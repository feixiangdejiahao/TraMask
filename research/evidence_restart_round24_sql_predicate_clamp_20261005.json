    "claim": "Aggregate detection matches MIN/MAX names without arity. SQLite treats two-or-more-argument min/max as scalar. If a row invariant receives the generated numeric predicate, classifying it as aggregate may inspect only the first row and miss a later violation. The candidate and all retained assertions still require independent contract review.",
    "source_spans": [
      {
        "path": "sqlite_utils/db.py",
        "start_line": 52,
        "end_line": 57,
        "start_byte": 848,
        "end_byte": 1078,
        "text": "_IMPORT_INVARIANT_AGGREGATES = re.compile(\n    r\"\\b(?:count|sum|avg|min|max|total|group_concat|string_agg|\"\n    r\"json_group_array|json_group_object|median|mode|percentile_cont|\"\n    r\"percentile_disc)\\s*\\(\",\n    re.IGNORECASE,\n)\n",
        "source_sha256": "369567e8d97830c9dc70db4a79678fc20e87c357028e8b24edaf7f67bf5a7e7a",
        "container": {
          "path": "/home/jhx/combination_coverage/results/relational_gap_20260928/batch7/N04/corpus.json",
          "sha256": "f72ab07a132e8cb4ec115d0ca24e1e7324157b1148875fdadd178ec2af2189fd"
        }
      },
      {
        "path": "sqlite_utils/db.py",
        "start_line": 1587,
        "end_line": 1620,
        "start_byte": 57693,
        "end_byte": 59217,
        "text": "        the import invariants registered for ``table``.\n        \"\"\"\n        self._create_import_invariants_table_if_needed()\n        return [\n            {\"id\": row[\"id\"], \"expression\": row[\"expression\"]}\n            for row in self.table(self._safe_import_invariants_table).rows_where(\n                '\"table\" = ?', [table], order_by=\"id\"\n            )\n        ]\n\n    def _is_aggregate_expression(self, expression: str) -> bool:\n        return bool(_IMPORT_INVARIANT_AGGREGATES.search(expression))\n\n    def _check_import_invariant(self, table: str, expression: str) -> bool:\n        sql = expression.strip()\n        if sql.upper().startswith(\"SELECT\"):\n            # Treat the first column of the first row as the truth value.\n            row = self.execute(sql).fetchone()\n            return bool(row[0]) if row else False\n        from_sql = \" FROM {}\".format(quote_identifier(table))\n        if self._is_aggregate_expression(sql):\n            # Aggregate expressions are evaluated once for the whole table.\n            row = self.execute(\"SELECT {}{}\".format(sql, from_sql)).fetchone()\n            return bool(row[0]) if row else False\n        # Non-aggregate expressions must be true for every row.\n        cursor = self.execute(\"SELECT {}{}\".format(sql, from_sql))\n        for row in cursor:\n            if not row[0]:\n                return False\n        return True\n\n    def validate_import_invariants(self, table: str) -> Dict[str, Any]:\n        \"\"\"\n        Validate all import invariants registered for ``table``.\n",
