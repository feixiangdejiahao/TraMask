+import { freeze } from '../util/object-utils.js'
+import type { OperationNode } from './operation-node.js'
+
+export type OverBoundType =
+  | 'current row'
+  | 'unbounded preceding'
+  | 'preceding'
+  | 'unbounded following'
+  | 'following'
+
+export interface OverBoundNode extends OperationNode {
+  readonly kind: 'OverBoundNode'
+  readonly type: OverBoundType
+  readonly value?: OperationNode
+}
+
+type OverBoundNodeFactory = Readonly<{
+  is(node: OperationNode): node is OverBoundNode
+  create(type: OverBoundType, value?: OperationNode): Readonly<OverBoundNode>
+}>
+
+/**
+ * @internal
+ */
+export const OverBoundNode: OverBoundNodeFactory = freeze<OverBoundNodeFactory>(
+  {
+    is(node): node is OverBoundNode {
+      return node.kind === 'OverBoundNode'
+    },
+
+    create(type, value?) {
+      return freeze({
+        kind: 'OverBoundNode',
+        type,
+        value,
+      })
+    },
+  },
+)
