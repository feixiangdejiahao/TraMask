+import { throwParseError } from "@ark/util"
+import type { JsonSchema } from "arktype"
+import { writeInvalidRefFormatMessage } from "./errors.ts"
+
+export const getRefName = (ref: string): string => {
+	if (!ref.startsWith("#/$defs/"))
+		throwParseError(writeInvalidRefFormatMessage())
+	const name = ref.slice("#/$defs/".length)
+	if (name.length === 0 || name.includes("/"))
+		throwParseError(writeInvalidRefFormatMessage())
+	return name
+}
+
+const objectKeywords = [
+	"properties",
+	"required",
+	"patternProperties",
+	"additionalProperties",
+	"maxProperties",
+	"minProperties",
+	"propertyNames",
+	"dependencies",
+	"dependentRequired",
+	"dependentSchemas"
+] as const
+
+export const hasObjectKeywords = (schema: JsonSchema): boolean =>
+	objectKeywords.some(keyword => keyword in schema)
+
+const isPrimitive = (value: unknown): boolean =>
+	typeof value !== "object" || value === null
+
+const rawStringDef = (schema: JsonSchema.String): string | undefined => {
+	if ("pattern" in schema || "format" in schema) return
+	let def = "string"
+	if ("minLength" in schema) def += ` >= ${schema.minLength}`
+	if ("maxLength" in schema) def += ` <= ${schema.maxLength}`
+	return def
+}
+
+const rawNumberDef = (schema: JsonSchema.Numeric): string | undefined => {
+	let def = "number"
+	if ("multipleOf" in schema) def += ` % ${schema.multipleOf}`
+	else if (schema.type === "integer") def += ".integer"
+	if ("minimum" in schema) def += ` >= ${schema.minimum}`
+	else if ("exclusiveMinimum" in schema) def += ` > ${schema.exclusiveMinimum}`
+	if ("maximum" in schema) def += ` <= ${schema.maximum}`
+	else if ("exclusiveMaximum" in schema) def += ` < ${schema.exclusiveMaximum}`
+	return def
+}
+
+const rawEnumDef = (schema: JsonSchema.Enum): string | undefined => {
+	if (schema.enum.length === 0) return "never"
+	for (const value of schema.enum)
+		if (typeof value === "object" && value !== null) return
+	return schema.enum
