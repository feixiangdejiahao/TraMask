+		if ("maxItems" in schema) def += ` <= ${schema.maxItems}`
+		return def
+	}
+
+	if (Array.isArray(schema.items) || "prefixItems" in schema) {
+		const prefix =
+			Array.isArray(schema.items) ? schema.items : (schema.prefixItems ?? [])
+		return prefix.map(item => jsonSchemaToRawDefSchema(item, defs, seen))
+	}
+
+	let def = "unknown[]"
+	if ("minItems" in schema) def += ` >= ${schema.minItems}`
+	if ("maxItems" in schema) def += ` <= ${schema.maxItems}`
+	return def
+}
+
+const rawUnionOrIntersection = (
+	branches: readonly JsonSchema[],
+	defs: Record<string, JsonSchema>,
+	operator: "|" | "&",
+	seen: Set<string>
+): unknown => {
+	const rawBranches = branches.map(branch =>
+		jsonSchemaToRawDefSchema(branch, defs, seen)
+	)
+	if (rawBranches.some(raw => raw === undefined)) return
+	const result: unknown[] = []
+	for (const [index, branch] of rawBranches.entries()) {
+		if (index > 0) result.push(operator)
+		result.push(branch)
+	}
+	return result
+}
+
+const jsonSchemaToRawDefSchema = (
+	jsonSchema: JsonSchema,
+	defs: Record<string, JsonSchema>,
+	seen: Set<string>
+): unknown => {
+	if (typeof jsonSchema === "boolean") return jsonSchema ? "unknown" : "never"
+
+	if ("$ref" in jsonSchema) {
+		const name = getRefName(jsonSchema.$ref)
+		if (!(name in defs)) return
+		if (seen.has(name)) return name
+		seen.add(name)
+		if (!isRawExpressibleSchema(defs[name], defs, seen)) return
+		return name
+	}
+
+	if ("const" in jsonSchema) {
+		if (isPrimitive(jsonSchema.const)) {
+			return typeof jsonSchema.const === "string" ?
+					`'${jsonSchema.const.replace(/'/g, "\\'")}'`
+				:	String(jsonSchema.const)
+		}
+		return
+	}
+
+	if ("enum" in jsonSchema) return rawEnumDef(jsonSchema)
+
+	if ("anyOf" in jsonSchema)
+		return rawUnionOrIntersection(jsonSchema.anyOf, defs, "|", seen)
+
+	if ("allOf" in jsonSchema)
+		return rawUnionOrIntersection(jsonSchema.allOf, defs, "&", seen)
+
+	if ("oneOf" in jsonSchema || "not" in jsonSchema) return
+
+	if ("type" in jsonSchema) {
+		if (Array.isArray(jsonSchema.type)) {
+			const branches = jsonSchema.type.map(t =>
+				jsonSchemaToRawDefSchema({ ...jsonSchema, type: t }, defs, seen)
+			)
+			if (branches.some(branch => branch === undefined)) return
+			const result: unknown[] = []
+			for (const [index, branch] of branches.entries()) {
+				if (index > 0) result.push("|")
+				result.push(branch)
+			}
+			return result
+		}
+		switch (jsonSchema.type) {
+			case "string":
+				return rawStringDef(jsonSchema as JsonSchema.String)
+			case "number":
+			case "integer":
+				return rawNumberDef(jsonSchema as JsonSchema.Numeric)
+			case "boolean":
+			case "null":
+				return jsonSchema.type
+			case "object":
+				return rawObjectDef(jsonSchema as JsonSchema.Object, defs, seen)
+			case "array":
+				return rawArrayDef(jsonSchema as JsonSchema.Array, defs, seen)
+			default:
+				return
+		}
+	}
+
+	if (hasObjectKeywords(jsonSchema))
+		return rawObjectDef(jsonSchema as JsonSchema.Object, defs, seen)
+
+	return
+}
+
+/**
+ * Convert a JSON Schema into a raw ArkType definition that can be placed
+ * directly in a scope so that recursive $defs resolve lazily.
+ *
+ * Returns `undefined` when the schema cannot be fully represented as a raw
+ * definition (e.g. it needs predicates or references a non-raw def), in which
+ * case it is parsed eagerly.
+ */
+export const jsonSchemaToRawDef = (
+	jsonSchema: JsonSchema,
+	defs: Record<string, JsonSchema>
+): unknown => jsonSchemaToRawDefSchema(jsonSchema, defs, new Set())
