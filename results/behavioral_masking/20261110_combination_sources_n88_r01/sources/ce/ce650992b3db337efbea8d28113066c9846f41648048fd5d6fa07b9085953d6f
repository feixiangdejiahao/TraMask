+			isRawExpressibleSchema(branch, defs, seen)
+		)
+	}
+	if ("allOf" in jsonSchema) {
+		return jsonSchema.allOf.every(branch =>
+			isRawExpressibleSchema(branch, defs, seen)
+		)
+	}
+	if ("oneOf" in jsonSchema || "not" in jsonSchema) return false
+	if ("type" in jsonSchema) {
+		if (Array.isArray(jsonSchema.type)) {
+			return jsonSchema.type.every(t =>
+				isRawExpressibleSchema({ ...jsonSchema, type: t }, defs, seen)
+			)
+		}
