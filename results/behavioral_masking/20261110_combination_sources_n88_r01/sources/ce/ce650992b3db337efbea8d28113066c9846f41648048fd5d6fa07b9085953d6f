+	}
+
+	if (schema.patternProperties) {
+		for (const [key, value] of Object.entries(schema.patternProperties)) {
+			const raw = jsonSchemaToRawDefSchema(value, defs, seen)
+			if (raw === undefined) return
+			result[`[/${key.replace(/\//g, "\\/")}/]`] = raw
+		}
+	}
+
+	const additionalProperties = schema.additionalProperties
+	if (additionalProperties === false) result["+"] = "reject"
+	return result
+}
+
+const rawArrayDef = (
+	schema: JsonSchema.Array,
+	defs: Record<string, JsonSchema>,
+	seen: Set<string>
+): unknown => {
+	if (!isRawArraySchema(schema, defs, seen)) return
+
+	if ("items" in schema && !Array.isArray(schema.items)) {
+		const raw = jsonSchemaToRawDefSchema(schema.items as JsonSchema, defs, seen)
