+		const prefix =
+			Array.isArray(schema.items) ? schema.items : (schema.prefixItems ?? [])
+		if (
+			"additionalItems" in schema ||
+			"minItems" in schema ||
+			"maxItems" in schema
+		)
+			return false
+		return prefix.every(item => isRawExpressibleSchema(item, defs, seen))
+	}
+	return true
