+				return false
+		}
+	}
+	if (hasObjectKeywords(jsonSchema))
+		return isRawObjectSchema(jsonSchema as JsonSchema.Object, defs, seen)
+	return false
+}
+
+export const isRawExpressible = (
+	jsonSchema: JsonSchema,
+	defs: Record<string, JsonSchema>
+): boolean => isRawExpressibleSchema(jsonSchema, defs, new Set())
+
+const rawObjectDef = (
+	schema: JsonSchema.Object,
+	defs: Record<string, JsonSchema>,
+	seen: Set<string>
+): Record<string, unknown> | undefined => {
+	if (!isRawObjectSchema(schema, defs, seen)) return
