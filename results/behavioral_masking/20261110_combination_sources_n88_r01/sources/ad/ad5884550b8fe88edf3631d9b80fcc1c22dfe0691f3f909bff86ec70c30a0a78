+    @skip_unsupported
+    def test_stencil_mode_1d(self):
+        """Tests the wrap, nearest, reflect and symmetric boundary modes for
+        1D stencils.
+        """
+
+        def expected(a, mode):
+            n = len(a)
+            out = np.zeros_like(a)
+            for i in range(n):
+                acc = 0.0
+                for rel in (-1, 0, 1):
+                    j = i + rel
+                    if mode == 'wrap':
+                        idx = j % n
+                    elif mode == 'nearest':
+                        idx = min(max(j, 0), n - 1)
+                    elif mode == 'reflect':
+                        if n == 1:
+                            if j != 0:
+                                acc += 0.0
+                                continue
+                            idx = 0
+                        else:
+                            period = 2 * (n - 1)
+                            m = j % period
+                            idx = m if m < n else period - m
+                    elif mode == 'symmetric':
+                        period = 2 * n
+                        m = j % period
+                        idx = m if m < n else period - m - 1
+                    else:
