n\nNow first/nullable computation. Need `flattenSequence` and helpers:\n```go\nfunc sequenceNodes(s *sequence) []node {\n    var out []node\n    for ; s != nil; s = s.next { out = append(out, s.node) }\n    return out\n}\n```\n\nfirst of sequence tail:\n```go\nfunc (a *analysis) firstOfList(nodes []node) (map[firstToken]bool, bool) {\n    out := map[firstToken]bool{}\n    allNullable := true\n    for _, n := range nodes {\n        for f := range a.first[n] { out[f] = true }\n        if !a.nullable[n] { allNullable = false; break }\n    }\n    return out, allNullable\n}\n```\nActually allNullable should be true only if ALL nodes nullable; the loop above sets false if any non-nullable, but if we break early, the remaining nodes aren't considered \u2014 that's fine because allNullable only matters if we got through all. But if we break on first non-nullable, allNullable=false and remaining don't matter. Correct.\n\nUpdate logic per node:\n```go\nfunc (a *analysis) computeFirst(n node) (map[firstToken]bool, bool) {\n    switch x := n.(type) {\n    case *literal:\n        if x.t == lexer.EOF {\n            return map[firstToken]bool{{firstLiteral, x.s}: true}, false\n        }\n        return map[firstToken]bool{{firstType, x.tt}: true}, false\n    case *reference:\n        return map[firstToken]bool{{firstType, x.identifier}: true}, false\n    case *sequence:\n        return a.firstOfList(sequenceNodes(x))\n    case *disjunction:\n        out := map[firstToken]bool{}\n        nullable := false\n        for _, c := range x.nodes {\n            for f := range a.first[c] { out[f] = true }\n            if a.nullable[c] { nullable = true }\n        }\n        return out, nullable\n    case *group:\n        switch x.mode {\n        case groupMatchZeroOrOne, groupMatchZeroOrMore:\n            out := map[firstToken]bool{}\n            for f := range a.first[x.expr] { out[f] = true }\n            return out, true\n        case groupMatchNonEmpty:\n            out := map[firstTok