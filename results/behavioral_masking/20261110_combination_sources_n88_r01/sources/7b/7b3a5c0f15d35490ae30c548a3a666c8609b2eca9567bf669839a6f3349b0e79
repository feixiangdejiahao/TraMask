+        cached_scores = {}
+        fname_to_path = {}
+
+        for fname in self.files_list:
+            fname_to_path[fname] = os.path.abspath(fname)
+
+        statuses = {}
+        for fname in self.files_list:
+            path = fname_to_path[fname]
+            if fname in ("-", "<stdin>"):
