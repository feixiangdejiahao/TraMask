+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/token"
+	"go/types"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken links in doc comments"
+	info.Before = `
+// Foo is documented.
+// See [Bar] for details.
+type Foo struct{}`
+	info.After = `
+// Foo is documented.
+// See [Foo] for details.
+type Foo struct{}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		ctx.Require.PkgObjects = true
+		return astwalk.WalkerForDocLink(&brokenDocLinkChecker{ctx: ctx}), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(doc *ast.CommentGroup, decl ast.Node) {
+	parser := &comment.Parser{
+		LookupPackage: func(name string) (string, bool) {
+			if name != "_" && token.IsIdentifier(name) {
+				return name, true
+			}
+			return "", false
+		},
+		LookupSym: func(recv, name string) bool {
+			return true
+		},
+	}
+
+	parsed := parser.Parse(docCommentText(doc))
+	for _, link := range collectDocLinks(parsed) {
+		c.checkLink(link, decl)
+	}
+}
+
+func collectDocLinks(doc *comment.Doc) []*comment.DocLink {
+	var links []*comment.DocLink
+	var visitText func([]comment.Text)
+	var visitBlock func(comment.Block)
+
+	visitText = func(text []comment.Text) {
+		for _, t := range text {
+			switch t := t.(type) {
+			case *comment.DocLink:
+				links = append(links, t)
+			case *comment.Link:
+				visitText(t.Text)
+			}
+		}
+	}
+	visitBlock = func(block comment.Block) {
+		switch block := block.(type) {
+		case *comment.Paragraph:
+			visitText(block.Text)
+		case *comment.Heading:
+			visitText(block.Text)
+		case *comment.List:
+			for _, item := range block.Items {
+				for _, content := range item.Content {
+					visitBlock(content)
+				}
+			}
+		}
+	}
+
+	for _, block := range doc.Content {
+		visitBlock(block)
+	}
+	return links
+}
+
+func (c *brokenDocLinkChecker) checkLink(link *comment.DocLink, decl ast.Node) {
+	ref := docLinkRef(link)
+
+	switch {
+	case link.ImportPath != "" && link.Name == "":
+		// A package reference: [pkg].
+		if isBuiltin(link.ImportPath) {
+			return
+		}
+		if c.lookupPackage(link.ImportPath) == nil {
+			c.warn(decl, ref, `package "%s" is not imported`, link.ImportPath)
+		}
+
+	case link.ImportPath != "":
+		pkg := c.lookupPackage(link.ImportPath)
+		if pkg == nil {
+			c.warn(decl, ref, `package "%s" is not imported`, link.ImportPath)
+			return
+		}
+		if link.Recv == "" {
+			if pkg.Scope().Lookup(link.Name) == nil {
+				c.warn(decl, ref, `"%s" not found in package "%s"`, link.Name, link.ImportPath)
+			}
+			return
+		}
+		c.checkMember(decl, ref, pkg.Scope().Lookup(link.Recv), link.Recv, link.Name, link.ImportPath, false)
+
+	case link.Recv != "":
+		// A method or field reference in the current package: [Type.Member].
+		c.checkMember(decl, ref, c.lookupLocal(link.Recv), link.Recv, link.Name, "", true)
+
+	default:
+		// A symbol reference in the current package: [Name].
+		if c.lookupLocal(link.Name) == nil && !isBuiltin(link.Name) {
+			c.warn(decl, ref, `unknown symbol "%s" in current package`, link.Name)
+		}
+	}
+}
+
+func (c *brokenDocLinkChecker) checkMember(decl ast.Node, ref string, obj types.Object, recv, member, pkgName string, local bool) {
+	if obj == nil {
+		if local {
+			c.warn(decl, ref, `type "%s" not found in current package`, recv)
+		} else {
+			c.warn(decl, ref, `type "%s" not found in package "%s"`, recv, pkgName)
+		}
+		return
+	}
+
+	typeName, ok := obj.(*types.TypeName)
+	if !ok {
+		c.warn(decl, ref, `"%s" is not a type`, recv)
+		return
+	}
+
+	if obj, _, _ := types.LookupFieldOrMethod(typeName.Type(), true, typeName.Pkg(), member); obj == nil {
+		c.warn(decl, ref, `type "%s" has no method or field "%s"`, recv, member)
+	}
+}
+
+func (c *brokenDocLinkChecker) lookupLocal(name string) types.Object {
+	if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+		return obj
+	}
+	for pkgName, localName := range c.ctx.PkgObjects {
+		if localName != "." {
+			continue
+		}
+		if obj := pkgName.Imported().Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) lookupPackage(name string) *types.Package {
+	// Prefer a package referred to by its local name (including aliases).
+	for pkgName, localName := range c.ctx.PkgObjects {
+		if localName == "." {
+			continue
+		}
+		if localName == name {
+			return pkgName.Imported()
+		}
+	}
+	// Fall back to full import paths, e.g. [net/http].
+	for pkgName, localName := range c.ctx.PkgObjects {
+		if localName == "." {
+			continue
+		}
+		if pkgName.Imported().Path() == name {
+			return pkgName.Imported()
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) warn(decl ast.Node, ref string, format string, args ...interface{}) {
+	c.ctx.Warn(decl, "[%s]: %s", ref, fmt.Sprintf(format, args...))
+}
+
+func docCommentText(doc *ast.CommentGroup) string {
+	var b strings.Builder
+	for _, c := range doc.List {
+		if strings.HasPrefix(c.Text, "/*") {
+			continue
+		}
+		if b.Len() != 0 {
+			b.WriteByte('\n')
+		}
+		b.WriteString(strings.TrimPrefix(c.Text, "//"))
+	}
+	return b.String()
+}
+
+func docLinkRef(link *comment.DocLink) string {
+	var b strings.Builder
+	for _, t := range link.Text {
+		switch t := t.(type) {
+		case comment.Plain:
+			b.WriteString(string(t))
+		case comment.Italic:
+			b.WriteString(string(t))
+		}
+	}
+	return b.String()
+}
