+	v.run()
+	atomic.StoreInt64(&v.aborting, 0)
+	if v.err != nil {
+		return nil, v.formatError(v.err)
+	}
+	ret := v.returnValue
+	if ret == nil {
+		ret = UndefinedValue
+	}
+	return ret, nil
