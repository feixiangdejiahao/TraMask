: ratFromInt64(1024 * 1024 * 1024)},\\n\\t\\t{names: []string{\\\"TB\\\", \\\"Tb\\\", \\\"tb\\\"}, mult: ratFromInt64(1000 * 1000 * 1000 * 1000)},\\n\\t\\t{names: []string{\\\"TiB\\\", \\\"Ti\\\", \\\"TIB\\\", \\\"tib\\\"}, mult: ratFromInt64(1024 * 1024 * 1024 * 1024)},\\n\\t\\t{names: []string{\\\"PB\\\", \\\"Pb\\\", \\\"pb\\\"}, mult: ratFromInt64(1000 * 1000 * 1000 * 1000 * 1000)},\\n\\t\\t{names: []string{\\\"PiB\\\", \\\"Pi\\\", \\\"PIB\\\", \\\"pib\\\"}, mult: ratFromInt64(1024 * 1024 * 1024 * 1024 * 1024)},\\n\\t\\t{names: []string{\\\"EB\\\", \\\"Eb\\\", \\\"eb\\\"}, mult: ratFromInt64(1000 * 1000 * 1000 * 1000 * 1000 * 1000)},\\n\\t\\t{names: []string{\\\"EiB\\\", \\\"Ei\\\", \\\"EIB\\\", \\\"eib\\\"}, mult: ratFromInt64(1024 * 1024 * 1024 * 1024 * 1024 * 1024)},\\n\\t}\\n)\\n\\n// parseScientific parses a decimal number in scientific notation (with an\\n// optional leading sign, a decimal point and an optional exponent) into an\\n// arbitrary-precision rational. A bare exponent marker with no following digits\\n// is rejected.\\nfunc parseScientific(s string) (*big.Rat, bool) {\\n\\ti := 0\\n\\tneg := false\\n\\tif i \\u003c len(s) \\u0026\\u0026 (s[i] == \\u0027+\\u0027 || s[i] == \\u0027-\\u0027) {\\n\\t\\tneg = s[i] == \\u0027-\\u0027\\n\\t\\ti++\\n\\t}\\n\\n\\tintStart := i\\n\\tfor i \\u003c len(s) \\u0026\\u0026 isDigit(s[i]) {\\n\\t\\ti++\\n\\t}\\n\\tintDigits := s[intStart:i]\\n\\n\\tfracDigits := \\\"\\\"\\n\\tif i \\u003c len(s) \\u0026\\u0026 s[i] == \\u0027.\\u0027 {\\n\\t\\ti++\\n\\t\\tfracStart := i\\n\\t\\tfor i \\u003c len(s) \\u0026\\u0026 isDigit(s[i]) {\\n\\t\\t\\ti++\\n\\t\\t}\\n\\t\\tfracDigits = s[fracStart:i]\\n\\t}\\n\\n\\tif len(intDigits) == 0 \\u0026\\u0026 len(fracDigits) == 0 {\\n\\t\\treturn nil, false\\n\\t}\\n\\n\\texp := new(big.Int)\\n\\tif i \\u003c len(s) \\u0026\\u0026 (s[i] == \\u0027e\\u0027 || s[i] == \\u0027E\\u0027) {\\n\\t\\ti++\\n\\t\\texpNeg := false\\n\\t\\tif i \\u003c len(s) \\u0026\\u0026 (s[i] == \\u0027+\\u0027 || s[i] == \\u0027-\\u0027) {\\n\\t\\t\\texpNeg = s[i] == \\u0027-\\u0027\\n\\t\\t\\ti++\\n\\t\\t}\\n\\t\\texpStart := i\\n\\t\\tfor i \\u003c len(s) \\u0026\\u0026 isDigit(s[i]) {\\n\\t\\t\\ti++\\n\\t\\t}\\n\\t\\tif i == expStart {\\n\\t\\t\\t// Bare exponent marker with no digits.\\n\\t\\t\\treturn nil, false\\n\\t\\t}\\n\\t\\texp.SetString(s[expStart:i], 10)\\n\\t\\tif expNeg {\\n\\t\\t\\texp.Neg(exp)\\n\\t\\t}\\n\\t}\\n\\n\\tif i != len(s) {\\n\\t\\treturn nil, false\\n\\t}\\n\\n\\tdigits := intDigits + fracDigits\\n\\tnum := new(big.Int)\\n\\tif len(digits) \\u003e 0 {\\n\\t\\tnum.SetString(digits, 10)\\n\\t}\\n\\tif neg {\\n\\t\\tnum.Neg(num)\\n\\t}\\n\\n\\tden := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(len(fracDigits))), nil)\\n\\trat := new(big.Rat).SetFrac(num, den)\\n\\n\\tif exp.Sign() \\u003e 0 {\\n\\t\\tfactor := new(big.Int).Exp(big.NewInt(10), exp, nil)\\n\\t\\trat.Mul(rat, new(big.Rat).SetInt(factor))\\n\\t} else if exp.Sign() \\u003c 0 {\\n\\t\\tfactor := new(big.Int).Exp(big.NewInt(10), new(big.Int).Neg(exp), nil)\\n\\t\\trat.Quo(rat, new(big.Rat).SetInt(factor))\\n\\t}\\n\\n\\treturn rat, true\\n}\\n\\n// parseScientificPrefix parses a decimal number in scientific notation at the\\n// beginning of s and returns the number of bytes consumed.\\nfunc parseScientificPrefix(s string) (*big.Rat, int, bool) {\\n\\ti := 0\\n\\tneg := false\\n\\tif i \\u003c len(s) \\u0026\\u0026 (s[i] == \\u0027+\\u0027 || s[i] == \\u0027-\\u0027) {\\n\\t\\tneg = s[i] == \\u0027-\\u0027\\n\\t\\ti++\\n\\t}\\n\\n\\tintStart := i\\n\\tfor i \\u003c len(s) \\u0026\\u0026 isDigit(s[i]) {\\n\\t\\ti++\\n\\t}\\n\\tintDigits := s[intStart:i]\\n\\n\\tfracDigits := \\\"\\\"\\n\\tif i \\u003c len(s) \\u0026\\u0026 s[i] == \\u0027.\\u0027 {\\n\\t\\ti++\\n\\t\\tfracStart := i\\n\\t\\tfor i \\u003c len(s) \\u0026\\u0026 isDigit(s[i]) {\\n\\t\\t\\ti++\\n\\t\\t}\\n\\t\\tfracDigits = s[fracStart:i]\\n\\t}\\n\\n\\tif len(intDigits) == 0 \\u0026\\u0026 len(fracDigits) == 0 {\\n\\t\\treturn nil, 0, false\\n\\t}\\n\\n\\texp := new(big.Int)\\n\\tif i \\u003c len(s) \\u0026\\u0026 (s[i] == \\u0027e\\u0027 || s[i] == \\u0027E\\u0027) {\\n\\t\\ti++\\n\\t\\texpNeg := false\\n\\t\\tif i \\u003c len(s) \\u0026\\u0026 (s[i] == \\u0027+\\u0027 || s[i] == \\u0027-\\u0027) {\\n\\t\\t\\texpNeg = s[i] == \\u0027-\\u0027\\n\\t\\t\\ti++\\n\\t\\t}\\n\\t\\texpStart := i\\n\\t\\tfor i \\u003c len(s) \\u0026\\u0026 isDigit(s[i]) {\\n\\t\\t\\ti++\\n\\t\\t}\\n\\t\\tif i == expStart {\\n\\t\\t\\treturn nil, 0, false\\n\\t\\t}\\n\\t\\texp.SetString(s[expStart:i], 10)\\n\\t\\tif expNeg {\\n\\t\\t\\texp.Neg(exp)\\n\\t\\t}\\n\\t}\\n\\n\\tdigits := intDigits + fracDigits\\n\\tnum := new(big.Int)\\n\\tif len(digits) \\u003e 0 {\\n\\t\\tnum.SetString(digits, 10)\\n\\t}\\n\\tif neg {\\n\\t\\tnum.Neg(num)\\n\\t}\\n\\n\\tden := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(len(fracDigits))), nil)\\n\\trat := new(big.Rat).SetFrac(num, den)\\n\\n\\tif exp.Sign() \\u003e 0 {\\n\\t\\tfactor := new(big.Int).Exp(big.NewInt(10), exp, nil)\\n\\t\\trat.Mul(rat, new(big.Rat).SetInt(factor))\\n\\t} else if exp.Sign() \\u003c 0 {\\n\\t\\tfactor := new(big.Int).Exp(big.NewInt(10), new(big.Int).Neg(exp), nil)\\n\\t\\trat.Quo(rat, new(big.Rat).SetInt(factor))\\n\\t}\\n\\n\\treturn rat, i, true\\n}\\n\\n// matchUnit matches a unit suffix at the beginning of s, preferring the longest\\n// unit name.\\nfunc matchUnit(s string, units []unitDef) (int, *big.Rat, bool) {\\n\\tfor _, u := range units {\\n\\t\\tfor _, name := range u.names {\\n\\t\\t\\tif strings.HasPrefix(s, name) {\\n\\t\\t\\t\\treturn len(name), u.mult, true\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\treturn 0, nil, false\\n}\\n\\n// parseUnitValue parses a value consisting of one or more scientific-notation\\n// coefficients followed by units. If compound is false, only a single\\n// coefficient/unit pair is accepted.\\nfunc parseUnitValue(s string, units []unitDef, compound bool) (*big.Rat, bool) {\\n\\tif s == \\\"\\\" {\\n\\t\\treturn nil, false\\n\\t}\\n\\tneg := false\\n\\tif s[0] == \\u0027+\\u0027 || s[0] == \\u0027-\\u0027 {\\n\\t\\tneg = s[0] == \\u0027-\\u0027\\n\\t\\ts = s[1:]\\n\\t\\tif s == \\\"\\\" {\\n\\t\\t\\treturn nil, false\\n\\t\\t}\\n\\t}\\n\\n\\ttotal := new(big.Rat)\\n\\tparts := 0\\n\\tfor s != \\\"\\\" {\\n\\t\\trat, n, ok := parseScientificPrefix(s)\\n\\t\\tif !ok {\\n\\t\\t\\treturn nil, false\\n\\t\\t}\\n\\t\\ts = s[n:]\\n\\n\\t\\tunitLen, mult, ok := matchUnit(s, units)\\n\\t\\tif !ok {\\n\\t\\t\\treturn nil, false\\n\\t\\t}\\n\\t\\ts = s[unitLen:]\\n\\n\\t\\tterm := new(big.Rat).Mul(rat, mult)\\n\\t\\ttotal.Add(total, term)\\n\\t\\tparts++\\n\\t\\tif !compound {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t}\\n\\tif !compound \\u0026\\u0026 s != \\\"\\\" {\\n\\t\\treturn nil, false\\n\\t}\\n\\tif parts == 0 {\\n\\t\\treturn nil, false\\n\\t}\\n\\tif neg {\\n\\t\\ttotal.Neg(total)\\n\\t}\\n\\treturn total, true\\n}\\n\\nfunc parseDurationValue(s string) (*big.Rat, bool) {\\n\\treturn parseUnitValue(s, durationUnits, true)\\n}\\n\\nfunc parseBytesValue(s string) (*big.Rat, bool) {\\n\\treturn parseUnitValue(s, byteUnits, false)\\n}\\n\\n// semverID is one identifier of a semver prerelease or build segment.\\ntype semverID struct {\\n\\tnumeric bool\\n\\tnum     uint64\\n\\tstr     string\\n}\\n\\n// semverVersion is a parsed semantic version. Build metadata is intentionally\\n// ignored for ordering.\\ntype semverVersion struct {\\n\\tsegments   []uint64\\n\\tprerelease []semverID\\n}\\n\\nfunc parseSemverIdentifiers(s string) ([]semverID, string, bool) {\\n\\tvar ids []semverID\\n\\tfor {\\n\\t\\tj := 0\\n\\t\\tfor j \\u003c len(s) \\u0026\\u0026 isSemverIdentChar(s[j]) {\\n\\t\\t\\tj++\\n\\t\\t}\\n\\t\\tif j == 0 {\\n\\t\\t\\treturn nil, \\\"\\\", false\\n\\t\\t}\\n\\t\\tid := s[:j]\\n\\t\\ts = s[j:]\\n\\n\\t\\tallDigits := true\\n\\t\\tfor k := 0; k \\u003c len(id); k++ {\\n\\t\\t\\tif !isDigit(id[k]) {\\n\\t\\t\\t\\tallDigits = false\\n\\t\\t\\t\\tbreak\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tvar v semverID\\n\\t\\tif allDigits {\\n\\t\\t\\tn, err := strconv.ParseUint(id, 10, 64)\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\treturn nil, \\\"\\\", false\\n\\t\\t\\t}\\n\\t\\t\\tv = semverID{numeric: true, num: n}\\n\\t\\t} else {\\n\\t\\t\\tv = semverID{str: id}\\n\\t\\t}\\n\\t\\tids = append(ids, v)\\n\\n\\t\\tif len(s) \\u003e 0 \\u0026\\u0026 s[0] == \\u0027.\\u0027 {\\n\\t\\t\\ts = s[1:]\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tbreak\\n\\t}\\n\\treturn ids, s, true\\n}\\n\\n// parseSemver parses a semantic version with an optional leading v/V prefix.\\n// It accepts one to three numeric segments, an optional prerelease and an\\n// optional build metadata section.\\nfunc parseSemver(s string) (semverVersion, bool) {\\n\\tif s == \\\"\\\" {\\n\\t\\treturn semverVersion{}, false\\n\\t}\\n\\tif s[0] == \\u0027v\\u0027 || s[0] == \\u0027V\\u0027 {\\n\\t\\ts = s[1:]\\n\\t\\tif s == \\\"\\\" {\\n\\t\\t\\treturn semverVersion{}, false\\n\\t\\t}\\n\\t}\\n\\n\\tvar segments []uint64\\n\\tfor {\\n\\t\\tj := 0\\n\\t\\tfor j \\u003c len(s) \\u0026\\u0026 isDigit(s[j]) {\\n\\t\\t\\tj++\\n\\t\\t}\\n\\t\\tif j == 0 {\\n\\t\\t\\treturn semverVersion{}, false\\n\\t\\t}\\n\\t\\tn, err := strconv.ParseUint(s[:j], 10, 64)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn semverVersion{}, false\\n\\t\\t}\\n\\t\\tsegments = append(segments, n)\\n\\t\\ts = s[j:]\\n\\n\\t\\tif len(s) \\u003e 0 \\u0026\\u0026 s[0] == \\u0027.\\u0027 {\\n\\t\\t\\tif len(segments) \\u003e= 3 {\\n\\t\\t\\t\\treturn semverVersion{}, false\\n\\t\\t\\t}\\n\\t\\t\\ts = s[1:]\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tbreak\\n\\t}\\n\\n\\tvar pre []semverID\\n\\tif len(s) \\u003e 0 \\u0026\\u0026 s[0] == \\u0027-\\u0027 {\\n\\t\\ts = s[1:]\\n\\t\\tvar ok bool\\n\\t\\tpre, s, ok = parseSemverIdentifiers(s)\\n\\t\\tif !ok {\\n\\t\\t\\treturn semverVersion{}, false\\n\\t\\t}\\n\\t}\\n\\n\\tif len(s) \\u003e 0 \\u0026\\u0026 s[0] == \\u0027+\\u0027 {\\n\\t\\ts = s[1:]\\n\\t\\t_, rest, ok := parseSemverIdentifie