+
+// Standard library package links are valid even without an import:
+// [math] and [math.Sin].
+func ValidStdlibRefs() {}
+
+// Content with spaces or non-identifier characters is not a link:
+// [foo bar], [foo-bar], [fmt.println], [Foo.Bar Baz].
