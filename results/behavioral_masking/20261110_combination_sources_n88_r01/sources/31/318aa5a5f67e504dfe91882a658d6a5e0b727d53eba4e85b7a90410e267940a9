+# Mode codes used to specialize stencil boundary handling at compile time.
+MODE_CONSTANT = 0
+MODE_WRAP = 1
+MODE_NEAREST = 2
+MODE_REFLECT = 3
+MODE_SYMMETRIC = 4
+
+_MODE_CODES = {
+    'constant': MODE_CONSTANT,
+    'wrap': MODE_WRAP,
+    'nearest': MODE_NEAREST,
+    'reflect': MODE_REFLECT,
+    'symmetric': MODE_SYMMETRIC,
+}
+
+_SUPPORTED_MODES = frozenset(_MODE_CODES.keys())
+
+
+@register_jitable
+def _stencil_bound_index(mode, idx, shape):
+    """Return ``(bounded_index, valid)`` for an out-of-bounds access at absolute
+    index ``idx`` in a dimension of size ``shape``.
+
+    ``mode`` is one of the ``MODE_*`` integer codes defined above.  The
+    ``valid`` flag is only ever ``False`` for the ``reflect`` and
+    ``symmetric`` modes when, after a single reflection, the index is still
+    outside the valid range.  In that case the caller should use the stencil
+    ``cval`` for the access instead.
+    """
+    if mode == MODE_WRAP:
+        # Circular indexing.
+        return idx % shape, True
+    elif mode == MODE_NEAREST:
+        # Clamp to the edge of the dimension.
+        if idx < 0:
+            return 0, True
+        elif idx >= shape:
+            return shape - 1, True
+        else:
+            return idx, True
+    elif mode == MODE_REFLECT:
+        # Mirror about the edges without repeating the edge values.
+        if idx < 0:
+            idx = -idx
+        if idx >= shape:
+            idx = 2 * (shape - 1) - idx
+        if 0 <= idx < shape:
+            return idx, True
+        else:
+            return idx, False
+    elif mode == MODE_SYMMETRIC:
+        # Mirror about the edges with the edge values repeated.
+        if idx < 0:
+            idx = -idx - 1
+        if idx >= shape:
+            idx = 2 * shape - 1 - idx
+        if 0 <= idx < shape:
+            return idx, True
+        else:
+            return idx, False
+    else:  # MODE_CONSTANT
+        # In a mixed-mode stencil a constant-mode dimension behaves as an
+        # in-bounds check: if the access is out of bounds in this dimension,
+        # cval is used for the whole access.
+        return idx, 0 <= idx < shape
+
+
+@register_jitable
+def _stencil_getitem(valid, arr, idx, cval):
+    """Return ``arr[idx]`` when ``valid`` is true, otherwise return ``cval``.
+    """
+    if valid:
+        return arr[idx]
+    else:
+        return cval
