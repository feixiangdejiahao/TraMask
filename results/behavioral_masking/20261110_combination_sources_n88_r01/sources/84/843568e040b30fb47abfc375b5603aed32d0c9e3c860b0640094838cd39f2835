ry:\n            with zipfile.ZipFile(path) as zf:\n                names = zf.namelist()\n                metadata: Optional[dict[str, Any]] = None\n                if \"metadata.json\" not in names:\n                    errors.append(\"Bundle is missing metadata.json\")\n                else:\n                    try:\n                        metadata = json.loads(\n                            zf.read(\"metadata.json\").decode(\"utf-8\")\n                        )\n                    except Exception as exc:\n                        errors.append(f\"metadata.json is not valid JSON: {exc}\")\n                    if isinstance(metadata, dict):\n                        errors.extend(_validate_metadata(metadata))\n                    elif metadata is not None:\n                        errors.append(\"metadata.json must contain a JSON object\")\n\n                events: list[dict[str, Any]] = []\n                if \"events.jsonl\" not in names:\n                    errors.append(\"Bundle is missing events.jsonl\")\n                else:\n                    raw_events = zf.read(\"events.jsonl\").decode(\"utf-8\")\n                    events, event_errors = _validate_events(raw_events)\n                    errors.extend(event_errors)\n                    if isinstance(metadata, dict):\n                        redactions = metadata.get(\"redactions\")\n                        if isinstance(redactions, list):\n                            for pattern in redactions:\n                                if isinstance(pattern, str) and pattern and pattern in raw_events:\n                                    errors.append(\n                                        f\"Redacted string {pattern!r} appears in events.jsonl\"\n                                    )\n                        event_count = metadata.get(\"event_count\")\n                        if _is_int(event_count) and event_count != len(events):\n                            errors.append(\n                              