idation in strict mode.\\\"\\\"\\\"\\n\\n    def __init__(self, bundle_path: Path | str, errors: list[str]) -\\u003e None:\\n        self.bundle_path = Path(bundle_path)\\n        self.errors = list(errors)\\n        super().__init__(\\n            \\\"Invalid session bundle at {}: {}\\\".format(\\n                self.bundle_path, \\\"; \\\".join(self.errors)\\n            )\\n        )\\n\\n\\n# -----------------------------------------------------------------------------\\n# Path helpers\\n# -----------------------------------------------------------------------------\\ndef _resolve_bundle_path(path: Path | str) -\\u003e Path:\\n    \\\"\\\"\\\"Normalize a bundle path, appending ``.ipybundle`` if needed.\\\"\\\"\\\"\\n    path = Path(path)\\n    if path.suffix != BUNDLE_SUFFIX:\\n        path = Path(str(path) + BUNDLE_SUFFIX)\\n    return path\\n\\n\\ndef _now_iso() -\\u003e str:\\n    return datetime.now(timezone.utc).isoformat()\\n\\n\\ndef _redact_text(text: str, patterns: list[str]) -\\u003e str:\\n    for pattern in patterns:\\n        if pattern:\\n            text = text.replace(pattern, REDACTED)\\n    return text\\n\\n\\ndef _redact_object(obj: Any, patterns: list[str]) -\\u003e Any:\\n    \\\"\\\"\\\"Recursively redact literal patterns from strings in ``obj``.\\\"\\\"\\\"\\n    if isinstance(obj, str):\\n        return _redact_text(obj, patterns)\\n    if isinstance(obj, list):\\n        return [_redact_object(item, patterns) for item in obj]\\n    if isinstance(obj, dict):\\n        return {\\n            key: _redact_object(value, patterns)\\n            for key, value in obj.items()\\n        }\\n    return obj\\n\\n\\n# -----------------------------------------------------------------------------\\n# Saving and loading\\n# -----------------------------------------------------------------------------\\ndef save_session_bundle(\\n    path: Path | str,\\n    meta: dict[str, Any],\\n    events: list[dict[str, Any]],\\n    *,\\n    overwrite: bool = False,\\n) -\\u003e Path:\\n    \\\"\\\"\\\"Write ``metadata.json`` and ``events.jsonl`` into a bundle at ``path``.\\n\\n    The final bundle ``Path`` is returned.  If ``path`` does not already end\\n    with ``.ipybundle`` the suffix is appended.\\n\\n    Parameters\\n    ----------\\n    path : path-like\\n        Destination for the bundle.\\n    meta : dict\\n        Metadata dictionary written as ``metadata.json``.\\n    events : list of dict\\n        Cell events written as ``events.jsonl``.\\n    overwrite : bool\\n        If ``True`` replace an existing bundle; otherwise raise\\n        :class:`FileExistsError` when the target already exists.\\n    \\\"\\\"\\\"\\n    path = _resolve_bundle_path(path)\\n    if path.exists() and not overwrite:\\n        raise FileExistsError(f\\\"Session bundle already exists: {path}\\\")\\n\\n    events = list(events)\\n    meta = dict(meta)\\n\"\n}"
