already exists.\n    \"\"\"\n    path = _resolve_bundle_path(path)\n    if path.exists() and not overwrite:\n        raise FileExistsError(f\"Session bundle already exists: {path}\")\n\n    meta = dict(meta)\n    if \"event_count\" not in meta:\n        meta[\"event_count\"] = len(events)\n\n    path.parent.mkdir(parents=True, exist_ok=True)\n    fd, tmp_name = tempfile.mkstemp(\n        prefix=path.name + \".\", suffix=\".tmp\", dir=str(path.parent)\n    )\n    os.close(fd)\n    tmp_path = Path(tmp_name)\n    try:\n        with zipfile.ZipFile(tmp_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n            zf.writestr(\"metadata.json\", json.dumps(meta, indent=2) + \"\\n\")\n            events_text = \"\".join(\n                json.dumps(event, ensure_ascii=False) + \"\\n\" for event in events\n            )\n            zf.writestr(\"events.jsonl\", events_text)\n        os.replace(tmp_path, path)\n    finally:\n        if tmp_path.exists():\n            tmp_path.unlink()\n    return path\n\n\ndef load_session_bundle(path: Path | str) -> tuple[dict[str, Any], list[dict[str, Any]]]:\n    \"\"\"Load a session bundle and return ``(metadata, events)``.\n\n    This function does not execute any recorded code.\n    \"\"\"\n    path = Path(path)\n    with zipfile.ZipFile(path) as zf:\n        with zf.open(\"metadata.json\") as f:\n            metadata = json.load(f)\n        with zf.open(\"events.jsonl\") as f:\n            raw_events = f.read().decode(\"utf-8\")\n    events = []\n    for line in raw_events.splitlines():\n        line = line.strip()\n        if line:\n            events.append(json.loads(line))\n    return metadata, events\n\n\n# -----------------------------------------------------------------------------\n# Validation\n# -----------------------------------------------------------------------------\ndef _is_int(value: Any) -> bool:\n    return isinstance(value, int) and not isinstance(value, bool)\n\n\ndef _is_iso8601(value: Any) -> bool:\n    if not isinst