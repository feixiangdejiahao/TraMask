    31	class BanditManager:
    32	    scope = []
    33	
    34	    def __init__(
    35	        self,
    36	        config,
    37	        agg_type,
    38	        debug=False,
    39	        verbose=False,
    40	        quiet=False,
   295	        self.files_list = new_files_list
   296	
   297	        # do final aggregation of metrics
   298	        self.metrics.aggregate()
   299	
   300	    def _parse_file(self, fname, fdata, new_files_list):
   301	        try:
   302	            # parse the current file
   303	            data = fdata.read()
   304	            lines = data.splitlines()
   305	            self.metrics.begin(fname)
   306	            self.metrics.count_locs(lines)
   307	            # nosec_lines is a dict of line number -> suppression for the line
   308	            nosec_lines = dict()
   309	            if not self.ignore_nosec:
   310	                enabled_tests = self._get_enabled_tests()
   311	                nosec_lines = nosec.build_nosec_lines(data, enabled_tests)
   312	            score = self._execute_ast_visitor(fname, fdata, data, nosec_lines)
   313	            self.scores.append(score)
   314	            self.metrics.count_issues([score])
   315	        except KeyboardInterrupt:
   316	            sys.exit(2)
   317	        except SyntaxError:
   318	            self.skipped.append(
   319	                (fname, "syntax error while parsing AST from file")
   320	            )
   321	            new_files_list.remove(fname)
   322	        except Exception as e:
   323	            LOG.error(
   324	                "Exception occurred when executing tests against %s.", fname
   325	            )
   326	            if not LOG.isEnabledFor(logging.DEBUG):
   327	                LOG.error(
   328	                    'Run "bandit --debug %s" to see the full traceback.', fname
   329	                )
   330	
   331	            self.skipped.append((fname, "exception while scanning file"))
   332	            new_files_list.remove(fname)
   333	            LOG.debug("  Exception string: %s", e)
   334	            LOG.debug("  Exception traceback: %s", traceback.format_exc())
   335	
   336	    def _get_enabled_tests(self):
   337	        """Return the set of test IDs currently enabled for this manager."""
   338	        enabled = set()
   339	        for plugin in self.b_ts.plugins:
   340	            if (
   341	                hasattr(plugin.plugin, "_config")
   342	                and plugin.plugin._test_id == "B001"
   343	            ):
   344	                for tests in plugin.plugin._config.values():
   345	                    enabled.update(t["id"] for t in tests)
   346	            else:
   347	                enabled.add(plugin.plugin._test_id)
   348	        return enabled
   349	
   350	    def _execute_ast_visitor(self, fname, fdata, data, nosec_lines):
   351	        """Execute AST parse on each file
   352	
   353	        :param fname: The name of the file being parsed
   354	        :param data: Original file contents
   355	        :param lines: The lines of code to process
   356	        :return: The accumulated test score
   357	        """
   358	        score = []
   359	        res = b_node_visitor.BanditNodeVisitor(
   360	            fname,
   361	            fdata,
   362	            self.b_ma,
   363	            self.b_ts,
   364	            self.debug,
   365	            nosec_lines,
   366	            self.metrics,
   367	        )
   368	
   369	        score = res.process(data)
   370	        self.results.extend(res.tester.results)
   371	        return score
