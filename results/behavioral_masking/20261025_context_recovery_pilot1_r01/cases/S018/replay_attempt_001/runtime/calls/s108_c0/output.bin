   260	        self.assertIn(3, nosec_lines)
   261	        self.assertIn(4, nosec_lines)
   262	
   263	    def test_unmatched_end_does_nothing(self):
   264	        source = "# nosec-end\nfoo()\n"
   265	        nosec_lines = self._build(source)
   266	        self.assertNotIn(2, nosec_lines)
   267	
   268	
   269	    def test_next_line_combined_with_region(self):
   270	        source = (
   271	            "# nosec-begin B607\n"
   272	            "# nosec-next-line B602\n"
   273	            "foo()\n"
   274	            "# nosec-end\n"
   275	        )
   276	        nosec_lines = self._build(source)
   277	        self.assertIn(3, nosec_lines)
   278	        self.assertEqual({"B602", "B607"}, nosec_lines[3].tests)
   279	
   280	    def test_statement_wide_region_with_end_inside(self):
   281	        source = (
   282	            "foo(\n"
   283	            "    # nosec-begin\n"
   284	            "    bar,\n"
   285	            "    # nosec-end\n"
   286	            ")\n"
   287	        )
   288	        nosec_lines = self._build(source)
   289	        # The statement spans lines 1-5; the region covers line 3, so the
   290	        # whole statement should be considered suppressed.
   291	        self.assertIn(3, nosec_lines)
   292	        self.assertTrue(nosec_lines[3].is_blanket)
   293	
   294	    def test_next_line_skips_semicolon_and_ellipsis(self):
   295	        source = (
   296	            "# nosec-next-line\n"
   297	            ";\n"
   298	            "...\n"
   299	            "foo()\n"
   300	        )
   301	        nosec_lines = self._build(source)
   302	        self.assertIn(4, nosec_lines)
   303	
   304	    def test_next_line_skips_continuation(self):
   305	        source = (
   306	            "foo(\n"
   307	            "    # nosec-next-line\n"
   308	            "    bar,\n"
   309	            ")\n"
   310	            "baz()\n"
   311	        )
   312	        nosec_lines = self._build(source)
   313	        self.assertIn(5, nosec_lines)
   314	        self.assertNotIn(3, nosec_lines)
   315	
   316	    def test_next_line_decorated_function(self):
   317	        source = (
   318	            "# nosec-next-line\n"
   319	            "@decorator\n"
   320	            "def foo():\n"
   321	            "    bar()\n"
   322	        )
   323	        nosec_lines = self._build(source)
   324	        self.assertIn(3, nosec_lines)
   325	        self.assertIn(4, nosec_lines)
