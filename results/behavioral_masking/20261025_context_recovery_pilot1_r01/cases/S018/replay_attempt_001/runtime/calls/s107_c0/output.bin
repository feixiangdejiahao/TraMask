    56	class SelectorTests(testtools.TestCase):
    57	    ENABLED = {"B101", "B601", "B602", "B603", "B607", "B608"}
    58	
    59	    def _resolve(self, text):
    60	        return nosec._evaluate(nosec._tokenize(text), self.ENABLED)
    61	
    62	    def test_blank(self):
    63	        self.assertTrue(nosec._resolve_selector("", self.ENABLED, "nosec").is_blanket)
    64	
    65	    def test_all(self):
    66	        self.assertTrue(nosec._resolve_selector("all", self.ENABLED, "nosec").is_blanket)
    67	
    68	    def test_none(self):
    69	        suppression = nosec._resolve_selector("none", self.ENABLED, "nosec")
    70	        self.assertTrue(suppression.is_none)
    71	
    72	    def test_single_id(self):
    73	        suppression = nosec._resolve_selector("B602", self.ENABLED, "nosec")
    74	        self.assertEqual({"B602"}, suppression.tests)
    75	
    76	    def test_name(self):
    77	        suppression = nosec._resolve_selector(
    78	            "subprocess_popen_with_shell_equals_true", self.ENABLED, "nosec"
    79	        )
    80	        self.assertEqual({"B602"}, suppression.tests)
    81	
    82	    def test_union_space(self):
    83	        suppression = nosec._resolve_selector("B602 B607", self.ENABLED, "nosec")
    84	        self.assertEqual({"B602", "B607"}, suppression.tests)
    85	
    86	    def test_union_comma(self):
    87	        suppression = nosec._resolve_selector("B602, B607", self.ENABLED, "nosec")
    88	        self.assertEqual({"B602", "B607"}, suppression.tests)
    89	
    90	    def test_union_pipe(self):
    91	        suppression = nosec._resolve_selector("B602 | B607", self.ENABLED, "nosec")
    92	        self.assertEqual({"B602", "B607"}, suppression.tests)
    93	
    94	    def test_intersection(self):
    95	        suppression = nosec._resolve_selector(
    96	            "B60* & B602", self.ENABLED, "nosec"
    97	        )
    98	        self.assertEqual({"B602"}, suppression.tests)
    99	
   100	    def test_difference(self):
   101	        suppression = nosec._resolve_selector(
   102	            "B60* - B602", self.ENABLED, "nosec"
   103	        )
   104	        self.assertEqual({"B601", "B603", "B607", "B608"}, suppression.tests)
   105	
   106	    def test_negation(self):
   107	        suppression = nosec._resolve_selector("!B602", self.ENABLED, "nosec")
   108	        self.assertEqual(self.ENABLED - {"B602"}, suppression.tests)
   109	
   110	    def test_glob(self):
   111	        suppression = nosec._resolve_selector("B60*", self.ENABLED, "nosec")
   112	        self.assertEqual({"B601", "B602", "B603", "B607", "B608"}, suppression.tests)
   113	
   114	    def test_parenthesized(self):
   115	        suppression = nosec._resolve_selector(
   116	            "(B602 | B607) & !B607", self.ENABLED, "nosec"
   117	        )
   118	        self.assertEqual({"B602"}, suppression.tests)
   119	
   120	    def test_fallback_union(self):
   121	        suppression = nosec._resolve_selector(
   122	            "B602 &", self.ENABLED, "nosec"
   123	        )
   124	        self.assertEqual({"B602"}, suppression.tests)
   125	
   126	    def test_unknown_token_nosec_backwards_compat(self):
   127	        # Historically `# nosec <unknown text>` was a blanket suppression.
   128	        suppression = nosec._resolve_selector("on the line", self.ENABLED, "nosec")
   129	        self.assertTrue(suppression.is_blanket)
   130	
   131	    def test_unknown_token_begin_is_none(self):
   132	        suppression = nosec._resolve_selector("on the line", self.ENABLED, "begin")
   133	        self.assertTrue(suppression.is_none)
   134	
   135	    def test_case_insensitive_all(self):
   136	        suppression = nosec._resolve_selector("ALL", self.ENABLED, "nosec")
   137	        self.assertTrue(suppression.is_blanket)
   138	
