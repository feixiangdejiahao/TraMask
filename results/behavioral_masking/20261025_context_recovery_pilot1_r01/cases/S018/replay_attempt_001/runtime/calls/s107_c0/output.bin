    45	    def test_combine_none_ignored(self):
    46	        combined = nosec.combine_suppressions(
    47	            [nosec.Suppression.none(), nosec.Suppression.specific(["B602"])]
    48	        )
    49	        self.assertEqual({"B602"}, combined.tests)
    50	
    51	    def test_combine_empty(self):
    52	        self.assertIsNone(nosec.combine_suppressions([]))
    53	        self.assertIsNone(nosec.combine_suppressions([nosec.Suppression.none()]))
    54	
