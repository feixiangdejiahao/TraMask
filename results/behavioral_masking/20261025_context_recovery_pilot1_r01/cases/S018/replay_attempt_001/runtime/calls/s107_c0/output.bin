   140	class DirectiveParseTests(testtools.TestCase):
   141	    ENABLED = {"B602", "B607"}
   142	
   143	    def test_plain_nosec(self):
   144	        directives = nosec.parse_directives("# nosec B602", 1, self.ENABLED)
   145	        self.assertEqual(1, len(directives))
   146	        self.assertEqual("nosec", directives[0].type)
   147	        self.assertEqual({"B602"}, directives[0].suppression.tests)
   148	
   149	    def test_begin(self):
   150	        directives = nosec.parse_directives("# nosec-begin B602", 1, self.ENABLED)
   151	        self.assertEqual(1, len(directives))
   152	        self.assertEqual("begin", directives[0].type)
   153	        self.assertEqual({"B602"}, directives[0].suppression.tests)
   154	
   155	    def test_end(self):
   156	        directives = nosec.parse_directives(
   157	            "# nosec-end extra text ignored", 1, self.ENABLED
   158	        )
   159	        self.assertEqual(1, len(directives))
   160	        self.assertEqual("end", directives[0].type)
   161	
   162	    def test_next_line(self):
   163	        directives = nosec.parse_directives(
   164	            "# nosec-next-line B602", 1, self.ENABLED
   165	        )
   166	        self.assertEqual(1, len(directives))
   167	        self.assertEqual("next_line", directives[0].type)
   168	
   169	    def test_case_insensitive_keywords(self):
   170	        directives = nosec.parse_directives("# NOSEC-BEGIN B602", 1, self.ENABLED)
   171	        self.assertEqual("begin", directives[0].type)
   172	        directives = nosec.parse_directives("# nosec-NEXT-LINE B602", 1, self.ENABLED)
   173	        self.assertEqual("next_line", directives[0].type)
   174	        directives = nosec.parse_directives("# NOSEC-END", 1, self.ENABLED)
   175	        self.assertEqual("end", directives[0].type)
   176	
   177	    def test_multiple_directives_in_one_comment(self):
   178	        directives = nosec.parse_directives(
   179	            "# nosec-begin B602 # nosec-end", 1, self.ENABLED
   180	        )
