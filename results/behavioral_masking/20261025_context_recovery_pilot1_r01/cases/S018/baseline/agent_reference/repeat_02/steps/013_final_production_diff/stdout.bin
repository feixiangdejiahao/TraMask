diff --git a/bandit/core/tester.py b/bandit/core/tester.py
index 32642a5..327bbe9 100644
--- a/bandit/core/tester.py
+++ b/bandit/core/tester.py
@@ -130,7 +130,6 @@ class BanditTester:
         :param test_result: optional test result
         :return: set of tests to skip for the line based on contexts
         """
-        nosec_tests_to_skip = set()
         base_tests = (
             self.nosec_lines.get(test_result.lineno, None)
             if test_result
@@ -143,15 +142,19 @@ class BanditTester:
         # empty set indicates blanket nosec comment without
         # individual test names or ids
         if base_tests is None and context_tests is None:
-            nosec_tests_to_skip = None
-
-        # combine tests from current line and context line
-        if base_tests is not None:
-            nosec_tests_to_skip.update(base_tests)
-        if context_tests is not None:
-            nosec_tests_to_skip.update(context_tests)
-
-        return nosec_tests_to_skip
+            return None
+
+        # Combine suppressions from the finding's reported line and any other
+        # line in the same statement (context linerange). Blanket suppression
+        # (empty set) dominates and must not be "narrowed" by unioning with a
+        # specific set, as that would break skip metrics and semantics.
+        if base_tests is None:
+            return set(context_tests)
+        if context_tests is None:
+            return set(base_tests)
+        if not base_tests or not context_tests:
+            return set()
+        return set(base_tests) | set(context_tests)
 
     @staticmethod
     def report_error(test, context, error):
diff --git a/bandit/core/utils.py b/bandit/core/utils.py
index 7feb214..d53d3b3 100644
--- a/bandit/core/utils.py
+++ b/bandit/core/utils.py
@@ -219,7 +219,33 @@ def calc_linerange(node):
 def linerange(node):
     """Get line number range from a node."""
     if hasattr(node, "lineno"):
-        return list(range(node.lineno, node.end_lineno + 1))
+        # Most expression nodes (e.g. multiline calls) can safely use the full
+        # span so that a suppression comment on any line of the statement
+        # applies to findings reported for that statement.
+        #
+        # For compound statements with bodies (def/class/if/for/try/with/etc.),
+        # using the full span would incorrectly propagate a header-line nosec
+        # across the entire nested suite. Preserve baseline behavior by
+        # restricting these to the header line only.
+        compound_header_only = (
+            ast.FunctionDef,
+            ast.AsyncFunctionDef,
+            ast.ClassDef,
+            ast.If,
+            ast.For,
+            ast.AsyncFor,
+            ast.While,
+            ast.Try,
+            ast.With,
+            ast.AsyncWith,
+            getattr(ast, "Match", ()),  # py>=3.10
+        )
+        if isinstance(node, compound_header_only):
+            return [node.lineno]
+        end = getattr(node, "end_lineno", None)
+        if isinstance(end, int) and end >= node.lineno:
+            return list(range(node.lineno, end + 1))
+        return [node.lineno]
     else:
         if hasattr(node, "_bandit_linerange_stripped"):
             lines_minmax = node._bandit_linerange_stripped
@@ -391,8 +417,15 @@ def check_ast_node(name):
 
 
 def get_nosec(nosec_lines, context):
+    combined = None
     for lineno in context["linerange"]:
         nosec = nosec_lines.get(lineno, None)
-        if nosec is not None:
-            return nosec
-    return None
+        if nosec is None:
+            continue
+        if combined is None:
+            combined = set(nosec)
+        elif not combined or not nosec:
+            return set()
+        else:
+            combined.update(nosec)
+    return combined
