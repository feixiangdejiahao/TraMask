   185						const submitPrefix = hasGuide ? styleText('gray', S_BAR) : '';
   186						return `${headings.join('\n')}\n${submitPrefix}${label}`;
   187					}
   188	
   189					case 'cancel': {
   190						const userInputText = userInput
