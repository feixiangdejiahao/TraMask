   235							this.filteredOptions.length === 0 && userInput
   236								? [`${guidePrefix}${styleText('yellow', 'No matches found')}`]
   237								: [];
   238	
   239						const validationError =
   240							this.state === 'error' ? [`${guidePrefix}${styleText('yellow', this.error)}`] : [];
   241	
   242						if (hasGuide) {
   243							headings.push(`${guidePrefix.trimEnd()}`);
   244						}
   245						headings.push(
   246							`${guidePrefix}${styleText('dim', 'Search:')}${searchText}${matches}`,
   247							...noResults,
   248							...validationError
   249						);
