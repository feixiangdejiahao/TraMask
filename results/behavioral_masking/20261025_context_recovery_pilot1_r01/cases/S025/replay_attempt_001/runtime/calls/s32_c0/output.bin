   209					}
   210	
   211					default: {
   212						const barStyle = this.state === 'error' ? 'yellow' : 'cyan';
   213						const guidePrefix = hasGuide ? `${styleText(barStyle, S_BAR)}  ` : '';
   214						const guidePrefixEnd = hasGuide ? styleText(barStyle, S_BAR_END) : '';
   215						// Display cursor position - show plain text in navigation mode
   216						let searchText = '';
