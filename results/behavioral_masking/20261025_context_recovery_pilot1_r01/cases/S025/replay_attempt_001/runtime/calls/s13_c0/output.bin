     1	import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
     2	import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
     3	import { isCancel } from '../src/index.js';
     4	import { MockReadable, MockWritable } from './test-utils.js';
     5	
     6	describe('autocomplete', () => {
     7		let input: MockReadable;
     8		let output: MockWritable;
     9		const testOptions = [
    10			{ value: 'apple', label: 'Apple' },
    11			{ value: 'banana', label: 'Banana' },
    12			{ value: 'cherry', label: 'Cherry' },
    13			{ value: 'grape', label: 'Grape' },
    14			{ value: 'orange', label: 'Orange' },
    15		];
    16	
    17		beforeEach(() => {
    18			input = new MockReadable();
    19			output = new MockWritable();
    20		});
    21	
    22		afterEach(() => {
    23			vi.restoreAllMocks();
    24		});
    25	
    26		test('renders initial UI with message and instructions', async () => {
    27			const result = autocomplete({
    28				message: 'Select a fruit',
    29				options: testOptions,
    30				input,
    31				output,
    32			});
    33	
    34			input.emit('keypress', '', { name: 'return' });
    35			await result;
    36			expect(output.buffer).toMatchSnapshot();
    37		});
    38	
    39		test('limits displayed options when maxItems is set', async () => {
    40			const options = [];
    41			for (let i = 0; i < 10; i++) {
    42				options.push({ value: `option ${i}`, label: `Option ${i}` });
    43			}
    44	
    45			const result = autocomplete({
    46				message: 'Select an option',
    47				options,
    48				maxItems: 6,
    49				input,
    50				output,
    51			});
    52	
    53			input.emit('keypress', '', { name: 'return' });
    54			await result;
    55			expect(output.buffer).toMatchSnapshot();
    56		});
    57	
    58		test('shows no matches message when search has no results', async () => {
    59			const result = autocomplete({
    60				message: 'Select a fruit',
    61				options: testOptions,
    62				input,
    63				output,
    64			});
    65	
    66			// Type something that won't match
    67			input.emit('keypress', 'z', { name: 'z' });
    68			input.emit('keypress', '', { name: 'return' });
    69			await result;
    70			expect(output.buffer).toMatchSnapshot();
    71		});
    72	
    73		test('shows hint when option has hint and is focused', async () => {
    74			const result = autocomplete({
    75				message: 'Select a fruit',
    76				options: [...testOptions, { value: 'kiwi', label: 'Kiwi', hint: 'New Zealand' }],
    77				input,
    78				output,
    79			});
    80	
    81			// Navigate to the option with hint
    82			input.emit('keypress', '', { name: 'down' });
    83			input.emit('keypress', '', { name: 'down' });
    84			input.emit('keypress', '', { name: 'down' });
    85			input.emit('keypress', '', { name: 'down' });
    86			input.emit('keypress', '', { name: 'down' });
    87			input.emit('keypress', '', { name: 'return' });
    88			await result;
    89			expect(output.buffer).toMatchSnapshot();
    90		});
    91	
    92		test('shows selected value in submit state', async () => {
    93			const result = autocomplete({
    94				message: 'Select a fruit',
    95				options: testOptions,
    96				input,
    97				output,
    98			});
    99	
   100			// Select an option and submit
   101			input.emit('keypress', '', { name: 'down' });
   102			input.emit('keypress', '', { name: 'return' });
   103	
   104			const value = await result;
   105			expect(value).toBe('banana');
   106			expect(output.buffer).toMatchSnapshot();
   107		});
   108	
   109		test('shows strikethrough in cancel state', async () => {
   110			const result = autocomplete({
   111				message: 'Select a fruit',
   112				options: testOptions,
   113				input,
   114				output,
   115			});
   116	
   117			// Cancel with Ctrl+C
   118			input.emit('keypress', '\x03', { name: 'c', ctrl: true });
   119	
   120			const value = await result;
   121			expect(typeof value === 'symbol').toBe(true);
   122			expect(output.buffer).toMatchSnapshot();
   123		});
   124	
   125		test('renders placeholder if set', async () => {
   126			const result = autocomplete({
   127				message: 'Select a fruit',
   128				placeholder: 'Type to search...',
   129				options: testOptions,
   130				input,
   131				output,
   132			});
   133	
   134			input.emit('keypress', '', { name: 'return' });
   135			const value = await result;
   136			expect(output.buffer).toMatchSnapshot();
   137			expect(value).toBe('apple');
   138		});
   139	
   140		test('Tab with placeholder fills input and Enter submits matching option', async () => {
   141			const result = autocomplete({
   142				message: 'Select a fruit',
   143				placeholder: 'apple',
   144				options: testOptions,
   145				input,
   146				output,
   147			});
   148	
   149			input.emit('keypress', '\t', { name: 'tab' });
   150			input.emit('keypress', '', { name: 'return' });
   151			const value = await result;
   152			expect(value).toBe('apple');
   153		});
   154	
   155		test('Tab with non-matching placeholder does not fill input', async () => {
   156			const result = autocomplete({
   157				message: 'Select a fruit',
   158				placeholder: 'Type to search...',
   159				options: testOptions,
   160				input,
   161				output,
   162			});
   163	
   164			input.emit('keypress', '\t', { name: 'tab' });
   165			input.emit('keypress', '', { name: 'return' });
   166			const value = await result;
   167			// Tab did not fill input with placeholder (no option matches), so Enter submits first option
   168			expect(value).toBe('apple');
   169		});
   170	
   171		test('supports initialValue', async () => {
   172			const result = autocomplete({
   173				message: 'Select a fruit',
   174				options: testOptions,
   175				initialValue: 'cherry',
   176				input,
   177				output,
   178			});
   179	
   180			input.emit('keypress', '', { name: 'return' });
   181			const value = await result;
   182	
   183			expect(value).toBe('cherry');
   184			expect(output.buffer).toMatchSnapshot();
   185		});
   186	
   187		test('can be aborted by a signal', async () => {
   188			const controller = new AbortController();
   189			const result = autocomplete({
   190				message: 'foo',
   191				options: testOptions,
   192				input,
   193				output,
   194				signal: controller.signal,
   195			});
   196	
   197			controller.abort();
   198			const value = await result;
   199			expect(isCancel(value)).toBe(true);
   200			expect(output.buffer).toMatchSnapshot();
   201		});
   202	
   203		test('renders bottom ellipsis when items do not fit', async () => {
   204			output.rows = 5;
   205	
   206			const options = [
   207				{
   208					value: Array.from({ length: 4 })
   209						.map((_val, index) => `Line ${index}`)
   210						.join('\n'),
   211				},
   212				{
   213					value: 'Option 2',
   214				},
   215			];
   216	
   217			const result = autocomplete({
   218				message: 'Select an option',
   219				options,
   220				maxItems: 5,
   221				input,
   222				output,
   223			});
   224	
   225			input.emit('keypress', '', { name: 'return' });
   226			await result;
   227			expect(output.buffer).toMatchSnapshot();
   228		});
   229	
   230		test('renders top ellipsis when scrolled down and its do not fit', async () => {
   231			output.rows = 5;
   232	
   233			const options = [
   234				{
   235					value: 'option1',
   236					label: Array.from({ length: 4 })
   237						.map((_val, index) => `Line ${index}`)
   238						.join('\n'),
   239				},
   240				{
   241					value: 'option2',
   242					label: 'Option 2',
   243				},
   244			];
   245	
   246			const result = autocomplete({
   247				message: 'Select an option',
   248				options,
   249				initialValue: 'option2',
   250				maxItems: 5,
   251				input,
   252				output,
   253			});
   254	
   255			input.emit('keypress', '', { name: 'return' });
   256			await result;
   257			expect(output.buffer).toMatchSnapshot();
   258		});
   259	
   260		test('placeholder is shown if set', async () => {
   261			const result = autocomplete({
   262				message: 'Select a fruit',
   263				placeholder: 'Type to search...',
   264				options: testOptions,
   265				input,
   266				output,
   267			});
   268	
   269			input.emit('keypress', 'g', { name: 'g' });
   270			input.emit('keypress', '', { name: 'return' });
   271			const value = await result;
   272			expect(output.buffer).toMatchSnapshot();
   273			expect(value).toBe('grape');
   274		});
   275	
   276		test('displays disabled options correctly', async () => {
   277			const optionsWithDisabled = [...testOptions, { value: 'kiwi', label: 'Kiwi', disabled: true }];
   278			const result = autocomplete({
   279				message: 'Select a fruit',
   280				options: optionsWithDisabled,
   281				input,
   282				output,
   283			});
   284	
   285			for (let i = 0; i < 5; i++) {
   286				input.emit('keypress', '', { name: 'down' });
   287			}
   288			input.emit('keypress', '', { name: 'return' });
   289	
   290			const value = await result;
   291			expect(value).toBe('apple');
   292			expect(output.buffer).toMatchSnapshot();
   293		});
   294	
   295		test('cannot select disabled options when only one left', async () => {
   296			const optionsWithDisabled = [...testOptions, { value: 'kiwi', label: 'Kiwi', disabled: true }];
   297			const result = autocomplete({
   298				message: 'Select a fruit',
   299				options: optionsWithDisabled,
   300				input,
   301				output,
   302			});
   303	
   304			input.emit('keypress', 'k', { name: 'k' });
   305			input.emit('keypress', '', { name: 'return' });
   306	
   307			const value = await result;
   308			expect(value).toBe(undefined);
   309			expect(output.buffer).toMatchSnapshot();
   310		});
   311	});
   312	
   313	describe('autocompleteMultiselect', () => {
   314		let input: MockReadable;
   315		let output: MockWritable;
   316		const testOptions = [
   317			{ value: 'apple', label: 'Apple' },
   318			{ value: 'banana', label: 'Banana' },
   319			{ value: 'cherry', label: 'Cherry' },
   320			{ value: 'grape', label: 'Grape' },
   321			{ value: 'orange', label: 'Orange' },
   322		];
   323	
   324		beforeEach(() => {
   325			input = new MockReadable();
   326			output = new MockWritable();
   327		});
   328	
   329		afterEach(() => {
   330			vi.restoreAllMocks();
   331		});
   332	
   333		test('renders error when empty selection & required is true', async () => {
   334			const result = autocompleteMultiselect({
   335				message: 'Select a fruit',
   336				options: testOptions,
   337				required: true,
   338				input,
   339				output,
   340			});
   341	
   342			input.emit('keypress', '', { name: 'return' });
   343			input.emit('keypress', '', { name: 'tab' });
   344			input.emit('keypress', '', { name: 'return' });
   345			await result;
   346			expect(output.buffer).toMatchSnapshot();
   347		});
   348	
   349		test('can be aborted by a signal', async () => {
   350			const controller = new AbortController();
   351			const result = autocompleteMultiselect({
   352				message: 'foo',
   353				options: testOptions,
   354				input,
   355				output,
   356				signal: controller.signal,
   357			});
   358	
   359			controller.abort();
   360			const value = await result;
   361			expect(isCancel(value)).toBe(true);
   362			expect(output.buffer).toMatchSnapshot();
   363		});
   364	
   365		test('can use navigation keys to select options', async () => {
   366			const result = autocompleteMultiselect({
   367				message: 'Select fruits',
   368				options: testOptions,
   369				input,
   370				output,
   371			});
   372	
   373			input.emit('keypress', '', { name: 'down' });
   374			input.emit('keypress', '', { name: 'space' });
   375			input.emit('keypress', '', { name: 'down' });
   376			input.emit('keypress', '', { name: 'space' });
   377			input.emit('keypress', '', { name: 'return' });
   378	
   379			const value = await result;
   380			expect(value).toEqual(['banana', 'cherry']);
   381			expect(output.buffer).toMatchSnapshot();
   382		});
   383	
   384		test('supports custom filter function', async () => {
   385			const result = autocompleteMultiselect({
   386				message: 'Select fruits',
   387				options: testOptions,
   388				input,
   389				output,
   390				// Custom filter that only matches exact prefix
   391				filter: (search, option) => {
   392					const label = option.label ?? String(option.value ?? '');
   393					return label.toLowerCase().startsWith(search.toLowerCase());
   394				},
   395			});
   396	
   397			// Type 'a' - should match 'Apple' only (not 'Banana' which contains 'a')
   398			input.emit('keypress', 'a', { name: 'a' });
   399			input.emit('keypress', '', { name: 'tab' });
   400			input.emit('keypress', '', { name: 'return' });
   401	
   402			const value = await result;
   403			expect(value).toEqual(['apple']);
   404			expect(output.buffer).toMatchSnapshot();
   405		});
   406	
   407		test('displays disabled options correctly', async () => {
   408			const optionsWithDisabled = [...testOptions, { value: 'kiwi', label: 'Kiwi', disabled: true }];
   409			const result = autocompleteMultiselect({
   410				message: 'Select a fruit',
   411				options: optionsWithDisabled,
   412				input,
   413				output,
   414			});
   415	
   416			for (let i = 0; i < testOptions.length; i++) {
   417				input.emit('keypress', '', { name: 'down' });
   418			}
   419			input.emit('keypress', '', { name: 'tab' });
   420			input.emit('keypress', '', { name: 'return' });
   421	
   422			const value = await result;
   423			expect(value).toEqual(['apple']);
   424			expect(output.buffer).toMatchSnapshot();
   425		});
   426	
   427		test('cannot select disabled options when only one left', async () => {
   428			const optionsWithDisabled = [...testOptions, { value: 'kiwi', label: 'Kiwi', disabled: true }];
   429			const result = autocompleteMultiselect({
   430				message: 'Select a fruit',
   431				options: optionsWithDisabled,
   432				input,
   433				output,
   434			});
   435	
   436			input.emit('keypress', 'k', { name: 'k' });
   437			input.emit('keypress', '', { name: 'tab' });
   438			input.emit('keypress', '', { name: 'return' });
   439	
   440			const value = await result;
   441			expect(value).toEqual([]);
   442			expect(output.buffer).toMatchSnapshot();
   443		});
   444	
   445		test('Tab with placeholder fills input; Enter submits current selection', async () => {
   446			const result = autocompleteMultiselect({
   447				message: 'Select fruits',
   448				placeholder: 'apple',
   449				options: testOptions,
   450				input,
   451				output,
   452			});
   453	
   454			input.emit('keypress', '\t', { name: 'tab' });
   455			input.emit('keypress', '', { name: 'return' });
   456			const value = await result;
   457			expect(value).toEqual([]);
   458		});
   459	});
   460	
   461	describe('autocomplete with custom filter', () => {
   462		let input: MockReadable;
   463		let output: MockWritable;
   464		const testOptions = [
   465			{ value: 'apple', label: 'Apple' },
   466			{ value: 'banana', label: 'Banana' },
   467			{ value: 'cherry', label: 'Cherry' },
   468		];
   469	
   470		beforeEach(() => {
   471			input = new MockReadable();
   472			output = new MockWritable();
   473		});
   474	
   475		afterEach(() => {
   476			vi.restoreAllMocks();
   477		});
   478	
   479		test('uses custom filter function when provided', async () => {
   480			const result = autocomplete({
   481				message: 'Select a fruit',
   482				options: testOptions,
   483				input,
   484				output,
   485				// Custom filter that only matches exact prefix
   486				filter: (search, option) => {
   487					const label = option.label ?? String(option.value ?? '');
   488					return label.toLowerCase().startsWith(search.toLowerCase());
   489				},
   490			});
   491	
   492			// Type 'a' - should match 'Apple' only (not 'Banana' which contains 'a')
   493			input.emit('keypress', 'a', { name: 'a' });
   494			input.emit('keypress', '', { name: 'return' });
   495	
   496			const value = await result;
   497			expect(value).toBe('apple');
   498			expect(output.buffer).toMatchSnapshot();
   499		});
   500	
   501		test('falls back to default filter when not provided', async () => {
   502			const result = autocomplete({
   503				message: 'Select a fruit',
   504				options: testOptions,
   505				input,
   506				output,
   507			});
   508	
   509			// Type 'a' - default filter should match both 'Apple' and 'Banana'
   510			input.emit('keypress', 'a', { name: 'a' });
   511			input.emit('keypress', '', { name: 'return' });
   512	
   513			const value = await result;
   514			// First match should be selected
   515			expect(value).toBe('apple');
   516			expect(output.buffer).toMatchSnapshot();
   517		});
   518	});
