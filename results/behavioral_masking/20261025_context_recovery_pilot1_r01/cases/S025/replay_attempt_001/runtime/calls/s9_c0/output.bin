     1	import { stdin, stdout } from 'node:process';
     2	import readline, { type Key, type ReadLine } from 'node:readline';
     3	import type { Readable, Writable } from 'node:stream';
     4	import { wrapAnsi } from 'fast-wrap-ansi';
     5	import { cursor, erase } from 'sisteransi';
     6	import type { ClackEvents, ClackState } from '../types.js';
     7	import type { Action } from '../utils/index.js';
     8	import {
     9		CANCEL_SYMBOL,
    10		diffLines,
    11		getRows,
    12		isActionKey,
    13		setRawMode,
    14		settings,
    15	} from '../utils/index.js';
    16	
    17	export interface PromptOptions<TValue, Self extends Prompt<TValue>> {
    18		render(this: Omit<Self, 'prompt'>): string | undefined;
    19		initialValue?: any;
    20		initialUserInput?: string;
    21		validate?: ((value: TValue | undefined) => string | Error | undefined) | undefined;
    22		input?: Readable;
    23		output?: Writable;
    24		debug?: boolean;
    25		signal?: AbortSignal;
    26	}
    27	
    28	export default class Prompt<TValue> {
    29		protected input: Readable;
    30		protected output: Writable;
    31		private _abortSignal?: AbortSignal;
    32	
    33		private rl: ReadLine | undefined;
    34		private opts: Omit<PromptOptions<TValue, Prompt<TValue>>, 'render' | 'input' | 'output'>;
    35		private _render: (context: Omit<Prompt<TValue>, 'prompt'>) => string | undefined;
    36		private _track = false;
    37		private _prevFrame = '';
    38		private _subscribers = new Map<string, { cb: (...args: any) => any; once?: boolean }[]>();
    39		protected _cursor = 0;
    40	
    41		public state: ClackState = 'initial';
    42		public error = '';
    43		public value: TValue | undefined;
    44		public userInput = '';
    45	
    46		constructor(options: PromptOptions<TValue, Prompt<TValue>>, trackValue = true) {
    47			const { input = stdin, output = stdout, render, signal, ...opts } = options;
    48	
    49			this.opts = opts;
    50			this.onKeypress = this.onKeypress.bind(this);
    51			this.close = this.close.bind(this);
    52			this.render = this.render.bind(this);
    53			this._render = render.bind(this);
    54			this._track = trackValue;
    55			this._abortSignal = signal;
    56	
    57			this.input = input;
    58			this.output = output;
    59		}
    60	
    61		/**
    62		 * Unsubscribe all listeners
    63		 */
    64		protected unsubscribe() {
    65			this._subscribers.clear();
    66		}
    67	
    68		/**
    69		 * Set a subscriber with opts
    70		 * @param event - The event name
    71		 */
    72		private setSubscriber<T extends keyof ClackEvents<TValue>>(
    73			event: T,
    74			opts: { cb: ClackEvents<TValue>[T]; once?: boolean }
    75		) {
    76			const params = this._subscribers.get(event) ?? [];
    77			params.push(opts);
    78			this._subscribers.set(event, params);
    79		}
    80	
    81		/**
    82		 * Subscribe to an event
    83		 * @param event - The event name
    84		 * @param cb - The callback
    85		 */
    86		public on<T extends keyof ClackEvents<TValue>>(event: T, cb: ClackEvents<TValue>[T]) {
    87			this.setSubscriber(event, { cb });
    88		}
    89	
    90		/**
    91		 * Subscribe to an event once
    92		 * @param event - The event name
    93		 * @param cb - The callback
    94		 */
    95		public once<T extends keyof ClackEvents<TValue>>(event: T, cb: ClackEvents<TValue>[T]) {
    96			this.setSubscriber(event, { cb, once: true });
    97		}
    98	
    99		/**
   100		 * Emit an event with data
   101		 * @param event - The event name
   102		 * @param data - The data to pass to the callback
   103		 */
   104		public emit<T extends keyof ClackEvents<TValue>>(
   105			event: T,
   106			...data: Parameters<ClackEvents<TValue>[T]>
   107		) {
   108			const cbs = this._subscribers.get(event) ?? [];
   109			const cleanup: (() => void)[] = [];
   110	
   111			for (const subscriber of cbs) {
   112				subscriber.cb(...data);
   113	
   114				if (subscriber.once) {
   115					cleanup.push(() => cbs.splice(cbs.indexOf(subscriber), 1));
   116				}
   117			}
   118	
   119			for (const cb of cleanup) {
   120				cb();
   121			}
   122		}
   123	
   124		public prompt() {
   125			return new Promise<TValue | symbol | undefined>((resolve) => {
   126				if (this._abortSignal) {
   127					if (this._abortSignal.aborted) {
   128						this.state = 'cancel';
   129	
   130						this.close();
   131						return resolve(CANCEL_SYMBOL);
   132					}
   133	
   134					this._abortSignal.addEventListener(
   135						'abort',
   136						() => {
   137							this.state = 'cancel';
   138							this.close();
   139						},
   140						{ once: true }
   141					);
   142				}
   143	
   144				this.rl = readline.createInterface({
   145					input: this.input,
   146					tabSize: 2,
   147					prompt: '',
   148					escapeCodeTimeout: 50,
   149					terminal: true,
   150				});
   151				this.rl.prompt();
   152	
   153				if (this.opts.initialUserInput !== undefined) {
   154					this._setUserInput(this.opts.initialUserInput, true);
   155				}
   156	
   157				this.input.on('keypress', this.onKeypress);
   158				setRawMode(this.input, true);
   159				this.output.on('resize', this.render);
   160	
   161				this.render();
   162	
   163				this.once('submit', () => {
   164					this.output.write(cursor.show);
   165					this.output.off('resize', this.render);
   166					setRawMode(this.input, false);
   167					resolve(this.value);
   168				});
   169				this.once('cancel', () => {
   170					this.output.write(cursor.show);
   171					this.output.off('resize', this.render);
   172					setRawMode(this.input, false);
   173					resolve(CANCEL_SYMBOL);
   174				});
   175			});
   176		}
   177	
   178		protected _isActionKey(char: string | undefined, _key: Key): boolean {
   179			return char === '\t';
   180		}
   181	
   182		protected _setValue(value: TValue | undefined): void {
   183			this.value = value;
   184			this.emit('value', this.value);
   185		}
   186	
   187		protected _setUserInput(value: string | undefined, write?: boolean): void {
   188			this.userInput = value ?? '';
   189			this.emit('userInput', this.userInput);
   190			if (write && this._track && this.rl) {
   191				this.rl.write(this.userInput);
   192				this._cursor = this.rl.cursor;
   193			}
   194		}
   195	
   196		protected _clearUserInput(): void {
   197			this.rl?.write(null, { ctrl: true, name: 'u' });
   198			this._setUserInput('');
   199		}
   200	
   201		private onKeypress(char: string | undefined, key: Key) {
   202			if (this._track && key.name !== 'return') {
   203				if (key.name && this._isActionKey(char, key)) {
   204					this.rl?.write(null, { ctrl: true, name: 'h' });
   205				}
   206				this._cursor = this.rl?.cursor ?? 0;
   207				this._setUserInput(this.rl?.line);
   208			}
   209	
   210			if (this.state === 'error') {
   211				this.state = 'active';
   212			}
   213			if (key?.name) {
   214				if (!this._track && settings.aliases.has(key.name)) {
   215					this.emit('cursor', settings.aliases.get(key.name));
   216				}
   217				if (settings.actions.has(key.name as Action)) {
   218					this.emit('cursor', key.name as Action);
   219				}
   220			}
   221			if (char && (char.toLowerCase() === 'y' || char.toLowerCase() === 'n')) {
   222				this.emit('confirm', char.toLowerCase() === 'y');
   223			}
   224	
   225			// Call the key event handler and emit the key event
   226			this.emit('key', char?.toLowerCase(), key);
   227	
   228			if (key?.name === 'return') {
   229				if (this.opts.validate) {
   230					const problem = this.opts.validate(this.value);
   231					if (problem) {
   232						this.error = problem instanceof Error ? problem.message : problem;
   233						this.state = 'error';
   234						this.rl?.write(this.userInput);
   235					}
   236				}
   237				if (this.state !== 'error') {
   238					this.state = 'submit';
   239				}
   240			}
   241	
   242			if (isActionKey([char, key?.name, key?.sequence], 'cancel')) {
   243				this.state = 'cancel';
   244			}
   245	
   246			if (this.state === 'submit' || this.state === 'cancel') {
   247				this.emit('finalize');
   248			}
   249			this.render();
   250			if (this.state === 'submit' || this.state === 'cancel') {
   251				this.close();
   252			}
   253		}
   254	
   255		protected close() {
   256			this.input.unpipe();
   257			this.input.removeListener('keypress', this.onKeypress);
   258			this.output.write('\n');
   259			setRawMode(this.input, false);
   260			this.rl?.close();
   261			this.rl = undefined;
   262			this.emit(`${this.state}`, this.value);
   263			this.unsubscribe();
   264		}
   265	
   266		private restoreCursor() {
   267			const lines =
   268				wrapAnsi(this._prevFrame, process.stdout.columns, { hard: true, trim: false }).split('\n')
   269					.length - 1;
   270			this.output.write(cursor.move(-999, lines * -1));
   271		}
   272	
   273		private render() {
   274			const frame = wrapAnsi(this._render(this) ?? '', process.stdout.columns, {
   275				hard: true,
   276				trim: false,
   277			});
   278			if (frame === this._prevFrame) return;
   279	
   280			if (this.state === 'initial') {
   281				this.output.write(cursor.hide);
   282			} else {
   283				const diff = diffLines(this._prevFrame, frame);
   284				const rows = getRows(this.output);
   285				this.restoreCursor();
   286				if (diff) {
   287					const diffOffsetAfter = Math.max(0, diff.numLinesAfter - rows);
   288					const diffOffsetBefore = Math.max(0, diff.numLinesBefore - rows);
   289					let diffLine = diff.lines.find((line) => line >= diffOffsetAfter);
   290	
   291					if (diffLine === undefined) {
   292						this._prevFrame = frame;
   293						return;
   294					}
   295	
   296					// If a single line has changed, only update that line
   297					if (diff.lines.length === 1) {
   298						this.output.write(cursor.move(0, diffLine - diffOffsetBefore));
   299						this.output.write(erase.lines(1));
   300						const lines = frame.split('\n');
   301						this.output.write(lines[diffLine]);
   302						this._prevFrame = frame;
   303						this.output.write(cursor.move(0, lines.length - diffLine - 1));
   304						return;
   305						// If many lines have changed, rerender everything past the first line
   306					} else if (diff.lines.length > 1) {
   307						if (diffOffsetAfter < diffOffsetBefore) {
   308							diffLine = diffOffsetAfter;
   309						} else {
   310							const adjustedDiffLine = diffLine - diffOffsetBefore;
   311							if (adjustedDiffLine > 0) {
   312								this.output.write(cursor.move(0, adjustedDiffLine));
   313							}
   314						}
   315						this.output.write(erase.down());
   316						const lines = frame.split('\n');
   317						const newLines = lines.slice(diffLine);
   318						this.output.write(newLines.join('\n'));
   319						this._prevFrame = frame;
   320						return;
   321					}
   322				}
   323	
   324				this.output.write(erase.down());
   325			}
   326	
   327			this.output.write(frame);
   328			if (this.state === 'initial') {
   329				this.state = 'active';
   330			}
   331			this._prevFrame = frame;
   332		}
   333	}
