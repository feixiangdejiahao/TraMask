=====COMMON=====
     1	import type { Readable, Writable } from 'node:stream';
     2	import { styleText } from 'node:util';
     3	import type { State } from '@clack/core';
     4	import isUnicodeSupported from 'is-unicode-supported';
     5	
     6	export const unicode = isUnicodeSupported();
     7	export const isCI = (): boolean => process.env.CI === 'true';
     8	export const isTTY = (output: Writable): boolean => {
     9		return (output as Writable & { isTTY?: boolean }).isTTY === true;
    10	};
    11	export const unicodeOr = (c: string, fallback: string) => (unicode ? c : fallback);
    12	export const S_STEP_ACTIVE = unicodeOr('◆', '*');
    13	export const S_STEP_CANCEL = unicodeOr('■', 'x');
    14	export const S_STEP_ERROR = unicodeOr('▲', 'x');
    15	export const S_STEP_SUBMIT = unicodeOr('◇', 'o');
    16	
    17	export const S_BAR_START = unicodeOr('┌', 'T');
    18	export const S_BAR = unicodeOr('│', '|');
    19	export const S_BAR_END = unicodeOr('└', '—');
    20	export const S_BAR_START_RIGHT = unicodeOr('┐', 'T');
    21	export const S_BAR_END_RIGHT = unicodeOr('┘', '—');
    22	
    23	export const S_RADIO_ACTIVE = unicodeOr('●', '>');
    24	export const S_RADIO_INACTIVE = unicodeOr('○', ' ');
    25	export const S_CHECKBOX_ACTIVE = unicodeOr('◻', '[•]');
    26	export const S_CHECKBOX_SELECTED = unicodeOr('◼', '[+]');
    27	export const S_CHECKBOX_INACTIVE = unicodeOr('◻', '[ ]');
    28	export const S_PASSWORD_MASK = unicodeOr('▪', '•');
    29	
    30	export const S_BAR_H = unicodeOr('─', '-');
    31	export const S_CORNER_TOP_RIGHT = unicodeOr('╮', '+');
    32	export const S_CONNECT_LEFT = unicodeOr('├', '+');
    33	export const S_CORNER_BOTTOM_RIGHT = unicodeOr('╯', '+');
    34	export const S_CORNER_BOTTOM_LEFT = unicodeOr('╰', '+');
    35	export const S_CORNER_TOP_LEFT = unicodeOr('╭', '+');
    36	
    37	export const S_INFO = unicodeOr('●', '•');
    38	export const S_SUCCESS = unicodeOr('◆', '*');
    39	export const S_WARN = unicodeOr('▲', '!');
    40	export const S_ERROR = unicodeOr('■', 'x');
    41	
    42	export const symbol = (state: State) => {
    43		switch (state) {
    44			case 'initial':
    45			case 'active':
    46				return styleText('cyan', S_STEP_ACTIVE);
    47			case 'cancel':
    48				return styleText('red', S_STEP_CANCEL);
    49			case 'error':
    50				return styleText('yellow', S_STEP_ERROR);
    51			case 'submit':
    52				return styleText('green', S_STEP_SUBMIT);
    53		}
    54	};
    55	
    56	export const symbolBar = (state: State) => {
    57		switch (state) {
    58			case 'initial':
    59			case 'active':
    60				return styleText('cyan', S_BAR);
    61			case 'cancel':
    62				return styleText('red', S_BAR);
    63			case 'error':
    64				return styleText('yellow', S_BAR);
    65			case 'submit':
    66				return styleText('green', S_BAR);
    67		}
    68	};
    69	
    70	export interface CommonOptions {
    71		input?: Readable;
    72		output?: Writable;
    73		signal?: AbortSignal;
    74		withGuide?: boolean;
    75	}
