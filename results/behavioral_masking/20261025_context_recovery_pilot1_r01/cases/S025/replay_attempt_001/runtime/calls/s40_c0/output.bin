   421							`${styleText('dim', 'Type:')} to search`,
   422						];
   423	
   424						// No results message
   425						const noResults =
   426							this.filteredOptions.length === 0 && userInput
   427								? [`${styleText(barStyle, S_BAR)}  ${styleText('yellow', 'No matches found')}`]
   428								: [];
   429	
   430						const errorMessage =
   431							this.state === 'error'
   432								? [`${styleText(barStyle, S_BAR)}  ${styleText('yellow', this.error)}`]
   433								: [];
   434	
   435						// Calculate header and footer line counts for rowPadding
   436						const headerLines = [
   437							...`${title}${styleText(barStyle, S_BAR)}`.split('\n'),
   438							`${styleText(barStyle, S_BAR)}  ${styleText('dim', 'Search:')} ${searchText}${matches}`,
   439							...noResults,
   440							...errorMessage,
   441						];
   442						const footerLines = [
   443							`${styleText(barStyle, S_BAR)}  ${instructions.join(' • ')}`,
   444							styleText(barStyle, S_BAR_END),
   445						];
