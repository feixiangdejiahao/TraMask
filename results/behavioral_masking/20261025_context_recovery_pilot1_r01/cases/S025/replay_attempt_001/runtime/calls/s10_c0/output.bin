			});
			this.rl.prompt();

			if (this.opts.initialUserInput !== undefined) {
				this._setUserInput(this.opts.initialUserInput, true);
			}

			this.input.on('keypress', this.onKeypress);
			setRawMode(this.input, true);
			this.output.on('resize', this.render);

			this.render();

			this.once('submit', () => {
				this.output.write(cursor.show);
				this.output.off('resize', this.render);
				setRawMode(this.input, false);
				resolve(this.value);
			});
			this.once('cancel', () => {
				this.output.write(cursor.show);
				this.output.off('resize', this.render);
				setRawMode(this.input, false);
				resolve(CANCEL_SYMBOL);
			});
		});
	}

	protected _isActionKey(char: string | undefined, _key: Key): boolean {
		return char === '\t';
	}

	protected _setValue(value: TValue | undefined): void {
		this.value = value;
		this.emit('value', this.value);
	}

	protected _setUserInput(value: string | undefined, write?: boolean): void {
		this.userInput = value ?? '';
		this.emit('userInput', this.userInput);
		if (write && this._track && this.rl) {
			this.rl.write(this.userInput);
			this._cursor = this.rl.cursor;
		}
	}

	protected _clearUserInput(): void {
		this.rl?.write(null, { ctrl: true, name: 'u' });
		this._setUserInput('');
	}

=====PROMPTS AUTCOMP=====
     1	import { styleText } from 'node:util';
     2	import { AutocompletePrompt, settings } from '@clack/core';
     3	import {
     4		type CommonOptions,
     5		S_BAR,
     6		S_BAR_END,
     7		S_CHECKBOX_INACTIVE,
     8		S_CHECKBOX_SELECTED,
     9		S_RADIO_ACTIVE,
    10		S_RADIO_INACTIVE,
    11		symbol,
    12	} from './common.js';
    13	import { limitOptions } from './limit-options.js';
    14	import type { Option } from './select.js';
    15	
    16	function getLabel<T>(option: Option<T>) {
    17		return option.label ?? String(option.value ?? '');
    18	}
    19	
    20	function getFilteredOption<T>(searchText: string, option: Option<T>): boolean {
    21		if (!searchText) {
    22			return true;
    23		}
    24		const label = (option.label ?? String(option.value ?? '')).toLowerCase();
    25		const hint = (option.hint ?? '').toLowerCase();
    26		const value = String(option.value).toLowerCase();
    27		const term = searchText.toLowerCase();
    28	
    29		return label.includes(term) || hint.includes(term) || value.includes(term);
    30	}
    31	
    32	function getSelectedOptions<T>(values: T[], options: Option<T>[]): Option<T>[] {
    33		const results: Option<T>[] = [];
    34	
    35		for (const option of options) {
    36			if (values.includes(option.value)) {
    37				results.push(option);
    38			}
    39		}
    40	
    41		return results;
    42	}
    43	
    44	interface AutocompleteSharedOptions<Value> extends CommonOptions {
    45		/**
    46		 * The message to display to the user.
    47		 */
    48		message: string;
    49		/**
    50		 * Available options for the autocomplete prompt.
    51		 */
    52		options: Option<Value>[] | ((this: AutocompletePrompt<Option<Value>>) => Option<Value>[]);
    53		/**
    54		 * Maximum number of items to display at once.
    55		 */
    56		maxItems?: number;
    57		/**
    58		 * Placeholder text to display when no input is provided.
    59		 */
    60		placeholder?: string;
    61		/**
    62		 * Validates the value
    63		 */
    64		validate?: (value: Value | Value[] | undefined) => string | Error | undefined;
    65		/**
    66		 * Custom filter function to match options against search input.
    67		 * If not provided, a default filter that matches label, hint, and value is used.
    68		 */
    69		filter?: (search: string, option: Option<Value>) => boolean;
    70	}
    71	
    72	export interface AutocompleteOptions<Value> extends AutocompleteSharedOptions<Value> {
    73		/**
    74		 * The initial selected value.
    75		 */
    76		initialValue?: Value;
    77		/**
    78		 * The initial user input
    79		 */
    80		initialUserInput?: string;
    81	}
    82	
    83	export const autocomplete = <Value>(opts: AutocompleteOptions<Value>) => {
    84		const prompt = new AutocompletePrompt({
    85			options: opts.options,
    86			initialValue: opts.initialValue ? [opts.initialValue] : undefined,
    87			initialUserInput: opts.initialUserInput,
    88			placeholder: opts.placeholder,
    89			filter:
    90				opts.filter ??
    91				((search: string, opt: Option<Value>) => {
    92					return getFilteredOption(search, opt);
    93				}),
    94			signal: opts.signal,
    95			input: opts.input,
    96			output: opts.output,
    97			validate: opts.validate,
    98			render() {
    99				const hasGuide = opts.withGuide ?? settings.withGuide;
   100				// Title and message display
   101				const headings = hasGuide
   102					? [`${styleText('gray', S_BAR)}`, `${symbol(this.state)}  ${opts.message}`]
   103					: [`${symbol(this.state)}  ${opts.message}`];
   104				const userInput = this.userInput;
   105				const options = this.options;
   106				const placeholder = opts.placeholder;
   107				const showPlaceholder = userInput === '' && placeholder !== undefined;
   108				const opt = (option: Option<Value>, state: 'inactive' | 'active' | 'disabled') => {
   109					const label = getLabel(option);
   110					const hint =
   111						option.hint && option.value === this.focusedValue
   112							? styleText('dim', ` (${option.hint})`)
   113							: '';
   114					switch (state) {
   115						case 'active':
   116							return `${styleText('green', S_RADIO_ACTIVE)} ${label}${hint}`;
   117						case 'inactive':
   118							return `${styleText('dim', S_RADIO_INACTIVE)} ${styleText('dim', label)}`;
   119						case 'disabled':
   120							return `${styleText('gray', S_RADIO_INACTIVE)} ${styleText(['strikethrough', 'gray'], label)}`;
   121					}
   122				};
   123	
   124				// Handle different states
   125				switch (this.state) {
   126					case 'submit': {
   127						// Show selected value
   128						const selected = getSelectedOptions(this.selectedValues, options);
   129						const label =
   130							selected.length > 0 ? `  ${styleText('dim', selected.map(getLabel).join(', '))}` : '';
   131						const submitPrefix = hasGuide ? styleText('gray', S_BAR) : '';
   132						return `${headings.join('\n')}\n${submitPrefix}${label}`;
   133					}
   134	
   135					case 'cancel': {
   136						const userInputText = userInput
   137							? `  ${styleText(['strikethrough', 'dim'], userInput)}`
   138							: '';
   139						const cancelPrefix = hasGuide ? styleText('gray', S_BAR) : '';
   140						return `${headings.join('\n')}\n${cancelPrefix}${userInputText}`;
   141					}
   142	
   143					default: {
   144						const barStyle = this.state === 'error' ? 'yellow' : 'cyan';
   145						const guidePrefix = hasGuide ? `${styleText(barStyle, S_BAR)}  ` : '';
   146						const guidePrefixEnd = hasGuide ? styleText(barStyle, S_BAR_END) : '';
   147						// Display cursor position - show plain text in navigation mode
   148						let searchText = '';
   149						if (this.isNavigating || showPlaceholder) {
   150							const searchTextValue = showPlaceholder ? placeholder : userInput;
   151							searchText = searchTextValue !== '' ? ` ${styleText('dim', searchTextValue)}` : '';
   152						} else {
   153							searchText = ` ${this.userInputWithCursor}`;
   154						}
   155	
   156						// Show match count if filtered
   157						const matches =
   158							this.filteredOptions.length !== options.length
   159								? styleText(
   160										'dim',
   161										` (${this.filteredOptions.length} match${this.filteredOptions.length === 1 ? '' : 'es'})`
   162									)
   163								: '';
   164	
   165						// No matches message
   166						const noResults =
   167							this.filteredOptions.length === 0 && userInput
   168								? [`${guidePrefix}${styleText('yellow', 'No matches found')}`]
   169								: [];
   170	
   171						const validationError =
   172							this.state === 'error' ? [`${guidePrefix}${styleText('yellow', this.error)}`] : [];
   173	
   174						if (hasGuide) {
   175							headings.push(`${guidePrefix.trimEnd()}`);
   176						}
   177						headings.push(
   178							`${guidePrefix}${styleText('dim', 'Search:')}${searchText}${matches}`,
   179							...noResults,
   180							...validationError
   181						);
   182	
   183						// Show instructions
   184						const instructions = [
   185							`${styleText('dim', '↑/↓')} to select`,
   186							`${styleText('dim', 'Enter:')} confirm`,
   187							`${styleText('dim', 'Type:')} to search`,
   188						];
   189	
   190						const footers = [`${guidePrefix}${instructions.join(' • ')}`, guidePrefixEnd];
   191	
   192						// Render options with selection
   193						const displayOptions =
   194							this.filteredOptions.length === 0
   195								? []
   196								: limitOptions({
   197										cursor: this.cursor,
   198										options: this.filteredOptions,
   199										columnPadding: hasGuide ? 3 : 0, // for `|  ` when guide is shown
   200										rowPadding: headings.length + footers.length,
   201										style: (option, active) => {
   202											return opt(
   203												option,
   204												option.disabled ? 'disabled' : active ? 'active' : 'inactive'
   205											);
   206										},
   207										maxItems: opts.maxItems,
   208										output: opts.output,
   209									});
   210	
   211						// Return the formatted prompt
   212						return [
   213							...headings,
   214							...displayOptions.map((option) => `${guidePrefix}${option}`),
   215							...footers,
   216						].join('\n');
   217					}
   218				}
   219			},
   220		});
   221	
   222		// Return the result or cancel symbol
   223		return prompt.prompt() as Promise<Value | symbol>;
   224	};
   225	
   226	// Type definition for the autocompleteMultiselect component
   227	export interface AutocompleteMultiSelectOptions<Value> extends AutocompleteSharedOptions<Value> {
   228		/**
   229		 * The initial selected values
   230		 */
   231		initialValues?: Value[];
   232		/**
   233		 * If true, at least one option must be selected
   234		 */
   235		required?: boolean;
   236	}
   237	
   238	/**
   239	 * Integrated autocomplete multiselect - combines type-ahead filtering with multiselect in one UI
   240	 */
   241	export const autocompleteMultiselect = <Value>(opts: AutocompleteMultiSelectOptions<Value>) => {
   242		const formatOption = (
   243			option: Option<Value>,
   244			active: boolean,
   245			selectedValues: Value[],
   246			focusedValue: Value | undefined
   247		) => {
   248			const isSelected = selectedValues.includes(option.value);
   249			const label = option.label ?? String(option.value ?? '');
   250			const hint =
   251				option.hint && focusedValue !== undefined && option.value === focusedValue
   252					? styleText('dim', ` (${option.hint})`)
   253					: '';
   254			const checkbox = isSelected
   255				? styleText('green', S_CHECKBOX_SELECTED)
   256				: styleText('dim', S_CHECKBOX_INACTIVE);
   257	
   258			if (option.disabled) {
   259				return `${styleText('gray', S_CHECKBOX_INACTIVE)} ${styleText(['strikethrough', 'gray'], label)}`;
   260			}
   261			if (active) {
   262				return `${checkbox} ${label}${hint}`;
   263			}
   264			return `${checkbox} ${styleText('dim', label)}`;
   265		};
   266	
   267		// Create text prompt which we'll use as foundation
   268		const prompt = new AutocompletePrompt<Option<Value>>({
   269			options: opts.options,
   270			multiple: true,
   271			placeholder: opts.placeholder,
   272			filter:
   273				opts.filter ??
   274				((search, opt) => {
   275					return getFilteredOption(search, opt);
   276				}),
   277			validate: () => {
   278				if (opts.required && prompt.selectedValues.length === 0) {
   279					return 'Please select at least one item';
   280				}
   281				return undefined;
   282			},
   283			initialValue: opts.initialValues,
   284			signal: opts.signal,
   285			input: opts.input,
   286			output: opts.output,
   287			render() {
   288				// Title and symbol
   289				const title = `${styleText('gray', S_BAR)}\n${symbol(this.state)}  ${opts.message}\n`;
   290	
   291				// Selection counter
   292				const userInput = this.userInput;
   293				const placeholder = opts.placeholder;
   294				const showPlaceholder = userInput === '' && placeholder !== undefined;
   295	
   296				// Search input display
   297				const searchText =
   298					this.isNavigating || showPlaceholder
   299						? styleText('dim', showPlaceholder ? placeholder : userInput) // Just show plain text when in navigation mode
   300						: this.userInputWithCursor;
   301	
   302				const options = this.options;
   303	
   304				const matches =
   305					this.filteredOptions.length !== options.length
   306						? styleText(
   307								'dim',
   308								` (${this.filteredOptions.length} match${this.filteredOptions.length === 1 ? '' : 'es'})`
   309							)
   310						: '';
   311	
   312				// Render prompt state
   313				switch (this.state) {
   314					case 'submit': {
   315						return `${title}${styleText('gray', S_BAR)}  ${styleText('dim', `${this.selectedValues.length} items selected`)}`;
   316					}
   317					case 'cancel': {
   318						return `${title}${styleText('gray', S_BAR)}  ${styleText(['strikethrough', 'dim'], userInput)}`;
   319					}
   320					default: {
   321						const barStyle = this.state === 'error' ? 'yellow' : 'cyan';
   322						// Instructions
   323						const instructions = [
   324							`${styleText('dim', '↑/↓')} to navigate`,
   325							`${styleText('dim', this.isNavigating ? 'Space/Tab:' : 'Tab:')} select`,
   326							`${styleText('dim', 'Enter:')} confirm`,
   327							`${styleText('dim', 'Type:')} to search`,
   328						];
   329	
   330						// No results message
   331						const noResults =
   332							this.filteredOptions.length === 0 && userInput
   333								? [`${styleText(barStyle, S_BAR)}  ${styleText('yellow', 'No matches found')}`]
   334								: [];
   335	
   336						const errorMessage =
   337							this.state === 'error'
   338								? [`${styleText(barStyle, S_BAR)}  ${styleText('yellow', this.error)}`]
   339								: [];
   340	
   341						// Calculate header and footer line counts for rowPadding
   342						const headerLines = [
   343							...`${title}${styleText(barStyle, S_BAR)}`.split('\n'),
   344							`${styleText(barStyle, S_BAR)}  ${styleText('dim', 'Search:')} ${searchText}${matches}`,
   345							...noResults,
   346							...errorMessage,
   347						];
   348						const footerLines = [
   349							`${styleText(barStyle, S_BAR)}  ${instructions.join(' • ')}`,
   350							styleText(barStyle, S_BAR_END),
   351						];
   352	
   353						// Get limited options for display
   354						const displayOptions = limitOptions({
   355							cursor: this.cursor,
   356							options: this.filteredOptions,
   357							style: (option, active) =>
   358								formatOption(option, active, this.selectedValues, this.focusedValue),
   359							maxItems: opts.maxItems,
   360							output: opts.output,
   361							rowPadding: headerLines.length + footerLines.length,
   362						});
   363	
   364						// Build the prompt display
   365						return [
   366							...headerLines,
   367							...displayOptions.map((option) => `${styleText(barStyle, S_BAR)}  ${option}`),
   368							...footerLines,
   369						].join('\n');
   370					}
   371				}
   372			},
   373		});
   374	
   375		// Return the result or cancel symbol
   376		return prompt.prompt() as Promise<Value[] | symbol>;
   377	};
