   760	    globPatterns: Array<string | GlobWithOptions>,
   761	    opts: LoadModulesOptions<ESM>,
   762	  ): ESM extends false ? AwilixContainer : Promise<AwilixContainer>
   763	  /**
   764	   * Binds `lib/loadModules` to this container, and provides
   765	   * real implementations of it's dependencies.
   766	   *
   767	   * Additionally, any modules using the `dependsOn` API
   768	   * will be resolved.
   769	   *
   770	   * @see lib/loadModules.js documentation.
   771	   */
   772	  function loadModules<ESM extends boolean = false>(
   773	    globPatterns: Array<string | GlobWithOptions>,
   774	    opts: LoadModulesOptions<ESM>,
   775	  ): Promise<AwilixContainer> | AwilixContainer {
   776	    const _loadModulesDeps = {
   777	      require:
   778	        options!.require ||
   779	        function (uri) {
   780	          // eslint-disable-next-line @typescript-eslint/no-require-imports
   781	          return require(uri)
   782	        },
   783	      listModules,
   784	      container,
   785	    }
   786	    if (opts?.esModules) {
   787	      _loadModulesDeps.require = importModule
   788	      return (
   789	        realLoadModules(
   790	          _loadModulesDeps,
   791	          globPatterns,
   792	          opts,
   793	        ) as Promise<LoadModulesResult>
   794	      ).then(() => container)
   795	    } else {
   796	      realLoadModules(_loadModulesDeps, globPatterns, opts)
   797	      return container
   798	    }
   799	  }
   800	
   801	  /**
   802	   * Disposes this container and it's children, calling the disposer
   803	   * on all disposable registrations and clearing the cache.
   804	   */
   805	  function dispose(): Promise<void> {
   806	    const entries = Array.from(container.cache.entries())
   807	    container.cache.clear()
   808	    return Promise.all(
   809	      entries.map(([, entry]) => {
   810	        const { resolver, value } = entry
   811	        const disposable = resolver as DisposableResolver<any>
   812	        if (disposable.dispose) {
   813	          return Promise.resolve().then(() => disposable.dispose!(value))
   814	        }
   815	        return Promise.resolve()
   816	      }),
   817	    ).then(() => undefined)
   818	  }
   819	}
