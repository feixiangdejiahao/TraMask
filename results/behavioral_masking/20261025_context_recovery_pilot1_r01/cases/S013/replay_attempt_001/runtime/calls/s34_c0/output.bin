   154	    }
   155	    return undefined
   156	  }
   157	
   158	  /**
   159	   * Checks if a registration has been initialized in this container or any parent.
   160	   */
   161	  function hasInitializedValue(name: string | symbol): boolean {
   162	    if (initializedValues.has(name)) {
   163	      return true
   164	    }
   165	    if (parentContainer) {
   166	      return (parentContainer as any)[HAS_INITIALIZED_VALUE](name)
   167	    }
   168	    return false
   169	  }
