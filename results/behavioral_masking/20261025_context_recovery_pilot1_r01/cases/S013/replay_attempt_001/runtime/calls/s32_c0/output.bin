   494	  /**
   495	   * Disposes this container and it's children, calling the disposer
   496	   * on all disposable registrations and clearing the cache.
   497	   */
   498	  function dispose(): Promise<void> {
   499	    const entries = Array.from(container.cache.entries())
   500	    container.cache.clear()
   501	    initializedValues.clear()
   502	    initializationState = { status: 'idle' }
   503	    return Promise.all(
   504	      entries.map(([, entry]) => {
   505	        const { resolver, value } = entry
   506	        const disposable = resolver as DisposableResolver<any>
   507	        if (disposable.dispose) {
   508	          return Promise.resolve().then(() => disposable.dispose!(value))
   509	        }
   510	        return Promise.resolve()
   511	      }),
   512	    ).then(() => undefined)
   513	  }
   514	}
