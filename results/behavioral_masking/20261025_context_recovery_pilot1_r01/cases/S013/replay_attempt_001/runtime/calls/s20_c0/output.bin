   440	            enumerable: true,
   441	            configurable: true,
   442	          }
   443	        }
   444	
   445	        return undefined
   446	      },
   447	    },
   448	  )
   449	
   450	  return proxy
   451	}
   452	
   453	/**
   454	 * Returns a resolve function used to construct the dependency graph
   455	 *
   456	 * @this {Registration}
   457	 * The `this` context is a resolver.
   458	 *
   459	 * @param {Function} fn
   460	 * The function to construct
   461	 *
   462	 * @param {Function} dependencyParseTarget
   463	 * The function to parse for the dependencies of the construction target
   464	 *
   465	 * @param {boolean} isFunction
   466	 * Is the resolution target an actual function or a mask for a constructor?
   467	 *
   468	 * @return {Function}
   469	 * The function used for dependency resolution
   470	 */
   471	function generateResolve(fn: Function, dependencyParseTarget?: Function) {
   472	  // If the function used for dependency parsing is falsy, use the supplied function
   473	  if (!dependencyParseTarget) {
   474	    dependencyParseTarget = fn
   475	  }
   476	
   477	  // Parse out the dependencies
   478	  // NOTE: we do this regardless of whether PROXY is used or not,
   479	  // because if this fails, we want it to fail early (at startup) rather
   480	  // than at resolution time.
   481	  const dependencies = parseDependencies(dependencyParseTarget)
   482	
   483	  // Use a regular function instead of an arrow function to facilitate binding to the resolver.
   484	  return function resolve<T extends object>(
   485	    this: BuildResolver<any>,
   486	    container: AwilixContainer<T>,
   487	  ) {
   488	    // Because the container holds a global reolutionMode we need to determine it in the proper order of precedence:
   489	    // resolver -> container -> default value
   490	    const injectionMode =
   491	      this.injectionMode ||
   492	      container.options.injectionMode ||
   493	      InjectionMode.PROXY
   494	
   495	    if (injectionMode !== InjectionMode.CLASSIC) {
   496	      // If we have a custom injector, we need to wrap the cradle.
   497	      const cradle = this.injector
   498	        ? createInjectorProxy(container, this.injector)
   499	        : container.cradle
   500	
   501	      // Return the target injected with the cradle
   502	      return fn(cradle)
   503	    }
   504	
   505	    // We have dependencies so we need to resolve them manually
   506	    if (dependencies.length > 0) {
   507	      const resolve = this.injector
   508	        ? wrapWithLocals(container, this.injector(container))
   509	        : container.resolve
   510	
   511	      const children = dependencies.map((p) =>
   512	        resolve(p.name, { allowUnregistered: p.optional }),
   513	      )
   514	      return fn(...children)
   515	    }
   516	
   517	    return fn()
   518	  }
   519	}
   520	
   521	/**
   522	 * Parses the dependencies from the given function.
   523	 * If it's a class that extends another class, and it does
   524	 * not have a defined constructor, attempt to parse it's super constructor.
   525	 */
   526	function parseDependencies(fn: Function): Array<Parameter> {
   527	  const result = parseParameterList(fn.toString())
   528	  if (!result) {
   529	    // No defined constructor for a class, check if there is a parent
   530	    // we can parse.
