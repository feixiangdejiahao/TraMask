   520	      registrations[key as any] = resolver
   521	    }
   522	
   523	    return container
   524	  }
   525	
   526	  /**
   527	   * Returned to `util.inspect` and Symbol.toStringTag when attempting to resolve
   528	   * a custom inspector function on the cradle.
   529	   */
   530	  function toStringRepresentationFn() {
   531	    return Object.prototype.toString.call(cradle)
   532	  }
   533	
   534	  /**
