   620	      // of the parents have a shorter lifetime than the one requested, throw an error.
   621	      if (options.strict && !resolver.isLeakSafe) {
   622	        const maybeLongerLifetimeParentIndex = resolutionStack.findIndex(
   623	          ({ lifetime: parentLifetime }) =>
   624	            isLifetimeLonger(parentLifetime, lifetime),
   625	        )
   626	        if (maybeLongerLifetimeParentIndex > -1) {
