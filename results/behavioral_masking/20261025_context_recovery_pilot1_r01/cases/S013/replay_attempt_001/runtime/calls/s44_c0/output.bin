   360	      set: (_target, name: string) => {
   361	        throw new Error(
   362	          `Attempted setting property "${
   363	            name as any
   364	          }" on container cradle - this is not allowed.`,
   365	        )
   366	      },
   367	
   368	      /**
   369	       * Used for `Object.keys`.
   370	       */
   371	      ownKeys() {
   372	        return Array.from(cradle as any)
   373	      },
   374	
   375	      /**
   376	       * Used for `Object.keys`.
   377	       */
   378	      getOwnPropertyDescriptor(target, key) {
   379	        const regs = rollUpRegistrations()
   380	        if (Object.getOwnPropertyDescriptor(regs, key)) {
   381	          return {
   382	            enumerable: true,
   383	            configurable: true,
   384	          }
   385	        }
   386	
   387	        return undefined
   388	      },
   389	    },
   390	  ) as T
   391	
   392	  // The container being exposed.
   393	  const container = {
   394	    options,
   395	    cradle,
   396	    inspect,
   397	    cache: new Map<string | symbol, CacheEntry>(),
   398	    loadModules,
   399	    createScope,
   400	    register: register as any,
   401	    build,
   402	    resolve,
   403	    hasRegistration,
   404	    dispose,
   405	    initialize,
   406	    getRegistration,
   407	    [util.inspect.custom]: inspect,
   408	    [ROLL_UP_REGISTRATIONS!]: rollUpRegistrations,
   409	    [INITIALIZED_VALUES]: initializedValues,
   410	    [FIND_INITIALIZED_VALUE]: findInitializedValue,
   411	    [HAS_INITIALIZED_VALUE]: hasInitializedValue,
   412	    get registrations() {
   413	      return rollUpRegistrations()
   414	    },
   415	  }
   416	
   417	  // Track the family tree.
   418	  const familyTree: Array<AwilixContainer> = parentContainer
   419	    ? [container].concat((parentContainer as any)[FAMILY_TREE])
   420	    : [container]
   421	
   422	  // Save it so we can access it from a scoped container.
   423	  ;(container as any)[FAMILY_TREE] = familyTree
   424	
   425	  // We need a reference to the root container,
   426	  // so we can retrieve and store singletons.
   427	  const rootContainer = last(familyTree)
   428	
   429	  /**
   430	   * Values that have been initialized for this container. Keyed by registration name.
   431	   */
   432	  const initializedValues = new Map<string | symbol, CacheEntry>()
   433	
   434	  type InitializationState =
   435	    | { status: 'idle' }
   436	    | { status: 'initializing'; promise: Promise<InitializeResult> }
   437	    | { status: 'success'; result: InitializeResult }
   438	    | { status: 'failed'; error: Error }
   439	
   440	  /**
   441	   * The initialization state of this container.
   442	   */
   443	  let initializationState: InitializationState = { status: 'idle' }
   444	
   445	  return container
