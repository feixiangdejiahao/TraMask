   948	      for (const name of remaining) {
   949	        const deps = dependencies.get(name) || []
   950	        if (deps.every((depName) => processed.has(depName))) {
   951	          levelEntries.push(byName.get(name)!)
   952	        }
   953	      }
   954	      if (levelEntries.length === 0) {
   955	        // Defensive; cycles are already detected above.
   956	        const first = remaining.values().next().value as string | symbol
   957	        throw new AwilixResolutionError(
   958	          first,
   959	          [],
   960	          'Cyclic dependencies detected.',
