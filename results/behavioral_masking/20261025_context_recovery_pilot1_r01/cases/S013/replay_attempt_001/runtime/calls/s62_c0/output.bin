   866	  /**
   867	   * Builds the initialization plan: registrations with an initializer grouped
   868	   * into dependency levels. Throws AwilixResolutionError if a cycle is detected.
   869	   */
   870	  function buildInitializationPlan(): Array<InitializationLevel> {
   871	    const entries: Array<InitializationEntry> = []
   872	    const localNames = [
   873	      ...Object.keys(registrations),
   874	      ...Object.getOwnPropertySymbols(registrations),
   875	    ]
   876	    for (const name of localNames) {
   877	      const resolver = registrations[name as any] as Resolver<any>
