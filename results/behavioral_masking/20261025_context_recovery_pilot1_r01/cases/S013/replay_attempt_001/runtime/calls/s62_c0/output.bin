   855	  ): Array<string | symbol> {
   856	    const resolve = (resolver as any).resolve
   857	    const dependencies = resolve && resolve.dependencies
   858	    if (!Array.isArray(dependencies)) {
   859	      return []
   860	    }
   861	    return dependencies.map(
   862	      (dep: { name: string | symbol }) => dep.name,
   863	    )
   864	  }
