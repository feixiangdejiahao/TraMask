   895	      string | symbol,
   896	      Array<string | symbol>
   897	    >()
   898	    for (const entry of entries) {
   899	      const deps = getResolverDependencies(entry.resolver).filter(
   900	        (depName) => byName.has(depName),
   901	      )
   902	      dependencies.set(entry.name, deps)
   903	    }
