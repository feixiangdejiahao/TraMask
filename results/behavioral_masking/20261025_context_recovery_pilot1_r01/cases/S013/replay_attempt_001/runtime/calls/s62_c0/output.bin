   937	      visit(entry.name)
   938	    }
   939	
   940	    // Compute levels: a registration is in the current level once all of its
   941	    // initialized dependencies have been processed.
   942	    const levels: Array<InitializationLevel> = []
   943	    const processed = new Set<string | symbol>()
   944	    const remaining = new Set<string | symbol>(entries.map((e) => e.name))
   945	
   946	    while (remaining.size > 0) {
