  1155	  }
  1156	
  1157	  /**
  1158	   * Disposes this container and it's children, calling the disposer
  1159	   * on all disposable registrations and clearing the cache.
  1160	   */
  1161	  function dispose(): Promise<void> {
  1162	    const entries = Array.from(container.cache.entries())
  1163	    container.cache.clear()
  1164	    return Promise.all(
  1165	      entries.map(([, entry]) => {
  1166	        const { resolver, value } = entry
  1167	        const disposable = resolver as DisposableResolver<any>
  1168	        if (disposable.dispose) {
  1169	          return Promise.resolve().then(() => disposable.dispose!(value))
  1170	        }
  1171	        return Promise.resolve()
  1172	      }),
  1173	    ).then(() => undefined)
  1174	  }
  1175	}
