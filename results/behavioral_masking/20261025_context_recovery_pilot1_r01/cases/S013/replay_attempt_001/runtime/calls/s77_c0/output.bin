   600	            return CRADLE_STRING_TAG
   601	          // Edge case: Promise unwrapping will look for a "then" property and attempt to call it.
   602	          // Return undefined so that we won't cause a resolution error. (issue #109)
   603	          case 'then':
   604	            return undefined
   605	          // When using `Array.from` or spreading the cradle, this will
   606	          // return the registration names.
   607	          case Symbol.iterator:
   608	            return cradleIterator
   609	        }
   610	
   611	        if (resolveOpts.allowUnregistered) {
   612	          return undefined
   613	        }
   614	
   615	        throw new AwilixResolutionError(name, resolutionStack)
   616	      }
   617	
   618	      // If this registration has an initializer, it must be initialized before it can be
   619	      // resolved. If it has already been initialized, return the initialized value.
   620	      if (typeof (resolver as any)[INITIALIZER] === 'function') {
   621	        const initializedEntry = findInitializedValue(name)
   622	        if (initializedEntry !== undefined) {
   623	          return initializedEntry.value
   624	        }
   625	        throw new AwilixNotInitializedError(name)
   626	      }
   627	
   628	      const lifetime = resolver.lifetime || Lifetime.TRANSIENT
   629	
   630	      // if we are running in strict mode, this resolver is not explicitly marked leak-safe, and any
   631	      // of the parents have a shorter lifetime than the one requested, throw an error.
   632	      if (options.strict && !resolver.isLeakSafe) {
   633	        const maybeLongerLifetimeParentIndex = resolutionStack.findIndex(
   634	          ({ lifetime: parentLifetime }) =>
   635	            isLifetimeLonger(parentLifetime, lifetime),
   636	        )
   637	        if (maybeLongerLifetimeParentIndex > -1) {
   638	          throw new AwilixResolutionError(
   639	            name,
   640	            resolutionStack,
   641	            `Dependency '${name.toString()}' has a shorter lifetime than its ancestor: '${resolutionStack[
   642	              maybeLongerLifetimeParentIndex
   643	            ].name.toString()}'`,
   644	          )
   645	        }
   646	      }
   647	
   648	      // Pushes the currently-resolving module information onto the stack
   649	      resolutionStack.push({ name, lifetime })
   650	
...
   860	
   861	  /**
   862	   * Builds the initialization plan: registrations with an initializer grouped
   863	   * into dependency levels. Throws AwilixResolutionError if a cycle is detected.
   864	   */
   865	  function buildInitializationPlan(): Array<InitializationLevel> {
   866	    const entries: Array<InitializationEntry> = []
   867	    const localNames = [
   868	      ...Object.keys(registrations),
   869	      ...Object.getOwnPropertySymbols(registrations),
   870	    ]
   871	    for (const name of localNames) {
   872	      const resolver = registrations[name as any] as Resolver<any>
   873	      if (resolver && typeof (resolver as any)[INITIALIZER] === 'function') {
   874	        entries.push({ name, resolver })
   875	      }
   876	    }
   877	
   878	    if (entries.length === 0) {
   879	      return []
   880	    }
   881	
   882	    const byName = new Map<string | symbol, InitializationEntry>()
   883	    const initializedNames = new Set<string | symbol>()
   884	    for (const entry of entries) {
   885	      byName.set(entry.name, entry)
   886	      initializedNames.add(entry.name)
   887	    }
   888	
   889	    // Build a graph over all local registrations. Edges go from a registration
   890	    // to the local registrations it depends on.
   891	    const graph = new Map<string | symbol, Array<string | symbol>>()
   892	    for (const name of localNames) {
   893	      const resolver = registrations[name as any] as Resolver<any>
   894	      graph.set(
   895	        name,
   896	        resolver
   897	          ? getResolverDependencies(resolver).filter((depName) =>
   898	              Object.prototype.hasOwnProperty.call(registrations, depName),
   899	            )
   900	          : [],
   901	      )
   902	    }
   903	
   904	    // For each initialized registration, compute the set of initialized
   905	    // registrations it depends on (directly or through non-initialized
   906	    // registrations). Cycles are detected while traversing.
   907	    const initializedAncestors = new Map<
   908	      string | symbol,
   909	      Set<string | symbol>
   910	    >()
   911	
   912	    const collectAncestors = (
   913	      name: string | symbol,
   914	      visiting: Set<string | symbol>,
   915	    ): Set<string | symbol> => {
   916	      const cached = initializedAncestors.get(name)
   917	      if (cached) {
   918	        return cached
   919	      }
   920	      if (visiting.has(name)) {
   921	        throw new AwilixResolutionError(
   922	          name,
   923	          [],
   924	          'Cyclic dependencies detected.',
   925	        )
   926	      }
   927	      visiting.add(name)
   928	      const result = new Set<string | symbol>()
   929	      for (const depName of graph.get(name) || []) {
   930	        if (visiting.has(depName)) {
   931	          throw new AwilixResolutionError(
   932	            depName,
   933	            [],
   934	            'Cyclic dependencies detected.',
   935	          )
   936	        }
   937	        if (initializedNames.has(depName)) {
   938	          result.add(depName)
   939	        }
   940	        const depAncestors = collectAncestors(depName, visiting)
   941	        for (const ancestor of depAncestors) {
   942	          result.add(ancestor)
   943	        }
   944	      }
   945	      visiting.delete(name)
   946	      initializedAncestors.set(name, result)
   947	      return result
   948	    }
   949	
   950	    for (const entry of entries) {
   951	      collectAncestors(entry.name, new Set<string | symbol>())
   952	    }
   953	
   954	    // Compute levels: an initialized registration is in the current level once
   955	    // all of its initialized ancestors have been processed.
   956	    const levels: Array<InitializationLevel> = []
   957	    const processed = new Set<string | symbol>()
   958	    const remaining = new Set<string | symbol>(entries.map((e) => e.name))
   959	
   960	    while (remaining.size > 0) {
   961	      const levelEntries: Array<InitializationEntry> = []
   962	      for (const name of remaining) {
   963	        const ancestors = initializedAncestors.get(name) || new Set()
   964	        let ready = true
   965	        for (const ancestor of ancestors) {
   966	          if (!processed.has(ancestor)) {
   967	            ready = false
   968	            break
   969	          }
   970	        }
   971	        if (ready) {
   972	          levelEntries.push(byName.get(name)!)
   973	        }
   974	      }
   975	      if (levelEntries.length === 0) {
   976	        // Defensive; cycles are already detected above.
   977	        const first = remaining.values().next().value as string | symbol
   978	        throw new AwilixResolutionError(
   979	          first,
   980	          [],
   981	          'Cyclic dependencies detected.',
   982	        )
   983	      }
   984	      for (const entry of levelEntries) {
   985	        processed.add(entry.name)
   986	        remaining.delete(entry.name)
   987	      }
   988	      levels.push({ entries: levelEntries })
   989	    }
   990	
   991	    return levels
   992	  }
   993	
   994	  /**
   995	   * Initializes the container. Resolves all registrations with an `initializer`
   996	   * in dependency order, running initializers within a level concurrently.
   997	   */
   998	  function initialize(
   999	    options: InitializeOptions = {},
  1000	  ): Promise<InitializeResult> {
  1001	    if (initializationState.status === 'success') {
  1002	      return Promise.resolve(initializationState.result)
  1003	    }
  1004	    if (initializationState.status === 'failed') {
  1005	      return Promise.reject(
  1006	        new Error(
  1007	          'Cannot re-initialize the container because it previously failed.',
  1008	        ),
  1009	      )
  1010	    }
