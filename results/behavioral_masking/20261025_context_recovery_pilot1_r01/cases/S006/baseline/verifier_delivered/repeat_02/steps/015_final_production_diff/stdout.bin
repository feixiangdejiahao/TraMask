diff --git a/parser/lexer.go b/parser/lexer.go
index 4a9e6c1..b7fd4a8 100644
--- a/parser/lexer.go
+++ b/parser/lexer.go
@@ -87,6 +87,11 @@ func (s *Scanner) Init(src string) {
 	s.src = []rune(src)
 }
 
+// Source returns the source code.
+func (s *Scanner) Source() string {
+	return string(s.src)
+}
+
 // Scan analyses token, and decide identify or literals.
 func (s *Scanner) Scan() (tok int, lit string, pos ast.Position, err error) {
 retry:
@@ -587,10 +592,21 @@ func (l *Lexer) Error(msg string) {
 
 // Parse provides way to parse the code using Scanner.
 func Parse(s *Scanner) (ast.Stmt, error) {
+	src := s.Source()
+	newSrc, defaults, err := preprocessDefaultParams(src)
+	if err != nil {
+		return nil, err
+	}
+	if newSrc != src {
+		s = &Scanner{src: []rune(newSrc)}
+	}
 	l := Lexer{s: s}
 	if yyParse(&l) != 0 {
 		return nil, l.e
 	}
+	if err := attachFuncDefaults(l.stmt, defaults); err != nil {
+		return nil, err
+	}
 	return l.stmt, l.e
 }
 
