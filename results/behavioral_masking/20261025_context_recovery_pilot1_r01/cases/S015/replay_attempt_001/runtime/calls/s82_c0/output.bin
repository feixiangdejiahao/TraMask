+    )
+    parser.add_argument(
+        "--warm-cache",
+        dest="warm_cache",
+        action="store_true",
+        default=False,
+        help="pre-populate the cache without reporting issues",
+    )
+    parser.add_argument(
+        "--export-cache",
+        dest="export_cache",
