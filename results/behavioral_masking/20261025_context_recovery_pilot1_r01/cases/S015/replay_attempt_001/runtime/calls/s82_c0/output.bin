         default=False,
         help="exit with 0, " "even with results found",
     )
+    parser.add_argument(
+        "--incremental",
+        dest="incremental",
+        action="store_true",
+        default=None,
+        help="enable incremental analysis using cached results",
+    )
+    parser.add_argument(
+        "--no-incremental",
+        dest="incremental",
+        action="store_false",
+        help="disable incremental analysis (default)",
+    )
+    parser.add_argument(
+        "--cache-dir",
+        dest="cache_dir",
+        action="store",
+        default=None,
+        help="directory to use for the incremental analysis cache",
+    )
+    parser.add_argument(
+        "--cache-size-limit",
+        dest="cache_size_limit",
+        action="store",
+        default=None,
+        type=int,
+        help="maximum size of the cache file in bytes",
+    )
+    parser.add_argument(
+        "--clear-cache",
+        dest="clear_cache",
+        action="store_true",
+        default=False,
+        help="clear the cache directory and exit",
+    )
+    parser.add_argument(
+        "--cache-summary",
+        dest="cache_summary",
+        action="store_true",
+        default=False,
+        help="print the number of files in the cache and exit",
+    )
+    parser.add_argument(
+        "--force-rescan",
+        dest="force_rescan",
+        action="store_true",
+        default=False,
+        help="bypass cache lookups but still store results "
