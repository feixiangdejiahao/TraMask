     1	from __future__ import annotations
     2	
     3	import asyncio
     4	import dataclasses
     5	import sys
     6	from importlib.metadata import version
     7	from pathlib import Path
     8	from typing import TYPE_CHECKING, Dict, Mapping, Tuple
     9	
    10	if sys.version_info >= (3, 11):
    11	    from enum import StrEnum
    12	else:
    13	    from backports.strenum import StrEnum
    14	
    15	from aiohttp import web
    16	from jinja2 import Environment, PackageLoader, select_autoescape
    17	from pydantic import Field
    18	
    19	from .utils import APIParams, check_params
    20	
    21	if TYPE_CHECKING:
    22	    from ..monitor import Monitor
    23	
    24	
    25	@dataclasses.dataclass
    26	class WebUIContext:
    27	    monitor: Monitor
    28	    jenv: Environment
    29	
    30	
    31	class TaskTypes(StrEnum):
    32	    RUNNING = "running"
    33	    TERMINATED = "terminated"
    34	
    35	
    36	class TaskTypeParams(APIParams):
    37	    task_type: TaskTypes = Field(default=TaskTypes.RUNNING)
    38	
    39	
    40	class TaskIdParams(APIParams):
    41	    task_id: str
    42	
    43	
    44	class ListFilterParams(APIParams):
    45	    filter: str = Field(default="")
    46	    persistent: bool = Field(default=False)
    47	
    48	
    49	@dataclasses.dataclass
    50	class NavigationItem:
    51	    title: str
    52	    current: bool
    53	
    54	
    55	nav_menus: Mapping[str, NavigationItem] = {
    56	    "/": NavigationItem(
    57	        title="Dashboard",
    58	        current=False,
    59	    ),
    60	    "/about": NavigationItem(
    61	        title="About",
    62	        current=False,
    63	    ),
    64	}
    65	
    66	
    67	ctx_key = web.AppKey("ctx_key", WebUIContext)
    68	
    69	
    70	def get_navigation_info(
    71	    route: str,
    72	) -> Tuple[NavigationItem, Mapping[str, NavigationItem]]:
    73	    nav_items: Dict[str, NavigationItem] = {}
    74	    current_item = None
    75	    for path, item in nav_menus.items():
    76	        is_current = path == route
    77	        nav_items[path] = NavigationItem(title=item.title, current=is_current)
    78	        if is_current:
    79	            current_item = item
    80	    if current_item is None:
    81	        raise web.HTTPNotFound
    82	    return current_item, nav_items
    83	
    84	
    85	async def show_list_page(request: web.Request) -> web.Response:
    86	    ctx: WebUIContext = request.app[ctx_key]
    87	    nav_info, nav_items = get_navigation_info(request.path)
    88	    template = ctx.jenv.get_template("index.html")
    89	    async with check_params(request, TaskTypeParams) as params:
    90	        output = template.render(
    91	            navigation=nav_items,
    92	            page={
    93	                "title": nav_info.title,
    94	            },
    95	            current_list_type=params.task_type,
    96	            list_types=[
    97	                {"id": TaskTypes.RUNNING, "title": "Running"},
    98	                {"id": TaskTypes.TERMINATED, "title": "Terminated"},
    99	            ],
   100	        )
   101	        return web.Response(body=output, content_type="text/html")
   102	
   103	
   104	async def show_about_page(request: web.Request) -> web.Response:
   105	    ctx: WebUIContext = request.app[ctx_key]
   106	    nav_info, nav_items = get_navigation_info(request.path)
   107	    template = ctx.jenv.get_template("about.html")
   108	    output = template.render(
   109	        navigation=nav_items,
   110	        page={
   111	            "title": nav_info.title,
   112	        },
   113	    )
   114	    return web.Response(body=output, content_type="text/html")
   115	
   116	
   117	async def show_trace_page(request: web.Request) -> web.Response:
   118	    ctx: WebUIContext = request.app[ctx_key]
   119	    template = ctx.jenv.get_template("trace.html")
   120	    async with check_params(request, TaskIdParams) as params:
   121	        if request.path.startswith("/trace-running"):
   122	            trace_data = ctx.monitor.format_running_task_stack(params.task_id)
   123	        elif request.path.startswith("/trace-terminated"):
   124	            trace_data = ctx.monitor.format_terminated_task_stack(params.task_id)
   125	        else:
   126	            raise RuntimeError("should not reach here")
   127	        output = template.render(
   128	            navigation=nav_menus,
   129	            page={
   130	                "title": f"Task trace for {params.task_id}",
   131	            },
   132	            trace_data=trace_data,
   133	        )
   134	        return web.Response(body=output, content_type="text/html")
   135	
   136	
   137	async def get_version(request: web.Request) -> web.Response:
   138	    return web.json_response(
   139	        data={
   140	            "value": version("aiomonitor"),
   141	        }
   142	    )
   143	
   144	
   145	async def get_task_count(request: web.Request) -> web.Response:
   146	    async with check_params(request, TaskTypeParams) as params:
   147	        ctx: WebUIContext = request.app[ctx_key]
   148	        if params.task_type == TaskTypes.RUNNING:
   149	            count = len(asyncio.all_tasks(ctx.monitor._monitored_loop))
   150	        elif params.task_type == TaskTypes.TERMINATED:
   151	            count = len(ctx.monitor._terminated_history)
   152	        else:
   153	            raise RuntimeError("should not reach here")
   154	        return web.json_response(
   155	            data={
   156	                "value": count,
   157	            }
   158	        )
   159	
   160	
   161	async def get_live_task_list(request: web.Request) -> web.Response:
   162	    ctx: WebUIContext = request.app[ctx_key]
   163	    async with check_params(request, ListFilterParams) as params:
   164	        tasks = ctx.monitor.format_running_task_list(
   165	            params.filter,
   166	            params.persistent,
   167	        )
   168	        return web.json_response(
   169	            data={
   170	                "tasks": [
   171	                    {
   172	                        "task_id": t.task_id,
   173	                        "state": t.state,
   174	                        "name": t.name,
   175	                        "coro": t.coro,
   176	                        "created_location": t.created_location,
   177	                        "since": t.since,
   178	                        "is_root": t.created_location == "-",
   179	                    }
   180	                    for t in tasks
   181	                ]
   182	            }
   183	        )
   184	
   185	
   186	async def get_terminated_task_list(request: web.Request) -> web.Response:
   187	    ctx: WebUIContext = request.app[ctx_key]
   188	    async with check_params(request, ListFilterParams) as params:
   189	        tasks = ctx.monitor.format_terminated_task_list(
   190	            params.filter,
   191	            params.persistent,
   192	        )
   193	        return web.json_response(
   194	            data={
   195	                "tasks": [
   196	                    {
   197	                        "task_id": t.task_id,
   198	                        "name": t.name,
   199	                        "coro": t.coro,
   200	                        "started_since": t.started_since,
   201	                        "terminated_since": t.terminated_since,
   202	                    }
   203	                    for t in tasks
   204	                ]
   205	            }
   206	        )
   207	
   208	
   209	async def cancel_task(request: web.Request) -> web.Response:
   210	    ctx: WebUIContext = request.app[ctx_key]
   211	    async with check_params(request, TaskIdParams) as params:
   212	        try:
   213	            coro_repr = await ctx.monitor.cancel_monitored_task(params.task_id)
   214	            return web.json_response(
   215	                data={
   216	                    "msg": f"Successfully cancelled {params.task_id}",
   217	                    "detail": coro_repr,
   218	                },
   219	            )
   220	        except ValueError as e:
   221	            return web.json_response(
   222	                status=404,
   223	                data={"msg": repr(e)},
   224	            )
   225	
   226	
   227	async def init_webui(monitor: Monitor) -> web.Application:
   228	    jenv = Environment(
   229	        loader=PackageLoader("aiomonitor.webui"), autoescape=select_autoescape()
   230	    )
   231	    app = web.Application()
   232	    app[ctx_key] = WebUIContext(
   233	        monitor=monitor,
   234	        jenv=jenv,
   235	    )
   236	    app.router.add_route("GET", "/", show_list_page)
   237	    app.router.add_route("GET", "/about", show_about_page)
   238	    app.router.add_route("GET", "/trace-running", show_trace_page)
   239	    app.router.add_route("GET", "/trace-terminated", show_trace_page)
   240	    app.router.add_route("GET", "/api/version", get_version)
   241	    app.router.add_route("POST", "/api/task-count", get_task_count)
   242	    app.router.add_route("POST", "/api/live-tasks", get_live_task_list)
   243	    app.router.add_route("POST", "/api/terminated-tasks", get_terminated_task_list)
   244	    app.router.add_route("DELETE", "/api/task", cancel_task)
   245	    app.router.add_static("/static", Path(__file__).parent / "static")
   246	    return app
=====UTILS=====
import json
from contextlib import asynccontextmanager as actxmgr
from typing import AsyncIterator, Type, TypeVar

from aiohttp import web
from pydantic import BaseModel, ValidationError


class APIParams(BaseModel):
    pass


T_APIParams = TypeVar("T_APIParams", bound=APIParams)


@actxmgr
async def check_params(
    request: web.Request,
    model_class: Type[T_APIParams],
) -> AsyncIterator[T_APIParams]:
    try:
        if request.method in ("GET", "DELETE"):
            data = dict(request.query)
        else:
            body = await request.post()
            data = {k: str(v) for k, v in body.items()}
        params = model_class.model_validate(data)
    except ValidationError as e:
        error_messages = []
        for error in e.errors():
            field = ".".join(str(loc) for loc in error["loc"])
            message = error["msg"]
            error_messages.append(f"{field}: {message}")
        detail = "\n".join(error_messages)
        raise web.HTTPBadRequest(
            content_type="application/json",
            body=json.dumps({"msg": "Invalid parameters", "detail": detail}),
        ) from None
    try:
        yield params
    except Exception as e:
        raise web.HTTPInternalServerError(
            content_type="application/json",
            body=json.dumps({"msg": "Internal server error", "detail": repr(e)}),
        ) from e
