     1	{% extends "layout.html" %}
     2	{% block head_content %}
     3	<div class="border-b border-gray-200" x-data="{ current_id: '{{ current_list_type }}'}">
     4	  <nav class="-mb-px flex space-x-8" aria-label="Tabs">
     5	    {% for item in list_types %}
     6	    <a href="?task_type={{ item.id }}"
     7	       class="whitespace-nowrap border-b-2 py-2 px-1 text-sm font-medium"
     8	       x-bind:class="current_id == '{{ item.id }}'
     9	         ? 'border-indigo-500 text-indigo-600'
    10	         : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'"
    11	        aria-current="page"
    12	    >
    13	      {{ item.title }}
    14	      <span class="inline-flex items-center rounded-full ml-1 px-1.5 py-0.5 text-xs font-medium"
    15	        x-bind:class="'{{item.id}}' == 'running' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-500'"
    16	        hx-post="/api/task-count"
    17	        hx-vals='{"task_type": "{{ item.id }}"}'
    18	        hx-trigger="load,every 2s"
    19	        hx-swap="innerHTML"
    20	        mustache-template="scalar-value"
    21	      ></span>
    22	    </a>
    23	    {% endfor %}
    24	  </nav>
    25	</div>
    26	{% endblock %}
    27	{% block content %}
    28	{% if current_list_type == "running" %}
    29	<div class="flex space-x-2 divide-x divide-gray-200">
    30	  <div class="py-2 px-2">
    31	    <div class="relative">
    32	      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
    33	        <svg fill="none" viewBox="0 0 24 24" stroke-width="2.0" stroke="currentColor" class="w-5 h-5 text-gray-400">
    34	          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
    35	        </svg>
    36	      </div>
    37	      <input type="text" id="filter-keyword" placeholder="Coro/name filter"
    38	        class="inline-flex w-60 rounded-md border-0 py-1 pl-10 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
    39	        hx-trigger="keyup changed delay:300ms"
    40	        hx-target="#list-body"
    41	        hx-post="/api/live-tasks"
    42	        hx-swap="innerHTML"
    43	        hx-vals="js:{
    44	          persistent: Alpine.store('filters').persistent,
    45	          filter: document.getElementById('filter-keyword').value,
    46	        }"
    47	        mustache-template="live-task-list"
    48	      >
    49	    </div>
    50	  </div>
    51	  <div class="flex items-center gap-x-3 py-2 px-2">
    52	    <label for="filter-persistent" class="block text-sm font-medium leading-6 text-gray-900">Show persistent tasks only</label>
    53	    <button type="button" id="filter-persistent"
    54	      x-data
    55	      class="bg-gray-200 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2"
    56	      x-bind:class="$store.filters.persistent ? 'bg-indigo-600' : 'bg-gray-200'"
    57	      x-bind:aria-checked="$store.filters.persistent"
    58	      @click="$store.filters.persistent = ! $store.filters.persistent; htmx.trigger(document.getElementById('list-body'), 'refresh', {});"
    59	      role="switch"
    60	    >
    61	      <span class="sr-only">Toggle the persistent task filter</span>
    62	      <span aria-hidden="true"
    63	        class="translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
    64	        x-bind:class="$store.filters.persistent ? 'translate-x-5' : 'translate-x-0'"
    65	      ></span>
    66	    </button>
    67	  </div>
    68	</div>
    69	<div class="px-4 sm:px-6 lg:px-8">
    70	  <div class="mt-8 flow-root">
    71	    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    72	      <div class="inline-block min-w-full px-0 py-2 align-middle">
    73	        <table class="min-w-full divide-y divide-gray-300">
    74	          <thead>
    75	            <tr>
    76	              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Task ID</th>
    77	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">State</th>
    78	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
    79	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Coroutine</th>
    80	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Created Loc.</th>
    81	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since</th>
    82	              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
    83	                <span class="sr-only">Action</span>
    84	              </th>
    85	            </tr>
    86	          </thead>
    87	          <tbody id="list-body" class="divide-y divide-gray-200"
    88	            hx-trigger="load,every 2s,refresh from:body"
    89	            hx-post="/api/live-tasks"
    90	            hx-swap="innerHTML"
    91	            hx-vals="js:{
    92	              persistent: Alpine.store('filters').persistent,
    93	              filter: document.getElementById('filter-keyword').value,
    94	            }"
    95	            mustache-template="live-task-list"
    96	          >
    97	          </tbody>
    98	        </table>
    99	      </div>
   100	    </div>
   101	  </div>
   102	</div>
   103	
   104	{% raw %}
   105	<template id="live-task-list">
   106	{{# tasks}}
   107	<tr>
   108	  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ task_id }}</td>
   109	  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ state }}</td>
   110	  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
   111	  <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ coro }}</td>
   112	  <td class="break-all px-1 py-2 font-mono text-xs text-gray-500">{{ created_location }}</td>
   113	  <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ since }}</td>
   114	  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
   115	    {{^is_root}}
   116	    <button
   117	      type="button"
   118	      class="notify-result rounded bg-rose-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-rose-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600 disabled:opacity-50"
   119	      hx-delete="/api/task"
   120	      hx-params="not persistent,filter"
   121	      hx-vals='{"task_id": "{{ task_id }}"}'
   122	      hx-swap="none"
   123	      hx-sync="closest tbody:drop"
   124	      onclick="this.disabled=true"
   125	      >Cancel<img src="/static/loader.svg" class="htmx-indicator button-indicator ml-2 w-3 h-3" /></button>
   126	    {{/is_root}}
   127	    <a
   128	      type="button"
   129	      class="cursor-pointer rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
   130	      href="/trace-running?task_id={{ task_id }}"
   131	    >Trace</a>
   132	  </td>
   133	</tr>
   134	{{/ tasks}}
   135	</template>
   136	{% endraw %}
   137	
   138	{% elif current_list_type == "terminated" %}
   139	
   140	<div class="flex space-x-2 divide-x divide-gray-200">
   141	  <div class="py-2 px-2">
   142	    <div class="relative">
   143	      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
   144	        <svg fill="none" viewBox="0 0 24 24" stroke-width="2.0" stroke="currentColor" class="w-5 h-5 text-gray-400">
   145	          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
   146	        </svg>
   147	      </div>
   148	      <input type="text" id="filter-keyword" placeholder="Coro/name filter"
   149	        class="inline-flex w-60 rounded-md border-0 py-1 pl-10 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
   150	        hx-trigger="keyup changed delay:300ms"
   151	        hx-target="#list-body"
   152	        hx-post="/api/terminated-tasks"
   153	        hx-swap="innerHTML"
   154	        hx-vals="js:{
   155	          persistent: Alpine.store('filters').persistent,
   156	          filter: document.getElementById('filter-keyword').value,
   157	        }"
   158	        mustache-template="terminated-task-list"
   159	      >
   160	    </div>
   161	  </div>
   162	  <div class="flex items-center gap-x-3 py-2 px-2">
   163	    <label for="filter-persistent" class="block text-sm font-medium leading-6 text-gray-900">Show persistent tasks only</label>
   164	    <button type="button" id="filter-persistent"
   165	      x-data
   166	      class="bg-gray-200 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2"
   167	      x-bind:class="$store.filters.persistent ? 'bg-indigo-600' : 'bg-gray-200'"
   168	      x-bind:aria-checked="$store.filters.persistent"
   169	      @click="$store.filters.persistent = ! $store.filters.persistent; htmx.trigger(document.getElementById('list-body'), 'refresh', {});"
   170	      role="switch"
   171	    >
   172	      <span class="sr-only">Toggle the persistent task filter</span>
   173	      <span aria-hidden="true"
   174	        class="translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
   175	        x-bind:class="$store.filters.persistent ? 'translate-x-5' : 'translate-x-0'"
   176	      ></span>
   177	    </button>
   178	  </div>
   179	</div>
   180	<div class="px-4 sm:px-6 lg:px-8">
   181	  <div class="mt-8 flow-root">
   182	    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
   183	      <div class="inline-block min-w-full px-0 py-2 align-middle">
   184	        <table class="min-w-full divide-y divide-gray-300">
   185	          <thead>
   186	            <tr>
   187	              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Task ID</th>
   188	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
   189	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Coroutine</th>
   190	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since Started</th>
   191	              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since Terminated</th>
   192	              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
   193	                <span class="sr-only">Action</span>
   194	              </th>
   195	            </tr>
   196	          </thead>
   197	          <tbody id="list-body" class="divide-y divide-gray-200"
   198	            hx-trigger="load,every 2s,refresh from:body"
   199	            hx-post="/api/terminated-tasks"
   200	            hx-swap="innerHTML"
   201	            hx-vals="js:{
   202	              persistent: Alpine.store('filters').persistent,
   203	              filter: document.getElementById('filter-keyword').value,
   204	            }"
   205	            mustache-template="terminated-task-list"
   206	          >
   207	          </tbody>
   208	        </table>
   209	      </div>
   210	    </div>
   211	  </div>
   212	</div>
   213	
   214	{% raw %}
   215	<template id="terminated-task-list">
   216	{{# tasks}}
   217	<tr>
   218	  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ task_id }}</td>
   219	  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
   220	  <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ coro }}</td>
   221	  <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ started_since }}</td>
   222	  <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ terminated_since }}</td>
   223	  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
   224	    <a
   225	      type="button"
   226	      class="cursor-pointer rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
   227	      href="/trace-terminated?task_id={{ task_id }}"
   228	    >Trace</a>
   229	  </td>
   230	</tr>
   231	{{/ tasks}}
   232	</template>
   233	{% endraw %}
   234	{% endif %}
   235	<script type="text/javascript">
   236	  document.addEventListener("alpine:init", () => {
   237	    Alpine.store("filters", {
   238	      persistent: false,
   239	    });
   240	    console.log("init filters")
   241	  });
   242	</script>
   243	{% endblock %}
