diff --git a/aiomonitor/task.py b/aiomonitor/task.py
index 966965e..ce42f6c 100644
--- a/aiomonitor/task.py
+++ b/aiomonitor/task.py
@@ -75,6 +75,7 @@ class TracedTask(asyncio.Task):
             canceller_stack=None,
             exc_repr=exc_repr,
             persistent=self._persistent,
+            object_id=str(id(self)),
         )
         self._termination_info_queue.put_nowait(task_info)
 
diff --git a/aiomonitor/termui/completion.py b/aiomonitor/termui/completion.py
index 7c4938b..d89cbcd 100644
--- a/aiomonitor/termui/completion.py
+++ b/aiomonitor/termui/completion.py
@@ -88,3 +88,47 @@ def complete_signal_names(
     incomplete: str,
 ) -> Iterable[str]:
     return [sig.name for sig in signal.Signals if sig.name.startswith(incomplete)]
+
+
+def complete_snapshot_id(
+    ctx: click.Context,
+    param: click.Parameter,
+    incomplete: str,
+) -> Iterable[str]:
+    try:
+        self: Monitor = current_monitor.get()
+    except LookupError:
+        return []
+    return [
+        str(snapshot.id)
+        for snapshot in self.list_snapshots()
+        if str(snapshot.id).startswith(incomplete)
+    ][:10]
+
+
+def complete_snapshot_task_id(
+    ctx: click.Context,
+    param: click.Parameter,
+    incomplete: str,
+) -> Iterable[str]:
+    try:
+        self: Monitor = current_monitor.get()
+    except LookupError:
+        return []
+    # The preceding positional argument is the snapshot ID.
+    snapshot_id = ctx.params.get("snapshot_id")
+    if snapshot_id is None and ctx.protected_args:
+        snapshot_id = ctx.protected_args[-1]
+    if snapshot_id is None:
+        return []
+    try:
+        return [
+            task_id
+            for task_id in (
+                info.task_id
+                for info in self.format_snapshot_task_list(snapshot_id)
+            )
+            if task_id.startswith(incomplete)
+        ][:10]
+    except KeyError:
+        return []
diff --git a/aiomonitor/types.py b/aiomonitor/types.py
index 04e5b04..498bb60 100644
--- a/aiomonitor/types.py
+++ b/aiomonitor/types.py
@@ -2,8 +2,8 @@ from __future__ import annotations
 
 import sys
 import traceback
-from dataclasses import dataclass
-from typing import List, NamedTuple, Optional
+from dataclasses import dataclass, field
+from typing import Dict, List, NamedTuple, Optional, Sequence, Union
 
 if sys.version_info >= (3, 11):
     from enum import StrEnum
@@ -52,6 +52,7 @@ class TerminatedTaskInfo:
     canceller_stack: Optional[List[traceback.FrameSummary]] = None
     exc_repr: Optional[str] = None
     persistent: bool = False
+    object_id: Optional[str] = None
 
 
 @dataclass
@@ -59,3 +60,75 @@ class CancellationChain:
     target_id: str
     canceller_id: str
     canceller_stack: Optional[List[traceback.FrameSummary]] = None
+
+
+SnapshotTaskInfo = Union[FormattedLiveTaskInfo, FormattedTerminatedTaskInfo]
+
+
+@dataclass
+class Snapshot:
+    id: int
+    name: Optional[str]
+    captured_at: float
+    running_tasks: Dict[str, FormattedLiveTaskInfo]
+    terminated_tasks: Dict[str, FormattedTerminatedTaskInfo]
+    terminated_object_ids: Dict[str, str] = field(default_factory=dict)
+    stacks: Dict[str, Sequence[FormattedStackItem]] = field(default_factory=dict)
+
+    @property
+    def running_count(self) -> int:
+        return len(self.running_tasks)
+
+    @property
+    def terminated_count(self) -> int:
+        return len(self.terminated_tasks)
+
+
+@dataclass
+class SnapshotSummary:
+    id: int
+    name: Optional[str]
+    running_count: int
+    terminated_count: int
+
+
+@dataclass
+class SnapshotTaskItem:
+    task_id: str
+    kind: str
+    info: SnapshotTaskInfo
+
+    @property
+    def name(self) -> str:
+        return self.info.name
+
+    @property
+    def coro(self) -> str:
+        return self.info.coro
+
+    @property
+    def state(self) -> Optional[str]:
+        return getattr(self.info, "state", None)
+
+    @property
+    def created_location(self) -> Optional[str]:
+        return getattr(self.info, "created_location", None)
+
+    @property
+    def since(self) -> Optional[str]:
+        return getattr(self.info, "since", None)
+
+    @property
+    def started_since(self) -> Optional[str]:
+        return getattr(self.info, "started_since", None)
+
+    @property
+    def terminated_since(self) -> Optional[str]:
+        return getattr(self.info, "terminated_since", None)
+
+
+@dataclass
+class SnapshotDiff:
+    added: List[SnapshotTaskItem]
+    removed: List[SnapshotTaskItem]
+    common: List[SnapshotTaskItem]
