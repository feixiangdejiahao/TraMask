    82	              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
    83	                <span class="sr-only">Action</span>
    84	              </th>
    85	            </tr>
    86	          </thead>
    87	          <tbody id="list-body" class="divide-y divide-gray-200"
    88	            hx-trigger="load,every 2s,refresh from:body"
    89	            hx-post="/api/live-tasks"
    90	            hx-swap="innerHTML"
    91	            hx-vals="js:{
    92	              persistent: Alpine.store('filters').persistent,
    93	              filter: document.getElementById('filter-keyword').value,
    94	            }"
    95	            mustache-template="live-task-list"
    96	          >
    97	          </tbody>
    98	        </table>
    99	      </div>
   100	    </div>
   101	  </div>
   102	</div>
   103	
   104	{% raw %}
   105	<template id="live-task-list">
   106	{{# tasks}}
   107	<tr>
   108	  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ task_id }}</td>
   109	  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ state }}</td>
   110	  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
   111	  <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ coro }}</td>
   112	  <td class="break-all px-1 py-2 font-mono text-xs text-gray-500">{{ created_location }}</td>
   113	  <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ since }}</td>
   114	  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
   115	    {{^is_root}}
   116	    <button
   117	      type="button"
   118	      class="notify-result rounded bg-rose-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-rose-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600 disabled:opacity-50"
   119	      hx-delete="/api/task"
   120	      hx-params="not persistent,filter"
   121	      hx-vals='{"task_id": "{{ task_id }}"}'
   122	      hx-swap="none"
   123	      hx-sync="closest tbody:drop"
   124	      onclick="this.disabled=true"
   125	      >Cancel<img src="/static/loader.svg" class="htmx-indicator button-indicator ml-2 w-3 h-3" /></button>
   126	    {{/is_root}}
   127	    <a
   128	      type="button"
   129	      class="cursor-pointer rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
   130	      href="/trace-running?task_id={{ task_id }}"
   131	    >Trace</a>
   132	  </td>
   133	</tr>
   134	{{/ tasks}}
   135	</template>
   136	{% endraw %}
   137	
   138	{% elif current_list_type == "terminated" %}
   139	
   140	<div class="flex space-x-2 divide-x divide-gray-200">
   141	  <div class="py-2 px-2">
   142	    <div class="relative">
   143	      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
   144	        <svg fill="none" viewBox="0 0 24 24" stroke-width="2.0" stroke="currentColor" class="w-5 h-5 text-gray-400">
   145	          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
   146	        </svg>
   147	      </div>
   148	      <input type="text" id="filter-keyword" placeholder="Coro/name filter"
   149	        class="inline-flex w-60 rounded-md border-0 py-1 pl-10 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
   150	        hx-trigger="keyup changed delay:300ms"
