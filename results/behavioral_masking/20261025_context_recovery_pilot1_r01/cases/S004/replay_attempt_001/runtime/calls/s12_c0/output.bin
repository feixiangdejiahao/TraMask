    67	def print_ok(msg: str) -> None:
    68	    print_formatted_text(
    69	        FormattedText([
    70	            ("ansibrightgreen", "✓ "),
    71	            ("", msg),
    72	        ])
    73	    )
    74	
    75	
    76	def print_fail(msg: str) -> None:
    77	    print_formatted_text(
    78	        FormattedText([
    79	            ("ansibrightred", "✗ "),
    80	            ("", msg),
    81	        ])
    82	    )
