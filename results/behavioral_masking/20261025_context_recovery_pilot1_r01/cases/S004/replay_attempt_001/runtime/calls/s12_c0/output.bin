   527	            print_formatted_text(
   528	                FormattedText([
   529	                    ("ansiwhite", item_text),
   530	                ])
   531	            )
   532	        else:
   533	            stdout.write(textwrap.indent(item_text.strip("\n"), "  "))
   534	            stdout.write("\n")
