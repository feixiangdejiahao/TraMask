    22	var (
    23		registerPlaywrightRoutes []func(apiGroup *gin.RouterGroup, services *Services)
    24		registerBuildableRoutes  []func(apiGroup *gin.RouterGroup, services *Services)
    25	)
    26	
    27	var loggerSkipPatterns = []string{
    28		"POST /api/tunnel/poll",
    29		"GET /api/environments/*/ws/containers/*/logs",
    30		"GET /api/environments/*/ws/containers/*/stats",
    31		"GET /api/environments/*/ws/containers/*/terminal",
    32		"GET /api/environments/*/ws/projects/*/logs",
    33		"GET /api/environments/*/ws/system/stats",
    34		"GET /_app/*",
    35		"GET /img",
    36		"GET /api/fonts/sans",
    37		"GET /api/fonts/mono",
    38		"GET /api/fonts/serif",
    39		"GET /api/health",
    40		"HEAD /api/health",
    41	}
    42	
    43	func shouldLogRequest(c *gin.Context) bool {
    44		mp := c.Request.Method + " " + c.Request.URL.Path
    45		for _, pat := range loggerSkipPatterns {
    46			if pat == mp {
    47				return false
    48			}
    49			if before, ok := strings.CutSuffix(pat, "/*"); ok {
    50				if strings.HasPrefix(mp, before) {
    51					return false
    52				}
    53			}
    54			if ok, _ := path.Match(pat, mp); ok {
    55				return false
    56			}
    57			if strings.HasSuffix(pat, "/") && strings.HasPrefix(mp, pat) {
    58				return false
    59			}
    60		}
    61		return true
    62	}
    63	
    64	func createAuthValidator(appServices *Services) middleware.AuthValidator {
    65		return func(ctx context.Context, c *gin.Context) bool {
    66			// Check for API key authentication
    67			if apiKey := c.GetHeader("X-API-Key"); apiKey != "" {
    68				user, err := appServices.ApiKey.ValidateApiKey(ctx, apiKey)
    69				return err == nil && user != nil
    70			}
    71	
    72			// Check for Bearer token authentication
    73			token := ""
    74			if auth := c.GetHeader("Authorization"); strings.HasPrefix(auth, "Bearer ") {
    75				token = strings.TrimPrefix(auth, "Bearer ")
    76			} else if cookieToken, err := cookie.GetTokenCookie(c); err == nil && cookieToken != "" {
    77				token = cookieToken
    78			}
    79	
    80			if token == "" {
    81				return false
    82			}
    83	
    84			user, err := appServices.Auth.VerifyToken(ctx, token)
    85			return err == nil && user != nil
    86		}
    87	}
    88	
    89	func setupRouter(ctx context.Context, cfg *config.Config, appServices *Services) (*gin.Engine, *edge.TunnelServer) {
    90		if cfg.Environment == "production" {
    91			gin.SetMode(gin.ReleaseMode)
    92		} else {
    93			gin.SetMode(gin.DebugMode)
    94		}
    95		router := gin.New()
    96		router.Use(gin.Recovery())
    97	
    98		router.Use(sloggin.NewWithConfig(slog.Default(), sloggin.Config{
    99			Filters: []sloggin.Filter{shouldLogRequest},
   100		}))
