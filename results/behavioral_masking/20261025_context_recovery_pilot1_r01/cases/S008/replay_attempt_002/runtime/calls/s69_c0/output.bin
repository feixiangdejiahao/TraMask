125:	// VulnerabilityScanEnabled indicates if scheduled vulnerability scanning is enabled.
128:	VulnerabilityScanEnabled *string `json:"vulnerabilityScanEnabled,omitempty"`
130:	// VulnerabilityScanInterval is the cron expression for scheduled vulnerability scans.
133:	VulnerabilityScanInterval *string `json:"vulnerabilityScanInterval,omitempty"`
360:	// AutoHealEnabled indicates if automatic container healing is enabled.
363:	AutoHealEnabled *string `json:"autoHealEnabled,omitempty"`
365:	// AutoHealInterval is the cron expression for how often to check container health.
368:	AutoHealInterval *string `json:"autoHealInterval,omitempty"`
370:	// AutoHealExcludedContainers is a comma-separated list of container names to exclude from auto-heal.
373:	AutoHealExcludedContainers *string `json:"autoHealExcludedContainers,omitempty"`
375:	// AutoHealMaxRestarts is the maximum number of auto-heal restarts per container within the restart window.
378:	AutoHealMaxRestarts *string `json:"autoHealMaxRestarts,omitempty"`
380:	// AutoHealRestartWindow is the time window in minutes for counting auto-heal restarts.
383:	AutoHealRestartWindow *string `json:"autoHealRestartWindow,omitempty"`
