   100					vulnerabilityScanJob,
   101					autoHealJob,
   102				)
   103			}
   104		}
   105	}
   106	
   107	func handleJobScheduleChangeInternal(
   108		ctx context.Context,
   109		key string,
   110		appConfig *config.Config,
   111		newScheduler *pkg_scheduler.JobScheduler,
   112		imagePollingJob *pkg_scheduler.ImagePollingJob,
   113		autoUpdateJob *pkg_scheduler.AutoUpdateJob,
   114		environmentHealthJob *pkg_scheduler.EnvironmentHealthJob,
   115		eventCleanupJob *pkg_scheduler.EventCleanupJob,
   116		scheduledPruneJob *pkg_scheduler.ScheduledPruneJob,
   117		gitOpsSyncJob *pkg_scheduler.GitOpsSyncJob,
   118		vulnerabilityScanJob *pkg_scheduler.VulnerabilityScanJob,
   119		autoHealJob *pkg_scheduler.AutoHealJob,
   120	) {
   121		switch key {
   122		case "pollingInterval":
   123			if err := newScheduler.RescheduleJob(ctx, imagePollingJob); err != nil {
   124				slog.WarnContext(ctx, "Failed to reschedule image-polling job", "error", err)
   125			}
   126		case "autoUpdateInterval":
   127			if err := newScheduler.RescheduleJob(ctx, autoUpdateJob); err != nil {
   128				slog.WarnContext(ctx, "Failed to reschedule auto-update job", "error", err)
   129			}
   130		case "environmentHealthInterval":
   131			if appConfig.AgentMode {
   132				return
   133			}
   134			if err := newScheduler.RescheduleJob(ctx, environmentHealthJob); err != nil {
   135				slog.WarnContext(ctx, "Failed to reschedule environment-health job", "error", err)
   136			}
   137		case "eventCleanupInterval":
   138			if err := newScheduler.RescheduleJob(ctx, eventCleanupJob); err != nil {
   139				slog.WarnContext(ctx, "Failed to reschedule event cleanup job", "error", err)
   140			}
   141		case "scheduledPruneInterval":
   142			if err := newScheduler.RescheduleJob(ctx, scheduledPruneJob); err != nil {
   143				slog.WarnContext(ctx, "Failed to reschedule scheduled-prune job", "error", err)
   144			}
   145		case "gitopsSyncInterval":
   146			if err := newScheduler.RescheduleJob(ctx, gitOpsSyncJob); err != nil {
   147				slog.WarnContext(ctx, "Failed to reschedule gitops sync job", "error", err)
   148			}
   149		case "vulnerabilityScanInterval":
   150			if err := newScheduler.RescheduleJob(ctx, vulnerabilityScanJob); err != nil {
   151				slog.WarnContext(ctx, "Failed to reschedule vulnerability-scan job", "error", err)
   152			}
   153		case "autoHealInterval":
   154			if err := newScheduler.RescheduleJob(ctx, autoHealJob); err != nil {
   155				slog.WarnContext(ctx, "Failed to reschedule auto-heal job", "error", err)
   156			}
   157		}
   158	}
   159	
   160	func setupSettingsCallbacks(lifecycleCtx context.Context, appServices *Services, appConfig *config.Config, newScheduler *pkg_scheduler.JobScheduler, imagePollingJob *pkg_scheduler.ImagePollingJob, autoUpdateJob *pkg_scheduler.AutoUpdateJob, environmentHealthJob *pkg_scheduler.EnvironmentHealthJob, fsWatcherJob *pkg_scheduler.FilesystemWatcherJob, scheduledPruneJob *pkg_scheduler.ScheduledPruneJob, vulnerabilityScanJob *pkg_scheduler.VulnerabilityScanJob, autoHealJob *pkg_scheduler.AutoHealJob) {
   161		appServices.Settings.OnImagePollingSettingsChanged = func(_ context.Context) {
   162			if err := newScheduler.RescheduleJob(lifecycleCtx, imagePollingJob); err != nil {
   163				slog.WarnContext(lifecycleCtx, "Failed to reschedule image-polling job", "error", err)
   164			}
   165			if err := newScheduler.RescheduleJob(lifecycleCtx, autoUpdateJob); err != nil {
   166				slog.WarnContext(lifecycleCtx, "Failed to reschedule auto-update job", "error", err)
   167			}
   168			if !appConfig.AgentMode {
   169				if err := newScheduler.RescheduleJob(lifecycleCtx, environmentHealthJob); err != nil {
   170					slog.WarnContext(lifecycleCtx, "Failed to reschedule environment-health job", "error", err)
   171				}
   172			}
   173		}
   174		appServices.Settings.OnAutoUpdateSettingsChanged = func(ctx context.Context) {
   175			slog.DebugContext(lifecycleCtx, "AutoUpdateSettingsChanged callback triggered", "triggerContextCanceled", ctx.Err() != nil)
   176			if err := newScheduler.RescheduleJob(lifecycleCtx, autoUpdateJob); err != nil {
   177				slog.WarnContext(lifecycleCtx, "Failed to reschedule auto-update job", "error", err)
   178			}
   179		}
   180		appServices.Settings.OnProjectsDirectoryChanged = func(_ context.Context) {
   181			if fsWatcherJob != nil {
   182				if err := fsWatcherJob.RestartProjectsWatcher(lifecycleCtx); err != nil {
   183					slog.WarnContext(lifecycleCtx, "Failed to restart projects filesystem watcher", "error", err)
   184				}
   185			}
   186		}
   187		appServices.Settings.OnScheduledPruneSettingsChanged = func(_ context.Context) {
   188			if err := newScheduler.RescheduleJob(lifecycleCtx, scheduledPruneJob); err != nil {
   189				slog.WarnContext(lifecycleCtx, "Failed to reschedule scheduled-prune job", "error", err)
   190			}
   191		}
   192		appServices.Settings.OnVulnerabilityScanSettingsChanged = func(_ context.Context) {
   193			if err := newScheduler.RescheduleJob(lifecycleCtx, vulnerabilityScanJob); err != nil {
   194				slog.WarnContext(lifecycleCtx, "Failed to reschedule vulnerability-scan job", "error", err)
   195			}
   196		}
   197		appServices.Settings.OnAutoHealSettingsChanged = func(ctx context.Context) {
   198			if err := newScheduler.RescheduleJob(ctx, autoHealJob); err != nil {
   199				slog.WarnContext(ctx, "Failed to reschedule auto-heal job", "error", err)
   200			}
   201		}
   202	
   203		// Only set up timeout sync callback on main instance (not in agent mode)
   204		if !appConfig.AgentMode {
   205			appServices.Settings.OnTimeoutSettingsChanged = func(ctx context.Context, timeoutSettings []libarcane.SettingUpdate) {
   206				go syncTimeoutSettingsToAgentsInternal(context.WithoutCancel(ctx), appServices, timeoutSettings)
   207			}
   208		}
   209	}
   210	
   211	// syncTimeoutSettingsToAgentsInternal syncs timeout settings to all connected remote environments
   212	func syncTimeoutSettingsToAgentsInternal(ctx context.Context, appServices *Services, timeoutSettings []libarcane.SettingUpdate) {
   213		envs, err := appServices.Environment.ListRemoteEnvironments(ctx)
   214		if err != nil {
   215			slog.WarnContext(ctx, "Failed to list remote environments for timeout sync", "error", err)
   216			return
   217		}
   218	
   219		if len(envs) == 0 {
   220			return
   221		}
   222	
   223		// Build the settings update payload
   224		settingsMap := make(map[string]string, len(timeoutSettings))
   225		keys := make([]string, 0, len(timeoutSettings))
   226		for _, update := range timeoutSettings {
   227			settingsMap[update.Key] = update.Value
   228			keys = append(keys, update.Key)
   229		}
   230		body, err := json.Marshal(settingsMap)
   231		if err != nil {
   232			slog.WarnContext(ctx, "Failed to marshal timeout settings for sync", "error", err)
   233			return
   234		}
   235	
   236		slog.InfoContext(ctx, "Syncing environment settings to remote environments", "count", len(envs), "keys", keys)
   237	
   238		for _, env := range envs {
   239			_, statusCode, err := appServices.Environment.ProxyRequest(ctx, env.ID, http.MethodPut, "/api/environments/0/settings", body)
   240			if err != nil {
   241				slog.WarnContext(ctx, "Failed to sync timeout settings to environment", "environmentID", env.ID, "environmentName", env.Name, "error", err)
   242				continue
   243			}
   244			if statusCode != http.StatusOK {
   245				slog.WarnContext(ctx, "Environment returned non-OK status for timeout sync", "environmentID", env.ID, "environmentName", env.Name, "statusCode", statusCode)
   246				continue
   247			}
   248			slog.DebugContext(ctx, "Successfully synced timeout settings to environment", "environmentID", env.ID, "environmentName", env.Name)
   249		}
   250	}
