diff --git a/src/errors.ts b/src/errors.ts
index 282f93c..82aa3cc 100644
--- a/src/errors.ts
+++ b/src/errors.ts
@@ -172,3 +172,52 @@ export class AwilixRegistrationError extends AwilixError {
     super(msg)
   }
 }
+
+/**
+ * Error thrown when attempting to resolve a registration that has an
+ * initializer configured but has not been initialized yet.
+ */
+export class AwilixNotInitializedError extends AwilixError {
+  /**
+   * Constructor.
+   *
+   * @param {string|symbol} name
+   * The name of the registration that has not been initialized.
+   */
+  constructor(name: string | symbol) {
+    super(
+      `'${name.toString()}' is not initialized. Call container.initialize()`,
+    )
+  }
+}
+
+/**
+ * Error thrown when initialization of one or more registrations fails.
+ * The original error is exposed via `cause`.
+ */
+export class AwilixInitializationError extends AwilixError {
+  /**
+   * The original error that caused the initialization failure.
+   */
+  readonly cause?: unknown
+
+  /**
+   * Constructor.
+   *
+   * @param {string} message
+   * A human readable message describing the failure.
+   *
+   * @param {unknown} cause
+   * The original error that caused the failure.
+   */
+  constructor(message: string, cause?: unknown) {
+    super(message)
+    if (cause !== undefined) {
+      Object.defineProperty(this, 'cause', {
+        enumerable: false,
+        writable: true,
+        value: cause,
+      })
+    }
+  }
+}
