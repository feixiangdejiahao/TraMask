+
+func TestTypedBindingsUnknownType(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: nosuchtype = 1`, RunErrorFunc: errorContainsAny("unknown type", "undefined type")},
+		{Script: `var x: nosuchtype`, RunErrorFunc: errorContainsAny("unknown type", "undefined type")},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsBlankIdentifier(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var _: int64 = "a"; var x: int64 = 1; x`, RunOutput: int64(1)},
+		{Script: `var _: int64; var x: int64 = 1; x`, RunOutput: int64(1)},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsInterface(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{
+			Script:    `var x: typedTestInterface = s; x.GetValue()`,
+			Types:     map[string]interface{}{"typedTestInterface": reflect.TypeOf((*typedTestInterface)(nil)).Elem()},
+			Input:     map[string]interface{}{"s": typedTestStruct{}},
+			RunOutput: int64(42),
+		},
+		{
+			Script:    `var x: typedTestInterface = nil; x`,
+			Types:     map[string]interface{}{"typedTestInterface": reflect.TypeOf((*typedTestInterface)(nil)).Elem()},
+			RunOutput: nil,
+		},
+		{
+			Script:       `var x: typedTestInterface = 1`,
+			Types:        map[string]interface{}{"typedTestInterface": reflect.TypeOf((*typedTestInterface)(nil)).Elem()},
+			RunErrorFunc: errorContains("type error", "typedTestInterface"),
+		},
+		{Script: `var x: interface = 10; x`, RunOutput: int64(10)},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsScope(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: int64 = 1; if true { x = "a" }`, RunErrorFunc: errorContains("type error", "x")},
+		{Script: `var x: int64 = 1; if true { var x = "a"; x }`, RunOutput: "a"},
+		{Script: `var x: int64 = 1; if true { var x = "a"; x = 5; x }`, RunOutput: int64(5)},
+		{Script: `var x: int64 = 1; if true { var x: string = "a"; x = "b"; x }`, RunOutput: "b"},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsNoImplicitConversion(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: int64 = 10; x`, RunOutput: int64(10)},
+		{Script: `var x: float64 = 1.0; x`, RunOutput: float64(1)},
+		{Script: `var x: int64 = 10.0`, RunError: fmt.Errorf("type error: variable x is type int64 cannot assign value of type float64 to declared type int64")},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+// Ensure env API is still usable for typed bindings.
+func TestTypedBindingsEnvAPI(t *testing.T) {
+	t.Parallel()
+
+	e := env.NewEnv()
+	err := e.DefineTypedValue("x", reflect.ValueOf(int64(10)), reflect.TypeOf(int64(1)))
+	if err != nil {
+		t.Fatal("DefineTypedValue error:", err)
+	}
+	err = e.Set("x", "a")
+	if err == nil || !strings.Contains(err.Error(), "type error") {
+		t.Fatalf("expected type error, received: %v", err)
+	}
+	err = e.Set("x", int64(20))
+	if err != nil {
+		t.Fatal("Set error:", err)
+	}
+	v, err := e.Get("x")
+	if err != nil || v != int64(20) {
+		t.Fatalf("Get error - value: %#v - err: %v", v, err)
+	}
+	err = e.Define("x", "a")
+	if err != nil {
+		t.Fatal("Define error:", err)
+	}
+	err = e.Set("x", int64(5))
+	if err != nil {
+		t.Fatal("expected dynamic Set to succeed, received:", err)
+	}
+}
