+package vm
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/mattn/anko/env"
+)
+
+type typedTestInterface interface {
+	GetValue() int64
+}
+
+type typedTestStruct struct{}
+
+func (typedTestStruct) GetValue() int64 { return 42 }
+
+func errorContains(parts ...string) *func(*testing.T, error) {
+	f := func(t *testing.T, err error) {
+		if err == nil {
+			t.Errorf("expected error containing %v, got nil", parts)
+			return
+		}
+		for _, part := range parts {
+			if !strings.Contains(err.Error(), part) {
+				t.Errorf("error %q does not contain %q", err.Error(), part)
+			}
+		}
+	}
+	return &f
+}
+
+func errorContainsAny(parts ...string) *func(*testing.T, error) {
+	f := func(t *testing.T, err error) {
+		if err == nil {
+			t.Errorf("expected error containing one of %v, got nil", parts)
+			return
+		}
+		for _, part := range parts {
+			if strings.Contains(err.Error(), part) {
+				return
+			}
+		}
+		t.Errorf("error %q does not contain any of %v", err.Error(), parts)
+	}
+	return &f
+}
+
+func TestTypedBindingsBasic(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: int64 = 10; x`, RunOutput: int64(10)},
+		{Script: `var x: int64; x`, RunOutput: int64(0)},
+		{Script: `var x: string = "a"; x`, RunOutput: "a"},
+		{Script: `var x: string; x`, RunOutput: ""},
+		{Script: `var x: bool; x`, RunOutput: false},
+		{Script: `var x: float64 = 1.5; x`, RunOutput: float64(1.5)},
+		{Script: `var a, b: int64 = 1, 2; a + b`, RunOutput: int64(3)},
+		{Script: `var a, b: int64; a + b`, RunOutput: int64(0)},
+		{Script: `var x: int64 = 10; x = 20; x`, RunOutput: int64(20)},
+		{Script: `var x: []int64 = []int64{1, 2, 3}; x[1]`, RunOutput: int64(2)},
+		{Script: `var x: map[string]int64 = map[string]int64{"a": 1}; x["a"]`, RunOutput: int64(1)},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsZeroValues(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: []int64; x == nil`, RunOutput: true},
+		{Script: `var x: map[string]int64; x == nil`, RunOutput: true},
+		{Script: `var x: chan int64; x == nil`, RunOutput: true},
+		{Script: `var x: *int64; x == nil`, RunOutput: true},
+		{Script: `var x: interface; x == nil`, RunOutput: true},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsErrors(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: int64 = "a"`, RunErrorFunc: errorContains("type error", "x", "string", "int64")},
+		{Script: `var x: int64 = 10; x = "a"`, RunErrorFunc: errorContains("type error", "x", "string", "int64")},
+		{Script: `var x: string = 10`, RunErrorFunc: errorContains("type error", "x", "int64", "string")},
+		{Script: `var x: float64 = 10`, RunErrorFunc: errorContains("type error", "x", "int64", "float64")},
+		{Script: `var x: int = 10`, RunErrorFunc: errorContains("type error", "x", "int64", "int")},
+		{Script: `var x: int64 = 10; x = 10.0`, RunErrorFunc: errorContains("type error", "x", "float64", "int64")},
+		{Script: `var x: rune = 10`, RunErrorFunc: errorContains("type error", "x", "int64", "int32")},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsNil(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: []int64 = nil; x`, RunOutput: nil},
+		{Script: `var x: map[string]int64 = nil; x`, RunOutput: nil},
+		{Script: `var x: interface = nil; x`, RunOutput: nil},
+		{Script: `var x: *int64 = nil; x`, RunOutput: nil},
+		{Script: `var x: chan int64 = nil; x`, RunOutput: nil},
+		{Script: `var x: int64 = nil`, RunErrorFunc: errorContains("type error", "<nil>", "int64")},
+		{Script: `var x: bool = nil`, RunErrorFunc: errorContains("type error", "<nil>", "bool")},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
+
+func TestTypedBindingsDisabled(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: int64 = "a"; x`, RunOutput: "a"},
+		{Script: `var x: int64 = nil; x`, RunOutput: nil},
+		{Script: `var x: int64 = 10; x = "a"; x`, RunOutput: "a"},
+		{Script: `var x: int64 = 10; x = nil; x`, RunOutput: nil},
