    {
      "kind": "instruction",
      "path": "/home/jhx/combination_coverage/results/failure_analysis/deepswe_failed_trials_n211_20261006/trials/abs-stepped-slices__9zkafrW/instruction.md",
      "sha256": "0381637972fc77c6c27bbc9f999af79ce57e9fc78d9ac43cf1ced51c9f8ea3dd",
      "bytes": 3484,
      "line_count": 64,
      "anchors": [
        {
          "line": 1,
          "text": "Extend indexing ranges so arrays and strings support a third slice component:"
        },
        {
          "line": 3,
          "text": "- `value[start:end:step]`"
        },
        {
          "line": 5,
          "text": "This must work for both arrays and strings, and coexist with existing single-index and two-part range behavior."
        },
        {
          "line": 7,
          "text": "## Expected Behavior"
        },
        {
          "line": 9,
          "text": "1. Parser support"
        },
        {
          "line": 10,
          "text": "- Accept `start:end:step` inside index brackets."
        },
        {
          "line": 11,
          "text": "- Accept omitted components for stepped slices: `value[:end:step]`, `value[start::step]`, and `value[::step]`."
        },
        {
          "line": 12,
          "text": "- AST stringification must preserve stepped ranges, for example:"
        },
        {
          "line": 13,
          "text": "  - `myArray[99 : 101 : 2]` -> `(myArray[99:101:2])`"
        },
        {
          "line": 14,
          "text": "  - `myArray[::2]` -> `(myArray[::2])`"
        },
        {
          "line": 15,
          "text": "  - `myArray[4::-1]` -> `(myArray[4::(-1)])`"
        },
        {
          "line": 17,
          "text": "2. Runtime support for arrays and strings"
        },
        {
          "line": 18,
          "text": "- Existing index (`value[i]`) and two-part range (`value[start:end]`) behavior stays the same."
        },
        {
          "line": 19,
          "text": "- New stepped range behavior (`value[start:end:step]`) must work in both directions:"
        },
        {
          "line": 20,
          "text": "  - Positive step iterates forward."
        },
        {
          "line": 21,
          "text": "  - Negative step iterates backward."
        },
        {
          "line": 22,
          "text": "- A step of `0` must raise an error that starts with: `slice step cannot be 0`."
        },
        {
          "line": 23,
          "text": "- A non-numeric `start` in array/string slices must keep the existing index-operator error format:"
        },
        {
          "line": 24,
          "text": "  - `index operator not supported: <inspect> on ARRAY`"
        },
        {
          "line": 25,
          "text": "  - `index operator not supported: <inspect> on STRING`"
        },
        {
          "line": 26,
          "text": "- Non-numeric `end` or `step` values in ranges must keep the existing numeric-range error format:"
        },
        {
          "line": 27,
          "text": "  - `index ranges can only be numerical: got \"<inspect>\" (type <TYPE>)`"
        },
        {
          "line": 29,
          "text": "3. Array and string range assignment"
        },
        {
          "line": 30,
          "text": "- Support assigning to array ranges selected with either two-part or three-part slice syntax:"
        },
        {
          "line": 31,
          "text": "  - `array[start:end] = [...]`"
        },
        {
          "line": 32,
          "text": "  - `array[start:end:step] = [...]`"
        },
        {
          "line": 33,
          "text": "- Use the same index-selection semantics as read slicing."
        },
        {
          "line": 34,
          "text": "- If the assigned value is an array, its length must exactly match selected target indexes."
        },
        {
          "line": 35,
          "text": "- If the assigned value is not an array, broadcast that value across all selected indexes."
        },
        {
          "line": 36,
          "text": "- Support assigning to string indexes/ranges:"
        },
        {
          "line": 37,
          "text": "  - `string[i] = \"x\"`"
        },
        {
          "line": 38,
          "text": "  - `string[start:end] = \"...\"` and `string[start:end:step] = \"...\"`"
        },
        {
          "line": 39,
          "text": "- String single-index assignment must require a one-character replacement string."
        },
        {
          "line": 40,
          "text": "- String range assignment must accept either:"
        },
        {
          "line": 41,
          "text": "  - a replacement string with rune length equal to selected target indexes, or"
        },
        {
          "line": 42,
          "text": "  - a one-character replacement string that is broadcast across selected target indexes."
        },
        {
          "line": 43,
          "text": "- Broadcasting for string range assignment applies only when the number of selected target indexes is greater than zero."
        },
        {
          "line": 44,
          "text": "- If a string range selects zero indexes, any non-empty replacement string must raise a size-mismatch error."
        },
        {
          "line": 45,
          "text": "- Keep existing single-index assignment behavior unchanged."
        },
        {
          "line": 46,
          "text": "- Assignment error strings must match exactly:"
        },
        {
          "line": 47,
          "text": "  - Range assignment length mismatch (array or string, including zero-length targets):"
        },
        {
          "line": 48,
          "text": "    - `range assignment size mismatch: target=<X> value=<Y>`"
        },
        {
          "line": 49,
          "text": "  - String range assignment with non-string value:"
        },
        {
          "line": 50,
          "text": "    - `range assignment expects STRING value, got <TYPE>`"
        },
        {
          "line": 51,
          "text": "  - String single-index assignment with multi-character replacement:"
        },
        {
          "line": 52,
          "text": "    - `index assignment expects single-character STRING value, got <N> characters`"
        },
        {
          "line": 54,
          "text": "4. String correctness"
        },
        {
          "line": 55,
          "text": "- String indexing and range slicing must operate on Unicode characters (runes), not raw bytes."
        },
        {
          "line": 56,
          "text": "- This includes single index access and both two-part and three-part ranges."
        },
        {
          "line": 58,
          "text": "## Constraints"
        },
        {
          "line": 60,
          "text": "- Do not change public syntax outside index brackets."
        },
        {
          "line": 61,
          "text": "- Do not break existing non-stepped range semantics."
        },
        {
          "line": 62,
          "text": "- Keep compatibility with current error style and evaluator behavior."
        },
        {
          "line": 64,
          "text": "IMPORTANT: Please work on this in a new branch from main and commit everything when you are done."
        }
      ]
    },
