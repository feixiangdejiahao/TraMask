 			b.BackgroundError(err)
 		},
+		BatchDurable: func(info BatchDurableInfo) {
+			if a.BatchDurable != nil {
+				a.BatchDurable(info)
+			}
+			if b.BatchDurable != nil {
+				b.BatchDurable(info)
+			}
+		},
 		BlobFileCreated: func(info BlobFileCreateInfo) {
 			a.BlobFileCreated(info)
 			b.BlobFileCreated(info)
