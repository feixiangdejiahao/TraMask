+// batchSyncCompleteCallback returns a callback that is invoked by the WAL
+// writer when the WAL sync for a Sync commit completes, whether successfully or
+// with an error. The callback is invoked before the commit's WaitGroup is
+// signaled, so the batch has not yet been released by the committing goroutine.
+func (d *DB) batchSyncCompleteCallback(b *Batch) func() {
+	return func() {
+		d.durabilityTracker.onBatchSyncComplete(b)
+	}
+}
