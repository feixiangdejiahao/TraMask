diff --git a/event.go b/event.go
index 8400b94c..0bbd0a86 100644
--- a/event.go
+++ b/event.go
@@ -920,11 +920,54 @@ func (k APIMisuseKind) String() string {
 // excessive amount of time as they are invoked synchronously by the DB and may
 // block continued DB work. For a similar reason it is advisable to not perform
 // any synchronous calls back into the DB.
+// BatchDurableInfo contains the information for a BatchDurable event, which is
+// fired after the WAL sync for a Sync commit completes.
+type BatchDurableInfo struct {
+	// JobID is an identifier for the commit job. It can be used with
+	// DB.WaitForJobDurability to wait for the commit to become durable.
+	JobID int
+	// SeqNum is the sequence number of the first record in the batch.
+	SeqNum base.SeqNum
+	// Err is non-nil if the WAL sync failed.
+	Err error
+	// ApplyDuration is the wall-clock duration spent applying the batch to the
+	// memtable.
+	ApplyDuration time.Duration
+	// SyncDuration is the wall-clock duration spent syncing the WAL.
+	SyncDuration time.Duration
+	// CorrelationID is the value of WriteOptions.CommitCorrelationID for the
+	// commit.
+	CorrelationID uint64
+	// BatchSize is the encoded size of the batch in bytes.
+	BatchSize int
+	// KeyCount is the number of records in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable error: %s", redact.Safe(i.JobID), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable seqnum=%d sync=%s apply=%s",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.SyncDuration),
+		redact.Safe(i.ApplyDuration))
+}
+
