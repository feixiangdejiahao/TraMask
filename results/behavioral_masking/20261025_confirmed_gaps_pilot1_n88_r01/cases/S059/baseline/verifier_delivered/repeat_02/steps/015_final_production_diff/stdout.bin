+	BatchDurable func(BatchDurableInfo)
+
 	// BlobFileCreated is invoked after a blob file has been created.
 	BlobFileCreated func(BlobFileCreateInfo)
 
@@ -1036,6 +1079,9 @@ func (l *EventListener) EnsureDefaults(logger Logger) {
