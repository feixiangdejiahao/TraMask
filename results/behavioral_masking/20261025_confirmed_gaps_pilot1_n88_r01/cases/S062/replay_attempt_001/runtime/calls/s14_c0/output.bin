done
   173	
   174	        return data
   175	
   176	    def get_fill_size(self, size=None):
   177	        """
   178	        Retrieves the default fill size for this buffer class.
   179	
   180	        Arguments:
   181	            size (int): (Optional) If set and not None, returns the size variable back.
   182	
   183	        Returns:
   184	            Fill size as integer if size is None, else size.
   185	        """
   186	        if size is None:
   187	            size = self.buffer_fill_size
   188	
   189	        with context.local(buffer_size=size):
   190	            return context.buffer_size
   191	
   192	    def set_watermarks(self, high=None, low=None):
   193	        """
   194	        Sets the high and low water marks used for flow control.
   195	
   196	        Arguments:
   197	            high(int): High water mark, at which ``over_high_water`` becomes
   198	                True.  ``None`` disables it.
   199	            low(int): Low water mark, at which ``under_low_water`` becomes
   200	                True.  ``None`` disables it.
   201	
   202	        Raises:
   203	            ValueError: If ``low > high``.
   204	        """
   205	        if low is not None and high is not None and low > high:
   206	            raise ValueError("low_water mark cannot exceed high_water mark")
   207	
   208	        if high is not None:
   209	            self.high_water = high
   210	        if low is not None:
   211	            self.low_water = low
   212	
   213	    @property
   214	    def over_high_water(self):
   215	        """
   216	        True when the buffer size is at or above the high water mark.
   217	        False when the high water mark is unset.
   218	        """
   219	        if self.high_water is None:
   220	            return False
   221	        return self.size >= self.high_water
   222	
   223	    @property
   224	    def under_low_water(self):
   225	        """
   226	        True when the buffer size is at or below the low water mark.
   227	        False when the low water mark is unset.
   228	        """
   229	        if self.low_water is None:
   230	            return False
   231	        return self.size <= self.low_water
   232	
