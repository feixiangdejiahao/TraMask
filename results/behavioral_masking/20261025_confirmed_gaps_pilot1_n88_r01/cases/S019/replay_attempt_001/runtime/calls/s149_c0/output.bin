13:import { withAttributeNameDecoding, withOptional, withRequiredIf } from './utils.js'
---
    ? Object.entries(schema.attributes).filter(([, { props }]) => !props.hidden)
    : Object.entries(schema.attributes)

  return withAttributeNameDecoding(
    schema,
    options,
    withOptional(
      schema,
      options,
      withValidate(
        schema,
        z.object(
          Object.fromEntries(
