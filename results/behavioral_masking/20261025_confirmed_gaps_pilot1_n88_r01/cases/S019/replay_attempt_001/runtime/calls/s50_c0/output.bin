     1	/**
     2	 * @debt circular "Remove & prevent imports from entity to schema"
     3	 */
     4	import type { UpdateValueInput } from '~/entity/actions/update/types.js'
     5	import type { Paths, SchemaAction, ValidValue } from '~/schema/index.js'
     6	import type { If, NarrowObject, Overwrite, ValueOrGetter } from '~/types/index.js'
     7	import { ifThenElse } from '~/utils/ifThenElse.js'
     8	import { overwrite } from '~/utils/overwrite.js'
     9	
    10	import type { StringSchema } from '../string/index.js'
    11	import type {
    12	  Always,
    13	  AtLeastOnce,
    14	  Never,
    15	  Schema,
    16	  SchemaRequiredProp,
    17	  Validator
    18	} from '../types/index.js'
    19	import type { Light } from '../utils/light.js'
    20	import { light } from '../utils/light.js'
    21	import { RecordSchema } from './schema.js'
    22	import type { RecordElementSchema, RecordKeySchema, RecordSchemaProps } from './types.js'
    23	
    24	type RecordSchemer = <
    25	  KEYS extends RecordKeySchema,
    26	  ELEMENTS extends RecordElementSchema,
    27	  PROPS extends RecordSchemaProps = {}
    28	>(
    29	  keys: KEYS,
    30	  elements: ELEMENTS,
    31	  props?: NarrowObject<PROPS>
    32	) => RecordSchema_<Light<KEYS>, Light<ELEMENTS>, PROPS>
    33	
    34	/**
    35	 * Define a new record attribute
    36	 * Note that record keys and elements have constraints. They must be:
    37	 * - Required (required: AtLeastOnce)
    38	 * - Displayed (hidden: false)
    39	 * - Not key (key: false)
    40	 * - Not renamed (savedAs: undefined)
    41	 * - Not defaulted (defaults: undefined)
    42	 *
    43	 * @param keys Keys (With constraints)
    44	 * @param elements Attribute (With constraints)
    45	 * @param props _(optional)_ Record Props
    46	 */
    47	export const record: RecordSchemer = <
    48	  KEYS extends RecordKeySchema,
    49	  ELEMENTS extends RecordElementSchema,
    50	  PROPS extends RecordSchemaProps = {}
    51	>(
    52	  keys: KEYS,
    53	  elements: ELEMENTS,
    54	  props: NarrowObject<PROPS> = {} as PROPS
    55	) => new RecordSchema_(light(keys), light(elements), props)
    56	
    57	/**
    58	 * Record attribute interface
    59	 */
    60	export class RecordSchema_<
    61	  KEYS extends StringSchema = StringSchema,
    62	  ELEMENTS extends Schema = Schema,
    63	  PROPS extends RecordSchemaProps = RecordSchemaProps
    64	> extends RecordSchema<KEYS, ELEMENTS, PROPS> {
    65	  /**
    66	   * Tag attribute as required. Possible values are:
    67	   * - `'atLeastOnce'` _(default)_: Required in PUTs, optional in UPDATEs
    68	   * - `'never'`: Optional in PUTs and UPDATEs
    69	   * - `'always'`: Required in PUTs and UPDATEs
    70	   *
    71	   * @param nextRequired SchemaRequiredProp
    72	   */
    73	  required<NEXT_IS_REQUIRED extends SchemaRequiredProp = AtLeastOnce>(
    74	    nextRequired: NEXT_IS_REQUIRED = 'atLeastOnce' as NEXT_IS_REQUIRED
    75	  ): RecordSchema_<KEYS, ELEMENTS, Overwrite<PROPS, { required: NEXT_IS_REQUIRED }>> {
    76	    return new RecordSchema_(
    77	      this.keys,
    78	      this.elements,
    79	      overwrite(this.props, { required: nextRequired })
    80	    )
    81	  }
    82	
    83	  /**
    84	   * Shorthand for `required('never')`
    85	   */
    86	  optional(): RecordSchema_<KEYS, ELEMENTS, Overwrite<PROPS, { required: Never }>> {
    87	    return this.required('never')
    88	  }
    89	
    90	  /**
    91	   * Hide attribute after fetch commands and formatting
    92	   */
    93	  hidden<NEXT_HIDDEN extends boolean = true>(
    94	    nextHidden: NEXT_HIDDEN = true as NEXT_HIDDEN
    95	  ): RecordSchema_<KEYS, ELEMENTS, Overwrite<PROPS, { hidden: NEXT_HIDDEN }>> {
    96	    return new RecordSchema_(
    97	      this.keys,
    98	      this.elements,
    99	      overwrite(this.props, { hidden: nextHidden })
   100	    )
   101	  }
   102	
   103	  /**
   104	   * Tag attribute as a primary key attribute or linked to a primary attribute
   105	   */
   106	  key<NEXT_KEY extends boolean = true>(
   107	    nextKey: NEXT_KEY = true as NEXT_KEY
   108	  ): RecordSchema_<KEYS, ELEMENTS, Overwrite<PROPS, { key: NEXT_KEY; required: Always }>> {
   109	    return new RecordSchema_(
   110	      this.keys,
   111	      this.elements,
   112	      overwrite(this.props, { key: nextKey, required: 'always' })
   113	    )
   114	  }
   115	
   116	  /**
   117	   * Rename attribute before save commands
   118	   */
   119	  savedAs<NEXT_SAVED_AS extends string | undefined>(
   120	    nextSavedAs: NEXT_SAVED_AS
   121	  ): RecordSchema_<KEYS, ELEMENTS, Overwrite<PROPS, { savedAs: NEXT_SAVED_AS }>> {
   122	    return new RecordSchema_(
   123	      this.keys,
   124	      this.elements,
   125	      overwrite(this.props, { savedAs: nextSavedAs })
   126	    )
   127	  }
   128	
   129	  /**
   130	   * Tag record as partial
   131	   */
   132	  partial<NEXT_PARTIAL extends boolean = true>(
   133	    nextPartial: NEXT_PARTIAL = true as NEXT_PARTIAL
   134	  ): RecordSchema_<KEYS, ELEMENTS, Overwrite<PROPS, { partial: NEXT_PARTIAL }>> {
   135	    return new RecordSchema_(
   136	      this.keys,
   137	      this.elements,
   138	      overwrite(this.props, { partial: nextPartial })
   139	    )
   140	  }
   141	
   142	  /**
   143	   * Provide a default value for attribute in Primary Key computing
   144	   *
   145	   * @param nextKeyDefault `keyAttributeInput | (() => keyAttributeInput)`
   146	   */
   147	  keyDefault(
   148	    nextKeyDefault: ValueOrGetter<ValidValue<this, { mode: 'key' }>>
   149	  ): RecordSchema_<KEYS, ELEMENTS, Overwrite<PROPS, { keyDefault: unknown }>> {
   150	    return new RecordSchema_(
   151	      this.keys,
   152	      this.elements,
   153	      overwrite(this.props, { keyDefault: nextKeyDefault as unknown })
   154	    )
   155	  }
   156	
   157	  /**
   158	   * Provide a default value for attribute in PUT commands
   159	   *
   160	   * @param nextPutDefault `putAttributeInput | (() => putAttributeInput)`
===RECORD types===
import type { StringSchema, StringSchemaProps } from '../string/index.js'
import type { AtLeastOnce, Schema, SchemaProps } from '../types/index.js'

export interface RecordSchemaProps extends SchemaProps {
  partial?: boolean
}

interface RecordKeyAndElementProps extends SchemaProps {
  required?: AtLeastOnce
  hidden?: false
  key?: false
  savedAs?: undefined
  keyDefault?: undefined
  putDefault?: undefined
  updateDefault?: undefined
  keyLink?: undefined
  putLink?: undefined
  updateLink?: undefined
}

// TODO: Re-introduce constraint in interface (not only in typer)
export type RecordElementSchema = Schema & { props: RecordKeyAndElementProps }

// TODO: Re-introduce constraint in interface (not only in typer)
export type RecordKeySchema = StringSchema<StringSchemaProps & RecordKeyAndElementProps>
