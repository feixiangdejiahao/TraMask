     1	/**
     2	 * @debt circular "Remove & prevent imports from entity to schema"
     3	 */
     4	import type { UpdateValueInput } from '~/entity/actions/update/types.js'
     5	import type { Paths, SchemaAction, ValidValue } from '~/schema/index.js'
     6	import type { If, NarrowObject, Overwrite, ValueOrGetter } from '~/types/index.js'
     7	import { ifThenElse } from '~/utils/ifThenElse.js'
     8	import { overwrite } from '~/utils/overwrite.js'
     9	
    10	import type {
    11	  Always,
    12	  AtLeastOnce,
    13	  Never,
    14	  Schema,
    15	  SchemaRequiredProp,
    16	  Validator
    17	} from '../types/index.js'
    18	import type { LightTuple } from '../utils/light.js'
    19	import { lightTuple } from '../utils/light.js'
    20	import { AnyOfSchema } from './schema.js'
    21	import type { AnyOfElementSchema, AnyOfSchemaProps, Discriminator } from './types.js'
    22	
    23	type AnyOfSchemer = <ELEMENTS extends AnyOfElementSchema[]>(
    24	  ...elements: ELEMENTS
    25	) => AnyOfSchema_<LightTuple<ELEMENTS>, {}>
    26	
    27	/**
    28	 * Define a new anyOf attribute
    29	 * @param elements Attribute[]
    30	 */
    31	export const anyOf: AnyOfSchemer = (...elements) => new AnyOfSchema_(lightTuple(...elements), {})
    32	
    33	/**
    34	 * AnyOf attribute interface
    35	 */
    36	export class AnyOfSchema_<
    37	  ELEMENTS extends Schema[] = Schema[],
    38	  PROPS extends AnyOfSchemaProps = AnyOfSchemaProps
    39	> extends AnyOfSchema<ELEMENTS, PROPS> {
    40	  /**
    41	   * Tag attribute as required. Possible values are:
    42	   * - `'atLeastOnce'` _(default)_: Required in PUTs, optional in UPDATEs
    43	   * - `'never'`: Optional in PUTs and UPDATEs
    44	   * - `'always'`: Required in PUTs and UPDATEs
    45	   *
    46	   * @param nextRequired SchemaRequiredProp
    47	   */
    48	  required<NEXT_IS_REQUIRED extends SchemaRequiredProp = AtLeastOnce>(
    49	    nextRequired: NEXT_IS_REQUIRED = 'atLeastOnce' as NEXT_IS_REQUIRED
    50	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { required: NEXT_IS_REQUIRED }>> {
    51	    return new AnyOfSchema_(this.elements, overwrite(this.props, { required: nextRequired }))
    52	  }
    53	
    54	  /**
    55	   * Shorthand for `required('never')`
    56	   */
    57	  optional(): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { required: Never }>> {
    58	    return this.required('never')
    59	  }
    60	
    61	  /**
    62	   * Hide attribute after fetch commands and formatting
    63	   */
    64	  hidden<NEXT_HIDDEN extends boolean = true>(
    65	    nextHidden: NEXT_HIDDEN = true as NEXT_HIDDEN
    66	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { hidden: NEXT_HIDDEN }>> {
    67	    return new AnyOfSchema_(this.elements, overwrite(this.props, { hidden: nextHidden }))
    68	  }
    69	
    70	  /**
    71	   * Tag attribute as a primary key attribute or linked to a primary attribute
    72	   */
    73	  key<NEXT_KEY extends boolean = true>(
    74	    nextKey: NEXT_KEY = true as NEXT_KEY
    75	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { key: NEXT_KEY; required: Always }>> {
    76	    return new AnyOfSchema_(
    77	      this.elements,
    78	      overwrite(this.props, { key: nextKey, required: 'always' })
    79	    )
    80	  }
    81	
    82	  /**
    83	   * Rename attribute before save commands
    84	   */
    85	  savedAs<NEXT_SAVED_AS extends string | undefined>(
    86	    nextSavedAs: NEXT_SAVED_AS
    87	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { savedAs: NEXT_SAVED_AS }>> {
    88	    return new AnyOfSchema_(this.elements, overwrite(this.props, { savedAs: nextSavedAs }))
    89	  }
    90	
    91	  /**
    92	   * Discriminates the union with a shared string attribute with enum
    93	   */
    94	  discriminate<NEXT_DISCRIMINATOR extends Discriminator<ELEMENTS>>(
    95	    nextDiscriminator: NEXT_DISCRIMINATOR
    96	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { discriminator: NEXT_DISCRIMINATOR }>> {
    97	    return new AnyOfSchema_(
    98	      this.elements,
    99	      overwrite(this.props, { discriminator: nextDiscriminator })
   100	    )
   101	  }
   102	
   103	  /**
   104	   * Provide a default value for attribute in Primary Key computing
   105	   *
   106	   * @param nextKeyDefault `keyAttributeInput | (() => keyAttributeInput)`
   107	   */
   108	  keyDefault(
   109	    nextKeyDefault: ValueOrGetter<ValidValue<this, { mode: 'key' }>>
   110	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { keyDefault: unknown }>> {
   111	    return new AnyOfSchema_(
   112	      this.elements,
   113	      overwrite(this.props, { keyDefault: nextKeyDefault as unknown })
   114	    )
   115	  }
   116	
   117	  /**
   118	   * Provide a default value for attribute in PUT commands
   119	   *
   120	   * @param nextPutDefault `putAttributeInput | (() => putAttributeInput)`
   121	   */
   122	  putDefault(
   123	    nextPutDefault: ValueOrGetter<ValidValue<this>>
   124	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { putDefault: unknown }>> {
   125	    return new AnyOfSchema_(
   126	      this.elements,
   127	      overwrite(this.props, { putDefault: nextPutDefault as unknown })
   128	    )
   129	  }
   130	
   131	  /**
   132	   * Provide a default value for attribute in UPDATE commands
   133	   *
   134	   * @param nextUpdateDefault `updateAttributeInput | (() => updateAttributeInput)`
   135	   */
   136	  updateDefault(
   137	    nextUpdateDefault: ValueOrGetter<UpdateValueInput<this, { filled: true }>>
   138	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { updateDefault: unknown }>> {
   139	    return new AnyOfSchema_(
   140	      this.elements,
   141	      overwrite(this.props, { updateDefault: nextUpdateDefault as unknown })
   142	    )
   143	  }
   144	
   145	  /**
   146	   * Provide a default value for attribute in PUT commands OR Primary Key computing if attribute is tagged as key
   147	   *
   148	   * @param nextDefault `key/putAttributeInput | (() => key/putAttributeInput)`
   149	   */
   150	  default(
   151	    nextDefault: ValueOrGetter<
   152	      If<PROPS['key'], ValidValue<this, { mode: 'key' }>, ValidValue<this>>
   153	    >
   154	  ): If<
   155	    PROPS['key'],
   156	    AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { keyDefault: unknown }>>,
   157	    AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { putDefault: unknown }>>
   158	  > {
   159	    return ifThenElse(
   160	      this.props.key as PROPS['key'],
   161	      new AnyOfSchema_(
   162	        this.elements,
   163	        overwrite(this.props, { keyDefault: nextDefault as unknown })
   164	      ),
   165	      new AnyOfSchema_(this.elements, overwrite(this.props, { putDefault: nextDefault as unknown }))
   166	    )
   167	  }
   168	
   169	  /**
   170	   * Provide a **linked** default value for attribute in Primary Key computing
   171	   *
   172	   * @param nextKeyLink `keyAttributeInput | ((keyInput) => keyAttributeInput)`
   173	   */
   174	  keyLink<SCHEMA extends Schema>(
   175	    nextKeyLink: (
   176	      keyInput: ValidValue<SCHEMA, { mode: 'key'; defined: true }>
   177	    ) => ValidValue<this, { mode: 'key' }>
   178	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { keyLink: unknown }>> {
   179	    return new AnyOfSchema_(
   180	      this.elements,
   181	      overwrite(this.props, { keyLink: nextKeyLink as unknown })
   182	    )
   183	  }
   184	
   185	  /**
   186	   * Provide a **linked** default value for attribute in PUT commands
   187	   *
   188	   * @param nextPutLink `putAttributeInput | ((putItemInput) => putAttributeInput)`
   189	   */
   190	  putLink<SCHEMA extends Schema>(
   191	    nextPutLink: (putItemInput: ValidValue<SCHEMA, { defined: true }>) => ValidValue<this>
   192	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { putLink: unknown }>> {
   193	    return new AnyOfSchema_(
   194	      this.elements,
   195	      overwrite(this.props, { putLink: nextPutLink as unknown })
   196	    )
   197	  }
   198	
   199	  /**
   200	   * Provide a **linked** default value for attribute in UPDATE commands
   201	   *
   202	   * @param nextUpdateLink `unknown | ((updateItemInput) => updateAttributeInput)`
   203	   */
   204	  updateLink<SCHEMA extends Schema>(
   205	    nextUpdateLink: (
   206	      updateItemInput: UpdateValueInput<SCHEMA, { defined: true; extended: false }, Paths<SCHEMA>>
   207	    ) => UpdateValueInput<this, { filled: true }>
   208	  ): AnyOfSchema_<ELEMENTS, Overwrite<PROPS, { updateLink: unknown }>> {
   209	    return new AnyOfSchema_(
   210	      this.elements,
   211	      overwrite(this.props, { updateLink: nextUpdateLink as unknown })
   212	    )
   213	  }
   214	
   215	  /**
   216	   * Provide a **linked** default value for attribute in PUT commands OR Primary Key computing if attribute is tagged as key
   217	   *
   218	   * @param nextLink `key/putAttributeInput | (() => key/putAttributeInput)`
   219	   */
   220	  link<SCHEMA extends Schema>(
