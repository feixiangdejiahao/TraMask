    })
    schema.check()

    const dto = new SchemaDTO(schema).toJSON()
    const restored = fromSchemaDTO(dto)
    restored.check()

    expect(
      (restored.attributes as Record<string, { props: { requiredIf: unknown } }>).details.props
        .requiredIf
    ).toStrictEqual({
      type: ['a']
    })
  })

