@@ -68,6 +69,20 @@ program.on('--help', () => {
   console.log();
 });
 
+function parseBailOnTestFailure(value) {
+  if (value === true || value === 'true') {
+    return true;
+  }
+  if (value === 'false') {
+    return false;
+  }
+  let parsed = parseInt(value, 10);
+  if (!isNaN(parsed)) {
+    return parsed;
+  }
+  return value;
+}
+
