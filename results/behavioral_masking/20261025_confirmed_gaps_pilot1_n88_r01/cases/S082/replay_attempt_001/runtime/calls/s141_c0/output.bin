  -b, --bail_on_uncaught_error  Bail on any uncaught errors
  --bail_on_test_failure [n]    Bail on the Nth test failure
  -R, --reporter [reporter]     Test reporter to use [tap|dot|xunit|teamcity]
  --cwd [path]                  directory to use as root
