   330	
   331	      expect(reporter.hasPassed()).to.be.true();
   332	    });
   333	
   334	    it('returns true when all tests skipped', function() {
   335	      let reporter = new Reporter(app, stream);
   336	
   337	      reporter.report('test', { skipped: 1 });
   338	
   339	      expect(reporter.hasPassed()).to.be.true();
   340	    });
   341	
   342	    it('returns true when all tests skipped or passed', function() {
