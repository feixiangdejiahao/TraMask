   381	  });
   382	});
   383	
   384	  describe('bail_on_test_failure', function() {
   385	    function bailApp(value) {
   386	      return {
   387	        config: {
   388	          get: function(key) {
   389	            switch (key) {
   390	              case 'reporter':
   391	                return new FakeReporter();
   392	              case 'bail_on_test_failure':
   393	                return value;
   394	            }
   395	          }
   396	        }
   397	      };
   398	    }
   399	
   400	    it('defaults to disabled when no value is provided', function() {
   401	      let reporter = new Reporter(mockApp(), stream);
   402	      expect(reporter.bailOnTestFailure).to.equal(0);
   403	      expect(reporter.hasBailed()).to.be.false();
   404	    });
   405	
   406	    it('treats true as a threshold of one', function() {
   407	      let reporter = new Reporter(bailApp(true), stream);
   408	      expect(reporter.bailOnTestFailure).to.equal(1);
   409	    });
   410	
