+                        groupMatches = true;
+                        break;
+                    }
+                }
+            }
+
+            if (logic === 'and' && !groupMatches) break;
+            if (logic === 'or' && groupMatches) break;
+        }
+
+        if (logic === 'or') {
+            hasOrGroup = true;
+            if (groupMatches) anyOrMatched = true;
+        } else if (!groupMatches) {
+            return false;
+        }
+    }
+
+    if (hasOrGroup && !anyOrMatched) return false;
+    return true;
