   380	    // Index queries with relation filters
   381	    const hasRelationFilters = query.relationFilters && query.relationFilters.length > 0;
   382	
   383	    if (hasRelationFilters) {
   384	        for (const pair of query.relationFilters!) {
   385	            const relationTrait = pair[$internal].relation[$internal].trait;
   386	            const relationTraitInstance = getTraitInstance(ctx.traitInstances, relationTrait);
   387	            if (relationTraitInstance) {
   388	                relationTraitInstance.relationQueries.add(query);
   389	            }
   390	        }
   391	    }
   392	
   393	    // Populate query with initial matching entities
   394	    if (query.trackingGroups.length > 0) {
   395	        // For tracking queries, check each entity against tracking groups
   396	        for (const group of query.trackingGroups) {
   397	            const { type, id, logic, bitmasks } = group;
   398	            const snapshot = ctx.trackingSnapshots.get(id)!;
   399	            const dirtyMask = ctx.dirtyMasks.get(id)!;
   400	            const changedMask = ctx.changedMasks.get(id)!;
   401	
   402	            for (const entity of ctx.entityIndex.dense) {
   403	                // For AND groups, skip if already in query (will be checked by other groups)
   404	                // For OR groups, skip if already in query
   405	                if (query.entities.has(entity)) continue;
   406	
   407	                const eid = getEntityId(entity);
   408	                let matches = logic === 'and'; // AND starts true, OR starts false
   409	
   410	                // Check each generation that has bitmasks
   411	                for (let genId = 0; genId < bitmasks.length; genId++) {
   412	                    const mask = bitmasks[genId];
   413	                    if (!mask) continue;
   414	
   415	                    const oldMask = snapshot[genId]?.[eid] || 0;
   416	                    const currentMask = ctx.entityMasks[genId]?.[eid] || 0;
   417	
   418	                    // Check each bit in the mask
   419	                    for (let bit = 1; bit <= mask; bit <<= 1) {
   420	                        if (!(mask & bit)) continue;
   421	
   422	                        let traitMatches = false;
   423	
   424	                        switch (type) {
   425	                            case 'add':
   426	                                traitMatches = (oldMask & bit) === 0 && (currentMask & bit) === bit;
   427	                                break;
   428	                            case 'remove':
   429	                                traitMatches =
   430	                                    ((oldMask & bit) === bit && (currentMask & bit) === 0) ||
   431	                                    ((oldMask & bit) === 0 &&
   432	                                        (currentMask & bit) === 0 &&
   433	                                        ((dirtyMask[genId]?.[eid] ?? 0) & bit) === bit);
   434	                                break;
   435	                            case 'change':
   436	                                traitMatches = ((changedMask[genId]?.[eid] ?? 0) & bit) === bit;
   437	                                break;
   438	                        }
   439	
   440	                        if (logic === 'and') {
   441	                            if (!traitMatches) {
   442	                                matches = false;
   443	                                break;
   444	                            }
   445	                        } else {
   446	                            // OR logic
   447	                            if (traitMatches) {
   448	                                matches = true;
   449	                                break;
   450	                            }
   451	                        }
   452	                    }
   453	
   454	                    // Early exit for AND that failed or OR that succeeded
   455	                    if (logic === 'and' && !matches) break;
   456	                    if (logic === 'or' && matches) break;
   457	                }
   458	
   459	                if (matches) {
   460	                    if (hasRelationFilters) {
   461	                        let relationMatch = true;
   462	                        for (const pair of query.relationFilters!) {
   463	                            if (!hasRelationPair(world, entity, pair)) {
   464	                                relationMatch = false;
   465	                                break;
   466	                            }
   467	                        }
   468	                        if (relationMatch) query.add(entity);
   469	                    } else {
   470	                        query.add(entity);
   471	                    }
   472	                }
   473	            }
   474	        }
   475	    } else {
   476	        // Non-tracking query: populate immediately
   477	        const entities = ctx.entityIndex.dense;
   478	        for (let i = 0; i < entities.length; i++) {
   479	            const entity = entities[i];
   480	            const match = hasRelationFilters
   481	                ? checkQueryWithRelations(world, query, entity)
   482	                : query.check(world, entity);
   483	            if (match) query.add(entity);
   484	        }
   485	    }
   486	
   487	    return query;
   488	}
   489	
   490	let queryId = 0;
   491	
   492	export function createQuery<T extends QueryParameter[]>(...parameters: T): Query<T> {
   493	    const hash = createQueryHash(parameters);
   494	
   495	    // Check if this query was already cached
   496	    const existing = universe.cachedQueries.get(hash);
   497	    if (existing) return existing as Query<T>;
   498	
   499	    // Create new query ref with ID
   500	    const id = queryId++;
