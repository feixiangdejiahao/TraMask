     1	import { $internal } from '../common';
     2	import { createEntity, destroyEntity } from '../entity/entity';
     3	import type { Entity } from '../entity/types';
     4	import { createEntityIndex, getAliveEntities, isEntityAlive } from '../entity/utils/entity-index';
     5	import { IsExcluded, createQueryInstance } from '../query/query';
     6	import { createRelationOnlyQueryResult } from '../query/query-result';
     7	import type { Query, QueryInstance, QueryParameter, QueryUnsubscriber } from '../query/types';
     8	import { createQueryHash } from '../query/utils/create-query-hash';
     9	import { isQuery } from '../query/utils/is-query';
    10	import { getTrackingCursor, setTrackingMasks } from '../query/utils/tracking-cursor';
    11	import { getEntitiesWithRelationTo } from '../relation/relation';
    12	import type { Relation, RelationPair } from '../relation/types';
    13	import { isRelation, isRelationPair } from '../relation/utils/is-relation';
    14	import { addTrait, getTrait, hasTrait, registerTrait, removeTrait, setTrait } from '../trait/trait';
    15	import { clearTraitInstance, getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
    16	import type {
    17	    ConfigurableTrait,
    18	    ExtractSchema,
    19	    SetTraitCallback,
    20	    Trait,
    21	    TraitRecord,
    22	    TraitValue,
    23	} from '../trait/types';
    24	import { universe } from '../universe/universe';
    25	import type { World, WorldInternal, WorldOptions } from './types';
    26	import { allocateWorldId, releaseWorldId } from './utils/world-index';
    27	
    28	export function createWorld(options: WorldOptions): World;
    29	export function createWorld(...traits: ConfigurableTrait[]): World;
    30	export function createWorld(
    31	    optionsOrFirstTrait?: WorldOptions | ConfigurableTrait,
    32	    ...traits: ConfigurableTrait[]
    33	): World {
    34	    const id = allocateWorldId(universe.worldIndex);
    35	    let isInitialized = false;
    36	    let lazyTraits: ConfigurableTrait[] | undefined;
    37	    type HookInput = Trait | Relation<Trait> | RelationPair<Trait>;
    38	    type HookCallback = (entity: Entity, target?: Entity) => void;
    39	
    40	    function resolveHookTrait(input: HookInput): Trait {
    41	        if (isRelationPair(input)) return input[$internal].relation[$internal].trait;
    42	        if (isRelation(input)) return input[$internal].trait;
    43	        return input;
    44	    }
    45	
    46	    function resolveHookCallback(input: HookInput, callback: HookCallback): HookCallback {
    47	        if (isRelationPair(input)) {
    48	            const pairTarget = input[$internal].target;
    49	            if (pairTarget === '*') return callback;
    50	            return (entity: Entity, target?: Entity) => {
    51	                if (target === pairTarget) callback(entity, target);
    52	            };
    53	        }
    54	        return callback;
    55	    }
    56	
    57	    const world = {
    58	        [$internal]: {
    59	            entityIndex: createEntityIndex(id),
    60	            entityMasks: [[]],
    61	            entityTraits: new Map(),
    62	            bitflag: 1,
    63	            traitInstances: [],
    64	            relations: new Set(),
    65	            queriesHashMap: new Map(),
    66	            queryInstances: [],
    67	            actionInstances: [],
    68	            notQueries: new Set(),
    69	            dirtyQueries: new Set(),
    70	            dirtyMasks: new Map(),
    71	            trackingSnapshots: new Map(),
    72	            changedMasks: new Map(),
    73	            worldEntity: null!,
    74	            trackedTraits: new Set(),
    75	            resetSubscriptions: new Set(),
    76	        } as WorldInternal,
    77	
    78	        traits: new Set<Trait>(),
    79	
    80	        init(...initTraits: ConfigurableTrait[]) {
    81	            const ctx = world[$internal];
    82	            if (isInitialized) return;
    83	
    84	            isInitialized = true;
    85	            universe.worlds[id] = world;
    86	
    87	            // Create uninitialized added masks.
    88	            const cursor = getTrackingCursor();
    89	            for (let i = 0; i < cursor; i++) {
    90	                setTrackingMasks(world, i);
    91	            }
    92	
    93	            // Register system traits.
    94	            if (!hasTraitInstance(ctx.traitInstances, IsExcluded)) registerTrait(world, IsExcluded);
    95	
    96	            // Check for traits passed into lazy init
    97	            if (lazyTraits) {
    98	                initTraits = lazyTraits;
    99	                // clear lazyTraits
   100	                lazyTraits = undefined;
   101	            }
   102	            // Create world entity.
   103	            ctx.worldEntity = createEntity(world, IsExcluded, ...initTraits);
   104	        },
   105	
   106	        spawn(...spawnTraits: ConfigurableTrait[]): Entity {
   107	            return createEntity(world, ...spawnTraits);
   108	        },
   109	
   110	        has(target: Entity | Trait): boolean {
   111	            return typeof target === 'number'
   112	                ? isEntityAlive(world[$internal].entityIndex, target)
   113	                : hasTrait(world, world[$internal].worldEntity, target);
   114	        },
   115	
   116	        add(...addTraits: ConfigurableTrait[]) {
   117	            addTrait(world, world[$internal].worldEntity, ...addTraits);
   118	        },
   119	
   120	        remove(...removeTraits: Trait[]) {
   121	            removeTrait(world, world[$internal].worldEntity, ...removeTraits);
   122	        },
   123	
   124	        get<T extends Trait>(trait: T): TraitRecord<ExtractSchema<T>> | undefined {
   125	            return getTrait(world, world[$internal].worldEntity, trait);
   126	        },
   127	
   128	        set<T extends Trait>(trait: T, value: TraitValue<ExtractSchema<T>> | SetTraitCallback<T>) {
   129	            setTrait(world, world[$internal].worldEntity, trait, value, true);
   130	        },
   131	
   132	        destroy() {
   133	            // Destroy world entity.
   134	            destroyEntity(world, world[$internal].worldEntity);
   135	            world[$internal].worldEntity = null!;
   136	
   137	            world.reset();
   138	            isInitialized = false;
   139	            // Clean up universe side effects.
   140	            releaseWorldId(universe.worldIndex, id);
   141	            universe.worlds[id] = null;
   142	        },
   143	
   144	        reset() {
   145	            lazyTraits = undefined;
   146	            const ctx = world[$internal];
   147	
   148	            // Destroy all entities so any cleanup is done.
   149	            world.entities.forEach((entity) => {
   150	                // Some relations may have caused the entity to be destroyed before
   151	                // we get to them in the loop.
   152	                if (world.has(entity)) {
   153	                    destroyEntity(world, entity);
   154	                }
   155	            });
   156	
   157	            ctx.entityIndex = createEntityIndex(id);
   158	            ctx.entityTraits.clear();
   159	            ctx.entityMasks = [[]];
   160	            ctx.bitflag = 1;
   161	
   162	            clearTraitInstance(ctx.traitInstances);
   163	            world.traits.clear();
   164	            ctx.relations.clear();
   165	
   166	            ctx.queriesHashMap.clear();
   167	            ctx.queryInstances.length = 0;
   168	            ctx.actionInstances.length = 0;
   169	            ctx.dirtyQueries.clear();
   170	            ctx.notQueries.clear();
   171	
   172	            ctx.trackingSnapshots.clear();
   173	            ctx.dirtyMasks.clear();
   174	            ctx.changedMasks.clear();
   175	            ctx.trackedTraits.clear();
   176	
   177	            // Create new world entity.
   178	            ctx.worldEntity = createEntity(world, IsExcluded);
   179	
   180	            for (const sub of ctx.resetSubscriptions) {
   181	                sub(world);
   182	            }
   183	        },
   184	
   185	        query(...args: any[]) {
   186	            const ctx = world[$internal];
   187	
   188	            // Check if first arg is a QueryRef
   189	            if (args.length === 1 && isQuery(args[0])) {
   190	                const queryRef = args[0];
   191	                // Try array lookup first
   192	                let query = ctx.queryInstances[queryRef.id];
   193	                if (query) return query.run(world, queryRef.parameters);
   194	
   195	                // Fallback to hash map
   196	                query = ctx.queriesHashMap.get(queryRef.hash);
   197	                if (!query) {
   198	                    query = createQueryInstance(world, queryRef.parameters);
   199	                    ctx.queriesHashMap.set(queryRef.hash, query);
   200	                    // Store in array for fast future lookups
   201	                    if (queryRef.id >= ctx.queryInstances.length) {
   202	                        ctx.queryInstances.length = queryRef.id + 1;
   203	                    }
   204	                    ctx.queryInstances[queryRef.id] = query;
   205	                }
   206	                return query.run(world, queryRef.parameters);
   207	            } else {
   208	                const params = args as QueryParameter[];
   209	
   210	                // Fast path: single relation pair with specific target
   211	                if (params.length === 1 && isRelationPair(params[0])) {
   212	                    const pairCtx = params[0][$internal];
   213	                    const relation = pairCtx.relation;
   214	                    const target = pairCtx.target;
   215	
   216	                    // Only use fast path for specific targets
   217	                    if (typeof target === 'number') {
   218	                        const entities = getEntitiesWithRelationTo(
   219	                            world,
   220	                            relation as Relation<Trait>,
   221	                            target as Entity
   222	                        );
   223	                        return createRelationOnlyQueryResult(entities.slice() as Entity[]);
   224	                    }
   225	                }
   226	
   227	                const hash = createQueryHash(params);
   228	                let query = ctx.queriesHashMap.get(hash);
   229	
   230	                if (!query) {
   231	                    query = createQueryInstance(world, params);
   232	                    ctx.queriesHashMap.set(hash, query);
   233	                }
   234	
   235	                return query.run(world, params);
   236	            }
   237	        },
   238	
   239	        queryFirst(...args: [string] | QueryParameter[]) {
   240	            // @ts-expect-error - Having an issue with the TS overloads.
   241	            return world.query(...args)[0];
   242	        },
   243	
   244	        onQueryAdd(
   245	            args: Query<QueryParameter[]> | QueryParameter[],
   246	            callback: (entity: Entity) => void
   247	        ): QueryUnsubscriber {
   248	            const ctx = world[$internal];
   249	            let query: QueryInstance;
   250	
   251	            // Check if args is a QueryRef object
   252	            if (isQuery(args)) {
   253	                const queryRef = args;
   254	                query = ctx.queryInstances[queryRef.id] || ctx.queriesHashMap.get(queryRef.hash)!;
   255	
   256	                if (!query) {
   257	                    query = createQueryInstance(world, queryRef.parameters);
   258	                    ctx.queriesHashMap.set(queryRef.hash, query);
   259	                    if (queryRef.id >= ctx.queryInstances.length) {
   260	                        ctx.queryInstances.length = queryRef.id + 1;
