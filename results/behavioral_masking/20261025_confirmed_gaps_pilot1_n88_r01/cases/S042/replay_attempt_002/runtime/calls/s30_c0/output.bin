   562	    it('updateEach should work with Removed modifier', () => {
   563	        const Removed = createRemoved();
   564	        const Name = trait({ name: '' });
   565	        const entity = world.spawn(Position({ x: 7, y: 8 }), Name({ name: 'keep' }));
   566	
   567	        entity.remove(Position);
   568	
   569	        // Removed modifier includes the removed trait in stores, plus any other queried traits
   570	        world.query(Removed(Position), Name).updateEach(([position, name]) => {
   571	            // Position data may still be accessible (stale) even after removal
   572	            expect(position).toHaveProperty('x');
   573	            expect(name).toHaveProperty('name', 'keep');
   574	            name.name = 'modified';
   575	        });
   576	
   577	        expect(entity.get(Name)!.name).toBe('modified');
   578	    });
