   603	        // Change both on entityC - should still match
   604	        entityC.changed(Position);
   605	        entityC.changed(Foo);
   606	        entities = world.query(Or(Changed(Position), Changed(Foo)));
   607	        expect(entities).toContain(entityC);
   608	        expect(entities.length).toBe(1);
   609	    });
