   246	/* @inline */ export function getQueryStores<T extends QueryParameter[]>(
   247	    params: T,
   248	    traits: Trait[],
   249	    stores: Store<any>[],
   250	    world: World
   251	) {
   252	    for (let i = 0; i < params.length; i++) {
   253	        const param = params[i];
   254	
   255	        // Handle relation pairs
   256	        if (isRelationPair(param)) {
   257	            const pairCtx = param[$internal];
   258	            const relation = pairCtx.relation as Relation<Trait>;
   259	            const baseTrait = relation[$internal].trait;
   260	            if (baseTrait[$internal].type !== 'tag') {
   261	                traits.push(baseTrait);
   262	                stores.push(getStore(world, baseTrait));
   263	            }
   264	            continue;
   265	        }
   266	
   267	        if (isModifier(param)) {
   268	            // Skip not modifier.
   269	            if (param.type === 'not') continue;
   270	
   271	            const modifierTraits = param.traits;
   272	            for (const trait of modifierTraits) {
   273	                if (trait[$internal].type === 'tag') continue; // Skip tags
   274	                traits.push(trait);
   275	                stores.push(getStore(world, trait));
   276	            }
   277	        } else {
   278	            const trait = param as Trait;
   279	            if (trait[$internal].type === 'tag') continue; // Skip tags
   280	            traits.push(trait);
   281	            stores.push(getStore(world, trait));
   282	        }
   283	    }
   284	}
   285	
   286	export function createEmptyQueryResult(): QueryResult<QueryParameter[]> {
   287	    const results = Object.assign([], {
   288	        readEach: () => results,
   289	        updateEach: () => results,
   290	        useStores: () => results,
   291	        select: () => results,
   292	        sort: () => results,
   293	    }) as QueryResult<QueryParameter[]>;
   294	
   295	    return results;
   296	}
   297	
   298	// Cached no-op result methods for relation-only queries
   299	const relationOnlyMethods = {
   300	    readEach(this: QueryResult<any>, callback: any) {
   301	        // No traits to read, just iterate entities
   302	        for (let i = 0; i < this.length; i++) {
   303	            callback([], this[i], i);
   304	        }
   305	        return this;
   306	    },
   307	    updateEach(this: QueryResult<any>, callback: any) {
   308	        // No traits to update, just iterate entities
   309	        for (let i = 0; i < this.length; i++) {
   310	            callback([], this[i], i);
   311	        }
   312	        return this;
   313	    },
   314	    useStores(this: QueryResult<any>, callback: any) {
   315	        // No stores, call with empty array
   316	        callback([], this);
   317	        return this;
   318	    },
   319	    select(this: QueryResult<any>) {
   320	        // No-op, nothing to select
   321	        return this;
   322	    },
   323	};
   324	
   325	/**
   326	 * Lightweight query result for relation-only queries.
   327	 * Skips store/trait setup since we only need to iterate entities.
   328	 */
   329	export function createRelationOnlyQueryResult<T extends QueryParameter[]>(
   330	    entities: Entity[]
   331	): QueryResult<T> {
   332	    const results = Object.assign(entities, {
   333	        readEach: relationOnlyMethods.readEach,
   334	        updateEach: relationOnlyMethods.updateEach,
   335	        useStores: relationOnlyMethods.useStores,
   336	        select: relationOnlyMethods.select,
   337	        sort(
   338	            callback: (a: Entity, b: Entity) => number = (a, b) => getEntityId(a) - getEntityId(b)
   339	        ): QueryResult<T> {
   340	            Array.prototype.sort.call(entities, callback);
   341	            return results;
   342	        },
   343	    }) as unknown as QueryResult<T>;
   344	
   345	    return results;
   346	}
