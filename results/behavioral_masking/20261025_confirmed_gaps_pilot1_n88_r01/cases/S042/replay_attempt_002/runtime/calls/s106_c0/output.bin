    92	
    93	/**
    94	 * Update tracking queries that reference the relation trait after a pair-level event.
    95	 */
    96	export function updateQueriesForRelationPairChange(
    97	    world: World,
    98	    relationTrait: Trait,
    99	    entity: Entity,
   100	    target: Entity,
   101	    eventType: 'add' | 'remove' | 'change',
   102	    canceled = false
   103	) {
   104	    const ctx = world[$internal];
   105	    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
   106	    if (!instance) return;
   107	
   108	    const { generationId, bitflag } = instance;
   109	
   110	    for (const query of instance.trackingQueries) {
   111	        console.log('UPDATE', eventType, 'map', canceledByTracker ? [...canceledByTracker.entries()] : 'none', 'query gids', query.trackingGroups.map(g=>g.id), 'entity', entity);
   112	        const match = query.checkTracking(
   113	            world,
   114	            entity,
   115	            eventType,
   116	            generationId,
   117	            bitflag,
   118	            target,
   119	            canceled
   120	        );
   121	        if (match) query.add(entity);
   122	        else query.remove(world, entity);
   123	    }
   124	}
   125	
   126	/** Get a nested map by relation trait id. */
   127	function getTargetSet(
   128	    map: Map<number, Map<number, Set<number>>>,
   129	    traitId: number,
   130	    entity: Entity
   131	): Set<number> | undefined {
   132	    return map.get(traitId)?.get(entity);
   133	}
