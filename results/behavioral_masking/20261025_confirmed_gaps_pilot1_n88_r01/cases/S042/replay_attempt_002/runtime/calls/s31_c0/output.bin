   670	    });
   671	
   672	    it('should track Changed on a relation', () => {
   673	        const ChildOf = relation({ store: { order: 0 } });
   674	        const Changed = createChanged();
   675	
   676	        const parentA = world.spawn();
   677	        const parentB = world.spawn();
   678	        const childA = world.spawn(ChildOf(parentA));
   679	        const childB = world.spawn(ChildOf(parentB));
   680	
   681	        // No changes yet
   682	        expect(world.query(Changed(ChildOf))).toHaveLength(0);
   683	
   684	        // Change only childA
   685	        childA.set(ChildOf(parentA), { order: 1 });
   686	        let changed = world.query(Changed(ChildOf));
   687	        expect(changed).toHaveLength(1);
   688	        expect(changed).toContain(childA);
   689	
   690	        // Change both, query filtered by parentA pair
   691	        childA.set(ChildOf(parentA), { order: 2 });
   692	        childB.set(ChildOf(parentB), { order: 3 });
   693	        const filteredA = world.query(Changed(ChildOf), ChildOf(parentA));
   694	        expect(filteredA).toHaveLength(1);
   695	        expect(filteredA).toContain(childA);
   696	    });
   697	
   698	    it('should track Added on a relation', () => {
   699	        const ChildOf = relation();
   700	        const Added = createAdded();
   701	
   702	        const parentA = world.spawn();
   703	        const parentB = world.spawn();
   704	
   705	        const childA = world.spawn(ChildOf(parentA));
   706	        const childB = world.spawn(ChildOf(parentB));
   707	        const childC = world.spawn(ChildOf(parentA));
   708	
   709	        // Filtered by parentA: only childA and childC target parentA
   710	        const filteredA = world.query(Added(ChildOf), ChildOf(parentA));
   711	        expect(filteredA).toHaveLength(2);
   712	        expect(filteredA).toContain(childA);
   713	        expect(filteredA).toContain(childC);
   714	        expect(filteredA).not.toContain(childB);
   715	    });
   716	
   717	    it('should track Removed on a relation', () => {
   718	        const ChildOf = relation();
   719	        const Removed = createRemoved();
   720	
   721	        const parentA = world.spawn();
   722	        const parentB = world.spawn();
   723	        const childA = world.spawn(ChildOf(parentA));
   724	        const childB = world.spawn(ChildOf(parentB));
   725	
   726	        // No removals yet
   727	        expect(world.query(Removed(ChildOf))).toHaveLength(0);
   728	
   729	        // Remove childA's relation
   730	        childA.remove(ChildOf(parentA));
   731	        let removed = world.query(Removed(ChildOf));
   732	        expect(removed).toHaveLength(1);
   733	        expect(removed).toContain(childA);
   734	
   735	        // Remove childB
   736	        childB.remove(ChildOf(parentB));
   737	        removed = world.query(Removed(ChildOf));
   738	        expect(removed).toHaveLength(1);
   739	        expect(removed).toContain(childB);
   740	    });
   741	
   742	    it('updateEach should work with Removed modifier for relations', () => {
   743	        const Removed = createRemoved();
   744	        const Contains = relation({ store: { amount: 0 } });
   745	
   746	        const inventory = world.spawn();
   747	        const gold = world.spawn();
   748	
   749	        inventory.add(Contains(gold, { amount: 42 }));
   750	        inventory.remove(Contains(gold));
   751	
   752	        world.query(Removed(Contains), Contains(gold)).updateEach(([contains], entity) => {
   753	            // Removed relation queries should still expose the removed pair's store data.
   754	            expect(contains).toHaveProperty('amount', 42);
   755	            // And its target
   756	            expect(entity.targetFor(Contains)).toBe(gold);
   757	        });
   758	    });
   759	
   760	    // @internal Tests internal implementation edge case with generation overflow
   761	    it('[internal] should handle Changed modifier when trait registration causes generation overflow', () => {
   762	        // Create a fresh world to control trait registration count
   763	        const testWorld = createWorld();
   764	        testWorld.init();
   765	
   766	        // IsExcluded is already registered (bitflag=2 after), register 29 more to get bitflag=2^30
   767	        const fillerTraits = Array.from({ length: 29 }, () => trait());
   768	        for (const t of fillerTraits) {
   769	            testWorld.spawn(t);
   770	        }
   771	
   772	        // Create Changed modifier - snapshots entityMasks with 1 generation
   773	        const Changed = createChanged();
   774	
   775	        // Spawn an entity so entityIndex.dense is not empty (required to trigger the bug)
   776	        const entity = testWorld.spawn();
   777	
   778	        // Register the 31st trait to trigger overflow (bitflag 2^30 -> 2^31 -> overflow)
   779	        const Trait31 = trait();
   780	        entity.add(Trait31);
   781	
   782	        // Now entityMasks has 2 generations, but changedMask only has 1
   783	
   784	        // Create the 32nd trait - will be in generation 1
   785	        const NewTrait = trait();
   786	
   787	        // This should not throw "cannot read properties of undefined (reading '0')"
   788	        // when accessing changedMask[generationId][eid] where generationId is 1 but changedMask only has index 0
   789	        expect(() => {
   790	            testWorld.query(Changed(NewTrait));
   791	        }).not.toThrow();
   792	    });
   793	});
