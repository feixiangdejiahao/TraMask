   243	
   244	        // Adding Foo and Bar to entityB should not match the query as it has Bar.
   245	        entityB.add(Foo, Bar);
   246	        entities = world.query(Added(Foo), Not(Bar));
   247	        expect(entities.length).toBe(0);
   248	    });
