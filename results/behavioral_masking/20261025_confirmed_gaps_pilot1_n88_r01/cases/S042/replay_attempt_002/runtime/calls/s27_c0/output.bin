   228	    it('should combine Not and Added modifiers with logical AND', () => {
   229	        const Added = createAdded();
   230	
   231	        const entityA = world.spawn();
   232	        const entityB = world.spawn();
   233	
   234	        // No entities should match this query since while Not will match
   235	        // all empty entities, Added will only match entities that have Foo.
   236	        let entities = world.query(Added(Foo), Not(Bar));
   237	        expect(entities.length).toBe(0);
   238	
   239	        // Adding Foo to entityA should match the query as it has Foo added and not Bar.
   240	        entityA.add(Foo);
