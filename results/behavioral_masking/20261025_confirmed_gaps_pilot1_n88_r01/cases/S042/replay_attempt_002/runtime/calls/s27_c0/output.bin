   213	
   214	        const LaterAdded = createAdded();
   215	
   216	        let entities2 = world.query(LaterAdded(Foo));
   217	        expect(entities2.length).toBe(0);
   218	
   219	        entityA.remove(Foo); // Reset
   220	        entityA.add(Foo);
   221	        entities = world.query(Added(Foo));
   222	        entities2 = world.query(LaterAdded(Foo));
   223	
   224	        expect(entities.length).toBe(1);
   225	        expect(entities2.length).toBe(1);
   226	    });
