   230	    } else {
   231	        const targetsArray = traitData.relationTargets as number[][];
   232	        if (!targetsArray[eid]) {
   233	            targetsArray[eid] = [];
   234	        }
   235	
   236	        // Check if already exists
   237	        const existingIndex = targetsArray[eid].indexOf(target);
   238	        if (existingIndex !== -1) {
   239	            return -1;
   240	        }
   241	
   242	        targetIndex = targetsArray[eid].length;
   243	        targetsArray[eid].push(target);
   244	    }
   245	
   246	    // Pair-level tracking events
   247	    markPairEvent(world, baseTrait, entity, target, 'add');
   248	    updateQueriesForRelationPairChange(world, baseTrait, entity, target, 'add');
   249	
   250	    updateQueriesForRelationChange(world, relation, entity);
   251	
   252	    return targetIndex;
   253	}
   254	
   255	/**
   256	 * Remove a relation target from an entity.
   257	 * Returns the removed index and whether this was the last target.
   258	 */
   259	export function removeRelationTarget(
   260	    world: World,
   261	    relation: Relation<Trait>,
   262	    entity: Entity,
   263	    target: Entity
   264	): { removedIndex: number; wasLastTarget: boolean } {
   265	    const ctx = world[$internal];
   266	    const relationCtx = relation[$internal];
   267	    const relationTrait = relationCtx.trait;
   268	
   269	    const data = getTraitInstance(ctx.traitInstances, relationTrait);
   270	    if (!data || !data.relationTargets) return { removedIndex: -1, wasLastTarget: false };
   271	
   272	    const eid = getEntityId(entity);
   273	
   274	    let removedIndex = -1;
   275	    let hasRemainingTargets = false;
   276	
   277	    if (relationCtx.exclusive) {
   278	        const targets = data.relationTargets as Array<Entity | undefined>;
   279	        if (targets[eid] === target) {
   280	            targets[eid] = undefined;
   281	            removedIndex = 0;
   282	            hasRemainingTargets = false;
   283	            clearRelationDataInternal(data.store, relationTrait[$internal].type, eid, 0, true);
   284	        }
   285	    } else {
   286	        const targetsArray = data.relationTargets as number[][];
   287	        const entityTargets = targetsArray[eid];
   288	        if (entityTargets) {
   289	            const idx = entityTargets.indexOf(target);
   290	            if (idx !== -1) {
   291	                const lastIdx = entityTargets.length - 1;
   292	                if (idx !== lastIdx) {
   293	                    entityTargets[idx] = entityTargets[lastIdx];
   294	                }
   295	                entityTargets.pop();
   296	                swapAndPopRelationData(data.store, relationTrait[$internal].type, eid, idx, lastIdx);
   297	                removedIndex = idx;
   298	                hasRemainingTargets = entityTargets.length > 0;
   299	            }
   300	        }
   301	    }
   302	
   303	    if (removedIndex !== -1) {
   304	        // Pair-level tracking events
   305	        markPairEvent(world, relationTrait, entity, target, 'remove');
   306	        updateQueriesForRelationPairChange(world, relationTrait, entity, target, 'remove');
   307	
   308	        updateQueriesForRelationChange(world, relation, entity);
   309	    }
   310	
   311	    const wasLastTarget = removedIndex !== -1 && !hasRemainingTargets;
   312	    return { removedIndex, wasLastTarget };
   313	}
   314	
   315	/**
