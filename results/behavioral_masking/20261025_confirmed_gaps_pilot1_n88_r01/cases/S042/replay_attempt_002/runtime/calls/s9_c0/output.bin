   100	/** Reset tracking state for an entity across all tracking groups */
   101	export function resetQueryTrackingBitmasks(query: QueryInstance, eid: number) {
   102	    const groups = query.trackingGroups;
   103	    const len = groups.length;
   104	    for (let i = 0; i < len; i++) {
   105	        const trackers = groups[i].trackers;
   106	        const trackersLen = trackers.length;
   107	        for (let j = 0; j < trackersLen; j++) {
   108	            const tracker = trackers[j];
   109	            if (tracker) tracker[eid] = 0;
   110	        }
   111	    }
   112	}
   113	
   114	/**
   115	 * Unified function to process tracking modifiers with explicit AND/OR logic.
   116	 * Groups modifiers by (type, id, logic) key so same-tracker calls are combined.
   117	 */
   118	function processTrackingModifier(
   119	    world: World,
   120	    query: QueryInstance,
   121	    modifier: Modifier,
   122	    logic: 'and' | 'or',
   123	    ctx: World[typeof $internal],
   124	    groupsMap: Map<string, TrackingGroup>
   125	): void {
   126	    const trackingType = getTrackingType(modifier);
   127	    if (!trackingType) return;
   128	
   129	    const id = modifier.id;
   130	    // Key includes logic so Changed(A) at top-level stays separate from Or(Changed(A))
   131	    const key = `${trackingType}-${id}-${logic}`;
   132	
   133	    // Find or create tracking group
   134	    let group = groupsMap.get(key);
   135	    if (!group) {
   136	        group = {
   137	            logic,
   138	            type: trackingType,
   139	            id,
   140	            bitmasks: [],
   141	            trackers: [],
   142	        };
   143	        groupsMap.set(key, group);
   144	        query.trackingGroups.push(group);
   145	    }
   146	
   147	    // Register traits and build bitmasks
   148	    for (const trait of modifier.traits) {
   149	        if (!hasTraitInstance(ctx.traitInstances, trait)) registerTrait(world, trait);
   150	        const instance = getTraitInstance(ctx.traitInstances, trait)!;
   151	        query.traits.push(trait);
   152	
   153	        // Add to traitInstances.all for query registration
   154	        query.traitInstances.all.push(instance);
   155	
   156	        // Build bitmasks by generation
   157	        const genId = instance.generationId;
   158	        group.bitmasks[genId] = (group.bitmasks[genId] || 0) | instance.bitflag;
   159	
   160	        // Track changed traits for change detection in query-result
   161	        if (trackingType === 'change') {
   162	            query.changedTraits.add(trait);
   163	            query.hasChangedModifiers = true;
   164	        }
   165	    }
   166	
   167	    query.isTracking = true;
   168	}
   169	
   170	export function createQueryInstance<T extends QueryParameter[]>(
   171	    world: World,
   172	    parameters: T
   173	): QueryInstance {
   174	    const query: QueryInstance = {
   175	        version: 0,
   176	        world,
   177	        parameters,
   178	        hash: '',
   179	        traits: [],
   180	        traitInstances: {
   181	            required: [],
   182	            forbidden: [],
   183	            or: [],
   184	            all: [],
   185	        },
   186	        staticBitmasks: [],
   187	        trackingGroups: [],
   188	        generations: [],
   189	        entities: new SparseSet(),
   190	        isTracking: false,
   191	        hasChangedModifiers: false,
   192	        changedTraits: new Set<Trait>(),
   193	        toRemove: new SparseSet(),
   194	        addSubscriptions: new Set<QuerySubscriber>(),
   195	        removeSubscriptions: new Set<QuerySubscriber>(),
   196	        relationFilters: [],
   197	
   198	        run: (world: World, params: QueryParameter[]) => runQuery(world, query, params),
   199	        add: (entity: Entity) => addEntityToQuery(query, entity),
   200	        remove: (world: World, entity: Entity) => removeEntityFromQuery(world, query, entity),
   201	        check: (world: World, entity: Entity) => checkQuery(world, query, entity),
   202	        checkTracking: (
   203	            world: World,
   204	            entity: Entity,
   205	            eventType: EventType,
   206	            generationId: number,
   207	            bitflag: number
   208	        ) => checkQueryTracking(world, query, entity, eventType, generationId, bitflag),
   209	        resetTrackingBitmasks: (eid: number) => resetQueryTrackingBitmasks(query, eid),
   210	    };
   211	
   212	    const ctx = world[$internal];
   213	
   214	    // Map for grouping tracking modifiers by (type, id, logic)
   215	    const trackingGroupsMap = new Map<string, TrackingGroup>();
   216	
   217	    // Process all parameters
   218	    for (let i = 0; i < parameters.length; i++) {
   219	        const parameter = parameters[i];
   220	
   221	        // Handle relation pairs
   222	        if (isRelationPair(parameter)) {
   223	            const pairCtx = parameter[$internal];
   224	            const relation = pairCtx.relation;
   225	
   226	            query.relationFilters!.push(parameter);
   227	
   228	            const baseTrait = (relation as Relation<Trait>)[$internal].trait;
   229	            if (!hasTraitInstance(ctx.traitInstances, baseTrait)) registerTrait(world, baseTrait);
   230	            query.traitInstances.required.push(getTraitInstance(ctx.traitInstances, baseTrait)!);
   231	            query.traits.push(baseTrait);
   232	
   233	            continue;
   234	        }
   235	
   236	        if (isModifier(parameter)) {
   237	            const traits = parameter.traits;
   238	
   239	            // Register traits
   240	            for (let j = 0; j < traits.length; j++) {
   241	                const t = traits[j];
   242	                if (!hasTraitInstance(ctx.traitInstances, t)) registerTrait(world, t);
   243	            }
   244	
   245	            if (parameter.type === 'not') {
   246	                query.traitInstances.forbidden.push(
   247	                    ...traits.map((t) => getTraitInstance(ctx.traitInstances, t)!)
   248	                );
   249	            } else if (parameter.type === 'or') {
   250	                // Handle regular traits in Or
   251	                query.traitInstances.or.push(
   252	                    ...traits.map((t) => getTraitInstance(ctx.traitInstances, t)!)
   253	                );
   254	
   255	                // Handle nested tracking modifiers in Or
   256	                if (isOrWithModifiers(parameter)) {
   257	                    for (const nestedModifier of parameter.modifiers) {
   258	                        if (isTrackingModifier(nestedModifier)) {
   259	                            processTrackingModifier(world, query, nestedModifier, 'or', ctx, trackingGroupsMap);
   260	                        }
