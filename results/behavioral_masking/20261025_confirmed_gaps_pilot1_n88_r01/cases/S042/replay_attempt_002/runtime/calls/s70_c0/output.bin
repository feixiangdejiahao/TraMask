   130	
   131	    const id = modifier.id;
   132	    const pairs = modifier.pairs ?? [];
   133	    const pairTraitIds = new Set<number>();
   134	
   135	    // Each relation pair becomes its own tracking group so per-target state is distinct.
   136	    for (const pair of pairs) {
   137	        const pairCtx = pair[$internal];
   138	        const relation = pairCtx.relation as Relation<Trait>;
   139	        const trait = relation[$internal].trait;
   140	        pairTraitIds.add(trait.id);
   141	
   142	        const target = pairCtx.target;
   143	        const key = `${trackingType}-${id}-${logic}-pair:${trait.id}:${target}`;
   144	
   145	        let group = groupsMap.get(key);
   146	        if (!group) {
   147	            group = {
   148	                logic,
   149	                type: trackingType,
   150	                id,
   151	                bitmasks: [],
   152	                trackers: [],
   153	                pairs: [pair],
   154	            };
   155	            groupsMap.set(key, group);
   156	            query.trackingGroups.push(group);
   157	        }
   158	
   159	        if (!hasTraitInstance(ctx.traitInstances, trait)) registerTrait(world, trait);
   160	        const instance = getTraitInstance(ctx.traitInstances, trait)!;
   161	        query.traits.push(trait);
   162	        query.traitInstances.all.push(instance);
   163	
   164	        const genId = instance.generationId;
   165	        group.bitmasks[genId] = (group.bitmasks[genId] || 0) | instance.bitflag;
   166	
   167	        if (trackingType === 'change') {
   168	            query.changedTraits.add(trait);
   169	            query.hasChangedModifiers = true;
   170	        }
   171	
   172	        query.isTracking = true;
   173	    }
   174	
   175	    // Non-pair traits are grouped together (existing trait-level behavior).
   176	    const regularTraits = modifier.traits.filter((trait) => !pairTraitIds.has(trait.id));
   177	    if (regularTraits.length === 0) return;
   178	
   179	    const key = `${trackingType}-${id}-${logic}`;
   180	
   181	    let group = groupsMap.get(key);
   182	    if (!group) {
   183	        group = {
   184	            logic,
   185	            type: trackingType,
   186	            id,
   187	            bitmasks: [],
   188	            trackers: [],
   189	        };
   190	        groupsMap.set(key, group);
   191	        query.trackingGroups.push(group);
   192	    }
   193	
   194	    for (const trait of regularTraits) {
   195	        if (!hasTraitInstance(ctx.traitInstances, trait)) registerTrait(world, trait);
   196	        const instance = getTraitInstance(ctx.traitInstances, trait)!;
   197	        query.traits.push(trait);
   198	
   199	        // Add to traitInstances.all for query registration
   200	        query.traitInstances.all.push(instance);
   201	
   202	        // Build bitmasks by generation
   203	        const genId = instance.generationId;
   204	        group.bitmasks[genId] = (group.bitmasks[genId] || 0) | instance.bitflag;
   205	
   206	        // Track changed traits for change detection in query-result
   207	        if (trackingType === 'change') {
   208	            query.changedTraits.add(trait);
   209	            query.hasChangedModifiers = true;
   210	        }
   211	    }
   212	
   213	    query.isTracking = true;
   214	}
   215	
   216	/**
   217	 * Evaluate a tracking query against accumulated state at query creation time.
   218	 * Unlike checkQueryTracking (which uses incremental per-query trackers), this
   219	 * reads the persistent tracking masks and pair event state directly.
   220	 */
   221	function checkQueryTrackingAtCreation(world: World, query: QueryInstance, entity: Entity): boolean {
   222	    // Static constraints first.
   223	    if (!checkQuery(world, query, entity)) return false;
   224	
   225	    const ctx = world[$internal];
   226	    const eid = getEntityId(entity);
   227	    let hasOrGroup = false;
   228	    let anyOrMatched = false;
   229	
   230	    for (const group of query.trackingGroups) {
   231	        const { type, id, logic } = group;
   232	
   233	        // Pair groups are satisfied from pair-level event state.
   234	        if (group.pairs && group.pairs.length > 0) {
   235	            const pair = group.pairs[0];
   236	            const pairCtx = pair[$internal];
   237	            const trait = pairCtx.relation[$internal].trait;
   238	            const target = pairCtx.target;
   239	
   240	            let traitMatches = false;
   241	            switch (type) {
   242	                case 'add':
   243	                    traitMatches =
   244	                        hasPairEvent(world, id, trait, entity, target, 'add') &&
   245	                        hasRelationPair(world, entity, pair);
   246	                    break;
   247	                case 'remove':
   248	                    traitMatches = hasPairEvent(world, id, trait, entity, target, 'remove');
   249	                    break;
   250	                case 'change':
