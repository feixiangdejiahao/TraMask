{
  "name": "@clack/root",
  "private": true,
  "type": "module",
  "scripts": {
    "stub": "pnpm -r run build --stub",
    "build": "pnpm --filter \"@clack/*\" run build",
    "start": "pnpm run dev",
    "dev": "pnpm --filter @example/changesets run start",
    "format": "biome check --write",
    "lint": "biome lint --write --unsafe",
    "types": "tsc --noEmit",
    "deps": "pnpm exec knip --production",
    "test": "pnpm --color -r run test",
    "pretest": "pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@changesets/cli": "^2.29.5",
    "@types/node": "^24.1.0",
    "jsr": "^0.13.4",
    "knip": "^5.62.0",
    "typescript": "^5.8.3",
    "unbuild": "^3.6.0"
  },
  "packageManager": "pnpm@9.14.2",
  "volta": {
    "node": "20.18.1"
  }
}
---
packages
packages/core
packages/core/test
packages/core/test/prompts
packages/core/src
packages/core/src/utils
packages/core/src/prompts
packages/core/node_modules
packages/core/node_modules/.bin
packages/prompts
packages/prompts/__mocks__
packages/prompts/test
packages/prompts/test/__snapshots__
packages/prompts/src
packages/prompts/node_modules
packages/prompts/node_modules/.bin
packages/prompts/node_modules/@clack
---
packages:
  - 'examples/*'
  - 'packages/*'
