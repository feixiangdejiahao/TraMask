    50		}
    51		if (multiple) {
    52			return values;
    53		}
    54		return values[0];
    55	}
    56	
    57	function isThenable<T>(value: T[] | Promise<T[]> | Thenable<T[]>): value is Promise<T[]> {
    58		return typeof (value as { then?: unknown })?.then === 'function';
    59	}
    60	
    61	export interface AutocompleteOptions<T extends OptionLike>
    62		extends PromptOptions<T['value'] | T['value'][], AutocompletePrompt<T>> {
    63		options: Options<T>;
    64		filter?: FilterFunction<T>;
    65		multiple?: boolean;
   365			this.#clearTimers();
   366			this.#abortCurrentFetch();
   367			const id = ++this.#fetchId;
   368			const controller = new AbortController();
   369			this.#abortController = controller;
   370			const options = this.#resolver.call(this, search, { signal: controller.signal });
   371			this.#abortController = undefined;
   372			this.#options = options;
   373			this.filteredOptions = this.#filterOptions(options, search);
   374			this.#updateCursorAndSelection();
   375			this.#setupInitialValues();
   376			if (id !== this.#fetchId) {
   377				return;
   378			}
   379			this.#renderIfActive();
   380		}
   455					this.#minDurationTimer = setTimeout(apply, remaining);
   456					return;
   457				}
   458			}
   459			apply();
   460		}
   461	
   462		#handleFetchFailure(id: number, search: string, err: Error, startTime: number): void {
   463			if (id !== this.#fetchId || search !== this.#lastUserInput) {
   464				return;
   465			}
   466	
   467			if (err?.name === 'AbortError') {
   468				this.loading = false;
   469				return;
   470			}
