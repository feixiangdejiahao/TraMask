  1040	        """.format(
  1041	            if_not_exists="IF NOT EXISTS " if if_not_exists else "",
  1042	            table=quote_identifier(name),
  1043	            columns_sql=columns_sql,
  1044	            extra_pk=extra_pk,
  1045	            strict=" STRICT" if strict and self.supports_strict else "",
  1046	        )
  1047	        return sql
  1048	
  1049	    def create_table(
  1050	        self,
  1051	        name: str,
  1052	        columns: Dict[str, Any],
  1053	        pk: Optional[Any] = None,
  1054	        foreign_keys: Optional[ForeignKeysType] = None,
  1055	        column_order: Optional[List[str]] = None,
  1056	        not_null: Optional[Iterable[str]] = None,
  1057	        defaults: Optional[Dict[str, Any]] = None,
  1058	        hash_id: Optional[str] = None,
  1059	        hash_id_columns: Optional[Iterable[str]] = None,
  1060	        extracts: Optional[Union[Dict[str, str], List[str]]] = None,
  1061	        if_not_exists: bool = False,
  1062	        replace: bool = False,
  1063	        ignore: bool = False,
  1064	        transform: bool = False,
  1065	        strict: bool = False,
  1066	    ) -> "Table":
  1067	        """
  1068	        Create a table with the specified name and the specified ``{column_name: type}`` columns.
  1069	
  1070	        See :ref:`python_api_explicit_create`.
  1071	
  1072	        :param name: Name of table
  1073	        :param columns: Dictionary mapping column names to their types, for example ``{"name": str, "age": int}``
  1074	        :param pk: String name of column to use as a primary key, or a tuple of strings for a compound primary key covering multiple columns
  1075	        :param foreign_keys: List of foreign key definitions for this table
  1076	        :param column_order: List specifying which columns should come first
  1077	        :param not_null: List of columns that should be created as ``NOT NULL``
  1078	        :param defaults: Dictionary specifying default values for columns
  1079	        :param hash_id: Name of column to be used as a primary key containing a hash of the other columns
  1080	        :param hash_id_columns: List of columns to be used when calculating the hash ID for a row
  1081	        :param extracts: List or dictionary of columns to be extracted during inserts, see :ref:`python_api_extracts`
  1082	        :param if_not_exists: Use ``CREATE TABLE IF NOT EXISTS``
  1083	        :param replace: Drop and replace table if it already exists
  1084	        :param ignore: Silently do nothing if table already exists
  1085	        :param transform: If table already exists transform it to fit the specified schema
  1086	        :param strict: Apply STRICT mode to table
  1087	        """
  1088	        # Transform table to match the new definition if table already exists:
  1089	        if self[name].exists():
  1090	            if ignore:
  1091	                return self.table(name)
  1092	            elif replace:
  1093	                self[name].drop()
  1094	        if transform and self[name].exists():
  1095	            table = self.table(name)
  1096	            should_transform = False
  1097	            # First add missing columns and figure out columns to drop
  1098	            existing_columns = table.columns_dict
  1099	            missing_columns = dict(
  1100	                (col_name, col_type)
  1101	                for col_name, col_type in columns.items()
  1102	                if col_name not in existing_columns
  1103	            )
  1104	            columns_to_drop = [
  1105	                column for column in existing_columns if column not in columns
  1106	            ]
  1107	            if missing_columns:
  1108	                for col_name, col_type in missing_columns.items():
  1109	                    table.add_column(col_name, col_type)
  1110	            if missing_columns or columns_to_drop or columns != existing_columns:
  1111	                should_transform = True
  1112	            # Do we need to change the column order?
  1113	            if (
  1114	                column_order
  1115	                and list(existing_columns)[: len(column_order)] != column_order
  1116	            ):
  1117	                should_transform = True
  1118	            # Has the primary key changed?
  1119	            current_pks = table.pks
  1120	            desired_pk = None
  1121	            if isinstance(pk, str):
  1122	                desired_pk = [pk]
  1123	            elif pk:
  1124	                desired_pk = list(pk)
  1125	            if desired_pk and current_pks != desired_pk:
  1126	                should_transform = True
  1127	            # Any not-null changes?
  1128	            current_not_null = {c.name for c in table.columns if c.notnull}
  1129	            desired_not_null = set(not_null) if not_null else set()
  1130	            if current_not_null != desired_not_null:
  1131	                should_transform = True
  1132	            # How about defaults?
  1133	            if defaults and defaults != table.default_values:
  1134	                should_transform = True
  1135	            # Only run .transform() if there is something to do
  1136	            if should_transform:
  1137	                table.transform(
  1138	                    types=columns,
  1139	                    drop=columns_to_drop,
  1140	                    column_order=column_order,
  1141	                    not_null=not_null,
  1142	                    defaults=defaults,
  1143	                    pk=pk,
  1144	                )
  1145	            return table
  1146	        sql = self.create_table_sql(
  1147	            name=name,
  1148	            columns=columns,
  1149	            pk=pk,
  1150	            foreign_keys=foreign_keys,
  1151	            column_order=column_order,
  1152	            not_null=not_null,
  1153	            defaults=defaults,
  1154	            hash_id=hash_id,
  1155	            hash_id_columns=hash_id_columns,
  1156	            extracts=extracts,
  1157	            if_not_exists=if_not_exists,
  1158	            strict=strict,
  1159	        )
  1160	        self.execute(sql)
  1161	        return self.table(
  1162	            name,
  1163	            pk=pk,
  1164	            foreign_keys=foreign_keys,
  1165	            column_order=column_order,
  1166	            not_null=not_null,
  1167	            defaults=defaults,
  1168	            hash_id=hash_id,
  1169	            hash_id_columns=hash_id_columns,
  1170	        )
  1171	
  1172	    def rename_table(self, name: str, new_name: str) -> None:
  1173	        """
  1174	        Rename a table.
  1175	
  1176	        :param name: Current table name
  1177	        :param new_name: Name to rename it to
  1178	        """
  1179	        self.execute(
  1180	            "ALTER TABLE {} RENAME TO {}".format(
  1181	                quote_identifier(name), quote_identifier(new_name)
  1182	            )
  1183	        )
  1184	
  1185	    def create_view(
  1186	        self, name: str, sql: str, ignore: bool = False, replace: bool = False
  1187	    ) -> "Database":
  1188	        """
  1189	        Create a new SQL view with the specified name - ``sql`` should start with ``SELECT ...``.
  1190	
  1191	        :param name: Name of the view
  1192	        :param sql: SQL ``SELECT`` query to use for this view.
  1193	        :param ignore: Set to ``True`` to do nothing if a view with this name already exists
  1194	        :param replace: Set to ``True`` to replace the view if one with this name already exists
  1195	        """
  1196	        assert not (
  1197	            ignore and replace
  1198	        ), "Use one or the other of ignore/replace, not both"
  1199	        create_sql = "CREATE VIEW {name} AS {sql}".format(
  1200	            name=quote_identifier(name), sql=sql
  1201	        )
  1202	        if ignore or replace:
  1203	            # Does view exist already?
  1204	            if name in self.view_names():
  1205	                if ignore:
  1206	                    return self
  1207	                elif replace:
  1208	                    # If SQL is the same, do nothing
  1209	                    if create_sql == self[name].schema:
  1210	                        return self
  1211	                    self[name].drop()
  1212	        self.execute(create_sql)
  1213	        return self
  1214	
  1215	    def m2m_table_candidates(self, table: str, other_table: str) -> List[str]:
  1216	        """
  1217	        Given two table names returns the name of tables that could define a
  1218	        many-to-many relationship between those two tables, based on having
  1219	        foreign keys to both of the provided tables.
  1220	
  1221	        :param table: Table name
  1222	        :param other_table: Other table name
  1223	        """
  1224	        candidates = []
  1225	        tables = {table, other_table}
  1226	        for table_obj in self.tables:
  1227	            # Does it have foreign keys to both table and other_table?
  1228	            has_fks_to = {fk.other_table for fk in table_obj.foreign_keys}
  1229	            if has_fks_to.issuperset(tables):
  1230	                candidates.append(table_obj.name)
  1231	        return candidates
  1232	
  1233	    def add_foreign_keys(
  1234	        self, foreign_keys: Iterable[Tuple[str, str, str, str]]
  1235	    ) -> None:
  1236	        """
  1237	        See :ref:`python_api_add_foreign_keys`.
  1238	
  1239	        :param foreign_keys: A list of  ``(table, column, other_table, other_column)``
  1240	          tuples
  1241	        """
  1242	        # foreign_keys is a list of explicit 4-tuples
  1243	        assert all(
  1244	            len(fk) == 4 and isinstance(fk, (list, tuple)) for fk in foreign_keys
  1245	        ), "foreign_keys must be a list of 4-tuples, (table, column, other_table, other_column)"
  1246	
  1247	        foreign_keys_to_create = []
  1248	
  1249	        # Verify that all tables and columns exist
  1250	        for table, column, other_table, other_column in foreign_keys:
  1251	            if not self.table(table).exists():
  1252	                raise AlterError("No such table: {}".format(table))
  1253	            table_obj = self.table(table)
  1254	            if column not in table_obj.columns_dict:
  1255	                raise AlterError("No such column: {} in {}".format(column, table))
  1256	            if not self[other_table].exists():
  1257	                raise AlterError("No such other_table: {}".format(other_table))
  1258	            if (
  1259	                other_column != "rowid"
  1260	                and other_column not in self[other_table].columns_dict
  1261	            ):
  1262	                raise AlterError(
  1263	                    "No such other_column: {} in {}".format(other_column, other_table)
  1264	                )
  1265	            # We will silently skip foreign keys that exist already
  1266	            if not any(
  1267	                fk
  1268	                for fk in table_obj.foreign_keys
  1269	                if fk.column == column
  1270	                and fk.other_table == other_table
  1271	                and fk.other_column == other_column
  1272	            ):
  1273	                foreign_keys_to_create.append(
  1274	                    (table, column, other_table, other_column)
  1275	                )
  1276	
  1277	        # Group them by table
  1278	        by_table: Dict[str, List] = {}
  1279	        for fk in foreign_keys_to_create:
  1280	            by_table.setdefault(fk[0], []).append(fk)
  1281	
  1282	        for table, fks in by_table.items():
  1283	            self.table(table).transform(add_foreign_keys=fks)
  1284	
  1285	        self.vacuum()
  1286	
  1287	    def index_foreign_keys(self) -> None:
  1288	        "Create indexes for every foreign key column on every table in the database."
  1289	        for table_name in self.table_names():
  1290	            table = self.table(table_name)
  1291	            existing_indexes = {
  1292	                i.columns[0] for i in table.indexes if len(i.columns) == 1
  1293	            }
  1294	            for fk in table.foreign_keys:
  1295	                if fk.column not in existing_indexes:
  1296	                    table.create_index([fk.column], find_unique_name=True)
  1297	
  1298	    def vacuum(self) -> None:
  1299	        "Run a SQLite ``VACUUM`` against the database."
  1300	        self.execute("VACUUM;")
  1301	
  1302	    def analyze(self, name: Optional[str] = None) -> None:
  1303	        """
  1304	        Run ``ANALYZE`` against the entire database or a named table or index.
  1305	
  1306	        :param name: Run ``ANALYZE`` against this specific named table or index
  1307	        """
  1308	        sql = "ANALYZE"
  1309	        if name is not None:
  1310	            sql += " {}".format(quote_identifier(name))
  1311	        self.execute(sql)
  1312	
  1313	    def iterdump(self) -> Generator[str, None, None]:
  1314	        "A sequence of strings representing a SQL dump of the database"
  1315	        if iterdump:
  1316	            yield from iterdump(self.conn)
  1317	        else:
  1318	            try:
  1319	                yield from self.conn.iterdump()
  1320	            except AttributeError:
  1321	                raise AttributeError(
  1322	                    "conn.iterdump() not found - try pip install sqlite-dump"
  1323	                )
  1324	
  1325	    def init_spatialite(self, path: Optional[str] = None) -> bool:
  1326	        """
  1327	        The ``init_spatialite`` method will load and initialize the SpatiaLite extension.
  1328	        The ``path`` argument should be an absolute path to the compiled extension, which
  1329	        can be found using ``find_spatialite``.
  1330	
  1331	        Returns ``True`` if SpatiaLite was successfully initialized.
  1332	
  1333	        .. code-block:: python
  1334	
  1335	            from sqlite_utils.db import Database
  1336	            from sqlite_utils.utils import find_spatialite
  1337	
  1338	            db = Database("mydb.db")
  1339	            db.init_spatialite(find_spatialite())
  1340	
  1341	        If you've installed SpatiaLite somewhere unexpected (for testing an alternate version, for example)
  1342	        you can pass in an absolute path:
  1343	
  1344	        .. code-block:: python
  1345	
  1346	            from sqlite_utils.db import Database
  1347	            from sqlite_utils.utils import find_spatialite
  1348	
  1349	            db = Database("mydb.db")
  1350	            db.init_spatialite("./local/mod_spatialite.dylib")
  1351	
  1352	        :param path: Path to SpatiaLite module on disk
  1353	        """
  1354	        if path is None:
  1355	            path = find_spatialite()
  1356	        if path is None:
  1357	            raise OSError("Could not find SpatiaLite extension")
  1358	
  1359	        self.conn.enable_load_extension(True)
  1360	        self.conn.load_extension(path)
  1361	        # Initialize SpatiaLite if not yet initialized
  1362	        if "spatial_ref_sys" in self.table_names():
  1363	            return False
  1364	        cursor = self.execute("select InitSpatialMetadata(1)")
  1365	        result = cursor.fetchone()
  1366	        return result and bool(result[0])
  1367	
  1368	
  1369	class Queryable:
  1370	    db: "Database"
  1371	    name: str
  1372	
  1373	    def exists(self) -> bool:
  1374	        "Does this table or view exist yet?"
  1375	        return False
  1376	
  1377	    def __init__(self, db: "Database", name: str) -> None:
  1378	        self.db = db
  1379	        self.name = name
  1380	
  1381	    def count_where(
  1382	        self,
  1383	        where: Optional[str] = None,
  1384	        where_args: Optional[Union[Sequence, Dict[str, Any]]] = None,
  1385	    ) -> int:
  1386	        """
  1387	        Executes ``SELECT count(*) FROM table WHERE ...`` and returns a count.
  1388	
  1389	        :param where: SQL where fragment to use, for example ``id > ?``
  1390	        :param where_args: Parameters to use with that fragment - an iterable for ``id > ?``
  1391	          parameters, or a dictionary for ``id > :id``
  1392	        """
  1393	        sql = "select count(*) from {}".format(quote_identifier(self.name))
  1394	        if where is not None:
  1395	            sql += " where " + where
  1396	        return self.db.execute(sql, where_args or []).fetchone()[0]
  1397	
  1398	    def execute_count(self) -> int:
  1399	        # Backwards compatibility, see https://github.com/simonw/sqlite-utils/issues/305#issuecomment-890713185
  1400	        return self.count_where()
  1401	
  1402	    @property
  1403	    def count(self) -> int:
  1404	        "A count of the rows in this table or view."
  1405	        return self.count_where()
  1406	
  1407	    @property
  1408	    def rows(self) -> Generator[Dict[str, Any], None, None]:
  1409	        "Iterate over every dictionaries for each row in this table or view."
  1410	        return self.rows_where()
  1411	
  1412	    def rows_where(
  1413	        self,
  1414	        where: Optional[str] = None,
  1415	        where_args: Optional[Union[Sequence, Dict[str, Any]]] = None,
  1416	        order_by: Optional[str] = None,
  1417	        select: str = "*",
  1418	        limit: Optional[int] = None,
  1419	        offset: Optional[int] = None,
  1420	    ) -> Generator[Dict[str, Any], None, None]:
  1421	        """
  1422	        Iterate over every row in this table or view that matches the specified where clause.
  1423	
  1424	        Returns each row as a dictionary. See :ref:`python_api_rows` for more details.
  1425	
  1426	        :param where: SQL where fragment to use, for example ``id > ?``
  1427	        :param where_args: Parameters to use with that fragment - an iterable for ``id > ?``
  1428	          parameters, or a dictionary for ``id > :id``
  1429	        :param order_by: Column or fragment of SQL to order by
  1430	        :param select: Comma-separated list of columns to select - defaults to ``*``
  1431	        :param limit: Integer number of rows to limit to
  1432	        :param offset: Integer for SQL offset
  1433	        """
  1434	        if not self.exists():
  1435	            return
  1436	        sql = "select {} from {}".format(select, quote_identifier(self.name))
  1437	        if where is not None:
  1438	            sql += " where " + where
  1439	        if order_by is not None:
  1440	            sql += " order by " + order_by
  1441	        if limit is not None:
  1442	            sql += " limit {}".format(limit)
  1443	        if offset is not None:
  1444	            sql += " offset {}".format(offset)
  1445	        cursor = self.db.execute(sql, where_args or [])
  1446	        columns = [c[0] for c in cursor.description]
  1447	        for row in cursor:
  1448	            yield dict(zip(columns, row))
  1449	
  1450	    def pks_and_rows_where(
  1451	        self,
  1452	        where: Optional[str] = None,
  1453	        where_args: Optional[Union[Sequence, Dict[str, Any]]] = None,
  1454	        order_by: Optional[str] = None,
  1455	        limit: Optional[int] = None,
  1456	        offset: Optional[int] = None,
  1457	    ) -> Generator[Tuple[Any, Dict[str, Any]], None, None]:
  1458	        """
  1459	        Like ``.rows_where()`` but returns ``(pk, row)`` pairs - ``pk`` can be a single value or tuple.
  1460	
  1461	        :param where: SQL where fragment to use, for example ``id > ?``
  1462	        :param where_args: Parameters to use with that fragment - an iterable for ``id > ?``
  1463	          parameters, or a dictionary for ``id > :id``
  1464	        :param order_by: Column or fragment of SQL to order by
  1465	        :param select: Comma-separated list of columns to select - defaults to ``*``
  1466	        :param limit: Integer number of rows to limit to
  1467	        :param offset: Integer for SQL offset
  1468	        """
  1469	        column_names = [column.name for column in self.columns]
  1470	        pks = [column.name for column in self.columns if column.is_pk]
  1471	        if not pks:
  1472	            column_names.insert(0, "rowid")
  1473	            pks = ["rowid"]
  1474	        select = ",".join(quote_identifier(column_name) for column_name in column_names)
  1475	        for row in self.rows_where(
  1476	            select=select,
  1477	            where=where,
  1478	            where_args=where_args,
  1479	            order_by=order_by,
  1480	            limit=limit,
  1481	            offset=offset,
  1482	        ):
  1483	            row_pk = tuple(row[pk] for pk in pks)
  1484	            if len(row_pk) == 1:
  1485	                row_pk = row_pk[0]
  1486	            yield row_pk, row
  1487	
  1488	    @property
  1489	    def columns(self) -> List["Column"]:
  1490	        "List of :ref:`Columns <reference_db_other_column>` representing the columns in this table or view."
  1491	        if not self.exists():
  1492	            return []
  1493	        rows = self.db.execute(
  1494	            "PRAGMA table_info({})".format(quote_identifier(self.name))
  1495	        ).fetchall()
  1496	        return [Column(*row) for row in rows]
  1497	
  1498	    @property
  1499	    def columns_dict(self) -> Dict[str, Any]:
  1500	        "``{column_name: python-type}`` dictionary representing columns in this table or view."
  1501	        return {column.name: column_affinity(column.type) for column in self.columns}
  1502	
  1503	    @property
  1504	    def schema(self) -> str:
  1505	        "SQL schema for this table or view."
  1506	        return self.db.execute(
  1507	            "select sql from sqlite_master where name = ?", (self.name,)
  1508	        ).fetchone()[0]
  1509	
