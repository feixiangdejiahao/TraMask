   975	        self._require_active_checkpoint(checkpoint_id)
   976	        quoted = quote_identifier(checkpoint_id)
   977	        self.execute("ROLLBACK TO SAVEPOINT {}".format(quoted))
   978	        self.execute("RELEASE SAVEPOINT {}".format(quoted))
   979	        # Any checkpoints created after this one were destroyed by the rollback
   980	        try:
   981	            index = self._active_checkpoint_order.index(checkpoint_id)
   982	            for inner_id in self._active_checkpoint_order[index + 1:]:
   983	                self._active_checkpoints.discard(inner_id)
   984	            self._active_checkpoint_order = self._active_checkpoint_order[: index + 1]
   985	        except ValueError:
   986	            pass
   987	        self._forget_checkpoint(checkpoint_id)
   988	        self._finalized_checkpoints.add(checkpoint_id)
   989	
   990	    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
   991	        """
   992	        Remove a checkpoint id from tracking. Active checkpoints are released
   993	        (their changes are kept) and finalized checkpoints are simply forgotten.
   994	
   995	        After cleanup, commit/rollback calls with the same id raise
   996	        :class:`CheckpointNotFoundError`.
   997	        """
   998	        if checkpoint_id in self._active_checkpoints:
   999	            try:
  1000	                self.execute(
  1001	                    "RELEASE SAVEPOINT {}".format(quote_identifier(checkpoint_id))
  1002	                )
  1003	            except Exception:
  1004	                pass
  1005	            self._forget_checkpoint(checkpoint_id)
  1006	        elif checkpoint_id in self._finalized_checkpoints:
  1007	            self._finalized_checkpoints.discard(checkpoint_id)
  1008	        else:
  1009	            raise CheckpointNotFoundError(
  1010	                "Checkpoint {} does not exist".format(checkpoint_id)
  1011	            )
  1012	
  1013	    def _ensure_import_invariants_table(self) -> None:
  1014	        self.execute(
  1015	            _IMPORT_INVARIANTS_TABLE_CREATE_SQL.format(_IMPORT_INVARIANTS_TABLE)
  1016	        )
  1017	
  1018	    def add_import_invariant(self, table: str, sql: str) -> str:
  1019	        """
  1020	        Add a persistent import invariant for a table. Returns an opaque
  1021	        invariant id.
  1022	
  1023	        :param table: Name of the table the invariant applies to
  1024	        :param sql: SQL invariant expression, or a ``SELECT`` statement
  1025	        """
