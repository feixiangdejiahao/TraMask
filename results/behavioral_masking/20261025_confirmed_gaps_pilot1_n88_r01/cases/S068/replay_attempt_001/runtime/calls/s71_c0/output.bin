  1401	    """
  1402	    Upsert records based on their primary key. Works like 'insert' but if
  1403	    an incoming record has a primary key that matches an existing record
  1404	    the existing record will be updated.
  1405	
  1406	    Example:
  1407	
  1408	    \b
  1409	        echo '[
  1410	            {"id": 1, "name": "Lila"},
  1411	            {"id": 2, "name": "Suna"}
  1412	        ]' | sqlite-utils upsert data.db chickens - --pk id
