   405	            assert not recreate, "recreate cannot be used with connections, only paths"
   406	            self.conn = filename_or_conn
   407	        self._tracer = tracer
   408	        if recursive_triggers:
   409	            self.execute("PRAGMA recursive_triggers=on;")
   410	        self._registered_functions: set = set()
   411	        self.use_counts_table = use_counts_table
   412	        if execute_plugins:
   413	            pm.hook.prepare_connection(conn=self.conn)
   414	        self.strict = strict
   415	
   416	    def __enter__(self) -> "Database":
   417	        return self
