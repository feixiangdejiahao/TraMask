    48	
    49	def _register_db_for_cleanup(db):
    50	    """Register a database to be closed when the Click context is cleaned up."""
    51	    ctx = click.get_current_context(silent=True)
    52	    if ctx is None:
    53	        return
    54	    if "_databases_to_close" not in ctx.meta:
    55	        ctx.meta["_databases_to_close"] = []
    56	        ctx.call_on_close(lambda: _close_databases(ctx))
    57	    ctx.meta["_databases_to_close"].append(db)
    58	
    59	
    60	def _close_databases(ctx):
    61	    """Close all databases registered for cleanup."""
    62	    for db in ctx.meta.get("_databases_to_close", []):
    63	        try:
    64	            db.close()
    65	        except Exception:
    66	            pass
    67	
