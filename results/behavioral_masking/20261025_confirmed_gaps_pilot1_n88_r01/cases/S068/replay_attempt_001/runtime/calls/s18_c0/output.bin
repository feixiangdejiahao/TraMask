    86	class CaseInsensitiveChoice(click.Choice):
    87	    def __init__(self, choices):
    88	        super().__init__([choice.lower() for choice in choices])
    89	
    90	    def convert(self, value, param, ctx):
    91	        return super().convert(value.lower(), param, ctx)
    92	
    93	
    94	def output_options(fn):
    95	    for decorator in reversed(
    96	        (
    97	            click.option(
    98	                "--nl",
    99	                help="Output newline-delimited JSON",
   100	                is_flag=True,
   101	                default=False,
   102	            ),
   103	            click.option(
   104	                "--arrays",
   105	                help="Output rows as arrays instead of objects",
   106	                is_flag=True,
   107	                default=False,
   108	            ),
   109	            click.option("--csv", is_flag=True, help="Output CSV"),
   110	            click.option("--tsv", is_flag=True, help="Output TSV"),
   111	            click.option("--no-headers", is_flag=True, help="Omit CSV headers"),
   112	            click.option(
   113	                "-t", "--table", is_flag=True, help="Output as a formatted table"
   114	            ),
   115	            click.option(
   116	                "--fmt",
   117	                help="Table format - one of {}".format(
   118	                    ", ".join(tabulate.tabulate_formats)
   119	                ),
   120	            ),
   121	            click.option(
   122	                "--json-cols",
   123	                help="Detect JSON cols and output them as JSON, not escaped strings",
   124	                is_flag=True,
   125	                default=False,
   126	            ),
   127	        )
   128	    ):
   129	        fn = decorator(fn)
   130	    return fn
   131	
   132	
   133	def load_extension_option(fn):
   134	    return click.option(
   135	        "--load-extension",
   136	        multiple=True,
   137	        help="Path to SQLite extension, with optional :entrypoint",
   138	    )(fn)
   139	
   140	
   141	@click.group(
   142	    cls=DefaultGroup,
   143	    default="query",
   144	    default_if_no_args=True,
   145	    context_settings=CONTEXT_SETTINGS,
   146	)
   147	@click.version_option()
   148	def cli():
   149	    "Commands for interacting with a SQLite database"
   150	    pass
