   440	
   441	        This will reset to the previous autocommit state at the end of the block.
   442	        """
   443	        old_isolation_level = self.conn.isolation_level
   444	        try:
   445	            self.conn.isolation_level = None
   446	            yield
   447	        finally:
   448	            self.conn.isolation_level = old_isolation_level
   449	
   450	    @contextlib.contextmanager
   451	    def tracer(
   452	        self, tracer: Optional[Callable[[str, Optional[Sequence]], None]] = None
   453	    ) -> Generator["Database", None, None]:
   454	        """
   455	        Context manager to temporarily set a tracer function - all executed SQL queries will
   456	        be passed to this.
   457	
   458	        The tracer function should accept two arguments: ``sql`` and ``parameters``
   459	
   460	        Example usage::
   461	
   462	            with db.tracer(print):
   463	                db["creatures"].insert({"name": "Cleo"})
   464	
   465	        See :ref:`python_api_tracing`.
   466	
   467	        :param tracer: Callable accepting ``sql`` and ``parameters`` arguments
   468	        """
   469	        prev_tracer = self._tracer
   470	        self._tracer = tracer or print
