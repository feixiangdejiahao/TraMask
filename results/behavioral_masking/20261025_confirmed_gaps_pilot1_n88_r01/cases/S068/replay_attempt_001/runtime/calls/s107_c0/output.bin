   953	    def commit_checkpoint(self, checkpoint_id: str) -> None:
   954	        """
   955	        Commit a checkpoint created using :meth:`create_import_checkpoint`.
   956	        Any changes made since the checkpoint was created are kept.
   957	
   958	        Committing finalizes the checkpoint: further commit or rollback calls
   959	        with the same id will raise :class:`CheckpointNotActiveError`.
   960	        """
   961	        self._require_active_checkpoint(checkpoint_id)
   962	        self.execute("RELEASE SAVEPOINT {}".format(quote_identifier(checkpoint_id)))
   963	        self._forget_checkpoint(checkpoint_id)
   964	        self._finalized_checkpoints.add(checkpoint_id)
