   942	    def _require_active_checkpoint(self, checkpoint_id: str) -> None:
   943	        if checkpoint_id in self._active_checkpoints:
   944	            return
   945	        if checkpoint_id in self._finalized_checkpoints:
   946	            raise CheckpointNotActiveError(
   947	                "Checkpoint {} is no longer active".format(checkpoint_id)
   948	            )
   949	        raise CheckpointNotFoundError(
   950	            "Checkpoint {} does not exist".format(checkpoint_id)
   951	        )
