   937	    def _forget_checkpoint(self, checkpoint_id: str) -> None:
   938	        self._active_checkpoints.discard(checkpoint_id)
   939	        if checkpoint_id in self._active_checkpoint_order:
   940	            self._active_checkpoint_order.remove(checkpoint_id)
