  1671	    @property
  1672	    def indexes(self) -> List[Index]:
  1673	        "List of indexes defined on this table."
  1674	        sql = 'PRAGMA index_list("{}")'.format(self.name)
  1675	        indexes = []
  1676	        for row in self.db.execute_returning_dicts(sql):
  1677	            index_name = row["name"]
  1678	            index_name_quoted = (
  1679	                '"{}"'.format(index_name)
  1680	                if not index_name.startswith('"')
  1681	                else index_name
  1682	            )
  1683	            column_sql = "PRAGMA index_info({})".format(index_name_quoted)
  1684	            columns = []
  1685	            for seqno, cid, name in self.db.execute(column_sql).fetchall():
  1686	                columns.append(name)
  1687	            row["columns"] = columns
  1688	            # These columns may be missing on older SQLite versions:
  1689	            for key, default in {"origin": "c", "partial": 0}.items():
  1690	                if key not in row:
  1691	                    row[key] = default
  1692	            indexes.append(Index(**row))
  1693	        return indexes
  1694	
  1695	    @property
  1696	    def xindexes(self) -> List[XIndex]:
  1697	        "List of indexes defined on this table using the more detailed ``XIndex`` format."
  1698	        sql = 'PRAGMA index_list("{}")'.format(self.name)
  1699	        indexes = []
  1700	        for row in self.db.execute_returning_dicts(sql):
  1701	            index_name = row["name"]
  1702	            index_name_quoted = (
  1703	                '"{}"'.format(index_name)
  1704	                if not index_name.startswith('"')
  1705	                else index_name
  1706	            )
  1707	            column_sql = "PRAGMA index_xinfo({})".format(index_name_quoted)
  1708	            index_columns = []
  1709	            for info in self.db.execute(column_sql).fetchall():
  1710	                index_columns.append(XIndexColumn(*info))
  1711	            indexes.append(XIndex(index_name, index_columns))
  1712	        return indexes
