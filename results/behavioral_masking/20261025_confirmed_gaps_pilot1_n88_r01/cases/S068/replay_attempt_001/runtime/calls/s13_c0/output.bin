  1714	    @property
  1715	    def triggers(self) -> List[Trigger]:
  1716	        "List of triggers defined on this table."
  1717	        return [
  1718	            Trigger(*r)
  1719	            for r in self.db.execute(
  1720	                "select name, tbl_name, sql from sqlite_master where type = 'trigger'"
  1721	                " and tbl_name = ?",
  1722	                (self.name,),
  1723	            ).fetchall()
  1724	        ]
  1725	
  1726	    @property
  1727	    def triggers_dict(self) -> Dict[str, str]:
