  1581	    def __repr__(self) -> str:
  1582	        return "<Table {}{}>".format(
  1583	            self.name,
  1584	            (
  1585	                " (does not exist yet)"
  1586	                if not self.exists()
  1587	                else " ({})".format(", ".join(c.name for c in self.columns))
  1588	            ),
  1589	        )
  1590	
  1591	    @property
  1592	    def count(self) -> int:
  1593	        "Count of the rows in this table - optionally from the table count cache, if configured."
  1594	        if self.db.use_counts_table:
  1595	            counts = self.db.cached_counts([self.name])
  1596	            if counts:
  1597	                return next(iter(counts.values()))
  1598	        return self.count_where()
  1599	
  1600	    def exists(self) -> bool:
  1601	        return self.name in self.db.table_names()
  1602	
  1603	    @property
  1604	    def pks(self) -> List[str]:
  1605	        "Primary key columns for this table."
  1606	        names = [column.name for column in self.columns if column.is_pk]
  1607	        if not names:
  1608	            names = ["rowid"]
  1609	        return names
  1610	
  1611	    @property
  1612	    def use_rowid(self) -> bool:
  1613	        "Does this table use ``rowid`` for its primary key (no other primary keys are specified)?"
  1614	        return not any(column for column in self.columns if column.is_pk)
  1615	
  1616	    def get(self, pk_values: Union[list, tuple, str, int]) -> dict:
  1617	        """
  1618	        Return row (as dictionary) for the specified primary key.
  1619	
  1620	        Raises ``sqlite_utils.db.NotFoundError`` if a matching row cannot be found.
  1621	
  1622	        :param pk_values: A single value, or a tuple of values for tables that have a compound primary key
  1623	        """
  1624	        if not isinstance(pk_values, (list, tuple)):
  1625	            pk_values = [pk_values]
  1626	        pks = self.pks
  1627	        last_pk = pk_values[0] if len(pks) == 1 else pk_values
  1628	        if len(pks) != len(pk_values):
  1629	            raise NotFoundError(
  1630	                "Need {} primary key value{}".format(
  1631	                    len(pks), "" if len(pks) == 1 else "s"
  1632	                )
  1633	            )
  1634	
  1635	        wheres = ["{} = ?".format(quote_identifier(pk_name)) for pk_name in pks]
  1636	        rows = self.rows_where(" and ".join(wheres), pk_values)
  1637	        try:
  1638	            row = list(rows)[0]
  1639	            self.last_pk = last_pk
  1640	            return row
  1641	        except IndexError:
  1642	            raise NotFoundError
  1643	
  1644	    @property
  1645	    def foreign_keys(self) -> List["ForeignKey"]:
  1646	        "List of foreign keys defined on this table."
  1647	        fks = []
  1648	        for row in self.db.execute(
  1649	            "PRAGMA foreign_key_list({})".format(quote_identifier(self.name))
  1650	        ).fetchall():
  1651	            if row is not None:
  1652	                id, seq, table_name, from_, to_, on_update, on_delete, match = row
  1653	                fks.append(
  1654	                    ForeignKey(
  1655	                        table=self.name,
  1656	                        column=from_,
  1657	                        other_table=table_name,
  1658	                        other_column=to_,
  1659	                    )
  1660	                )
  1661	        return fks
  1662	
  1663	    @property
  1664	    def virtual_table_using(self) -> Optional[str]:
  1665	        "Type of virtual table, or ``None`` if this is not a virtual table."
  1666	        match = _virtual_table_using_re.match(self.schema)
  1667	        if match is None:
  1668	            return None
  1669	        return match.groupdict()["using"].upper()
