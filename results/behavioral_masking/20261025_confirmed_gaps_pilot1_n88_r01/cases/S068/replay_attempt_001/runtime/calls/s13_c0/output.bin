  1837	    def duplicate(self, new_name: str) -> "Table":
  1838	        """
  1839	        Create a duplicate of this table, copying across the schema and all row data.
  1840	
  1841	        :param new_name: Name of the new table
  1842	        """
  1843	        if not self.exists():
  1844	            raise NoTable(f"Table {self.name} does not exist")
  1845	        with self.db.conn:
  1846	            sql = "CREATE TABLE {} AS SELECT * FROM {};".format(
  1847	                quote_identifier(new_name),
  1848	                quote_identifier(self.name),
  1849	            )
  1850	            self.db.execute(sql)
  1851	        return self.db.table(new_name)
