  1542	    def __init__(
  1543	        self,
  1544	        db: Database,
  1545	        name: str,
  1546	        pk: Optional[Any] = None,
  1547	        foreign_keys: Optional[ForeignKeysType] = None,
  1548	        column_order: Optional[List[str]] = None,
  1549	        not_null: Optional[Iterable[str]] = None,
  1550	        defaults: Optional[Dict[str, Any]] = None,
  1551	        batch_size: int = 100,
  1552	        hash_id: Optional[str] = None,
  1553	        hash_id_columns: Optional[Iterable[str]] = None,
  1554	        alter: bool = False,
  1555	        ignore: bool = False,
  1556	        replace: bool = False,
  1557	        extracts: Optional[Union[Dict[str, str], List[str]]] = None,
  1558	        conversions: Optional[dict] = None,
  1559	        columns: Optional[Dict[str, Any]] = None,
  1560	        strict: bool = False,
  1561	    ):
  1562	        super().__init__(db, name)
  1563	        self._defaults = dict(
  1564	            pk=pk,
  1565	            foreign_keys=foreign_keys,
  1566	            column_order=column_order,
  1567	            not_null=not_null,
  1568	            defaults=defaults,
  1569	            batch_size=batch_size,
  1570	            hash_id=hash_id,
  1571	            hash_id_columns=hash_id_columns,
  1572	            alter=alter,
  1573	            ignore=ignore,
  1574	            replace=replace,
