  1740	    @property
  1741	    def strict(self) -> bool:
  1742	        "Is this a STRICT table?"
  1743	        table_suffix = self.schema.split(")")[-1].strip().upper()
  1744	        table_options = [bit.strip() for bit in table_suffix.split(",")]
  1745	        return "STRICT" in table_options
