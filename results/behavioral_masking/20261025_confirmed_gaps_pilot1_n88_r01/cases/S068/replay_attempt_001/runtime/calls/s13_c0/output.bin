  1747	    def create(
  1748	        self,
  1749	        columns: Dict[str, Any],
  1750	        pk: Optional[Any] = DEFAULT,
  1751	        foreign_keys: Union[Optional[ForeignKeysType], Default] = DEFAULT,
  1752	        column_order: Union[Optional[List[str]], Default] = DEFAULT,
  1753	        not_null: Union[Optional[Iterable[str]], Default] = DEFAULT,
  1754	        defaults: Union[Optional[Dict[str, Any]], Default] = DEFAULT,
  1755	        hash_id: Union[Optional[str], Default] = DEFAULT,
  1756	        hash_id_columns: Union[Optional[Iterable[str]], Default] = DEFAULT,
  1757	        extracts: Union[Optional[Union[Dict[str, str], List[str]]], Default] = DEFAULT,
  1758	        if_not_exists: bool = False,
  1759	        replace: bool = False,
  1760	        ignore: bool = False,
  1761	        transform: bool = False,
  1762	        strict: Union[bool, Default] = DEFAULT,
  1763	    ) -> "Table":
  1764	        """
  1765	        Create a table with the specified columns.
  1766	
  1767	        See :ref:`python_api_explicit_create` for full details.
  1768	
  1769	        :param columns: Dictionary mapping column names to their types, for example ``{"name": str, "age": int}``
  1770	        :param pk: String name of column to use as a primary key, or a tuple of strings for a compound primary key covering multiple columns
  1771	        :param foreign_keys: List of foreign key definitions for this table
  1772	        :param column_order: List specifying which columns should come first
  1773	        :param not_null: List of columns that should be created as ``NOT NULL``
  1774	        :param defaults: Dictionary specifying default values for columns
  1775	        :param hash_id: Name of column to be used as a primary key containing a hash of the other columns
  1776	        :param hash_id_columns: List of columns to be used when calculating the hash ID for a row
  1777	        :param extracts: List or dictionary of columns to be extracted during inserts, see :ref:`python_api_extracts`
  1778	        :param if_not_exists: Use ``CREATE TABLE IF NOT EXISTS``
  1779	        :param replace: Drop and replace table if it already exists
  1780	        :param ignore: Silently do nothing if table already exists
  1781	        :param transform: If table already exists transform it to fit the specified schema
  1782	        :param strict: Apply STRICT mode to table
  1783	        """
  1784	        # Resolve defaults from _defaults (issue #655)
  1785	        pk = self.value_or_default("pk", pk)
  1786	        foreign_keys = self.value_or_default("foreign_keys", foreign_keys)
  1787	        column_order = self.value_or_default("column_order", column_order)
  1788	        not_null = self.value_or_default("not_null", not_null)
  1789	        defaults = self.value_or_default("defaults", defaults)
  1790	        hash_id = self.value_or_default("hash_id", hash_id)
  1791	        hash_id_columns = self.value_or_default("hash_id_columns", hash_id_columns)
  1792	        extracts = self.value_or_default("extracts", extracts)
  1793	        strict = self.value_or_default("strict", strict)
  1794	
  1795	        # Store configuration in _defaults for subsequent operations (issue #655)
  1796	        # Don't store pk if hash_id is set, since pk is derived from hash_id in that case
  1797	        if pk is not None and hash_id is None:
  1798	            self._defaults["pk"] = pk
  1799	        if foreign_keys is not None:
  1800	            self._defaults["foreign_keys"] = foreign_keys
  1801	        if column_order is not None:
  1802	            self._defaults["column_order"] = column_order
  1803	        if not_null is not None:
  1804	            self._defaults["not_null"] = not_null
  1805	        if defaults is not None:
  1806	            self._defaults["defaults"] = defaults
  1807	        if hash_id is not None:
  1808	            self._defaults["hash_id"] = hash_id
  1809	        if hash_id_columns is not None:
  1810	            self._defaults["hash_id_columns"] = hash_id_columns
  1811	        if extracts is not None:
  1812	            self._defaults["extracts"] = extracts
  1813	        if strict:
  1814	            self._defaults["strict"] = strict
  1815	
  1816	        columns = {name: value for (name, value) in columns.items()}
  1817	        with self.db.conn:
  1818	            self.db.create_table(
  1819	                self.name,
  1820	                columns,
  1821	                pk=pk,
  1822	                foreign_keys=foreign_keys,  # type: ignore[arg-type]
  1823	                column_order=column_order,  # type: ignore[arg-type]
  1824	                not_null=not_null,  # type: ignore[arg-type]
  1825	                defaults=defaults,  # type: ignore[arg-type]
  1826	                hash_id=hash_id,  # type: ignore[arg-type]
  1827	                hash_id_columns=hash_id_columns,  # type: ignore[arg-type]
  1828	                extracts=extracts,  # type: ignore[arg-type]
  1829	                if_not_exists=if_not_exists,
  1830	                replace=replace,
  1831	                ignore=ignore,
  1832	                transform=transform,
  1833	                strict=strict,  # type: ignore[arg-type]
  1834	            )
  1835	        return self
