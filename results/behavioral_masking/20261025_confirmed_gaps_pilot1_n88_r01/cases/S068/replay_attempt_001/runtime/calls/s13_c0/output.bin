  1511	class Table(Queryable):
  1512	    """
  1513	    Tables should usually be initialized using the ``db.table(table_name)`` or
  1514	    ``db[table_name]`` methods.
  1515	
  1516	    The following optional parameters can be passed to ``db.table(table_name, ...)``:
  1517	
  1518	    :param db: Provided by ``db.table(table_name)``
  1519	    :param name: Provided by ``db.table(table_name)``
  1520	    :param pk: Name of the primary key column, or tuple of columns
  1521	    :param foreign_keys: List of foreign key definitions
  1522	    :param column_order: List of column names in the order they should be in the table
  1523	    :param not_null: List of columns that cannot be null
  1524	    :param defaults: Dictionary of column names and default values
  1525	    :param batch_size: Integer number of rows to insert at a time
  1526	    :param hash_id: If True, use a hash of the row values as the primary key
  1527	    :param hash_id_columns: List of columns to use for the hash_id
  1528	    :param alter: If True, automatically alter the table if it doesn't match the schema
  1529	    :param ignore: If True, ignore rows that already exist when inserting
  1530	    :param replace: If True, replace rows that already exist when inserting
