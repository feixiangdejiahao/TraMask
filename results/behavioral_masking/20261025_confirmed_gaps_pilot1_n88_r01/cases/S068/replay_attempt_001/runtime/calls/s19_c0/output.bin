   782	@cli.command(name="disable-wal")
   783	@click.argument(
   784	    "path",
   785	    nargs=-1,
   786	    type=click.Path(exists=True, file_okay=True, dir_okay=False, allow_dash=False),
   787	    required=True,
   788	)
   789	@load_extension_option
   790	def disable_wal(path, load_extension):
   791	    """Disable WAL for database files
   792	
   793	    Example:
   794	
   795	    \b
   796	        sqlite-utils disable-wal chickens.db
   797	    """
   798	    for path_ in path:
   799	        db = sqlite_utils.Database(path_)
   800	        _register_db_for_cleanup(db)
   801	        _load_extensions(db, load_extension)
   802	        db.disable_wal()
   803	
