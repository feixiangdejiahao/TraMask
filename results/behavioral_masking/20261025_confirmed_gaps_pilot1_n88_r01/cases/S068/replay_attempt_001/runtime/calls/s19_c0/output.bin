   805	@cli.command(name="enable-counts")
   806	@click.argument(
   807	    "path",
   808	    type=click.Path(exists=True, file_okay=True, dir_okay=False, allow_dash=False),
   809	    required=True,
   810	)
   811	@click.argument("tables", nargs=-1)
   812	@load_extension_option
   813	def enable_counts(path, tables, load_extension):
   814	    """Configure triggers to update a _counts table with row counts
   815	
   816	    Example:
   817	
   818	    \b
   819	        sqlite-utils enable-counts chickens.db
   820	    """
   821	    db = sqlite_utils.Database(path)
   822	    _register_db_for_cleanup(db)
   823	    _load_extensions(db, load_extension)
   824	    if not tables:
   825	        db.enable_counts()
   826	    else:
   827	        # Check all tables exist
   828	        bad_tables = [table for table in tables if not db[table].exists()]
   829	        if bad_tables:
   830	            raise click.ClickException("Invalid tables: {}".format(bad_tables))
   831	        for table in tables:
   832	            db.table(table).enable_counts()
   833	
