   856	_import_options = (
   857	    click.option(
   858	        "--flatten",
   859	        is_flag=True,
   860	        help='Flatten nested JSON objects, so {"a": {"b": 1}} becomes {"a_b": 1}',
   861	    ),
   862	    click.option("--nl", is_flag=True, help="Expect newline-delimited JSON"),
   863	    click.option("-c", "--csv", is_flag=True, help="Expect CSV input"),
   864	    click.option("--tsv", is_flag=True, help="Expect TSV input"),
   865	    click.option("--empty-null", is_flag=True, help="Treat empty strings as NULL"),
   866	    click.option(
   867	        "--lines",
   868	        is_flag=True,
   869	        help="Treat each line as a single value called 'line'",
   870	    ),
   871	    click.option(
   872	        "--text",
   873	        is_flag=True,
   874	        help="Treat input as a single value called 'text'",
   875	    ),
   876	    click.option("--convert", help="Python code to convert each item"),
   877	    click.option(
   878	        "--import",
   879	        "imports",
   880	        type=str,
   881	        multiple=True,
   882	        help="Python modules to import",
   883	    ),
   884	    click.option("--delimiter", help="Delimiter to use for CSV files"),
   885	    click.option("--quotechar", help="Quote character to use for CSV/TSV"),
   886	    click.option("--sniff", is_flag=True, help="Detect delimiter and quote character"),
   887	    click.option("--no-headers", is_flag=True, help="CSV file has no header row"),
   888	    click.option(
   889	        "--encoding",
   890	        help="Character encoding for input, defaults to utf-8",
   891	    ),
   892	)
   893	
   894	
   895	def import_options(fn):
   896	    for decorator in reversed(_import_options):
   897	        fn = decorator(fn)
   898	    return fn
   899	
   900	
   901	def insert_upsert_options(*, require_pk=False):
   902	    def inner(fn):
   903	        for decorator in reversed(
   904	            (
   905	                click.argument(
   906	                    "path",
   907	                    type=click.Path(file_okay=True, dir_okay=False, allow_dash=False),
   908	                    required=True,
   909	                ),
   910	                click.argument("table"),
   911	                click.argument("file", type=click.File("rb", lazy=True), required=True),
   912	                click.option(
   913	                    "--pk",
   914	                    help="Columns to use as the primary key, e.g. id",
   915	                    multiple=True,
   916	                    required=require_pk,
   917	                ),
   918	            )
   919	            + _import_options
   920	            + (
   921	                click.option(
   922	                    "--batch-size", type=int, default=100, help="Commit every X records"
   923	                ),
   924	                click.option("--stop-after", type=int, help="Stop after X records"),
   925	                click.option(
   926	                    "--alter",
   927	                    is_flag=True,
   928	                    help="Alter existing table to add any missing columns",
   929	                ),
   930	                click.option(
   931	                    "--not-null",
   932	                    multiple=True,
   933	                    help="Columns that should be created as NOT NULL",
   934	                ),
   935	                click.option(
   936	                    "--default",
   937	                    multiple=True,
   938	                    type=(str, str),
   939	                    help="Default value that should be set for a column",
   940	                ),
   941	                click.option(
   942	                    "-d",
   943	                    "--detect-types",
   944	                    is_flag=True,
   945	                    help="Detect types for columns in CSV/TSV data (default)",
   946	                ),
   947	                click.option(
   948	                    "--no-detect-types",
   949	                    is_flag=True,
   950	                    help="Treat all CSV/TSV columns as TEXT",
   951	                ),
   952	                click.option(
   953	                    "--analyze",
   954	                    is_flag=True,
   955	                    help="Run ANALYZE at the end of this operation",
   956	                ),
   957	                load_extension_option,
   958	                click.option("--silent", is_flag=True, help="Do not show progress bar"),
   959	                click.option(
   960	                    "--strict",
   961	                    is_flag=True,
   962	                    default=False,
   963	                    help="Apply STRICT mode to created table",
   964	                ),
   965	            )
   966	        ):
   967	            fn = decorator(fn)
   968	        return fn
   969	
   970	    return inner
   971	
   972	
   973	def insert_upsert_implementation(
   974	    path,
   975	    table,
   976	    file,
   977	    pk,
   978	    flatten,
   979	    nl,
   980	    csv,
   981	    tsv,
   982	    empty_null,
   983	    lines,
   984	    text,
   985	    convert,
   986	    imports,
   987	    delimiter,
   988	    quotechar,
   989	    sniff,
   990	    no_headers,
   991	    encoding,
   992	    batch_size,
   993	    stop_after,
   994	    alter,
   995	    upsert,
   996	    ignore=False,
   997	    replace=False,
   998	    truncate=False,
   999	    not_null=None,
  1000	    default=None,
  1001	    detect_types=None,
  1002	    no_detect_types=False,
  1003	    analyze=False,
  1004	    load_extension=None,
  1005	    silent=False,
  1006	    bulk_sql=None,
  1007	    functions=None,
  1008	    strict=False,
  1009	):
  1010	    db = sqlite_utils.Database(path)
  1011	    _register_db_for_cleanup(db)
  1012	    _load_extensions(db, load_extension)
  1013	    _maybe_register_functions(db, functions)
  1014	    if (delimiter or quotechar or sniff or no_headers) and not tsv:
  1015	        csv = True
  1016	    if (nl + csv + tsv) >= 2:
  1017	        raise click.ClickException("Use just one of --nl, --csv or --tsv")
  1018	    if (csv or tsv) and flatten:
  1019	        raise click.ClickException("--flatten cannot be used with --csv or --tsv")
  1020	    if empty_null and not (csv or tsv):
  1021	        raise click.ClickException("--empty-null can only be used with --csv or --tsv")
  1022	    if encoding and not (csv or tsv):
  1023	        raise click.ClickException("--encoding must be used with --csv or --tsv")
  1024	    if pk and len(pk) == 1:
  1025	        pk = pk[0]
  1026	    encoding = encoding or "utf-8-sig"
  1027	
  1028	    # The --sniff option needs us to buffer the file to peek ahead
  1029	    sniff_buffer = None
  1030	    decoded_buffer = None
  1031	    if sniff:
  1032	        sniff_buffer = io.BufferedReader(file, buffer_size=4096)
  1033	        decoded_buffer = io.TextIOWrapper(sniff_buffer, encoding=encoding)
  1034	    else:
  1035	        decoded_buffer = io.TextIOWrapper(file, encoding=encoding)
  1036	
  1037	    tracker = None
  1038	    with file_progress(decoded_buffer, silent=silent) as decoded:
  1039	        if csv or tsv:
  1040	            if sniff:
  1041	                # Read first 2048 bytes and use that to detect
  1042	                assert sniff_buffer is not None
  1043	                first_bytes = sniff_buffer.peek(2048)
  1044	                dialect = csv_std.Sniffer().sniff(
  1045	                    first_bytes.decode(encoding, "ignore")
  1046	                )
  1047	            else:
  1048	                dialect = "excel-tab" if tsv else "excel"
  1049	            csv_reader_args: dict[str, Any] = {"dialect": dialect}
  1050	            if delimiter:
  1051	                csv_reader_args["delimiter"] = delimiter
  1052	            if quotechar:
  1053	                csv_reader_args["quotechar"] = quotechar
  1054	            reader = csv_std.reader(decoded, **csv_reader_args)  # type: ignore
  1055	            first_row = next(reader)
  1056	            if no_headers:
  1057	                headers = ["untitled_{}".format(i + 1) for i in range(len(first_row))]
  1058	                reader = itertools.chain([first_row], reader)
  1059	            else:
  1060	                headers = first_row
  1061	            if empty_null:
  1062	                docs = (
  1063	                    dict(zip(headers, [None if cell == "" else cell for cell in row]))
  1064	                    for row in reader
  1065	                )
  1066	            else:
  1067	                docs = (dict(zip(headers, row)) for row in reader)
  1068	            # detect_types is now the default, unless --no-detect-types is passed
  1069	            if not no_detect_types:
  1070	                tracker = TypeTracker()
  1071	                docs = tracker.wrap(docs)
  1072	        elif lines:
  1073	            docs = ({"line": line.strip()} for line in decoded)
  1074	        elif text:
  1075	            docs = ({"text": decoded.read()},)
  1076	        else:
  1077	            try:
  1078	                if nl:
  1079	                    docs = (json.loads(line) for line in decoded if line.strip())
  1080	                else:
  1081	                    docs = json.load(decoded)
  1082	                    if isinstance(docs, dict):
  1083	                        docs = [docs]
  1084	            except json.decoder.JSONDecodeError as ex:
  1085	                raise click.ClickException(
  1086	                    "Invalid JSON - use --csv for CSV or --tsv for TSV files\n\nJSON error: {}".format(
  1087	                        ex
  1088	                    )
  1089	                )
  1090	            if flatten:
  1091	                docs = (_flatten(doc) for doc in docs)
  1092	
  1093	        if stop_after:
  1094	            docs = itertools.islice(docs, stop_after)
  1095	
  1096	        if convert:
  1097	            variable = "row"
  1098	            if lines:
  1099	                variable = "line"
  1100	            elif text:
  1101	                variable = "text"
  1102	            fn = _compile_code(convert, imports, variable=variable)
  1103	            if lines:
  1104	                docs = (fn(doc["line"]) for doc in docs)
  1105	            elif text:
  1106	                # Special case: this is allowed to be an iterable
  1107	                text_value = list(docs)[0]["text"]
  1108	                fn_return = fn(text_value)
  1109	                if isinstance(fn_return, dict):
  1110	                    docs = [fn_return]
  1111	                else:
  1112	                    try:
  1113	                        docs = iter(fn_return)
  1114	                    except TypeError:
  1115	                        raise click.ClickException(
  1116	                            "--convert must return dict or iterator"
  1117	                        )
  1118	            else:
  1119	                docs = (fn(doc) or doc for doc in docs)
  1120	
  1121	        extra_kwargs = {
  1122	            "ignore": ignore,
  1123	            "replace": replace,
  1124	            "truncate": truncate,
  1125	            "analyze": analyze,
  1126	            "strict": strict,
  1127	        }
  1128	        if not_null:
  1129	            extra_kwargs["not_null"] = set(not_null)
  1130	        if default:
  1131	            extra_kwargs["defaults"] = dict(default)
  1132	        if upsert:
  1133	            extra_kwargs["upsert"] = upsert
  1134	
  1135	        # docs should all be dictionaries
  1136	        docs = (verify_is_dict(doc) for doc in docs)
  1137	
  1138	        # Apply {"$base64": true, ...} decoding, if needed
  1139	        docs = (decode_base64_values(doc) for doc in docs)
  1140	
  1141	        # For bulk_sql= we use cursor.executemany() instead
  1142	        if bulk_sql:
  1143	            if batch_size:
  1144	                doc_chunks = chunks(docs, batch_size)
  1145	            else:
  1146	                doc_chunks = [docs]
  1147	            for doc_chunk in doc_chunks:
  1148	                with db.conn:
  1149	                    db.conn.cursor().executemany(bulk_sql, doc_chunk)
  1150	            return
  1151	
  1152	        try:
  1153	            db.table(table).insert_all(
  1154	                docs, pk=pk, batch_size=batch_size, alter=alter, **extra_kwargs
  1155	            )
  1156	        except Exception as e:
  1157	            if (
  1158	                isinstance(e, OperationalError)
  1159	                and e.args
  1160	                and (
  1161	                    "has no column named" in e.args[0] or "no such column" in e.args[0]
  1162	                )
  1163	            ):
  1164	                raise click.ClickException(
  1165	                    "{}\n\nTry using --alter to add additional columns".format(
  1166	                        e.args[0]
  1167	                    )
  1168	                )
  1169	            # If we can find sql= and parameters= arguments, show those
  1170	            variables = _find_variables(e.__traceback__, ["sql", "parameters"])
  1171	            if "sql" in variables and "parameters" in variables:
  1172	                raise click.ClickException(
  1173	                    "{}\n\nsql = {}\nparameters = {}".format(
  1174	                        str(e), variables["sql"], variables["parameters"]
  1175	                    )
  1176	                )
  1177	            else:
  1178	                raise
  1179	        if tracker is not None:
  1180	            db.table(table).transform(types=tracker.types)
  1181	
  1182	        # Clean up open file-like objects
  1183	        if sniff_buffer:
  1184	            sniff_buffer.close()
  1185	        if decoded_buffer:
  1186	            decoded_buffer.close()
  1187	
  1188	
  1189	def _find_variables(tb, vars):
  1190	    to_find = list(vars)
  1191	    found = {}
  1192	    for var in to_find:
  1193	        if var in tb.tb_frame.f_locals:
  1194	            vars.remove(var)
  1195	            found[var] = tb.tb_frame.f_locals[var]
  1196	    if vars and tb.tb_next:
  1197	        found.update(_find_variables(tb.tb_next, vars))
  1198	    return found
  1199	
