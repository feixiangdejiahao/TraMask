   835	@cli.command(name="reset-counts")
   836	@click.argument(
   837	    "path",
   838	    type=click.Path(exists=True, file_okay=True, dir_okay=False, allow_dash=False),
   839	    required=True,
   840	)
   841	@load_extension_option
   842	def reset_counts(path, load_extension):
   843	    """Reset calculated counts in the _counts table
   844	
   845	    Example:
   846	
   847	    \b
   848	        sqlite-utils reset-counts chickens.db
   849	    """
   850	    db = sqlite_utils.Database(path)
   851	    _register_db_for_cleanup(db)
   852	    _load_extensions(db, load_extension)
   853	    db.reset_counts()
