  1419	@cli.command()
  1420	@click.argument(
  1421	    "path",
  1422	    type=click.Path(file_okay=True, dir_okay=False, allow_dash=False),
  1423	    required=True,
  1424	)
  1425	@click.argument("sql")
  1426	@click.argument("file", type=click.File("rb"), required=True)
  1427	@click.option("--batch-size", type=int, default=100, help="Commit every X records")
  1428	@click.option(
  1429	    "--functions",
  1430	    help="Python code or file path defining custom SQL functions",
  1431	    multiple=True,
  1432	)
  1433	@import_options
  1434	@load_extension_option
  1435	def bulk(
  1436	    path,
  1437	    sql,
  1438	    file,
  1439	    batch_size,
  1440	    functions,
  1441	    flatten,
  1442	    nl,
  1443	    csv,
  1444	    tsv,
  1445	    empty_null,
  1446	    lines,
  1447	    text,
  1448	    convert,
  1449	    imports,
  1450	    delimiter,
  1451	    quotechar,
  1452	    sniff,
  1453	    no_headers,
  1454	    encoding,
  1455	    load_extension,
  1456	):
  1457	    """
  1458	    Execute parameterized SQL against the provided list of documents.
  1459	
  1460	    Example:
  1461	
  1462	    \b
  1463	        echo '[
  1464	            {"id": 1, "name": "Lila2"},
  1465	            {"id": 2, "name": "Suna2"}
  1466	        ]' | sqlite-utils bulk data.db '
  1467	            update chickens set name = :name where id = :id
  1468	        ' -
  1469	    """
  1470	    try:
  1471	        insert_upsert_implementation(
  1472	            path=path,
  1473	            table=None,
  1474	            file=file,
  1475	            pk=None,
  1476	            flatten=flatten,
  1477	            nl=nl,
  1478	            csv=csv,
  1479	            tsv=tsv,
  1480	            empty_null=empty_null,
  1481	            lines=lines,
  1482	            text=text,
  1483	            convert=convert,
  1484	            imports=imports,
  1485	            delimiter=delimiter,
  1486	            quotechar=quotechar,
  1487	            sniff=sniff,
  1488	            no_headers=no_headers,
  1489	            encoding=encoding,
  1490	            batch_size=batch_size,
  1491	            stop_after=None,
  1492	            alter=False,
  1493	            upsert=False,
  1494	            not_null=set(),
  1495	            default={},
  1496	            detect_types=False,
  1497	            no_detect_types=True,
  1498	            load_extension=load_extension,
  1499	            silent=False,
  1500	            bulk_sql=sql,
  1501	            functions=functions,
  1502	        )
  1503	    except (OperationalError, sqlite3.IntegrityError) as e:
  1504	        raise click.ClickException(str(e))
