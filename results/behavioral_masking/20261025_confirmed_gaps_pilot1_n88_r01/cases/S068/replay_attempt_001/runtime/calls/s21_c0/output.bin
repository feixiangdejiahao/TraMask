  1366	    silent,
  1367	    strict,
  1368	):
  1369	    """
  1370	    Upsert records based on their primary key. Works like 'insert' but if
  1371	    an incoming record has a primary key that matches an existing record
  1372	    the existing record will be updated.
  1373	
  1374	    Example:
  1375	
  1376	    \b
  1377	        echo '[
  1378	            {"id": 1, "name": "Lila"},
  1379	            {"id": 2, "name": "Suna"}
  1380	        ]' | sqlite-utils upsert data.db chickens - --pk id
  1381	    """
  1382	    try:
  1383	        insert_upsert_implementation(
  1384	            path,
  1385	            table,
  1386	            file,
  1387	            pk,
  1388	            flatten,
  1389	            nl,
  1390	            csv,
  1391	            tsv,
  1392	            empty_null,
  1393	            lines,
  1394	            text,
  1395	            convert,
  1396	            imports,
  1397	            delimiter,
  1398	            quotechar,
  1399	            sniff,
  1400	            no_headers,
  1401	            encoding,
  1402	            batch_size,
  1403	            stop_after,
  1404	            alter=alter,
  1405	            upsert=True,
  1406	            not_null=not_null,
  1407	            default=default,
  1408	            detect_types=detect_types,
  1409	            no_detect_types=no_detect_types,
  1410	            analyze=analyze,
  1411	            load_extension=load_extension,
  1412	            silent=silent,
  1413	            strict=strict,
  1414	        )
  1415	    except UnicodeDecodeError as ex:
  1416	        raise click.ClickException(UNICODE_ERROR.format(ex))
