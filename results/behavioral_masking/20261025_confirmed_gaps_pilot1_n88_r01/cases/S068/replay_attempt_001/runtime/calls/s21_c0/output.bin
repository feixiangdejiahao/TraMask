  1217	)
  1218	def insert(
  1219	    path,
  1220	    table,
  1221	    file,
  1222	    pk,
  1223	    flatten,
  1224	    nl,
  1225	    csv,
  1226	    tsv,
  1227	    empty_null,
  1228	    lines,
