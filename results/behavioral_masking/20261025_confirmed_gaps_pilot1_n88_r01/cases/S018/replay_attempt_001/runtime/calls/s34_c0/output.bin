EDT -> None <class 'NoneType'>
EST -> tzfile('/usr/share/zoneinfo/EST') <class 'dateutil.tz.tz.tzfile'>
America/New_York -> tzfile('/usr/share/zoneinfo/America/New_York') <class 'dateutil.tz.tz.tzfile'>
UTC -> tzfile('/usr/share/zoneinfo/UTC') <class 'dateutil.tz.tz.tzfile'>
tzname: EDT utcoffset: -1 day, 20:00:00
