   170				}
   171				v.stack[v.sp] = obj
   172				v.sp++
   173			case parser.OpNull:
   174				v.stack[v.sp] = UndefinedValue
   175				v.sp++
   176			case parser.OpBinaryOp:
   177				v.ip++
   178				right := v.stack[v.sp-1]
   179				left := v.stack[v.sp-2]
   180				tok := token.Token(v.curInsts[v.ip])
   181				res, e := left.BinaryOp(tok, right)
   182				if e != nil {
   183					v.sp -= 2
   184					if e == ErrInvalidOperator {
   185						v.err = fmt.Errorf("invalid operation: %s %s %s",
   186							left.TypeName(), tok.String(), right.TypeName())
   187						return
   188					}
   189					v.err = e
   190					return
