   145	func (v *VM) run() {
   146		for atomic.LoadInt64(&v.aborting) == 0 {
   147			v.ip++
   148	
   149			switch v.curInsts[v.ip] {
   150			case parser.OpConstant:
   151				v.ip += 2
   152				cidx := int(v.curInsts[v.ip]) | int(v.curInsts[v.ip-1])<<8
   153	
   154				obj := v.constants[cidx]
   155				if fn, ok := obj.(*CompiledFunction); ok {
   156					obj = fn.attachContext(v.ctx)
   157				}
   158				v.stack[v.sp] = obj
   159				v.sp++
   160			case parser.OpNull:
