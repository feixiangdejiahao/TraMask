ter = high\n+        if low is not None:\n+            self._low_water = low\n+\n+    @property\n+    def high_water(self):\n+        \"\"\"int or None: Current high water mark.\"\"\"\n+        return self._high_water\n+\n+    @property\n+    def low_water(self):\n+        \"\"\"int or None: Current low water mark.\"\"\"\n+        return self._low_water\n+\n+    @property\n+    def over_high_water(self):\n+        \"\"\"bool: True if the buffer size meets or exceeds the high water mark.\"\"\"\n+        if self._high_water is None:\n+            return False\n+        return self.size >= self._high_water\n+\n+    @property\n+    def under_low_water(self):\n+        \"\"\"bool: True if the buffer size is at or below the low water mark.\"\"\"\n+        if self._low_water is None:\n+            return False\n+        return self.size <= self._low_water\n+\n     def get_fill_size(self, size=None):\n         \"\"\"\n         Retrieves the default fill size for this buffer class.\ndiff --git a/pwnlib/tubes/tube.py b/pwnlib/tubes/tube.py\nindex 084e9cb1..9aa835a5 100644\n--- a/pwnlib/tubes/tube.py\n+++ b/pwnlib/tubes/tube.py\n@@ -1718,3 +1718,19 @@ class tube(Timeout, Logger):\n \n     # Clean up the scope\n     del wrapper, func, make_wrapper, _name, _name2\n+\n+    def mux(self, **kwargs):\n+        \"\"\"mux(**kwargs) -> TubeMultiplexer\n+\n+        Wraps this tube in a :class:`pwnlib.tubes.mux.TubeMultiplexer`,\n+        enabling multiple independent logical channels over this single\n+        connection.\n+\n+        Any keyword arguments are forwarded to the\n+        :class:`~pwnlib.tubes.mux.TubeMultiplexer` constructor.\n+\n+        Returns:\n+            :class:`pwnlib.tubes.mux.TubeMultiplexer`\n+        \"\"\"\n+        from pwnlib.tubes.mux import TubeMultiplexer\n+        return TubeMultiplexer(self, **kwargs)\n",
