    50	e1 = m3.open_channel(1, timeout=1); e2 = m4.accept_channel(timeout=1)
    51	r2.close()  # kill underlying from client side; but m3 reader may block...
    52	# Instead use m3.close() which closes underlying and sends mux close to m4
    53	m3.close()
    54	time.sleep(0.2)
    55	print("m4.closed after m3.close", m4.closed)
    56	try:
    57	    e2.recv(timeout=0.2)
    58	    print("ERROR e2 recv expected EOF")
    59	except EOFError:
    60	    print("e2 recv EOF ok")
    61	try:
    62	    e2.send(b'x')
    63	    print("ERROR e2 send expected EOF")
    64	except EOFError:
    65	    print("e2 send EOF ok")
    66	
    67	m1.close(); m2.close(); m4.close()
    68	print("HALFCLOSE OK")
