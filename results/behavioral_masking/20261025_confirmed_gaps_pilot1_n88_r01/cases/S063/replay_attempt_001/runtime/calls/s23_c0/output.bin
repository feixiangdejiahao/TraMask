patched
    30	        will be received first.
    31	    """
    32	    def __init__(self, buffer_fill_size = None):
    33	        self.data = [] # Buffer
    34	        self.size = 0  # Length
    35	        self.buffer_fill_size = buffer_fill_size
    36	        self.high_water = None
    37	        self.low_water = None
    38	
    39	    def __len__(self):
    40	        """
    41	        >>> b = Buffer()
    42	        >>> b.add(b'lol')
    43	        >>> len(b) == 3
    44	        True
    45	        >>> b.add(b'foobar')
    46	        >>> len(b) == 9
    47	        True
    48	        """
    49	        return self.size
    50	
    51	    def __nonzero__(self):
    52	        return len(self) > 0
    53	
    54	    def __contains__(self, x):
    55	        """
    56	        >>> b = Buffer()
    57	        >>> b.add(b'asdf')
    58	        >>> b'x' in b
    59	        False
    60	        >>> b.add(b'x')
    61	        >>> b'x' in b
    62	        True
    63	        """
    64	        for b in self.data:
    65	            if x in b:
    66	                return True
    67	        return False
    68	
    69	    def set_watermarks(self, high=None, low=None):
    70	        """
    71	        Set the high and/or low water marks used for flow control.
    72	
    73	        Arguments:
    74	            high(int): High water mark.  The buffer is considered
    75	                :attr:`over_high_water` when its size is greater than or
    76	                equal to this value.
    77	            low(int): Low water mark.  The buffer is considered
    78	                :attr:`under_low_water` when its size is less than or
    79	                equal to this value.
    80	
    81	        Raises:
    82	            ValueError: If both water marks are set and ``low > high``.
    83	        """
    84	        if high is not None:
    85	            self.high_water = high
    86	        if low is not None:
    87	            self.low_water = low
    88	        if (self.high_water is not None and self.low_water is not None
    89	                and self.low_water > self.high_water):
    90	            raise ValueError("low_water_mark cannot exceed high_water_mark")
    91	
    92	    @property
    93	    def over_high_water(self):
    94	        """True if the buffer size is at or above the high water mark."""
    95	        if self.high_water is None:
    96	            return False
    97	        return self.size >= self.high_water
    98	
    99	    @property
   100	    def under_low_water(self):
