    95	
    96	const isAggregateError = (error: any): error is any =>
    97	  typeof AggregateError !== 'undefined' && error instanceof AggregateError;
    98	
    99	const serializeErrorLeaf = (
   100	  error: Error,
   101	  options: NormalizedErrorStackOptions
   102	): any => {
   103	  const result: any = {
   104	    name: error.name,
   105	    message: error.message,
   106	  };
   107	
   108	  if (options.sanitizeMessage) {
   109	    result.message = sanitizeMessage(result.message);
   110	  }
   111	
   112	  if (isAggregateError(error) && 'errors' in error) {
   113	    result.errors = (error as any).errors;
   114	  }
   115	
   116	  return result;
   117	};
   118	
   119	const serializeErrorWithOptions = (
   120	  error: Error,
   121	  superJson: SuperJSON,
   122	  options: NormalizedErrorStackOptions,
   123	  causeDepth = 0
   124	): any => {
   125	  const baseError: any = {
   126	    name: error.name,
   127	    message: error.message,
   128	  };
   129	
   130	  if (options.includeCauses !== 'none' && 'cause' in error) {
   131	    const cause = serializeErrorCause(
   132	      error.cause,
   133	      options,
   134	      superJson,
   135	      causeDepth
   136	    );
   137	    if (cause !== undefined) {
   138	      baseError.cause = cause;
   139	    }
   140	  }
   141	
   142	  if (isAggregateError(error) && 'errors' in error) {
   143	    baseError.errors = (error as any).errors;
   144	  }
   145	
   146	  superJson.allowedErrorProps.forEach(prop => {
   147	    if (prop === 'stack') {
   148	      if (
   149	        options.mode === 'string' &&
   150	        typeof (error as any).stack === 'string'
   151	      ) {
   152	        baseError.stack = processStackString((error as any).stack, options);
   153	      }
   154	    } else if (prop === 'stackFrames') {
   155	      if (
   156	        options.mode === 'frames' &&
   157	        typeof (error as any).stack === 'string'
   158	      ) {
   159	        baseError.stackFrames = processStackFrames(
   160	          (error as any).stack,
   161	          options
   162	        );
   163	      }
   164	    } else {
   165	      baseError[prop] = (error as any)[prop];
   166	    }
   167	  });
   168	
   169	  if (options.sanitizeMessage) {
   170	    baseError.message = sanitizeMessage(baseError.message);
   171	  }
   172	
   173	  const processor = superJson.errorClassRegistry.getProcessor(error.name);
   174	  if (processor) {
   175	    return processor(baseError);
   176	  }
   177	
   178	  return baseError;
   179	};
   180	
   181	const serializeErrorCause = (
   182	  cause: unknown,
   183	  options: NormalizedErrorStackOptions,
   184	  superJson: SuperJSON,
   185	  depth: number
   186	): any => {
   187	  if (!isError(cause)) {
   188	    return undefined;
   189	  }
   190	
   191	  if (options.includeCauses === 'direct') {
   192	    return serializeErrorLeaf(cause, options);
   193	  }
   194	
   195	  if (depth >= options.maxCauseDepth) {
   196	    return undefined;
   197	  }
   198	
   199	  return serializeErrorWithOptions(cause, superJson, options, depth + 1);
   200	};
   201	
   202	const reconstructError = (value: any): Error => {
   203	  if (value instanceof Error) {
   204	    return value;
   205	  }
   206	
   207	  if (value && typeof value === 'object') {
   208	    const base: any = Array.isArray(value.errors)
   209	      ? new AggregateError(value.errors, value.message ?? '')
   210	      : new Error(value.message ?? '');
   211	    base.name = value.name ?? 'Error';
   212	    base.stack = value.stack;
   213	    if (value.cause !== undefined) {
   214	      base.cause = reconstructError(value.cause);
   215	    }
   216	    Object.keys(value).forEach(key => {
   217	      if (
   218	        key === 'name' ||
   219	        key === 'message' ||
   220	        key === 'stack' ||
   221	        key === 'cause' ||
   222	        key === 'errors'
   223	      ) {
   224	        return;
   225	      }
   226	      base[key] = value[key];
   227	    });
   228	    return base;
   229	  }
   230	
   231	  return new Error(String(value));
   232	};
   233	
   234	const errorStackUntransform = (v: any, _superJson: SuperJSON) => {
   235	  const e: any = Array.isArray(v.errors)
   236	    ? new AggregateError(v.errors, v.message ?? '')
   237	    : new Error(v.message ?? '');
   238	  e.name = v.name ?? 'Error';
   239	  e.stack = v.stack;
   240	  e.stackFrames = v.stackFrames;
   241	  if (v.cause !== undefined) {
   242	    e.cause = reconstructError(v.cause);
   243	  }
   244	  if (Array.isArray(v.errors)) {
   245	    e.errors = v.errors;
   246	  }
   247	
   248	  Object.keys(v).forEach(key => {
   249	    if (
   250	      key === 'name' ||
   251	      key === 'message' ||
   252	      key === 'stack' ||
   253	      key === 'stackFrames' ||
   254	      key === 'cause' ||
   255	      key === 'errors'
   256	    ) {
   257	      return;
   258	    }
   259	    e[key] = v[key];
   260	  });
   261	
   262	  return e;
   263	};
   264	
   265	const simpleRules = [
   266	  simpleTransformation(
   267	    isUndefined,
   268	    'undefined',
   269	    () => null,
   270	    () => undefined
   271	  ),
   272	  simpleTransformation(
   273	    isBigint,
   274	    'bigint',
   275	    v => v.toString(),
   276	    v => {
   277	      if (typeof BigInt !== 'undefined') {
   278	        return BigInt(v);
   279	      }
   280	
   281	      console.error('Please add a BigInt polyfill.');
   282	
   283	      return v as any;
   284	    }
   285	  ),
   286	  simpleTransformation(
   287	    isDate,
   288	    'Date',
   289	    v => v.toISOString(),
   290	    v => new Date(v)
   291	  ),
   292	
   293	  simpleTransformation(
   294	    isErrorStackString,
   295	    'Error/stack',
   296	    (v, superJson) =>
   297	      serializeErrorWithOptions(v, superJson, superJson.errorStackOptions!),
   298	    errorStackUntransform
   299	  ),
   300	
