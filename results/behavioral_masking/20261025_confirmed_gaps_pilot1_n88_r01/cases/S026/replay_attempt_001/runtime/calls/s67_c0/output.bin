=== "[Foo[T]]" ===
  comment.Plain [Foo[T]]
=== "[map[string]int]" ===
  comment.Plain [map[string]int]
=== "[[]int]" ===
  comment.Plain [[]int]
=== "[Foo.Bar]" ===
  *comment.DocLink &{[Foo.Bar]  Foo Bar}
=== "[pkg.Foo[T]]" ===
  comment.Plain [pkg.Foo[T]]
=== "[[Foo]]" ===
  comment.Plain [
  *comment.DocLink &{[Foo]   Foo}
  comment.Plain ]
=== "[Foo]." ===
  *comment.DocLink &{[Foo]   Foo}
  comment.Plain .
=== "foo [Bar] baz" ===
  comment.Plain foo 
  *comment.DocLink &{[Bar]   Bar}
  comment.Plain  baz
