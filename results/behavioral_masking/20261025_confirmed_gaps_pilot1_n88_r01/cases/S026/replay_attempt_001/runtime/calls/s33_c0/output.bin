err: <nil> pkg: package p ("p")
--- import spec path="fmt" name=<nil>
  Implicits: *types.PkgName package fmt
  PkgName.Name="fmt" Imported=fmt
--- import spec path="strings" name=alias
  ObjectOf(name): *types.PkgName package alias ("strings")
  PkgName.Name="alias" Imported=strings
  Implicits: <nil> <nil>
--- import spec path="sort" name=.
  ObjectOf(name): *types.PkgName package . ("sort")
  PkgName.Name="." Imported=sort
  Implicits: <nil> <nil>
