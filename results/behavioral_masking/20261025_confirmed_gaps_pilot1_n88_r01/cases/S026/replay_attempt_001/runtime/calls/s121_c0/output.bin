=== checkers/testdata/_integration/cgo/linttest.params ===
check -enable=dupImport . | linttest.golden
=== checkers/testdata/_integration/check_comments/linttest.params ===
check -enable=commentedOutImport,codegenComment ./... | linttest.golden
=== checkers/testdata/_integration/check_main_only/linttest.params ===
check -enableAll ./... | linttest.golden
check -enableAll main.go | linttest.golden
=== checkers/testdata/_integration/check_packages/linttest.params ===
check -enableAll ./src/foo ./src/bar | linttest.golden
check -enableAll ./src/bar ./src/foo | linttest.golden
=== checkers/testdata/_integration/ruleguard-glob/linttest.params ===
check -@ruleguard.rules rules*.go -enable ruleguard ./... | linttest.golden=== checkers/testdata/_integration/ruleguard-multi/linttest.params ===
check -@ruleguard.rules rules1.go,rules2.go -enable ruleguard ./... | linttest.golden=== checkers/testdata/_integration/ruleguard/linttest.params ===
check -@ruleguard.rules ./rules.go -enable ruleguard -@ruleguard.disable=#test ./... | linttest.golden
check -@ruleguard.rules ./rules.go -enable ruleguard -@ruleguard.enable=#style -@ruleguard.disable=#test ./... | linttest.golden2
check -@ruleguard.rules ./rules.go -enable ruleguard -@ruleguard.enable=#style,#test,#experimental ./... | linttest.golden3
check -@ruleguard.rules ./rules.go -enable ruleguard ./... | linttest.golden4
