   185	
   186	    def clear(self) -> None:
   187	        """Cancel pending waiters and reset statistics.
   188	
   189	        The default implementation is a no-op. Concrete backends may override it.
   190	        """
   191	
   192	
   193	class InMemoryCoalesceBackend(CoalesceBackend):
   194	    """Thread-safe, in-memory :class:`CoalesceBackend` implementation."""
   195	
   196	    def __init__(self) -> None:
   197	        self._lock = threading.RLock()
   198	        self._executions: dict[Any, _Execution] = {}
   199	        self._active = 0
   200	        self._coalesced = 0
   201	        self._total = 0
   202	
   203	    @override
   204	    def register(self, key: Any) -> bool:
   205	        ckey = _canonical_key(key)
   206	        with self._lock:
   207	            execution = self._executions.get(ckey)
   208	            self._total += 1
   209	            if execution is None or execution.completed or execution.cancelled:
   210	                self._executions[ckey] = _Execution()
   211	                self._active += 1
   212	                return True
   213	            self._coalesced += 1
   214	            return False
   215	
